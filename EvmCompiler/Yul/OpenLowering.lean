    have hAfterJumpRel :
        Structured.Preservation.Frame.StateRel callState
          (Assembly.Source.jumpPc entryDest afterPrologue)
          (token :: tokens) := by
      refine ⟨?_, ?_⟩
      · simpa [Assembly.Source.jumpPc] using
          hRelAfterPrologue.stackRel
      · simpa [Assembly.Source.jumpPc,
          Structured.Preservation.eraseControl_with_pc] using
          hRelAfterPrologue.dataRel
    have hAfterJumpPc :
        (Assembly.Source.jumpPc entryDest afterPrologue).pc =
          EvmYul.UInt256.ofNat entryDest := by
      rfl
    have hAfterJumpGas :
        SourceStateTargetGasRel cfg sourceState
          (Assembly.Source.jumpPc entryDest afterPrologue) :=
      SourceStateTargetGasRel.of_target_gasAvailable_eq hFinalGas
        (by simp [Assembly.Source.jumpPc])
    rcases
        hRest (Assembly.Source.jumpPc entryDest afterPrologue)
          hAfterJumpRel hAfterJumpPc hAfterJumpGas with
      ⟨fuelAfterJump, hAfterJumpTrace, hAfterJumpReady⟩
    let hAfterJumpTrace' :
        OpenAssembly.Source.OpenTraceResult
          ((pre ++ prologue) ++ [Assembly.Instr.jump entryLabel] ++ post)
          fuelAfterJump (Assembly.Source.jumpPc entryDest afterPrologue)
          tailTrace result := by
      simpa [prologue, List.append_assoc] using hAfterJumpTrace
    have hAfterJumpReady' :
        SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg)
          hAfterJumpTrace' := by
      simpa [prologue, List.append_assoc] using hAfterJumpReady
    rcases
        source_jump_no_call_running_continue_exists
          (cfg := cfg) (pre := pre ++ prologue) (post := post)
          (label := entryLabel) (state := afterPrologue)
          (dest := entryDest) (fuel := fuelAfterJump)
          (tailTrace := tailTrace) (result := result)
          (Structured.Preservation.AssemblyProgram.PCFitsFrom.start hFitsJump)
          hFinalPc hJumpLabel hAfterJumpReady' with
      ⟨hJumpTrace, hJumpReady⟩
    exact ⟨fuelAfterJump + 1,
      by simpa [List.append_assoc] using hJumpTrace,
      by simpa [List.append_assoc] using hJumpReady⟩
  rcases
