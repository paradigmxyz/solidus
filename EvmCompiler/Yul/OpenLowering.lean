            ⟨(localsExprOpenSupported?_sound hAnd.1).1,
              (localsExprOpenSupported?_sound hAnd.1).2,
              Functions.LiveLayout.ExprAccess.expr?_sound hAccessTail.1,
              of_decide_eq_true hFreshTail.1,
              functionsStmtListRegularOpenSupportedFor?_sound hFreshTail.2⟩
      | assign name valueExpr =>
          have hAnd :
              localsExprOpenSupported? valueExpr = true ∧
                (Functions.LiveLayout.ExprAccess.expr? 0 layout valueExpr &&
                  (Functions.LiveLayout.Layout.accessible? 0 layout name &&
                    functionsStmtListRegularOpenSupportedFor? programSource
                      returns layout rest)) = true := by
            simpa [functionsStmtListRegularOpenSupportedFor?] using hCheck
          have hAccessTail :
              Functions.LiveLayout.ExprAccess.expr? 0 layout valueExpr = true ∧
                (Functions.LiveLayout.Layout.accessible? 0 layout name &&
                  functionsStmtListRegularOpenSupportedFor? programSource
                    returns layout rest) = true := by
