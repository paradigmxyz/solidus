      Reference.SourceBridgeFacts.SourceStateRel.OpenPrimitiveResultRel cfg
        layout (sourceCall.resume response) compilerResult ∧
      Reference.SourceBridgeFacts.SourceStateRel.CompilerPrimitiveEVMResultRel
        baseStack compilerResult (evmCall.resume response) ∧
      SourceStateTargetGasRel cfg (sourceCall.resume response).1
        (EvmYul.EVM.State.incrPC (evmCall.resume response)) := by
  have hRel :=
    OpenExternal.OpenCallRel.preserves_response hCallRel response hResponse
  rcases hRel with ⟨compilerResult, hSourceCompiler, hCompilerEVM⟩
  refine ⟨compilerResult, hSourceCompiler, hCompilerEVM, ?_⟩
  exact
    SourceStateTargetGasRel.of_openPrimitiveEVMResultRel_incrPC
      ⟨compilerResult, hSourceCompiler, hCompilerEVM⟩

