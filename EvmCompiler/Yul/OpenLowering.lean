theorem sourceStoreRel_exists_of_all_visible_some
    {layout : List Name} {vars : Locals.Source.Store}
    (hSome : ∀ name, name ∈ layout → ∃ value, vars name = some value) :
    ∃ store : EvmYul.Yul.VarStore,
      Reference.SourceBridgeFacts.SourceStoreRel layout store vars := by
  induction layout with
  | nil =>
      exact
        ⟨(default : EvmYul.Yul.VarStore),
          Reference.SourceBridgeFacts.sourceStoreRel_nil
            (default : EvmYul.Yul.VarStore) vars⟩
  | cons head tail ih =>
      have hTailSome :
          ∀ name, name ∈ tail → ∃ value, vars name = some value := by
        intro name hMem
        exact hSome name (by simp [hMem])
      rcases ih hTailSome with ⟨tailStore, hTailRel⟩
      rcases hSome head (by simp) with ⟨headValue, hHeadValue⟩
      refine ⟨tailStore.insert head headValue, ?_⟩
      intro name hMem
      simp only [List.mem_cons] at hMem
      rcases hMem with hEq | hTailMem
      · subst name
        simp [hHeadValue]
      · by_cases hName : name = head
        · subst name
          simp [hHeadValue]
        · rw [Finmap.lookup_insert_of_ne]
          · exact hTailRel name hTailMem
          · exact hName

theorem source_insertMany_preserves_of_not_mem :
    ∀ {names : List Name} {values : List Word}
      {store store' : Locals.Source.Store} {name : Name},
      Functions.Source.Store.insertMany names values store =
          some store' →
        name ∉ names →
          store' name = store name
  | [], [], _store, _store', _name, hInsert, _hFresh => by
      simp [Functions.Source.Store.insertMany] at hInsert
      cases hInsert
      rfl
  | [], _value :: _values, _store, _store', _name, hInsert, _hFresh => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | _head :: _tail, [], _store, _store', _name, hInsert, _hFresh => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | head :: tail, value :: values, store, store', name, hInsert, hFresh => by
      unfold Functions.Source.Store.insertMany at hInsert
      have hTailFresh : name ∉ tail := by
        intro hMem
        exact hFresh (by simp [hMem])
      have hHeadNe : name ≠ head := by
        intro hEq
        exact hFresh (by simp [hEq])
      have hPreserve :=
        source_insertMany_preserves_of_not_mem
          (names := tail) (values := values)
          (store := Locals.Source.Store.insert store head value)
          (store' := store') (name := name) hInsert hTailFresh
      simpa [Locals.Source.Store.insert_of_ne hHeadNe] using hPreserve

