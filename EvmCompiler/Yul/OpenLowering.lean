def FunctionsStmtListRegularOpenSupported (layout : List Name) :
    List Functions.Stmt → Prop
  | [] => True
  | .expr expr :: rest =>
      Locals.Source.Expr.SourceOwned expr ∧
        LocalsExprOpenSupported expr ∧
          Locals.SourceLowering.Expr.Accessible layout 0 expr ∧
            FunctionsStmtListRegularOpenSupported layout rest
  | .let_ name valueExpr :: rest =>
      Locals.Source.Expr.SourceOwned valueExpr ∧
        LocalsExprOpenSupported valueExpr ∧
          Locals.SourceLowering.Expr.Accessible layout 0 valueExpr ∧
            name ∉ layout ∧
              FunctionsStmtListRegularOpenSupported (name :: layout) rest
  | .assign name valueExpr :: rest =>
      Locals.Source.Expr.SourceOwned valueExpr ∧
        LocalsExprOpenSupported valueExpr ∧
          Locals.SourceLowering.Expr.Accessible layout 0 valueExpr ∧
            (∃ idx, layout[idx]? = some name ∧ idx + 1 ≤ 16) ∧
              FunctionsStmtListRegularOpenSupported layout rest
  | _ :: _ => False

def FunctionsCallRegularOpenSupported
    (programSource : Functions.Program) (layout : List Name)
    (targets : List Name) (functionName : Name)
    (args : List (Functions.Expr 1)) : Prop :=
  targets.Nodup ∧
    Locals.Source.ExprSeq.SourceOwned (Functions.Lower.argExprs args) ∧
      LocalsExprSeqOpenSupported (Functions.Lower.argExprs args) ∧
        Locals.SourceLowering.ExprSeq.Accessible layout 0
          (Functions.Lower.argExprs args) ∧
          (∀ {name : Name}, name ∈ targets →
            ∃ idx, layout[idx]? = some name ∧ targets.length + idx ≤ 16) ∧
            (∀ {fn : Functions.FunDef},
              Functions.Source.FunList.find? functionName
                  programSource.functions =
                some fn →
              fn.params.length ≤ 16 ∧ fn.returns.length < 16)

def FunctionsStmtListRegularOpenSupportedFor
    (programSource : Functions.Program) (returns layout : List Name) :
    List Functions.Stmt → Prop
  | [] => True
  | .expr expr :: rest =>
      Locals.Source.Expr.SourceOwned expr ∧
        LocalsExprOpenSupported expr ∧
          Locals.SourceLowering.Expr.Accessible layout 0 expr ∧
            FunctionsStmtListRegularOpenSupportedFor programSource returns
              layout rest
  | .let_ name valueExpr :: rest =>
      Locals.Source.Expr.SourceOwned valueExpr ∧
        LocalsExprOpenSupported valueExpr ∧
          Locals.SourceLowering.Expr.Accessible layout 0 valueExpr ∧
            name ∉ layout ∧
              FunctionsStmtListRegularOpenSupportedFor programSource returns
                (name :: layout) rest
  | .assign name valueExpr :: rest =>
      Locals.Source.Expr.SourceOwned valueExpr ∧
        LocalsExprOpenSupported valueExpr ∧
          Locals.SourceLowering.Expr.Accessible layout 0 valueExpr ∧
            (∃ idx, layout[idx]? = some name ∧ idx + 1 ≤ 16) ∧
              FunctionsStmtListRegularOpenSupportedFor programSource returns
                layout rest
  | .call targets functionName args :: rest =>
      FunctionsCallRegularOpenSupported programSource layout targets
        functionName args ∧
        FunctionsStmtListRegularOpenSupportedFor programSource returns layout
          rest
  | _ :: _ => False

def FunctionsProgramRegularOpenSupported
    (programSource : Functions.Program) : Prop :=
  FunctionsStmtListRegularOpenSupportedFor programSource [] []
    programSource.body.stmts ∧
    ∀ {functionName : Name} {fn : Functions.FunDef},
      Functions.Source.FunList.find? functionName programSource.functions =
        some fn →
      fn.Scoped ∧
        Functions.SourceDirect.FrameBound.FunDef fn ∧
          fn.params.length ≤ 16 ∧
            fn.returns.length < 16 ∧
              FunctionsStmtListRegularOpenSupportedFor programSource
                fn.returns
                (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
                fn.body.stmts

def basicOpOpenSupported? (op : Structured.BasicOp) : Bool :=
  match basicOpSourceBridgeSafe? op with
  | true => true
  | false => (OpenExternal.CallKind.ofBasicOp? op).isSome

theorem basicOpOpenSupported?_sound
    {op : Structured.BasicOp}
    (hCheck : basicOpOpenSupported? op = true) :
    BasicOpOpenSupported op := by
  unfold basicOpOpenSupported? at hCheck
  cases hSafe : basicOpSourceBridgeSafe? op with
  | true =>
      exact Or.inl hSafe
  | false =>
    simp [hSafe] at hCheck
    cases hKind : OpenExternal.CallKind.ofBasicOp? op with
    | none =>
        simp [hKind] at hCheck
    | some kind =>
        exact Or.inr ⟨kind, hKind⟩

mutual
  def localsExprOpenSupported? {results : Nat} :
      Locals.Expr results → Bool
    | .lit _value => true
    | .var _name => true
    | .code _code => false
    | .prim op args =>
        localsExprSeqOpenSupported? args && basicOpOpenSupported? op

  def localsExprSeqOpenSupported? {results : Nat} :
      Locals.ExprSeq results → Bool
    | .nil => true
    | .cons head tail =>
        localsExprOpenSupported? head &&
          localsExprSeqOpenSupported? tail
end

mutual
  theorem localsExprOpenSupported?_sound {results : Nat}
      {expr : Locals.Expr results}
      (hCheck : localsExprOpenSupported? expr = true) :
      Locals.Source.Expr.SourceOwned expr ∧
        LocalsExprOpenSupported expr := by
    cases expr with
    | lit value =>
        simp [Locals.Source.Expr.SourceOwned, LocalsExprOpenSupported]
    | var name =>
        simp [Locals.Source.Expr.SourceOwned, LocalsExprOpenSupported]
    | code code =>
        simp [localsExprOpenSupported?] at hCheck
    | prim op args =>
        have hAnd :
            localsExprSeqOpenSupported? args = true ∧
              basicOpOpenSupported? op = true := by
          simpa [localsExprOpenSupported?] using hCheck
        exact
          ⟨(localsExprSeqOpenSupported?_sound hAnd.1).1,
            ⟨(localsExprSeqOpenSupported?_sound hAnd.1).2,
              basicOpOpenSupported?_sound hAnd.2⟩⟩

  theorem localsExprSeqOpenSupported?_sound {results : Nat}
      {exprs : Locals.ExprSeq results}
      (hCheck : localsExprSeqOpenSupported? exprs = true) :
      Locals.Source.ExprSeq.SourceOwned exprs ∧
        LocalsExprSeqOpenSupported exprs := by
    cases exprs with
    | nil =>
        simp [Locals.Source.ExprSeq.SourceOwned, LocalsExprSeqOpenSupported]
    | cons head tail =>
        have hAnd :
            localsExprOpenSupported? head = true ∧
              localsExprSeqOpenSupported? tail = true := by
          simpa [localsExprSeqOpenSupported?] using hCheck
        exact
          ⟨⟨(localsExprOpenSupported?_sound hAnd.1).1,
              (localsExprSeqOpenSupported?_sound hAnd.2).1⟩,
            ⟨(localsExprOpenSupported?_sound hAnd.1).2,
              (localsExprSeqOpenSupported?_sound hAnd.2).2⟩⟩
end

def functionsTargetAssignable? (width : Nat) (layout : List Name)
    (name : Name) : Bool :=
  match Functions.LiveLayout.Layout.index? name layout with
  | none => false
  | some idx => decide (width + idx ≤ 16)

theorem functionsTargetAssignable?_sound
    {width : Nat} {layout : List Name} {name : Name}
    (hCheck : functionsTargetAssignable? width layout name = true) :
    ∃ idx, layout[idx]? = some name ∧ width + idx ≤ 16 := by
  unfold functionsTargetAssignable? at hCheck
  cases hIndex : Functions.LiveLayout.Layout.index? name layout with
  | none =>
      simp [hIndex] at hCheck
  | some idx =>
      have hCheck' : decide (width + idx ≤ 16) = true := by
        simpa [functionsTargetAssignable?, hIndex] using hCheck
      have hLe : width + idx ≤ 16 := by
        exact of_decide_eq_true hCheck'
      exact
        ⟨idx, Functions.LiveLayout.Layout.index?_sound hIndex, hLe⟩

def functionsTargetsAssignable? (width : Nat) (layout targets : List Name) :
    Bool :=
  targets.all fun name => functionsTargetAssignable? width layout name

theorem functionsTargetsAssignable?_sound
    {width : Nat} {layout targets : List Name}
    (hCheck : functionsTargetsAssignable? width layout targets = true) :
    ∀ {name : Name}, name ∈ targets →
      ∃ idx, layout[idx]? = some name ∧ width + idx ≤ 16 := by
  intro name hName
  exact
    functionsTargetAssignable?_sound
      ((List.all_eq_true.mp hCheck) name hName)

def functionsCallRegularOpenSupported?
    (programSource : Functions.Program) (layout : List Name)
    (targets : List Name) (functionName : Name)
    (args : List (Functions.Expr 1)) : Bool :=
  decide targets.Nodup &&
    (localsExprSeqOpenSupported? (Functions.Lower.argExprs args) &&
      (Functions.LiveLayout.ExprAccess.exprSeq? 0 layout
        (Functions.Lower.argExprs args) &&
        (functionsTargetsAssignable? targets.length layout targets &&
          match
            Functions.Source.FunList.find? functionName
              programSource.functions with
          | none => true
          | some fn =>
              decide (fn.params.length ≤ 16) &&
                decide (fn.returns.length < 16))))

theorem functionsCallRegularOpenSupported?_sound
    {programSource : Functions.Program} {layout targets : List Name}
    {functionName : Name} {args : List (Functions.Expr 1)}
    (hCheck :
      functionsCallRegularOpenSupported? programSource layout targets
        functionName args = true) :
    FunctionsCallRegularOpenSupported programSource layout targets
      functionName args := by
  unfold functionsCallRegularOpenSupported? at hCheck
  have hParts :
      decide targets.Nodup = true ∧
        (localsExprSeqOpenSupported? (Functions.Lower.argExprs args) &&
          (Functions.LiveLayout.ExprAccess.exprSeq? 0 layout
            (Functions.Lower.argExprs args) &&
            (functionsTargetsAssignable? targets.length layout targets &&
              match
                Functions.Source.FunList.find? functionName
                  programSource.functions with
              | none => true
              | some fn =>
                  decide (fn.params.length ≤ 16) &&
                    decide (fn.returns.length < 16)))) = true := by
    simpa using hCheck
  have hTail :
      localsExprSeqOpenSupported? (Functions.Lower.argExprs args) = true ∧
        (Functions.LiveLayout.ExprAccess.exprSeq? 0 layout
          (Functions.Lower.argExprs args) &&
          (functionsTargetsAssignable? targets.length layout targets &&
            match
              Functions.Source.FunList.find? functionName
                programSource.functions with
            | none => true
            | some fn =>
                decide (fn.params.length ≤ 16) &&
                  decide (fn.returns.length < 16))) = true := by
    simpa using hParts.2
  have hAccessTail :
      Functions.LiveLayout.ExprAccess.exprSeq? 0 layout
          (Functions.Lower.argExprs args) = true ∧
        (functionsTargetsAssignable? targets.length layout targets &&
          match
            Functions.Source.FunList.find? functionName
              programSource.functions with
          | none => true
          | some fn =>
              decide (fn.params.length ≤ 16) &&
                decide (fn.returns.length < 16)) = true := by
    simpa using hTail.2
  have hTargetsTail :
      functionsTargetsAssignable? targets.length layout targets = true ∧
        (match
          Functions.Source.FunList.find? functionName programSource.functions with
        | none => true
        | some fn =>
            decide (fn.params.length ≤ 16) &&
              decide (fn.returns.length < 16)) = true := by
    simpa using hAccessTail.2
  refine
    ⟨of_decide_eq_true hParts.1,
      (localsExprSeqOpenSupported?_sound hTail.1).1,
      (localsExprSeqOpenSupported?_sound hTail.1).2,
      Functions.LiveLayout.ExprAccess.exprSeq?_sound hAccessTail.1,
      functionsTargetsAssignable?_sound hTargetsTail.1, ?_⟩
  intro fn hFind
  rw [hFind] at hTargetsTail
  have hBounds :
      decide (fn.params.length ≤ 16) = true ∧
        decide (fn.returns.length < 16) = true := by
    simpa using hTargetsTail.2
  exact ⟨of_decide_eq_true hBounds.1, of_decide_eq_true hBounds.2⟩

def functionsStmtListRegularOpenSupportedFor?
    (programSource : Functions.Program) (returns layout : List Name) :
    List Functions.Stmt → Bool
  | [] => true
  | .expr expr :: rest =>
      localsExprOpenSupported? expr &&
        (Functions.LiveLayout.ExprAccess.expr? 0 layout expr &&
          functionsStmtListRegularOpenSupportedFor? programSource returns
            layout rest)
  | .let_ name valueExpr :: rest =>
      localsExprOpenSupported? valueExpr &&
        (Functions.LiveLayout.ExprAccess.expr? 0 layout valueExpr &&
          (decide (name ∉ layout) &&
            functionsStmtListRegularOpenSupportedFor? programSource returns
              (name :: layout) rest))
  | .assign name valueExpr :: rest =>
      localsExprOpenSupported? valueExpr &&
        (Functions.LiveLayout.ExprAccess.expr? 0 layout valueExpr &&
          (Functions.LiveLayout.Layout.accessible? 0 layout name &&
            functionsStmtListRegularOpenSupportedFor? programSource returns
              layout rest))
  | .call targets functionName args :: rest =>
      functionsCallRegularOpenSupported? programSource layout targets
        functionName args &&
        functionsStmtListRegularOpenSupportedFor? programSource returns layout
          rest
  | _ :: _ => false

theorem functionsStmtListRegularOpenSupportedFor?_sound
    {programSource : Functions.Program} {returns layout : List Name} :
    ∀ {stmts : List Functions.Stmt},
