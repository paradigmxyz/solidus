inductive SourceOpenTraceCurrentSharedBridgeReadyFor
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} :
    {targetFuel : Nat} → {state : EvmYul.EVM.State} →
      {trace : OpenExternal.OpenTrace} →
        {targetResult : Assembly.StepResult} →
          OpenAssembly.Source.OpenTraceResult program targetFuel state trace
            targetResult → Prop where
  | done (state : EvmYul.EVM.State) :
      SourceOpenTraceCurrentSharedBridgeReadyFor
        (OpenAssembly.Source.OpenTraceResult.done
          (program := program) state)
  | stepRunning
      {fuel : Nat} {state mid : EvmYul.EVM.State}
      {headTrace tailTrace : OpenExternal.OpenTrace}
      {result : Assembly.StepResult}
      (hStep :
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openStepResult program state)
          headTrace (.ok (.running mid)))
      {hRest :
        OpenAssembly.Source.OpenTraceResult program fuel mid tailTrace
          result}
      (hBoundaryBridgeRel :
        SourceOpenCurrentSharedBridgeBoundaryRel cfg program state)
      (hRestReady :
        SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg) hRest) :
      SourceOpenTraceCurrentSharedBridgeReadyFor
        (OpenAssembly.Source.OpenTraceResult.stepRunning hStep hRest)
  | stepHalted
      {fuel : Nat} {state : EvmYul.EVM.State}
      {headTrace : OpenExternal.OpenTrace} {halt : Assembly.Halt}
      (hStep :
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openStepResult program state)
          headTrace (.ok (.halted halt))) :
      SourceOpenTraceCurrentSharedBridgeReadyFor
        (OpenAssembly.Source.OpenTraceResult.stepHalted
          (fuel := fuel) hStep)

