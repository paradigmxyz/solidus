              (caseLabel := Structured.LabelSupply.label base idx)
              (caseDest := Assembly.Program.byteLength headCasePre)
              (pre := pre)
              (post :=
                testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix ++
