                    (ctxFinal := ctxFinal) (sourceFuel := sourceFuel')
                    (compiler := compilerAfter)
                    (sourceAfter := sourceAfter) (trace := tailTrace)
                    hRestSupported hRest
                simpa [Functions.Scope.StmtList.outEnv,
