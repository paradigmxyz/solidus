      removeBuriedUnder_source_running_continue_exists
        (cfg := cfg) (state := target) (returnValues := callee.evm.stack)
        (suffix := callerTarget) (token := token) (pre := pre)
        (post := post) (tailTrace := tailTrace) (result := result)
