                Structured.StackShuffle.removeBuriedUnder
                  callee.evm.stack.length ++
                [Assembly.Instr.jump site.returnLabel]) := by
          exact
            Structured.Preservation.AssemblyProgram.PCFitsFrom.left
              (pre := pre)
