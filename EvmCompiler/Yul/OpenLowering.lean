      by simpa [List.append_assoc] using hJumpReady,
      hResultRel⟩
  rcases
      callPrologue_source_running_continue_exists_sourceGasRel
        (cfg := cfg) (sourceState := sourceState) (state := target)
        (args := args) (suffix := callerTarget) (token := token)
        (pre := pre) (post := [Assembly.Instr.jump entryLabel] ++ post)
        hFitsPrologue
        (by simpa [hTargetRecord] using hPc)
        hArgBound hGasRel hRestForPrologue with
    ⟨fuelPrologue, targetResult, hPrologueTrace, hPrologueReady,
      hResultRel⟩
  exact ⟨fuelPrologue, targetResult,
    by simpa [hTargetRecord, prologue, List.append_assoc] using
      hPrologueTrace,
    by simpa [hTargetRecord, prologue, List.append_assoc] using
