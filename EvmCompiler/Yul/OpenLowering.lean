theorem sourceStoreRel_assignMany_visible_exists
    {layout : List Name} {sourceStore : EvmYul.Yul.VarStore}
    {vars vars' : Locals.Source.Store}
    {names : List Name} {values : List Word}
    (hRel :
      Reference.SourceBridgeFacts.SourceStoreRel layout sourceStore vars)
    (hAssign :
      Functions.Source.Store.assignMany names values vars = some vars') :
    ∃ sourceStore' : EvmYul.Yul.VarStore,
      Reference.SourceBridgeFacts.SourceStoreRel layout sourceStore' vars' := by
  induction names generalizing values vars sourceStore with
  | nil =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.assignMany] at hAssign
          cases hAssign
          exact ⟨sourceStore, hRel⟩
      | cons _ _ =>
          simp [Functions.Source.Store.assignMany] at hAssign
  | cons name names ih =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.assignMany] at hAssign
      | cons value values =>
          unfold Functions.Source.Store.assignMany at hAssign
          by_cases hContains : vars.contains name
          · simp [hContains] at hAssign
            exact
              ih
                (values := values)
                (vars := Locals.Source.Store.insert vars name value)
                (sourceStore := sourceStore.insert name value)
                (Reference.SourceBridgeFacts.sourceStoreRel_insert_visible
                  hRel)
                hAssign
          · simp [hContains] at hAssign

