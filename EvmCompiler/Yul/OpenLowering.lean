  rcases
      codeSegment_expressionsStmtList_append_split
        (left := rawStmts)
        (right := pushStmts ++ Locals.codeStmt cleanup)
        segment' with
    ⟨rawSegment, returnTailSegment, hRawStart, hTailStart, hTailFall⟩
  refine
    ⟨rawStmts, pushCtx, pushStmts, finalCtx, cleanup,
