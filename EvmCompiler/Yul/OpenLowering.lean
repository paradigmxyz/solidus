theorem structuredBasicInstr_step_no_call_gasAvailable_eq
    {instr : Structured.BasicInstr}
    {state post : EvmYul.EVM.State}
    (hNoCall : instr.usesCallCreate = false)
    (hStep : instr.step state = .ok post) :
    post.gasAvailable = state.gasAvailable := by
  cases instr with
  | push value =>
      simp [Structured.BasicInstr.step, Assembly.Target.stepInstr] at hStep
      cases hStep
      simp [EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC]
  | op op =>
      have hNoPrim : op.toPrimOp.isCallCreate = false := by
        simpa [Structured.BasicInstr.usesCallCreate] using hNoCall
      change
        Assembly.Target.stepInstr (Assembly.TargetInstr.prim op.toPrimOp)
            state =
          .ok post at hStep
      simp [Assembly.Target.stepInstr] at hStep
      cases hCont : op.toPrimOp.continuingStep? with
      | none =>
          have hRun :
              EvmYul.step op.toPrimOp.toEVM none state = .ok post := by
            rw [Assembly.PrimOp.step_eq_evm_step_of_not_continuing
              hCont hNoPrim] at hStep
            exact hStep
          exact
            Assembly.GasAware.EvmYul_step_noncontinuing_prim_gasAvailable_eq
              hCont hNoPrim hRun
      | some step =>
          have hRun :
              EvmYul.step op.toPrimOp.toEVM none state = .ok post := by
            rw [Assembly.GasAware.EvmYul_step_eq_continuingStep_run_exact
              hCont state]
            simpa [Assembly.PrimOp.step, hCont] using hStep
          exact
            Assembly.GasAware.EvmYul_step_continuing_prim_gasAvailable_eq
              hCont hRun

