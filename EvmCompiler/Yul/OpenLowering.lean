noncomputable def FunctionsProgramCompileCheckedAssemblyTarget?
    (program : Functions.Program) :
    Option (Assembly.Program × Assembly.TargetProgram) := do
  let asm ← Functions.Source.Program.compileChecked? program
  let target ← Assembly.compile? asm
  some (asm, target)

theorem FunctionsProgramCompileCheckedAssemblyTarget?_eq_some
    {program : Functions.Program} {asm : Assembly.Program}
    {target : Assembly.TargetProgram}
    (hCompileTarget :
      FunctionsProgramCompileCheckedAssemblyTarget? program =
        some (asm, target)) :
    Functions.Source.Program.compileChecked? program = some asm ∧
      Assembly.compile? asm = some target := by
  unfold FunctionsProgramCompileCheckedAssemblyTarget? at hCompileTarget
  cases hCompile : Functions.Source.Program.compileChecked? program with
  | none =>
      simp [hCompile] at hCompileTarget
  | some asm' =>
      simp [hCompile] at hCompileTarget
      cases hAssemble : Assembly.compile? asm' with
      | none =>
          simp [hAssemble] at hCompileTarget
      | some target' =>
          simp [hAssemble] at hCompileTarget
          rcases hCompileTarget with ⟨rfl, rfl⟩
          exact ⟨by simp, hAssemble⟩

noncomputable def FunctionsProgramCompileCheckedRegularOpenAssemblyTarget?
    (program : Functions.Program) :
    Option (Assembly.Program × Assembly.TargetProgram) :=
  if FunctionsProgramRegularOpenSupported? program then
    FunctionsProgramCompileCheckedAssemblyTarget? program
  else
    none

