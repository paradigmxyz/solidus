        have hHeadTokenNeSite : head.token ≠ site.token := by
          intro hEq
          exact hNe (by simpa [hToken] using hEq)
        let headCasePre :=
          pre ++ headTest ++ testsRest ++ [Assembly.Instr.prim .invalid] ++
            casePrefix
        have hHeadCaseLabel :
