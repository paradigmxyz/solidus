theorem compilerOpenPrimitive_callKind_stackPrefixSuffixErased_openRunNResult_continue
    {prim : Objects.Source.PrimitiveSemantics}
    {layout : List Name}
    {compiler : Objects.Source.State}
    {state : EvmYul.EVM.State}
    {op : Structured.BasicOp} {kind : OpenExternal.CallKind}
    (hKind : OpenExternal.CallKind.ofBasicOp? op = some kind)
    (values : List Word)
    (hValuesLen :
      values.length = Expressions.Structured.BasicOp.inputs op)
    (stackPrefix suffix : List Word)
    (hPrefixRel :
      StackPrefixSuffixErasedRel layout compiler
        (values.reverse ++ stackPrefix) suffix state)
    (program : Assembly.Program) (pc fuel : Nat)
    (hAt :
      Assembly.Program.instrAtPc program state.pc.toNat =
        some (pc, Assembly.Instr.prim op.toPrimOp)) :
    ∃ operands : OpenExternal.CallOperands,
    ∃ compilerCall :
        OpenExternal.OpenCall (Objects.Source.State × List Word),
    ∃ evmCall : OpenExternal.OpenCall EvmYul.EVM.State,
      values = (kind.args operands).reverse ∧
      Reference.SourceBridgeFacts.SourceStateRel.compilerPrimitiveOpenCall?
          compiler kind values =
        some compilerCall ∧
      OpenExternal.CallKind.evmOpenCall? state kind =
        some evmCall ∧
      (∀ response : OpenExternal.CallResponse,
        StackPrefixSuffixErasedRel layout
          (compilerCall.resume response).1
          ((compilerCall.resume response).2.reverse ++ stackPrefix) suffix
          (EvmYul.EVM.State.incrPC (evmCall.resume response))) ∧
      ∀ (response : OpenExternal.CallResponse)
        {tailTrace : OpenExternal.OpenTrace}
        {result : Except EVMException Assembly.StepResult},
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult program fuel
            (EvmYul.EVM.State.incrPC (evmCall.resume response)))
          tailTrace result →
        OpenExternal.OpenResultResolves
          (Reference.SourceBridgeFacts.CompilerOpen.Primitive.eval
            prim op compiler values)
          [{ site := compilerCall.site, response := response }]
          (.ok (compilerCall.resume response)) ∧
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult program (fuel + 1) state)
          ({ site := compilerCall.site, response := response } :: tailTrace)
          result := by
  have hOp : op = kind.toBasicOp :=
    basicOp_eq_toBasicOp_of_callKind hKind
  subst op
  have hLen : values.length = kind.inputArity := by
    simpa using hValuesLen
  rcases
      OpenExternal.CallKind.exists_operands_of_reverse_args_length
        kind hLen with
    ⟨operands, hValues⟩
  subst values
  have hPrefixRelArgs :
      StackPrefixSuffixErasedRel layout compiler
        (kind.args operands ++ stackPrefix) suffix state := by
    simpa [List.reverse_reverse] using hPrefixRel
  rcases hPrefixRelArgs with
    ⟨hErase, storeBase, hStack, hStoreRel⟩
  let baseStack : OpenExternal.Stack := stackPrefix ++ storeBase ++ suffix
  have hStateStack :
      state.stack = kind.args operands ++ baseStack := by
    simp [baseStack, hStack, List.append_assoc]
  have hStateEq :
      ({ state with stack := kind.args operands ++ baseStack }
        : EvmYul.EVM.State) = state :=
    evmState_with_stack_eq_self hStateStack
  let siteCompiler :=
    (OpenExternal.CallContext.ofEVMSharedState compiler.shared).callSite
      kind (kind.canonicalOperands operands)
  let compilerCall :
      OpenExternal.OpenCall (Objects.Source.State × List Word) :=
    { site := siteCompiler
      resume := fun response =>
        (compiler.withShared
          (siteCompiler.finishShared compiler.shared response),
          [response.statusWord]) }
  let siteEVM :=
    (OpenExternal.CallContext.ofEVMState state).callSite
      kind (kind.canonicalOperands operands)
  let evmCall : OpenExternal.OpenCall EvmYul.EVM.State :=
    { site := siteEVM
      resume := fun response =>
        { state with
          toSharedState := siteEVM.finishShared state.toSharedState response
          stack := response.statusWord :: baseStack } }
  have hCompilerCall :
      Reference.SourceBridgeFacts.SourceStateRel.compilerPrimitiveOpenCall?
          compiler kind (kind.args operands).reverse =
        some compilerCall := by
    simp [Reference.SourceBridgeFacts.SourceStateRel.compilerPrimitiveOpenCall?,
      compilerCall, siteCompiler]
  have hEVMCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some evmCall := by
    simpa [hStateEq, evmCall, siteEVM] using
      OpenExternal.CallKind.evmOpenCall?_args state kind operands baseStack
  have hSiteEq : siteEVM = siteCompiler := by
    exact
      StackPrefixSuffixErasedRel.callSite_eq_targetShared
        (layout := layout) (source := compiler)
        (stackPrefix := kind.args operands ++ stackPrefix)
        (suffix := suffix) (evm := state)
        ⟨hErase, storeBase, hStack, hStoreRel⟩
        kind (kind.canonicalOperands operands)
  have hResponseRel :
      ∀ response : OpenExternal.CallResponse,
        StackPrefixSuffixErasedRel layout
          (compilerCall.resume response).1
          ((compilerCall.resume response).2.reverse ++ stackPrefix) suffix
          (EvmYul.EVM.State.incrPC (evmCall.resume response)) := by
    intro response
    have hEraseAfter :=
      StackPrefixSuffixErasedRel.eraseControl_incrPC_finishShared_targetShared
        (layout := layout) (source := compiler)
        (stackPrefix := kind.args operands ++ stackPrefix)
        (suffix := suffix) (evm := state)
        ⟨hErase, storeBase, hStack, hStoreRel⟩
        siteEVM response (response.statusWord :: baseStack)
    refine ⟨?_, storeBase, ?_, ?_⟩
    · simpa [compilerCall, evmCall, siteCompiler, siteEVM,
        Locals.Source.State.withShared, hSiteEq] using hEraseAfter
    · simp [compilerCall, evmCall, baseStack, EvmYul.EVM.State.incrPC,
        List.append_assoc]
    · simpa [compilerCall, Locals.Source.State.withShared] using hStoreRel
  refine
    ⟨operands, compilerCall, evmCall, rfl, hCompilerCall, hEVMCall,
      hResponseRel, ?_⟩
  intro response tailTrace result hRest
  have hSourceSuspend :
      Reference.SourceBridgeFacts.CompilerOpen.Primitive.eval prim
          kind.toBasicOp compiler (kind.args operands).reverse =
        .call
          { site := compilerCall.site
            resume := fun response =>
              .done (.ok (compilerCall.resume response)) } :=
    Reference.SourceBridgeFacts.CompilerOpen.Primitive.eval_suspends_toBasicOp
      kind hCompilerCall
  have hSource :
      OpenExternal.OpenResultResolves
        (Reference.SourceBridgeFacts.CompilerOpen.Primitive.eval
          prim kind.toBasicOp compiler (kind.args operands).reverse)
        [{ site := compilerCall.site, response := response }]
        (.ok (compilerCall.resume response)) := by
    rw [hSourceSuspend]
    exact OpenExternal.OpenResultResolves.call
      OpenExternal.OpenResultResolves.done
  have hTargetRaw :
      OpenExternal.OpenResultResolves
        (OpenAssembly.Source.openRunNResult program (fuel + 1) state)
        ({ site := evmCall.site, response := response } :: tailTrace)
        result :=
    OpenAssembly.Source.openRunNResult_current_prim_call_continue
      (program := program) (state := state) (fuel := fuel) (pc := pc)
      (op := kind.toBasicOp.toPrimOp) (kind := kind) (call := evmCall)
      hAt (callKind_ofEVMOperation_toBasicOp_toPrimOp kind) hEVMCall
      response hRest
  have hTarget :
      OpenExternal.OpenResultResolves
        (OpenAssembly.Source.openRunNResult program (fuel + 1) state)
        ({ site := compilerCall.site, response := response } :: tailTrace)
        result := by
    simpa [compilerCall, evmCall, siteCompiler, siteEVM, hSiteEq] using
      hTargetRaw
  exact ⟨hSource, hTarget⟩

