    { source with shared := state.toSharedState }
  have hExactPrefix :
      StackPrefixSuffixRel layout sourceExact (value :: restValues) suffix
        state := by
    simpa [sourceExact] using
      StackPrefixSuffixErasedRel.exactWithTargetShared hPrefixRel
  rcases
      compilerOpenAssignTopWithOffset_stackPrefixSuffix_openRunNResult_continue_fallthrough
        (layout := layout) (source := sourceExact) (state := state)
        (name := name) (idx := idx) (offset := offset) (value := value)
        (restValues := restValues) (suffix := suffix) (swapOp := swapOp)
        hNoDup hName hPrefixLen hBound hSwap hExactPrefix
        program segment hPc with
    ⟨evmAfter, hExactAfter, hAfterPc, hCont⟩
  have hEraseFinal :
      Structured.Preservation.eraseControl state =
        Structured.Preservation.eraseControl
          { state with
            toSharedState :=
              (source.withVars
                (Locals.Source.Store.insert source.vars name value)).shared } := by
    simpa [Locals.Source.State.withVars] using hPrefixRel.1
  have hErasedAfter :
      StackPrefixSuffixErasedRel layout
        (source.withVars (Locals.Source.Store.insert source.vars name value))
        restValues suffix evmAfter := by
    exact
      StackPrefixSuffixErasedRel.of_exactWithTargetShared
        (source :=
          source.withVars (Locals.Source.Store.insert source.vars name value))
        (start := state)
        hEraseFinal
