theorem openTraceResult_append_running_of_result
    {program : Assembly.Program}
    {prefixFuel suffixFuel : Nat}
    {state mid : EvmYul.EVM.State}
    {prefixTrace suffixTrace : OpenExternal.OpenTrace}
    {prefixResult result : Assembly.StepResult}
    (hPrefix :
      OpenAssembly.Source.OpenTraceResult program prefixFuel state
        prefixTrace prefixResult)
    (hPrefixResult : prefixResult = .running mid)
    (hSuffix :
      OpenAssembly.Source.OpenTraceResult program suffixFuel mid suffixTrace
        result) :
    OpenAssembly.Source.OpenTraceResult program (prefixFuel + suffixFuel)
      state (prefixTrace ++ suffixTrace) result := by
  induction hPrefix generalizing mid suffixFuel suffixTrace result with
  | done state =>
      cases hPrefixResult
      simpa using hSuffix
  | stepRunning hStep hRest ih =>
      have hRestApp := ih hPrefixResult hSuffix
      have hStepApp :=
        OpenAssembly.Source.OpenTraceResult.stepRunning hStep hRestApp
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm,
        List.append_assoc] using hStepApp
  | stepHalted hStep =>
      cases hPrefixResult

theorem openTraceResult_append_running
    {program : Assembly.Program}
    {prefixFuel suffixFuel : Nat}
    {state mid : EvmYul.EVM.State}
    {prefixTrace suffixTrace : OpenExternal.OpenTrace}
    {result : Assembly.StepResult}
    (hPrefix :
      OpenAssembly.Source.OpenTraceResult program prefixFuel state
        prefixTrace (.running mid))
    (hSuffix :
      OpenAssembly.Source.OpenTraceResult program suffixFuel mid suffixTrace
        result) :
    OpenAssembly.Source.OpenTraceResult program (prefixFuel + suffixFuel)
      state (prefixTrace ++ suffixTrace) result :=
  openTraceResult_append_running_of_result hPrefix rfl hSuffix

structure SourceOpenCurrentSharedBridgeBoundaryRel
    (cfg : Reference.StateRelConfig)
    (program : Assembly.Program)
    (state : EvmYul.EVM.State) : Prop where
  call :
    ∀ {pc : Nat} {op : Assembly.PrimOp}
      {kind : OpenExternal.CallKind}
      {call : OpenExternal.OpenCall EvmYul.EVM.State},
      Assembly.Program.instrAtPc program state.pc.toNat =
        some (pc, .prim op) →
      OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind →
      OpenExternal.CallKind.evmOpenCall? state kind = some call →
      FunctionsOpenCurrentSharedStateBridgeRel cfg state
  create :
    ∀ {pc : Nat} {op : Assembly.PrimOp}
      {kind : OpenExternal.CreateKind}
      {create : OpenExternal.OpenCreate EvmYul.EVM.State},
      Assembly.Program.instrAtPc program state.pc.toNat =
        some (pc, .prim op) →
      OpenExternal.CallKind.ofEVMOperation? op.toEVM = none →
      OpenExternal.CreateKind.ofEVMOperation? op.toEVM = some kind →
      OpenExternal.CreateKind.evmOpenCreate? state kind = some create →
      FunctionsOpenCurrentSharedStateBridgeRel cfg state

