  rcases
      Structured.Preservation.Frame.StateRel.caller_materialization_of_top_return
        hRel hReturns with
    ⟨callerTarget, _hCaller, hTargetStack⟩
  have hTargetRecord :
      { target with stack := callee.evm.stack ++ token :: callerTarget } =
        target := by
