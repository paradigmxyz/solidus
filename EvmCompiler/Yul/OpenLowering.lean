                subst ctxAfterHead
                subst trace
                simp [Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] at hRest
                have hScope :=
                  ih (returns := returns) (layout := layout)
                    (sourceCtx := sourceCtx) (ctxFinal := ctxFinal)
                    (sourceFuel := sourceFuel') (compiler := compilerAfter)
                    (sourceAfter := sourceAfter) (trace := tailTrace)
                    hRestSupported hRest
                simpa [Functions.Scope.StmtList.outEnv,
                  Functions.Scope.Stmt.outEnv] using hScope
