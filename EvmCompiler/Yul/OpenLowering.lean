                  functionsStmtListRegularOpenSupportedFor? programSource
                    returns layout rest) = true := by
            simpa [functionsStmtListRegularOpenSupportedFor?] using hCheck
          have hTail :
              Functions.LiveLayout.ExprAccess.expr? 0 layout expr = true ∧
                functionsStmtListRegularOpenSupportedFor? programSource returns
                  layout rest = true := by
            simpa using hAnd.2
