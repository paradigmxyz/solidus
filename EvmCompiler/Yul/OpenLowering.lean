theorem of_target_gasAvailable_eq
    {cfg : Reference.StateRelConfig}
    {source : Reference.State}
    {target target' : EvmYul.EVM.State}
    (hRel : SourceStateTargetGasRel cfg source target)
    (hGas : target'.gasAvailable = target.gasAvailable) :
    SourceStateTargetGasRel cfg source target' := by
  cases source with
  | Ok sourceShared sourceStore =>
      simpa [SourceStateTargetGasRel, hGas] using hRel
  | OutOfFuel =>
      exact hRel
  | Checkpoint checkpoint =>
      exact hRel

