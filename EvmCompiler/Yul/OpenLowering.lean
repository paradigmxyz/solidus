    (hSwap : Locals.StackOp.swap? (idx + 1) = some swapOp)
    (suffix : List Word)
    (program : Assembly.Program)
    (tailFuel : Nat)
    (segment :
      Structured.Preservation.CodeSegment program
        (valueCode ++
          [Structured.BasicInstr.op swapOp,
            Structured.BasicInstr.op Structured.BasicOp.pop]).toAssembly)
