    rw [hAt]
    unfold Assembly.Source.stepAtResult Assembly.Source.stepAt
    simp [afterLabel, Assembly.Target.stepInstr,
      Assembly.Instr.haltKind?]
  have hRelAfter :
      Structured.Preservation.Frame.StateRel source afterLabel tokens := by
    refine ⟨?_, ?_⟩
    · simpa [afterLabel, EvmYul.EVM.State.incrPC] using hRel.stackRel
    · simpa [afterLabel, EvmYul.EVM.State.incrPC,
