    {sourceShared : EvmYul.SharedState .Yul}
    {sourceStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {target : EvmYul.EVM.State}
    {stackPrefix suffix : List Word}
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg sourceLayout
        (.Ok sourceShared sourceStore) compiler)
    (hRel :
      StackPrefixSuffixErasedRel layout compiler stackPrefix suffix target)
    (hGasRel :
      cfg.gasAvailableRel sourceShared.gasAvailable target.gasAvailable) :
    Reference.SharedStateRel cfg sourceShared target.toSharedState := by
  cases hSourceRel with
  | ok hShared _hVars =>
      rcases hShared with ⟨hChain, hMachine⟩
      rcases hRel with ⟨hErase, _storeBase, _hStack, _hStoreRel⟩
      cases target
      cases compiler
      simp [Structured.Preservation.eraseControl, Assembly.eraseGas]
        at hErase hChain hMachine hGasRel ⊢
      rcases hErase with
        ⟨hToState, hActiveWords, hMemory, hReturnData, hHReturn⟩
      constructor
      · rw [hToState]
        exact hChain
      · constructor
        · exact hGasRel
        · rw [hActiveWords]
          exact hMachine.activeWords
        · rw [hMemory]
          exact hMachine.memory
        · rw [hReturnData]
          exact hMachine.returnData
        · rw [hHReturn]
          exact hMachine.H_return

theorem sourceStateTargetGasRel_of_callKind_response
    {cfg : Reference.StateRelConfig}
    {sourceLayout layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {sourceStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {state : EvmYul.EVM.State}
    {kind : OpenExternal.CallKind}
    {operands : OpenExternal.CallOperands}
    {stackPrefix suffix : List Word}
    {compilerCall :
      OpenExternal.OpenCall (Objects.Source.State × List Word)}
    {evmCall : OpenExternal.OpenCall EvmYul.EVM.State}
    {response : OpenExternal.CallResponse}
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg sourceLayout
        (.Ok sourceShared sourceStore) compiler)
    (hRel :
      StackPrefixSuffixErasedRel layout compiler
        (kind.args operands ++ stackPrefix) suffix state)
    (hGasRel :
      cfg.gasAvailableRel sourceShared.gasAvailable state.gasAvailable)
    (hCompilerCall :
      Reference.SourceBridgeFacts.SourceStateRel.compilerPrimitiveOpenCall?
          compiler kind (kind.args operands).reverse =
        some compilerCall)
    (hEVMCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some evmCall)
    (hResponse :
      Reference.SharedStateRel.OpenExternalResponseRel cfg sourceShared
        state.toSharedState response) :
    ∃ sourceAfter : Reference.State,
      Reference.SourceBridgeFacts.SourceStateRel cfg sourceLayout sourceAfter
        (compilerCall.resume response).1 ∧
      SourceStateTargetGasRel cfg sourceAfter
        (EvmYul.EVM.State.incrPC (evmCall.resume response)) := by
  rcases
      Reference.SourceBridgeFacts.SourceStateRel.openExternalPrimitiveOpenCallRel_of_args
        hSourceRel kind operands with
    ⟨sourceCall, compilerCall', _hSourceCall, hCompilerCall',
      hSourceCompiler⟩
  rw [hCompilerCall] at hCompilerCall'
  cases hCompilerCall'
  have hTargetStateEq :
      state.toSharedState.toState = compiler.shared.toState := by
    rcases hRel with ⟨hErase, _storeBase, _hStack, _hStoreRel⟩
    cases state
    cases compiler
    simp [Structured.Preservation.eraseControl, Assembly.eraseGas] at hErase ⊢
    exact hErase.1
  have hResponseCompiler :
      Reference.SharedStateRel.OpenExternalResponseRel cfg sourceShared
        compiler.shared response := by
    simpa [Reference.SharedStateRel.OpenExternalResponseRel,
      hTargetStateEq] using hResponse
  have hSourceCompilerResult :=
    OpenExternal.OpenCallRel.preserves_response hSourceCompiler response
      hResponseCompiler
  rcases hSourceCompilerResult with ⟨hSourceAfter, _hValuesAfter⟩
  have hSourceResume :
      (sourceCall.resume response).1 =
        .Ok (sourceCall.site.finishShared sourceShared response)
          sourceStore :=
    yulOpenCall?_resume_state_eq_finishShared
      (kind := kind) (args := kind.args operands)
      (shared := sourceShared) (store := sourceStore)
      _hSourceCall response
  have hEVMResume :
      (evmCall.resume response).toSharedState =
        evmCall.site.finishShared state.toSharedState response :=
    evmOpenCall?_resume_toSharedState_eq_finishShared hEVMCall response
  have hSharedTarget :
      Reference.SharedStateRel cfg sourceShared state.toSharedState :=
    sharedStateRel_of_source_state_rel_gas hSourceRel hRel hGasRel
  have hSiteEq : compilerCall.site = evmCall.site :=
    compilerPrimitiveOpenCall?_site_eq_evmOpenCall?
      (layout := layout) (source := compiler)
      (stackPrefix := stackPrefix) (suffix := suffix) (evm := state)
      (kind := kind) (operands := operands)
      hRel hCompilerCall hEVMCall
  have hSourceTargetAfter :
      Reference.SharedStateRel cfg
        (sourceCall.site.finishShared sourceShared response)
        (evmCall.site.finishShared state.toSharedState response) := by
    have hFinished :=
      Reference.SharedStateRel.finishExternalCall
        (cfg := cfg) (sourceShared := sourceShared)
        (targetShared := state.toSharedState)
        (site := evmCall.site) (response := response)
        hSharedTarget hResponse
    simpa [hSourceCompiler.sameSite, hSiteEq] using hFinished
  refine ⟨(sourceCall.resume response).1, hSourceAfter, ?_⟩
  simpa [SourceStateTargetGasRel, EvmYul.EVM.State.incrPC, hSourceResume,
    hEVMResume] using hSourceTargetAfter.machine.gasAvailable

end StackPrefixSuffixErasedRel

