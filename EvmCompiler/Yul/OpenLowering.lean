def StackPrefixSuffixRel (layout : List Name) (source : Objects.Source.State)
    (stackPrefix suffix : List Word) (evm : EvmYul.EVM.State) : Prop :=
  evm.toSharedState = source.shared ∧
    ∃ baseStack : EvmYul.Stack Word,
      evm.stack = stackPrefix ++ baseStack ++ suffix ∧
        Locals.SourceLowering.StackStoreRel layout source.vars baseStack

def StackPrefixSuffixErasedRel (layout : List Name)
    (source : Objects.Source.State) (stackPrefix suffix : List Word)
    (evm : EvmYul.EVM.State) : Prop :=
  Structured.Preservation.eraseControl evm =
      Structured.Preservation.eraseControl
        { evm with toSharedState := source.shared } ∧
    ∃ baseStack : EvmYul.Stack Word,
      evm.stack = stackPrefix ++ baseStack ++ suffix ∧
        Locals.SourceLowering.StackStoreRel layout source.vars baseStack

namespace StackPrefixSuffixErasedRel

theorem of_stackPrefixRel
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      Locals.SourceLowering.StackPrefixRel layout source stackPrefix evm) :
    StackPrefixSuffixErasedRel layout source stackPrefix [] evm := by
  rcases hRel with ⟨hShared, baseStack, hStack, hStoreRel⟩
  refine ⟨?_, baseStack, ?_, hStoreRel⟩
  · rw [← hShared]
  · simpa [List.append_assoc] using hStack

theorem of_stackPrefixSuffixRel
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixRel layout source stackPrefix suffix evm) :
    StackPrefixSuffixErasedRel layout source stackPrefix suffix evm := by
  rcases hRel with ⟨hShared, baseStack, hStack, hStoreRel⟩
  refine ⟨?_, baseStack, hStack, hStoreRel⟩
  · rw [← hShared]

theorem to_stackPrefixSuffixRel
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix evm) :
    StackPrefixSuffixRel layout
      { source with shared := evm.toSharedState } stackPrefix suffix evm := by
  rcases hRel with ⟨_hErase, baseStack, hStack, hStoreRel⟩
  exact ⟨rfl, baseStack, hStack, by simpa using hStoreRel⟩

theorem consPrefix_replaceStackAndIncrPC
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {state : EvmYul.EVM.State}
    {value : Word} {pcΔ : Nat}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix state) :
    StackPrefixSuffixErasedRel layout source (value :: stackPrefix) suffix
      (state.replaceStackAndIncrPC (value :: state.stack) (pcΔ := pcΔ)) := by
  rcases hRel with ⟨hErase, baseStack, hStack, hStoreRel⟩
  refine ⟨?_, baseStack, ?_, hStoreRel⟩
  · cases state
    cases source
    simp [Structured.Preservation.eraseControl, Assembly.eraseGas,
      EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC] at hErase ⊢
    exact hErase
  · simp [EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC, hStack, List.append_assoc]

theorem local_stack_lookup_value
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {state : EvmYul.EVM.State}
    {idx : Nat} {name : Name}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix state)
    (hName : layout[idx]? = some name) :
    ∃ value : Word,
      state.stack[stackPrefix.length + idx]? = some value ∧
        source.vars name = some value := by
  rcases hRel with ⟨_hErase, baseStack, hStack, hStoreRel⟩
  rcases
      Locals.SourceLowering.StackStoreRel.lookup_value hStoreRel hName with
    ⟨value, hBaseAt, hStore⟩
  have hIdxLt : idx < baseStack.length :=
    (List.getElem?_eq_some_iff.mp hBaseAt).1
  have hBaseSuffixAt :
      (baseStack ++ suffix)[idx]? = some value := by
    rw [List.getElem?_append_left hIdxLt]
    exact hBaseAt
  have hStackAt :
      state.stack[stackPrefix.length + idx]? = some value := by
    rw [hStack]
    simpa [List.append_assoc] using
      (Locals.StackLowering.getElem?_append_right_add stackPrefix
        (baseStack ++ suffix) idx).trans hBaseSuffixAt
  exact ⟨value, hStackAt, hStore⟩

theorem local_stack_get?_of_store_lookup
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {state : EvmYul.EVM.State}
    {idx : Nat} {name : Name} {value : Word}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix state)
    (hName : layout[idx]? = some name)
    (hLookup : source.vars name = some value) :
    state.stack[stackPrefix.length + idx]? = some value := by
  rcases local_stack_lookup_value hRel hName with
    ⟨value', hStackAt, hStore⟩
  rw [hLookup] at hStore
  cases hStore
  exact hStackAt

theorem gasExecRel_targetShared
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix evm) :
    Assembly.GasAware.GasExecRel evm
      ({ evm with toSharedState := source.shared } : EvmYul.EVM.State) := by
  rcases hRel with ⟨hErase, _baseStack, _hStack, _hStoreRel⟩
  rcases evm with ⟨evmShared, pc, stack, execLength⟩
  rcases source with ⟨sourceShared, vars⟩
  rcases evmShared with
    ⟨evmBase, evmGas, evmActiveWords, evmMemory, evmReturnData,
      evmHReturn⟩
  rcases sourceShared with
    ⟨sourceBase, sourceGas, sourceActiveWords, sourceMemory,
      sourceReturnData, sourceHReturn⟩
  simp [Structured.Preservation.eraseControl, Assembly.eraseGas,
    Assembly.GasAware.GasExecRel] at hErase ⊢
  rcases hErase with
    ⟨hState, hActiveWords, hMemory, hReturnData, hHReturn⟩
  cases hState
  cases hActiveWords
  cases hMemory
  cases hReturnData
  cases hHReturn
  exact ⟨rfl, rfl, rfl, rfl, rfl⟩

theorem callSite_eq_targetShared
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix evm)
    (kind : OpenExternal.CallKind)
    (operands : OpenExternal.CallOperands) :
    (OpenExternal.CallContext.ofEVMState evm).callSite kind operands =
      (OpenExternal.CallContext.ofEVMSharedState source.shared).callSite
        kind operands := by
  rcases hRel with ⟨hErase, _baseStack, _hStack, _hStoreRel⟩
  rcases evm with ⟨evmShared, pc, stack, execLength⟩
  rcases source with ⟨sourceShared, vars⟩
  rcases evmShared with
    ⟨evmBase, evmGas, evmActiveWords, evmMemory, evmReturnData,
      evmHReturn⟩
  rcases sourceShared with
    ⟨sourceBase, sourceGas, sourceActiveWords, sourceMemory,
      sourceReturnData, sourceHReturn⟩
  simp [Structured.Preservation.eraseControl, Assembly.eraseGas] at hErase
  rcases hErase with
    ⟨hState, _hActiveWords, hMemory, _hReturnData, _hHReturn⟩
  cases hState
  cases hMemory
  cases kind <;>
    rfl

theorem compilerPrimitiveOpenCall?_site_eq_evmOpenCall?
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    {kind : OpenExternal.CallKind}
    {operands : OpenExternal.CallOperands}
    {compilerCall :
      OpenExternal.OpenCall (Objects.Source.State × List Word)}
    {evmCall : OpenExternal.OpenCall EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixErasedRel layout source
        (kind.args operands ++ stackPrefix) suffix evm)
    (hCompilerCall :
      Reference.SourceBridgeFacts.SourceStateRel.compilerPrimitiveOpenCall?
          source kind (kind.args operands).reverse =
        some compilerCall)
    (hEVMCall :
      OpenExternal.CallKind.evmOpenCall? evm kind = some evmCall) :
    compilerCall.site = evmCall.site := by
  rcases hRel with ⟨hErase, storeBase, hStack, hStoreRel⟩
  let baseStack : OpenExternal.Stack := stackPrefix ++ storeBase ++ suffix
  have hStateStack :
      evm.stack = kind.args operands ++ baseStack := by
    simp [baseStack, hStack, List.append_assoc]
  have hStateEq :
      ({ evm with stack := kind.args operands ++ baseStack }
        : EvmYul.EVM.State) = evm :=
    evmState_with_stack_eq_self hStateStack
  have hCompilerSite :
      compilerCall.site =
        (OpenExternal.CallContext.ofEVMSharedState source.shared).callSite
          kind (kind.canonicalOperands operands) := by
    simp [Reference.SourceBridgeFacts.SourceStateRel.compilerPrimitiveOpenCall?]
      at hCompilerCall
    cases hCompilerCall
    rfl
  have hEVMSite :
      evmCall.site =
        (OpenExternal.CallContext.ofEVMState evm).callSite
          kind (kind.canonicalOperands operands) := by
    have hArgs :=
      OpenExternal.CallKind.evmOpenCall?_args evm kind operands baseStack
    rw [hStateEq] at hArgs
    rw [hEVMCall] at hArgs
    cases hArgs
    rfl
  have hSiteEq :
      (OpenExternal.CallContext.ofEVMState evm).callSite kind
          (kind.canonicalOperands operands) =
        (OpenExternal.CallContext.ofEVMSharedState source.shared).callSite
          kind (kind.canonicalOperands operands) :=
    StackPrefixSuffixErasedRel.callSite_eq_targetShared
      (layout := layout) (source := source)
      (stackPrefix := kind.args operands ++ stackPrefix)
      (suffix := suffix) (evm := evm)
      ⟨hErase, storeBase, hStack, hStoreRel⟩
      kind (kind.canonicalOperands operands)
  exact hCompilerSite.trans (hSiteEq.symm.trans hEVMSite.symm)

theorem eraseControl_incrPC_finishShared_targetShared
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix evm)
    (site : OpenExternal.CallSite)
    (response : OpenExternal.CallResponse)
    (stack : List Word) :
    Structured.Preservation.eraseControl
        (EvmYul.EVM.State.incrPC
          ({ evm with
            toSharedState :=
              site.finishShared evm.toSharedState response
            stack := stack } : EvmYul.EVM.State)) =
      Structured.Preservation.eraseControl
        ({ EvmYul.EVM.State.incrPC
            ({ evm with
              toSharedState :=
                site.finishShared evm.toSharedState response
              stack := stack } : EvmYul.EVM.State) with
          toSharedState := site.finishShared source.shared response } :
          EvmYul.EVM.State) := by
  rcases hRel with ⟨hErase, _baseStack, _hStack, _hStoreRel⟩
  rcases evm with ⟨evmShared, pc, evmStack, execLength⟩
  rcases source with ⟨sourceShared, vars⟩
  rcases evmShared with
    ⟨evmBase, evmGas, evmActiveWords, evmMemory, evmReturnData,
      evmHReturn⟩
  rcases sourceShared with
    ⟨sourceBase, sourceGas, sourceActiveWords, sourceMemory,
      sourceReturnData, sourceHReturn⟩
  simp [Structured.Preservation.eraseControl, Assembly.eraseGas] at hErase ⊢
  rcases hErase with
    ⟨hState, hActiveWords, hMemory, _hReturnData, _hHReturn⟩
  cases hState
  cases hActiveWords
  cases hMemory
  simp [OpenExternal.CallSite.finishShared,
    OpenExternal.ReturnWindow.finishMachine,
    EvmYul.MachineState.finishExternalCall, EvmYul.writeBytes,
    EvmYul.EVM.State.incrPC]

theorem exactWithTargetShared
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {evm : EvmYul.EVM.State}
    (hRel :
      StackPrefixSuffixErasedRel layout source stackPrefix suffix evm) :
    StackPrefixSuffixRel layout
      { source with shared := evm.toSharedState } stackPrefix suffix evm := by
  rcases hRel with ⟨_hErase, baseStack, hStack, hStoreRel⟩
  exact ⟨rfl, baseStack, hStack, by simpa using hStoreRel⟩

theorem of_exactWithTargetShared
    {layout : List Name} {source : Objects.Source.State}
    {stackPrefix suffix : List Word} {start evm : EvmYul.EVM.State}
    (hErase :
      Structured.Preservation.eraseControl start =
        Structured.Preservation.eraseControl
          { start with toSharedState := source.shared })
    (hRel :
      StackPrefixSuffixRel layout
        { source with shared := start.toSharedState } stackPrefix suffix evm) :
    StackPrefixSuffixErasedRel layout source stackPrefix suffix evm := by
  rcases hRel with ⟨hShared, baseStack, hStack, hStoreRel⟩
  refine ⟨?_, baseStack, hStack, by simpa using hStoreRel⟩
  cases start
  cases evm
  simp [Structured.Preservation.eraseControl, Assembly.eraseGas] at hErase hShared ⊢
  cases hShared
  exact hErase

theorem of_frameStateRel_stateRel
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source : Objects.Source.State} {base : Locals.RunState}
    {target : EvmYul.EVM.State} {values tokens : List Word}
    (hBaseRel :
      Functions.SourceDirect.StateRel layout hiddenReturns source base)
    (hFrameRel :
      Structured.Preservation.Frame.StateRel
        (base.withEVM
          { base.evm with stack := values.reverse ++ base.evm.stack })
        target tokens) :
    ∃ suffix,
      StackPrefixSuffixErasedRel layout source values.reverse suffix target := by
  rcases hBaseRel with ⟨hLowerRel, hReturns⟩
  rcases hLowerRel with ⟨hBaseShared, hStoreRel⟩
  rcases hFrameRel.hidden_suffix with
    ⟨suffix, hTargetStack, _hMaterialize⟩
  refine ⟨suffix, ?_⟩
  refine ⟨?_, base.evm.stack, ?_, hStoreRel⟩
  · calc
      Structured.Preservation.eraseControl target =
          Structured.Preservation.eraseControl
            { (base.withEVM
                { base.evm with stack := values.reverse ++ base.evm.stack }).evm with
              stack := target.stack } := hFrameRel.dataRel
      _ = Structured.Preservation.eraseControl
            { target with toSharedState := source.shared } := by
          cases target
          cases base
          cases source
          cases hBaseShared
          simp [Structured.RunState.withEVM,
            Structured.Preservation.eraseControl, Assembly.eraseGas]
  · calc
      target.stack =
          (base.withEVM
            { base.evm with stack := values.reverse ++ base.evm.stack }).evm.stack ++
            suffix := hTargetStack
      _ = (values.reverse ++ base.evm.stack) ++ suffix := by
            simp [Structured.RunState.withEVM]
      _ = values.reverse ++ base.evm.stack ++ suffix := by
            simp [List.append_assoc]

theorem of_frameStateRel_stateRel_with_materialize
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source : Objects.Source.State} {base : Locals.RunState}
    {target : EvmYul.EVM.State} {values tokens : List Word}
    (hBaseRel :
      Functions.SourceDirect.StateRel layout hiddenReturns source base)
    (hFrameRel :
      Structured.Preservation.Frame.StateRel
        (base.withEVM
          { base.evm with stack := values.reverse ++ base.evm.stack })
        target tokens) :
    ∃ suffix,
      StackPrefixSuffixErasedRel layout source values.reverse suffix target ∧
        ∀ newVisible : EvmYul.Stack Word,
          Structured.Preservation.Frame.materializeStack newVisible
              hiddenReturns tokens =
            some (newVisible ++ suffix) := by
  rcases hBaseRel with ⟨hLowerRel, hReturns⟩
  rcases hLowerRel with ⟨hBaseShared, hStoreRel⟩
  rcases hFrameRel.hidden_suffix with
    ⟨suffix, hTargetStack, hMaterialize⟩
  have hMaterializeHidden :
      ∀ newVisible : EvmYul.Stack Word,
        Structured.Preservation.Frame.materializeStack newVisible
            hiddenReturns tokens =
          some (newVisible ++ suffix) := by
    intro newVisible
    simpa [Structured.RunState.withEVM, hReturns] using
      hMaterialize newVisible
  refine ⟨suffix, ?_, hMaterializeHidden⟩
  refine ⟨?_, base.evm.stack, ?_, hStoreRel⟩
  · calc
      Structured.Preservation.eraseControl target =
          Structured.Preservation.eraseControl
            { (base.withEVM
                { base.evm with stack := values.reverse ++ base.evm.stack }).evm with
              stack := target.stack } := hFrameRel.dataRel
      _ = Structured.Preservation.eraseControl
            { target with toSharedState := source.shared } := by
          cases target
          cases base
          cases source
          cases hBaseShared
          simp [Structured.RunState.withEVM,
            Structured.Preservation.eraseControl, Assembly.eraseGas]
  · calc
      target.stack =
          (base.withEVM
            { base.evm with stack := values.reverse ++ base.evm.stack }).evm.stack ++
            suffix := hTargetStack
      _ = (values.reverse ++ base.evm.stack) ++ suffix := by
            simp [Structured.RunState.withEVM]
      _ = values.reverse ++ base.evm.stack ++ suffix := by
            simp [List.append_assoc]

theorem to_sourceDirect_stateRel_frameStateRel_nil
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source : Objects.Source.State} {target : EvmYul.EVM.State}
    {suffix tokens : List Word}
    (hRel :
      StackPrefixSuffixErasedRel layout source [] suffix target)
    (hMaterialize :
      ∀ newVisible : EvmYul.Stack Word,
        Structured.Preservation.Frame.materializeStack newVisible
            hiddenReturns tokens =
          some (newVisible ++ suffix)) :
    ∃ direct : Locals.RunState,
      Functions.SourceDirect.StateRel layout hiddenReturns source direct ∧
        Structured.Preservation.Frame.StateRel direct target tokens := by
  rcases hRel with ⟨hErase, baseStack, hStack, hStoreRel⟩
  let direct : Locals.RunState :=
    { evm := { target with toSharedState := source.shared, stack := baseStack }
      returns := hiddenReturns }
  refine ⟨direct, ?_, ?_⟩
  · constructor
    · constructor
      · simp [direct]
      · simpa [direct] using hStoreRel
    · simp [direct]
  · constructor
    · have hStackRel := hMaterialize baseStack
      simpa [direct, hStack] using hStackRel
    · calc
        Structured.Preservation.eraseControl target =
            Structured.Preservation.eraseControl
              { target with toSharedState := source.shared } := hErase
        _ =
            Structured.Preservation.eraseControl
              { direct.evm with stack := target.stack } := by
              simp [direct]

theorem to_sourceDirect_prefixedStateRel_frameStateRel
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source : Objects.Source.State} {target : EvmYul.EVM.State}
    {values suffix tokens : List Word}
    (hRel :
      StackPrefixSuffixErasedRel layout source values suffix target)
    (hMaterialize :
      ∀ newVisible : EvmYul.Stack Word,
        Structured.Preservation.Frame.materializeStack newVisible
            hiddenReturns tokens =
          some (newVisible ++ suffix)) :
    ∃ direct : Locals.RunState,
      Functions.SourceDirect.PrefixedStateRel layout hiddenReturns source
          values direct ∧
        Structured.Preservation.Frame.StateRel direct target tokens := by
  rcases hRel with ⟨hErase, baseStack, hStack, hStoreRel⟩
  let direct : Locals.RunState :=
    { evm := { target with toSharedState := source.shared, stack := values ++ baseStack }
      returns := hiddenReturns }
  refine ⟨direct, ?_, ?_⟩
  · exact ⟨by simp [direct], baseStack, by simp [direct], hStoreRel,
      by simp [direct]⟩
  · constructor
    · have hStackRel := hMaterialize (values ++ baseStack)
      simpa [direct, hStack, List.append_assoc] using hStackRel
    · calc
        Structured.Preservation.eraseControl target =
            Structured.Preservation.eraseControl
              { target with toSharedState := source.shared } := hErase
        _ =
            Structured.Preservation.eraseControl
              { direct.evm with stack := target.stack } := by
              simp [direct]

theorem of_attached_returnedFrameStateRel_stateRel
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {sourceBeforeCall sourceAfterCall : Objects.Source.State}
    {base bodyState returned : Locals.RunState}
    {target : EvmYul.EVM.State}
    {values tokens stack : List Word} {frame : Structured.ReturnDest}
    (hBaseRel :
      Functions.SourceDirect.StateRel layout hiddenReturns sourceBeforeCall
        base)
    (hVars : sourceAfterCall.vars = sourceBeforeCall.vars)
    (hReturned :
      Functions.SourceDirect.ReturnedStackRel (frame :: hiddenReturns)
        sourceAfterCall values bodyState)
    (hAttach :
      Structured.StackFrame.attachReturns? frame bodyState.evm.stack =
        some stack)
    (hFrameStack : frame.callerStack = base.evm.stack)
    (hFrameRel :
      Structured.Preservation.Frame.StateRel
        (returned.withEVM { bodyState.evm with stack := stack })
        target tokens) :
    ∃ suffix,
      StackPrefixSuffixErasedRel layout sourceAfterCall values.reverse suffix
        target := by
  rcases hBaseRel with ⟨hLowerRel, _hReturns⟩
  rcases hLowerRel with ⟨_hBaseShared, hStoreRel⟩
  rcases hReturned with ⟨hReturnedShared, hReturnedStack, _hReturnedReturns⟩
  rcases hFrameRel.hidden_suffix with
    ⟨suffix, hTargetStack, _hMaterialize⟩
  have hStoreRelAfter :
      Locals.SourceLowering.StackStoreRel layout sourceAfterCall.vars
        base.evm.stack := by
    simpa [hVars] using hStoreRel
  have hAttachedStack :
      stack = values.reverse ++ base.evm.stack := by
    have hStackEq :=
      Structured.Preservation.Frame.StackFrameFacts.attachReturns?_eq hAttach
    calc
      stack = bodyState.evm.stack ++ frame.callerStack := hStackEq
      _ = values.reverse ++ frame.callerStack := by
            rw [hReturnedStack]
      _ = values.reverse ++ base.evm.stack := by
            rw [hFrameStack]
  refine ⟨suffix, ?_⟩
  refine ⟨?_, base.evm.stack, ?_, hStoreRelAfter⟩
  · calc
      Structured.Preservation.eraseControl target =
          Structured.Preservation.eraseControl
            { (returned.withEVM
                { bodyState.evm with stack := stack }).evm with
              stack := target.stack } := hFrameRel.dataRel
      _ = Structured.Preservation.eraseControl
            { target with toSharedState := sourceAfterCall.shared } := by
          cases target
          cases bodyState
          cases returned
          cases sourceAfterCall
          cases hReturnedShared
          simp [Structured.RunState.withEVM,
            Structured.Preservation.eraseControl, Assembly.eraseGas]
  · calc
      target.stack = stack ++ suffix := by
            simpa [Structured.RunState.withEVM] using hTargetStack
      _ = (values.reverse ++ base.evm.stack) ++ suffix := by
            rw [hAttachedStack]
      _ = values.reverse ++ base.evm.stack ++ suffix := by
            simp [List.append_assoc]

end StackPrefixSuffixErasedRel

def StackSuffixErasedRel (layout : List Name)
    (source : Objects.Source.State) (evm : EvmYul.EVM.State) : Prop :=
  ∃ suffix : List Word,
    StackPrefixSuffixErasedRel layout source [] suffix evm

namespace StackSuffixErasedRel

theorem of_stackPrefixRel
    {layout : List Name} {source : Objects.Source.State}
    {evm : EvmYul.EVM.State}
    (hRel :
      Locals.SourceLowering.StackPrefixRel layout source [] evm) :
    StackSuffixErasedRel layout source evm :=
  ⟨[], StackPrefixSuffixErasedRel.of_stackPrefixRel hRel⟩

theorem intro_erased
    {layout : List Name} {source : Objects.Source.State}
    {evm : EvmYul.EVM.State} {suffix : List Word}
    (hRel : StackPrefixSuffixErasedRel layout source [] suffix evm) :
    StackSuffixErasedRel layout source evm :=
  ⟨suffix, hRel⟩

theorem explicitSuffixTail_of_tail
    {layout : List Name} {source : Objects.Source.State}
    {asm : Assembly.Program} {pc : Word}
    {tailTrace : OpenExternal.OpenTrace}
    {result : Except EVMException Assembly.StepResult}
    (hTail :
      ∀ evmAfter,
        StackSuffixErasedRel layout source evmAfter →
        evmAfter.pc = pc →
        ∃ tailFuel : Nat,
          OpenExternal.OpenResultResolves
            (OpenAssembly.Source.openRunNResult asm tailFuel evmAfter)
            tailTrace result) :
    ∀ evmAfter suffix,
      StackPrefixSuffixErasedRel layout source [] suffix evmAfter →
      evmAfter.pc = pc →
      ∃ tailFuel : Nat,
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult asm tailFuel evmAfter)
          tailTrace result := by
  intro evmAfter suffix hRel hPc
  exact hTail evmAfter (intro_erased hRel) hPc

theorem explicitSuffixTail_exists_rel_of_tail
    {layout : List Name} {source : Objects.Source.State}
    {asm : Assembly.Program} {pc : Word}
    {tailTrace : OpenExternal.OpenTrace}
    {ResultRel : Assembly.StepResult → Prop}
    (hTail :
      ∀ evmAfter,
        StackSuffixErasedRel layout source evmAfter →
        evmAfter.pc = pc →
        ∃ tailFuel targetResult,
          OpenExternal.OpenResultResolves
            (OpenAssembly.Source.openRunNResult asm tailFuel evmAfter)
            tailTrace (.ok targetResult) ∧
          ResultRel targetResult) :
    ∀ evmAfter suffix,
      StackPrefixSuffixErasedRel layout source [] suffix evmAfter →
      evmAfter.pc = pc →
      ∃ tailFuel targetResult,
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult asm tailFuel evmAfter)
          tailTrace (.ok targetResult) ∧
        ResultRel targetResult := by
  intro evmAfter suffix hRel hPc
  exact hTail evmAfter (intro_erased hRel) hPc

end StackSuffixErasedRel

theorem openRunNResult_resolves_running_continue_exists_rel
    {asm : Assembly.Program} {headFuel : Nat}
    {source target : EvmYul.EVM.State}
    {headTrace tailTrace : OpenExternal.OpenTrace}
    {ResultRel : Assembly.StepResult → Prop}
    (hHead :
      OpenExternal.OpenResultResolves
        (OpenAssembly.Source.openRunNResult asm headFuel source)
        headTrace (.ok (.running target)))
    (hTail :
      ∃ tailFuel targetResult,
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult asm tailFuel target)
          tailTrace (.ok targetResult) ∧
        ResultRel targetResult) :
    ∃ fuel targetResult,
      OpenExternal.OpenResultResolves
        (OpenAssembly.Source.openRunNResult asm fuel source)
        (headTrace ++ tailTrace) (.ok targetResult) ∧
      ResultRel targetResult := by
  rcases hTail with ⟨tailFuel, targetResult, hTailRun, hRel⟩
  exact
    ⟨headFuel + tailFuel, targetResult,
      OpenAssembly.Source.openRunNResult_resolves_running_continue
        hHead hTailRun,
      hRel⟩

theorem compilerOpenPrimitive_no_callCreate_stackPrefixSuffixErased_openRunNResult_continue_pc_of_eval
    {prim : Objects.Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {layout : List Name}
    {compiler : Objects.Source.State}
    {state : EvmYul.EVM.State}
    (op : Structured.BasicOp)
    (hNoCallCreate : op.toPrimOp.isCallCreate = false)
    (values : List Word)
    (stackPrefix suffix : List Word)
    (hPrefixRel :
      StackPrefixSuffixErasedRel layout compiler
        (values.reverse ++ stackPrefix) suffix state)
    (program : Assembly.Program) (pc fuel : Nat)
    (hAt :
      Assembly.Program.instrAtPc program state.pc.toNat =
        some (pc, Assembly.Instr.prim op.toPrimOp))
    {sharedAfter : EvmYul.SharedState .EVM}
    {valuesAfter : List Word}
    (hEval :
      prim.eval op compiler.shared values = .ok (sharedAfter, valuesAfter)) :
    ∃ evmAfter : EvmYul.EVM.State,
      StackPrefixSuffixErasedRel layout (compiler.withShared sharedAfter)
        (valuesAfter.reverse ++ stackPrefix) suffix evmAfter ∧
      evmAfter.pc = state.pc + EvmYul.UInt256.ofNat 1 ∧
      ∀ {tailTrace : OpenExternal.OpenTrace}
        {result : Except EVMException Assembly.StepResult},
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult program fuel evmAfter)
          tailTrace result →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Source.openRunNResult program (fuel + 1) state)
          tailTrace result := by
  let targetState : EvmYul.EVM.State :=
    { state with toSharedState := compiler.shared }
  have hGasRel :
      Assembly.GasAware.GasExecRel state targetState := by
    simpa [targetState] using
      StackPrefixSuffixErasedRel.gasExecRel_targetShared hPrefixRel
  rcases hPrefixRel with ⟨_hErase, storeBase, hStack, hStoreRel⟩
  have hTargetShared : targetState.toSharedState = compiler.shared := by
    simp [targetState]
  have hTargetStack :
      targetState.stack =
        values.reverse ++ (stackPrefix ++ storeBase ++ suffix) := by
    simp [targetState, hStack, List.append_assoc]
  rcases
      hPrim.eval_step_exists
        (op := op) (shared := compiler.shared)
        (shared' := sharedAfter) (values := values)
        (values' := valuesAfter) (evm := targetState)
        (baseStack := stackPrefix ++ storeBase ++ suffix)
        hEval hTargetShared hTargetStack with
    ⟨targetAfter, hTargetStep, hAfterShared, hAfterStack⟩
  have hTargetPrim :
      op.toPrimOp.step targetState = .ok targetAfter := by
