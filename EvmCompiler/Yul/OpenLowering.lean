          EvmYul.UInt256.ofNat entryDest := by
      rfl
    have hAfterJumpGas :
        SourceStateTargetGasRel cfg sourceState
          (Assembly.Source.jumpPc entryDest afterPrologue) :=
      SourceStateTargetGasRel.of_target_gasAvailable_eq hFinalGas
        (by simp [Assembly.Source.jumpPc])
    rcases
        hRest (Assembly.Source.jumpPc entryDest afterPrologue)
          hAfterJumpRel hAfterJumpPc hAfterJumpGas with
      ⟨fuelAfterJump, targetResult, hAfterJumpTrace,
        hAfterJumpReady, hResultRel⟩
    let hAfterJumpTrace' :
        OpenAssembly.Source.OpenTraceResult
          ((pre ++ prologue) ++ [Assembly.Instr.jump entryLabel] ++ post)
          fuelAfterJump (Assembly.Source.jumpPc entryDest afterPrologue)
          tailTrace targetResult := by
      simpa [prologue, List.append_assoc] using hAfterJumpTrace
    have hAfterJumpReady' :
        SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg)
          hAfterJumpTrace' := by
      simpa [prologue, List.append_assoc] using hAfterJumpReady
    rcases
        SourceOpenTraceCurrentSharedBridgeReadyFor.source_jump_no_call_running_continue_exists
          (cfg := cfg) (pre := pre ++ prologue) (post := post)
          (label := entryLabel) (state := afterPrologue)
          (dest := entryDest) (fuel := fuelAfterJump)
          (tailTrace := tailTrace) (result := targetResult)
