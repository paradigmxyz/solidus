theorem of_source_state_rel_stackPrefixSuffixErasedRel
    {cfg : Reference.StateRelConfig}
    {sourceLayout layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {sourceStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {target : EvmYul.EVM.State}
    {stackPrefix suffix : List Word}
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg sourceLayout
        (.Ok sourceShared sourceStore) compiler)
    (hRel :
      StackPrefixSuffixErasedRel layout compiler stackPrefix suffix target)
    (hGasRel :
      cfg.gasAvailableRel sourceShared.gasAvailable target.gasAvailable) :
    FunctionsOpenCurrentSharedStateBridgeRel cfg target := by
  cases hSourceRel with
  | ok hShared _hVars =>
      rcases hShared with ⟨hChain, hMachine⟩
      rcases hRel with ⟨hErase, _storeBase, _hStack, _hStoreRel⟩
      cases target
      cases compiler
      simp [Structured.Preservation.eraseControl, Assembly.eraseGas] at hErase hChain hMachine hGasRel ⊢
      rcases hErase with
        ⟨hToState, hActiveWords, hMemory, hReturnData, hHReturn⟩
      refine ⟨sourceShared, ?_⟩
      constructor
      · rw [hToState]
        exact hChain
      · constructor
        · exact hGasRel
        · rw [hActiveWords]
          exact hMachine.activeWords
        · rw [hMemory]
          exact hMachine.memory
        · rw [hReturnData]
          exact hMachine.returnData
        · rw [hHReturn]
          exact hMachine.H_return

