def functionsFunDefRegularOpenSupported?
    (programSource : Functions.Program) (fn : Functions.FunDef) : Bool :=
  Functions.SourceAcceptedCheck.FunDef.scoped? fn &&
    (Functions.SourceDirect.FrameBound.funDef? fn &&
      (decide (fn.params.length ≤ 16) &&
        (decide (fn.returns.length < 16) &&
          functionsStmtListRegularOpenSupportedFor? programSource
            fn.returns
            (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
            fn.body.stmts)))

theorem functionsFunDefRegularOpenSupported?_sound
    {programSource : Functions.Program} {fn : Functions.FunDef}
    (hCheck :
      functionsFunDefRegularOpenSupported? programSource fn = true) :
    fn.Scoped ∧
      Functions.SourceDirect.FrameBound.FunDef fn ∧
        fn.params.length ≤ 16 ∧
          fn.returns.length < 16 ∧
            FunctionsStmtListRegularOpenSupportedFor programSource
              fn.returns
              (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
              fn.body.stmts := by
  unfold functionsFunDefRegularOpenSupported? at hCheck
  have hParts :
      Functions.SourceAcceptedCheck.FunDef.scoped? fn = true ∧
        (Functions.SourceDirect.FrameBound.funDef? fn &&
          (decide (fn.params.length ≤ 16) &&
            (decide (fn.returns.length < 16) &&
              functionsStmtListRegularOpenSupportedFor? programSource
                fn.returns
                (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
                fn.body.stmts))) = true := by
    simpa using hCheck
  have hFrameTail :
      Functions.SourceDirect.FrameBound.funDef? fn = true ∧
        (decide (fn.params.length ≤ 16) &&
          (decide (fn.returns.length < 16) &&
            functionsStmtListRegularOpenSupportedFor? programSource
              fn.returns
              (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
              fn.body.stmts)) = true := by
    simpa using hParts.2
  have hParamsTail :
      decide (fn.params.length ≤ 16) = true ∧
        (decide (fn.returns.length < 16) &&
          functionsStmtListRegularOpenSupportedFor? programSource
            fn.returns
            (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
            fn.body.stmts) = true := by
    simpa using hFrameTail.2
  have hReturnsTail :
      decide (fn.returns.length < 16) = true ∧
        functionsStmtListRegularOpenSupportedFor? programSource
          fn.returns
          (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
          fn.body.stmts = true := by
    simpa using hParamsTail.2
  exact
    ⟨Functions.SourceAcceptedCheck.FunDef.scoped_of_check hParts.1,
      Functions.SourceDirect.FrameBound.funDef_of_check hFrameTail.1,
      of_decide_eq_true hParamsTail.1,
      of_decide_eq_true hReturnsTail.1,
      functionsStmtListRegularOpenSupportedFor?_sound hReturnsTail.2⟩

def functionsFunListRegularOpenSupported?
    (programSource : Functions.Program) :
    List Functions.FunDef → Bool
  | [] => true
  | fn :: rest =>
      functionsFunDefRegularOpenSupported? programSource fn &&
        functionsFunListRegularOpenSupported? programSource rest

theorem functionsFunListRegularOpenSupported?_sound
    {programSource : Functions.Program} :
    ∀ {functions : List Functions.FunDef},
      functionsFunListRegularOpenSupported? programSource functions = true →
        ∀ {functionName : Name} {fn : Functions.FunDef},
          Functions.Source.FunList.find? functionName functions = some fn →
            fn.Scoped ∧
              Functions.SourceDirect.FrameBound.FunDef fn ∧
                fn.params.length ≤ 16 ∧
                  fn.returns.length < 16 ∧
                    FunctionsStmtListRegularOpenSupportedFor programSource
                      fn.returns
                      (Functions.SourceDirect.FunDef.targetBodyCtx fn).layout
                      fn.body.stmts
  | [], _hCheck, functionName, fn, hFind => by
      simp [Functions.Source.FunList.find?] at hFind
  | head :: rest, hCheck, functionName, fn, hFind => by
      have hAnd :
          functionsFunDefRegularOpenSupported? programSource head = true ∧
            functionsFunListRegularOpenSupported? programSource rest = true := by
        simpa [functionsFunListRegularOpenSupported?] using hCheck
      by_cases hName : head.name = functionName
      · have hFindHead : some head = some fn := by
          simpa [Functions.Source.FunList.find?, hName] using hFind
        cases hFindHead
        exact functionsFunDefRegularOpenSupported?_sound hAnd.1
      · have hFindTail :
            Functions.Source.FunList.find? functionName rest = some fn := by
          simpa [Functions.Source.FunList.find?, hName] using hFind
        exact functionsFunListRegularOpenSupported?_sound hAnd.2 hFindTail

def FunctionsProgramRegularOpenSupported? (programSource : Functions.Program) :
    Bool :=
  functionsStmtListRegularOpenSupportedFor? programSource [] []
      programSource.body.stmts &&
    functionsFunListRegularOpenSupported? programSource
      programSource.functions

theorem FunctionsProgramRegularOpenSupported?_sound
    {programSource : Functions.Program}
    (hCheck : FunctionsProgramRegularOpenSupported? programSource = true) :
    FunctionsProgramRegularOpenSupported programSource := by
  unfold FunctionsProgramRegularOpenSupported? at hCheck
  have hAnd :
      functionsStmtListRegularOpenSupportedFor? programSource [] []
          programSource.body.stmts = true ∧
        functionsFunListRegularOpenSupported? programSource
          programSource.functions = true := by
    simpa using hCheck
  exact
    ⟨functionsStmtListRegularOpenSupportedFor?_sound hAnd.1,
      functionsFunListRegularOpenSupported?_sound hAnd.2⟩

