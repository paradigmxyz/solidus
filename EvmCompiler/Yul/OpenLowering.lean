theorem yulOpenCall?_resume_state_eq_finishShared
    {kind : OpenExternal.CallKind} {args : List Word}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {call : OpenExternal.OpenCall (EvmYul.Yul.State × List Word)}
    (hCall :
      OpenExternal.CallKind.yulOpenCall? (.Ok shared store) kind args =
        some call)
    (response : OpenExternal.CallResponse) :
    (call.resume response).1 =
      .Ok (call.site.finishShared shared response) store := by
  unfold OpenExternal.CallKind.yulOpenCall? at hCall
  cases hSite : kind.yulCallSite? (.Ok shared store) args with
  | none =>
      simp [hSite] at hCall
  | some site =>
      simp [hSite] at hCall
      cases hCall
      simp

theorem evmOpenCall?_resume_toSharedState_eq_finishShared
    {kind : OpenExternal.CallKind}
    {state : EvmYul.EVM.State}
    {call : OpenExternal.OpenCall EvmYul.EVM.State}
    (hCall : OpenExternal.CallKind.evmOpenCall? state kind = some call)
    (response : OpenExternal.CallResponse) :
    (call.resume response).toSharedState =
      call.site.finishShared state.toSharedState response := by
  unfold OpenExternal.CallKind.evmOpenCall? at hCall
  cases hSite : kind.evmCallSite? state with
  | none =>
      simp [hSite] at hCall
  | some pair =>
      rcases pair with ⟨rest, site⟩
      simp [hSite] at hCall
      cases hCall
      simp

