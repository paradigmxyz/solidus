def SourceStateTargetGasRel
    (cfg : Reference.StateRelConfig) (source : Reference.State)
    (target : EvmYul.EVM.State) : Prop :=
  match source with
  | .Ok sourceShared _sourceStore =>
      cfg.gasAvailableRel sourceShared.gasAvailable target.gasAvailable
  | .OutOfFuel => False
  | .Checkpoint _ => False

