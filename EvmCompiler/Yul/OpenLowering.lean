    {pre post : Assembly.Program} {label : Assembly.Label}
    {state afterPop : EvmYul.EVM.State} {condTrue : Bool}
    {dest : Nat}
    {tailTrace : OpenExternal.OpenTrace}
    {ResultRel : Assembly.StepResult → Prop}
    (hFit : Structured.Preservation.PCFits pre)
    (hPc : state.pc = Assembly.Program.pcAfter pre)
    (hLabel :
      Assembly.Program.labelPc
        (pre ++ [Assembly.Instr.jumpi label] ++ post) label = some dest)
    (hPop : Structured.Code.popCondition state = .ok (afterPop, condTrue))
    (hGasRel : SourceStateTargetGasRel cfg sourceState state)
    (hRest :
      ∀ afterJump : EvmYul.EVM.State,
        Structured.Preservation.RelAt
          (if condTrue then
            EvmYul.UInt256.ofNat dest
          else
            Assembly.Program.pcAfter (pre ++ [Assembly.Instr.jumpi label]))
          afterJump afterPop →
        SourceStateTargetGasRel cfg sourceState afterJump →
        ∃ fuel : Nat,
          SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg
            (pre ++ [Assembly.Instr.jumpi label] ++ post) fuel afterJump
            tailTrace ResultRel) :
    ∃ fuel : Nat,
      SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg
        (pre ++ [Assembly.Instr.jumpi label] ++ post) fuel state tailTrace
        ResultRel := by
  have hAt :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.jumpi label] ++ post)
          state.pc.toNat =
        some (Assembly.Program.byteLength pre,
          Assembly.Instr.jumpi label) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.jumpi label) 0
  unfold Structured.Code.popCondition at hPop
  cases hStatePop : state.stack.pop with
  | none =>
      rw [hStatePop] at hPop
      cases hPop
  | some popped =>
      rcases popped with ⟨rest, cond⟩
      rw [hStatePop] at hPop
      simp at hPop
      cases hPop.1
      cases hPop.2
      let afterJump : EvmYul.EVM.State :=
        { state with
          pc :=
            if cond != EvmYul.UInt256.ofNat 0 then
              EvmYul.UInt256.ofNat dest
            else
              Assembly.Source.jumpiFallthroughPc state
          stack := rest }
      have hLabel' :
          Assembly.Program.labelPc
              (pre ++ Assembly.Instr.jumpi label :: post) label =
            some dest := by
        simpa using hLabel
      have hStep :
          Assembly.Source.stepResult
              (pre ++ [Assembly.Instr.jumpi label] ++ post) state =
            .ok (.running afterJump) := by
        unfold Assembly.Source.stepResult
        rw [hAt]
        unfold Assembly.Source.stepAtResult Assembly.Source.stepAt
        simp [hLabel', Assembly.Source.invalid, hStatePop, afterJump,
          Assembly.Instr.haltKind?]
      have hRelAfter :
          Structured.Preservation.RelAt
            (if cond != EvmYul.UInt256.ofNat 0 then
              EvmYul.UInt256.ofNat dest
            else
              Assembly.Program.pcAfter (pre ++ [Assembly.Instr.jumpi label]))
            afterJump { state with stack := rest } := by
        refine ⟨?_, ?_⟩
        · by_cases hCond : cond != EvmYul.UInt256.ofNat 0
          · simp [afterJump, hCond]
          · simp [afterJump, hCond]
            unfold Assembly.Source.jumpiFallthroughPc Assembly.Program.pcAfter
            calc
              state.pc + EvmYul.UInt256.ofNat Assembly.Instr.push32Size +
                  EvmYul.UInt256.ofNat 1
                  = EvmYul.UInt256.ofNat (Assembly.Program.byteLength pre) +
                      EvmYul.UInt256.ofNat Assembly.Instr.push32Size +
                        EvmYul.UInt256.ofNat 1 := by
                          rw [hPc]
                          rfl
              _ = EvmYul.UInt256.ofNat
                    (Assembly.Program.byteLength pre +
                      Assembly.Instr.push32Size) +
                      EvmYul.UInt256.ofNat 1 := by
                        rw [Assembly.UInt256_ofNat_add]
              _ = EvmYul.UInt256.ofNat
                    (Assembly.Program.byteLength pre +
                      Assembly.Instr.push32Size + 1) := by
                        rw [Assembly.UInt256_ofNat_add]
              _ = EvmYul.UInt256.ofNat
                    (Assembly.Program.byteLength
                      (pre ++ [Assembly.Instr.jumpi label])) := by
                        simp [Assembly.Program.byteLength_append,
                          Assembly.Program.byteLength, Assembly.Instr.byteSize,
                          Assembly.Instr.jumpSize]
                        rw [Nat.add_assoc]
        · simp [Structured.Preservation.SameData,
            Structured.Preservation.eraseControl, Assembly.eraseGas,
            afterJump]
      have hGasAfter :
          SourceStateTargetGasRel cfg sourceState afterJump :=
        SourceStateTargetGasRel.of_target_gasAvailable_eq hGasRel
          (by simp [afterJump])
      rcases hRest afterJump hRelAfter hGasAfter with
        ⟨fuel, targetResult, hTrace, hReady, hResultRel⟩
      have hNoInstr :
          Assembly.Instr.usesCallCreate (Assembly.Instr.jumpi label) = false := by
        simp [Assembly.Instr.usesCallCreate]
      rcases
          SourceOpenTraceCurrentSharedBridgeReadyFor.current_no_call_running_continue_of_current_instr_exists
            (cfg := cfg) hAt hNoInstr hStep hReady with
        ⟨hFullTrace, hFullReady⟩
      exact ⟨fuel + 1, targetResult, hFullTrace, hFullReady, hResultRel⟩

