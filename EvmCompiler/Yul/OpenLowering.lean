          SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg) hTrace) :
    ∃ fuel : Nat,
    ∃ hFullTrace :
      OpenAssembly.Source.OpenTraceResult
        (pre ++ (Structured.Dispatch.forProc proc sites supply).code ++ post)
