theorem initReturns_frameStateRel_running_of_compileOpen
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {ctx finalCtx : Locals.Ctx}
    {returns : List Name} {stmts : List Expressions.Stmt}
    {state final : Locals.RunState} {target : EvmYul.EVM.State}
    {tokens : List Word}
    {structuredCtx : Structured.CompileContext}
    {supply : Structured.LabelSupply}
    (hCompile :
      Locals.Block.compileOpen ctx
        { stmts := Functions.Lower.initReturns returns } =
        some (stmts, finalCtx))
    (segment :
      Structured.Preservation.CodeSegment program
        (Structured.Block.compileFromCtx
          { stmts := Expressions.StmtList.toStructured stmts }
          structuredCtx supply).code)
    (hPc :
      target.pc = Structured.Preservation.CodeSegment.startPc segment)
    (hRel :
      Structured.Preservation.Frame.StateRel state target tokens)
    (hRun :
      Functions.Direct.initReturns returns ctx state = .ok (final, finalCtx)) :
    ∃ initFuel targetFinal,
      Structured.Preservation.Frame.StateRel final targetFinal tokens ∧
        targetFinal.pc =
          Structured.Preservation.CodeSegment.fallthroughPc segment ∧
        SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg program initFuel
          target [] (fun result => result = .running targetFinal) := by
  induction returns generalizing ctx finalCtx stmts state final target
      structuredCtx supply with
  | nil =>
      have hNil : stmts = [] ∧ ctx = finalCtx := by
        simpa [Functions.Lower.initReturns, Locals.Block.compileOpen] using
          hCompile
      rcases hNil with ⟨hStmts, hFinalCtx⟩
      subst stmts
      subst finalCtx
      simp [Functions.Direct.initReturns] at hRun
      cases hRun
      have hSegmentCode :
          (Structured.Block.compileFromCtx
              { stmts := Expressions.StmtList.toStructured ([] :
                  List Expressions.Stmt) }
              structuredCtx supply).code = [] := by
        simp [Expressions.StmtList.toStructured,
          Structured.Block.compileFromCtx]
      let emptySegment :
          Structured.Preservation.CodeSegment program [] :=
        Structured.Preservation.CodeSegment.cast_code hSegmentCode segment
      have hStart :
          Structured.Preservation.CodeSegment.startPc emptySegment =
            Structured.Preservation.CodeSegment.startPc segment := by
        simp [emptySegment, Structured.Preservation.CodeSegment.cast_code,
          Structured.Preservation.CodeSegment.startPc]
      have hFall :
          Structured.Preservation.CodeSegment.fallthroughPc emptySegment =
            Structured.Preservation.CodeSegment.fallthroughPc segment := by
        cases segment with
        | mk pre post hAsm hFits =>
            simp [emptySegment, Structured.Preservation.CodeSegment.cast_code,
              Structured.Preservation.CodeSegment.fallthroughPc,
              hSegmentCode]
      have hEmpty :
          Structured.Preservation.CodeSegment.fallthroughPc emptySegment =
            Structured.Preservation.CodeSegment.startPc emptySegment :=
        codeSegment_fallthroughPc_empty emptySegment
      have hPcFall :
          target.pc =
            Structured.Preservation.CodeSegment.fallthroughPc segment := by
        calc
          target.pc =
              Structured.Preservation.CodeSegment.startPc segment := hPc
          _ =
              Structured.Preservation.CodeSegment.startPc emptySegment :=
                hStart.symm
          _ =
              Structured.Preservation.CodeSegment.fallthroughPc
                emptySegment := hEmpty.symm
          _ =
              Structured.Preservation.CodeSegment.fallthroughPc segment :=
                hFall
      let hDone :
          OpenAssembly.Source.OpenTraceResult program 0 target []
            (.running target) :=
        OpenAssembly.Source.OpenTraceResult.done (program := program) target
      have hDoneReady :
          SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg) hDone :=
        SourceOpenTraceCurrentSharedBridgeReadyFor.done target
      exact
        ⟨0, target, hRel, hPcFall,
          SourceOpenTraceCurrentSharedBridgeReadyResultRel.of_trace hDone
            hDoneReady rfl⟩
  | cons name rest ih =>
      rcases localsBlock_compileOpen_let_cons_inv hCompile with
        ⟨code, restStmts, hCode, hRestCompile, hStmts⟩
      subst stmts
      have hCodeDirect :
          Locals.Expr.compileCode ctx 0 (.lit Functions.Direct.zero) =
            some code := by
        simpa [Functions.Direct.zero, Functions.Lower.zero] using hCode
      simp [Functions.Direct.initReturns] at hRun
      cases hLetRun :
          Locals.Direct.Expr.runState ctx (.lit Functions.Direct.zero)
            state with
      | error err =>
          simp [hLetRun] at hRun
      | ok stateAfterLet =>
          simp [hLetRun] at hRun
          rcases codeSegment_expressions_codeStmt_cons_split segment with
            ⟨headSegment, tailSegment, hHeadStart, hTailStart, hTailFall⟩
          have hHeadPc :
              target.pc =
                Structured.Preservation.CodeSegment.startPc headSegment := by
            rw [hPc, ← hHeadStart]
          have hRunState :
              Structured.Code.runState code state = .ok stateAfterLet := by
            rw [← Locals.Direct.Expr.runState_eq_compileCode
              ctx (.lit Functions.Direct.zero) code state hCodeDirect]
            exact hLetRun
          have hSafe :
              Structured.Preservation.Code.RunnerSafe code :=
            structuredCode_runnerSafe_lit_compileCode hCodeDirect
          have hFrame :
              Structured.Code.FrameSafe code :=
            structuredCode_frameSafe_lit_compileCode hCodeDirect
          have hNoCall :
              Structured.Code.usesCallCreate code = false :=
            structuredCode_noCall_lit_compileCode hCodeDirect
          rcases
              codeSegment_no_call_frameStateRel_running_continue_exists
                (cfg := cfg) headSegment hSafe hFrame hNoCall hHeadPc
                hRel hRunState
                (by
                  intro targetAfterLet hRelAfterLet hAfterLetPc
                  have hTailPc :
                      targetAfterLet.pc =
                        Structured.Preservation.CodeSegment.startPc
                          tailSegment := by
                    calc
                      targetAfterLet.pc =
                          Structured.Preservation.CodeSegment.fallthroughPc
                            headSegment := hAfterLetPc
                      _ =
                          Structured.Preservation.CodeSegment.startPc
                            tailSegment := hTailStart.symm
                  rcases
                      ih (ctx := ctx.withLayout (name :: ctx.layout))
                        (finalCtx := finalCtx) (stmts := restStmts)
                        (state := stateAfterLet) (final := final)
                        (target := targetAfterLet)
                        (structuredCtx := structuredCtx) (supply := supply)
                        hRestCompile tailSegment hTailPc hRelAfterLet hRun with
                    ⟨tailFuel, targetFinal, hRelFinal, hFinalPcTail,
                      hTailRel⟩
                  have hFinalPc :
                      targetFinal.pc =
                        Structured.Preservation.CodeSegment.fallthroughPc
                          segment := by
                    calc
                      targetFinal.pc =
                          Structured.Preservation.CodeSegment.fallthroughPc
                            tailSegment := hFinalPcTail
                      _ =
                          Structured.Preservation.CodeSegment.fallthroughPc
                            segment := hTailFall
                  exact
                    ⟨tailFuel,
                      by
                        rcases hTailRel with
                          ⟨targetResult, hTrace, hReady, hResultRel⟩
                        have hPacked :
                            (fun result =>
                              ∃ targetFinal,
                                Structured.Preservation.Frame.StateRel final
                                  targetFinal tokens ∧
                                targetFinal.pc =
                                  Structured.Preservation.CodeSegment.fallthroughPc
                                    segment ∧
                                result = .running targetFinal) targetResult :=
                          ⟨targetFinal, hRelFinal, hFinalPc, hResultRel⟩
                        exact
                          SourceOpenTraceCurrentSharedBridgeReadyResultRel.of_trace
                            hTrace hReady hPacked⟩) with
            ⟨initFuel, hInitRel⟩
          rcases hInitRel with
            ⟨targetResult, hTrace, hReady, hResultRel⟩
          rcases hResultRel with
            ⟨targetFinal, hRelFinal, hFinalPc, hResultRel⟩
          cases hResultRel
          exact
            ⟨initFuel, targetFinal, hRelFinal, hFinalPc,
              ⟨.running targetFinal, hTrace, hReady, rfl⟩⟩

