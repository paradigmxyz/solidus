theorem selected_table_source_running_continue_exists_sourceGasRel
    {cfg : Reference.StateRelConfig}
    {sourceState : Reference.State}
    {base : Structured.LabelSupply} {retc idx : Nat}
    {casePrefix post pre : Assembly.Program}
