theorem sourceStateRel_funDef_body_entry_exists
    {cfg : Reference.StateRelConfig} {callerSourceLayout : List Name}
    {sourceAfterRef : Reference.State}
    {sourceAfterArgs : Objects.Source.State}
    {fn : Functions.FunDef} {argValues : List Word}
    {paramStore : Functions.Source.Store}
    (hScoped : fn.Scoped)
    (hParams :
      Functions.Source.Store.insertMany fn.params argValues
        Locals.Source.Store.empty = some paramStore)
    (hSourceAfterRef :
      Reference.SourceBridgeFacts.SourceStateRel cfg callerSourceLayout
        sourceAfterRef sourceAfterArgs) :
    ∃ sourceBodyRef : Reference.State,
      Reference.SourceBridgeFacts.SourceStateRel cfg
        (Functions.SourceDirect.FunDef.sourceBodyCtx fn).scope
        sourceBodyRef
        { shared := sourceAfterArgs.shared,
          vars := Functions.Source.Store.initReturns fn.returns paramStore } ∧
      ∀ {target : EvmYul.EVM.State},
        SourceStateTargetGasRel cfg sourceAfterRef target →
        SourceStateTargetGasRel cfg sourceBodyRef target := by
  cases hSourceAfterRef with
  | @ok sourceShared sourceStore _ hShared _hVars =>
      have hSignature : (fn.returns ++ fn.params).Nodup :=
        Functions.FunDef.signatureNodup hScoped
      have hParamsNoDup : fn.params.Nodup :=
        List.Nodup.of_append_right hSignature
      have hReturnsNoDup : fn.returns.Nodup :=
        List.Nodup.of_append_left hSignature
      have hParamNotReturn :
          ∀ name, name ∈ fn.params → name ∉ fn.returns := by
        intro name hParam hReturn
        rcases List.nodup_append.mp hSignature with
          ⟨_hReturns, _hParams, hNoOverlap⟩
        exact hNoOverlap name hReturn name hParam rfl
      let bodyCompiler : Objects.Source.State :=
        { shared := sourceAfterArgs.shared,
          vars := Functions.Source.Store.initReturns fn.returns paramStore }
      have hAllSome :
          ∀ name,
            name ∈ (Functions.SourceDirect.FunDef.sourceBodyCtx fn).scope →
              ∃ value, bodyCompiler.vars name = some value := by
        intro name hMem
        have hScope :
            (Functions.SourceDirect.FunDef.sourceBodyCtx fn).scope =
              fn.returns ++ fn.params := by
          simp [Functions.SourceDirect.FunDef.sourceBodyCtx,
            Functions.Source.FunDef.bodyCtx]
        rw [hScope] at hMem
        simp only [List.mem_append] at hMem
        rcases hMem with hReturn | hParam
        · exact
            ⟨Functions.Source.zero, by
              simpa [bodyCompiler] using
                source_initReturns_lookup_some_of_mem_nodup
                  (names := fn.returns) (store := paramStore)
                  (name := name) hReturnsNoDup hReturn⟩
        · rcases
            source_insertMany_lookup_some_of_mem_nodup
              (names := fn.params) (values := argValues)
              (store := Locals.Source.Store.empty)
              (store' := paramStore) (name := name)
              hParams hParamsNoDup hParam with
            ⟨value, hValue⟩
          have hPreserve :
              Functions.Source.Store.initReturns fn.returns paramStore name =
                paramStore name :=
            source_initReturns_preserves_of_not_mem
              (names := fn.returns) (store := paramStore)
              (name := name) (hParamNotReturn name hParam)
          exact ⟨value, by simpa [bodyCompiler, hPreserve] using hValue⟩
      rcases sourceStoreRel_exists_of_all_visible_some hAllSome with
        ⟨bodyStore, hBodyStoreRel⟩
      let sourceBodyRef : Reference.State := .Ok sourceShared bodyStore
      refine ⟨sourceBodyRef, ?_, ?_⟩
      · exact Reference.SourceBridgeFacts.SourceStateRel.ok hShared hBodyStoreRel
      · intro target hGas
        simpa [sourceBodyRef, SourceStateTargetGasRel] using hGas

