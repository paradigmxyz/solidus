      cases hMem
  | [], _value :: _values, _store, _store', _name, hInsert, _hNoDup,
      _hMem => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | _head :: _tail, [], _store, _store', _name, hInsert, _hNoDup,
      _hMem => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | head :: tail, value :: values, store, store', name, hInsert, hNoDup,
      hMem => by
      unfold Functions.Source.Store.insertMany at hInsert
      simp only [List.mem_cons] at hMem
      rcases hMem with hEq | hTailMem
      · subst name
        have hPreserve :=
          source_insertMany_preserves_of_not_mem
            (names := tail) (values := values)
            (store := Locals.Source.Store.insert store head value)
            (store' := store') (name := head) hInsert hNoDup.notMem
        exact ⟨value, by
          simpa [Locals.Source.Store.insert_self] using hPreserve⟩
      · exact
          source_insertMany_lookup_some_of_mem_nodup
            (names := tail) (values := values)
            (store := Locals.Source.Store.insert store head value)
            (store' := store') (name := name) hInsert hNoDup.tail hTailMem

