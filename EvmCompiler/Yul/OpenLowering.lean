          hStep hBridge hRestAppReady
      simpa [openTraceResult_append_running_of_result, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm, List.append_assoc] using hStepReady
  | stepHalted hStep =>
      cases hPrefixResult

