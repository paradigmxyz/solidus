                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
            | switch scrutinee cases defaultBody =>
                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
            | for_ init cond post body =>
                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
            | brk =>
                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
            | cont =>
                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
            | leave =>
                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
            | terminal kind =>
                simp [FunctionsStmtListRegularOpenSupportedFor] at hSupported
