      constructor
      · rw [hToState]
        exact hChain
      · constructor
        · exact hGasRel
        · rw [hActiveWords]
          exact hMachine.activeWords
        · rw [hMemory]
          exact hMachine.memory
        · rw [hReturnData]
          exact hMachine.returnData
        · rw [hHReturn]
