theorem source_code_no_call_relAt_running_continue_exists
    {cfg : Reference.StateRelConfig}
    {pre post : Assembly.Program} {code : Structured.Code}
    {source target source' : EvmYul.EVM.State}
    {tailTrace : OpenExternal.OpenTrace}
    {ResultRel : Assembly.StepResult → Prop}
    (hSafe : Structured.Preservation.Code.RunnerSafe code)
    (hNoCall : Structured.Code.usesCallCreate code = false)
    (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
    (hRel :
      Structured.Preservation.RelAt
        (Assembly.Program.pcAfter pre) target source)
    (hRun : Structured.Code.run code source = .ok source')
    (hRest :
      ∀ targetFinal,
        Structured.Preservation.RelAt
          (Assembly.Program.pcAfter (pre ++ code.toAssembly))
          targetFinal source' →
        ∃ fuel : Nat,
          SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg
            (pre ++ code.toAssembly ++ post) fuel targetFinal tailTrace
            ResultRel) :
    ∃ fuel : Nat,
      SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg
        (pre ++ code.toAssembly ++ post) fuel target tailTrace ResultRel := by
  induction code generalizing pre source target with
  | nil =>
      simp [Structured.Code.run] at hRun
      cases hRun
      rcases hRest target (by simpa [Structured.Code.toAssembly] using hRel) with
        ⟨fuel, hRestRel⟩
      exact ⟨fuel, by simpa [Structured.Code.toAssembly] using hRestRel⟩
  | cons instr rest ih =>
      cases hSafe with
      | cons hInstr hRestSafe =>
          unfold Structured.Code.run at hRun
          cases hStep : instr.step source with
          | error err =>
              rw [hStep] at hRun
              cases hRun
          | ok sourceMid =>
              rw [hStep] at hRun
              have hNoParts :
                  instr.usesCallCreate = false ∧
                    Structured.Code.usesCallCreate rest = false := by
                simpa [Structured.Code.usesCallCreate] using hNoCall
              rcases hFits with ⟨hFitHere, hFitsRest⟩
              obtain ⟨targetMid, hAssemblyStep, hRelMid⟩ :=
                Structured.Preservation.BasicInstr.source_stepResult_ctx_relAt_of_relAt
                  (instr := instr) (pre := pre)
                  (post := Structured.Code.toAssembly rest ++ post)
                  hInstr hFitHere hRel hStep
              rcases
                  ih (pre := pre ++ [instr.toAssembly])
                    (source := sourceMid) (target := targetMid)
                    hRestSafe hNoParts.2 hFitsRest hRelMid hRun
                    (by
                      intro targetFinal hRelFinal
                      rcases
                          hRest targetFinal
                            (by
                              simpa [Structured.Code.toAssembly,
                                List.append_assoc] using hRelFinal) with
                        ⟨fuel, hRestRel⟩
                      exact
                        ⟨fuel,
                          by
                            simpa [Structured.Code.toAssembly,
                              List.append_assoc] using hRestRel⟩) with
                ⟨fuelRest, hRestRel⟩
              have hAt :
                  Assembly.Program.instrAtPc
                    (pre ++ [instr.toAssembly] ++
                      (Structured.Code.toAssembly rest ++ post))
                    target.pc.toNat =
                    some (Assembly.Program.byteLength pre,
                      instr.toAssembly) := by
                unfold Assembly.Program.instrAtPc
                rw [hRel.pc_eq, hFitHere]
                simpa using
                  Assembly.Program.instrAtPcFrom_append_boundary_cons
                    pre (Structured.Code.toAssembly rest ++ post)
                    instr.toAssembly 0
              have hNoInstr :
                  Assembly.Instr.usesCallCreate instr.toAssembly = false := by
                simpa [Structured.BasicInstr.toAssembly_usesCallCreate]
                  using hNoParts.1
              have hStepResult :
                  Assembly.Source.stepResult
                    (pre ++ [instr.toAssembly] ++
                      (Structured.Code.toAssembly rest ++ post)) target =
                    .ok (.running targetMid) := by
                simpa [List.append_assoc] using hAssemblyStep
              have hRestCurrent :
                  SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg
                    (pre ++ [instr.toAssembly] ++
                      (Structured.Code.toAssembly rest ++ post))
                    fuelRest targetMid tailTrace ResultRel := by
                simpa [List.append_assoc] using hRestRel
              have hCurrent :
                  SourceOpenTraceCurrentSharedBridgeReadyResultRel cfg
                    (pre ++ [instr.toAssembly] ++
                      (Structured.Code.toAssembly rest ++ post))
                    (fuelRest + 1) target tailTrace ResultRel :=
                current_no_call_running_continue_of_current_instr
                  (cfg := cfg) hAt hNoInstr hStepResult hRestCurrent
              exact
                ⟨fuelRest + 1,
                  by
                    simpa [Structured.Code.toAssembly, List.append_assoc]
                      using hCurrent⟩

theorem structuredBasicInstr_source_stepResult_ctx_relAt_of_relAt_gasAvailable_eq
    {instr : Structured.BasicInstr}
    {pre post : Assembly.Program}
    {source target source' : EvmYul.EVM.State}
    (hSafe : Structured.Preservation.BasicInstr.RunnerSafe instr)
    (hNoCall : instr.usesCallCreate = false)
    (hFit : Structured.Preservation.PCFits pre)
    (hRel :
      Structured.Preservation.RelAt (Assembly.Program.pcAfter pre) target
        source)
    (hStep : instr.step source = .ok source') :
    ∃ target',
      Assembly.Source.stepResult (pre ++ instr.toAssembly :: post) target =
          .ok (.running target') ∧
        Structured.Preservation.RelAt
          (Assembly.Program.pcAfter (pre ++ [instr.toAssembly]))
          target' source' ∧
        target'.gasAvailable = target.gasAvailable := by
  obtain ⟨target', hTargetStep, hEq⟩ :=
    hSafe.controlSafe hRel.sameData hStep
  have hStepResult :
      Assembly.Source.stepResult (pre ++ instr.toAssembly :: post) target =
        .ok (.running target') := by
    unfold Assembly.Source.stepResult
    have hAt :
        Assembly.Program.instrAtPc (pre ++ instr.toAssembly :: post)
            target.pc.toNat =
          some (Assembly.Program.byteLength pre, instr.toAssembly) := by
      unfold Assembly.Program.instrAtPc
      rw [hRel.pc_eq, hFit]
      simpa using
        Assembly.Program.instrAtPcFrom_append_boundary_cons
          pre post instr.toAssembly 0
    rw [hAt]
    simp [Assembly.Source.stepAtResult,
      Structured.Preservation.BasicInstr.source_stepAt_eq_step,
      hTargetStep,
      Structured.Preservation.BasicInstr.toAssembly_haltKind?_none,
      Bind.bind, Except.bind]
  have hRelTarget :
      Structured.Preservation.RelAt
        (Assembly.Program.pcAfter (pre ++ [instr.toAssembly]))
        target' source' := by
    refine ⟨?_, hEq⟩
    calc
      target'.pc
          = target.pc + EvmYul.UInt256.ofNat instr.toAssembly.byteSize :=
              hSafe.stepPC hTargetStep
      _ = Assembly.Program.pcAfter pre +
            EvmYul.UInt256.ofNat instr.toAssembly.byteSize := by
              rw [hRel.pc_eq]
      _ = EvmYul.UInt256.ofNat (Assembly.Program.byteLength pre) +
            EvmYul.UInt256.ofNat instr.toAssembly.byteSize := by
              rfl
      _ = EvmYul.UInt256.ofNat
            (Assembly.Program.byteLength pre + instr.toAssembly.byteSize) := by
              rw [Assembly.UInt256_ofNat_add]
      _ = Assembly.Program.pcAfter (pre ++ [instr.toAssembly]) := by
              simp [Assembly.Program.pcAfter,
                Assembly.Program.byteLength_append,
                Assembly.Program.byteLength]
  have hGas :
      target'.gasAvailable = target.gasAvailable :=
    structuredBasicInstr_step_no_call_gasAvailable_eq hNoCall hTargetStep
  exact ⟨target', hStepResult, hRelTarget, hGas⟩

