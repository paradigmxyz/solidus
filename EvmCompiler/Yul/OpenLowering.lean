  unfold FunctionsProgramCompileCheckedRegularOpenAssemblyTarget? at hCompileTarget
  cases hSupported : FunctionsProgramRegularOpenSupported? program with
  | false =>
      simp [hSupported] at hCompileTarget
  | true =>
      simp [hSupported] at hCompileTarget
      exact ⟨rfl, hCompileTarget⟩

