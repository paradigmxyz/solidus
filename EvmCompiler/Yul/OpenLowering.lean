      SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg) hPrefix)
    (hSuffixReady :
      SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg) hSuffix) :
    SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg)
      (openTraceResult_append_running_of_result hPrefix hPrefixResult
        hSuffix) := by
  induction hPrefixReady generalizing mid suffixFuel suffixTrace result with
  | done state =>
      cases hPrefixResult
      simpa [openTraceResult_append_running_of_result] using hSuffixReady
  | stepRunning hStep hBridge hRestReady ih =>
      have hRestAppReady := ih hPrefixResult hSuffixReady
      have hStepReady :=
