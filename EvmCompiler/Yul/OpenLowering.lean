    {response : OpenExternal.CallResponse}
    (hCallRel :
      Reference.SharedStateRel.OpenCallRelAt cfg sourceShared compilerShared
        (Reference.SourceBridgeFacts.SourceStateRel.OpenPrimitiveEVMResultRel
          cfg layout baseStack) sourceCall evmCall)
    (hResponse :
      Reference.SharedStateRel.OpenExternalResponseRel cfg sourceShared
        compilerShared response) :
