      Reference.SourceBridgeFacts.SourceStateRel.OpenPrimitiveEVMResultRel
        cfg layout baseStack sourceResult evmResult) :
    SourceStateTargetGasRel cfg sourceResult.1 evmResult := by
  rcases sourceResult with ⟨sourceState, sourceValues⟩
  rcases hRel with ⟨compilerResult, hSourceCompiler, hCompilerEVM⟩
  rcases hSourceCompiler with ⟨hSourceRel, _hValues⟩
  rcases hCompilerEVM with ⟨hSharedEq, _hStack⟩
  cases hSourceRel with
  | ok hShared hVars =>
      simpa [SourceStateTargetGasRel, hSharedEq]
        using hShared.machine.gasAvailable

