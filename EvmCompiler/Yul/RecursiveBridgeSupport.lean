                  EvmYul.Yul.State.overwrite?, EvmYul.Yul.State.reviveJump,
                  EvmYul.Yul.State.revive] using hCaller
      | Leave shared store =>
          cases callee with
          | Ok sharedCallee storeCallee =>
              simpa [StateStoreDomainExact, EvmYul.Yul.State.setStore,
