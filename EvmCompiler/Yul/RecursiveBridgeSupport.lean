          match state' with
          | .Ok _ _ =>
              OpenExternal.YulOpenResult.toOpenResult
                (OpenExternal.YulOpen.execSeq fuel rest codeOverride state')
          | .OutOfFuel => .done (.ok state')
          | .Checkpoint _ => .done (.ok state')) := by
  simp [OpenExternal.YulOpen.execSeq]
  rw [OpenExternal.YulOpenResult.toOpenResult_bind]
  apply OpenExternal.OpenResult.bind_congr_next
  intro state'
  cases state' <;> rfl

theorem openResult_bind_ok_id
    {ε : Type u} {α : Type v} (result : OpenExternal.OpenResult ε α) :
    OpenExternal.OpenResult.bind result OpenExternal.OpenResult.ok = result := by
  exact
    OpenExternal.OpenResult.rec
      (motive_1 := fun result =>
        OpenExternal.OpenResult.bind result OpenExternal.OpenResult.ok =
          result)
      (motive_2 := fun externalCall =>
        OpenExternal.OpenResult.bind
            (OpenExternal.OpenResult.call externalCall)
            OpenExternal.OpenResult.ok =
          OpenExternal.OpenResult.call externalCall)
      (motive_3 := fun externalCreate =>
        OpenExternal.OpenResult.bind
            (OpenExternal.OpenResult.create externalCreate)
            OpenExternal.OpenResult.ok =
          OpenExternal.OpenResult.create externalCreate)
      (by
        intro doneResult
        cases doneResult <;> rfl)
      (by
        intro _ hCall
        exact hCall)
      (by
        intro _ hCreate
        exact hCreate)
      (by
        intro site resume ih
        rw [OpenExternal.OpenResult.bind_call]
        congr
        funext response
        exact ih response)
      (by
        intro site resume ih
        rw [OpenExternal.OpenResult.bind_create]
        congr
        funext response
        exact ih response)
      result

