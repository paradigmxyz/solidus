    EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall, hPrim] at hExecBlock
  exact hExecBlock.symm

theorem execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
    {sourceFuel : Nat} {source sourceAfterArgs : State}
    {yulPrim : EvmYul.Operation .Yul} {args : List AstExpr}
