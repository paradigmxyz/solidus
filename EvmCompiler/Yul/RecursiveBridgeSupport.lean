theorem compilerOpen_block_runOpen_generated_terminalArgs_tail_resolves
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfterArgs : Functions.Source.Ctx}
    {kind : Assembly.HaltKind}
    {preArgs lowerTail : List Functions.Stmt}
    {argExprs : List (Locals.Expr 1)} {names : List Name}
    {seq : Locals.ExprSeq kind.argCount}
    {sourceArgsResult : State × List Word}
    {targetArgsResult : Functions.Source.Outcome × Functions.Source.Ctx}
    {compiler compilerAfterArgs : Objects.Source.State}
    {argsTrace : OpenExternal.OpenTrace}
    {argsFuel terminalFuel : Nat}
    {sharedAfter : EvmYul.SharedState .EVM}
    (hLowerVars :
      argExprs = names.map (fun name => (.var name : Locals.Expr 1)))
    (hSeq : Expr.List.toStackSeq? argExprs kind.argCount = some seq)
    (hArgsDone :
      SourceArgTerminalRawPreludeOpenDoneRel cfg layout terminalRel revertRel
        prim argExprs (.ok sourceArgsResult) (.ok targetArgsResult))
    (hTargetArgs :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx argsFuel
          { stmts := preArgs } compiler)
        argsTrace (.ok targetArgsResult))
    (hTerminal :
      prim.terminal kind compilerAfterArgs.shared sourceArgsResult.2 =
        .ok sharedAfter)
    (hTargetArgsEq :
      targetArgsResult =
        (Functions.Source.Outcome.regular compilerAfterArgs, ctxAfterArgs)) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx
        ((preArgs ++ [Functions.Stmt.terminalArgs kind seq]).length +
          (argsFuel + terminalFuel + 2))
        { stmts :=
          preArgs ++ [Functions.Stmt.terminalArgs kind seq] ++ lowerTail }
        compiler)
      argsTrace
      (.ok
        (Functions.Source.Outcome.halt kind
          (compilerAfterArgs.withShared sharedAfter), ctxAfterArgs)) := by
  subst targetArgsResult
  rcases
      sourceArgTerminalRawPreludeOpenDoneRel_toStackSeq_generated
        (cfg := cfg) (layout := layout) (terminalRel := terminalRel)
        (revertRel := revertRel) (prim := prim) (argExprs := argExprs)
        (names := names) (results := kind.argCount) (seq := seq)
        (sourceArgsResult := sourceArgsResult)
        (targetArgsResult :=
          (Functions.Source.Outcome.regular compilerAfterArgs, ctxAfterArgs))
        hLowerVars hSeq hArgsDone with
    ⟨hEvalSeq, _hStackRel⟩
  have hTerminalResolve :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctxAfterArgs 2
          { stmts := [Functions.Stmt.terminalArgs kind seq] }
          compilerAfterArgs)
        [] (.ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfterArgs)) :=
    compilerOpen_block_runOpen_singleton_terminalArgs_resolves
      (prim := prim) (program := program) (ctx := ctxAfterArgs)
      (kind := kind) (seq := seq) (state := compilerAfterArgs)
      (stateAfterArgs := compilerAfterArgs)
      (values := sourceArgsResult.2) (sharedAfter := sharedAfter)
