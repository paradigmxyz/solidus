            none :=
        yulPrimitiveEvalValuesOpenCreate?_none_of_safe_primitive hSafePrim
      have hNoCreateKind :
          OpenExternal.CreateKind.ofYulOperation? prim = none :=
        createKind_ofYulOperation?_none_of_safe_primitive hSafePrim
      simp [hNoOpen, hNoCreate, hNoCreateKind]
      exact
        multifill'_toOpenResult_doneInvariant_checkpointStoreContains
          (primCall_safe_toOpenResult_doneInvariant_checkpointStoreContains
            hSafePrim hArgsAllowed hArgsContains)
    · rcases hExternalKind with hCallKind | hCreateKind
      · rcases hCallKind with ⟨kind, hKind⟩
        have hPrimEq : prim = kind.toYulOperation :=
          OpenExternal.CallKind.toYulOperation_eq_ofYulOperation? hKind
        subst prim
        cases hOpen :
            OpenExternal.CallKind.yulPrimitiveEvalValuesOpenCall?
                stateArgs kind.toYulOperation argValues with
        | none =>
            have hNoCreate :
                OpenExternal.CreateKind.yulPrimitiveEvalValuesOpenCreate?
                    stateArgs kind.toYulOperation argValues =
                  none :=
              yulPrimitiveEvalValuesOpenCreate?_none_of_callKind
            have hNoCreateKind :
                OpenExternal.CreateKind.ofYulOperation? kind.toYulOperation =
                  none := by
              cases kind <;> rfl
            simp [hOpen, hNoCreate, hNoCreateKind]
            exact
              multifill'_toOpenResult_doneInvariant_checkpointStoreContains
                (primCall_callKind_toOpenResult_doneInvariant_checkpointStoreContains_of_no_open
                  hArgsAllowed hArgsContains hOpen)
        | some call =>
            simp [hOpen]
            exact
              YulOpenPairStateDoneInv.bind_state
                (yulPrimitiveEvalValuesOpenCall?_toOpenResult_doneInvariant_checkpointStoreContains_status
                  hArgsAllowed hArgsContains hOpen)
                (by
                  intro stateAfter values hStateAfter
                  exact
                    OpenResultDoneInvariant.done
                      (StateCheckpointStoreContains.multifill hStateAfter))
      · rcases hCreateKind with ⟨kind, hKind⟩
        have hPrimEq : prim = kind.toYulOperation :=
          OpenExternal.CreateKind.toYulOperation_eq_ofYulOperation? hKind
        subst prim
        have hNoOpen :
            OpenExternal.CallKind.yulPrimitiveEvalValuesOpenCall?
                stateArgs kind.toYulOperation argValues =
              none :=
          yulPrimitiveEvalValuesOpenCall?_none_of_createKind
        cases hCreate :
            OpenExternal.CreateKind.yulPrimitiveEvalValuesOpenCreate?
                stateArgs kind.toYulOperation argValues with
        | none =>
            simp [hNoOpen, hCreate, hKind]
            exact OpenResultDoneInvariant.done True.intro
        | some create =>
            simp [hNoOpen, hCreate]
            exact
              YulOpenPairStateDoneInv.bind_state
                (yulPrimitiveEvalValuesOpenCreate?_toOpenResult_doneInvariant_checkpointStoreContains_address
                  hArgsAllowed hArgsContains hCreate)
                (by
                  intro stateAfter values hStateAfter
                  exact
                    OpenResultDoneInvariant.done
                      (StateCheckpointStoreContains.multifill hStateAfter)))

