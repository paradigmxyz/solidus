          sourceValues = targetValues
  | .error (.YulHalt source value),
      .ok (.halted kind compiler) =>
        terminalRel kind value source compiler
  | .error (.Revert source),
      .ok (.halted .revert compiler) =>
        revertRel source compiler
  | _, _ => False

