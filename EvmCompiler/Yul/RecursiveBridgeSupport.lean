theorem assign_user_lookup_identNames_length
    {contract : AstContract} {functionName : Name}
    {names : List EvmYul.Identifier} {args : List AstExpr}
    {params returns : List EvmYul.Identifier}
    {body : List AstStmt}
    (hStmt :
      StmtOk contract (.Assign names (.Call (.inr functionName) args)))
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns body)) :
    (identNames names).length = returns.length := by
  simpa [identNames] using
    assign_user_lookup_targets_length
      (contract := contract) (functionName := functionName)
      (names := names) (args := args) (params := params)
      (returns := returns) (body := body) hStmt hLookup

