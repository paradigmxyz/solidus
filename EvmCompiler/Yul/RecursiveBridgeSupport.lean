theorem to_outcome_block_of_not_regular_no_loop
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceResult : Except Exception State}
    {sourceOutcome : Objects.Source.Outcome}
    (hRel :
      SourceResultKontOutcomeRel cfg
        (SourceModeKontLayouts.block layout outcomeLayout) terminalRel
        revertRel sourceResult sourceOutcome)
    (hNotRegular : SourceResultNotRegularOk sourceResult)
    (hNoBreak :
      ∀ {sharedBreak : EvmYul.SharedState .Yul}
        {storeBreak : EvmYul.Yul.VarStore},
        sourceResult =
          .ok (.Checkpoint (.Break sharedBreak storeBreak)) →
        False)
    (hNoContinue :
      ∀ {sharedContinue : EvmYul.SharedState .Yul}
        {storeContinue : EvmYul.Yul.VarStore},
        sourceResult =
          .ok (.Checkpoint (.Continue sharedContinue storeContinue)) →
        False) :
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult sourceOutcome := by
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hState =>
          cases hState with
          | ok _hShared _hVars =>
              cases hNotRegular
      | brk hState =>
          exact False.elim (hNoBreak rfl)
      | cont hState =>
          exact False.elim (hNoContinue rfl)
      | leave hState =>
          exact
            SourceResultOutcomeRel.ok
              (SourceOkOutcomeRel.leave
                (by simpa [SourceModeKontLayouts.block] using hState))
  | yulHalt hTerminal =>
      exact SourceResultOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact SourceResultOutcomeRel.revert hRevert

end SourceResultKontOutcomeRel

namespace SourceResultOutcomeRel

theorem mode_leave_or_halt_of_not_regular_no_loop
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceResult : Except Exception State}
    {sourceOutcome : Objects.Source.Outcome}
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        sourceOutcome)
    (hNotRegular : SourceResultNotRegularOk sourceResult)
    (hNoBreak :
      ∀ {sharedBreak : EvmYul.SharedState .Yul}
        {storeBreak : EvmYul.Yul.VarStore},
        sourceResult =
          .ok (.Checkpoint (.Break sharedBreak storeBreak)) →
        False)
    (hNoContinue :
      ∀ {sharedContinue : EvmYul.SharedState .Yul}
        {storeContinue : EvmYul.Yul.VarStore},
        sourceResult =
          .ok (.Checkpoint (.Continue sharedContinue storeContinue)) →
        False) :
    sourceOutcome.mode = Locals.Source.Mode.leave ∨
      ∃ kind : Assembly.HaltKind,
        sourceOutcome.mode = Locals.Source.Mode.halt kind := by
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hState =>
          cases hState with
          | ok _hShared _hVars =>
              cases hNotRegular
      | brk hState =>
          exact False.elim (hNoBreak rfl)
      | cont hState =>
          exact False.elim (hNoContinue rfl)
      | leave hState =>
          exact Or.inl rfl
  | yulHalt hTerminal =>
      exact Or.inr ⟨_, rfl⟩
  | revert hRevert =>
      exact Or.inr ⟨.revert, rfl⟩

end SourceResultOutcomeRel

