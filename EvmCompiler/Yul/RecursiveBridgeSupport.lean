    {names : List EvmYul.Identifier}
    (hAllowed : StateCheckpointAllowed canBreak canContinue canLeave state) :
    StateCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.State.zeroFill names state) := by
  induction names with
  | nil =>
      simpa [EvmYul.Yul.State.zeroFill] using hAllowed
  | cons name rest ih =>
      simp [EvmYul.Yul.State.zeroFill]
      exact StateCheckpointAllowed.insert ih

theorem StateCheckpointAllowed.multifill
    {canBreak canContinue canLeave : Bool} {state : State}
    {names : List EvmYul.Identifier} {values : List Word}
    (hAllowed : StateCheckpointAllowed canBreak canContinue canLeave state) :
    StateCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.State.multifill names values state) := by
  cases state with
  | Ok shared store =>
      let step : EvmYul.Identifier × Word → State → State :=
        fun entry state => EvmYul.Yul.State.insert entry.1 entry.2 state
      have hFoldOk :
          ∀ entries : List (EvmYul.Identifier × Word),
            ∃ shared' store',
              List.foldr step (.Ok shared store) entries =
                (.Ok shared' store' : State) := by
        intro entries
        induction entries with
        | nil =>
            exact ⟨shared, store, rfl⟩
        | cons entry rest ih =>
            rcases ih with ⟨shared', store', hRest⟩
            cases entry with
            | mk name value =>
                exact ⟨shared', Finmap.insert name value store', by
                  change
                    EvmYul.Yul.State.insert name value
                      (List.foldr step (.Ok shared store) rest) =
                    (.Ok shared' (Finmap.insert name value store') : State)
                  rw [hRest]
                  rfl⟩
      rcases hFoldOk (names.zip values) with ⟨shared', store', hFold⟩
      simpa [EvmYul.Yul.State.multifill, step, hFold,
        StateCheckpointAllowed]
  | OutOfFuel =>
      simp [EvmYul.Yul.State.multifill, StateCheckpointAllowed]
  | Checkpoint jump =>
      cases jump <;> simpa [StateCheckpointAllowed] using hAllowed

