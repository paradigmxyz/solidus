    ⟨sourceOutcome, ctxAfterBody, bodyFuel, hGeneratedBodyOpen,
      hOutcomeRel⟩
  have hSourceHead :
      EvmYul.Yul.exec sourceFuel.succ.succ.succ (.For cond post body)
          codeOverride (.Ok shared store) =
        .error err := by
    rw [Imported.exec_for_succ]
    rw [Imported.loop_succ_succ]
    have hEvalMkOk :
        EvmYul.Yul.eval sourceFuel cond codeOverride
            (EvmYul.Yul.State.mkOk (.Ok shared store)) =
          .error err := by
      simpa [EvmYul.Yul.State.mkOk] using hEvalError
    simp [hEvalMkOk]
  cases sourceOutcome with
  | mk outcomeState outcomeMode =>
      cases outcomeMode with
      | regular =>
          have hNonregular :
              ({ state := outcomeState,
                 mode := Locals.Source.Mode.regular } :
                Functions.Source.Outcome).mode ≠
                Locals.Source.Mode.regular :=
            SourceResultOutcomeRel.mode_ne_regular_of_error hOutcomeRel
          exact False.elim (hNonregular rfl)
      | brk =>
          cases hOutcomeRel
      | cont =>
          cases hOutcomeRel
      | leave =>
          cases hOutcomeRel
      | halt kind =>
          have hLoopCondTrue :
              Functions.Source.Expr.evalCondition prim
                  (.lit (EvmYul.UInt256.ofNat 1)) compiler =
                .ok (compiler, true) := by
            have hBool :
                (EvmYul.UInt256.ofNat 1 != EvmYul.UInt256.ofNat 0) = true :=
              word_bne_zero_true_of_ne (by decide)
            simp [Functions.Source.Expr.evalCondition,
              Locals.Source.Expr.evalCondition, Locals.Source.Expr.evalOne,
              Locals.Source.Expr.eval, hBool]
          have hGeneratedBodyScoped :
              Functions.Source.Block.runScoped prim program bodyCtx
                  { stmts := pre ++ guard :: lowerBody.stmts } bodyFuel
                  compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState) := by
            simp [bodyCtx, Functions.Source.Block.runScoped,
              hGeneratedBodyOpen, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt]
          have hGeneratedBodyScoped' :
              Functions.Source.Block.runScoped prim program
                  { scope := layout, breakScope? := some layout,
                    continueScope? := some layout,
                    leaveScope? := ctx.leaveScope? }
                  { stmts :=
                      pre ++
                        (Functions.Stmt.if_
                          (.prim .iszero
                            (Locals.ExprSeq.cons lowerCond .nil))
                          { stmts := [Functions.Stmt.brk] } ::
                          lowerBody.stmts) }
                  bodyFuel compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState) := by
            simpa [bodyCtx, guard, Functions.Source.Ctx.withoutLoopControl,
              Functions.Source.Ctx.withLoopControl, hScope] using
              hGeneratedBodyScoped
          have hForRun :
              Functions.Source.Stmt.run prim program ctx bodyFuel.succ.succ
                  (Functions.Stmt.for_ { stmts := [] }
                    (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
                    { stmts :=
                        pre ++
                          (Functions.Stmt.if_
                            (.prim .iszero
                              (Locals.ExprSeq.cons lowerCond .nil))
                            { stmts := [Functions.Stmt.brk] } ::
                            lowerBody.stmts) })
                  compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState, ctx) := by
            simp [Functions.Source.Stmt.run, Functions.Source.Block.runOpen,
              Functions.Source.Stmt.runForLoop, hLoopCondTrue,
              hGeneratedBodyScoped', Functions.Source.Ctx.withoutLoopControl,
              Functions.Source.Ctx.withLoopControl, hScope,
              Functions.Source.Outcome.regular, Locals.Source.Outcome.regular,
              Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hTargetBlock :
              Functions.Source.Block.runOpen prim program ctx
                  bodyFuel.succ.succ.succ
                  { stmts :=
                      [Functions.Stmt.for_ { stmts := [] }
                        (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
                        { stmts :=
                            pre ++
                              (Functions.Stmt.if_
                                (.prim .iszero
                                  (Locals.ExprSeq.cons lowerCond .nil))
                                { stmts := [Functions.Stmt.brk] } ::
                                lowerBody.stmts) }] }
                  compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState, ctx) := by
            simp [Functions.Source.Block.runOpen, hForRun,
              Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
          exact
            ⟨.error err, Functions.Source.Outcome.halt kind outcomeState, ctx,
              bodyFuel.succ.succ.succ, hSourceHead, hTargetBlock,
              hOutcomeRel,
              by simp [Functions.Source.Outcome.halt,
                Locals.Source.Outcome.halt]⟩

/--
Nonregular hidden-head bridge for a generated `for` condition prelude that
halts under a hidden target context.

The target loop body context is the one produced by `Functions.Source.Stmt.run`
for an empty-init loop: break/continue targets are the full current target
scope, while source-visible observations are still related only over `layout`.
-/
theorem sourceNonregularStmtRunHiddenExact_for_generated_condition_terminal_hidden_scope
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {pre : List Functions.Stmt} {lowerCond : Functions.Expr 1}
    {lowerPost lowerBody : Functions.Block}
    {err : Exception}
    (hCondTerminal :
      SourceExprPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        sourceFuel cond codeOverride pre)
    (hExact :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hEvalError :
      EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    SourceNonregularStmtRunHiddenExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ.succ.succ
      (.For cond post body) codeOverride (.Ok shared store) compiler
      { stmts :=
          [Functions.Stmt.for_ { stmts := [] }
            (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
            { stmts :=
                pre ++
                  (Functions.Stmt.if_
                    (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                    { stmts := [Functions.Stmt.brk] } ::
                    lowerBody.stmts) }] } := by
  let guard : Functions.Stmt :=
    Functions.Stmt.if_
      (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
      { stmts := [Functions.Stmt.brk] }
  let bodyCtx :=
    ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope
  rcases
      (SourceExprPreludeTerminalAt.append_suffix
        (suffix := guard :: lowerBody.stmts) hCondTerminal)
        hExact hEvalError hRelatable with
    ⟨sourceOutcome, ctxAfterBody, bodyFuel, hGeneratedBodyOpen,
      hOutcomeRel⟩
  have hSourceHead :
      EvmYul.Yul.exec sourceFuel.succ.succ.succ (.For cond post body)
          codeOverride (.Ok shared store) =
        .error err := by
    rw [Imported.exec_for_succ]
    rw [Imported.loop_succ_succ]
    have hEvalMkOk :
        EvmYul.Yul.eval sourceFuel cond codeOverride
            (EvmYul.Yul.State.mkOk (.Ok shared store)) =
          .error err := by
      simpa [EvmYul.Yul.State.mkOk] using hEvalError
    simp [hEvalMkOk]
  cases sourceOutcome with
  | mk outcomeState outcomeMode =>
      cases outcomeMode with
      | regular =>
          have hNonregular :
              ({ state := outcomeState,
                 mode := Locals.Source.Mode.regular } :
                Functions.Source.Outcome).mode ≠
                Locals.Source.Mode.regular :=
            SourceResultOutcomeRel.mode_ne_regular_of_error hOutcomeRel
          exact False.elim (hNonregular rfl)
      | brk =>
          cases hOutcomeRel
      | cont =>
          cases hOutcomeRel
      | leave =>
          cases hOutcomeRel
      | halt kind =>
          have hLoopCondTrue :
              Functions.Source.Expr.evalCondition prim
                  (.lit (EvmYul.UInt256.ofNat 1)) compiler =
                .ok (compiler, true) := by
            have hBool :
                (EvmYul.UInt256.ofNat 1 != EvmYul.UInt256.ofNat 0) = true :=
              word_bne_zero_true_of_ne (by decide)
            simp [Functions.Source.Expr.evalCondition,
              Locals.Source.Expr.evalCondition, Locals.Source.Expr.evalOne,
              Locals.Source.Expr.eval, hBool]
          have hGeneratedBodyScoped :
              Functions.Source.Block.runScoped prim program bodyCtx
                  { stmts := pre ++ guard :: lowerBody.stmts } bodyFuel
                  compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState) := by
            simp [bodyCtx, Functions.Source.Block.runScoped,
              hGeneratedBodyOpen, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt]
          have hGeneratedBodyScoped' :
              Functions.Source.Block.runScoped prim program
                  (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
                  { stmts :=
                      pre ++
                        (Functions.Stmt.if_
                          (.prim .iszero
                            (Locals.ExprSeq.cons lowerCond .nil))
                          { stmts := [Functions.Stmt.brk] } ::
                          lowerBody.stmts) }
                  bodyFuel compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState) := by
            simpa [bodyCtx, guard] using hGeneratedBodyScoped
          have hGeneratedBodyScopedRecord :
              Functions.Source.Block.runScoped prim program
                  { scope := ctx.scope, breakScope? := some ctx.scope,
                    continueScope? := some ctx.scope,
                    leaveScope? := ctx.leaveScope? }
                  { stmts :=
                      pre ++
                        (Functions.Stmt.if_
                          (.prim .iszero
                            (Locals.ExprSeq.cons lowerCond .nil))
                          { stmts := [Functions.Stmt.brk] } ::
                          lowerBody.stmts) }
                  bodyFuel compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState) := by
            simpa [Functions.Source.Ctx.withoutLoopControl,
              Functions.Source.Ctx.withLoopControl] using
              hGeneratedBodyScoped'
          have hForRun :
              Functions.Source.Stmt.run prim program ctx bodyFuel.succ.succ
                  (Functions.Stmt.for_ { stmts := [] }
                    (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
                    { stmts :=
                        pre ++
                          (Functions.Stmt.if_
                            (.prim .iszero
                              (Locals.ExprSeq.cons lowerCond .nil))
                            { stmts := [Functions.Stmt.brk] } ::
                            lowerBody.stmts) })
                  compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState, ctx) := by
            simp [Functions.Source.Stmt.run, Functions.Source.Block.runOpen,
              Functions.Source.Stmt.runForLoop, hLoopCondTrue,
              hGeneratedBodyScopedRecord,
              Functions.Source.Ctx.withoutLoopControl,
              Functions.Source.Ctx.withLoopControl,
              Functions.Source.Outcome.regular, Locals.Source.Outcome.regular,
              Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hTargetBlock :
              Functions.Source.Block.runOpen prim program ctx
                  bodyFuel.succ.succ.succ
                  { stmts :=
                      [Functions.Stmt.for_ { stmts := [] }
                        (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
                        { stmts :=
                            pre ++
                              (Functions.Stmt.if_
                                (.prim .iszero
                                  (Locals.ExprSeq.cons lowerCond .nil))
                                { stmts := [Functions.Stmt.brk] } ::
                                lowerBody.stmts) }] }
                  compiler =
                .ok (Functions.Source.Outcome.halt kind outcomeState, ctx) := by
            simp [Functions.Source.Block.runOpen, hForRun,
              Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
          exact
            ⟨.error err, Functions.Source.Outcome.halt kind outcomeState, ctx,
              bodyFuel.succ.succ.succ, hSourceHead, hTargetBlock,
              hOutcomeRel,
              by simp [Functions.Source.Outcome.halt,
                Locals.Source.Outcome.halt]⟩

def generatedForLowerBlock
    (pre : List Functions.Stmt) (lowerCond : Functions.Expr 1)
    (lowerPost lowerBody : Functions.Block) : Functions.Block :=
  { stmts :=
      [Functions.Stmt.for_ { stmts := [] }
        (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
        { stmts :=
            pre ++
              (Functions.Stmt.if_
                (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                { stmts := [Functions.Stmt.brk] } ::
              lowerBody.stmts) }] }

structure GeneratedForCompiled
    (reserved layout : List Name) (cond : AstExpr)
    (post body : List AstStmt) where
  compileFuel : Nat
  freshState : Fresh.State
  freshStateAfterCond : Fresh.State
  freshStateAfterPost : Fresh.State
  freshState' : Fresh.State
  preCond : List Functions.Stmt
  lowerCond : Functions.Expr 1
  lowerPost : Functions.Block
  lowerBody : Functions.Block
  covers : FreshCoversLayout (reserved ++ layout) freshState
  condLower :
    Expr.lower1? freshState cond =
      some (preCond, lowerCond, freshStateAfterCond)
  postLower :
    Stmt.List.toBlockFuel? compileFuel freshStateAfterCond post =
      some (lowerPost, freshStateAfterPost)
  bodyLower :
    Stmt.List.toBlockFuel? compileFuel freshStateAfterPost body =
      some (lowerBody, freshState')
  stmtLower :
    Stmt.toFunctionsList? freshState (.For cond post body) =
      some
        ([Functions.Stmt.for_ { stmts := [] }
          (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
          { stmts :=
              preCond ++
                [Functions.Stmt.if_
                  (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                  { stmts := [Functions.Stmt.brk] }] ++
                lowerBody.stmts }],
          freshState')

theorem GeneratedForCompiled.singleton_toBlockFuel?
    {reserved layout : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (pieces : GeneratedForCompiled reserved layout cond post body) :
    Stmt.List.toBlockFuel? (Stmt.List.fuel [.For cond post body])
        pieces.freshState [.For cond post body] =
      some
        (generatedForLowerBlock pieces.preCond pieces.lowerCond
          pieces.lowerPost pieces.lowerBody, pieces.freshState') := by
  let stmt : AstStmt := .For cond post body
  let stmtFuel := Stmt.fuel stmt
  let listHeadFuel := Nat.max stmtFuel (Stmt.List.fuel [])
  have hStmtHigh :
      Stmt.toFunctionsListFuel? listHeadFuel pieces.freshState stmt =
        some
          ([Functions.Stmt.for_ { stmts := [] }
            (.lit (EvmYul.UInt256.ofNat 1)) pieces.lowerPost
            { stmts :=
                pieces.preCond ++
                  [Functions.Stmt.if_
                    (.prim .iszero
                      (Locals.ExprSeq.cons pieces.lowerCond .nil))
                    { stmts := [Functions.Stmt.brk] }] ++
                  pieces.lowerBody.stmts }],
            pieces.freshState') := by
    exact
      LoweringFuel.stmt_toFunctionsListFuel?_of_some_high stmt
        (fuel := stmtFuel) (high := listHeadFuel)
        (by
          dsimp [listHeadFuel]
          exact Nat.le_max_left _ _)
        (by
          dsimp [stmt, stmtFuel]
          exact pieces.stmtLower)
  have hListHeadFuelPos : 0 < listHeadFuel := by
    dsimp [listHeadFuel]
    exact Nat.lt_of_lt_of_le (by decide : 0 < Stmt.List.fuel [])
      (Nat.le_max_right _ _)
  have hNil :
      Stmt.List.toFunctionsFuel? listHeadFuel pieces.freshState' [] =
        some ([], pieces.freshState') := by
    have hSucc : listHeadFuel = listHeadFuel.pred.succ :=
      (Nat.succ_pred_eq_of_pos hListHeadFuelPos).symm
    conv_lhs => rw [hSucc]
    simp [Stmt.List.toFunctionsFuel?]
  have hBlock :
      Stmt.List.toBlockFuel? (listHeadFuel + 2) pieces.freshState [stmt] =
        some
          (generatedForLowerBlock pieces.preCond pieces.lowerCond
            pieces.lowerPost pieces.lowerBody, pieces.freshState') := by
    simp [Stmt.List.toBlockFuel?, Stmt.List.toFunctionsFuel?, hStmtHigh,
      hNil, generatedForLowerBlock, List.append_assoc]
  simpa [stmt, stmtFuel, listHeadFuel, Stmt.List.fuel, Nat.add_assoc]
    using hBlock

def GeneratedForBodyBlockSound
    (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (body : List AstStmt)
    (codeOverride : Option AstContract)
    (lowerBody : Functions.Block) : Prop :=
  ∀ {bodyOutcomeLayout : List Name} {ctxAfterPre}
    {bodyResult : Except Exception State},
    (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
    SourceCtxHandlersEq
      (ctx.withoutLoopControl.withLoopControl layout layout)
      ctxAfterPre →
    SourceResultRelatable bodyResult →
    SourceResultOutcomeLayoutCompatible ctxAfterPre layout
      bodyOutcomeLayout bodyResult →
    SourceResultBlockSoundWhenAtExactHiddenScope cfg layout
      bodyOutcomeLayout terminalRel revertRel prim program ctxAfterPre
      sourceFuel body codeOverride lowerBody
      (fun result => result = bodyResult)

def GeneratedForPostBlockSound
    (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (post : List AstStmt)
    (codeOverride : Option AstContract)
    (lowerPost : Functions.Block) : Prop :=
  ∀ {postOutcomeLayout : List Name}
    {postResult : Except Exception State},
    SourceResultRelatable postResult →
    SourceResultOutcomeLayoutCompatible (ctx.withoutLoopControl) layout
      postOutcomeLayout postResult →
      SourceResultBlockSoundWhenAtExactHiddenScope cfg layout
      postOutcomeLayout terminalRel revertRel prim program
      (ctx.withoutLoopControl) sourceFuel post codeOverride lowerPost
      (fun result => result = postResult)

/--
Mode-facing body contract for a generated `for`.

`GeneratedForBodyBlockSound` is still useful at ordinary block boundaries, but
it is too final-outcome-shaped for generated loops whose internal body handlers
live at the hidden target scope `ctx.scope`.  This interface exposes the modes
that the generated loop actually consumes.  In particular, `break` and
`continue` only promise the source-visible `layout` relation; they are handled
inside the generated loop and should not be forced through
`SourceResultOutcomeLayoutCompatible`.
-/
structure GeneratedForBodyModeSound
    (cfg : StateRelConfig) (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (body : List AstStmt)
    (codeOverride : Option AstContract)
    (lowerBody : Functions.Block) : Prop where
  regular :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      StoreDomainExact layout storeOut →
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
        (.Ok sharedIn storeIn) = .ok (.Ok sharedOut storeOut) →
      ∀ {ctxAfterPre},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        SourceCtxHandlersEq
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          ctxAfterPre →
        SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
        ∃ compilerOut : Objects.Source.State,
        ∃ bodyFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyFuel compilerIn =
            .ok (Functions.Source.Outcome.regular compilerOut) ∧
          SourceStateRel cfg layout (.Ok sharedOut storeOut) compilerOut
  brk :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      StoreDomainExact layout storeOut →
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
        (.Ok sharedIn storeIn) =
          .ok (.Checkpoint (.Break sharedOut storeOut)) →
      ∀ {ctxAfterPre},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        SourceCtxHandlersEq
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          ctxAfterPre →
        SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
        ∃ compilerOut : Objects.Source.State,
        ∃ bodyFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyFuel compilerIn =
            .ok (Functions.Source.Outcome.brk compilerOut) ∧
          SourceStateRel cfg layout (.Ok sharedOut storeOut) compilerOut
  cont :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      StoreDomainExact layout storeOut →
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
        (.Ok sharedIn storeIn) =
          .ok (.Checkpoint (.Continue sharedOut storeOut)) →
      ∀ {ctxAfterPre},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        SourceCtxHandlersEq
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          ctxAfterPre →
        SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
        ∃ compilerOut : Objects.Source.State,
        ∃ bodyFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyFuel compilerIn =
            .ok (Functions.Source.Outcome.cont compilerOut) ∧
          SourceStateRel cfg layout (.Ok sharedOut storeOut) compilerOut
  leave :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
        (.Ok sharedIn storeIn) =
          .ok (.Checkpoint (.Leave sharedOut storeOut)) →
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        (.ok (.Checkpoint (.Leave sharedOut storeOut))) →
      ∀ {ctxAfterPre},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        SourceCtxHandlersEq
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          ctxAfterPre →
        SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
        ∃ compilerOut : Objects.Source.State,
        ∃ bodyFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyFuel compilerIn =
            .ok (Functions.Source.Outcome.leave compilerOut) ∧
          SourceStateRel cfg outcomeLayout (.Ok sharedOut storeOut)
            compilerOut
  halt :
    ∀ {sharedIn : EvmYul.SharedState .Yul}
      {storeIn : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State}
      {sourceResult : Except Exception State},
      StoreDomainExact layout storeIn →
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
        (.Ok sharedIn storeIn) = sourceResult →
      SourceResultRelatable sourceResult →
      SourceResultNotRegularOk sourceResult →
      SourceResultNoCheckpoint sourceResult →
      ∀ {ctxAfterPre},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        SourceCtxHandlersEq
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          ctxAfterPre →
        SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
        ∃ haltKind : Assembly.HaltKind,
        ∃ compilerOut : Objects.Source.State,
        ∃ bodyFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyFuel compilerIn =
            .ok (Functions.Source.Outcome.halt haltKind compilerOut) ∧
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            sourceResult
            (Functions.Source.Outcome.halt haltKind compilerOut)

/--
Mode-facing post contract for a generated `for`.

The post block cannot legally produce `break` or `continue` in accepted Yul
loops, so its useful modes are regular fallthrough plus terminal/leave exits.
-/
structure GeneratedForPostModeSound
    (cfg : StateRelConfig) (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (post : List AstStmt)
    (codeOverride : Option AstContract)
    (lowerPost : Functions.Block) : Prop where
  regular :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeOut →
