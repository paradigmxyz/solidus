/-
Source-visible variable scoping for imported Yul expressions.

This predicate is deliberately separate from `Safe.expr`: safety records which
primitive families the current bridge supports, while this records the ordinary
Yul lexical fact needed by direct variable reads.  Function names are not local
variables, so only call arguments are checked for user calls.
-/
mutual
  def SourceExprScoped (layout : List Name) : AstExpr → Prop
    | .Lit _value => True
    | .Var name => identName name ∈ layout
    | .Call (.inl _prim) args => SourceExprsScoped layout args
    | .Call (.inr _functionName) args => SourceExprsScoped layout args

  def SourceExprsScoped (layout : List Name) : List AstExpr → Prop
    | [] => True
    | head :: rest =>
        SourceExprScoped layout head ∧ SourceExprsScoped layout rest
end

theorem SourceExprsScoped.mem
    {layout : List Name} {args : List AstExpr} {expr : AstExpr}
    (hScoped : SourceExprsScoped layout args)
    (hMem : expr ∈ args) :
    SourceExprScoped layout expr := by
  induction args with
  | nil =>
      simp at hMem
  | cons head tail ih =>
      simp [SourceExprsScoped] at hScoped
      simp at hMem
      rcases hMem with hEq | hTail
      · subst expr
        exact hScoped.1
      · exact ih hScoped.2 hTail

theorem SourceExprsScoped.append
    {layout : List Name} {left right : List AstExpr}
    (hLeft : SourceExprsScoped layout left)
    (hRight : SourceExprsScoped layout right) :
    SourceExprsScoped layout (left ++ right) := by
  induction left with
  | nil =>
      simpa using hRight
  | cons head tail ih =>
      simp [SourceExprsScoped] at hLeft
      simp [SourceExprsScoped, hLeft.1, ih hLeft.2]

theorem SourceExprsScoped.reverse
    {layout : List Name} {args : List AstExpr}
    (hScoped : SourceExprsScoped layout args) :
    SourceExprsScoped layout args.reverse := by
  induction args with
  | nil =>
      simp [SourceExprsScoped]
  | cons head tail ih =>
      simp [SourceExprsScoped] at hScoped
      simpa using
        SourceExprsScoped.append (ih hScoped.2)
          (by simp [SourceExprsScoped, hScoped.1])

mutual
  def SourceExprScoped? (layout : List Name) : AstExpr → Bool
    | .Lit _value => true
    | .Var name => decide (identName name ∈ layout)
    | .Call (.inl _prim) args => SourceExprsScoped? layout args
    | .Call (.inr _functionName) args => SourceExprsScoped? layout args

  def SourceExprsScoped? (layout : List Name) : List AstExpr → Bool
    | [] => true
    | head :: rest =>
        SourceExprScoped? layout head && SourceExprsScoped? layout rest
end

mutual
  theorem SourceExprScoped.of_check
      {layout : List Name} {expr : AstExpr}
      (hCheck : SourceExprScoped? layout expr = true) :
      SourceExprScoped layout expr := by
    cases expr with
    | Lit value =>
        trivial
    | Var name =>
        have hMem : identName name ∈ layout :=
          of_decide_eq_true (by simpa [SourceExprScoped?] using hCheck)
        simpa [SourceExprScoped] using hMem
    | Call callee args =>
        cases callee with
        | inl prim =>
            exact SourceExprsScoped.of_check hCheck
        | inr functionName =>
            exact SourceExprsScoped.of_check hCheck

  theorem SourceExprsScoped.of_check
      {layout : List Name} {exprs : List AstExpr}
      (hCheck : SourceExprsScoped? layout exprs = true) :
      SourceExprsScoped layout exprs := by
    cases exprs with
    | nil =>
        trivial
    | cons head rest =>
        have hAnd :
            SourceExprScoped? layout head = true ∧
              SourceExprsScoped? layout rest = true :=
          by simpa [SourceExprsScoped?] using hCheck
        exact
          ⟨SourceExprScoped.of_check hAnd.1,
            SourceExprsScoped.of_check hAnd.2⟩
end

mutual
  theorem SourceExprScoped.of_mem_iff
      {layout layout' : List Name} {expr : AstExpr}
      (hMem : ∀ name, name ∈ layout ↔ name ∈ layout')
      (hScoped : SourceExprScoped layout expr) :
      SourceExprScoped layout' expr := by
    cases expr with
    | Lit value =>
        simp [SourceExprScoped]
    | Var name =>
        exact (hMem (identName name)).mp hScoped
    | Call fn args =>
        cases fn with
        | inl prim =>
            exact SourceExprsScoped.of_mem_iff hMem hScoped
        | inr functionName =>
            exact SourceExprsScoped.of_mem_iff hMem hScoped

  theorem SourceExprsScoped.of_mem_iff
      {layout layout' : List Name} {exprs : List AstExpr}
      (hMem : ∀ name, name ∈ layout ↔ name ∈ layout')
      (hScoped : SourceExprsScoped layout exprs) :
      SourceExprsScoped layout' exprs := by
    cases exprs with
    | nil =>
        simp [SourceExprsScoped]
    | cons head tail =>
        exact
          ⟨SourceExprScoped.of_mem_iff hMem hScoped.1,
            SourceExprsScoped.of_mem_iff hMem hScoped.2⟩
end

/-
Source-visible lexical scoping for the imported Yul AST.

This is intentionally separate from `Safe`: `Safe` says an expression uses
primitive/call families that this bridge supports, while lexical scoping says
direct variable reads and assignment targets are in the current source layout.
The compiler may introduce hidden target-only temporaries below this layer, but
those do not appear in this source predicate.
-/
namespace SourceLexical

def StmtOutLayout (layout : List Name) : AstStmt → List Name
  | .Let names _value? => identNames names ++ layout
  | _ => layout

mutual
  def StmtScoped (layout : List Name) : AstStmt → Prop
    | .Block body => StmtsScoped layout body
    | .Let names none =>
        (identNames names).Nodup ∧
          ∀ name, name ∈ identNames names → name ∉ layout
    | .Let names (some value) =>
        ((identNames names).Nodup ∧
          ∀ name, name ∈ identNames names → name ∉ layout) ∧
        SourceExprScoped layout value
    | .Assign names value =>
        ((identNames names).Nodup ∧
          ∀ name, name ∈ identNames names → name ∈ layout) ∧
          SourceExprScoped layout value
    | .ExprStmtCall value => SourceExprScoped layout value
    | .Switch scrutinee cases defaultBody =>
        SourceExprScoped layout scrutinee ∧ CasesScoped layout cases ∧
          StmtsScoped layout defaultBody
    | .For cond post body =>
        SourceExprScoped layout cond ∧ StmtsScoped layout post ∧
          StmtsScoped layout body
    | .If cond body =>
        SourceExprScoped layout cond ∧ StmtsScoped layout body
    | .Continue | .Break | .Leave => True

  def StmtsScoped (layout : List Name) : List AstStmt → Prop
    | [] => True
    | head :: tail =>
        StmtScoped layout head ∧ StmtsScoped (StmtOutLayout layout head) tail

  def CasesScoped (layout : List Name) :
      List (Word × List AstStmt) → Prop
    | [] => True
    | (_value, body) :: rest =>
        StmtsScoped layout body ∧ CasesScoped layout rest
end

def namesNodup? (names : List Name) : Bool :=
  decide names.Nodup

def namesFresh? (layout names : List Name) : Bool :=
  names.all fun name => decide (name ∉ layout)

def namesInLayout? (layout names : List Name) : Bool :=
  names.all fun name => decide (name ∈ layout)

theorem namesNodup_of_check {names : List Name}
    (hCheck : namesNodup? names = true) :
    names.Nodup :=
  of_decide_eq_true hCheck

theorem namesFresh_of_check {layout names : List Name}
    (hCheck : namesFresh? layout names = true) :
    ∀ name, name ∈ names → name ∉ layout := by
  intro name hName
  exact
    of_decide_eq_true
      ((List.all_eq_true.mp hCheck) name hName)

theorem namesInLayout_of_check {layout names : List Name}
    (hCheck : namesInLayout? layout names = true) :
    ∀ name, name ∈ names → name ∈ layout := by
  intro name hName
  exact
    of_decide_eq_true
      ((List.all_eq_true.mp hCheck) name hName)

mutual
  def StmtScoped? (layout : List Name) : AstStmt → Bool
    | .Block body => StmtsScoped? layout body
    | .Let names none =>
        namesNodup? (identNames names) &&
          namesFresh? layout (identNames names)
    | .Let names (some value) =>
        (namesNodup? (identNames names) &&
          namesFresh? layout (identNames names)) &&
            SourceExprScoped? layout value
    | .Assign names value =>
        (namesNodup? (identNames names) &&
          namesInLayout? layout (identNames names)) &&
            SourceExprScoped? layout value
    | .ExprStmtCall value => SourceExprScoped? layout value
    | .Switch scrutinee cases defaultBody =>
        SourceExprScoped? layout scrutinee &&
          (CasesScoped? layout cases && StmtsScoped? layout defaultBody)
    | .For cond post body =>
        SourceExprScoped? layout cond &&
          (StmtsScoped? layout post && StmtsScoped? layout body)
    | .If cond body =>
        SourceExprScoped? layout cond && StmtsScoped? layout body
    | .Continue | .Break | .Leave => true

  def StmtsScoped? (layout : List Name) : List AstStmt → Bool
    | [] => true
    | head :: tail =>
        StmtScoped? layout head &&
          StmtsScoped? (StmtOutLayout layout head) tail

  def CasesScoped? (layout : List Name) :
      List (Word × List AstStmt) → Bool
    | [] => true
    | (_value, body) :: rest =>
        StmtsScoped? layout body && CasesScoped? layout rest
end

mutual
  theorem StmtScoped.of_check
      {layout : List Name} {stmt : AstStmt}
      (hCheck : StmtScoped? layout stmt = true) :
      StmtScoped layout stmt := by
    cases stmt with
    | Block body =>
        exact StmtsScoped.of_check hCheck
    | Let names value? =>
        cases value? with
        | none =>
            have hNames :
                namesNodup? (identNames names) = true ∧
                  namesFresh? layout (identNames names) = true :=
              by simpa [StmtScoped?] using hCheck
            exact
              ⟨namesNodup_of_check hNames.1,
                namesFresh_of_check hNames.2⟩
        | some value =>
            have hAnd :
                (namesNodup? (identNames names) &&
                  namesFresh? layout (identNames names)) = true ∧
                    SourceExprScoped? layout value = true :=
              by simpa [StmtScoped?] using hCheck
            have hNames :
                namesNodup? (identNames names) = true ∧
                  namesFresh? layout (identNames names) = true :=
              by simpa using hAnd.1
            exact
              ⟨⟨namesNodup_of_check hNames.1,
                  namesFresh_of_check hNames.2⟩,
                SourceExprScoped.of_check hAnd.2⟩
    | Assign names value =>
        have hAnd :
            (namesNodup? (identNames names) &&
              namesInLayout? layout (identNames names)) = true ∧
                SourceExprScoped? layout value = true :=
          by simpa [StmtScoped?] using hCheck
        have hNames :
            namesNodup? (identNames names) = true ∧
              namesInLayout? layout (identNames names) = true :=
          by simpa using hAnd.1
        exact
          ⟨⟨namesNodup_of_check hNames.1,
              namesInLayout_of_check hNames.2⟩,
            SourceExprScoped.of_check hAnd.2⟩
    | ExprStmtCall value =>
        exact SourceExprScoped.of_check hCheck
    | Switch scrutinee cases defaultBody =>
        have hAnd :
            SourceExprScoped? layout scrutinee = true ∧
              (CasesScoped? layout cases &&
                StmtsScoped? layout defaultBody) = true :=
          by simpa [StmtScoped?] using hCheck
        have hTail :
            CasesScoped? layout cases = true ∧
              StmtsScoped? layout defaultBody = true :=
          by simpa using hAnd.2
        exact
          ⟨SourceExprScoped.of_check hAnd.1,
            CasesScoped.of_check hTail.1,
            StmtsScoped.of_check hTail.2⟩
    | For cond post body =>
        have hAnd :
            SourceExprScoped? layout cond = true ∧
              (StmtsScoped? layout post &&
                StmtsScoped? layout body) = true :=
          by simpa [StmtScoped?] using hCheck
        have hTail :
            StmtsScoped? layout post = true ∧
              StmtsScoped? layout body = true :=
          by simpa using hAnd.2
        exact
          ⟨SourceExprScoped.of_check hAnd.1,
            StmtsScoped.of_check hTail.1,
            StmtsScoped.of_check hTail.2⟩
    | If cond body =>
        have hAnd :
            SourceExprScoped? layout cond = true ∧
              StmtsScoped? layout body = true :=
          by simpa [StmtScoped?] using hCheck
        exact
          ⟨SourceExprScoped.of_check hAnd.1,
            StmtsScoped.of_check hAnd.2⟩
    | Continue =>
        trivial
    | Break =>
        trivial
    | Leave =>
        trivial

  theorem StmtsScoped.of_check
      {layout : List Name} {stmts : List AstStmt}
      (hCheck : StmtsScoped? layout stmts = true) :
      StmtsScoped layout stmts := by
    cases stmts with
    | nil =>
        trivial
    | cons head tail =>
        have hAnd :
            StmtScoped? layout head = true ∧
              StmtsScoped? (StmtOutLayout layout head) tail = true :=
          by simpa [StmtsScoped?] using hCheck
        exact
          ⟨StmtScoped.of_check hAnd.1,
            StmtsScoped.of_check hAnd.2⟩

  theorem CasesScoped.of_check
      {layout : List Name} {cases : List (Word × List AstStmt)}
      (hCheck : CasesScoped? layout cases = true) :
      CasesScoped layout cases := by
    cases cases with
    | nil =>
        trivial
    | cons head rest =>
        rcases head with ⟨_value, body⟩
        have hAnd :
            StmtsScoped? layout body = true ∧
              CasesScoped? layout rest = true :=
          by simpa [CasesScoped?] using hCheck
        exact
          ⟨StmtsScoped.of_check hAnd.1,
            CasesScoped.of_check hAnd.2⟩
end

def FunctionScoped? : AstFunctionDefinition → Bool
  | .Def params returns body =>
      StmtsScoped? (identNames returns ++ identNames params) body

def FunctionListScoped? :
    List (Name × AstFunctionDefinition) → Bool
  | [] => true
  | (_name, fn) :: rest =>
      FunctionScoped? fn && FunctionListScoped? rest

noncomputable def ContractScoped? (contract : AstContract) : Bool :=
  StmtScoped? [] contract.dispatcher &&
    FunctionListScoped? (Contract.functionEntries contract)

noncomputable def ProgramScoped? (program : Program) : Bool :=
  ContractScoped? program.contract

mutual
  theorem StmtScoped.of_mem_iff
      {layout layout' : List Name} {stmt : AstStmt}
      (hMem : ∀ name, name ∈ layout ↔ name ∈ layout')
      (hScoped : StmtScoped layout stmt) :
      StmtScoped layout' stmt := by
    cases stmt with
    | Block body =>
        exact StmtsScoped.of_mem_iff hMem hScoped
    | Let names value? =>
        cases value? with
        | none =>
            exact
              ⟨hScoped.1, by
                intro name hName hIn
                exact hScoped.2 name hName ((hMem name).mpr hIn)⟩
        | some value =>
            exact
              ⟨⟨hScoped.1.1, by
                  intro name hName hIn
                  exact hScoped.1.2 name hName ((hMem name).mpr hIn)⟩,
                SourceExprScoped.of_mem_iff hMem hScoped.2⟩
    | Assign names value =>
        exact
          ⟨⟨hScoped.1.1, by
              intro name hName
              exact (hMem name).mp (hScoped.1.2 name hName)⟩,
            SourceExprScoped.of_mem_iff hMem hScoped.2⟩
    | ExprStmtCall value =>
        exact SourceExprScoped.of_mem_iff hMem hScoped
    | Switch scrutinee cases defaultBody =>
        exact
          ⟨SourceExprScoped.of_mem_iff hMem hScoped.1,
            CasesScoped.of_mem_iff hMem hScoped.2.1,
            StmtsScoped.of_mem_iff hMem hScoped.2.2⟩
    | For cond post body =>
        exact
          ⟨SourceExprScoped.of_mem_iff hMem hScoped.1,
            StmtsScoped.of_mem_iff hMem hScoped.2.1,
            StmtsScoped.of_mem_iff hMem hScoped.2.2⟩
    | If cond body =>
        exact
          ⟨SourceExprScoped.of_mem_iff hMem hScoped.1,
            StmtsScoped.of_mem_iff hMem hScoped.2⟩
    | Continue =>
        trivial
    | Break =>
        trivial
    | Leave =>
        trivial

  theorem StmtsScoped.of_mem_iff
      {layout layout' : List Name} {stmts : List AstStmt}
      (hMem : ∀ name, name ∈ layout ↔ name ∈ layout')
      (hScoped : StmtsScoped layout stmts) :
      StmtsScoped layout' stmts := by
    cases stmts with
    | nil =>
        simp [StmtsScoped]
    | cons head tail =>
        have hOut :
            ∀ name,
              name ∈ StmtOutLayout layout head ↔
                name ∈ StmtOutLayout layout' head := by
          intro name
          cases head <;>
            simp [StmtOutLayout, List.mem_append, hMem name]
        exact
          ⟨StmtScoped.of_mem_iff hMem hScoped.1,
            StmtsScoped.of_mem_iff hOut hScoped.2⟩

  theorem CasesScoped.of_mem_iff
      {layout layout' : List Name} {cases : List (Word × List AstStmt)}
      (hMem : ∀ name, name ∈ layout ↔ name ∈ layout')
      (hScoped : CasesScoped layout cases) :
      CasesScoped layout' cases := by
    cases cases with
    | nil =>
        simp [CasesScoped]
    | cons head tail =>
        cases head with
        | mk value body =>
            exact
              ⟨StmtsScoped.of_mem_iff hMem hScoped.1,
                CasesScoped.of_mem_iff hMem hScoped.2⟩
end

theorem tail_scoped_of_cons_let_none_reverse
    {layout : List Name} {names : List EvmYul.Identifier}
    {rest : List AstStmt}
    (hScoped : StmtsScoped layout (.Let names none :: rest)) :
    StmtsScoped ((identNames names).reverse ++ layout) rest := by
  exact
    StmtsScoped.of_mem_iff
      (layout := identNames names ++ layout)
      (layout' := (identNames names).reverse ++ layout)
      (stmts := rest)
      (by
        intro name
        simp [List.mem_append, List.mem_reverse])
      hScoped.2

theorem tail_scoped_of_cons_let_reverse
    {layout : List Name} {names : List EvmYul.Identifier}
    {value? : Option AstExpr} {rest : List AstStmt}
    (hScoped : StmtsScoped layout (.Let names value? :: rest)) :
    StmtsScoped ((identNames names).reverse ++ layout) rest := by
  exact
    StmtsScoped.of_mem_iff
      (layout := identNames names ++ layout)
      (layout' := (identNames names).reverse ++ layout)
      (stmts := rest)
      (by
        intro name
        simp [List.mem_append, List.mem_reverse])
      hScoped.2

def FunctionScoped : AstFunctionDefinition → Prop
  | .Def params returns body =>
      StmtsScoped (identNames returns ++ identNames params) body

inductive FunctionListScoped :
    List (Name × AstFunctionDefinition) → Prop where
  | nil : FunctionListScoped []
  | cons {name : Name} {fn : AstFunctionDefinition}
      {rest : List (Name × AstFunctionDefinition)}
      (hFn : FunctionScoped fn)
      (hRest : FunctionListScoped rest) :
      FunctionListScoped ((name, fn) :: rest)

noncomputable def ContractScoped (contract : AstContract) : Prop :=
  StmtScoped [] contract.dispatcher ∧
    FunctionListScoped (Contract.functionEntries contract)

noncomputable def ProgramScoped (program : Program) : Prop :=
  ContractScoped program.contract

theorem FunctionScoped.of_check {fn : AstFunctionDefinition}
    (hCheck : FunctionScoped? fn = true) :
    FunctionScoped fn := by
  cases fn with
  | Def params returns body =>
      exact StmtsScoped.of_check hCheck

theorem FunctionListScoped.of_check
    {entries : List (Name × AstFunctionDefinition)}
    (hCheck : FunctionListScoped? entries = true) :
    FunctionListScoped entries := by
  induction entries with
  | nil =>
      exact FunctionListScoped.nil
  | cons entry rest ih =>
      rcases entry with ⟨name, fn⟩
      have hAnd :
          FunctionScoped? fn = true ∧ FunctionListScoped? rest = true :=
        by simpa [FunctionListScoped?] using hCheck
      exact
        FunctionListScoped.cons
          (FunctionScoped.of_check hAnd.1) (ih hAnd.2)

theorem ContractScoped.of_check {contract : AstContract}
    (hCheck : ContractScoped? contract = true) :
    ContractScoped contract := by
  have hAnd :
      StmtScoped? [] contract.dispatcher = true ∧
        FunctionListScoped? (Contract.functionEntries contract) = true :=
    by simpa [ContractScoped?] using hCheck
  exact
    ⟨StmtScoped.of_check hAnd.1,
      FunctionListScoped.of_check hAnd.2⟩

theorem ProgramScoped.of_check {program : Program}
    (hCheck : ProgramScoped? program = true) :
    ProgramScoped program :=
  ContractScoped.of_check hCheck

theorem expr_user_call_args
    {layout : List Name} {functionName : Name} {args : List AstExpr}
    (hScoped :
      SourceExprScoped layout (.Call (.inr functionName) args)) :
    SourceExprsScoped layout args := by
  simpa [SourceExprScoped] using hScoped

theorem exprStmt_user_call_args
    {layout : List Name} {functionName : Name} {args : List AstExpr}
    (hScoped :
      StmtScoped layout (.ExprStmtCall (.Call (.inr functionName) args))) :
    SourceExprsScoped layout args := by
  simpa [StmtScoped, SourceExprScoped] using hScoped

theorem assign_user_call_args
    {layout : List Name} {names : List EvmYul.Identifier}
    {functionName : Name} {args : List AstExpr}
    (hScoped :
      StmtScoped layout (.Assign names (.Call (.inr functionName) args))) :
    SourceExprsScoped layout args := by
  simpa [StmtScoped, SourceExprScoped] using hScoped.2

theorem assign_names_nodup
    {layout : List Name} {names : List EvmYul.Identifier}
    {value : AstExpr}
    (hScoped : StmtScoped layout (.Assign names value)) :
    (identNames names).Nodup := by
  simpa [StmtScoped] using hScoped.1.1

theorem assign_names_mem
    {layout : List Name} {names : List EvmYul.Identifier}
    {value : AstExpr}
    (hScoped : StmtScoped layout (.Assign names value)) :
    ∀ name, name ∈ identNames names → name ∈ layout := by
  simpa [StmtScoped] using hScoped.1.2

theorem assign_value_scoped
    {layout : List Name} {names : List EvmYul.Identifier}
    {value : AstExpr}
    (hScoped : StmtScoped layout (.Assign names value)) :
    SourceExprScoped layout value := by
  simpa [StmtScoped] using hScoped.2

theorem let_user_call_args
    {layout : List Name} {names : List EvmYul.Identifier}
    {functionName : Name} {args : List AstExpr}
    (hScoped :
      StmtScoped layout
        (.Let names (some (.Call (.inr functionName) args)))) :
    SourceExprsScoped layout args := by
  simpa [StmtScoped, SourceExprScoped] using hScoped.2

theorem let_none_names_nodup
    {layout : List Name} {names : List EvmYul.Identifier}
    (hScoped : StmtScoped layout (.Let names none)) :
    (identNames names).Nodup := by
  simpa [StmtScoped] using hScoped.1

theorem let_none_names_fresh
    {layout : List Name} {names : List EvmYul.Identifier}
    (hScoped : StmtScoped layout (.Let names none)) :
    ∀ name, name ∈ identNames names → name ∉ layout := by
  simpa [StmtScoped] using hScoped.2

theorem let_some_names_nodup
    {layout : List Name} {names : List EvmYul.Identifier}
    {value : AstExpr}
    (hScoped : StmtScoped layout (.Let names (some value))) :
    (identNames names).Nodup := by
  simpa [StmtScoped] using hScoped.1.1

theorem let_some_names_fresh
    {layout : List Name} {names : List EvmYul.Identifier}
    {value : AstExpr}
    (hScoped : StmtScoped layout (.Let names (some value))) :
    ∀ name, name ∈ identNames names → name ∉ layout := by
  simpa [StmtScoped] using hScoped.1.2

theorem let_some_value_scoped
    {layout : List Name} {names : List EvmYul.Identifier}
    {value : AstExpr}
    (hScoped : StmtScoped layout (.Let names (some value))) :
    SourceExprScoped layout value := by
  simpa [StmtScoped] using hScoped.2

theorem if_cond_scoped
    {layout : List Name} {cond : AstExpr} {body : List AstStmt}
    (hScoped : StmtScoped layout (.If cond body)) :
    SourceExprScoped layout cond := by
  simpa [StmtScoped] using hScoped.1

theorem if_body_scoped
    {layout : List Name} {cond : AstExpr} {body : List AstStmt}
    (hScoped : StmtScoped layout (.If cond body)) :
    StmtsScoped layout body := by
  simpa [StmtScoped] using hScoped.2

theorem switch_scrutinee_scoped
    {layout : List Name} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody : List AstStmt}
    (hScoped : StmtScoped layout (.Switch scrutinee cases defaultBody)) :
    SourceExprScoped layout scrutinee := by
  simpa [StmtScoped] using hScoped.1

theorem switch_cases_scoped
    {layout : List Name} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody : List AstStmt}
    (hScoped : StmtScoped layout (.Switch scrutinee cases defaultBody)) :
    CasesScoped layout cases := by
  simpa [StmtScoped] using hScoped.2.1

theorem switch_default_scoped
    {layout : List Name} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody : List AstStmt}
    (hScoped : StmtScoped layout (.Switch scrutinee cases defaultBody)) :
    StmtsScoped layout defaultBody := by
  simpa [StmtScoped] using hScoped.2.2

theorem casesScoped_selectSwitchCase
    {layout : List Name} {value : Word}
    {defaultBody : List AstStmt} {cases : List (Word × List AstStmt)}
    (hCases : CasesScoped layout cases)
    (hDefault : StmtsScoped layout defaultBody) :
    StmtsScoped layout
      (EvmYul.Yul.selectSwitchCase value defaultBody cases) := by
  induction cases with
  | nil =>
      simpa [EvmYul.Yul.selectSwitchCase] using hDefault
  | cons head rest ih =>
      rcases head with ⟨caseValue, body⟩
      rcases hCases with ⟨hBody, hRest⟩
      by_cases hEq : caseValue = value
      · simp [EvmYul.Yul.selectSwitchCase, hEq, hBody]
      · simpa [EvmYul.Yul.selectSwitchCase, hEq] using ih hRest

theorem switch_selected_scoped
    {layout : List Name} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody : List AstStmt}
    {value : Word}
    (hScoped : StmtScoped layout (.Switch scrutinee cases defaultBody)) :
    StmtsScoped layout
      (EvmYul.Yul.selectSwitchCase value defaultBody cases) :=
  casesScoped_selectSwitchCase
    (switch_cases_scoped hScoped) (switch_default_scoped hScoped)

theorem for_cond_scoped
    {layout : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (hScoped : StmtScoped layout (.For cond post body)) :
    SourceExprScoped layout cond := by
  simpa [StmtScoped] using hScoped.1

theorem for_post_scoped
    {layout : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (hScoped : StmtScoped layout (.For cond post body)) :
    StmtsScoped layout post := by
  simpa [StmtScoped] using hScoped.2.1

theorem for_body_scoped
    {layout : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (hScoped : StmtScoped layout (.For cond post body)) :
    StmtsScoped layout body := by
  simpa [StmtScoped] using hScoped.2.2

theorem functionListScoped_functionScoped_of_find?
    {entries : List (Name × AstFunctionDefinition)}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hEntries : FunctionListScoped entries)
    (hFind : FunctionEntryList.find? functionName entries = some fn) :
    FunctionScoped fn := by
  induction entries with
  | nil =>
      simp [FunctionEntryList.find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      cases hEntries with
      | cons hHead hRest =>
          by_cases hEq : headName = functionName
          · have hHeadFn : headFn = fn := by
              simpa [FunctionEntryList.find?, hEq] using hFind
            simpa [hHeadFn] using hHead
          · simp [FunctionEntryList.find?, hEq] at hFind
            exact ih hRest hFind

theorem functionScoped_of_contract_lookup
    {program : Program} {functionName : Name}
    {fn : AstFunctionDefinition}
    (hScoped : ProgramScoped program)
    (hLookup : program.contract.functions.lookup functionName = some fn) :
    FunctionScoped fn := by
  have hFind :
      FunctionEntryList.find? functionName
          (Contract.functionEntries program.contract) =
        some fn :=
    FunctionEntryList.find?_contract_functionEntries_of_lookup
      program.contract hLookup
  exact functionListScoped_functionScoped_of_find? hScoped.2 hFind

theorem function_body_scoped_of_contract_lookup
    {program : Program} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    (hScoped : ProgramScoped program)
    (hLookup :
      program.contract.functions.lookup functionName =
        some (.Def params returns body)) :
    StmtsScoped (identNames returns ++ identNames params) body := by
  have hFn :
      FunctionScoped (.Def params returns body) :=
    functionScoped_of_contract_lookup
      (program := program) (functionName := functionName)
      (fn := .Def params returns body) hScoped hLookup
  simpa [FunctionScoped] using hFn

end SourceLexical

theorem exprEvalPreludeSound_lit
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {value : Word}
    {codeOverride : Option AstContract} :
    ExprEvalPreludeSound cfg layout prim program ctx sourceFuel
      (.Lit value) codeOverride [] (.lit value) := by
  intro source compiler sourceAfter out hInitial hEval
  cases sourceFuel with
  | zero =>
      rw [Imported.eval_zero] at hEval
      simp at hEval
  | succ fuel =>
      rw [Imported.eval_lit_succ] at hEval
      cases hEval
      exact
        ⟨compiler, compiler, ctx, 1,
          by simp [Functions.Source.Block.runOpen],
          by simp [Locals.Source.Expr.evalOne, Locals.Source.Expr.eval],
          hInitial⟩

theorem exprEvalPreludeSound_var
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {name : EvmYul.Identifier}
    {codeOverride : Option AstContract}
    (hMem : identName name ∈ layout) :
    ExprEvalPreludeSound cfg layout prim program ctx sourceFuel
      (.Var name) codeOverride [] (.var (identName name)) := by
  intro source compiler sourceAfter value hInitial hEval
  cases sourceFuel with
  | zero =>
      rw [Imported.eval_zero] at hEval
      simp at hEval
  | succ fuel =>
      cases hInitial with
      | @ok shared store compilerState hShared hVars =>
          rw [Imported.eval_var_succ] at hEval
          cases hLookup :
              EvmYul.Yul.State.lookup? name (.Ok shared store) with
          | none =>
              simp [hLookup] at hEval
          | some sourceValue =>
              simp [hLookup] at hEval
              rcases hEval with ⟨hSourceAfterEq, hValueEq⟩
              subst sourceAfter
              subst value
              have hStore :
                  store.lookup (identName name) = some sourceValue := by
                simpa [EvmYul.Yul.State.lookup?, identName] using hLookup
              have hSourceVar :
                  compiler.vars (identName name) = some sourceValue := by
                simpa [hStore] using hVars (identName name) hMem
              exact
                ⟨compiler, compiler, ctx, 1,
                  by simp [Functions.Source.Block.runOpen],
                  by
                    simp [Locals.Source.Expr.evalOne,
                      Locals.Source.Expr.eval, hSourceVar],
                  SourceStateRel.ok hShared hVars⟩

/--
Regular-success argument bridge with hidden compiler preludes.

Unlike `SourceArgEvalRegular`, this interface keeps the imported/source relation
at the original `layout`: generated prelude temporaries are compiler-only
locals and must not be required to exist in the imported Yul varstore.  The
prelude runs first, then the lowered expression sequence reads the argument
values, and only the post-expression state is related back to imported Yul.
-/
def SourceArgPreludeRegular
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) {results : Nat}
    (lower : Locals.ExprSeq results) : Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler sourceAfter} {values : List Word},
      SourceStateRel cfg layout source compiler →
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
        .ok (sourceAfter, values.reverse) →
      ∃ compilerAfterPre : Objects.Source.State,
      ∃ compilerAfterArgs : Objects.Source.State,
      ∃ ctxAfter : Functions.Source.Ctx,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runOpen prim program ctx targetFuel
            { stmts := pre } compiler =
          .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
        Locals.Source.Expr.ExprSeq.eval prim lower compilerAfterPre =
          .ok (compilerAfterArgs, values) ∧
        SourceStateRel cfg layout sourceAfter compilerAfterArgs

/--
Regular-success argument-list bridge with hidden compiler preludes.

This is the user-function-call sibling of `SourceArgPreludeRegular`: function
calls lower to a list of one-result expressions, not an arity-indexed
`ExprSeq`. The imported/source relation stays at the visible `layout`, while
generated argument temporaries remain compiler-only locals in `ctxAfter`.
-/
def SourceArgListPreludeRegular
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt)
    (lower : List (Locals.Expr 1)) : Prop :=
  ctx.scope = layout ∧ lower.length = args.length ∧
    ∀ {source compiler sourceAfter} {values : List Word},
      SourceStateRel cfg layout source compiler →
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
        .ok (sourceAfter, values.reverse) →
      ∃ compilerAfterPre : Objects.Source.State,
      ∃ compilerAfterArgs : Objects.Source.State,
      ∃ ctxAfter : Functions.Source.Ctx,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runOpen prim program ctx targetFuel
            { stmts := pre } compiler =
          .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
        Functions.Source.ArgList.eval prim lower compilerAfterPre =
          .ok (compilerAfterArgs, values) ∧
        SourceStateRel cfg layout sourceAfter compilerAfterArgs

/--
The same argument-list prelude contract without requiring the target context's
scope to equal the visible source layout.

This is needed at call sites that intentionally introduce hidden compiler-only
locals before argument evaluation, such as result slots for Yul
`let xs := f(...)`. The source relation still stays over the visible `layout`.
-/
def SourceArgListPreludeRegularAt
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt)
    (lower : List (Locals.Expr 1)) : Prop :=
  lower.length = args.length ∧
    ∀ {source compiler sourceAfter} {values : List Word},
      SourceStateRel cfg layout source compiler →
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
        .ok (sourceAfter, values.reverse) →
      ∃ compilerAfterPre : Objects.Source.State,
      ∃ compilerAfterArgs : Objects.Source.State,
      ∃ ctxAfter : Functions.Source.Ctx,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runOpen prim program ctx targetFuel
            { stmts := pre } compiler =
          .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
        Functions.Source.ArgList.eval prim lower compilerAfterPre =
        .ok (compilerAfterArgs, values) ∧
        SourceStateRel cfg layout sourceAfter compilerAfterArgs

/--
Terminal/error argument-list prelude bridge with hidden compiler preludes.

This is the sibling of `SourceArgListPreludeRegularAt` for the branch where
imported Yul argument evaluation itself halts or reverts before the enclosing
user-function call is reached.  The final user-call statement proof can compose
this terminal prelude with the skipped call/tail via
`Functions.Source.Block.runOpen_append_nonregular_exists`.
-/
def SourceArgListPreludeTerminalAt
    (cfg : StateRelConfig)
    (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) : Prop :=
  ∀ {source compiler err},
    SourceStateExactRel cfg layout source compiler →
    EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
      .error err →
    SourceResultRelatable (.error err) →
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre } compiler =
        .ok (sourceOutcome, ctxAfter) ∧
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        (.error err) sourceOutcome

/--
Build a terminal argument-prelude contract from an impossibility proof.

This is useful for direct/pure argument paths: if the imported argument
evaluator can only fail with front-end/fuel errors outside
`SourceResultRelatable`, the terminal-prelude branch is discharged without
running any compiler-side code.
-/
theorem SourceArgListPreludeTerminalAt.of_no_relatable_evalArgs_error
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    (hNoError :
      ∀ {source compiler err},
        SourceStateExactRel cfg layout source compiler →
        EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
          .error err →
        SourceResultRelatable (.error err) →
        False) :
    SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel args codeOverride pre := by
  intro source compiler err hInitial hEval hRelatable
  exact False.elim (hNoError hInitial hEval hRelatable)

theorem SourceArgListPreludeTerminalAt.append_suffix
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre suffix : List Functions.Stmt}
    (hTerminal :
      SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program ctx sourceFuel args codeOverride pre) :
    SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel args codeOverride
      (pre ++ suffix) := by
  intro source compiler err hInitial hEval hRelatable
  rcases hTerminal hInitial hEval hRelatable with
    ⟨sourceOutcome, ctxAfter, preFuel, hPreRun, hOutcomeRel⟩
  have hMode : sourceOutcome.mode ≠ .regular :=
    SourceResultOutcomeRel.mode_ne_regular_of_error hOutcomeRel
  rcases
      Functions.Source.Block.runOpen_append_nonregular_exists prim program
        pre suffix ctx compiler sourceOutcome ctxAfter ⟨preFuel, hPreRun⟩
        hMode with
    ⟨targetFuel, hRun⟩
  exact ⟨sourceOutcome, ctxAfter, targetFuel, hRun, hOutcomeRel⟩

/--
Terminal/error expression prelude bridge with hidden compiler preludes.

This is the single-expression analogue of
`SourceArgListPreludeTerminalAt`. It is intentionally context-parametric:
generated argument preludes may run after earlier hidden temporaries have been
introduced, so the source relation stays at the visible `layout` while `ctx`
may carry compiler-only locals.
-/
def SourceExprPreludeTerminalAt
    (cfg : StateRelConfig)
    (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) : Prop :=
  ∀ {source compiler err},
    SourceStateExactRel cfg layout source compiler →
    EvmYul.Yul.eval sourceFuel expr codeOverride source = .error err →
    SourceResultRelatable (.error err) →
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre } compiler =
        .ok (sourceOutcome, ctxAfter) ∧
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        (.error err) sourceOutcome

theorem SourceExprPreludeTerminalAt.append_suffix
    {cfg : StateRelConfig}
