    (cfg : StateRelConfig) (reserved layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel compileFuel : Nat)
    (sourceStmts : List AstStmt) (codeOverride : Option AstContract) :
    Prop :=
  ∀ {freshState freshState' lowerBlock},
    FreshCoversLayout (reserved ++ layout) freshState →
    Stmt.List.toBlockFuel? compileFuel freshState sourceStmts =
      some (lowerBlock, freshState') →
    FreshCoversLayout (reserved ++ layoutAfter) freshState' ∧
      SourceRegularSeqSoundAtFuelExactDomain cfg layout layoutAfter prim
        program ctx sourceFuel targetFuel sourceStmts codeOverride lowerBlock

/--
Names-aware singleton exact-domain target.

This is the local facade used by source declarations: the semantic relation is
still over the visible layout, but fresh-state obligations are checked against
`reserved ++ layout`.
-/
def CheckedRegularStmtSingletonSoundAtExactWithNames
    (cfg : StateRelConfig) (reserved layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) :
    Prop :=
  ∀ {lowerFuel freshState freshState' lowerHeadStmts},
    FreshCoversLayout (reserved ++ layout) freshState →
    Stmt.toFunctionsListFuel? lowerFuel freshState sourceStmt =
      some (lowerHeadStmts, freshState') →
    ∃ lowerHead : Functions.Stmt,
      lowerHeadStmts = [lowerHead] ∧
        FreshCoversLayout (reserved ++ layoutAfter) freshState' ∧
        SourceRegularStmtSoundAtExact cfg layout layoutAfter prim program ctx
          sourceFuel targetFuel sourceStmt codeOverride lowerHead

