            exact SourceResultOutcomeRel.yulHalt hDone

/-- A raw expression prelude can only stop honestly through a target halt. -/
theorem sourceExprRawPreludeOpenDoneRel_stopped_halt_mode
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceDone : Except Exception (State × List Word)}
    {target : Objects.Source.Outcome × Functions.Source.Ctx}
    (hDone :
      SourceExprRawPreludeOpenDoneRel cfg layout terminalRel revertRel
        sourceDone (.ok (.stopped target))) :
    ∃ kind, target.1.mode = Locals.Source.Mode.halt kind := by
  rcases target with ⟨targetOutcome, _targetCtx⟩
  cases targetOutcome with
  | mk targetState mode =>
      cases sourceDone with
      | ok sourceResult =>
          cases hDone
      | error err =>
          cases err <;> try { cases hDone }
          all_goals
            cases mode <;> try { cases hDone }
            rename_i kind
            exact ⟨kind, rfl⟩

