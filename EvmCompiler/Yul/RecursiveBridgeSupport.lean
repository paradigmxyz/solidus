                          EvmYul.Yul.State.reviveJump,
                          EvmYul.Yul.State.revive] at h <;>
                        rcases h with ⟨hStateAfter, _hValues⟩ <;>
                        subst stateAfter <;>
                        simpa [StateStoreDomainExact] using hDomain
          | some fname' =>
              cases hLookup :
                  (codeOverride.getD yulContract.code).functions.lookup fname' with
              | none => simp [hLookup] at h
              | some f =>
                  simp [hLookup] at h
                  cases hExec :
