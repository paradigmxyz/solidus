    (next' := OpenExternal.OpenResult.ok) (by
    intro state'
    cases state' with
    | Ok shared store =>
        rw [yulOpen_toOpenResult_execSeq_nil_succ
          (fuel := fuel) (codeOverride := codeOverride)
          (state := (.Ok shared store : State))]
        rfl
    | OutOfFuel => rfl
    | Checkpoint jump => rfl)]
  exact openResult_bind_ok_id _

