/--
Expose a productive `for` sequence head as the selected open loop head followed
by the ordinary syntactic tail.

This is the source-side normalization needed by the path-native loop frontier:
CALLs in the condition/body/post/recurrent loop stay inside `runLoopSource`,
and the tail is entered only after an ordinary `Ok` loop completion.
-/
theorem yulOpen_toOpenResult_execSeq_for_succ_succ_succ_succ_eq_bind_runLoopSource
    (fuel : Nat) (cond : AstExpr) (post body rest : List AstStmt)
    (codeOverride : Option AstContract) (state : State) :
    OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.execSeq fuel.succ.succ.succ.succ
          (.For cond post body :: rest) codeOverride state) =
      OpenExternal.OpenResult.bind
        (runLoopSource fuel cond post body codeOverride state)
        (fun stateAfter =>
          match stateAfter with
          | .Ok _ _ =>
              OpenExternal.YulOpenResult.toOpenResult
                (OpenExternal.YulOpen.execSeq fuel.succ.succ.succ rest
                  codeOverride stateAfter)
          | .OutOfFuel => .done (.ok stateAfter)
          | .Checkpoint _ => .done (.ok stateAfter)) := by
  rw [yulOpen_toOpenResult_execSeq_cons_succ]
  rw [yulOpen_toOpenResult_exec_for_succ_succ_succ_eq_runLoopSource]
  apply OpenExternal.OpenResult.bind_congr_next
  intro stateAfter
  cases stateAfter <;> rfl

/--
Path contract for a productive source loop head after exposing the imported
Yul loop interpreter as `runLoopSource`.

This is the semantic boundary the generated-`for` proof should target: regular
completion must still produce the exact selected-head relation needed by the
syntactic tail, while external CALLs inside the condition, body, post, or
recursive iteration remain in the selected open trace.
-/
def SourceOpenLoopHeadPathSoundWhenAtExactHiddenCtx
    (cfg : StateRelConfig) (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (lowerHead : Functions.Block)
    (allowed : Except Exception State → Prop) : Prop :=
  ∀ {source compiler trace sourceDone},
    SourceStateExactRel cfg layout source compiler →
    OpenExternal.OpenResultResolves
      (runLoopSource sourceFuel cond post body codeOverride source)
      trace sourceDone →
    (SourceResultNotRegularOk sourceDone → allowed sourceDone) →
    SourceOpenTraceResponsesAdmissible cfg trace →
    ∀ minimumTargetFuel,
      ∃ targetFuel,
        minimumTargetFuel ≤ targetFuel ∧
        OpenExternal.OpenResultPathRel
          (SourceOpenTraceCallResponseRel cfg)
          (SourceOpenStmtHeadPathDoneRel cfg layout outcomeLayout ctx
            terminalRel revertRel allowed)
          trace
          (runLoopSource sourceFuel cond post body codeOverride source)
          (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx
            targetFuel lowerHead compiler)

