    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel [.Break] codeOverride
      { stmts := [Functions.Stmt.brk] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.exec 0 (.Block [.Break]) codeOverride source =
            .error .OutOfFuel :=
        Imported.exec_zero (.Block [.Break]) codeOverride source
      rw [hZero] at hSource
      subst sourceResult
      exact False.elim (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
  | succ fuel =>
      cases fuel with
      | zero =>
          have hOne :
              EvmYul.Yul.exec 1 (.Block [.Break]) codeOverride source =
                .error .OutOfFuel := by
            simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]
          rw [hOne] at hSource
          subst sourceResult
