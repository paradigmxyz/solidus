/--
Selected finite-path relation for one initialized internal-function body.

This boundary is independent of caller-side return publication.  It starts from
the real initialized source/target callee frames, follows the admitted external
response trace through the body block, and chooses one adequate compiled body
cutoff for that trace.
-/
def SourceOpenInternalUserCallBlockPathWhen
    (cfg : StateRelConfig)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (yulProgram : Program) (program : Functions.Program)
    (bodyFuel : Nat) (params returns : List EvmYul.Identifier)
    (body : List AstStmt) (lowerFn : Functions.FunDef)
    (callerShared : EvmYul.SharedState .Yul)
    (callerStore : EvmYul.Yul.VarStore) (argValues : List Word)
    (targetState : Objects.Source.State) (paramStore : Locals.Source.Store) :
    Prop :=
  ∀ {trace : OpenExternal.OpenTrace}
    {blockDone : Except Exception State},
    OpenExternal.OpenResultResolves
      (OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.exec bodyFuel.succ (.Block body)
          (some yulProgram.contract)
          (EvmYul.Yul.State.mkOk
            (EvmYul.Yul.State.initcall params returns argValues
              (.Ok callerShared callerStore)))))
      trace blockDone →
    SourceOpenTraceResponsesAdmissible cfg trace →
    ∀ minimumTargetBodyFuel : Nat,
      ∃ targetBodyFuel : Nat,
        minimumTargetBodyFuel ≤ targetBodyFuel ∧
          OpenExternal.OpenResultPathRel
            (SourceOpenTraceCallResponseRel cfg)
            (SourceOpenResultSeqDoneRel cfg
              (lowerFn.returns ++ lowerFn.params) terminalRel revertRel
              (SourceResultCheckpointAllowed false false true))
            trace
            (OpenExternal.YulOpenResult.toOpenResult
              (OpenExternal.YulOpen.exec bodyFuel.succ (.Block body)
                (some yulProgram.contract)
                (EvmYul.Yul.State.mkOk
                  (EvmYul.Yul.State.initcall params returns argValues
                    (.Ok callerShared callerStore)))))
            (CompilerOpen.FunctionsOpen.Block.runOpen prim program
              { (Functions.Source.Ctx.initial.withLeaveScope
                  (lowerFn.returns ++ lowerFn.params)) with
                scope := lowerFn.returns ++ lowerFn.params }
              targetBodyFuel lowerFn.body
                ({ shared := targetState.shared
                   vars :=
                     Functions.Source.Store.initReturns lowerFn.returns
                       paramStore } :
                  Objects.Source.State))

