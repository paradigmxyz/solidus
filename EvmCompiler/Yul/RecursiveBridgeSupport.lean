def CheckedDispatcherLoweringSoundWhenExact (cfg : StateRelConfig)
    (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (functionProgram : Functions.Program)
    (program : Program) (sourceFuel : Nat)
    (allowed : Except Exception State → Prop) :
    Prop :=
  ∀ {freshState'},
    Stmt.toFunctionsList?
        (Fresh.initial (Contract.names program.contract))
        program.contract.dispatcher =
      some (functionProgram.body.stmts, freshState') →
    SourceResultBlockSoundWhenAtExact cfg layout layout terminalRel revertRel
      prim functionProgram Functions.Source.Ctx.initial sourceFuel
      [program.contract.dispatcher] (some program.contract)
      functionProgram.body allowed

theorem checkedDispatcherLoweringSoundWhenExact_of_stmtBlockLoweringSoundWhenFreshAtExact
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {functionProgram : Functions.Program}
    {program : Program} {sourceFuel : Nat}
    {allowed : Except Exception State → Prop}
    (hStmt :
      CheckedStmtBlockLoweringSoundWhenFreshAtExact cfg layout layout
        terminalRel revertRel prim functionProgram Functions.Source.Ctx.initial
        sourceFuel program.contract.dispatcher (some program.contract) allowed)
    (hCovers :
      FreshCoversLayout layout
        (Fresh.initial (Contract.names program.contract))) :
    CheckedDispatcherLoweringSoundWhenExact cfg layout terminalRel revertRel prim
      functionProgram program sourceFuel allowed := by
  intro freshState' hLower
  cases hBody : functionProgram.body with
  | mk stmts =>
      have hLower' :
          Stmt.toFunctionsList?
              (Fresh.initial (Contract.names program.contract))
              program.contract.dispatcher =
            some (stmts, freshState') := by
        simpa [hBody] using hLower
      simpa [hBody] using hStmt hCovers hLower'

