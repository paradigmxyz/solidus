/--
`checkAssignment` errors are front-end assignment-shape errors, never terminal
Yul halts or reverts.  Under the run-filtered bridge contract, these branches
are therefore impossible.
-/
theorem checkAssignment_error_not_relatable
    {state : State} {names : List EvmYul.Identifier}
    {err : Exception}
    (hCheck :
      EvmYul.Yul.checkAssignment state names = .error err) :
    SourceResultRelatable (.error err) → False := by
  intro hRelatable
  unfold EvmYul.Yul.checkAssignment at hCheck
  cases hDup : EvmYul.Yul.firstDuplicate? names with
  | some duplicate =>
      simp [hDup] at hCheck
      cases hCheck
      cases hRelatable
  | none =>
      simp [hDup] at hCheck
      cases hUndeclared : EvmYul.Yul.firstUndeclared? state names with
      | some undeclared =>
          simp [hUndeclared] at hCheck
          cases hCheck
          cases hRelatable
      | none =>
          simp [hUndeclared] at hCheck

/--
`checkDeclaration` errors are front-end declaration errors, never terminal Yul
halts or reverts.  Under the run-filtered bridge contract, these branches are
therefore impossible.
-/
theorem checkDeclaration_error_not_relatable
    {state : State} {names : List EvmYul.Identifier}
    {err : Exception}
    (hCheck :
      EvmYul.Yul.checkDeclaration state names = .error err) :
    SourceResultRelatable (.error err) → False := by
