import EvmCompiler.Yul.RecursiveBridge
import EvmCompiler.Yul.OpenTargetFuel

/-!
Support lemmas for the Nethermind-Yul source-tower recursive bridge.

This file is intentionally kept separate from `RecursiveBridge.lean` so parallel
bridge work can continue there with minimal merge pressure.  The theorems live
in the same namespace and can be moved into the main bridge file once the
recursive successor theorem is assembled.
-/

namespace EvmCompiler
namespace Yul
namespace Reference
namespace SourceBridgeFacts

attribute [local simp] OpenExternal.OpenResult.bind_call
  OpenExternal.YulOpenResult.bind_call
  OpenExternal.YulOpenResult.toOpenResult_call

namespace LoweringFuel

set_option maxHeartbeats 1200000 in
mutual
  theorem stmt_toFunctionsListFuel?_stable_pair :
      ∀ (stmt : AstStmt) {fuel₁ fuel₂ : Nat} {state : Fresh.State},
        Stmt.fuel stmt ≤ fuel₁ →
        Stmt.fuel stmt ≤ fuel₂ →
        Stmt.toFunctionsListFuel? fuel₁ state stmt =
          Stmt.toFunctionsListFuel? fuel₂ state stmt
    | .Block body, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                have hBody₁ : Stmt.List.fuel body ≤ fuel₁' := by
                  simp [Stmt.fuel] at h₁
                  omega
                have hBody₂ : Stmt.List.fuel body ≤ fuel₂' := by
                  simp [Stmt.fuel] at h₂
                  omega
                simp [Stmt.toFunctionsListFuel?,
                  list_toBlockFuel?_stable_pair body hBody₁ hBody₂]
    | .Let names none, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                simpa only [Stmt.toFunctionsListFuel?.eq_3]
    | .Let names (some value), fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ <;> cases fuel₂ <;>
          simp [Stmt.fuel] at h₁ h₂
        · cases value with
          | Call target args =>
              cases target with
              | inl prim =>
                  cases names with
                  | nil => rfl
                  | cons name rest =>
                      cases rest with
                      | nil => rfl
                      | cons name₂ rest₂ =>
                          rfl
              | inr functionName =>
                  cases names with
                  | nil => rfl
                  | cons name rest =>
                      cases rest with
                      | nil => rfl
                      | cons name₂ rest₂ => rfl
          | Var name =>
              cases names with
              | nil => rfl
              | cons name₁ rest =>
                  cases rest with
                  | nil => rfl
                  | cons name₂ rest₂ =>
                      rfl
          | Lit value =>
              cases names with
              | nil => rfl
              | cons name rest =>
                  cases rest with
                  | nil => rfl
                  | cons name₂ rest₂ =>
                      rfl
    | .Assign names value, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ <;> cases fuel₂ <;>
          simp [Stmt.fuel] at h₁ h₂
        · cases value with
          | Call target args =>
              cases target with
              | inl prim =>
                  cases names with
                  | nil => rfl
                  | cons name rest =>
                      cases rest with
                      | nil => rfl
                      | cons name₂ rest₂ =>
                          rfl
              | inr functionName =>
                  cases names with
                  | nil => rfl
                  | cons name rest =>
                      cases rest with
                      | nil => rfl
                      | cons name₂ rest₂ => rfl
          | Var name =>
              cases names with
              | nil => rfl
              | cons name₁ rest =>
                  cases rest with
                  | nil => rfl
                  | cons name₂ rest₂ =>
                      rfl
          | Lit value =>
              cases names with
              | nil => rfl
              | cons name rest =>
                  cases rest with
                  | nil => rfl
                  | cons name₂ rest₂ =>
                      rfl
    | .ExprStmtCall expr, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ <;> cases fuel₂ <;>
          simp [Stmt.fuel] at h₁ h₂
        · cases expr with
          | Call target args =>
              cases target with
              | inl prim => rfl
              | inr functionName => rfl
          | Var name => rfl
          | Lit value => rfl
    | .Switch scrutinee cases defaultBody, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                have hCases₁ : Stmt.CaseList.fuel cases - 1 ≤ fuel₁' := by
                  simp [Stmt.fuel] at h₁
                  have hLe :
                      Stmt.CaseList.fuel cases ≤
                        Nat.max (Stmt.CaseList.fuel cases)
                          (Stmt.List.fuel defaultBody) :=
                    Nat.le_max_left _ _
                  omega
                have hCases₂ : Stmt.CaseList.fuel cases - 1 ≤ fuel₂' := by
                  simp [Stmt.fuel] at h₂
                  have hLe :
                      Stmt.CaseList.fuel cases ≤
                        Nat.max (Stmt.CaseList.fuel cases)
                          (Stmt.List.fuel defaultBody) :=
                    Nat.le_max_left _ _
                  omega
                have hDefault₁ : Stmt.List.fuel defaultBody ≤ fuel₁' := by
                  simp [Stmt.fuel] at h₁
                  have hLe :
                      Stmt.List.fuel defaultBody ≤
                        Nat.max (Stmt.CaseList.fuel cases)
                          (Stmt.List.fuel defaultBody) :=
                    Nat.le_max_right _ _
                  omega
                have hDefault₂ : Stmt.List.fuel defaultBody ≤ fuel₂' := by
                  simp [Stmt.fuel] at h₂
                  have hLe :
                      Stmt.List.fuel defaultBody ≤
                        Nat.max (Stmt.CaseList.fuel cases)
                          (Stmt.List.fuel defaultBody) :=
                    Nat.le_max_right _ _
                  omega
                cases hScrutinee : Expr.lower1? state scrutinee with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hScrutinee]
                | some scrutineeRes =>
                    rcases scrutineeRes with ⟨preScrutinee, lowerScrutinee,
                      stateAfterScrutinee⟩
                    simp [Stmt.toFunctionsListFuel?, hScrutinee]
                    rw [caseList_toFunctionsFuel?_stable_pair cases hCases₁
                      hCases₂]
                    cases hCasesLower :
                        Stmt.CaseList.toFunctionsFuel? fuel₂'
                          stateAfterScrutinee cases with
                    | none =>
                        simp [hCasesLower]
                    | some caseRes =>
                        rcases caseRes with ⟨lowerCases, stateAfterCases⟩
                        simp [hCasesLower]
                        cases defaultBody with
                        | nil =>
                            simp
                        | cons head tail =>
                            have hDefault₁' :
                                Stmt.List.fuel (head :: tail) ≤ fuel₁' :=
                              hDefault₁
                            have hDefault₂' :
                                Stmt.List.fuel (head :: tail) ≤ fuel₂' :=
                              hDefault₂
                            rw [list_toBlockFuel?_stable_pair (head :: tail)
                              hDefault₁' hDefault₂']
    | .For cond post body, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                have hPost₁ : Stmt.List.fuel post ≤ fuel₁' := by
                  simp [Stmt.fuel] at h₁
                  have hLe :
                      Stmt.List.fuel post ≤
                        Nat.max (Stmt.List.fuel post) (Stmt.List.fuel body) :=
                    Nat.le_max_left _ _
                  omega
                have hPost₂ : Stmt.List.fuel post ≤ fuel₂' := by
                  simp [Stmt.fuel] at h₂
                  have hLe :
                      Stmt.List.fuel post ≤
                        Nat.max (Stmt.List.fuel post) (Stmt.List.fuel body) :=
                    Nat.le_max_left _ _
                  omega
                have hBody₁ : Stmt.List.fuel body ≤ fuel₁' := by
                  simp [Stmt.fuel] at h₁
                  have hLe :
                      Stmt.List.fuel body ≤
                        Nat.max (Stmt.List.fuel post) (Stmt.List.fuel body) :=
                    Nat.le_max_right _ _
                  omega
                have hBody₂ : Stmt.List.fuel body ≤ fuel₂' := by
                  simp [Stmt.fuel] at h₂
                  have hLe :
                      Stmt.List.fuel body ≤
                        Nat.max (Stmt.List.fuel post) (Stmt.List.fuel body) :=
                    Nat.le_max_right _ _
                  omega
                cases hCond : Expr.lower1? state cond with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hCond]
                | some condRes =>
                    rcases condRes with ⟨preCond, lowerCond, stateAfterCond⟩
                    simp [Stmt.toFunctionsListFuel?, hCond]
                    rw [list_toBlockFuel?_stable_pair post hPost₁ hPost₂]
                    cases hPostLower :
                        Stmt.List.toBlockFuel? fuel₂' stateAfterCond post with
                    | none =>
                        simp [hPostLower]
                    | some postRes =>
                        rcases postRes with ⟨lowerPost, stateAfterPost⟩
                        simp [hPostLower]
                        rw [list_toBlockFuel?_stable_pair body hBody₁ hBody₂]
    | .If cond body, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                have hBody₁ : Stmt.List.fuel body ≤ fuel₁' := by
                  simp [Stmt.fuel] at h₁
                  omega
                have hBody₂ : Stmt.List.fuel body ≤ fuel₂' := by
                  simp [Stmt.fuel] at h₂
                  omega
                cases hCond : Expr.lower1? state cond with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hCond]
                | some condRes =>
                    rcases condRes with ⟨preCond, lowerCond, stateAfterCond⟩
                    simp [Stmt.toFunctionsListFuel?, hCond]
                    rw [list_toBlockFuel?_stable_pair body hBody₁ hBody₂]
    | .Continue, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                rfl
    | .Break, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                rfl
    | .Leave, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.fuel] at h₂
            | succ fuel₂' =>
                rfl

  theorem list_toFunctionsFuel?_stable_pair :
      ∀ (stmts : List AstStmt) {fuel₁ fuel₂ : Nat}
        {state : Fresh.State},
        Stmt.List.fuel stmts - 1 ≤ fuel₁ →
        Stmt.List.fuel stmts - 1 ≤ fuel₂ →
        Stmt.List.toFunctionsFuel? fuel₁ state stmts =
          Stmt.List.toFunctionsFuel? fuel₂ state stmts
    | [], fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ <;> cases fuel₂ <;>
          simp [Stmt.List.fuel, Stmt.List.toFunctionsFuel?] at h₁ h₂ ⊢
    | stmt :: rest, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.List.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.List.fuel] at h₂
            | succ fuel₂' =>
                have hStmt₁ : Stmt.fuel stmt ≤ fuel₁' := by
                  simp [Stmt.List.fuel] at h₁
                  have hLe :
                      Stmt.fuel stmt ≤
                        Nat.max (Stmt.fuel stmt) (Stmt.List.fuel rest) :=
                    Nat.le_max_left _ _
                  omega
                have hStmt₂ : Stmt.fuel stmt ≤ fuel₂' := by
                  simp [Stmt.List.fuel] at h₂
                  have hLe :
                      Stmt.fuel stmt ≤
                        Nat.max (Stmt.fuel stmt) (Stmt.List.fuel rest) :=
                    Nat.le_max_left _ _
                  omega
                have hRest₁ : Stmt.List.fuel rest - 1 ≤ fuel₁' := by
                  simp [Stmt.List.fuel] at h₁
                  have hLe :
                      Stmt.List.fuel rest ≤
                        Nat.max (Stmt.fuel stmt) (Stmt.List.fuel rest) :=
                    Nat.le_max_right _ _
                  omega
                have hRest₂ : Stmt.List.fuel rest - 1 ≤ fuel₂' := by
                  simp [Stmt.List.fuel] at h₂
                  have hLe :
                      Stmt.List.fuel rest ≤
                        Nat.max (Stmt.fuel stmt) (Stmt.List.fuel rest) :=
                    Nat.le_max_right _ _
                  omega
                simp [Stmt.List.toFunctionsFuel?]
                rw [stmt_toFunctionsListFuel?_stable_pair stmt hStmt₁ hStmt₂]
                cases hStmtLower :
                    Stmt.toFunctionsListFuel? fuel₂' state stmt with
                | none =>
                    simp [hStmtLower]
                | some stmtRes =>
                    rcases stmtRes with ⟨lowerStmt, stateAfterStmt⟩
                    simp [hStmtLower]
                    rw [list_toFunctionsFuel?_stable_pair rest hRest₁ hRest₂]

  theorem caseList_toFunctionsFuel?_stable_pair :
      ∀ (cases : List (Word × List AstStmt)) {fuel₁ fuel₂ : Nat}
        {state : Fresh.State},
        Stmt.CaseList.fuel cases - 1 ≤ fuel₁ →
        Stmt.CaseList.fuel cases - 1 ≤ fuel₂ →
        Stmt.CaseList.toFunctionsFuel? fuel₁ state cases =
          Stmt.CaseList.toFunctionsFuel? fuel₂ state cases
    | [], fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ <;> cases fuel₂ <;>
          simp [Stmt.CaseList.fuel, Stmt.CaseList.toFunctionsFuel?]
            at h₁ h₂ ⊢
    | (value, body) :: rest, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            simp [Stmt.CaseList.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                simp [Stmt.CaseList.fuel] at h₂
            | succ fuel₂' =>
                have hBody₁ : Stmt.List.fuel body ≤ fuel₁' := by
                  simp [Stmt.CaseList.fuel] at h₁
                  have hLe :
                      Stmt.List.fuel body ≤
                        Nat.max (Stmt.List.fuel body)
                          (Stmt.CaseList.fuel rest) :=
                    Nat.le_max_left _ _
                  omega
                have hBody₂ : Stmt.List.fuel body ≤ fuel₂' := by
                  simp [Stmt.CaseList.fuel] at h₂
                  have hLe :
                      Stmt.List.fuel body ≤
                        Nat.max (Stmt.List.fuel body)
                          (Stmt.CaseList.fuel rest) :=
                    Nat.le_max_left _ _
                  omega
                have hRest₁ : Stmt.CaseList.fuel rest - 1 ≤ fuel₁' := by
                  simp [Stmt.CaseList.fuel] at h₁
                  have hLe :
                      Stmt.CaseList.fuel rest ≤
                        Nat.max (Stmt.List.fuel body)
                          (Stmt.CaseList.fuel rest) :=
                    Nat.le_max_right _ _
                  omega
                have hRest₂ : Stmt.CaseList.fuel rest - 1 ≤ fuel₂' := by
                  simp [Stmt.CaseList.fuel] at h₂
                  have hLe :
                      Stmt.CaseList.fuel rest ≤
                        Nat.max (Stmt.List.fuel body)
                          (Stmt.CaseList.fuel rest) :=
                    Nat.le_max_right _ _
                  omega
                simp [Stmt.CaseList.toFunctionsFuel?]
                rw [list_toBlockFuel?_stable_pair body hBody₁ hBody₂]
                cases hBodyLower :
                    Stmt.List.toBlockFuel? fuel₂' state body with
                | none =>
                    simp [hBodyLower]
                | some bodyRes =>
                    rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
                    simp [hBodyLower]
                    rw [caseList_toFunctionsFuel?_stable_pair rest hRest₁
                      hRest₂]

  theorem list_toBlockFuel?_stable_pair :
      ∀ (stmts : List AstStmt) {fuel₁ fuel₂ : Nat}
        {state : Fresh.State},
        Stmt.List.fuel stmts ≤ fuel₁ →
        Stmt.List.fuel stmts ≤ fuel₂ →
        Stmt.List.toBlockFuel? fuel₁ state stmts =
          Stmt.List.toBlockFuel? fuel₂ state stmts
    | stmts, fuel₁, fuel₂, state, h₁, h₂ => by
        cases fuel₁ with
        | zero =>
            cases stmts <;> simp [Stmt.List.fuel] at h₁
        | succ fuel₁' =>
            cases fuel₂ with
            | zero =>
                cases stmts <;> simp [Stmt.List.fuel] at h₂
            | succ fuel₂' =>
                have hFuncs₁ : Stmt.List.fuel stmts - 1 ≤ fuel₁' := by
                  omega
                have hFuncs₂ : Stmt.List.fuel stmts - 1 ≤ fuel₂' := by
                  omega
                simp [Stmt.List.toBlockFuel?]
                rw [list_toFunctionsFuel?_stable_pair stmts hFuncs₁ hFuncs₂]
end

theorem list_toBlockFuel?_toBlock?
    (stmts : List AstStmt) {fuel : Nat} {state : Fresh.State}
    (hFuel : Stmt.List.fuel stmts ≤ fuel) :
    Stmt.List.toBlockFuel? fuel state stmts =
      Stmt.List.toBlock? state stmts := by
  exact
    list_toBlockFuel?_stable_pair stmts hFuel (Nat.le_refl _)

set_option maxHeartbeats 1200000 in
mutual
  theorem stmt_toFunctionsListFuel?_of_some_high :
      ∀ (stmt : AstStmt) {fuel high : Nat} {state : Fresh.State}
        {lower : List Functions.Stmt} {state' : Fresh.State},
        Stmt.fuel stmt ≤ high →
        Stmt.toFunctionsListFuel? fuel state stmt = some (lower, state') →
        Stmt.toFunctionsListFuel? high state stmt = some (lower, state')
    | .Block body, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                have hBodyHigh : Stmt.List.fuel body ≤ high' := by
                  simp [Stmt.fuel] at hHigh
                  omega
                cases hBody :
                    Stmt.List.toBlockFuel? fuel' state body with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hBody] at hLower
                | some bodyRes =>
                    rcases bodyRes with ⟨lowerBody, stateBody⟩
                    have hBody' :
                        Stmt.List.toBlockFuel? high' state body =
                          some (lowerBody, stateBody) :=
                      list_toBlockFuel?_of_some_high body hBodyHigh hBody
                    simpa [Stmt.toFunctionsListFuel?, hBody, hBody'] using
                      hLower
    | .Let names none, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                rw [Nat.add_one] at hLower ⊢
                rw [Stmt.toFunctionsListFuel?.eq_3] at hLower ⊢
                exact hLower
    | .Let names (some value), fuel, high, state, lower, state', hHigh,
        hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                cases value with
                | Call target args =>
                    cases target with
                    | inl prim =>
                        cases names with
                        | nil =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_6]
                              using hLower
                        | cons name rest =>
                            cases rest with
                            | nil =>
                                simpa only [Stmt.toFunctionsListFuel?.eq_5]
                                  using hLower
                            | cons name₂ rest₂ =>
                                simpa only [Stmt.toFunctionsListFuel?.eq_6]
                                  using hLower
                    | inr functionName =>
                        cases names with
                        | nil =>
                            simpa [Stmt.toFunctionsListFuel?] using hLower
                        | cons name rest =>
                            cases rest with
                            | nil =>
                                simpa [Stmt.toFunctionsListFuel?] using hLower
                            | cons name₂ rest₂ =>
                                simpa [Stmt.toFunctionsListFuel?] using hLower
                | Var name =>
                    cases names with
                    | nil =>
                        simpa only [Stmt.toFunctionsListFuel?.eq_6]
                          using hLower
                    | cons name₁ rest =>
                        cases rest with
                        | nil =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_5]
                              using hLower
                        | cons name₂ rest₂ =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_6]
                              using hLower
                | Lit value =>
                    cases names with
                    | nil =>
                        simpa only [Stmt.toFunctionsListFuel?.eq_6]
                          using hLower
                    | cons name rest =>
                        cases rest with
                        | nil =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_5]
                              using hLower
                        | cons name₂ rest₂ =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_6]
                              using hLower
    | .Assign names value, fuel, high, state, lower, state', hHigh,
        hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                cases value with
                | Call target args =>
                    cases target with
                    | inl prim =>
                        cases names with
                        | nil =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_9]
                              using hLower
                        | cons name rest =>
                            cases rest with
                            | nil =>
                                simpa only [Stmt.toFunctionsListFuel?.eq_8]
                                  using hLower
                            | cons name₂ rest₂ =>
                                simpa only [Stmt.toFunctionsListFuel?.eq_9]
                                  using hLower
                    | inr functionName =>
                        cases names with
                        | nil =>
                            simpa [Stmt.toFunctionsListFuel?] using hLower
                        | cons name rest =>
                            cases rest with
                            | nil =>
                                simpa [Stmt.toFunctionsListFuel?] using hLower
                            | cons name₂ rest₂ =>
                                simpa [Stmt.toFunctionsListFuel?] using hLower
                | Var name =>
                    cases names with
                    | nil =>
                        simpa only [Stmt.toFunctionsListFuel?.eq_9]
                          using hLower
                    | cons name₁ rest =>
                        cases rest with
                        | nil =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_8]
                              using hLower
                        | cons name₂ rest₂ =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_9]
                              using hLower
                | Lit value =>
                    cases names with
                    | nil =>
                        simpa only [Stmt.toFunctionsListFuel?.eq_9]
                          using hLower
                    | cons name rest =>
                        cases rest with
                        | nil =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_8]
                              using hLower
                        | cons name₂ rest₂ =>
                            simpa only [Stmt.toFunctionsListFuel?.eq_9]
                              using hLower
    | .ExprStmtCall expr, fuel, high, state, lower, state', hHigh,
        hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                cases expr with
                | Call target args =>
                    cases target with
                    | inl prim =>
                        simpa only [Stmt.toFunctionsListFuel?.eq_11]
                          using hLower
                    | inr functionName =>
                        simpa only [Stmt.toFunctionsListFuel?.eq_10]
                          using hLower
                | Var name =>
                    simpa only [Stmt.toFunctionsListFuel?.eq_12] using hLower
                | Lit value =>
                    simpa only [Stmt.toFunctionsListFuel?.eq_12] using hLower
    | .Switch scrutinee cases defaultBody, fuel, high, state, lower, state',
        hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                have hCasesHigh :
                    Stmt.CaseList.fuel cases - 1 ≤ high' := by
                  simp [Stmt.fuel] at hHigh
                  have hLe :
                      Stmt.CaseList.fuel cases ≤
                        Nat.max (Stmt.CaseList.fuel cases)
                          (Stmt.List.fuel defaultBody) :=
                    Nat.le_max_left _ _
                  omega
                have hDefaultHigh :
                    Stmt.List.fuel defaultBody ≤ high' := by
                  simp [Stmt.fuel] at hHigh
                  have hLe :
                      Stmt.List.fuel defaultBody ≤
                        Nat.max (Stmt.CaseList.fuel cases)
                          (Stmt.List.fuel defaultBody) :=
                    Nat.le_max_right _ _
                  omega
                cases hScrutinee : Expr.lower1? state scrutinee with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hScrutinee] at hLower
                | some scrutineeRes =>
                    rcases scrutineeRes with
                      ⟨preScrutinee, lowerScrutinee, stateAfterScrutinee⟩
                    cases hCases :
                        Stmt.CaseList.toFunctionsFuel? fuel'
                          stateAfterScrutinee cases with
                    | none =>
                        simp [Stmt.toFunctionsListFuel?, hScrutinee, hCases]
                          at hLower
                    | some caseRes =>
                        rcases caseRes with ⟨lowerCases, stateAfterCases⟩
                        have hCases' :
                            Stmt.CaseList.toFunctionsFuel? high'
                                stateAfterScrutinee cases =
                              some (lowerCases, stateAfterCases) :=
                          caseList_toFunctionsFuel?_of_some_high cases
                            hCasesHigh hCases
                        cases defaultBody with
                        | nil =>
                            simpa [Stmt.toFunctionsListFuel?, hScrutinee,
                              hCases, hCases'] using hLower
                        | cons head tail =>
                            cases hDefault :
                                Stmt.List.toBlockFuel? fuel' stateAfterCases
                                  (head :: tail) with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hScrutinee,
                                  hCases, hDefault] at hLower
                            | some defaultRes =>
                                rcases defaultRes with
                                  ⟨lowerDefault, stateAfterDefault⟩
                                have hDefault' :
                                    Stmt.List.toBlockFuel? high'
                                        stateAfterCases (head :: tail) =
                                      some (lowerDefault,
                                        stateAfterDefault) :=
                                  list_toBlockFuel?_of_some_high
                                    (head :: tail) hDefaultHigh hDefault
                                simpa [Stmt.toFunctionsListFuel?, hScrutinee,
                                  hCases, hCases', hDefault, hDefault'] using
                                  hLower
    | .For cond post body, fuel, high, state, lower, state', hHigh,
        hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                have hPostHigh : Stmt.List.fuel post ≤ high' := by
                  simp [Stmt.fuel] at hHigh
                  have hLe :
                      Stmt.List.fuel post ≤
                        Nat.max (Stmt.List.fuel post)
                          (Stmt.List.fuel body) :=
                    Nat.le_max_left _ _
                  omega
                have hBodyHigh : Stmt.List.fuel body ≤ high' := by
                  simp [Stmt.fuel] at hHigh
                  have hLe :
                      Stmt.List.fuel body ≤
                        Nat.max (Stmt.List.fuel post)
                          (Stmt.List.fuel body) :=
                    Nat.le_max_right _ _
                  omega
                cases hCond : Expr.lower1? state cond with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hCond] at hLower
                | some condRes =>
                    rcases condRes with ⟨preCond, lowerCond, stateAfterCond⟩
                    cases hPost :
                        Stmt.List.toBlockFuel? fuel' stateAfterCond post with
                    | none =>
                        simp [Stmt.toFunctionsListFuel?, hCond, hPost]
                          at hLower
                    | some postRes =>
                        rcases postRes with ⟨lowerPost, stateAfterPost⟩
                        have hPost' :
                            Stmt.List.toBlockFuel? high' stateAfterCond post =
                              some (lowerPost, stateAfterPost) :=
                          list_toBlockFuel?_of_some_high post hPostHigh
                            hPost
                        cases hBody :
                            Stmt.List.toBlockFuel? fuel' stateAfterPost
                              body with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hCond, hPost,
                              hBody] at hLower
                        | some bodyRes =>
                            rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
                            have hBody' :
                                Stmt.List.toBlockFuel? high' stateAfterPost
                                    body =
                                  some (lowerBody, stateAfterBody) :=
                              list_toBlockFuel?_of_some_high body hBodyHigh
                                hBody
                            simpa [Stmt.toFunctionsListFuel?, hCond, hPost,
                              hPost', hBody, hBody'] using hLower
    | .If cond body, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                have hBodyHigh : Stmt.List.fuel body ≤ high' := by
                  simp [Stmt.fuel] at hHigh
                  omega
                cases hCond : Expr.lower1? state cond with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hCond] at hLower
                | some condRes =>
                    rcases condRes with ⟨preCond, lowerCond, stateAfterCond⟩
                    cases hBody :
                        Stmt.List.toBlockFuel? fuel' stateAfterCond body with
                    | none =>
                        simp [Stmt.toFunctionsListFuel?, hCond, hBody]
                          at hLower
                    | some bodyRes =>
                        rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
                        have hBody' :
                            Stmt.List.toBlockFuel? high' stateAfterCond body =
                              some (lowerBody, stateAfterBody) :=
                          list_toBlockFuel?_of_some_high body hBodyHigh hBody
                        simpa [Stmt.toFunctionsListFuel?, hCond, hBody,
                          hBody'] using hLower
    | .Continue, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                simpa [Stmt.toFunctionsListFuel?] using hLower
    | .Break, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                simpa [Stmt.toFunctionsListFuel?] using hLower
    | .Leave, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.toFunctionsListFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.fuel] at hHigh
            | succ high' =>
                simpa [Stmt.toFunctionsListFuel?] using hLower

  theorem list_toFunctionsFuel?_of_some_high :
      ∀ (stmts : List AstStmt) {fuel high : Nat} {state : Fresh.State}
        {lower : List Functions.Stmt} {state' : Fresh.State},
        Stmt.List.fuel stmts - 1 ≤ high →
        Stmt.List.toFunctionsFuel? fuel state stmts = some (lower, state') →
        Stmt.List.toFunctionsFuel? high state stmts = some (lower, state')
    | [], fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.List.toFunctionsFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.List.fuel] at hHigh
            | succ high' =>
                simpa [Stmt.List.toFunctionsFuel?] using hLower
    | stmt :: rest, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.List.toFunctionsFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.List.fuel] at hHigh
            | succ high' =>
                have hStmtHigh : Stmt.fuel stmt ≤ high' := by
                  simp [Stmt.List.fuel] at hHigh
                  have hLe :
                      Stmt.fuel stmt ≤
                        Nat.max (Stmt.fuel stmt) (Stmt.List.fuel rest) :=
                    Nat.le_max_left _ _
                  omega
                have hRestHigh : Stmt.List.fuel rest - 1 ≤ high' := by
                  simp [Stmt.List.fuel] at hHigh
                  have hLe :
                      Stmt.List.fuel rest ≤
                        Nat.max (Stmt.fuel stmt) (Stmt.List.fuel rest) :=
                    Nat.le_max_right _ _
                  omega
                cases hStmt :
                    Stmt.toFunctionsListFuel? fuel' state stmt with
                | none =>
                    simp [Stmt.List.toFunctionsFuel?, hStmt] at hLower
                | some stmtRes =>
                    rcases stmtRes with ⟨lowerStmt, stateAfterStmt⟩
                    have hStmt' :
                        Stmt.toFunctionsListFuel? high' state stmt =
                          some (lowerStmt, stateAfterStmt) :=
                      stmt_toFunctionsListFuel?_of_some_high stmt
                        hStmtHigh hStmt
                    cases hRest :
                        Stmt.List.toFunctionsFuel? fuel' stateAfterStmt
                          rest with
                    | none =>
                        simp [Stmt.List.toFunctionsFuel?, hStmt, hRest]
                          at hLower
                    | some restRes =>
                        rcases restRes with ⟨lowerRest, stateAfterRest⟩
                        have hRest' :
                            Stmt.List.toFunctionsFuel? high'
                                stateAfterStmt rest =
                              some (lowerRest, stateAfterRest) :=
                          list_toFunctionsFuel?_of_some_high rest
                            hRestHigh hRest
                        simpa [Stmt.List.toFunctionsFuel?, hStmt, hStmt',
                          hRest, hRest'] using hLower

  theorem caseList_toFunctionsFuel?_of_some_high :
      ∀ (cases : List (Word × List AstStmt)) {fuel high : Nat}
        {state : Fresh.State}
        {lower : List (Word × Functions.Block)}
        {state' : Fresh.State},
        Stmt.CaseList.fuel cases - 1 ≤ high →
        Stmt.CaseList.toFunctionsFuel? fuel state cases =
          some (lower, state') →
        Stmt.CaseList.toFunctionsFuel? high state cases =
          some (lower, state')
    | [], fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.CaseList.toFunctionsFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.CaseList.fuel] at hHigh
            | succ high' =>
                simpa [Stmt.CaseList.toFunctionsFuel?] using hLower
    | (value, body) :: rest, fuel, high, state, lower, state', hHigh,
        hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.CaseList.toFunctionsFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                simp [Stmt.CaseList.fuel] at hHigh
            | succ high' =>
                have hBodyHigh : Stmt.List.fuel body ≤ high' := by
                  simp [Stmt.CaseList.fuel] at hHigh
                  have hLe :
                      Stmt.List.fuel body ≤
                        Nat.max (Stmt.List.fuel body)
                          (Stmt.CaseList.fuel rest) :=
                    Nat.le_max_left _ _
                  omega
                have hRestHigh : Stmt.CaseList.fuel rest - 1 ≤ high' := by
                  simp [Stmt.CaseList.fuel] at hHigh
                  have hLe :
                      Stmt.CaseList.fuel rest ≤
                        Nat.max (Stmt.List.fuel body)
                          (Stmt.CaseList.fuel rest) :=
                    Nat.le_max_right _ _
                  omega
                cases hBody :
                    Stmt.List.toBlockFuel? fuel' state body with
                | none =>
                    simp [Stmt.CaseList.toFunctionsFuel?, hBody] at hLower
                | some bodyRes =>
                    rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
                    have hBody' :
                        Stmt.List.toBlockFuel? high' state body =
                          some (lowerBody, stateAfterBody) :=
                      list_toBlockFuel?_of_some_high body hBodyHigh hBody
                    cases hRest :
                        Stmt.CaseList.toFunctionsFuel? fuel'
                          stateAfterBody rest with
                    | none =>
                        simp [Stmt.CaseList.toFunctionsFuel?, hBody, hRest]
                          at hLower
                    | some restRes =>
                        rcases restRes with ⟨lowerRest, stateAfterRest⟩
                        have hRest' :
                            Stmt.CaseList.toFunctionsFuel? high'
                                stateAfterBody rest =
                              some (lowerRest, stateAfterRest) :=
                          caseList_toFunctionsFuel?_of_some_high rest
                            hRestHigh hRest
                        simpa [Stmt.CaseList.toFunctionsFuel?, hBody, hBody',
                          hRest, hRest'] using hLower

  theorem list_toBlockFuel?_of_some_high :
      ∀ (stmts : List AstStmt) {fuel high : Nat} {state : Fresh.State}
        {lower : Functions.Block} {state' : Fresh.State},
        Stmt.List.fuel stmts ≤ high →
        Stmt.List.toBlockFuel? fuel state stmts = some (lower, state') →
        Stmt.List.toBlockFuel? high state stmts = some (lower, state')
    | stmts, fuel, high, state, lower, state', hHigh, hLower => by
        cases fuel with
        | zero =>
            simp [Stmt.List.toBlockFuel?] at hLower
        | succ fuel' =>
            cases high with
            | zero =>
                cases stmts <;> simp [Stmt.List.fuel] at hHigh
            | succ high' =>
                have hFuncsHigh : Stmt.List.fuel stmts - 1 ≤ high' := by
                  omega
                cases hFuncs :
                    Stmt.List.toFunctionsFuel? fuel' state stmts with
                | none =>
                    simp [Stmt.List.toBlockFuel?, hFuncs] at hLower
                | some funcsRes =>
                    rcases funcsRes with ⟨lowerFuncs, stateAfterFuncs⟩
                    have hFuncs' :
                        Stmt.List.toFunctionsFuel? high' state stmts =
                          some (lowerFuncs, stateAfterFuncs) :=
                      list_toFunctionsFuel?_of_some_high stmts hFuncsHigh
                        hFuncs
                    simpa [Stmt.List.toBlockFuel?, hFuncs, hFuncs'] using
                      hLower
end

end LoweringFuel

namespace FunctionEntryList

def find? (functionName : Name) :
    List (Name × AstFunctionDefinition) → Option AstFunctionDefinition
  | [] => none
  | (name, fn) :: rest =>
      if name = functionName then
        some fn
      else
        find? functionName rest

theorem toFunDefsFuel?_head_name
    {fuel : Nat} {state state' : Fresh.State}
    {name : Name} {fn : AstFunctionDefinition} {lowerFn : Functions.FunDef}
    (hLower :
      FunctionDefinition.toFunDefFuel? fuel state name fn =
        some (lowerFn, state')) :
    lowerFn.name = name := by
  cases fn with
  | Def params returns body =>
      cases hBody : Stmt.List.toBlockFuel? fuel state body with
      | none =>
          simp [FunctionDefinition.toFunDefFuel?, hBody] at hLower
      | some bodyRes =>
          rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
          simp [FunctionDefinition.toFunDefFuel?, hBody] at hLower
          rcases hLower with ⟨hLowerFn, _hState⟩
          rw [← hLowerFn]

/--
Lookup alignment for a lowered Yul function-entry list.

This is intentionally source-list-shaped, not Finmap-shaped: later dispatcher
proofs can separately connect `Contract.functionEntries` to Nethermind's
`functions.lookup`. The theorem here only records the compiler fact that
successful function-list lowering preserves function lookup and exposes the
callee body's checked lowering equation.
-/
theorem toFunDefsFuel?_find?_some
    {fuel : Nat} {state state' : Fresh.State}
    {entries : List (Name × AstFunctionDefinition)}
    {functions : List Functions.FunDef}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hLower :
      FunctionList.toFunDefsFuel? fuel state entries =
        some (functions, state'))
    (hFind : find? functionName entries = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlockFuel? fuel freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns := by
  induction entries generalizing state state' functions with
  | nil =>
      simp [find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      cases hHead :
          FunctionDefinition.toFunDefFuel? fuel state headName headFn with
      | none =>
          simp [FunctionList.toFunDefsFuel?, hHead] at hLower
      | some headRes =>
          rcases headRes with ⟨lowerHead, stateAfterHead⟩
          cases hRest :
              FunctionList.toFunDefsFuel? fuel stateAfterHead rest with
          | none =>
              simp [FunctionList.toFunDefsFuel?, hHead, hRest] at hLower
          | some restRes =>
              rcases restRes with ⟨lowerRest, stateAfterRest⟩
              simp [FunctionList.toFunDefsFuel?, hHead, hRest] at hLower
              rcases hLower with ⟨hFunctions, hState'⟩
              subst functions
              subst state'
              have hLowerHeadName : lowerHead.name = headName :=
                toFunDefsFuel?_head_name hHead
              by_cases hEq : headName = functionName
              · have hFindHead : headFn = fn := by
                  simpa [find?, hEq] using hFind
                subst fn
                subst functionName
                cases headFn with
                | Def params returns body =>
                    cases hBody :
                        Stmt.List.toBlockFuel? fuel state body with
                    | none =>
                        simp [FunctionDefinition.toFunDefFuel?, hBody]
                          at hHead
                    | some bodyRes =>
                        rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
                        simp [FunctionDefinition.toFunDefFuel?, hBody]
                          at hHead
                        rcases hHead with ⟨hLowerHead, _hStateAfterHead⟩
                        refine
                          ⟨lowerHead, ?_, params, returns, body, state,
                            stateAfterBody, rfl, ?_, ?_, ?_, ?_⟩
                        · simp [Functions.Source.FunList.find?,
                            hLowerHeadName]
                        · simpa [← hLowerHead] using hBody
                        · simpa [← hLowerHead]
                        · simpa [← hLowerHead]
                        · simpa [← hLowerHead]
              · simp [find?, hEq] at hFind
                rcases ih hRest hFind with
                  ⟨lowerFn, hLowerFind, params, returns, body, freshBefore,
                    freshAfter, hFn, hBody, hName, hParams, hReturns⟩
                refine
                  ⟨lowerFn, ?_, params, returns, body, freshBefore,
                    freshAfter, hFn, hBody, hName, hParams, hReturns⟩
                simpa [Functions.Source.FunList.find?, hLowerHeadName, hEq]
                  using hLowerFind

theorem find?_filterMap_lookup_of_mem
    (functions : Finmap (fun _ : Name => AstFunctionDefinition))
    {keys : List Name} {functionName : Name} {fn : AstFunctionDefinition}
    (hNodup : keys.Nodup)
    (hMem : functionName ∈ keys)
    (hLookup : functions.lookup functionName = some fn) :
    find? functionName
        (keys.filterMap fun name =>
          match functions.lookup name with
          | some fn => some (name, fn)
          | none => none) =
      some fn := by
  induction keys with
  | nil =>
      simp at hMem
  | cons head rest ih =>
      have hRestNodup : rest.Nodup := hNodup.tail
      by_cases hEq : head = functionName
      · subst functionName
        simp [hLookup, find?]
      · have hMemRest : functionName ∈ rest := by
          have hNe : functionName ≠ head := by
            intro h
            exact hEq h.symm
          simpa [hNe] using hMem
        have hRest := ih hRestNodup hMemRest
        cases hHeadLookup : functions.lookup head with
        | none =>
            simpa [hHeadLookup] using hRest
        | some headFn =>
            simp [hHeadLookup, find?, hEq, hRest]

theorem find?_contract_functionEntries_of_lookup
    (contract : AstContract) {functionName : Name}
    {fn : AstFunctionDefinition}
    (hLookup : contract.functions.lookup functionName = some fn) :
    find? functionName (Contract.functionEntries contract) = some fn := by
  unfold Contract.functionEntries
  apply find?_filterMap_lookup_of_mem
  · exact Finset.nodup_toList contract.functions.keys
  · rw [Finset.mem_toList, Finmap.mem_keys]
    exact Finmap.mem_of_lookup_eq_some hLookup
  · exact hLookup

theorem body_fuel_le_functionList_fuel_of_find?
    {entries : List (Name × AstFunctionDefinition)}
    {functionName : Name} {params returns : List EvmYul.Identifier}
    {body : List AstStmt}
    (hFind : find? functionName entries = some (.Def params returns body)) :
    Stmt.List.fuel body ≤ FunctionList.fuel entries := by
  induction entries with
  | nil =>
      simp [find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      by_cases hEq : headName = functionName
      · simp [find?, hEq] at hFind
        subst headName
        subst headFn
        simp [FunctionDefinition.fuel, FunctionList.fuel]
        have hLe :
            Stmt.List.fuel body + 2 ≤
              Nat.max (Stmt.List.fuel body + 2)
                (FunctionList.fuel rest) :=
          Nat.le_max_left _ _
        omega
      · simp [find?, hEq] at hFind
        have hRest := ih hFind
        simp [FunctionList.fuel]
        have hLe :
            FunctionList.fuel rest ≤
              Nat.max (FunctionDefinition.fuel headFn)
                (FunctionList.fuel rest) :=
          Nat.le_max_right _ _
        omega

theorem toFunDefs?_find?_of_contract_lookup
    {contract : AstContract} {state state' : Fresh.State}
    {functions : List Functions.FunDef}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hLower :
      FunctionList.toFunDefs? state (Contract.functionEntries contract) =
        some (functions, state'))
    (hLookup : contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlockFuel? (FunctionList.fuel (Contract.functionEntries contract))
          freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns := by
  exact
    toFunDefsFuel?_find?_some
      (fuel := FunctionList.fuel (Contract.functionEntries contract))
      (state := state) (state' := state') (entries := Contract.functionEntries contract)
      (functions := functions) (functionName := functionName) (fn := fn)
      (by simpa [FunctionList.toFunDefs?] using hLower)
      (find?_contract_functionEntries_of_lookup contract hLookup)

theorem toFunDefs?_find?_of_contract_lookup_toBlock?
    {contract : AstContract} {state state' : Fresh.State}
    {functions : List Functions.FunDef}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hLower :
      FunctionList.toFunDefs? state (Contract.functionEntries contract) =
        some (functions, state'))
    (hLookup : contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns := by
  have hEntryFind :
      find? functionName (Contract.functionEntries contract) = some fn :=
    find?_contract_functionEntries_of_lookup contract hLookup
  rcases
      toFunDefs?_find?_of_contract_lookup
        (contract := contract) (state := state) (state' := state')
        (functions := functions) (functionName := functionName) (fn := fn)
        hLower hLookup with
    ⟨lowerFn, hLowerFind, params, returns, body, freshBefore, freshAfter,
      hFn, hBody, hName, hParams, hReturns⟩
  have hBodyFuel :
      Stmt.List.fuel body ≤
        FunctionList.fuel (Contract.functionEntries contract) := by
    subst fn
    exact body_fuel_le_functionList_fuel_of_find? hEntryFind
  have hStable :
      Stmt.List.toBlockFuel?
          (FunctionList.fuel (Contract.functionEntries contract))
          freshBefore body =
        Stmt.List.toBlock? freshBefore body :=
    LoweringFuel.list_toBlockFuel?_toBlock? body hBodyFuel
  rw [hStable] at hBody
  exact
    ⟨lowerFn, hLowerFind, params, returns, body, freshBefore, freshAfter,
      hFn, hBody, hName, hParams, hReturns⟩

theorem toObjects?_find?_of_contract_lookup
    {program : Program} {functionProgram : Functions.Program}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hLookup : program.contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName
          functionProgram.functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlockFuel?
            (FunctionList.fuel (Contract.functionEntries program.contract))
            freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns := by
  rcases
      Reference.BridgeFacts.toObjects?_root_components
        (program := program) (functionProgram := functionProgram)
        hToObjects with
    ⟨_bodyStmts, state, functions, state', _hBody, hFunctions, hProgram⟩
  cases hProgram
  exact
    toFunDefs?_find?_of_contract_lookup
      (contract := program.contract) (state := state) (state' := state')
      (functions := functions) (functionName := functionName) (fn := fn)
      hFunctions hLookup

theorem toObjects?_find?_of_contract_lookup_toBlock?
    {program : Program} {functionProgram : Functions.Program}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hLookup : program.contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName
          functionProgram.functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns := by
  rcases
      Reference.BridgeFacts.toObjects?_root_components
        (program := program) (functionProgram := functionProgram)
        hToObjects with
    ⟨_bodyStmts, state, functions, state', _hBody, hFunctions, hProgram⟩
  cases hProgram
  exact
    toFunDefs?_find?_of_contract_lookup_toBlock?
      (contract := program.contract) (state := state) (state' := state')
      (functions := functions) (functionName := functionName) (fn := fn)
      hFunctions hLookup

end FunctionEntryList

namespace NoShadowing

theorem functionEntries_functionDefinition_of_find?
    {functionEnv : List Name}
    {entries : List (Name × AstFunctionDefinition)}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hEntries : Safe.NoShadowing.functionEntries functionEnv entries)
    (hFind : FunctionEntryList.find? functionName entries = some fn) :
    Safe.NoShadowing.functionDefinition functionEnv fn := by
  induction entries with
  | nil =>
      simp [FunctionEntryList.find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      rcases hEntries with ⟨hHead, hRest⟩
      by_cases hEq : headName = functionName
      · have hHeadFn : headFn = fn := by
          simpa [FunctionEntryList.find?, hEq] using hFind
        simpa [hHeadFn] using hHead
      · simp [FunctionEntryList.find?, hEq] at hFind
        exact ih hRest hFind

theorem functionDefinition_of_contract_lookup
    {program : Program} {functionName : Name}
    {fn : AstFunctionDefinition}
    (hNoShadowing : Safe.NoShadowing.program program)
    (hLookup : program.contract.functions.lookup functionName = some fn) :
    Safe.NoShadowing.functionDefinition
      ((Contract.functionEntries program.contract).map Prod.fst) fn := by
  have hFind :
      FunctionEntryList.find? functionName
          (Contract.functionEntries program.contract) =
        some fn :=
    FunctionEntryList.find?_contract_functionEntries_of_lookup
      program.contract hLookup
  unfold Safe.NoShadowing.program Safe.NoShadowing.contract at hNoShadowing
  exact
    functionEntries_functionDefinition_of_find?
      (functionEnv := (Contract.functionEntries program.contract).map Prod.fst)
      hNoShadowing.2.2 hFind

theorem functionDefinition_param_return_facts
    {functionEnv : List Name}
    {params rets : List EvmYul.Identifier} {body : List AstStmt}
    (hFn :
      Safe.NoShadowing.functionDefinition functionEnv
        (.Def params rets body)) :
    (identNames params).Nodup ∧
      (identNames rets).Nodup ∧
        (∀ name, name ∈ identNames params → name ∉ identNames rets) := by
  unfold Safe.NoShadowing.functionDefinition at hFn
  let locals := identNames params ++ identNames rets
  have hFresh :
      Safe.NoShadowing.freshIn functionEnv
        (identNames params ++ identNames rets) := by
    simpa [locals] using hFn.1
  rcases List.nodup_append.mp hFresh.1 with
    ⟨hParams, hReturns, hDisjointPairs⟩
  refine ⟨hParams, hReturns, ?_⟩
  intro name hParam hReturn
  exact hDisjointPairs name hParam name hReturn rfl

theorem contract_lookup_param_return_facts
    {program : Program} {functionName : Name}
    {params rets : List EvmYul.Identifier} {body : List AstStmt}
    (hNoShadowing : Safe.NoShadowing.program program)
    (hLookup :
      program.contract.functions.lookup functionName =
        some (.Def params rets body)) :
    (identNames params).Nodup ∧
      (identNames rets).Nodup ∧
        (∀ name, name ∈ identNames params → name ∉ identNames rets) := by
  exact
    functionDefinition_param_return_facts
      (functionDefinition_of_contract_lookup
        (program := program) (functionName := functionName)
        (fn := .Def params rets body) hNoShadowing hLookup)

end NoShadowing

