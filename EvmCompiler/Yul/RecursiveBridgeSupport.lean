    simp [bodyNext]
    simpa [List.append_nil, bodyNext] using
      OpenExternal.OpenResultResolves.bind_ok
        (next := bodyNext) hBody hAfterBody
  simpa [CompilerOpen.FunctionsOpen.Stmt.runForLoop, bodyNext] using
    OpenExternal.OpenResultResolves.bind_ok hCond hAfterCond

/--
Selected open target path for the generated `for true` continuation itself when
the generated body completes regularly or by `continue`, and the generated post
then exits by `leave` or `halt`.
-/
theorem compilerOpen_generated_runForLoop_resolves_body_regular_or_continue_post_leave_or_halt
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {lowerPost generatedBody : Functions.Block}
    {bodyFuel postFuel : Nat} {compiler : Objects.Source.State}
    {bodyOutcome postOutcome : Functions.Source.Outcome}
    {bodyTrace postTrace : OpenExternal.OpenTrace}
    (hBodyMode :
      bodyOutcome.mode = .regular ∨ bodyOutcome.mode = .cont)
    (hPostMode :
      postOutcome.mode = .leave ∨
        ∃ kind : Assembly.HaltKind, postOutcome.mode = .halt kind)
    (hBody :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody bodyFuel compiler)
        bodyTrace (.ok bodyOutcome))
    (hPost :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl) lowerPost postFuel bodyOutcome.state)
        postTrace (.ok postOutcome)) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
        (ctx.withoutLoopControl) (.lit (EvmYul.UInt256.ofNat 1))
        (ctx.withoutLoopControl) lowerPost
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        generatedBody (Nat.max bodyFuel postFuel).succ compiler)
      (bodyTrace ++ postTrace) (.ok postOutcome) := by
  let loopFuel := Nat.max bodyFuel postFuel
  have hBodyMax :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody loopFuel compiler)
        bodyTrace (.ok bodyOutcome) :=
    CompilerOpen.FunctionsOpen.Block.runScoped_resolves_mono prim program
      (by dsimp [loopFuel]; exact Nat.le_max_left _ _) hBody
  have hPostMax :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl) lowerPost loopFuel bodyOutcome.state)
        postTrace (.ok postOutcome) :=
    CompilerOpen.FunctionsOpen.Block.runScoped_resolves_mono prim program
      (by dsimp [loopFuel]; exact Nat.le_max_right _ _) hPost
  have hCond :
      OpenExternal.OpenResultResolves
        (CompilerOpen.LocalsExpr.evalCondition prim
          (.lit (EvmYul.UInt256.ofNat 1)) compiler)
        [] (.ok (compiler, true)) :=
    compilerOpen_evalCondition_lit_one_resolves
      (prim := prim) (compiler := compiler)
  let postNext : Functions.Source.Outcome →
      CompilerOpen.Result Functions.Source.Outcome :=
    fun postOutcome =>
      match postOutcome.mode with
      | .regular =>
          CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
            (ctx.withoutLoopControl) (.lit (EvmYul.UInt256.ofNat 1))
            (ctx.withoutLoopControl) lowerPost
            (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
            generatedBody loopFuel postOutcome.state
      | .brk | .cont => CompilerOpen.invalid
      | .leave | .halt _ => OpenExternal.OpenResult.ok postOutcome
  have hAfterPost :
      OpenExternal.OpenResultResolves (postNext postOutcome) []
        (.ok postOutcome) := by
    rcases postOutcome with ⟨postState, postMode⟩
    dsimp [postNext]
    rcases hPostMode with hLeave | hHalt
    · cases postMode with
      | regular => simp at hLeave
      | brk => simp at hLeave
      | cont => simp at hLeave
      | leave =>
          simp [OpenExternal.OpenResult.ok, Functions.Source.Outcome.leave,
            Locals.Source.Outcome.leave]
          exact OpenExternal.OpenResultResolves.done
      | halt kind => simp at hLeave
    · rcases hHalt with ⟨kind, hHalt⟩
      cases postMode with
      | regular => simp at hHalt
      | brk => simp at hHalt
      | cont => simp at hHalt
      | leave => simp at hHalt
      | halt kind' =>
          simp [OpenExternal.OpenResult.ok, Functions.Source.Outcome.halt,
            Locals.Source.Outcome.halt]
          exact OpenExternal.OpenResultResolves.done
  let bodyNext : Functions.Source.Outcome →
      CompilerOpen.Result Functions.Source.Outcome :=
    fun bodyOutcome =>
      match bodyOutcome.mode with
      | .brk =>
          OpenExternal.OpenResult.ok
            (Functions.Source.Outcome.regular bodyOutcome.state)
      | .regular =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.FunctionsOpen.Block.runScoped prim program
              (ctx.withoutLoopControl) lowerPost loopFuel bodyOutcome.state)
            postNext
      | .cont =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.FunctionsOpen.Block.runScoped prim program
              (ctx.withoutLoopControl) lowerPost loopFuel bodyOutcome.state)
            postNext
      | .leave | .halt _ =>
          OpenExternal.OpenResult.ok bodyOutcome
  have hAfterBody :
      OpenExternal.OpenResultResolves (bodyNext bodyOutcome) postTrace
        (.ok postOutcome) := by
    rcases bodyOutcome with ⟨bodyState, bodyMode⟩
    dsimp [bodyNext]
    rcases hBodyMode with hRegular | hContinue
    · cases bodyMode with
      | regular =>
          simpa [List.append_nil, postNext] using
            OpenExternal.OpenResultResolves.bind_ok
              (next := postNext) hPostMax hAfterPost
      | brk => simp at hRegular
      | cont => simp at hRegular
      | leave => simp at hRegular
      | halt kind => simp at hRegular
    · cases bodyMode with
      | regular => simp at hContinue
      | brk => simp at hContinue
      | cont =>
          simpa [List.append_nil, postNext] using
            OpenExternal.OpenResultResolves.bind_ok
              (next := postNext) hPostMax hAfterPost
      | leave => simp at hContinue
      | halt kind => simp at hContinue
  have hAfterCond :
      OpenExternal.OpenResultResolves
        ((fun condResult : Objects.Source.State × Bool =>
