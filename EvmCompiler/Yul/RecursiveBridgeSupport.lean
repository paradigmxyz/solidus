      hLowerEq⟩
  rcases hHead hCovers hHeadLower with
    ⟨lowerHead, hHeadEq, hCoversMid, hHeadSound⟩
  have hHeadLowerSingleton :
      Stmt.toFunctionsListFuel? lowerFuel freshState head =
        some ([lowerHead], stateHead) := by
