            ctx { ctx with scope := (identNames names).reverse ++ ctx.scope }
            compiler compilerAfterInit
            (Functions.Source.Outcome.halt kind compilerAfterCall)
            ctxAfterCall
            ⟨(identNames names).length + 1, hInitRun⟩
            ⟨preCallFuel, hPreCallRun⟩ with
        ⟨targetFuel, hTargetOpen⟩
      refine
        ⟨Functions.Source.Outcome.halt kind compilerAfterCall, targetFuel,
          ?_, hOutcomeRel⟩
      simp [Functions.Source.Block.runScoped, hTargetOpen,
        Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]

