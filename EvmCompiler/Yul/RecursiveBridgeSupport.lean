      Locals.Source.Expr.evalOne prim lowerExpr compilerAfterPre =
        .ok (compilerAfterExpr, value) ∧
      SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfterExpr := by
  rcases hExpr hInitial hEval with
    ⟨compilerAfterPre, compilerAfterExpr, ctxAfterPre, preFuel,
      hPreRun, hExprRun, hRelAfter⟩
  exact
    ⟨compilerAfterPre, compilerAfterExpr, ctxAfterPre, preFuel,
      hPreRun, hExprRun,
      SourceStateExactRel.ofRelDomain hRelAfter hDomainAfter⟩

/--
Exact-domain lift for single-value expression preludes, deriving the post-domain
fact from an expression-domain preservation theorem.
-/
theorem ExprEvalPreludeSound.run_exact_of_eval_domain
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceExpr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {lowerExpr : Locals.Expr 1}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State} {value : Word}
    (hExpr :
      ExprEvalPreludeSound cfg layout prim program ctx sourceFuel sourceExpr
        codeOverride pre lowerExpr)
    (hEvalDomain :
      StoreDomainExact layout store →
      EvmYul.Yul.eval sourceFuel sourceExpr codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, value) →
      StoreDomainExact layout storeAfter)
    (hDomain : StoreDomainExact layout store)
    (hInitial : SourceStateRel cfg layout (.Ok shared store) compiler)
    (hEval :
      EvmYul.Yul.eval sourceFuel sourceExpr codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, value)) :
    ∃ compilerAfterPre : Objects.Source.State,
    ∃ compilerAfterExpr : Objects.Source.State,
    ∃ ctxAfterPre : Functions.Source.Ctx,
    ∃ preFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx preFuel
          { stmts := pre } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre,
          ctxAfterPre) ∧
      Locals.Source.Expr.evalOne prim lowerExpr compilerAfterPre =
        .ok (compilerAfterExpr, value) ∧
      SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfterExpr := by
  exact
    hExpr.run_exact_of_domain hInitial hEval
      (hEvalDomain hDomain hEval)

/--
Resource-aware single-value expression bridge for regular `Ok` source results.

User-function calls can mention the imported Yul `State.OutOfFuel` success
state at the raw interpreter boundary.  The final theorem already exposes a
no-`State.OutOfFuel` resource assumption, so user-call expression success is
proved at this `Ok` boundary and lifted only where that resource assumption is
available.
-/
def ExprEvalPreludeSoundOk
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt)
    (lower : Locals.Expr 1) : Prop :=
  ∀ {source compiler sharedAfter storeAfter value},
    SourceStateRel cfg layout source compiler →
    EvmYul.Yul.eval sourceFuel expr codeOverride source =
      .ok (.Ok sharedAfter storeAfter, value) →
    ∃ compilerAfterPre : Objects.Source.State,
    ∃ compilerAfter : Objects.Source.State,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
      Locals.Source.Expr.evalOne prim lower compilerAfterPre =
        .ok (compilerAfter, value) ∧
      SourceStateRel cfg layout (.Ok sharedAfter storeAfter) compilerAfter

theorem ExprEvalPreludeSoundOk.run_exact_of_domain
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
