                  cases hLowerEq
                  simpa [List.append_assoc] using
                    sourceArgListPreludeRegularAt_cons_of_tail_head_bounded
                      (cfg := cfg) (layout := layout) (prim := prim)
                      (program := program) (ctx := ctx)
                      (sourceFuel := sourceFuel) (head := head)
                      (tail := tail) (codeOverride := some contract)
                      (preTail := preTail) (preHead := preHead)
                      (lowerTail := lowerTail) (lowerHead := lowerHead)
