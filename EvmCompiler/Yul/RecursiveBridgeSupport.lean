/--
Internal adapter from hidden stack-order prelude evidence back to the legacy
`ExprArgStackPreludeSound` shape.
-/
theorem exprArgStackPreludeSound_of_sourceArgStackPreludeRegular
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {results : Nat}
    {lower : Locals.ExprSeq results}
    (hBridge :
      SourceArgStackPreludeRegular cfg layout prim program ctx sourceFuel args
        codeOverride pre lower) :
    ExprArgStackPreludeSound cfg layout prim program ctx sourceFuel args
      codeOverride pre lower := by
  intro source compiler sourceAfter values hInitial hEval
  cases hRaw :
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source with
  | error err =>
      simp [EvmYul.Yul.reverse', hRaw] at hEval
  | ok raw =>
      rcases raw with ⟨sourceAfterRaw, rawValues⟩
      simp [EvmYul.Yul.reverse', hRaw] at hEval
      rcases hEval with ⟨hSourceAfter, hValues⟩
      subst sourceAfterRaw
      subst values
      have hForBridge :
          EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
            .ok (sourceAfter, rawValues.reverse.reverse) := by
        simpa using hRaw
      rcases hBridge.2 hInitial hForBridge with
        ⟨compilerAfterPre, compilerAfterArgs, ctxAfter, targetFuel,
          hPreRun, hArgsRun, hRel⟩
      refine
        ⟨compilerAfterPre, compilerAfterArgs, ctxAfter, targetFuel,
          hPreRun, ?_, hRel⟩
      simpa using hArgsRun

/--
Primitive-call expression bridge for the hidden stack-order argument prelude.

This is the ordinary-expression counterpart of the terminal-call adapters below:
the generated argument prelude is treated as compiler-only source-tower code,
while the imported/source relation remains at the original Yul layout.
-/
