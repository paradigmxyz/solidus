theorem yul_primCall_mload_ok_single
    {fuel : Nat} {source sourceAfter : State} {args values : List Word}
    (hCall :
      EvmYul.Yul.primCall fuel.succ source (.StackMemFlow .MLOAD) args =
        .ok (sourceAfter, values)) :
    ∃ value, values = [value] := by
  cases args with
  | nil =>
      have hBad :
          EvmYul.Yul.primCall fuel.succ source (.StackMemFlow .MLOAD) [] =
            .error EvmYul.Yul.Exception.InvalidArguments := by
        simp [EvmYul.Yul.primCall]
        rfl
      rw [hBad] at hCall
      simp at hCall
  | cons slot rest =>
      cases rest with
      | nil =>
          have hOk :
              EvmYul.Yul.primCall fuel.succ source (.StackMemFlow .MLOAD)
                  [slot] =
                .ok
                  (EvmYul.Yul.State.setMachineState
                      (source.toSharedState.mload slot).2 source,
                    [(source.toSharedState.mload slot).1]) := by
            simp [EvmYul.Yul.primCall]
            rfl
          rw [hOk] at hCall
          cases hCall
          exact ⟨(source.toSharedState.mload slot).1, rfl⟩
      | cons extra tail =>
          have hBad :
              EvmYul.Yul.primCall fuel.succ source (.StackMemFlow .MLOAD)
                  (slot :: extra :: tail) =
                .error EvmYul.Yul.Exception.InvalidArguments := by
            simp [EvmYul.Yul.primCall]
            rfl
          rw [hBad] at hCall
          simp at hCall

theorem safeBasicOneOutputPrimCall_ok_single
    {sourceFuel : Nat} {primOp : EvmYul.Operation .Yul}
    {op : Structured.BasicOp}
    {source sourceAfter : State} {args values : List Word}
    (hSafe : Safe.primitive primOp)
    (hBasic : Prim.toBasicOp? primOp = some op)
    (hOutputs : Expressions.Structured.BasicOp.outputs op = 1)
    (hCall :
      EvmYul.Yul.primCall sourceFuel source primOp args =
        .ok (sourceAfter, values)) :
    ∃ value, values = [value] := by
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.primCall] at hCall
  | succ fuel =>
      cases primOp with
      | StopArith stopArith =>
          cases stopArith with
          | STOP =>
              simp [Prim.toBasicOp?] at hBasic
          | ADD | MUL | SUB | DIV | SDIV | MOD | SMOD | ADDMOD | MULMOD
          | EXP | SIGNEXTEND =>
              exact
                pureAliasPrim_primCall_ok_single
                  (by simp [Expr.pureAliasPrim?]) hCall
      | CompBit compBit =>
          cases compBit <;>
            exact
              pureAliasPrim_primCall_ok_single
                (by simp [Expr.pureAliasPrim?]) hCall
      | Keccak keccak =>
          cases keccak
          have hExec :
              yulPrimListResult
                (EvmYul.Yul.binaryMachineStateOp'
                  EvmYul.MachineState.keccak256 source args) =
                .ok (sourceAfter, values) := by
            simp [EvmYul.Yul.primCall] at hCall
            unfold EvmYul.step at hCall
            simpa [yulPrimListResult] using hCall
          exact wrapped_yul_binaryMachineStateOp'_ok_single hExec
      | Env env =>
          cases env with
          | ADDRESS =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.codeOwner)
                      source args) = .ok (sourceAfter, values) := by
                simp [EvmYul.Yul.primCall] at hCall
