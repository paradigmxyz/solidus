  have hArgsNil : args = [] := directCallArgsSafe_eq_true_iff_nil.mp hDirect
  subst args
  subst lowerArgs
  cases sourceFuel with
  | zero =>
      omega
  | succ sourceFuel =>
      cases targetFuel with
      | zero =>
          omega
      | succ targetFuel =>
          intro source compiler hInitial
          simpa using
            sourceArgTerminalRawPreludeOpenSoundAtExactTarget_nil
