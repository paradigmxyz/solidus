    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ .Continue codeOverride state) := by
  rw [Imported.exec_continue_succ]
  exact StateCheckpointAllowed.setContinue hContinue hState

theorem SourceResultCheckpointAllowed.exec_leave_succ
    {canBreak canContinue canLeave : Bool}
    (hLeave : canLeave = true)
    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ .Leave codeOverride state) := by
  rw [Imported.exec_leave_succ]
  exact StateCheckpointAllowed.setLeave hLeave hState

theorem SourceResultCheckpointAllowed.execSeq_nil_succ
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.execSeq fuel.succ [] codeOverride state) := by
  rw [Imported.execSeq_nil_succ]
  exact hState

theorem SourceResultCheckpointAllowed.execSeq_cons_succ
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {stmt : AstStmt} {rest : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hHead :
      SourceResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.exec fuel stmt codeOverride state))
    (hTail :
      ∀ {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel stmt codeOverride state =
          .ok (.Ok shared store) →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.execSeq fuel rest codeOverride (.Ok shared store))) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state) := by
  cases hExec : EvmYul.Yul.exec fuel stmt codeOverride state with
  | error err =>
      simp [EvmYul.Yul.execSeq, hExec, SourceResultCheckpointAllowed]
  | ok headState =>
      cases headState with
      | Ok shared store =>
          simpa [EvmYul.Yul.execSeq, hExec] using
            hTail (shared := shared) (store := store) hExec
      | OutOfFuel =>
          simp [EvmYul.Yul.execSeq, hExec, SourceResultCheckpointAllowed,
            StateCheckpointAllowed]
      | Checkpoint jump =>
          simpa [EvmYul.Yul.execSeq, hExec] using hHead

theorem SourceResultCheckpointAllowed.exec_block_succ_of_execSeq
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {stmts : List AstStmt} {codeOverride : Option AstContract}
    {state : State}
    (hSeq :
      SourceResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.execSeq fuel stmts codeOverride state)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.Block stmts) codeOverride state) := by
  cases hExecSeq : EvmYul.Yul.execSeq fuel stmts codeOverride state with
  | error err =>
      simp [EvmYul.Yul.exec, hExecSeq, SourceResultCheckpointAllowed]
  | ok stateAfter =>
      have hStateAfter :
          StateCheckpointAllowed canBreak canContinue canLeave stateAfter := by
        simpa [SourceResultCheckpointAllowed, hExecSeq] using hSeq
      simp [EvmYul.Yul.exec, hExecSeq, SourceResultCheckpointAllowed]
      exact StateCheckpointAllowed.restrictStoreTo
        (scope := EvmYul.Yul.State.store state) hStateAfter

theorem SourceResultCheckpointAllowed.exec_let_none_succ_of_state
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {names : List EvmYul.Identifier}
    {codeOverride : Option AstContract} {state : State}
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.Let names none) codeOverride state) := by
  rw [Imported.exec_let_none_succ]
  cases hCheck : EvmYul.Yul.checkDeclaration state names with
  | error err =>
      simp [hCheck, SourceResultCheckpointAllowed]
  | ok unit =>
      simpa [hCheck, SourceResultCheckpointAllowed]
        using StateCheckpointAllowed.zeroFill
          (names := names) hState

theorem SourceResultCheckpointAllowed.exec_let_some_succ_of_evalValues
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {names : List EvmYul.Identifier} {value : AstExpr}
    {codeOverride : Option AstContract} {state : State}
    (hEvalValues :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.evalValues fuel value codeOverride state)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.Let names (some value)) codeOverride
        state) := by
  simp [EvmYul.Yul.exec]
  cases hCheck : EvmYul.Yul.checkDeclaration state names with
  | error err =>
      simp [hCheck, SourceResultCheckpointAllowed]
  | ok unit =>
      simpa [hCheck] using
        SourceResultCheckpointAllowed.multifill'
          (names := names) hEvalValues

theorem SourceResultCheckpointAllowed.exec_assign_succ_of_evalValues
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {names : List EvmYul.Identifier} {value : AstExpr}
    {codeOverride : Option AstContract} {state : State}
    (hEvalValues :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.evalValues fuel value codeOverride state)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.Assign names value) codeOverride
        state) := by
  rw [Imported.exec_assign_succ]
  cases hCheck : EvmYul.Yul.checkAssignment state names with
  | error err =>
      simp [hCheck, SourceResultCheckpointAllowed]
  | ok unit =>
      simpa [hCheck] using
        SourceResultCheckpointAllowed.multifill'
          (names := names) hEvalValues

theorem SourceResultCheckpointAllowed.no_checkpoint_of_top
    {sourceResult : Except Exception State}
    (hAllowed :
      SourceResultCheckpointAllowed false false false sourceResult) :
    SourceResultNoCheckpoint sourceResult := by
  cases sourceResult with
  | error err =>
      simp [SourceResultNoCheckpoint]
  | ok state =>
      cases state with
      | Ok shared store =>
          simp [SourceResultNoCheckpoint]
      | OutOfFuel =>
          simp [SourceResultNoCheckpoint]
      | Checkpoint jump =>
          cases jump <;>
            simp [SourceResultCheckpointAllowed, StateCheckpointAllowed,
              SourceResultNoCheckpoint] at hAllowed

namespace ControlFlow

/-
Syntactic control-flow scoping for imported Yul statements.

The three boolean parameters say whether `break`, `continue`, and `leave` are
currently handled. Top-level object code should run with all three disabled;
loop bodies enable `break`/`continue`; function bodies enable `leave`.
-/
mutual
  def ScopedStmt : Bool → Bool → Bool → AstStmt → Prop
    | canBreak, canContinue, canLeave, .Block body =>
        ScopedStmts canBreak canContinue canLeave body
    | _canBreak, _canContinue, _canLeave, .Let _names none => True
    | _canBreak, _canContinue, _canLeave, .Let _names (some _value) => True
    | _canBreak, _canContinue, _canLeave, .Assign _names _value => True
    | _canBreak, _canContinue, _canLeave, .ExprStmtCall _value => True
    | canBreak, canContinue, canLeave, .Switch _scrutinee cases defaultBody =>
        ScopedCases canBreak canContinue canLeave cases ∧
          ScopedStmts canBreak canContinue canLeave defaultBody
    | _canBreak, _canContinue, canLeave, .For _cond post body =>
        ScopedStmts false false canLeave post ∧
          ScopedStmts true true canLeave body
    | canBreak, canContinue, canLeave, .If _cond body =>
        ScopedStmts canBreak canContinue canLeave body
    | canBreak, _canContinue, _canLeave, .Break => canBreak = true
    | _canBreak, canContinue, _canLeave, .Continue => canContinue = true
    | _canBreak, _canContinue, canLeave, .Leave => canLeave = true

  def ScopedStmts : Bool → Bool → Bool → List AstStmt → Prop
    | _canBreak, _canContinue, _canLeave, [] => True
    | canBreak, canContinue, canLeave, head :: tail =>
        ScopedStmt canBreak canContinue canLeave head ∧
          ScopedStmts canBreak canContinue canLeave tail

  def ScopedCases : Bool → Bool → Bool → List (Word × List AstStmt) → Prop
    | _canBreak, _canContinue, _canLeave, [] => True
    | canBreak, canContinue, canLeave, (_value, body) :: rest =>
        ScopedStmts canBreak canContinue canLeave body ∧
          ScopedCases canBreak canContinue canLeave rest
end

def FunctionScoped : AstFunctionDefinition → Prop
  | .Def _params _returns body => ScopedStmts false false true body

inductive FunctionListScoped :
    List (Name × AstFunctionDefinition) → Prop where
  | nil : FunctionListScoped []
  | cons {name : Name} {fn : AstFunctionDefinition}
      {rest : List (Name × AstFunctionDefinition)}
      (hFn : FunctionScoped fn)
      (hRest : FunctionListScoped rest) :
      FunctionListScoped ((name, fn) :: rest)

noncomputable def ContractScoped (contract : AstContract) : Prop :=
  ScopedStmt false false false contract.dispatcher ∧
    FunctionListScoped (Contract.functionEntries contract)

noncomputable def ProgramScoped (program : Program) : Prop :=
  ContractScoped program.contract

mutual
  def ScopedStmt? : Bool → Bool → Bool → AstStmt → Bool
    | canBreak, canContinue, canLeave, .Block body =>
        ScopedStmts? canBreak canContinue canLeave body
    | _canBreak, _canContinue, _canLeave, .Let _names none => true
    | _canBreak, _canContinue, _canLeave, .Let _names (some _value) => true
    | _canBreak, _canContinue, _canLeave, .Assign _names _value => true
    | _canBreak, _canContinue, _canLeave, .ExprStmtCall _value => true
    | canBreak, canContinue, canLeave, .Switch _scrutinee cases defaultBody =>
        ScopedCases? canBreak canContinue canLeave cases &&
          ScopedStmts? canBreak canContinue canLeave defaultBody
    | _canBreak, _canContinue, canLeave, .For _cond post body =>
        ScopedStmts? false false canLeave post &&
          ScopedStmts? true true canLeave body
    | canBreak, canContinue, canLeave, .If _cond body =>
        ScopedStmts? canBreak canContinue canLeave body
    | canBreak, _canContinue, _canLeave, .Break => canBreak
    | _canBreak, canContinue, _canLeave, .Continue => canContinue
    | _canBreak, _canContinue, canLeave, .Leave => canLeave

  def ScopedStmts? : Bool → Bool → Bool → List AstStmt → Bool
    | _canBreak, _canContinue, _canLeave, [] => true
    | canBreak, canContinue, canLeave, head :: tail =>
        ScopedStmt? canBreak canContinue canLeave head &&
          ScopedStmts? canBreak canContinue canLeave tail

  def ScopedCases? : Bool → Bool → Bool →
      List (Word × List AstStmt) → Bool
    | _canBreak, _canContinue, _canLeave, [] => true
    | canBreak, canContinue, canLeave, (_value, body) :: rest =>
        ScopedStmts? canBreak canContinue canLeave body &&
          ScopedCases? canBreak canContinue canLeave rest
end

mutual
  theorem ScopedStmt.of_check
      {canBreak canContinue canLeave : Bool} {stmt : AstStmt}
      (hCheck :
        ScopedStmt? canBreak canContinue canLeave stmt = true) :
      ScopedStmt canBreak canContinue canLeave stmt := by
    cases stmt with
    | Block body =>
        exact ScopedStmts.of_check hCheck
    | Let names value? =>
        cases value? <;> trivial
    | Assign names value =>
        trivial
    | ExprStmtCall value =>
        trivial
    | Switch scrutinee cases defaultBody =>
        have hAnd :
            ScopedCases? canBreak canContinue canLeave cases = true ∧
              ScopedStmts? canBreak canContinue canLeave defaultBody = true :=
          by simpa [ScopedStmt?] using hCheck
        exact
          ⟨ScopedCases.of_check hAnd.1,
            ScopedStmts.of_check hAnd.2⟩
    | For cond post body =>
        have hAnd :
            ScopedStmts? false false canLeave post = true ∧
              ScopedStmts? true true canLeave body = true :=
          by simpa [ScopedStmt?] using hCheck
        exact
          ⟨ScopedStmts.of_check hAnd.1,
            ScopedStmts.of_check hAnd.2⟩
    | If cond body =>
        exact ScopedStmts.of_check hCheck
    | Continue =>
        simpa [ScopedStmt?, ScopedStmt] using hCheck
    | Break =>
        simpa [ScopedStmt?, ScopedStmt] using hCheck
    | Leave =>
        simpa [ScopedStmt?, ScopedStmt] using hCheck

  theorem ScopedStmts.of_check
      {canBreak canContinue canLeave : Bool} {stmts : List AstStmt}
      (hCheck :
        ScopedStmts? canBreak canContinue canLeave stmts = true) :
      ScopedStmts canBreak canContinue canLeave stmts := by
    cases stmts with
    | nil =>
        trivial
    | cons head tail =>
        have hAnd :
            ScopedStmt? canBreak canContinue canLeave head = true ∧
              ScopedStmts? canBreak canContinue canLeave tail = true :=
          by simpa [ScopedStmts?] using hCheck
        exact
          ⟨ScopedStmt.of_check hAnd.1,
            ScopedStmts.of_check hAnd.2⟩

  theorem ScopedCases.of_check
      {canBreak canContinue canLeave : Bool}
      {cases : List (Word × List AstStmt)}
      (hCheck :
        ScopedCases? canBreak canContinue canLeave cases = true) :
      ScopedCases canBreak canContinue canLeave cases := by
    cases cases with
    | nil =>
        trivial
    | cons head rest =>
        rcases head with ⟨_value, body⟩
        have hAnd :
            ScopedStmts? canBreak canContinue canLeave body = true ∧
              ScopedCases? canBreak canContinue canLeave rest = true :=
          by simpa [ScopedCases?] using hCheck
        exact
          ⟨ScopedStmts.of_check hAnd.1,
            ScopedCases.of_check hAnd.2⟩
end

def FunctionScoped? : AstFunctionDefinition → Bool
  | .Def _params _returns body => ScopedStmts? false false true body

def FunctionListScoped? :
    List (Name × AstFunctionDefinition) → Bool
  | [] => true
  | (_name, fn) :: rest =>
      FunctionScoped? fn && FunctionListScoped? rest

noncomputable def ContractScoped? (contract : AstContract) : Bool :=
  ScopedStmt? false false false contract.dispatcher &&
    FunctionListScoped? (Contract.functionEntries contract)

noncomputable def ProgramScoped? (program : Program) : Bool :=
  ContractScoped? program.contract

theorem FunctionScoped.of_check {fn : AstFunctionDefinition}
    (hCheck : FunctionScoped? fn = true) :
    FunctionScoped fn := by
  cases fn with
  | Def params returns body =>
      exact ScopedStmts.of_check hCheck

theorem FunctionListScoped.of_check
    {entries : List (Name × AstFunctionDefinition)}
    (hCheck : FunctionListScoped? entries = true) :
    FunctionListScoped entries := by
  induction entries with
  | nil =>
      exact FunctionListScoped.nil
  | cons entry rest ih =>
      rcases entry with ⟨name, fn⟩
      have hAnd :
          FunctionScoped? fn = true ∧ FunctionListScoped? rest = true :=
        by simpa [FunctionListScoped?] using hCheck
      exact
        FunctionListScoped.cons
          (FunctionScoped.of_check hAnd.1) (ih hAnd.2)

theorem ContractScoped.of_check {contract : AstContract}
    (hCheck : ContractScoped? contract = true) :
    ContractScoped contract := by
  have hAnd :
      ScopedStmt? false false false contract.dispatcher = true ∧
        FunctionListScoped? (Contract.functionEntries contract) = true :=
    by simpa [ContractScoped?] using hCheck
  exact
    ⟨ScopedStmt.of_check hAnd.1,
      FunctionListScoped.of_check hAnd.2⟩

theorem ProgramScoped.of_check {program : Program}
    (hCheck : ProgramScoped? program = true) :
    ProgramScoped program :=
  ContractScoped.of_check hCheck

theorem scoped_block {canBreak canContinue canLeave body}
    (hBody : ScopedStmts canBreak canContinue canLeave body) :
    ScopedStmt canBreak canContinue canLeave (.Block body) :=
  hBody

theorem scoped_switch {canBreak canContinue canLeave scrutinee cases defaultBody}
    (hCases : ScopedCases canBreak canContinue canLeave cases)
    (hDefault : ScopedStmts canBreak canContinue canLeave defaultBody) :
    ScopedStmt canBreak canContinue canLeave
      (.Switch scrutinee cases defaultBody) :=
  And.intro hCases hDefault

theorem scopedCases_selectSwitchCase
    {canBreak canContinue canLeave : Bool}
    {value : Word} {cases : List (Word × List AstStmt)}
    {defaultBody : List AstStmt}
    (hCases : ScopedCases canBreak canContinue canLeave cases)
    (hDefault : ScopedStmts canBreak canContinue canLeave defaultBody) :
    ScopedStmts canBreak canContinue canLeave
      (EvmYul.Yul.selectSwitchCase value defaultBody cases) := by
  induction cases with
  | nil =>
      simpa [EvmYul.Yul.selectSwitchCase] using hDefault
  | cons head rest ih =>
      cases head with
      | mk caseValue body =>
          rcases hCases with ⟨hBody, hRest⟩
          by_cases hEq : caseValue = value
          · simp [EvmYul.Yul.selectSwitchCase, hEq, hBody]
          · simpa [EvmYul.Yul.selectSwitchCase, hEq] using ih hRest

theorem scoped_for {canBreak canContinue canLeave cond post body}
    (hPost : ScopedStmts false false canLeave post)
    (hBody : ScopedStmts true true canLeave body) :
    ScopedStmt canBreak canContinue canLeave (.For cond post body) :=
  And.intro hPost hBody

theorem scoped_if {canBreak canContinue canLeave cond body}
    (hBody : ScopedStmts canBreak canContinue canLeave body) :
    ScopedStmt canBreak canContinue canLeave (.If cond body) :=
  hBody

theorem contract_scoped_dispatcher {contract : AstContract}
    (hScoped : ContractScoped contract) :
    ScopedStmt false false false contract.dispatcher :=
  hScoped.1

theorem contract_scoped_functions {contract : AstContract}
    (hScoped : ContractScoped contract) :
    FunctionListScoped (Contract.functionEntries contract) :=
  hScoped.2

theorem program_scoped_dispatcher {program : Program}
    (hScoped : ProgramScoped program) :
    ScopedStmt false false false program.contract.dispatcher :=
  contract_scoped_dispatcher hScoped

theorem program_scoped_functions {program : Program}
    (hScoped : ProgramScoped program) :
    FunctionListScoped (Contract.functionEntries program.contract) :=
  contract_scoped_functions hScoped

theorem functionListScoped_functionScoped_of_find?
    {entries : List (Name × AstFunctionDefinition)}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hEntries : FunctionListScoped entries)
    (hFind : FunctionEntryList.find? functionName entries = some fn) :
    FunctionScoped fn := by
  induction hEntries with
  | nil =>
      simp [FunctionEntryList.find?] at hFind
  | cons hFn hRest ih =>
      rename_i headName headFn rest
      by_cases hEq : headName = functionName
      · have hHeadFn : headFn = fn := by
          simpa [FunctionEntryList.find?, hEq] using hFind
        simpa [hHeadFn] using hFn
      · simp [FunctionEntryList.find?, hEq] at hFind
        exact ih hFind

theorem functionScoped_of_contract_lookup
    {program : Program} {functionName : Name}
    {fn : AstFunctionDefinition}
    (hScoped : ProgramScoped program)
    (hLookup : program.contract.functions.lookup functionName = some fn) :
    FunctionScoped fn := by
  have hFind :
      FunctionEntryList.find? functionName
          (Contract.functionEntries program.contract) =
        some fn :=
    FunctionEntryList.find?_contract_functionEntries_of_lookup
      program.contract hLookup
  exact
    functionListScoped_functionScoped_of_find?
      (program_scoped_functions hScoped) hFind

theorem function_body_scoped_of_contract_lookup
    {program : Program} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    (hScoped : ProgramScoped program)
    (hLookup :
      program.contract.functions.lookup functionName =
        some (.Def params returns body)) :
    ScopedStmts false false true body := by
  have hFn :
      FunctionScoped (.Def params returns body) :=
    functionScoped_of_contract_lookup hScoped hLookup
  simpa [FunctionScoped] using hFn

theorem not_scoped_top_break :
    ¬ ScopedStmt false false false (.Break : AstStmt) := by
  intro h
  simp [ScopedStmt] at h

theorem not_scoped_top_continue :
    ¬ ScopedStmt false false false (.Continue : AstStmt) := by
  intro h
  simp [ScopedStmt] at h

theorem not_scoped_top_leave :
    ¬ ScopedStmt false false false (.Leave : AstStmt) := by
  intro h
  simp [ScopedStmt] at h

end ControlFlow

theorem SourceResultCheckpointAllowed.exec_break_succ_of_scoped
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hScoped : ControlFlow.ScopedStmt canBreak canContinue canLeave .Break)
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ .Break codeOverride state) := by
  have hBreak : canBreak = true := by
    simpa [ControlFlow.ScopedStmt] using hScoped
  exact SourceResultCheckpointAllowed.exec_break_succ hBreak hState

theorem SourceResultCheckpointAllowed.exec_continue_succ_of_scoped
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hScoped :
      ControlFlow.ScopedStmt canBreak canContinue canLeave .Continue)
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ .Continue codeOverride state) := by
  have hContinue : canContinue = true := by
    simpa [ControlFlow.ScopedStmt] using hScoped
  exact SourceResultCheckpointAllowed.exec_continue_succ hContinue hState

theorem SourceResultCheckpointAllowed.exec_leave_succ_of_scoped
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hScoped : ControlFlow.ScopedStmt canBreak canContinue canLeave .Leave)
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ .Leave codeOverride state) := by
  have hLeave : canLeave = true := by
    simpa [ControlFlow.ScopedStmt] using hScoped
  exact SourceResultCheckpointAllowed.exec_leave_succ hLeave hState

theorem SourcePairResultCheckpointAllowed.eval_of_evalValues
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {expr : AstExpr} {codeOverride : Option AstContract}
    {state : State}
    (hValues :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.evalValues fuel expr codeOverride state)) :
    SourcePairResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.eval fuel expr codeOverride state) := by
  simpa [EvmYul.Yul.eval] using
    SourcePairResultCheckpointAllowed.head' hValues

theorem SourceResultCheckpointAllowed.exec_if_succ_of_eval_and_body
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {body : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hEval :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel cond codeOverride state))
    (hBody :
      ∀ {stateAfter : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride state =
          .ok (stateAfter, value) →
        value ≠ ⟨0⟩ →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            stateAfter)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.If cond body) codeOverride state) := by
  rw [Imported.exec_if_succ]
  cases hEvalResult : EvmYul.Yul.eval fuel cond codeOverride state with
  | error err =>
      simp [hEvalResult, SourceResultCheckpointAllowed]
  | ok pair =>
      cases pair with
      | mk stateAfter value =>
          by_cases hNonzero : value ≠ ⟨0⟩
          · simpa [hEvalResult, hNonzero] using
              hBody (stateAfter := stateAfter) (value := value)
                hEvalResult hNonzero
          · have hAllowedState :
                StateCheckpointAllowed canBreak canContinue canLeave
                  stateAfter := by
              simpa [SourcePairResultCheckpointAllowed, hEvalResult]
                using hEval
            simpa [hEvalResult, hNonzero, SourceResultCheckpointAllowed]
              using hAllowedState

theorem SourceResultCheckpointAllowed.exec_if_succ_of_scoped_body
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {body : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hScoped : ControlFlow.ScopedStmt canBreak canContinue canLeave
      (.If cond body))
    (hEval :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel cond codeOverride state))
    (hBody :
      ∀ {stateAfter : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride state =
          .ok (stateAfter, value) →
        value ≠ ⟨0⟩ →
        ControlFlow.ScopedStmts canBreak canContinue canLeave body →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            stateAfter)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.If cond body) codeOverride state) := by
  exact
    SourceResultCheckpointAllowed.exec_if_succ_of_eval_and_body
      (canBreak := canBreak) (canContinue := canContinue)
      (canLeave := canLeave) (fuel := fuel) (cond := cond)
      (body := body) (codeOverride := codeOverride) (state := state)
      hEval
      (fun hEvalOk hNonzero => hBody hEvalOk hNonzero hScoped)

theorem SourceResultCheckpointAllowed.exec_switch_succ_of_eval_and_case
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {cases : List (Word × List AstStmt)}
    {defaultBody : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hEval :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel cond codeOverride state))
    (hCase :
      ∀ {stateAfter : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride state =
          .ok (stateAfter, value) →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.exec fuel
            (.Block (EvmYul.Yul.selectSwitchCase value defaultBody cases))
            codeOverride stateAfter)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.Switch cond cases defaultBody)
        codeOverride state) := by
  rw [Imported.exec_switch_succ]
  cases hEvalResult : EvmYul.Yul.eval fuel cond codeOverride state with
  | error err =>
      simp [hEvalResult, SourceResultCheckpointAllowed]
  | ok pair =>
      cases pair with
      | mk stateAfter value =>
          simpa [hEvalResult] using
            hCase (stateAfter := stateAfter) (value := value) hEvalResult

theorem SourceResultCheckpointAllowed.exec_switch_succ_of_scoped_case
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {cases : List (Word × List AstStmt)}
    {defaultBody : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hScoped : ControlFlow.ScopedStmt canBreak canContinue canLeave
      (.Switch cond cases defaultBody))
    (hEval :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel cond codeOverride state))
    (hBlock :
      ∀ {stateAfter : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride state =
          .ok (stateAfter, value) →
        ControlFlow.ScopedStmts canBreak canContinue canLeave
          (EvmYul.Yul.selectSwitchCase value defaultBody cases) →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.exec fuel
            (.Block (EvmYul.Yul.selectSwitchCase value defaultBody cases))
            codeOverride stateAfter)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec fuel.succ (.Switch cond cases defaultBody)
        codeOverride state) := by
  rcases hScoped with ⟨hCases, hDefault⟩
  exact
    SourceResultCheckpointAllowed.exec_switch_succ_of_eval_and_case
      (canBreak := canBreak) (canContinue := canContinue)
      (canLeave := canLeave) (fuel := fuel) (cond := cond)
      (cases := cases) (defaultBody := defaultBody)
      (codeOverride := codeOverride) (state := state)
      hEval
      (fun {stateAfter} {value} hEvalOk =>
        hBlock hEvalOk
          (ControlFlow.scopedCases_selectSwitchCase
            (value := value) hCases hDefault))

theorem SourceResultCheckpointAllowed.loop_zero
    {canBreak canContinue canLeave : Bool}
    {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {state : State} :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.loop 0 cond post body codeOverride state) := by
  rw [Imported.loop_zero]
  simp [SourceResultCheckpointAllowed]

theorem SourceResultCheckpointAllowed.loop_one
    {canBreak canContinue canLeave : Bool}
    {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {state : State} :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.loop 1 cond post body codeOverride state) := by
