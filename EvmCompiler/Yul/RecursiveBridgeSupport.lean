theorem yulOpen_toOpenResult_execSeq_exprStmt_prim_eq_bind_evalValues
    {fuel : Nat} {prim : EvmYul.Operation .Yul}
    {args : List AstExpr} {rest : List AstStmt}
    {codeOverride : Option AstContract} {state : State} :
    OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.execSeq fuel.succ.succ
          (.ExprStmtCall (.Call (.inl prim) args) :: rest) codeOverride
          state) =
      OpenExternal.OpenResult.bind
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel.succ
            (.Call (.inl prim) args) codeOverride state))
        (fun result =>
          let state' := EvmYul.Yul.State.multifill [] result.2 result.1
          match state' with
          | .Ok _ _ =>
              OpenExternal.YulOpenResult.toOpenResult
                (OpenExternal.YulOpen.execSeq fuel.succ rest codeOverride
                  state')
          | .OutOfFuel => .done (.ok state')
          | .Checkpoint _ => .done (.ok state')) := by
  rw [yulOpen_toOpenResult_execSeq_cons_succ]
  simp only [OpenExternal.YulOpen.exec]
  simp only [OpenExternal.YulOpen.execPrimCall,
    OpenExternal.YulOpen.evalValues, OpenExternal.YulOpenResult.toOpenResult_bind]
  rw [openResult_bind_assoc_sourceBridge]
  conv_rhs =>
    rw [openResult_bind_assoc_sourceBridge]
  apply OpenExternal.OpenResult.bind_congr_next
  intro result
  rcases result with ⟨sourceAfterArgs, values⟩
  cases hCall :
      OpenExternal.CallKind.yulPrimitiveEvalValuesOpenCall?
        sourceAfterArgs prim values with
  | none =>
      cases hCreate :
          OpenExternal.CreateKind.yulPrimitiveEvalValuesOpenCreate?
            sourceAfterArgs prim values with
      | none =>
          cases hKind :
              OpenExternal.CreateKind.ofYulOperation? prim with
          | none =>
              simp [hCall, hCreate, hKind, EvmYul.Yul.multifill',
                EvmYul.Yul.State.multifill]
              cases hPrim :
                  EvmYul.Yul.primCall fuel sourceAfterArgs prim values with
              | error err =>
                  simp [hPrim]
              | ok pair =>
                  rcases pair with ⟨stateAfterPrim, primValues⟩
                  cases stateAfterPrim <;> simp
          | some kind =>
              simp [hCall, hCreate, hKind, EvmYul.Yul.multifill',
                EvmYul.Yul.State.multifill]
              change
                OpenExternal.OpenResult.done
                    (Except.error EvmYul.Yul.Exception.InvalidArguments) =
                  OpenExternal.OpenResult.done
                    (Except.error EvmYul.Yul.Exception.InvalidArguments)
              rfl
      | some create =>
          simp [hCall, hCreate, OpenExternal.YulOpenResult.toOpenResult_bind,
            openResult_bind_assoc_sourceBridge, EvmYul.Yul.multifill',
            EvmYul.Yul.State.multifill]
          rfl
  | some call =>
      simp [hCall, OpenExternal.YulOpenResult.toOpenResult_bind,
        openResult_bind_assoc_sourceBridge]
      rfl

