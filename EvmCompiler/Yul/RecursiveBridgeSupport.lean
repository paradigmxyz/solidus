theorem yulPrimitiveEvalValuesOpenCreate?_resume_state_checkpoint_contains_address
    {layout : List Name} {canBreak canContinue canLeave : Bool}
    {prim : EvmYul.Operation .Yul}
    {args : List Word} {state : State}
    {create :
      OpenExternal.OpenCreate
        (Except EvmYul.Yul.Exception (State × List Word))}
    (hAllowed : StateCheckpointAllowed canBreak canContinue canLeave state)
    (hContains : StateStoreContains layout state)
    (hCreate :
      OpenExternal.CreateKind.yulPrimitiveEvalValuesOpenCreate?
          state prim args =
        some create)
    (response : OpenExternal.CreateResponse) :
    ∃ stateAfter,
      create.resume response =
        .ok (stateAfter, [response.address]) ∧
        StateCheckpointAllowed canBreak canContinue canLeave stateAfter ∧
        StateStoreContains layout stateAfter := by
  unfold OpenExternal.CreateKind.yulPrimitiveEvalValuesOpenCreate? at hCreate
  cases hKind : OpenExternal.CreateKind.ofYulOperation? prim with
  | none =>
      simp [hKind] at hCreate
  | some kind =>
      cases hOpen :
          OpenExternal.CreateKind.yulOpenCreate? state kind args with
      | none =>
          simp [hKind, hOpen] at hCreate
      | some sourceCreate =>
