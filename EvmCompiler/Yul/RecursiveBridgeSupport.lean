/--
Hidden open-sequence soundness for a generated argument prelude whose imported
argument evaluation itself halts or reverts before the generated suffix is
reached.

This is the sequence-level sibling of
`sourceResultBlockSoundWhenAtExact_arg_terminal_prelude_suffix`: no scoped
block cleanup or `ctx.scope = layout` premise is involved. It is the reusable
terminal branch for primitive and user-call heads inside hidden-context
open-sequence frontiers.
-/
theorem sourceResultSeqSoundWhenAtExactHiddenCtx_arg_terminal_prelude_suffix
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat} {sourceStmts : List AstStmt}
    {args : List AstExpr} {codeOverride : Option AstContract}
    {pre suffix : List Functions.Stmt}
    {allowed : Except Exception State → Prop}
    (hArgs :
      SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program ctx argFuel args codeOverride pre)
    (hArgError :
      ∀ {source compiler sourceResult},
        SourceStateExactRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
          sourceResult →
        ∃ err,
          EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
            .error err ∧
          sourceResult = .error err ∧
          SourceResultRelatable (.error err)) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel sourceStmts
      codeOverride { stmts := pre ++ suffix } allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hArgError hInitial hAllow hSource with
    ⟨err, hEvalArgs, hResultEq, hRelatable⟩
  rcases hArgs hInitial hEvalArgs hRelatable with
    ⟨sourceOutcome, ctxAfter, preFuel, hPreRun, hOutcomeRel⟩
  have hMode :
      sourceOutcome.mode ≠ .regular :=
    SourceResultOutcomeRel.mode_ne_regular_of_error hOutcomeRel
  rcases
      Functions.Source.Block.runOpen_append_nonregular_exists prim program
        pre suffix ctx compiler sourceOutcome ctxAfter ⟨preFuel, hPreRun⟩
        hMode with
    ⟨targetFuel, hTargetOpen⟩
  exact
    ⟨sourceOutcome, ctxAfter, targetFuel, hTargetOpen,
      by
        rw [hResultEq]
        exact hOutcomeRel⟩

