          (some contract) (.Ok shared store) with
    | error stmtErr =>
        have hErr : stmtErr = err := by
          simpa [hStmt] using hExecBlock
        subst stmtErr
        rfl
    | ok stmtState =>
        cases stmtState <;> simp [hStmt] at hExecBlock
