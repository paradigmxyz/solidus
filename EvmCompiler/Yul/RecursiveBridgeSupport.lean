    (hFresh : ∀ name, name ∈ identNames names → name ∉ layout)
    (hArgs :
      SourceArgListPreludeRegularAt cfg layout prim program
        { ctx with scope := (identNames names).reverse ++ ctx.scope }
        argFuel args codeOverride pre lowerArgs)
    (hCall :
      ∀ {source compiler sourceResult},
        SourceStateRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel
            (.Block [.Let names (some (.Call (.inr functionName) args))])
            codeOverride source =
