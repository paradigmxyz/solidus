theorem ForOkDomainExactContracts.of_contracts
    {layout : List Name} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    (hCond :
      ExprOkOrOutOfFuelDomainExactContract layout cond codeOverride)
    (hCondOutOfFuelFalse :
      ∀ {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
        {store storeAfter : EvmYul.Yul.VarStore} {value : Word},
        StoreDomainExact layout store →
        EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) =
          .ok (.OutOfFuel, value) →
        EvmYul.Yul.exec fuel.succ.succ.succ (.For cond post body)
          codeOverride (.Ok shared store) =
            .ok (.Ok sharedAfter storeAfter) →
        False)
    (hBody :
      BlockDomainExactContract layout body codeOverride)
    (hPost :
      BlockDomainExactContract layout post codeOverride)
    (hPostBreakFalse :
      ∀ {fuel : Nat}
        {sharedAfterBody sharedAfterPost : EvmYul.SharedState .Yul}
        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Checkpoint (.Break sharedAfterPost storeAfterPost)) →
        False)
    (hPostContinueFalse :
      ∀ {fuel : Nat}
        {sharedAfterBody sharedAfterPost : EvmYul.SharedState .Yul}
        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Checkpoint (.Continue sharedAfterPost storeAfterPost)) →
        False) :
    ForOkDomainExactContracts layout cond post body codeOverride where
  evalOkOrOutOfFuel := hCond.evalOkOrOutOfFuel
  condOutOfFuelFalse := hCondOutOfFuelFalse
  bodyOk := hBody.ok
  bodyBreak := hBody.brk
  bodyContinue := hBody.cont
  postOk := hPost.ok
  postBreakFalse := hPostBreakFalse
  postContinueFalse := hPostContinueFalse

theorem ForOkDomainExactContracts.of_execSeq_contains
    {layout : List Name} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    (hCond :
      ExprOkOrOutOfFuelDomainExactContract layout cond codeOverride)
    (hCondOutOfFuelFalse :
      ∀ {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
        {store storeAfter : EvmYul.Yul.VarStore} {value : Word},
        StoreDomainExact layout store →
        EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) =
          .ok (.OutOfFuel, value) →
        EvmYul.Yul.exec fuel.succ.succ.succ (.For cond post body)
          codeOverride (.Ok shared store) =
            .ok (.Ok sharedAfter storeAfter) →
        False)
    (hBodySeq :
      ∀ {fuel : Nat} {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore},
        StoreDomainExact layout store →
        SourceResultStoreContains layout
          (EvmYul.Yul.execSeq fuel body codeOverride (.Ok shared store)))
    (hPostSeq :
      ∀ {fuel : Nat} {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore},
        StoreDomainExact layout store →
        SourceResultStoreContains layout
          (EvmYul.Yul.execSeq fuel post codeOverride (.Ok shared store)))
    (hPostBreakFalse :
      ∀ {fuel : Nat}
        {sharedAfterBody sharedAfterPost : EvmYul.SharedState .Yul}
        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Checkpoint (.Break sharedAfterPost storeAfterPost)) →
        False)
    (hPostContinueFalse :
      ∀ {fuel : Nat}
        {sharedAfterBody sharedAfterPost : EvmYul.SharedState .Yul}
        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Checkpoint (.Continue sharedAfterPost storeAfterPost)) →
        False) :
    ForOkDomainExactContracts layout cond post body codeOverride :=
  ForOkDomainExactContracts.of_contracts
    (layout := layout) (cond := cond) (post := post) (body := body)
    (codeOverride := codeOverride)
    hCond hCondOutOfFuelFalse
    (BlockDomainExactContract.of_execSeq_contains
      (layout := layout) (stmts := body) (codeOverride := codeOverride)
      hBodySeq)
    (BlockDomainExactContract.of_execSeq_contains
      (layout := layout) (stmts := post) (codeOverride := codeOverride)
      hPostSeq)
    hPostBreakFalse hPostContinueFalse

theorem ForOkDomainExactContracts.of_safe_scoped_primitiveFamilies
    {layout : List Name} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {canBreak canContinue canLeave : Bool}
    (hSafeFor : Safe.stmt (.For cond post body))
    (hScopedFor :
      ControlFlow.ScopedStmt canBreak canContinue canLeave
        (.For cond post body)) :
    ForOkDomainExactContracts layout cond post body codeOverride := by
  rcases hSafeFor with ⟨hCondSafe, hPostSafe, hBodySafe⟩
  rcases hScopedFor with ⟨hPostScoped, _hBodyScoped⟩
  let hCheckpointExpr : CheckpointExpressionSound :=
    CheckpointExpressionSound.of_callSound
      (CheckpointCallSound.of_primitiveCallCheckpointAllowedForSafe
        PrimitiveCallCheckpointAllowedForSafe.of_primitive_families
        PrimitiveCallCheckpointAllowedForSafeNonOk.of_primitive_families)
  refine
    ForOkDomainExactContracts.of_execSeq_contains
      (layout := layout) (cond := cond) (post := post) (body := body)
      (codeOverride := codeOverride)
      (ExprOkOrOutOfFuelDomainExactContract.of_safe_primitiveFamilies
        (layout := layout) (expr := cond)
        (codeOverride := codeOverride) hCondSafe)
      ?_ ?_ ?_ ?_ ?_
  · intro fuel shared sharedAfter store storeAfter value _hDomain hEval hExec
    exact
      exec_for_ok_false_of_condition_outOfFuel
        (fuel := fuel) (cond := cond) (post := post) (body := body)
        (codeOverride := codeOverride) (shared := shared)
        (sharedAfter := sharedAfter) (store := store)
        (storeAfter := storeAfter) (value := value)
        hBodySafe hEval hExec
  · intro fuel shared store hDomain
    exact
      SourceResultStoreContains.execSeq_ok_of_safe_primitiveFamilies
        (layout := layout) (fuel := fuel) (stmts := body)
        (codeOverride := codeOverride) (shared := shared) (store := store)
        hBodySafe (StoreDomainContains.of_exact hDomain)
  · intro fuel shared store hDomain
    exact
      SourceResultStoreContains.execSeq_ok_of_safe_primitiveFamilies
        (layout := layout) (fuel := fuel) (stmts := post)
        (codeOverride := codeOverride) (shared := shared) (store := store)
        hPostSafe (StoreDomainContains.of_exact hDomain)
  · intro fuel sharedAfterBody sharedAfterPost storeAfterBody storeAfterPost
      hPost
    have hAllowedCanLeave :
        SourceResultCheckpointAllowed false false canLeave
          (EvmYul.Yul.exec fuel (.Block post) codeOverride
            (.Ok sharedAfterBody storeAfterBody)) :=
      SourceResultCheckpointAllowed.exec_of_scoped_safe
        hCheckpointExpr
        (by simpa [Safe.stmt] using hPostSafe)
        (ControlFlow.scoped_block hPostScoped)
        (by simp [StateCheckpointAllowed])
    have hAllowed :
        SourceResultCheckpointAllowed false false true
          (EvmYul.Yul.exec fuel (.Block post) codeOverride
            (.Ok sharedAfterBody storeAfterBody)) :=
      SourceResultCheckpointAllowed.mono
        (canBreakFrom := false) (canContinueFrom := false)
        (canLeaveFrom := canLeave) (canBreakTo := false)
        (canContinueTo := false) (canLeaveTo := true)
        (by intro h; cases h) (by intro h; cases h)
        (by intro _h; rfl) hAllowedCanLeave
    rw [hPost] at hAllowed
    simpa [SourceResultCheckpointAllowed, StateCheckpointAllowed] using
      hAllowed
  · intro fuel sharedAfterBody sharedAfterPost storeAfterBody storeAfterPost
      hPost
    have hAllowedCanLeave :
        SourceResultCheckpointAllowed false false canLeave
          (EvmYul.Yul.exec fuel (.Block post) codeOverride
            (.Ok sharedAfterBody storeAfterBody)) :=
      SourceResultCheckpointAllowed.exec_of_scoped_safe
        hCheckpointExpr
        (by simpa [Safe.stmt] using hPostSafe)
        (ControlFlow.scoped_block hPostScoped)
        (by simp [StateCheckpointAllowed])
    have hAllowed :
        SourceResultCheckpointAllowed false false true
          (EvmYul.Yul.exec fuel (.Block post) codeOverride
            (.Ok sharedAfterBody storeAfterBody)) :=
      SourceResultCheckpointAllowed.mono
        (canBreakFrom := false) (canContinueFrom := false)
        (canLeaveFrom := canLeave) (canBreakTo := false)
        (canContinueTo := false) (canLeaveTo := true)
        (by intro h; cases h) (by intro h; cases h)
        (by intro _h; rfl) hAllowedCanLeave
    rw [hPost] at hAllowed
    simpa [SourceResultCheckpointAllowed, StateCheckpointAllowed] using
      hAllowed

