    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hSeq :
      SourceRegularSeqSoundAtFuelExactDomain cfg layout layoutAfter prim
        program ctx sourceFuel targetFuel body codeOverride lowerBody) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ body codeOverride lowerBody
      allowed :=
  sourceResultBlockSoundWhenAtExact_same_layout_of_compat_no_checkpoint
    (sourceResultBlockSoundWhenAtExact_of_regularSeqExactDomain_same
      (cfg := cfg) (layout := layout) (layoutAfter := layoutAfter)
      (terminalRel := terminalRel) (revertRel := revertRel)
      (prim := prim) (program := program) (ctx := ctx)
      (sourceFuel := sourceFuel) (targetFuel := targetFuel)
      (body := body) (codeOverride := codeOverride)
      (lowerBody := lowerBody) (allowed := allowed) hSeq)
    hCompat
    (by
      intro source compiler sourceResult hInitial _hAllow hSource
      rcases hSeq with ⟨_hScope, hRun⟩
      cases hInitial with
      | @ok shared scope compiler hShared hVars hDomain =>
          rcases
              sourceRegularBlockRunAtExact_of_seqDomain
                (cfg := cfg) (layout := layout)
                (layoutAfter := layoutAfter) (prim := prim)
                (program := program) (ctx := ctx)
                (sourceFuel := sourceFuel) (targetFuel := targetFuel)
                (sourceStmts := body) (codeOverride := codeOverride)
                (shared := shared) (scope := scope) (compiler := compiler)
                (lowerBlock := lowerBody) hDomain
                (hRun (SourceStateExactRel.ok hShared hVars hDomain)) with
            ⟨sourceAfter, _compilerAfter, hSourceBlock, _hTargetBlock,
              hRelAfter⟩
          rw [hSourceBlock] at hSource
          subst sourceResult
          cases hRelAfter with
          | ok _hSharedAfter _hVarsAfter _hDomainAfter =>
              simp [SourceResultNoCheckpoint])

