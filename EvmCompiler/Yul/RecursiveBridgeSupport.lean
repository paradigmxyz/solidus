theorem lookupBang_reviveJump_eq (name : Name) (state : State) :
    EvmYul.Yul.State.lookup! name
        (EvmYul.Yul.State.reviveJump state) =
      EvmYul.Yul.State.lookup! name state := by
  cases state with
  | Ok shared store =>
      simp [EvmYul.Yul.State.reviveJump]
  | OutOfFuel =>
      simp [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.lookup!,
        EvmYul.Yul.State.lookup?]
  | Checkpoint jump =>
      cases jump with
      | Continue shared store =>
          simp [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
            EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?]
      | Break shared store =>
          simp [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
            EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?]
      | Leave shared store =>
          simp [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
            EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?]

theorem lookupBang_restrictStoreTo_eq_of_scope_some
    {name : Name} {scope : EvmYul.Yul.VarStore} {state : State}
    (hScope : (scope.lookup name).isSome = true) :
    EvmYul.Yul.State.lookup! name
        (EvmYul.Yul.State.restrictStoreTo scope state) =
      EvmYul.Yul.State.lookup! name state := by
  cases hScopeLookup : scope.lookup name with
  | none =>
      simp [hScopeLookup] at hScope
  | some value =>
      cases state with
      | Ok shared store =>
          simp [EvmYul.Yul.State.restrictStoreTo,
            EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
            FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
              name hScopeLookup]
      | OutOfFuel =>
          simp [EvmYul.Yul.State.restrictStoreTo,
            EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?]
      | Checkpoint jump =>
          cases jump with
          | Continue shared store =>
              simp [EvmYul.Yul.State.restrictStoreTo,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
                  name hScopeLookup]
          | Break shared store =>
              simp [EvmYul.Yul.State.restrictStoreTo,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
                  name hScopeLookup]
          | Leave shared store =>
              simp [EvmYul.Yul.State.restrictStoreTo,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
                  name hScopeLookup]

theorem map_lookupBang_restrictStoreTo_eq_of_domain
    {names : List Name} {scope : EvmYul.Yul.VarStore} {state : State}
    (hScope : StoreDomainExact names scope) :
    (names.map fun name =>
        EvmYul.Yul.State.lookup! name
          (EvmYul.Yul.State.restrictStoreTo scope state)) =
      names.map fun name => EvmYul.Yul.State.lookup! name state := by
  apply List.map_congr_left
  intro name hMem
  exact
    lookupBang_restrictStoreTo_eq_of_scope_some
      (name := name) (scope := scope) (state := state)
      ((hScope name).mpr hMem)

theorem map_lookupBang_restrictStoreTo_eq_of_scope_contains
    {names : List Name} {scope : EvmYul.Yul.VarStore} {state : State}
    (hScope :
      ∀ name, name ∈ names → (scope.lookup name).isSome = true) :
    (names.map fun name =>
        EvmYul.Yul.State.lookup! name
          (EvmYul.Yul.State.restrictStoreTo scope state)) =
      names.map fun name => EvmYul.Yul.State.lookup! name state := by
  apply List.map_congr_left
  intro name hMem
  exact
    lookupBang_restrictStoreTo_eq_of_scope_some
      (name := name) (scope := scope) (state := state)
      (hScope name hMem)

/--
No-target user-call state relation after imported call restoration.

For expression-statement calls, `multifill []` leaves the caller varstore
unchanged. The imported call keeps the revived callee shared state, then
restores the caller's varstore. The source compiler state mirrors that shape:
callee/shared effects plus caller locals.
-/
theorem sourceStateRel_userCall_noTargets_of_revive
    {cfg : StateRelConfig} {layout bodyLayout : List Name}
    {sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {storeArgs storeAfter : EvmYul.Yul.VarStore}
    {callerCompiler bodyCompiler : Objects.Source.State}
    {bodyState : State} {returnValues : List Word}
    (hCaller :
      SourceStateRel cfg layout (.Ok sharedArgs storeArgs) callerCompiler)
    (hBody :
      SourceStateRel cfg bodyLayout
        (EvmYul.Yul.State.reviveJump bodyState) bodyCompiler)
    (hFinal :
      EvmYul.Yul.State.multifill [] returnValues
          (((EvmYul.Yul.State.reviveJump bodyState).overwrite?
            (.Ok sharedArgs storeArgs)).setStore (.Ok sharedArgs storeArgs)) =
        .Ok sharedAfter storeAfter) :
    SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
      ({ shared := bodyCompiler.shared, vars := callerCompiler.vars } :
        Objects.Source.State) := by
  cases hCaller with
  | ok _hSharedCaller hVarsCaller =>
      cases bodyState with
      | Ok bodyShared bodyStore =>
          simp [EvmYul.Yul.State.reviveJump,
            EvmYul.Yul.State.overwrite?,
            EvmYul.Yul.State.setStore] at hBody hFinal
          cases hBody with
          | ok hSharedBody _hVarsBody =>
              simp [EvmYul.Yul.State.multifill,
                EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hFinal
              rcases hFinal with ⟨hSharedAfter, hStoreAfter⟩
              subst sharedAfter
              subst storeAfter
              exact SourceStateRel.ok hSharedBody hVarsCaller
      | OutOfFuel =>
          simp [EvmYul.Yul.State.reviveJump] at hBody
          cases hBody
      | Checkpoint jump =>
          cases jump with
          | Continue bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  simp [EvmYul.Yul.State.multifill,
                    EvmYul.Yul.State.overwrite?,
                    EvmYul.Yul.State.setStore] at hFinal
                  rcases hFinal with ⟨hSharedAfter, hStoreAfter⟩
                  subst sharedAfter
                  subst storeAfter
                  exact SourceStateRel.ok hSharedBody hVarsCaller
          | Break bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  simp [EvmYul.Yul.State.multifill,
                    EvmYul.Yul.State.overwrite?,
                    EvmYul.Yul.State.setStore] at hFinal
                  rcases hFinal with ⟨hSharedAfter, hStoreAfter⟩
                  subst sharedAfter
                  subst storeAfter
                  exact SourceStateRel.ok hSharedBody hVarsCaller
          | Leave bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  simp [EvmYul.Yul.State.multifill,
                    EvmYul.Yul.State.overwrite?,
                    EvmYul.Yul.State.setStore] at hFinal
                  rcases hFinal with ⟨hSharedAfter, hStoreAfter⟩
                  subst sharedAfter
                  subst storeAfter
                  exact SourceStateRel.ok hSharedBody hVarsCaller

theorem sourceOkOutcomeRel_lookupMany_eq_map_lookup!
    {cfg : StateRelConfig} {layout returns : List Name}
    {source : State} {outcome : Objects.Source.Outcome}
    {values : List Word}
    (hRel : SourceOkOutcomeRel cfg layout source outcome)
    (hMode :
      outcome.mode = .regular ∨ outcome.mode = .leave)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout)
    (hLookup :
      Functions.Source.Store.lookupMany returns outcome.state.vars =
        some values) :
    values = returns.map fun name => EvmYul.Yul.State.lookup! name source := by
  cases hRel with
  | regular hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          exact
            sourceStateRel_lookupMany_eq_map_lookup!
              (layout := layout) (returns := returns)
              (hRel := SourceStateRel.ok hShared hVars)
              hReturns hLookup
  | brk hStateRel =>
      cases hMode with
      | inl hRegular =>
          cases hRegular
      | inr hLeave =>
          cases hLeave
  | cont hStateRel =>
      cases hMode with
      | inl hRegular =>
          cases hRegular
      | inr hLeave =>
          cases hLeave
  | leave hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          have hValues :=
            sourceStateRel_lookupMany_eq_map_lookup!
              (layout := layout) (returns := returns)
              (hRel := SourceStateRel.ok hShared hVars)
              hReturns hLookup
          simpa [EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?]
            using hValues

theorem sourceStoreRel_of_mem_iff
    {layout layout' : List Name}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    (hRel : SourceStoreRel layout store vars)
    (hMem : ∀ name, name ∈ layout' ↔ name ∈ layout) :
    SourceStoreRel layout' store vars := by
  intro name hName
  exact hRel name ((hMem name).mp hName)

theorem StoreDomainExact.of_mem_iff
    {layout layout' : List Name} {store : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store)
    (hMem : ∀ name, name ∈ layout' ↔ name ∈ layout) :
    StoreDomainExact layout' store := by
  intro name
  constructor
  · intro hSome
    exact (hMem name).mpr ((hDomain name).mp hSome)
  · intro hName
    exact (hDomain name).mpr ((hMem name).mp hName)

theorem source_insertMany_preserves_of_not_mem :
    ∀ {names : List Name} {wordValues : List Word}
      {store store' : Locals.Source.Store} {name : Name},
      Functions.Source.Store.insertMany names wordValues store =
          some store' →
        name ∉ names →
          store' name = store name
  | [], [], _store, _store', _name, hInsert, _hFresh => by
      simp [Functions.Source.Store.insertMany] at hInsert
      cases hInsert
      rfl
  | [], _value :: _values, _store, _store', _name, hInsert, _hFresh => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | _head :: _tail, [], _store, _store', _name, hInsert, _hFresh => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | head :: tail, value :: values, store, store', name, hInsert, hFresh => by
      unfold Functions.Source.Store.insertMany at hInsert
      have hTailFresh : name ∉ tail := by
        intro hMem
        exact hFresh (by simp [hMem])
      have hHeadNe : name ≠ head := by
        intro hEq
        exact hFresh (by simp [hEq])
      have hPreserve :=
        source_insertMany_preserves_of_not_mem
          (names := tail) (wordValues := values)
          (store := Locals.Source.Store.insert store head value)
          (store' := store') (name := name) hInsert hTailFresh
      simpa [Locals.Source.Store.insert_of_ne hHeadNe] using hPreserve

theorem source_insertMany_exists_of_length :
    ∀ {names : List Name} {values : List Word}
      {store : Locals.Source.Store},
      values.length = names.length →
        ∃ store',
          Functions.Source.Store.insertMany names values store = some store'
  | [], [], store, _hLen => by
      exact ⟨store, by simp [Functions.Source.Store.insertMany]⟩
  | [], _value :: _values, _store, hLen => by
      simp at hLen
  | _name :: _names, [], _store, hLen => by
      simp at hLen
  | name :: names, value :: values, store, hLen => by
      have hTailLen : values.length = names.length := by
        simpa using Nat.succ.inj hLen
      rcases
          source_insertMany_exists_of_length
            (names := names) (values := values)
            (store := Locals.Source.Store.insert store name value)
            hTailLen with
        ⟨store', hInsert⟩
      exact ⟨store', by simpa [Functions.Source.Store.insertMany] using hInsert⟩

theorem source_assignMany_exists_of_length_contains :
    ∀ {names : List Name} {values : List Word}
      {store : Locals.Source.Store},
      values.length = names.length →
        (∀ name, name ∈ names →
          Locals.Source.Store.contains store name = true) →
        ∃ store',
          Functions.Source.Store.assignMany names values store = some store'
  | [], [], store, _hLen, _hContains => by
      exact ⟨store, by simp [Functions.Source.Store.assignMany]⟩
  | [], _value :: _values, _store, hLen, _hContains => by
      simp at hLen
  | _name :: _names, [], _store, hLen, _hContains => by
      simp at hLen
  | name :: names, value :: values, store, hLen, hContains => by
      have hHead : Locals.Source.Store.contains store name = true :=
        hContains name (by simp)
      have hTailLen : values.length = names.length := by
        simpa using Nat.succ.inj hLen
      have hTailContains :
          ∀ other, other ∈ names →
            Locals.Source.Store.contains
                (Locals.Source.Store.insert store name value) other = true := by
        intro other hMem
        by_cases hEq : other = name
        · subst other
          simp [Locals.Source.Store.contains,
            Locals.Source.Store.insert_self]
        · have hOld :
              Locals.Source.Store.contains store other = true :=
            hContains other (by simp [hMem])
          simpa [Locals.Source.Store.contains,
            Locals.Source.Store.insert_of_ne hEq] using hOld
      rcases
          source_assignMany_exists_of_length_contains
            (names := names) (values := values)
            (store := Locals.Source.Store.insert store name value)
            hTailLen hTailContains with
        ⟨store', hAssign⟩
      exact ⟨store', by
        simp [Functions.Source.Store.assignMany, hHead, hAssign]⟩

theorem source_assignMany_preserves_of_not_mem :
    ∀ {names : List Name} {values : List Word}
      {store store' : Locals.Source.Store} {name : Name},
      Functions.Source.Store.assignMany names values store =
          some store' →
        name ∉ names →
          store' name = store name
  | [], [], _store, _store', _name, hAssign, _hFresh => by
      simp [Functions.Source.Store.assignMany] at hAssign
      cases hAssign
      rfl
  | [], _value :: _values, _store, _store', _name, hAssign,
      _hFresh => by
      simp [Functions.Source.Store.assignMany] at hAssign
  | _head :: _tail, [], _store, _store', _name, hAssign,
      _hFresh => by
      simp [Functions.Source.Store.assignMany] at hAssign
  | head :: tail, value :: values, store, store', name, hAssign,
      hFresh => by
      unfold Functions.Source.Store.assignMany at hAssign
      by_cases hContains : store.contains head
      · simp [hContains] at hAssign
        have hTailFresh : name ∉ tail := by
          intro hMem
          exact hFresh (by simp [hMem])
        have hHeadNe : name ≠ head := by
          intro hEq
          exact hFresh (by simp [hEq])
        have hPreserve :=
          source_assignMany_preserves_of_not_mem
            (names := tail) (values := values)
            (store := Locals.Source.Store.insert store head value)
            (store' := store') (name := name) hAssign hTailFresh
        simpa [Locals.Source.Store.insert_of_ne hHeadNe] using hPreserve
      · simp [hContains] at hAssign

theorem fst_mem_of_mem_zip {α β : Type} :
    ∀ {xs : List α} {ys : List β} {pair : α × β},
      pair ∈ List.zip xs ys → pair.1 ∈ xs
  | [], _ys, _pair, hMem => by
      simp at hMem
  | _x :: _xs, [], _pair, hMem => by
      simp at hMem
  | x :: xs, y :: ys, pair, hMem => by
      simp at hMem
      rcases hMem with hEq | hTail
      · cases hEq
        simp
      · exact List.mem_cons_of_mem x (fst_mem_of_mem_zip hTail)

theorem exists_zip_value_of_mem_of_length :
    ∀ {names : List Name} {values : List Word} {name : Name},
      values.length = names.length →
        name ∈ names →
          ∃ value, (name, value) ∈ List.zip names values
  | [], [], _name, _hLen, hMem => by
      cases hMem
  | [], _value :: _values, _name, hLen, _hMem => by
      simp at hLen
  | _head :: _tail, [], _name, hLen, _hMem => by
      simp at hLen
  | head :: tail, value :: values, name, hLen, hMem => by
      simp at hLen
      simp at hMem
      rcases hMem with hEq | hTail
      · subst name
        exact ⟨value, by simp⟩
      · rcases
          exists_zip_value_of_mem_of_length
            (names := tail) (values := values) (name := name)
            hLen hTail with
          ⟨tailValue, hZip⟩
        exact ⟨tailValue, by simp [hZip]⟩

theorem source_assignMany_lookup_of_zip_nodup :
    ∀ {names : List Name} {values : List Word}
      {store store' : Locals.Source.Store} {name : Name} {value : Word},
      Functions.Source.Store.assignMany names values store = some store' →
        names.Nodup →
          (name, value) ∈ List.zip names values →
            store' name = some value
  | [], [], _store, _store', _name, _value, hAssign, _hNoDup,
      hPair => by
      simp at hPair
  | [], _value :: _values, _store, _store', _name, _assigned, hAssign,
      _hNoDup, _hPair => by
      simp [Functions.Source.Store.assignMany] at hAssign
  | _head :: _tail, [], _store, _store', _name, _assigned, hAssign,
      _hNoDup, _hPair => by
      simp [Functions.Source.Store.assignMany] at hAssign
  | head :: tail, value :: values, store, store', name, assigned,
      hAssign, hNoDup, hPair => by
      unfold Functions.Source.Store.assignMany at hAssign
      by_cases hContains : store.contains head
      · simp [hContains] at hAssign
        have hTailNoDup : tail.Nodup := hNoDup.tail
        have hHeadNotMemTail : head ∉ tail := hNoDup.notMem
        simp at hPair
        rcases hPair with hHead | hTail
        · rcases hHead with ⟨hName, hAssigned⟩
          subst name
          subst assigned
          have hPreserve :=
            source_assignMany_preserves_of_not_mem
              (names := tail) (values := values)
              (store := Locals.Source.Store.insert store head value)
              (store' := store') (name := head) hAssign
              hHeadNotMemTail
          simpa [Locals.Source.Store.insert_self] using hPreserve
        · exact
            source_assignMany_lookup_of_zip_nodup
              (names := tail) (values := values)
              (store := Locals.Source.Store.insert store head value)
              (store' := store') (name := name) (value := assigned)
              hAssign hTailNoDup hTail
      · simp [hContains] at hAssign

theorem lookup_insertPairs_of_zip_nodup :
    ∀ {names : List Name} {values : List Word}
      {store : EvmYul.Yul.VarStore} {name : Name} {value : Word},
      names.Nodup →
        (name, value) ∈ List.zip names values →
          (VarStackRel.insertPairs (List.zip names values) store).lookup name =
            some value
  | [], [], _store, _name, _value, _hNoDup, hPair => by
      simp at hPair
  | [], _value :: _values, _store, _name, _assigned, _hNoDup,
      hPair => by
      simp at hPair
  | _head :: _tail, [], _store, _name, _assigned, _hNoDup,
      hPair => by
      simp at hPair
  | head :: tail, value :: values, store, name, assigned, hNoDup,
      hPair => by
      have hTailNoDup : tail.Nodup := hNoDup.tail
      have hHeadNotMemTail : head ∉ tail := hNoDup.notMem
      simp at hPair
      rcases hPair with hHead | hTail
      · rcases hHead with ⟨hName, hAssigned⟩
        subst name
        subst assigned
        simp [VarStackRel.insertPairs]
      · have hNameTail : name ∈ tail :=
          fst_mem_of_mem_zip hTail
        have hNe : name ≠ head := by
          intro hEq
          exact hHeadNotMemTail (by simpa [hEq] using hNameTail)
        simp [VarStackRel.insertPairs]
        rw [Finmap.lookup_insert_of_ne]
        · exact
            lookup_insertPairs_of_zip_nodup
              (names := tail) (values := values)
              (store := store) (name := name) (value := assigned)
              hTailNoDup hTail
        · exact hNe

theorem sourceStoreRel_assignMany_insertPairs
    {layout names : List Name} {values : List Word}
    {store : EvmYul.Yul.VarStore}
    {vars vars' : Locals.Source.Store}
    (hAssign :
      Functions.Source.Store.assignMany names values vars = some vars')
    (hRel : SourceStoreRel layout store vars)
    (hNoDup : names.Nodup) :
    SourceStoreRel layout
      (VarStackRel.insertPairs (List.zip names values) store) vars' := by
  intro query hQuery
  have hLen : values.length = names.length :=
    Functions.Source.Store.assignMany_length hAssign
  by_cases hMem : query ∈ names
  · rcases
      exists_zip_value_of_mem_of_length
        (names := names) (values := values) (name := query)
        hLen hMem with
      ⟨value, hPair⟩
    have hSource :
        vars' query = some value :=
      source_assignMany_lookup_of_zip_nodup
        (names := names) (values := values) (store := vars)
        (store' := vars') (name := query) (value := value)
        hAssign hNoDup hPair
    have hTarget :
        (VarStackRel.insertPairs (List.zip names values) store).lookup query =
          some value :=
      lookup_insertPairs_of_zip_nodup
        (names := names) (values := values) (store := store)
        (name := query) (value := value) hNoDup hPair
    rw [hSource, hTarget]
  · have hSource :
        vars' query = vars query :=
      source_assignMany_preserves_of_not_mem
        (names := names) (values := values) (store := vars)
        (store' := vars') (name := query) hAssign hMem
    have hTarget :
        (VarStackRel.insertPairs (List.zip names values) store).lookup query =
          store.lookup query := by
      exact
        BridgeFacts.lookup_insertPairs_preserve
          (pairs := List.zip names values) (store := store)
          (name := query) (by
            intro pairName hPairName hEq
            rcases List.mem_map.mp hPairName with
              ⟨pair, hPairMem, hPairEq⟩
            have hPairNameMem : pairName ∈ names := by
              simpa [hPairEq] using
                (fst_mem_of_mem_zip (pair := pair) hPairMem)
            exact hMem (by simpa [hEq] using hPairNameMem))
    rw [hSource, hTarget]
    exact hRel query hQuery

/--
Assigning fresh hidden targets extends the source-visible relation.

This is the `let xs := f(...)` counterpart to
`sourceStoreRel_assignMany_insertPairs`: the compiler has already materialized
the target slots as hidden locals, while imported Yul only exposes them after
`multifill'`.  For old layout names we use preservation; for fresh target names
we use the assignment/insert-pair lookup facts directly.
-/
theorem sourceStoreRel_assignMany_insertPairs_extend
    {layout names : List Name} {values : List Word}
    {store : EvmYul.Yul.VarStore}
    {vars vars' : Locals.Source.Store}
    (hAssign :
      Functions.Source.Store.assignMany names values vars = some vars')
    (hRel : SourceStoreRel layout store vars)
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ layout) :
    SourceStoreRel (names ++ layout)
      (VarStackRel.insertPairs (List.zip names values) store) vars' := by
  intro query hQuery
  simp only [List.mem_append] at hQuery
  rcases hQuery with hTarget | hLayout
  · have hLen : values.length = names.length :=
      Functions.Source.Store.assignMany_length hAssign
    rcases
        exists_zip_value_of_mem_of_length
          (names := names) (values := values) (name := query)
          hLen hTarget with
      ⟨value, hPair⟩
    have hSource :
        vars' query = some value :=
      source_assignMany_lookup_of_zip_nodup
        (names := names) (values := values) (store := vars)
        (store' := vars') (name := query) (value := value)
        hAssign hNoDup hPair
    have hTargetLookup :
        (VarStackRel.insertPairs (List.zip names values) store).lookup
            query =
          some value :=
      lookup_insertPairs_of_zip_nodup
        (names := names) (values := values) (store := store)
        (name := query) (value := value) hNoDup hPair
    rw [hSource, hTargetLookup]
  · have hNotTarget : query ∉ names := by
      intro hMem
      exact hFresh query hMem hLayout
    have hSource :
        vars' query = vars query :=
      source_assignMany_preserves_of_not_mem
        (names := names) (values := values) (store := vars)
        (store' := vars') (name := query) hAssign hNotTarget
    have hTargetLookup :
        (VarStackRel.insertPairs (List.zip names values) store).lookup
            query =
          store.lookup query := by
      exact
        BridgeFacts.lookup_insertPairs_preserve
          (pairs := List.zip names values) (store := store)
          (name := query) (by
            intro pairName hPairName hEq
            rcases List.mem_map.mp hPairName with
              ⟨pair, hPairMem, hPairEq⟩
            have hPairNameMem : pairName ∈ names := by
              simpa [hPairEq] using
                (fst_mem_of_mem_zip (pair := pair) hPairMem)
            exact hNotTarget (by simpa [hEq] using hPairNameMem))
    rw [hSource, hTargetLookup]
    exact hRel query hLayout

/--
Returned-value user-call state relation after imported call restoration.

This is the assignment sibling of
`sourceStateRel_userCall_noTargets_of_revive`: the imported callee supplies the
shared-state effects, the caller varstore is restored, and the returned values
are assigned to caller targets by the same zip/insertion relation used by
source `assignMany`.
-/
theorem sourceStateRel_userCall_targets_of_revive
    {cfg : StateRelConfig} {layout bodyLayout targets : List Name}
    {returnValues : List Word}
    {sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {storeArgs storeAfter : EvmYul.Yul.VarStore}
    {callerCompiler bodyCompiler : Objects.Source.State}
    {bodyState : State} {returnStore : Locals.Source.Store}
    (hCaller :
      SourceStateRel cfg layout (.Ok sharedArgs storeArgs)
        callerCompiler)
    (hBody :
      SourceStateRel cfg bodyLayout
        (EvmYul.Yul.State.reviveJump bodyState) bodyCompiler)
    (hAssign :
      Functions.Source.Store.assignMany targets returnValues
        callerCompiler.vars = some returnStore)
    (hTargetsNoDup : targets.Nodup)
    (hFinal :
      EvmYul.Yul.State.multifill targets returnValues
          (((EvmYul.Yul.State.reviveJump bodyState).overwrite?
            (.Ok sharedArgs storeArgs)).setStore (.Ok sharedArgs storeArgs)) =
        .Ok sharedAfter storeAfter) :
    SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
      ({ shared := bodyCompiler.shared, vars := returnStore } :
        Objects.Source.State) := by
  cases hCaller with
  | ok _hSharedCaller hVarsCaller =>
      cases bodyState with
      | Ok bodyShared bodyStore =>
          simp [EvmYul.Yul.State.reviveJump,
            EvmYul.Yul.State.overwrite?,
            EvmYul.Yul.State.setStore] at hBody hFinal
          cases hBody with
          | ok hSharedBody _hVarsBody =>
              rw [VarStackRel.multifill_ok] at hFinal
              cases hFinal
              exact
                SourceStateRel.ok hSharedBody
                  (sourceStoreRel_assignMany_insertPairs
                    (layout := layout) (names := targets)
                    (values := returnValues) (store := storeArgs)
                    (vars := callerCompiler.vars) (vars' := returnStore)
                    hAssign hVarsCaller hTargetsNoDup)
      | OutOfFuel =>
          simp [EvmYul.Yul.State.reviveJump] at hBody
          cases hBody
      | Checkpoint jump =>
          cases jump with
          | Continue bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  rw [VarStackRel.multifill_ok] at hFinal
                  cases hFinal
                  exact
                    SourceStateRel.ok hSharedBody
                      (sourceStoreRel_assignMany_insertPairs
                        (layout := layout) (names := targets)
                        (values := returnValues) (store := storeArgs)
                        (vars := callerCompiler.vars)
                        (vars' := returnStore)
                        hAssign hVarsCaller hTargetsNoDup)
          | Break bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  rw [VarStackRel.multifill_ok] at hFinal
                  cases hFinal
                  exact
                    SourceStateRel.ok hSharedBody
                      (sourceStoreRel_assignMany_insertPairs
                        (layout := layout) (names := targets)
                        (values := returnValues) (store := storeArgs)
                        (vars := callerCompiler.vars)
                        (vars' := returnStore)
                        hAssign hVarsCaller hTargetsNoDup)
          | Leave bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  rw [VarStackRel.multifill_ok] at hFinal
                  cases hFinal
                  exact
                    SourceStateRel.ok hSharedBody
                      (sourceStoreRel_assignMany_insertPairs
                        (layout := layout) (names := targets)
                        (values := returnValues) (store := storeArgs)
                        (vars := callerCompiler.vars)
                      (vars' := returnStore)
                      hAssign hVarsCaller hTargetsNoDup)

/--
Returned-value user-call state relation for `let` declarations.

Unlike assignment, the returned target names are not part of the imported Yul
varstore before the call.  They are hidden compiler locals until `multifill'`
publishes them, so the post-call relation extends the visible layout by the
fresh targets.
-/
theorem sourceStateRel_userCall_letTargets_of_revive
    {cfg : StateRelConfig} {layout bodyLayout targets : List Name}
    {returnValues : List Word}
    {sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {storeArgs storeAfter : EvmYul.Yul.VarStore}
    {callerCompiler bodyCompiler : Objects.Source.State}
    {bodyState : State} {returnStore : Locals.Source.Store}
    (hCaller :
      SourceStateRel cfg layout (.Ok sharedArgs storeArgs)
        callerCompiler)
    (hBody :
      SourceStateRel cfg bodyLayout
        (EvmYul.Yul.State.reviveJump bodyState) bodyCompiler)
    (hAssign :
      Functions.Source.Store.assignMany targets returnValues
        callerCompiler.vars = some returnStore)
    (hTargetsNoDup : targets.Nodup)
    (hFresh : ∀ name, name ∈ targets → name ∉ layout)
    (hFinal :
      EvmYul.Yul.State.multifill targets returnValues
          (((EvmYul.Yul.State.reviveJump bodyState).overwrite?
            (.Ok sharedArgs storeArgs)).setStore (.Ok sharedArgs storeArgs)) =
        .Ok sharedAfter storeAfter) :
    SourceStateRel cfg (targets.reverse ++ layout) (.Ok sharedAfter storeAfter)
      ({ shared := bodyCompiler.shared, vars := returnStore } :
        Objects.Source.State) := by
  cases hCaller with
  | ok _hSharedCaller hVarsCaller =>
      cases bodyState with
      | Ok bodyShared bodyStore =>
          simp [EvmYul.Yul.State.reviveJump,
            EvmYul.Yul.State.overwrite?,
            EvmYul.Yul.State.setStore] at hBody hFinal
          cases hBody with
          | ok hSharedBody _hVarsBody =>
              rw [VarStackRel.multifill_ok] at hFinal
              cases hFinal
              exact
                SourceStateRel.ok hSharedBody
                  (sourceStoreRel_of_mem_iff
                  (sourceStoreRel_assignMany_insertPairs_extend
                    (layout := layout) (names := targets)
                    (values := returnValues) (store := storeArgs)
                    (vars := callerCompiler.vars) (vars' := returnStore)
                    hAssign hVarsCaller hTargetsNoDup hFresh)
                    (by
                      intro name
                      simp [List.mem_append]))
      | OutOfFuel =>
          simp [EvmYul.Yul.State.reviveJump] at hBody
          cases hBody
      | Checkpoint jump =>
          cases jump with
          | Continue bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  rw [VarStackRel.multifill_ok] at hFinal
                  cases hFinal
                  exact
                    SourceStateRel.ok hSharedBody
                      (sourceStoreRel_of_mem_iff
                        (sourceStoreRel_assignMany_insertPairs_extend
                          (layout := layout) (names := targets)
                          (values := returnValues) (store := storeArgs)
                          (vars := callerCompiler.vars)
                          (vars' := returnStore)
                          hAssign hVarsCaller hTargetsNoDup hFresh)
                        (by
                          intro name
                          simp [List.mem_append]))
          | Break bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  rw [VarStackRel.multifill_ok] at hFinal
                  cases hFinal
                  exact
                    SourceStateRel.ok hSharedBody
                      (sourceStoreRel_of_mem_iff
                        (sourceStoreRel_assignMany_insertPairs_extend
                          (layout := layout) (names := targets)
                          (values := returnValues) (store := storeArgs)
                          (vars := callerCompiler.vars)
                          (vars' := returnStore)
                          hAssign hVarsCaller hTargetsNoDup hFresh)
                        (by
                          intro name
                          simp [List.mem_append]))
          | Leave bodyShared bodyStore =>
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hBody hFinal
              cases hBody with
              | ok hSharedBody _hVarsBody =>
                  rw [VarStackRel.multifill_ok] at hFinal
                  cases hFinal
                  exact
                    SourceStateRel.ok hSharedBody
                      (sourceStoreRel_of_mem_iff
                        (sourceStoreRel_assignMany_insertPairs_extend
                          (layout := layout) (names := targets)
                          (values := returnValues) (store := storeArgs)
                          (vars := callerCompiler.vars)
                          (vars' := returnStore)
                          hAssign hVarsCaller hTargetsNoDup hFresh)
                        (by
                          intro name
                          simp [List.mem_append]))

/--
Hide compiler-only call targets after an imported `multifill`.

Expression-call lowering materializes the one returned value in a fresh hidden
local.  The imported Yul expression result does not publish that local in the
source varstore, so after reusing the ordinary `let`-target user-call theorem
we project the relation back to the visible source layout.  The only semantic
fact needed is that all `multifill` targets are fresh for the visible layout.
-/
theorem SourceStateRel.of_hidden_multifill
    {cfg : StateRelConfig} {layout targets : List Name}
    {values : List Word}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    (hRel :
      SourceStateRel cfg (targets.reverse ++ layout)
        (.Ok sharedAfter storeAfter) compiler)
    (hFresh : ∀ name, name ∈ targets → name ∉ layout)
    (hFinal :
      EvmYul.Yul.State.multifill targets values (.Ok shared store) =
        .Ok sharedAfter storeAfter) :
    SourceStateRel cfg layout (.Ok shared store) compiler := by
  rw [VarStackRel.multifill_ok] at hFinal
  cases hFinal
  cases hRel with
  | ok hShared hVars =>
      refine SourceStateRel.ok hShared ?_
      intro name hMem
      have hVisible :
          name ∈ targets.reverse ++ layout := by
        simp [hMem]
      have hVarsEq := hVars name hVisible
      have hPreserve :
          (VarStackRel.insertPairs (List.zip targets values) store).lookup
              name =
            store.lookup name :=
        BridgeFacts.lookup_insertPairs_preserve
          (pairs := List.zip targets values) (store := store)
          (name := name) (by
            intro pairName hPairName
            rcases List.mem_map.mp hPairName with
              ⟨pair, hPairMem, hPairEq⟩
            have hPairNameMem : pairName ∈ targets := by
              simpa [hPairEq] using
                (fst_mem_of_mem_zip (pair := pair) hPairMem)
            intro hNameEq
            exact hFresh pairName hPairNameMem (by simpa [hNameEq] using hMem))
      exact hVarsEq.trans hPreserve

theorem source_initReturns_preserves_of_not_mem :
    ∀ {names : List Name} {store : Locals.Source.Store} {name : Name},
      name ∉ names →
        Functions.Source.Store.initReturns names store name = store name
  | [], _store, _name, _hFresh => by
      rfl
  | head :: tail, store, name, hFresh => by
      unfold Functions.Source.Store.initReturns
      have hTailFresh : name ∉ tail := by
        intro hMem
        exact hFresh (by simp [hMem])
      have hHeadNe : name ≠ head := by
        intro hEq
        exact hFresh (by simp [hEq])
      have hPreserve :=
        source_initReturns_preserves_of_not_mem
          (names := tail)
          (store := Locals.Source.Store.insert store head Functions.Source.zero)
          (name := name) hTailFresh
      simpa [Locals.Source.Store.insert_of_ne hHeadNe] using hPreserve

/--
Run the generated zero-initializers without assuming they are fresh for the
whole hidden compiler context.

Hidden-context sequence proofs only need source-visible preservation: source
declaration names are fresh for the visible imported layout, but the target
context may already contain compiler-only temporaries.  This target-side helper
records the exact store produced by `Stmt.initNames`; callers project whatever
visible relation they need from `Functions.Source.Store.initReturns`.
-/
theorem functions_source_initNames_runOpen_regular_initReturns
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {compiler : Objects.Source.State} :
    ∀ (names : List Name),
      ∃ compilerAfter,
        Functions.Source.Block.runOpen prim program ctx (names.length + 1)
            { stmts := Stmt.initNames names } compiler =
          .ok (Functions.Source.Outcome.regular compilerAfter,
            { ctx with scope := names.reverse ++ ctx.scope }) ∧
        compilerAfter.shared = compiler.shared ∧
        compilerAfter.vars = Functions.Source.Store.initReturns names
          compiler.vars
  | [] => by
      refine ⟨compiler, ?_, rfl, rfl⟩
      simp [Stmt.initNames, Functions.Source.Block.runOpen]
  | name :: rest => by
      let compilerHead := compiler.insert name Stmt.zero
      let ctxHead : Functions.Source.Ctx :=
        { ctx with scope := name :: ctx.scope }
      rcases
          functions_source_initNames_runOpen_regular_initReturns
            (prim := prim) (program := program) (ctx := ctxHead)
            (compiler := compilerHead) rest with
        ⟨compilerAfter, hRestRun, hShared, hVars⟩
      refine ⟨compilerAfter, ?_, ?_, ?_⟩
      · have hHead :
            Functions.Source.Stmt.run prim program ctx rest.length.succ
                (Functions.Stmt.let_ name
                  (Locals.Expr.lit Stmt.zero)) compiler =
              .ok (Functions.Source.Outcome.regular compilerHead, ctxHead) := by
            simp [Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
              Locals.Source.Expr.evalOne, Locals.Source.Expr.eval,
              compilerHead, ctxHead, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular]
        exact
          (by
            simpa [Stmt.initNames, Functions.Source.Block.runOpen, hHead,
              ctxHead, compilerHead, List.append_assoc]
              using hRestRun)
      · simpa [compilerHead] using hShared
      · simpa [Functions.Source.Store.initReturns, compilerHead,
          Locals.Source.State.insert] using hVars

theorem source_initReturns_insert_commute_of_not_mem
    {names : List Name} {store : Locals.Source.Store}
    {name : Name} {value : Word}
    (hFresh : name ∉ names) :
    Locals.Source.Store.insert
        (Functions.Source.Store.initReturns names store) name value =
      Functions.Source.Store.initReturns names
        (Locals.Source.Store.insert store name value) := by
  induction names generalizing store with
  | nil =>
      rfl
  | cons head tail ih =>
      unfold Functions.Source.Store.initReturns
      have hTailFresh : name ∉ tail := by
        intro hMem
        exact hFresh (by simp [hMem])
      have hHeadNe : head ≠ name := by
        intro hEq
        exact hFresh (by simp [hEq])
      have hComm :
          Locals.Source.Store.insert
              (Locals.Source.Store.insert store head Functions.Source.zero)
              name value =
            Locals.Source.Store.insert
              (Locals.Source.Store.insert store name value)
              head Functions.Source.zero := by
        exact Functions.Source.Store.insert_comm_of_ne hHeadNe
      rw [ih hTailFresh]
      rw [hComm]

theorem source_insertMany_initReturns_commute_of_disjoint :
    ∀ {names : List Name} {values : List Word}
      {store store' : Locals.Source.Store} {returns : List Name},
      Functions.Source.Store.insertMany names values store = some store' →
        (∀ name, name ∈ names → name ∉ returns) →
          Functions.Source.Store.insertMany names values
              (Functions.Source.Store.initReturns returns store) =
            some (Functions.Source.Store.initReturns returns store')
  | [], [], _store, _store', _returns, hInsert, _hDisjoint => by
      simp [Functions.Source.Store.insertMany] at hInsert
      cases hInsert
      simp [Functions.Source.Store.insertMany]
  | [], _value :: _values, _store, _store', _returns, hInsert,
      _hDisjoint => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | _head :: _tail, [], _store, _store', _returns, hInsert,
      _hDisjoint => by
      simp [Functions.Source.Store.insertMany] at hInsert
  | head :: tail, value :: values, store, store', returns, hInsert,
      hDisjoint => by
      unfold Functions.Source.Store.insertMany at hInsert ⊢
      have hHeadFresh : head ∉ returns := hDisjoint head (by simp)
      have hTailDisjoint :
          ∀ name, name ∈ tail → name ∉ returns := by
        intro name hMem
        exact hDisjoint name (by simp [hMem])
      have hComm :
          Locals.Source.Store.insert
              (Functions.Source.Store.initReturns returns store)
              head value =
            Functions.Source.Store.initReturns returns
              (Locals.Source.Store.insert store head value) :=
        source_initReturns_insert_commute_of_not_mem hHeadFresh
      rw [hComm]
      exact
        source_insertMany_initReturns_commute_of_disjoint
          (names := tail) (values := values)
          (store := Locals.Source.Store.insert store head value)
          (store' := store') (returns := returns) hInsert hTailDisjoint

theorem sourceStoreRel_insertMany_insertPairs
    {layout names : List Name} {values : List Word}
    {store : EvmYul.Yul.VarStore}
    {vars vars' : Locals.Source.Store}
    (hInsert :
      Functions.Source.Store.insertMany names values vars = some vars')
    (hRel : SourceStoreRel layout store vars)
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ layout) :
    SourceStoreRel (names ++ layout)
      (VarStackRel.insertPairs (List.zip names values) store) vars' := by
  induction names generalizing values store vars vars' layout with
  | nil =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.insertMany] at hInsert
          cases hInsert
          simpa [VarStackRel.insertPairs] using hRel
      | cons value values =>
          simp [Functions.Source.Store.insertMany] at hInsert
  | cons head tail ih =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.insertMany] at hInsert
      | cons value values =>
          unfold Functions.Source.Store.insertMany at hInsert
          have hTailNoDup : tail.Nodup := hNoDup.tail
          have hHeadNotMemTail : head ∉ tail := hNoDup.notMem
          have hHeadFreshLayout : head ∉ layout := hFresh head (by simp)
          have hTailFreshLayout :
              ∀ name, name ∈ tail → name ∉ layout := by
            intro name hMem
            exact hFresh name (by simp [hMem])
          have hRelHidden :
              SourceStoreRel layout store
                (Locals.Source.Store.insert vars head value) :=
            sourceStoreRel_insert_hidden hRel hHeadFreshLayout
          have hTailRel :
              SourceStoreRel (tail ++ layout)
                (VarStackRel.insertPairs (List.zip tail values) store)
                vars' :=
            ih hInsert hRelHidden hTailNoDup hTailFreshLayout
          intro query hQuery
          simp only [List.cons_append, List.mem_cons, List.mem_append] at hQuery
          by_cases hEq : query = head
          · subst query
            have hSource :
                vars' head = some value := by
              have hPreserve :=
                source_insertMany_preserves_of_not_mem
                  (names := tail) (wordValues := values)
                  (store := Locals.Source.Store.insert vars head value)
                  (store' := vars') (name := head) hInsert hHeadNotMemTail
              simpa [Locals.Source.Store.insert_self] using hPreserve
            have hTarget :
                (VarStackRel.insertPairs
                    (List.zip (head :: tail) (value :: values)) store).lookup
                  head = some value := by
              simp [VarStackRel.insertPairs]
            rw [hSource, hTarget]
          · have hTailMem : query ∈ tail ++ layout := by
              rcases hQuery with hHead | hRest
              · exact False.elim (hEq hHead)
              · simpa [List.mem_append] using hRest
            have hTailEq := hTailRel query hTailMem
            have hTarget :
                (VarStackRel.insertPairs
                    (List.zip (head :: tail) (value :: values)) store).lookup
                  query =
                (VarStackRel.insertPairs (List.zip tail values) store).lookup
                  query := by
              simp [VarStackRel.insertPairs]
              rw [Finmap.lookup_insert_of_ne]
              exact hEq
            rw [hTarget]
            exact hTailEq

theorem sourceStoreRel_initReturns_insertZeros
    {layout names : List Name}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    (hRel : SourceStoreRel layout store vars)
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ layout) :
    SourceStoreRel (names ++ layout)
      (VarStackRel.insertPairs (VarStackRel.zeroPairs names) store)
      (Functions.Source.Store.initReturns names vars) := by
  induction names generalizing store vars layout with
  | nil =>
      simpa [Functions.Source.Store.initReturns, VarStackRel.zeroPairs,
        VarStackRel.insertPairs] using hRel
  | cons head tail ih =>
      unfold Functions.Source.Store.initReturns
      have hTailNoDup : tail.Nodup := hNoDup.tail
      have hHeadNotMemTail : head ∉ tail := hNoDup.notMem
      have hHeadFreshLayout : head ∉ layout := hFresh head (by simp)
      have hTailFreshLayout :
          ∀ name, name ∈ tail → name ∉ layout := by
        intro name hMem
        exact hFresh name (by simp [hMem])
      have hRelHidden :
          SourceStoreRel layout store
            (Locals.Source.Store.insert vars head Functions.Source.zero) :=
        sourceStoreRel_insert_hidden hRel hHeadFreshLayout
      have hTailRel :
          SourceStoreRel (tail ++ layout)
            (VarStackRel.insertPairs (VarStackRel.zeroPairs tail) store)
            (Functions.Source.Store.initReturns tail
              (Locals.Source.Store.insert vars head Functions.Source.zero)) :=
        ih hRelHidden hTailNoDup hTailFreshLayout
      intro query hQuery
      simp only [List.cons_append, List.mem_cons, List.mem_append] at hQuery
      by_cases hEq : query = head
      · subst query
        have hSource :
            Functions.Source.Store.initReturns tail
                (Locals.Source.Store.insert vars head Functions.Source.zero)
                head =
              some Functions.Source.zero := by
          have hPreserve :=
            source_initReturns_preserves_of_not_mem
              (names := tail)
              (store := Locals.Source.Store.insert vars head
                Functions.Source.zero)
              (name := head) hHeadNotMemTail
          simpa [Locals.Source.Store.insert_self] using hPreserve
        have hTarget :
            (VarStackRel.insertPairs
                (VarStackRel.zeroPairs (head :: tail)) store).lookup head =
              some Functions.Source.zero := by
          simp [VarStackRel.zeroPairs, VarStackRel.insertPairs,
            Functions.Source.zero, VarStackRel.zeroWord]
        rw [hSource, hTarget]
      · have hTailMem : query ∈ tail ++ layout := by
          rcases hQuery with hHead | hRest
          · exact False.elim (hEq hHead)
          · simpa [List.mem_append] using hRest
        have hTailEq := hTailRel query hTailMem
        have hTarget :
            (VarStackRel.insertPairs
                (VarStackRel.zeroPairs (head :: tail)) store).lookup query =
              (VarStackRel.insertPairs (VarStackRel.zeroPairs tail) store).lookup
                query := by
          simp [VarStackRel.zeroPairs, VarStackRel.insertPairs]
          rw [Finmap.lookup_insert_of_ne]
          exact hEq
        rw [hTarget]
        exact hTailEq

/--
Fresh generated return slots remain hidden from the old visible layout until a
source declaration successfully publishes them.
-/
theorem sourceStoreRel_initReturns_hidden
    {layout names : List Name}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    (hRel : SourceStoreRel layout store vars)
    (hFresh : ∀ name, name ∈ names → name ∉ layout) :
    SourceStoreRel layout store
      (Functions.Source.Store.initReturns names vars) := by
  induction names generalizing vars with
  | nil =>
      simpa [Functions.Source.Store.initReturns] using hRel
  | cons head tail ih =>
      unfold Functions.Source.Store.initReturns
      apply ih
      · exact
          sourceStoreRel_insert_hidden hRel
            (hFresh head (by simp))
      · intro name hMem
        exact hFresh name (by simp [hMem])

theorem identName_eq_self (name : EvmYul.Identifier) :
    identName name = name := rfl

theorem identNames_eq_self :
    ∀ names : List EvmYul.Identifier, identNames names = names
  | [] => rfl
  | head :: tail => by
      change identName head :: identNames tail = head :: tail
      rw [identName_eq_self head, identNames_eq_self tail]

theorem StoreDomainExact.multifill_ok_exact_extend
    {layout : List Name}
    {names : List EvmYul.Identifier} {values : List Word}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store)
    (hLen : (identNames names).length ≤ values.length)
    (hFinal :
      EvmYul.Yul.State.multifill names values (.Ok shared store) =
        .Ok sharedAfter storeAfter) :
    StoreDomainExact ((identNames names).reverse ++ layout) storeAfter := by
  have hNames : names = identNames names := (identNames_eq_self names).symm
  rw [hNames] at hFinal
  rw [VarStackRel.multifill_ok] at hFinal
  cases hFinal
  have hRaw :
      StoreDomainExact
        ((List.zip (identNames names) values).map Prod.fst ++ layout)
        (VarStackRel.insertPairs (List.zip (identNames names) values) store) :=
    StoreDomainExact.insertPairs
      (pairs := List.zip (identNames names) values) (layout := layout)
      (store := store) hDomain
  have hMap :
      (List.zip (identNames names) values).map Prod.fst =
        identNames names := by
    simpa using (List.map_fst_zip hLen)
  have hDomainNames :
      StoreDomainExact (identNames names ++ layout)
        (VarStackRel.insertPairs (List.zip (identNames names) values)
          store) := by
    simpa [hMap] using hRaw
  intro query
  constructor
  · intro hSome
    have hMem : query ∈ identNames names ++ layout :=
      (hDomainNames query).mp hSome
    simpa [List.mem_append, List.mem_reverse, or_comm, or_left_comm,
      or_assoc] using hMem
  · intro hMem
    have hMem' : query ∈ identNames names ++ layout := by
      simpa [List.mem_append, List.mem_reverse, or_comm, or_left_comm,
        or_assoc] using hMem
    exact (hDomainNames query).mpr hMem'


theorem initcall_ok_insertPairs
    (shared : EvmYul.SharedState .Yul)
    (callerStore : EvmYul.Yul.VarStore)
    (params rets : List EvmYul.Identifier) (args : List Word) :
    EvmYul.Yul.State.initcall params rets args (.Ok shared callerStore) =
      .Ok shared
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) := by
  simp [EvmYul.Yul.State.initcall, EvmYul.Yul.State.setStore,
    EvmYul.Yul.State.zeroFill]
  change
    EvmYul.Yul.State.multifill params args
      (List.foldr
        (fun name state => EvmYul.Yul.State.insert name VarStackRel.zeroWord state)
        (.Ok shared (default : EvmYul.Yul.VarStore)) rets) =
      .Ok shared
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore)))
  rw [VarStackRel.insertZeros_identifiers_ok]
  have hParams : params = identNames params :=
    (identNames_eq_self params).symm
  conv_lhs =>
    rw [hParams]
  exact
    VarStackRel.multifill_ok shared
      (VarStackRel.insertPairs (VarStackRel.zeroPairs (identNames rets))
        (default : EvmYul.Yul.VarStore))
      (identNames params) args

theorem sourceStateRel_initcall_of_insertMany
    {cfg : StateRelConfig}
    {sharedYul : EvmYul.SharedState .Yul}
    {sharedSource : EvmYul.SharedState .EVM}
    {callerStore : EvmYul.Yul.VarStore}
    {params rets : List EvmYul.Identifier}
    {args : List Word} {paramStore : Locals.Source.Store}
    (hShared : SharedStateRel cfg sharedYul sharedSource)
    (hInsert :
      Functions.Source.Store.insertMany (identNames params) args
        Locals.Source.Store.empty = some paramStore)
    (hParamsNoDup : (identNames params).Nodup)
    (hRetsNoDup : (identNames rets).Nodup)
    (hDisjoint :
      ∀ name, name ∈ identNames params → name ∉ identNames rets) :
    SourceStateRel cfg (identNames rets ++ identNames params)
      (EvmYul.Yul.State.initcall params rets args (.Ok sharedYul callerStore))
      ({ shared := sharedSource,
         vars :=
          Functions.Source.Store.initReturns (identNames rets) paramStore } :
        Objects.Source.State) := by
  let returnStore : Locals.Source.Store :=
    Functions.Source.Store.initReturns (identNames rets)
      Locals.Source.Store.empty
  have hReturnRel :
      SourceStoreRel (identNames rets)
        (VarStackRel.insertPairs
          (VarStackRel.zeroPairs (identNames rets))
          (default : EvmYul.Yul.VarStore))
        returnStore := by
    simpa [returnStore] using
      (sourceStoreRel_initReturns_insertZeros
        (layout := []) (names := identNames rets)
        (store := (default : EvmYul.Yul.VarStore))
        (vars := Locals.Source.Store.empty)
        (sourceStoreRel_nil (default : EvmYul.Yul.VarStore)
          Locals.Source.Store.empty)
        hRetsNoDup
        (by intro name hMem hNil; cases hNil))
  have hInsertAfterReturns :
      Functions.Source.Store.insertMany (identNames params) args returnStore =
        some
          (Functions.Source.Store.initReturns (identNames rets) paramStore) := by
    simpa [returnStore] using
      (source_insertMany_initReturns_commute_of_disjoint
        (names := identNames params) (values := args)
        (store := Locals.Source.Store.empty) (store' := paramStore)
        (returns := identNames rets) hInsert hDisjoint)
  have hParamRel :
      SourceStoreRel (identNames params ++ identNames rets)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore)))
        (Functions.Source.Store.initReturns (identNames rets) paramStore) :=
    sourceStoreRel_insertMany_insertPairs
      (layout := identNames rets) (names := identNames params)
      (values := args)
      (store :=
        VarStackRel.insertPairs (VarStackRel.zeroPairs (identNames rets))
          (default : EvmYul.Yul.VarStore))
      (vars := returnStore)
      (vars' := Functions.Source.Store.initReturns (identNames rets)
        paramStore)
      hInsertAfterReturns hReturnRel hParamsNoDup hDisjoint
  have hLayoutRel :
      SourceStoreRel (identNames rets ++ identNames params)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore)))
        (Functions.Source.Store.initReturns (identNames rets) paramStore) :=
    sourceStoreRel_of_mem_iff hParamRel (by
      intro name
      simp [List.mem_append]
      constructor <;> intro h <;> rcases h with h | h
      · exact Or.inr h
      · exact Or.inl h
      · exact Or.inr h
      · exact Or.inl h)
  rw [initcall_ok_insertPairs]
  exact SourceStateRel.ok hShared hLayoutRel

theorem sourceStateExactRel_initcall_of_insertMany
    {cfg : StateRelConfig}
    {sharedYul : EvmYul.SharedState .Yul}
    {sharedSource : EvmYul.SharedState .EVM}
    {callerStore : EvmYul.Yul.VarStore}
    {params rets : List EvmYul.Identifier}
    {args : List Word} {paramStore : Locals.Source.Store}
    (hShared : SharedStateRel cfg sharedYul sharedSource)
    (hInsert :
      Functions.Source.Store.insertMany (identNames params) args
        Locals.Source.Store.empty = some paramStore)
    (hParamsNoDup : (identNames params).Nodup)
    (hRetsNoDup : (identNames rets).Nodup)
    (hDisjoint :
      ∀ name, name ∈ identNames params → name ∉ identNames rets) :
    SourceStateExactRel cfg (identNames rets ++ identNames params)
      (EvmYul.Yul.State.initcall params rets args (.Ok sharedYul callerStore))
      ({ shared := sharedSource,
         vars :=
          Functions.Source.Store.initReturns (identNames rets) paramStore } :
        Objects.Source.State) := by
  have hRel :
      SourceStateRel cfg (identNames rets ++ identNames params)
        (EvmYul.Yul.State.initcall params rets args
          (.Ok sharedYul callerStore))
        ({ shared := sharedSource,
           vars :=
            Functions.Source.Store.initReturns (identNames rets)
              paramStore } : Objects.Source.State) :=
    sourceStateRel_initcall_of_insertMany
      (cfg := cfg) (sharedYul := sharedYul)
      (sharedSource := sharedSource) (callerStore := callerStore)
      (params := params) (rets := rets) (args := args)
      (paramStore := paramStore) hShared hInsert hParamsNoDup hRetsNoDup
      hDisjoint
  have hArgsLength : (identNames params).length ≤ args.length := by
    have hLen :=
      Functions.Source.Store.insertMany_length
        (names := identNames params) (values := args)
        (store := Locals.Source.Store.empty) (store' := paramStore)
        hInsert
    omega
  have hReturnsDomain :
      StoreDomainExact (identNames rets).reverse
        (VarStackRel.insertPairs
          (VarStackRel.zeroPairs (identNames rets))
          (default : EvmYul.Yul.VarStore)) := by
    simpa using
      (StoreDomainExact.insertZeros
        (names := identNames rets) (layout := [])
        (store := (default : EvmYul.Yul.VarStore))
        StoreDomainExact.empty)
  have hParamsDomainRaw :
      StoreDomainExact
        ((List.zip (identNames params) args).map Prod.fst ++
          (identNames rets).reverse)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) :=
    StoreDomainExact.insertPairs
      (pairs := List.zip (identNames params) args)
      (layout := (identNames rets).reverse)
      (store :=
        VarStackRel.insertPairs (VarStackRel.zeroPairs (identNames rets))
          (default : EvmYul.Yul.VarStore))
      hReturnsDomain
  have hParamsDomain :
      StoreDomainExact (identNames params ++ (identNames rets).reverse)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) := by
    simpa [List.map_fst_zip hArgsLength] using hParamsDomainRaw
  have hDomain :
      StoreDomainExact (identNames rets ++ identNames params)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) :=
    StoreDomainExact.of_mem_iff hParamsDomain (by
      intro name
      simp [List.mem_append, List.mem_reverse, or_comm, or_left_comm,
        or_assoc])
  rw [initcall_ok_insertPairs] at hRel ⊢
  exact SourceStateExactRel.ofRelDomain hRel hDomain

/--
Package the callee-entry relation in the shape needed by open internal
user-call bodies.

After the open argument prelude has related the caller states and the lowered
argument list has inserted parameters into the source function frame, the
callee body starts from exactly the same visible return/parameter layout on
both sides.  This theorem hides the AST/lowered-name transport that older
closed user-call proofs repeated inline.
-/
theorem sourceStateExactRel_initcall_of_lowerFun_insertMany
    {cfg : StateRelConfig} {layout : List Name}
    {sharedYul : EvmYul.SharedState .Yul}
    {callerStore : EvmYul.Yul.VarStore}
    {callerTarget : Objects.Source.State}
    {params rets : List EvmYul.Identifier}
    {args : List Word} {paramStore : Locals.Source.Store}
    {lowerFn : Functions.FunDef}
    (hCaller :
      SourceStateRel cfg layout (.Ok sharedYul callerStore) callerTarget)
    (hInsert :
      Functions.Source.Store.insertMany lowerFn.params args
        Locals.Source.Store.empty = some paramStore)
    (hLowerParams : lowerFn.params = identNames params)
    (hLowerReturns : lowerFn.returns = identNames rets)
    (hParamsNoDup : (identNames params).Nodup)
    (hRetsNoDup : (identNames rets).Nodup)
    (hDisjoint :
      ∀ name, name ∈ identNames params → name ∉ identNames rets) :
    SourceStateExactRel cfg (lowerFn.returns ++ lowerFn.params)
      (EvmYul.Yul.State.mkOk
        (EvmYul.Yul.State.initcall params rets args
          (.Ok sharedYul callerStore)))
      ({ shared := callerTarget.shared,
         vars :=
          Functions.Source.Store.initReturns lowerFn.returns paramStore } :
        Objects.Source.State) := by
  cases hCaller with
  | ok hShared _hVars =>
      have hInsertRaw :
          Functions.Source.Store.insertMany (identNames params) args
              Locals.Source.Store.empty =
            some paramStore := by
        simpa [hLowerParams] using hInsert
      have hInitialRaw :
          SourceStateExactRel cfg
            (identNames rets ++ identNames params)
            (EvmYul.Yul.State.initcall params rets args
              (.Ok sharedYul callerStore))
            ({ shared := callerTarget.shared,
               vars :=
                Functions.Source.Store.initReturns (identNames rets)
                  paramStore } : Objects.Source.State) :=
        sourceStateExactRel_initcall_of_insertMany
          (cfg := cfg) (sharedYul := sharedYul)
          (sharedSource := callerTarget.shared)
          (callerStore := callerStore) (params := params)
          (rets := rets) (args := args) (paramStore := paramStore)
          hShared hInsertRaw hParamsNoDup hRetsNoDup hDisjoint
      simpa [hLowerReturns, hLowerParams, EvmYul.Yul.State.mkOk,
        initcall_ok_insertPairs] using hInitialRaw

/--
Restricting an imported Yul state to a store with exact domain `layout`
produces a state with exact domain `layout`.

This is the source-facing statement of Yul block-scope cleanup: the concrete
state shape may be regular or a structured checkpoint, but the surviving
variable store is exactly the incoming scope store.
-/
theorem StateStoreDomainExact.restrictStoreTo_of_domain
    {layout layoutAfter : List Name}
    {scope : EvmYul.Yul.VarStore} {state : State}
    (hState : StateStoreDomainExact layoutAfter state)
    (hScope : StoreDomainExact layout scope)
    (hSubset : ∀ name, name ∈ layout → name ∈ layoutAfter) :
    StateStoreDomainExact layout
      (EvmYul.Yul.State.restrictStoreTo scope state) := by
  cases state with
  | Ok shared store =>
      simpa [StateStoreDomainExact, EvmYul.Yul.State.restrictStoreTo] using
        (StoreDomainExact.restrictVarStore_of_domain
          (layoutAfter := layoutAfter) (layout := layout)
          (store := store) (scope := scope)
          (by simpa [StateStoreDomainExact] using hState)
          hScope hSubset)
  | OutOfFuel =>
      simp [StateStoreDomainExact, EvmYul.Yul.State.restrictStoreTo]
  | Checkpoint jump =>
      cases jump with
      | Continue shared store =>
          simpa [StateStoreDomainExact, EvmYul.Yul.State.restrictStoreTo] using
            (StoreDomainExact.restrictVarStore_of_domain
              (layoutAfter := layoutAfter) (layout := layout)
              (store := store) (scope := scope)
              (by simpa [StateStoreDomainExact] using hState)
              hScope hSubset)
      | Break shared store =>
          simpa [StateStoreDomainExact, EvmYul.Yul.State.restrictStoreTo] using
            (StoreDomainExact.restrictVarStore_of_domain
              (layoutAfter := layoutAfter) (layout := layout)
              (store := store) (scope := scope)
              (by simpa [StateStoreDomainExact] using hState)
              hScope hSubset)
      | Leave shared store =>
          simpa [StateStoreDomainExact, EvmYul.Yul.State.restrictStoreTo] using
            (StoreDomainExact.restrictVarStore_of_domain
              (layoutAfter := layoutAfter) (layout := layout)
              (store := store) (scope := scope)
              (by simpa [StateStoreDomainExact] using hState)
              hScope hSubset)

theorem StateStoreDomainExact.callRestore
    {layout : List Name} {caller callee : State}
    (hCaller : StateStoreDomainExact layout caller) :
    StateStoreDomainExact layout
      (EvmYul.Yul.State.setStore
        (EvmYul.Yul.State.overwrite?
          (EvmYul.Yul.State.reviveJump callee) caller)
        caller) := by
  cases caller with
  | Ok shared store =>
      cases callee with
      | Ok sharedCallee storeCallee =>
          simpa [StateStoreDomainExact, EvmYul.Yul.State.setStore,
            EvmYul.Yul.State.overwrite?, EvmYul.Yul.State.reviveJump]
            using hCaller
      | OutOfFuel =>
          simp [StateStoreDomainExact, EvmYul.Yul.State.setStore,
            EvmYul.Yul.State.overwrite?, EvmYul.Yul.State.reviveJump]
      | Checkpoint jump =>
          cases jump <;>
            simpa [StateStoreDomainExact, EvmYul.Yul.State.setStore,
              EvmYul.Yul.State.overwrite?, EvmYul.Yul.State.reviveJump,
