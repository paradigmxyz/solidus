/-
Statement/function lowering preserves any fresh-coverage invariant already
held by the incoming fresh state.

This is deliberately stated for an arbitrary `coverLayout`: later callee-body
lookup lemmas instantiate it with the selected function's parameter/return
layout, while dispatcher proofs instantiate it with contract-level source-name
reservations.
-/
mutual
  theorem freshCoversLayout_toFunctionsListFuel?_of_some
      {coverLayout : List Name} {fuel : Nat}
      {state state' : Fresh.State} {stmt : AstStmt}
      {lowerStmts : List Functions.Stmt}
      (hCovers : FreshCoversLayout coverLayout state)
      (hLower :
        Stmt.toFunctionsListFuel? fuel state stmt =
          some (lowerStmts, state')) :
      FreshCoversLayout coverLayout state' := by
    cases fuel with
    | zero =>
        simp [Stmt.toFunctionsListFuel?] at hLower
    | succ fuel =>
        cases stmt with
        | Block body =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            cases hBody : Stmt.List.toBlockFuel? fuel state body with
            | none =>
                simp [hBody] at hLower
            | some bodyResult =>
                rcases bodyResult with ⟨lowerBody, stateAfterBody⟩
                simp [hBody] at hLower
                rcases hLower with ⟨_hLower, hState⟩
                cases hState
                exact
                  freshCoversLayout_toBlockFuel?_of_some hCovers hBody
        | Let names value? =>
            cases value? with
            | none =>
                rw [Stmt.toFunctionsListFuel?.eq_3] at hLower
                cases hLower
                exact hCovers
            | some value =>
                cases value with
                | Call callee args =>
                    cases callee with
                    | inl prim =>
                        cases names with
                        | nil =>
                            simp [Stmt.toFunctionsListFuel?] at hLower
                        | cons name restNames =>
                            cases restNames with
                            | cons second more =>
                                simp [Stmt.toFunctionsListFuel?] at hLower
                            | nil =>
                                cases hLowerExpr :
                                    Expr.lower1? state
                                      (.Call (.inl prim) args) with
                                | none =>
                                    simp [Stmt.toFunctionsListFuel?,
                                      hLowerExpr] at hLower
                                | some exprResult =>
                                    rcases exprResult with
                                      ⟨preValue, lowerValue, stateAfterExpr⟩
                                    cases preValue with
                                    | nil =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hLowerExpr] at hLower
                                        rcases hLower with ⟨_hLower, hState⟩
                                        cases hState
                                        exact
                                          freshCoversLayout_lower1?_of_some
                                            hCovers hLowerExpr
                                    | cons head tail =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hLowerExpr] at hLower
                                        rcases hLower with ⟨_hLower, hState⟩
                                        cases hState
                                        exact
                                          freshCoversLayout_lower1?_of_some
                                            hCovers hLowerExpr
                    | inr functionName =>
                        exact
                          freshCoversLayout_toFunctionsListFuel?_let_user_call_of_some
                            hCovers hLower
                | Lit value =>
                    cases names with
                    | nil =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
                    | cons name restNames =>
                        cases restNames with
                        | cons second more =>
                            simp [Stmt.toFunctionsListFuel?] at hLower
                        | nil =>
                            cases hLowerExpr : Expr.lower1? state (.Lit value) with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                  at hLower
                            | some exprResult =>
                                rcases exprResult with
                                  ⟨preValue, lowerValue, stateAfterExpr⟩
                                cases preValue with
                                | nil =>
                                    simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                      at hLower
                                    rcases hLower with ⟨_hLower, hState⟩
                                    cases hState
                                    exact
                                      freshCoversLayout_lower1?_of_some hCovers
                                        hLowerExpr
                                | cons head tail =>
                                    simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                      at hLower
                                    rcases hLower with ⟨_hLower, hState⟩
                                    cases hState
                                    exact
                                      freshCoversLayout_lower1?_of_some hCovers
                                        hLowerExpr
                | Var name =>
                    cases names with
                    | nil =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
                    | cons target restNames =>
                        cases restNames with
                        | cons second more =>
                            simp [Stmt.toFunctionsListFuel?] at hLower
                        | nil =>
                            cases hLowerExpr : Expr.lower1? state (.Var name) with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                  at hLower
                            | some exprResult =>
                                rcases exprResult with
                                  ⟨preValue, lowerValue, stateAfterExpr⟩
                                cases preValue with
                                | nil =>
                                    simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                      at hLower
                                    rcases hLower with ⟨_hLower, hState⟩
                                    cases hState
                                    exact
                                      freshCoversLayout_lower1?_of_some hCovers
                                        hLowerExpr
                                | cons head tail =>
                                    simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                      at hLower
                                    rcases hLower with ⟨_hLower, hState⟩
                                    cases hState
                                    exact
                                      freshCoversLayout_lower1?_of_some hCovers
                                        hLowerExpr
        | Assign names value =>
            cases value with
            | Call callee args =>
                cases callee with
                | inl prim =>
                    cases names with
                    | nil =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
                    | cons name restNames =>
                        cases restNames with
                        | cons second more =>
                            simp [Stmt.toFunctionsListFuel?] at hLower
                        | nil =>
                            cases hLowerExpr :
                                Expr.lower1? state (.Call (.inl prim) args) with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                  at hLower
                            | some exprResult =>
                                rcases exprResult with
                                  ⟨preValue, lowerValue, stateAfterExpr⟩
                                simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                                  at hLower
                                rcases hLower with ⟨_hLower, hState⟩
                                cases hState
                                exact
                                  freshCoversLayout_lower1?_of_some hCovers
                                    hLowerExpr
                | inr functionName =>
                    exact
                      freshCoversLayout_toFunctionsListFuel?_assign_user_call_of_some
                        hCovers hLower
            | Lit value =>
                cases names with
                | nil =>
                    simp [Stmt.toFunctionsListFuel?] at hLower
                | cons name restNames =>
                    cases restNames with
                    | cons second more =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
                    | nil =>
                        cases hLowerExpr : Expr.lower1? state (.Lit value) with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                              at hLower
                        | some exprResult =>
                            rcases exprResult with
                              ⟨preValue, lowerValue, stateAfterExpr⟩
                            simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                              at hLower
                            rcases hLower with ⟨_hLower, hState⟩
                            cases hState
                            exact
                              freshCoversLayout_lower1?_of_some hCovers
                                hLowerExpr
            | Var name =>
                cases names with
                | nil =>
                    simp [Stmt.toFunctionsListFuel?] at hLower
                | cons target restNames =>
                    cases restNames with
                    | cons second more =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
                    | nil =>
                        cases hLowerExpr : Expr.lower1? state (.Var name) with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                              at hLower
                        | some exprResult =>
                            rcases exprResult with
                              ⟨preValue, lowerValue, stateAfterExpr⟩
                            simp [Stmt.toFunctionsListFuel?, hLowerExpr]
                              at hLower
                            rcases hLower with ⟨_hLower, hState⟩
                            cases hState
                            exact
                              freshCoversLayout_lower1?_of_some hCovers
                                hLowerExpr
        | ExprStmtCall value =>
            cases value with
            | Call callee args =>
                cases callee with
                | inl prim =>
                    cases hTerminal : Prim.terminal? prim with
                    | some kind =>
                        cases hArgs :
                            Expr.List.lowerBound1? state args with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hTerminal,
                              hArgs] at hLower
                        | some argResult =>
                            rcases argResult with ⟨preArgs, lowerArgs, stateAfterArgs⟩
                            cases hSeq :
                                Expr.List.toStackSeq? lowerArgs kind.argCount with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hTerminal,
                                  hArgs, hSeq] at hLower
                            | some seq =>
                                simp [Stmt.toFunctionsListFuel?, hTerminal,
                                  hArgs, hSeq] at hLower
                                rcases hLower with ⟨_hLower, hState⟩
                                cases hState
                                exact
                                  freshCoversLayout_lowerBound1?_of_some
                                    hCovers hArgs
                    | none =>
                        cases hLowerExpr :
                            Expr.lower0? state (.Call (.inl prim) args) with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hTerminal,
                              hLowerExpr] at hLower
                        | some exprResult =>
                            rcases exprResult with ⟨pre, lower, stateAfterExpr⟩
                            simp [Stmt.toFunctionsListFuel?, hTerminal,
                              hLowerExpr] at hLower
                            rcases hLower with ⟨_hLower, hState⟩
                            cases hState
                            exact
                              freshCoversLayout_lower0?_of_some hCovers
                                hLowerExpr
                | inr functionName =>
                    exact
                      freshCoversLayout_toFunctionsListFuel?_expr_user_call_of_some
                        hCovers hLower
            | Lit value =>
                cases hLowerExpr : Expr.lower0? state (.Lit value) with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hLowerExpr] at hLower
                | some exprResult =>
                    rcases exprResult with ⟨pre, lower, stateAfterExpr⟩
                    simp [Stmt.toFunctionsListFuel?, hLowerExpr] at hLower
                    rcases hLower with ⟨_hLower, hState⟩
                    cases hState
                    exact
                      freshCoversLayout_lower0?_of_some hCovers hLowerExpr
            | Var name =>
                cases hLowerExpr : Expr.lower0? state (.Var name) with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hLowerExpr] at hLower
                | some exprResult =>
                    rcases exprResult with ⟨pre, lower, stateAfterExpr⟩
                    simp [Stmt.toFunctionsListFuel?, hLowerExpr] at hLower
                    rcases hLower with ⟨_hLower, hState⟩
                    cases hState
                    exact
                      freshCoversLayout_lower0?_of_some hCovers hLowerExpr
        | Switch scrutinee cases defaultBody =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            cases hScrutinee : Expr.lower1? state scrutinee with
            | none =>
                simp [hScrutinee] at hLower
            | some scrutineeResult =>
                rcases scrutineeResult with ⟨preScrutinee, lowerScrutinee, stateAfterScrutinee⟩
                have hCoversScrutinee :
                    FreshCoversLayout coverLayout stateAfterScrutinee :=
                  freshCoversLayout_lower1?_of_some hCovers hScrutinee
                cases hCases :
                    Stmt.CaseList.toFunctionsFuel? fuel stateAfterScrutinee
                      cases with
                | none =>
                    simp [hScrutinee, hCases] at hLower
                | some casesResult =>
                    rcases casesResult with ⟨lowerCases, stateAfterCases⟩
                    have hCoversCases :
                        FreshCoversLayout coverLayout stateAfterCases :=
                      freshCoversLayout_caseListToFunctionsFuel?_of_some
                        hCoversScrutinee hCases
                    cases defaultBody with
                    | nil =>
                        simp [hScrutinee, hCases] at hLower
                        rcases hLower with ⟨_hLower, hState⟩
                        cases hState
                        exact hCoversCases
                    | cons defaultHead defaultTail =>
                        cases hDefault :
                            Stmt.List.toBlockFuel? fuel stateAfterCases
                              (defaultHead :: defaultTail) with
                        | none =>
                            simp [hScrutinee, hCases, hDefault] at hLower
                        | some defaultResult =>
                            rcases defaultResult with
                              ⟨lowerDefault, stateAfterDefault⟩
                            simp [hScrutinee, hCases, hDefault] at hLower
                            rcases hLower with ⟨_hLower, hState⟩
                            cases hState
                            exact
                              freshCoversLayout_toBlockFuel?_of_some
                                hCoversCases hDefault
        | For cond post body =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            cases hCond : Expr.lower1? state cond with
            | none =>
                simp [hCond] at hLower
            | some condResult =>
                rcases condResult with ⟨preCond, lowerCond, stateAfterCond⟩
                have hCoversCond :
                    FreshCoversLayout coverLayout stateAfterCond :=
                  freshCoversLayout_lower1?_of_some hCovers hCond
                cases hPost :
                    Stmt.List.toBlockFuel? fuel stateAfterCond post with
                | none =>
                    simp [hCond, hPost] at hLower
                | some postResult =>
                    rcases postResult with ⟨lowerPost, stateAfterPost⟩
                    have hCoversPost :
                        FreshCoversLayout coverLayout stateAfterPost :=
                      freshCoversLayout_toBlockFuel?_of_some hCoversCond
                        hPost
                    cases hBody :
                        Stmt.List.toBlockFuel? fuel stateAfterPost body with
                    | none =>
                        simp [hCond, hPost, hBody] at hLower
                    | some bodyResult =>
                        rcases bodyResult with ⟨lowerBody, stateAfterBody⟩
                        simp [hCond, hPost, hBody] at hLower
                        rcases hLower with ⟨_hLower, hState⟩
                        cases hState
                        exact
                          freshCoversLayout_toBlockFuel?_of_some
                            hCoversPost hBody
        | If cond body =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            cases hCond : Expr.lower1? state cond with
            | none =>
                simp [hCond] at hLower
            | some condResult =>
                rcases condResult with ⟨preCond, lowerCond, stateAfterCond⟩
                have hCoversCond :
                    FreshCoversLayout coverLayout stateAfterCond :=
                  freshCoversLayout_lower1?_of_some hCovers hCond
                cases hBody :
                    Stmt.List.toBlockFuel? fuel stateAfterCond body with
                | none =>
                    simp [hCond, hBody] at hLower
                | some bodyResult =>
                    rcases bodyResult with ⟨lowerBody, stateAfterBody⟩
                    simp [hCond, hBody] at hLower
                    rcases hLower with ⟨_hLower, hState⟩
                    cases hState
                    exact
                      freshCoversLayout_toBlockFuel?_of_some hCoversCond
                        hBody
        | Continue =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            rcases hLower with ⟨_hLower, hState⟩
            cases hState
            exact hCovers
        | Break =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            rcases hLower with ⟨_hLower, hState⟩
            cases hState
            exact hCovers
        | Leave =>
            simp [Stmt.toFunctionsListFuel?] at hLower
            rcases hLower with ⟨_hLower, hState⟩
            cases hState
            exact hCovers

  theorem freshCoversLayout_listToFunctionsFuel?_of_some
      {coverLayout : List Name} {fuel : Nat}
      {state state' : Fresh.State} {stmts : List AstStmt}
      {lowerStmts : List Functions.Stmt}
      (hCovers : FreshCoversLayout coverLayout state)
      (hLower :
        Stmt.List.toFunctionsFuel? fuel state stmts =
          some (lowerStmts, state')) :
      FreshCoversLayout coverLayout state' := by
    cases fuel with
    | zero =>
        simp [Stmt.List.toFunctionsFuel?] at hLower
    | succ fuel =>
        cases stmts with
        | nil =>
            simp only [Stmt.List.toFunctionsFuel?] at hLower
            cases hLower
            exact hCovers
        | cons head rest =>
            simp [Stmt.List.toFunctionsFuel?] at hLower
            cases hHead :
                Stmt.toFunctionsListFuel? fuel state head with
            | none =>
                simp [hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨lowerHead, stateAfterHead⟩
                have hCoversHead :
                    FreshCoversLayout coverLayout stateAfterHead :=
                  freshCoversLayout_toFunctionsListFuel?_of_some
                    hCovers hHead
                cases hRest :
                    Stmt.List.toFunctionsFuel? fuel stateAfterHead rest with
                | none =>
                    simp [hHead, hRest] at hLower
                | some restResult =>
                    rcases restResult with ⟨lowerRest, stateAfterRest⟩
                    simp [hHead, hRest] at hLower
                    rcases hLower with ⟨_hLower, hState⟩
                    cases hState
                    exact
                      freshCoversLayout_listToFunctionsFuel?_of_some
                        hCoversHead hRest

  theorem freshCoversLayout_caseListToFunctionsFuel?_of_some
      {coverLayout : List Name} {fuel : Nat}
      {state state' : Fresh.State}
      {cases : List (Word × List AstStmt)}
      {lowerCases : List (Word × Functions.Block)}
      (hCovers : FreshCoversLayout coverLayout state)
      (hLower :
        Stmt.CaseList.toFunctionsFuel? fuel state cases =
          some (lowerCases, state')) :
      FreshCoversLayout coverLayout state' := by
    cases fuel with
    | zero =>
        simp [Stmt.CaseList.toFunctionsFuel?] at hLower
    | succ fuel =>
        cases cases with
        | nil =>
            simp only [Stmt.CaseList.toFunctionsFuel?] at hLower
            cases hLower
            exact hCovers
        | cons head rest =>
            rcases head with ⟨value, body⟩
            simp [Stmt.CaseList.toFunctionsFuel?] at hLower
            cases hBody : Stmt.List.toBlockFuel? fuel state body with
            | none =>
                simp [hBody] at hLower
            | some bodyResult =>
                rcases bodyResult with ⟨lowerBody, stateAfterBody⟩
                have hCoversBody :
                    FreshCoversLayout coverLayout stateAfterBody :=
                  freshCoversLayout_toBlockFuel?_of_some hCovers hBody
                cases hRest :
                    Stmt.CaseList.toFunctionsFuel? fuel stateAfterBody rest with
                | none =>
                    simp [hBody, hRest] at hLower
                | some restResult =>
                    rcases restResult with ⟨lowerRest, stateAfterRest⟩
                    simp [hBody, hRest] at hLower
                    rcases hLower with ⟨_hLower, hState⟩
                    cases hState
                    exact
                      freshCoversLayout_caseListToFunctionsFuel?_of_some
                        hCoversBody hRest

  theorem freshCoversLayout_toBlockFuel?_of_some
      {coverLayout : List Name} {fuel : Nat}
      {state state' : Fresh.State} {stmts : List AstStmt}
      {lowerBlock : Functions.Block}
      (hCovers : FreshCoversLayout coverLayout state)
      (hLower :
        Stmt.List.toBlockFuel? fuel state stmts =
          some (lowerBlock, state')) :
      FreshCoversLayout coverLayout state' := by
    cases fuel with
    | zero =>
        simp [Stmt.List.toBlockFuel?] at hLower
    | succ fuel =>
        simp [Stmt.List.toBlockFuel?] at hLower
        cases hStmts :
            Stmt.List.toFunctionsFuel? fuel state stmts with
        | none =>
            simp [hStmts] at hLower
        | some stmtResult =>
            rcases stmtResult with ⟨lowerStmts, stateAfterStmts⟩
            simp [hStmts] at hLower
            rcases hLower with ⟨_hLower, hState⟩
            cases hState
            exact
              freshCoversLayout_listToFunctionsFuel?_of_some hCovers hStmts
end

abbrev SwitchSelectedLoweringWithCover
    (coverLayout : List Name)
    (value : Word) (defaultBody : List AstStmt)
    (cases : List (Word × List AstStmt))
    (lowerCases : List (Word × Functions.Block))
    (lowerDefault : Option Functions.Block)
    (lowerBody : Functions.Block) : Prop :=
  ∃ selectedBody : List AstStmt,
    EvmYul.Yul.selectSwitchCase value defaultBody cases = selectedBody ∧
    Functions.Switch.select value lowerCases lowerDefault = some lowerBody ∧
    ∃ (bodyFuel : Nat) (bodyState bodyState' : Fresh.State),
      FreshCoversLayout coverLayout bodyState ∧
      Stmt.List.toBlockFuel? bodyFuel bodyState selectedBody =
        some (lowerBody, bodyState')

theorem switchSelectedLoweringWithCover_of_caseList_select_some_none
    {coverLayout : List Name} {fuel : Nat} {state : Fresh.State}
    {cases : List (Word × List AstStmt)}
    {lowerCases : List (Word × Functions.Block)}
    {state' : Fresh.State} {value : Word}
    {selectedLower : Functions.Block}
    (hCovers : FreshCoversLayout coverLayout state)
    (hCases :
      Stmt.CaseList.toFunctionsFuel? fuel state cases =
        some (lowerCases, state'))
    (hTargetSelect :
      Functions.Switch.select value lowerCases none = some selectedLower) :
    SwitchSelectedLoweringWithCover coverLayout value [] cases lowerCases none
      selectedLower := by
  induction cases generalizing fuel state lowerCases state' selectedLower with
  | nil =>
      cases fuel with
      | zero =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
      | succ fuel =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
          rcases hCases with ⟨hLowerCases, hStateEq⟩
          subst lowerCases
          subst state'
          change none = some selectedLower at hTargetSelect
          cases hTargetSelect
  | cons head rest ih =>
      rcases head with ⟨headValue, headBody⟩
      cases fuel with
      | zero =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
      | succ fuel =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
          cases hBody :
              Stmt.List.toBlockFuel? fuel state headBody with
          | none =>
              simp [hBody] at hCases
          | some compiledBody =>
              rcases compiledBody with ⟨lowerHead, stateAfterBody⟩
              have hCoversBody :
                  FreshCoversLayout coverLayout stateAfterBody :=
                freshCoversLayout_toBlockFuel?_of_some hCovers hBody
              cases hRest :
                  Stmt.CaseList.toFunctionsFuel? fuel stateAfterBody rest with
              | none =>
                  simp [hBody, hRest] at hCases
              | some compiledRest =>
                  rcases compiledRest with ⟨lowerRest, stateAfterRest⟩
                  simp [hBody, hRest] at hCases
                  rcases hCases with ⟨hLowerCases, hStateEq⟩
                  subst lowerCases
                  subst state'
                  have hTargetSelectHead :
                      Functions.Switch.select value
                          ((headValue, lowerHead) :: lowerRest) none =
                        some selectedLower := by
                    simpa using hTargetSelect
                  by_cases hEq : headValue = value
                  · have hLowerEq : lowerHead = selectedLower := by
                      simpa [Functions.Switch.select, hEq] using
                        hTargetSelectHead
                    subst selectedLower
                    refine
                      ⟨headBody, ?_, hTargetSelectHead, fuel, state,
                        stateAfterBody, hCovers, ?_⟩
                    · simp [EvmYul.Yul.selectSwitchCase, hEq]
                    · exact hBody
                  · have hRestSelect :
                        Functions.Switch.select value lowerRest none =
                          some selectedLower := by
                      simpa [Functions.Switch.select, hEq] using
                        hTargetSelectHead
                    rcases ih hCoversBody hRest hRestSelect with
                      ⟨selectedBody, hSourceSelect, hSelectedTarget,
                        bodyFuel, bodyState, bodyState', hBodyCovers,
                        hBodyLowering⟩
                    refine
                      ⟨selectedBody, ?_, hTargetSelectHead, bodyFuel, bodyState,
                        bodyState', hBodyCovers, hBodyLowering⟩
                    simp [EvmYul.Yul.selectSwitchCase, hEq, hSourceSelect]

theorem switchSelectedLoweringWithCover_of_caseList_select_some_some
    {coverLayout : List Name} {fuel defaultFuel : Nat}
    {state : Fresh.State}
    {cases : List (Word × List AstStmt)}
    {lowerCases : List (Word × Functions.Block)}
    {stateCases : Fresh.State} {value : Word}
    {defaultBody : List AstStmt} {lowerDefault : Functions.Block}
    {stateDefault : Fresh.State} {selectedLower : Functions.Block}
    (hCovers : FreshCoversLayout coverLayout state)
    (hCases :
      Stmt.CaseList.toFunctionsFuel? fuel state cases =
        some (lowerCases, stateCases))
    (hDefault :
      Stmt.List.toBlockFuel? defaultFuel stateCases defaultBody =
        some (lowerDefault, stateDefault))
    (hTargetSelect :
      Functions.Switch.select value lowerCases (some lowerDefault) =
        some selectedLower) :
    SwitchSelectedLoweringWithCover coverLayout value defaultBody cases
      lowerCases (some lowerDefault) selectedLower := by
  induction cases generalizing fuel state lowerCases stateCases
      defaultFuel stateDefault lowerDefault selectedLower with
  | nil =>
      cases fuel with
      | zero =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
      | succ fuel =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
          rcases hCases with ⟨hLowerCases, hStateEq⟩
          subst lowerCases
          subst stateCases
          have hLowerEq : lowerDefault = selectedLower := by
            simpa [Functions.Switch.select] using hTargetSelect
          subst selectedLower
          refine
            ⟨defaultBody, ?_, hTargetSelect, defaultFuel, state,
              stateDefault, hCovers, hDefault⟩
          simp [EvmYul.Yul.selectSwitchCase]
  | cons head rest ih =>
      rcases head with ⟨headValue, headBody⟩
      cases fuel with
      | zero =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
      | succ fuel =>
          simp [Stmt.CaseList.toFunctionsFuel?] at hCases
          cases hBody :
              Stmt.List.toBlockFuel? fuel state headBody with
          | none =>
              simp [hBody] at hCases
          | some compiledBody =>
              rcases compiledBody with ⟨lowerHead, stateAfterBody⟩
              have hCoversBody :
                  FreshCoversLayout coverLayout stateAfterBody :=
                freshCoversLayout_toBlockFuel?_of_some hCovers hBody
              cases hRest :
                  Stmt.CaseList.toFunctionsFuel? fuel stateAfterBody rest with
              | none =>
                  simp [hBody, hRest] at hCases
              | some compiledRest =>
                  rcases compiledRest with ⟨lowerRest, stateAfterRest⟩
                  simp [hBody, hRest] at hCases
                  rcases hCases with ⟨hLowerCases, hStateEq⟩
                  subst lowerCases
                  subst stateCases
                  have hTargetSelectHead :
                      Functions.Switch.select value
                          ((headValue, lowerHead) :: lowerRest)
                          (some lowerDefault) =
                        some selectedLower := by
                    simpa using hTargetSelect
                  by_cases hEq : headValue = value
                  · have hLowerEq : lowerHead = selectedLower := by
                      simpa [Functions.Switch.select, hEq] using
                        hTargetSelectHead
                    subst selectedLower
                    refine
                      ⟨headBody, ?_, hTargetSelectHead, fuel, state,
                        stateAfterBody, hCovers, ?_⟩
                    · simp [EvmYul.Yul.selectSwitchCase, hEq]
                    · exact hBody
                  · have hRestSelect :
                        Functions.Switch.select value lowerRest
                            (some lowerDefault) =
                          some selectedLower := by
                      simpa [Functions.Switch.select, hEq] using
                        hTargetSelectHead
                    rcases ih hCoversBody hRest hDefault hRestSelect with
                      ⟨selectedBody, hSourceSelect, hSelectedTarget,
                        bodyFuel, bodyState, bodyState', hBodyCovers,
                        hBodyLowering⟩
                    refine
                      ⟨selectedBody, ?_, hTargetSelectHead, bodyFuel, bodyState,
                        bodyState', hBodyCovers, hBodyLowering⟩
                    simp [EvmYul.Yul.selectSwitchCase, hEq, hSourceSelect]

theorem freshCoversLayout_toFunDefFuel?_of_some
    {coverLayout : List Name} {fuel : Nat}
    {state state' : Fresh.State} {functionName : Name}
    {fn : AstFunctionDefinition} {lowerFn : Functions.FunDef}
    (hCovers : FreshCoversLayout coverLayout state)
    (hLower :
      FunctionDefinition.toFunDefFuel? fuel state functionName fn =
        some (lowerFn, state')) :
    FreshCoversLayout coverLayout state' := by
  cases fn with
  | Def params returns body =>
      cases hBody : Stmt.List.toBlockFuel? fuel state body with
      | none =>
          simp [FunctionDefinition.toFunDefFuel?, hBody] at hLower
      | some bodyResult =>
          rcases bodyResult with ⟨lowerBody, stateAfterBody⟩
          simp [FunctionDefinition.toFunDefFuel?, hBody] at hLower
          rcases hLower with ⟨_hLower, hState⟩
          cases hState
          exact freshCoversLayout_toBlockFuel?_of_some hCovers hBody

theorem freshCoversLayout_toFunDefsFuel?_of_some
    {coverLayout : List Name} {fuel : Nat}
    {state state' : Fresh.State}
    {entries : List (Name × AstFunctionDefinition)}
    {functions : List Functions.FunDef}
    (hCovers : FreshCoversLayout coverLayout state)
    (hLower :
      FunctionList.toFunDefsFuel? fuel state entries =
        some (functions, state')) :
    FreshCoversLayout coverLayout state' := by
  induction entries generalizing state state' functions with
  | nil =>
      simp [FunctionList.toFunDefsFuel?] at hLower
      rcases hLower with ⟨_hFunctions, hState⟩
      cases hState
      exact hCovers
  | cons entry rest ih =>
      rcases entry with ⟨functionName, fn⟩
      cases hHead :
          FunctionDefinition.toFunDefFuel? fuel state functionName fn with
      | none =>
          simp [FunctionList.toFunDefsFuel?, hHead] at hLower
      | some headResult =>
          rcases headResult with ⟨lowerHead, stateAfterHead⟩
          have hCoversHead :
              FreshCoversLayout coverLayout stateAfterHead :=
            freshCoversLayout_toFunDefFuel?_of_some hCovers hHead
          cases hRest :
              FunctionList.toFunDefsFuel? fuel stateAfterHead rest with
          | none =>
              simp [FunctionList.toFunDefsFuel?, hHead, hRest] at hLower
          | some restResult =>
              rcases restResult with ⟨lowerRest, stateAfterRest⟩
              simp [FunctionList.toFunDefsFuel?, hHead, hRest] at hLower
              rcases hLower with ⟨_hLower, hState⟩
              cases hState
              exact ih hCoversHead hRest

