                  { stmts :=
                      [Functions.Stmt.call (identNames names) functionName
                        lowerArgs] }
                  compilerAfterPre =
                .ok
                  (Functions.Source.Outcome.halt kind compilerAfterCall,
                    ctxAfterCall) ∧
              SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
                sourceResult
                (Functions.Source.Outcome.halt kind compilerAfterCall)) :
    SourceResultBlockSoundWhenAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel
      [.Let names (some (.Call (.inr functionName) args))] codeOverride
      { stmts := Stmt.initNames (identNames names) ++ pre ++
          [Functions.Stmt.call (identNames names) functionName lowerArgs] }
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hCall hInitial hAllow hSource with
    ⟨sourceAfterArgs, argValues, hArgEval, hCallAfterArgs⟩
  cases hInitial with
  | @ok shared store compiler hShared hVars =>
      rcases
          functions_source_initNames_runOpen_regular
            (prim := prim) (program := program) (ctx := ctx)
            (compiler := compiler) (identNames names) hNoDup
            (by
              intro name hMem hCtx
              exact hFresh name hMem (by simpa [hScope] using hCtx)) with
        ⟨compilerAfterInit, hInitRun, hInitShared, hInitPreserve⟩
      have hRelInitial :
          SourceStateRel cfg layout (.Ok shared store) compiler :=
        SourceStateRel.ok hShared hVars
      have hRelInit :
          SourceStateRel cfg layout (.Ok shared store) compilerAfterInit := by
        refine SourceStateRel.ok ?_ ?_
        · simpa [hInitShared] using hShared
        · intro name hMem
          have hCtxMem : name ∈ ctx.scope := by
            simpa [hScope] using hMem
          rw [hInitPreserve name hCtxMem]
          exact hVars name hMem
      rcases hArgs.2 hRelInit hArgEval with
        ⟨compilerAfterPre, compilerAfterArgs, ctxAfterPre, preFuel, hPreRun,
          hArgsRun, hRelArgs⟩
      rcases hCallAfterArgs hRelInit hPreRun hArgsRun hRelArgs with
        ⟨kind, compilerAfterCall, ctxAfterCall, callFuel, hCallRun,
          hOutcomeRel⟩
      rcases
          Functions.Source.Block.runOpen_append_regular_exists prim program
            pre
            [Functions.Stmt.call (identNames names) functionName lowerArgs]
            { ctx with scope := (identNames names).reverse ++ ctx.scope }
            ctxAfterPre compilerAfterInit compilerAfterPre
            (Functions.Source.Outcome.halt kind compilerAfterCall)
            ctxAfterCall ⟨preFuel, hPreRun⟩ ⟨callFuel, hCallRun⟩ with
