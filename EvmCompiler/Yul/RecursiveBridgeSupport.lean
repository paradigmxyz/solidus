                              (.Leave shared store)).initcall
                              f.params f.rets args) with
                        | Except.error e => Except.error e
                        | Except.ok s2 =>
                            Except.ok
                              ((s2.reviveJump.overwrite?
                                  (EvmYul.Yul.State.Checkpoint
                                    (.Leave shared store))).setStore
                                  (EvmYul.Yul.State.Checkpoint
                                    (.Leave shared store)),
                                List.map s2.lookup! f.rets)) =
                        Except.ok (stateAfter, values) at h
                      cases hExec :
                          EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                            (👌 (EvmYul.Yul.State.Checkpoint
                              (.Leave shared store)).initcall
                              f.params f.rets args) with
                      | error e => simp [hExec] at h
                      | ok s2 =>
                          simp [hExec, EvmYul.Yul.State.overwrite?,
                            EvmYul.Yul.State.setStore] at h
                          rcases h with ⟨hStateAfter, _hValues⟩
                          subst stateAfter
                          simpa [StateStoreDomainExact] using hDomain
                  | some fname' =>
                      cases hLookup :
                          (codeOverride.getD yulContract.code).functions.lookup fname' with
                      | none => simp [hLookup] at h
                      | some f =>
                          simp [hLookup] at h
                          cases hExec :
                              EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                                (👌 (EvmYul.Yul.State.Checkpoint
                                  (.Leave shared store)).initcall
                                  f.params f.rets args) with
                          | error e => simp [hExec] at h
                          | ok s2 =>
                              simp [hExec, EvmYul.Yul.State.overwrite?,
                                EvmYul.Yul.State.setStore] at h
                              rcases h with ⟨hStateAfter, _hValues⟩
                              subst stateAfter
                              simpa [StateStoreDomainExact] using hDomain

theorem execCall_user_ok_domain_exact_of_arg_domain
    {layout : List Name}
    {fuel : Nat} {sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {storeArgs storeAfter : EvmYul.Yul.VarStore}
    {argValues : List Word} {functionName : Name}
    {targets : List EvmYul.Identifier}
    {codeOverride : Option AstContract}
    (hDomainArgs : StoreDomainExact layout storeArgs)
    (hTargets : ∀ name, name ∈ identNames targets → name ∈ layout)
    (hExecCall :
      EvmYul.Yul.execCall fuel functionName targets codeOverride
        (.ok (.Ok sharedArgs storeArgs, argValues)) =
      .ok (.Ok sharedAfter storeAfter)) :
    StoreDomainExact layout storeAfter := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.execCall] at hExecCall
  | succ callFuel =>
      have hExecCall' :
          EvmYul.Yul.multifill' targets
              (EvmYul.Yul.call callFuel argValues (some functionName)
                codeOverride (.Ok sharedArgs storeArgs)) =
            .ok (.Ok sharedAfter storeAfter) := by
        simpa [EvmYul.Yul.execCall] using hExecCall
      cases hCall :
          EvmYul.Yul.call callFuel argValues (some functionName)
            codeOverride (.Ok sharedArgs storeArgs) with
      | error err =>
          simp [hCall, EvmYul.Yul.multifill'] at hExecCall'
      | ok pair =>
          rcases pair with ⟨stateAfterCall, returnValues⟩
          have hDomainCall :
              StateStoreDomainExact layout stateAfterCall :=
            call_ok_state_domain_exact
              (layout := layout) (fuel := callFuel)
              (shared := sharedArgs) (store := storeArgs)
              (stateAfter := stateAfterCall) (args := argValues)
              (values := returnValues) (fname := some functionName)
              (codeOverride := codeOverride) hDomainArgs hCall
          have hDomainFilled :
              StateStoreDomainExact layout
                (EvmYul.Yul.State.multifill targets returnValues
                  stateAfterCall) :=
            StateStoreDomainExact.multifill_mem hDomainCall hTargets
          have hFilledEq :
              EvmYul.Yul.State.multifill targets returnValues
                  stateAfterCall =
                .Ok sharedAfter storeAfter := by
            simpa [EvmYul.Yul.multifill', hCall] using hExecCall'
          simpa [hFilledEq, StateStoreDomainExact] using hDomainFilled

theorem storeDomainExact_declared_of_checkAssignment_ok
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {names : List EvmYul.Identifier}
    (hDomain : StoreDomainExact layout store)
    (hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) names = .ok ()) :
    ∀ name, name ∈ identNames names → name ∈ layout := by
  have hUndeclared :
      EvmYul.Yul.firstUndeclared? (.Ok shared store) names = none := by
    unfold EvmYul.Yul.checkAssignment at hCheck
    cases hDup : EvmYul.Yul.firstDuplicate? names with
    | none =>
        simp [hDup] at hCheck
        cases hUndeclared :
            EvmYul.Yul.firstUndeclared? (.Ok shared store) names with
        | none =>
            rfl
        | some name =>
            simp [hUndeclared] at hCheck
    | some name =>
        simp [hDup] at hCheck
  intro name hMem
  have hNameMem : name ∈ names := by
    simpa [identNames, identName] using hMem
  unfold EvmYul.Yul.firstUndeclared? at hUndeclared
  have hDeclared :=
    (List.find?_eq_none.mp hUndeclared) name hNameMem
  cases hLookup : EvmYul.Yul.State.lookup? name (.Ok shared store) with
  | none =>
      simp [hLookup] at hDeclared
  | some value =>
      have hStoreLookup :
          store.lookup (identName name) = some value := by
        simpa [EvmYul.Yul.State.lookup?, identName] using hLookup
      have hSome : (store.lookup (identName name)).isSome = true := by
        simp [hStoreLookup]
      simpa [identName] using (hDomain (identName name)).mp hSome

theorem sourceAssignTargets_contains_of_checkAssignment_runOpen_argList
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {lowerArgs : List (Locals.Expr 1)} {argValues : List Word}
    {names : List EvmYul.Identifier}
    (hCtx : SourceCtxKeepsLayout (identNames names) ctx)
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) names = .ok ())
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel block compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter))
    (hArgs :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues)) :
    ∀ name, name ∈ identNames names →
      compilerAfterArgs.vars.contains name = true := by
  have hTargets :
      ∀ name, name ∈ identNames names → name ∈ layout := by
    cases hInitial with
    | ok _hShared _hVars hDomain =>
        exact
          storeDomainExact_declared_of_checkAssignment_ok
            (shared := shared) (store := store) (names := names)
            hDomain hCheck
  have hContains :
      SourceVarsContains (identNames names) compilerAfterArgs.vars :=
    SourceVarsContains.of_runOpen_regular_argList_eval_of_initial_exact
      (cfg := cfg) (layout := layout) (targetLayout := identNames names)
      (prim := prim) (program := program) (ctx := ctx)
      (ctxAfter := ctxAfter) (fuel := fuel) (block := block)
      (shared := shared) (store := store) (state := compiler)
      (stateAfterPre := compilerAfterPre)
      (stateAfterArgs := compilerAfterArgs) (args := lowerArgs)
      (values := argValues) hTargets hCtx hInitial hRun hArgs
  exact hContains

theorem call_ok_state_contains_of_state
    {layout : List Name}
    {fuel : Nat} {state stateAfter : State} {args values : List Word}
    {fname : Option EvmYul.Yul.Ast.YulFunctionName}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (hContains : StateStoreContains layout state)
    (h :
      EvmYul.Yul.call fuel args fname codeOverride state =
        .ok (stateAfter, values)) :
    StateStoreContains layout stateAfter := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.call] at h
  | succ fuel =>
      simp [EvmYul.Yul.call] at h
      cases hFind :
          (EvmYul.Yul.State.sharedState state).accountMap.find?
            (EvmYul.Yul.State.executionEnv state).codeOwner with
      | none =>
          simp [hFind] at h
      | some yulContract =>
          simp [hFind] at h
          cases fname with
          | none =>
              let f : EvmYul.Yul.Ast.FunctionDefinition :=
                .Def [] [] [(codeOverride.getD yulContract.code).dispatcher]
              change
                (match EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                    (👌 state.initcall f.params f.rets args) with
                  | Except.error e => Except.error e
                  | Except.ok s2 =>
                      Except.ok
                        ((s2.reviveJump.overwrite? state).setStore state,
                          List.map s2.lookup! f.rets)) =
                Except.ok (stateAfter, values) at h
              cases hExec :
                  EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                    (👌 state.initcall f.params f.rets args) with
              | error e =>
                  simp [hExec] at h
              | ok s2 =>
                  simp [hExec] at h
                  rcases h with ⟨hStateAfter, _hValues⟩
                  subst stateAfter
                  exact StateStoreContains.callRestore hContains
          | some fname' =>
              cases hLookup :
                  (codeOverride.getD yulContract.code).functions.lookup fname' with
              | none =>
                  simp [hLookup] at h
              | some f =>
                  simp [hLookup] at h
                  cases hExec :
                      EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                        (👌 state.initcall f.params f.rets args) with
                  | error e =>
                      simp [hExec] at h
                  | ok s2 =>
                      simp [hExec] at h
                      rcases h with ⟨hStateAfter, _hValues⟩
                      subst stateAfter
                      exact StateStoreContains.callRestore hContains

def SourceResultStoreContains (layout : List Name) :
    Except Exception State → Prop
  | .error _ => True
  | .ok state => StateStoreContains layout state

def SourcePairResultStoreContains (layout : List Name) {α : Type} :
    Except Exception (State × α) → Prop
  | .error _ => True
  | .ok (state, _) => StateStoreContains layout state

namespace SourcePairResultStoreContains

theorem ok {layout : List Name} {α : Type} {state : State} {value : α}
    (hState : StateStoreContains layout state) :
    SourcePairResultStoreContains layout (.ok (state, value)) := by
  simpa [SourcePairResultStoreContains] using hState

