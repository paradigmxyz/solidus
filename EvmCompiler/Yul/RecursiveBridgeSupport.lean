-/
theorem checkedSeqLoweringSoundWhenFreshNamesAtCompileFuelExact_cons_regular_stmt_single
    {cfg : StateRelConfig}
    {reserved layout layoutMid ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
