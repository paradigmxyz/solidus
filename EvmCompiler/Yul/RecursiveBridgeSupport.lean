/--
Selected source path for the nonzero-condition/body-break loop branch.

The condition trace resolves through `evalValues`; after the singleton
condition value is known to be nonzero, the body trace is selected from the
block execution.  A Yul `break` from the body exits the loop and revives to the
same regular source state over the concatenated trace.
-/
theorem runLoopSource_resolves_body_break_of_evalValues_nonzero
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared sharedAfterCond sharedAfterBody : EvmYul.SharedState .Yul}
    {store storeAfterCond storeAfterBody : EvmYul.Yul.VarStore}
    {value : Word} {trace bodyTrace : OpenExternal.OpenTrace}
    (hResolveValues :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (.Ok shared store)))
        trace
        (.ok ((.Ok sharedAfterCond storeAfterCond : State), [value])))
    (hNonzero : value ≠ EvmYul.UInt256.ofNat 0)
    (hBody :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
            (.Ok sharedAfterCond storeAfterCond)))
        bodyTrace
        (.ok (.Checkpoint (.Break sharedAfterBody storeAfterBody)))) :
    OpenExternal.OpenResultResolves
      (runLoopSource fuel cond post body codeOverride (.Ok shared store))
      (trace ++ bodyTrace)
      (.ok (.Ok sharedAfterBody storeAfterBody)) := by
  let loopNext : State × List Word → OpenExternal.OpenResult Exception State :=
    fun result =>
      OpenExternal.OpenResult.bind
        (.done (EvmYul.Yul.head' (.ok result)) :
          OpenExternal.OpenResult Exception (State × Word))
        (fun condResult =>
          if condResult.2 = EvmYul.UInt256.ofNat 0 then
            OpenExternal.OpenResult.ok
              (EvmYul.Yul.State.overwrite? condResult.1
                (.Ok shared store))
          else
            OpenExternal.OpenResult.bind
              (OpenExternal.YulOpenResult.toOpenResult
                (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
                  condResult.1))
              (fun bodyResult =>
                match bodyResult with
                | .OutOfFuel =>
                    OpenExternal.OpenResult.ok
                      (EvmYul.Yul.State.overwrite? bodyResult
                        (.Ok shared store))
                | .Checkpoint (.Break _ _) =>
                    OpenExternal.OpenResult.ok
                      (EvmYul.Yul.State.overwrite?
                        (EvmYul.Yul.State.reviveJump bodyResult)
                        (.Ok shared store))
                | .Checkpoint (.Leave _ _) =>
                    OpenExternal.OpenResult.ok
                      (EvmYul.Yul.State.overwrite? bodyResult
                        (.Ok shared store))
                | .Checkpoint (.Continue _ _) | _ =>
                    OpenExternal.OpenResult.bind
                      (OpenExternal.YulOpenResult.toOpenResult
                        (OpenExternal.YulOpen.exec fuel (.Block post)
                          codeOverride
                          (EvmYul.Yul.State.reviveJump bodyResult)))
                      (fun postResult =>
                        let stateAfterPost :=
                          EvmYul.Yul.State.overwrite? postResult
                            (.Ok shared store)
                        match postResult with
                        | .OutOfFuel =>
                            OpenExternal.OpenResult.ok stateAfterPost
                        | .Checkpoint (.Leave _ _) =>
                            OpenExternal.OpenResult.ok stateAfterPost
                        | _ =>
                            OpenExternal.OpenResult.bind
                              (OpenExternal.YulOpenResult.toOpenResult
                                (OpenExternal.YulOpen.exec fuel
                                  (.For cond post body) codeOverride
                                  stateAfterPost))
                              (fun loopResult =>
                                OpenExternal.OpenResult.ok
                                  (EvmYul.Yul.State.overwrite? loopResult
                                    (.Ok shared store))))))
  have hAfterBody :
      OpenExternal.OpenResultResolves
        ((fun bodyResult : State =>
            match bodyResult with
            | .OutOfFuel =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? bodyResult
                    (.Ok shared store))
            | .Checkpoint (.Break _ _) =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite?
                    (EvmYul.Yul.State.reviveJump bodyResult)
                    (.Ok shared store))
            | .Checkpoint (.Leave _ _) =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? bodyResult
                    (.Ok shared store))
            | .Checkpoint (.Continue _ _) | _ =>
                OpenExternal.OpenResult.bind
                  (OpenExternal.YulOpenResult.toOpenResult
                    (OpenExternal.YulOpen.exec fuel (.Block post)
                      codeOverride
                      (EvmYul.Yul.State.reviveJump bodyResult)))
                  (fun postResult =>
                    let stateAfterPost :=
                      EvmYul.Yul.State.overwrite? postResult
                        (.Ok shared store)
                    match postResult with
                    | .OutOfFuel =>
                        OpenExternal.OpenResult.ok stateAfterPost
                    | .Checkpoint (.Leave _ _) =>
                        OpenExternal.OpenResult.ok stateAfterPost
                    | _ =>
                        OpenExternal.OpenResult.bind
                          (OpenExternal.YulOpenResult.toOpenResult
                            (OpenExternal.YulOpen.exec fuel
                              (.For cond post body) codeOverride
                              stateAfterPost))
                          (fun loopResult =>
                            OpenExternal.OpenResult.ok
                              (EvmYul.Yul.State.overwrite? loopResult
                                (.Ok shared store)))))
          (.Checkpoint (.Break sharedAfterBody storeAfterBody)))
        [] (.ok (.Ok sharedAfterBody storeAfterBody)) := by
    simpa [OpenExternal.OpenResult.ok, EvmYul.Yul.State.reviveJump,
      EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?] using
      (OpenExternal.OpenResultResolves.done :
        OpenExternal.OpenResultResolves
          (OpenExternal.OpenResult.ok
            (ε := Exception) (.Ok sharedAfterBody storeAfterBody : State))
          [] (.ok (.Ok sharedAfterBody storeAfterBody)))
  have hAfterCond :
      OpenExternal.OpenResultResolves
        (loopNext ((.Ok sharedAfterCond storeAfterCond : State), [value]))
        bodyTrace (.ok (.Ok sharedAfterBody storeAfterBody)) := by
    have hHead :
        OpenExternal.OpenResultResolves
          ((.done
            (EvmYul.Yul.head'
              (.ok
                ((.Ok sharedAfterCond storeAfterCond : State), [value]))) :
            OpenExternal.OpenResult Exception (State × Word)))
          [] (.ok ((.Ok sharedAfterCond storeAfterCond : State), value)) := by
      simpa [EvmYul.Yul.head'] using
        (OpenExternal.OpenResultResolves.done :
          OpenExternal.OpenResultResolves
            (OpenExternal.OpenResult.ok
              (ε := Exception)
              ((.Ok sharedAfterCond storeAfterCond : State), value))
            [] (.ok ((.Ok sharedAfterCond storeAfterCond : State), value)))
    have hAfterHead :
        OpenExternal.OpenResultResolves
          ((fun condResult : State × Word =>
              if condResult.2 = EvmYul.UInt256.ofNat 0 then
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? condResult.1
                    (.Ok shared store))
              else
                OpenExternal.OpenResult.bind
                  (OpenExternal.YulOpenResult.toOpenResult
                    (OpenExternal.YulOpen.exec fuel (.Block body)
                      codeOverride condResult.1))
                  (fun bodyResult =>
                    match bodyResult with
                    | .OutOfFuel =>
                        OpenExternal.OpenResult.ok
                          (EvmYul.Yul.State.overwrite? bodyResult
                            (.Ok shared store))
                    | .Checkpoint (.Break _ _) =>
                        OpenExternal.OpenResult.ok
                          (EvmYul.Yul.State.overwrite?
                            (EvmYul.Yul.State.reviveJump bodyResult)
                            (.Ok shared store))
                    | .Checkpoint (.Leave _ _) =>
                        OpenExternal.OpenResult.ok
                          (EvmYul.Yul.State.overwrite? bodyResult
                            (.Ok shared store))
                    | .Checkpoint (.Continue _ _) | _ =>
                        OpenExternal.OpenResult.bind
                          (OpenExternal.YulOpenResult.toOpenResult
                            (OpenExternal.YulOpen.exec fuel (.Block post)
                              codeOverride
                              (EvmYul.Yul.State.reviveJump bodyResult)))
                          (fun postResult =>
                            let stateAfterPost :=
                              EvmYul.Yul.State.overwrite? postResult
                                (.Ok shared store)
                            match postResult with
                            | .OutOfFuel =>
                                OpenExternal.OpenResult.ok stateAfterPost
                            | .Checkpoint (.Leave _ _) =>
                                OpenExternal.OpenResult.ok stateAfterPost
                            | _ =>
                                OpenExternal.OpenResult.bind
                                  (OpenExternal.YulOpenResult.toOpenResult
                                    (OpenExternal.YulOpen.exec fuel
                                      (.For cond post body) codeOverride
                                      stateAfterPost))
                                  (fun loopResult =>
                                    OpenExternal.OpenResult.ok
                                      (EvmYul.Yul.State.overwrite? loopResult
                                        (.Ok shared store))))))
            ((.Ok sharedAfterCond storeAfterCond : State), value))
          bodyTrace (.ok (.Ok sharedAfterBody storeAfterBody)) := by
      dsimp
      simp [hNonzero]
      simpa [List.append_nil] using
        OpenExternal.OpenResultResolves.bind_ok
          (source :=
            OpenExternal.YulOpenResult.toOpenResult
              (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
                (.Ok sharedAfterCond storeAfterCond)))
          (next := fun bodyResult =>
            match bodyResult with
            | .OutOfFuel =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? bodyResult
                    (.Ok shared store))
            | .Checkpoint (.Break _ _) =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite?
                    (EvmYul.Yul.State.reviveJump bodyResult)
                    (.Ok shared store))
            | .Checkpoint (.Leave _ _) =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? bodyResult
                    (.Ok shared store))
            | .Checkpoint (.Continue _ _) | _ =>
                OpenExternal.OpenResult.bind
                  (OpenExternal.YulOpenResult.toOpenResult
                    (OpenExternal.YulOpen.exec fuel (.Block post) codeOverride
                      (EvmYul.Yul.State.reviveJump bodyResult)))
                  (fun postResult =>
                    let stateAfterPost :=
                      EvmYul.Yul.State.overwrite? postResult
                        (.Ok shared store)
                    match postResult with
                    | .OutOfFuel =>
                        OpenExternal.OpenResult.ok stateAfterPost
                    | .Checkpoint (.Leave _ _) =>
                        OpenExternal.OpenResult.ok stateAfterPost
                    | _ =>
                        OpenExternal.OpenResult.bind
                          (OpenExternal.YulOpenResult.toOpenResult
                            (OpenExternal.YulOpen.exec fuel
                              (.For cond post body) codeOverride
                              stateAfterPost))
                          (fun loopResult =>
                            OpenExternal.OpenResult.ok
                              (EvmYul.Yul.State.overwrite? loopResult
                                (.Ok shared store)))))
          hBody hAfterBody
    simpa [loopNext, List.append_nil] using
      (OpenExternal.OpenResultResolves.bind_ok hHead hAfterHead)
  rw [runLoopSource_eq_bind_evalValues]
  change
    OpenExternal.OpenResultResolves
      (OpenExternal.OpenResult.bind
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (.Ok shared store)))
        loopNext)
      (trace ++ bodyTrace) (.ok (.Ok sharedAfterBody storeAfterBody))
  exact
    OpenExternal.OpenResultResolves.bind_ok hResolveValues hAfterCond

/--
Selected source path for the nonzero-condition/body-terminal loop branch.

Once the condition trace resolves to a nonzero singleton, a selected terminal
body trace stops the whole normalized loop with the same source error.  The
post block and recursive loop continuation are not evaluated on this path.
-/
theorem runLoopSource_resolves_body_error_of_evalValues_nonzero
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared sharedAfterCond : EvmYul.SharedState .Yul}
    {store storeAfterCond : EvmYul.Yul.VarStore}
    {value : Word} {trace bodyTrace : OpenExternal.OpenTrace}
    {err : Exception}
    (hResolveValues :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (.Ok shared store)))
        trace
        (.ok ((.Ok sharedAfterCond storeAfterCond : State), [value])))
    (hNonzero : value ≠ EvmYul.UInt256.ofNat 0)
    (hBody :
