theorem safeBasicOneOutputPrimCall_error_not_relatable
    {sourceFuel : Nat} {primOp : EvmYul.Operation .Yul}
    {op : Structured.BasicOp}
    {source : State} {args : List Word} {err : Exception}
    (hSafe : Safe.primitive primOp)
    (hBasic : Prim.toBasicOp? primOp = some op)
    (hOutputs : Expressions.Structured.BasicOp.outputs op = 1)
    (hCall :
      EvmYul.Yul.primCall sourceFuel source primOp args = .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    False := by
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.primCall] at hCall
      subst err
      exact sourceResultRelatable_outOfFuel_false hRelatable
  | succ fuel =>
      cases primOp with
      | StopArith stopArith =>
          cases stopArith with
          | STOP =>
              simp [Prim.toBasicOp?] at hBasic
          | ADD | MUL | SUB | DIV | SDIV | MOD | SMOD | ADDMOD | MULMOD
          | EXP | SIGNEXTEND =>
              exact
                pureAliasPrim_primCall_error_not_relatable
                  (by simp [Expr.pureAliasPrim?]) hCall hRelatable
      | CompBit compBit =>
          cases compBit <;>
            exact
              pureAliasPrim_primCall_error_not_relatable
                (by simp [Expr.pureAliasPrim?]) hCall hRelatable
      | Keccak keccak =>
          cases keccak
          have hExec :
              yulPrimListResult
                (EvmYul.Yul.binaryMachineStateOp'
                  EvmYul.MachineState.keccak256 source args) =
                .error err := by
            simp [EvmYul.Yul.primCall] at hCall
            have hStep :
                EvmYul.step
                    ((.Keccak .KECCAK256 : EvmYul.Operation .Yul)) none =
                  EvmYul.Yul.binaryMachineStateOp'
                    EvmYul.MachineState.keccak256 := by
              rfl
            rw [hStep] at hCall
            simpa [yulPrimListResult] using hCall
          exact
            wrapped_yul_binaryMachineStateOp'_error_not_relatable
              hExec hRelatable
      | Env env =>
          cases env with
          | ADDRESS =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.codeOwner)
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .ADDRESS : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.executionEnvOp
                        (.ofNat ∘ Fin.val ∘
                          EvmYul.ExecutionEnv.codeOwner) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact
                wrapped_yul_executionEnvOp_error_not_relatable
                  hExec hRelatable
          | BALANCE =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.unaryStateOp EvmYul.State.balance
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .BALANCE : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.unaryStateOp EvmYul.State.balance := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_unaryStateOp_error_not_relatable
                hExec hRelatable
          | ORIGIN =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.sender)
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .ORIGIN : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.executionEnvOp
                        (.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.sender) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_executionEnvOp_error_not_relatable
                hExec hRelatable
          | CALLER =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.source)
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CALLER : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.executionEnvOp
                        (.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.source) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_executionEnvOp_error_not_relatable
                hExec hRelatable
          | CALLVALUE =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      EvmYul.ExecutionEnv.weiValue source args) =
                    .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CALLVALUE : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.executionEnvOp
                        EvmYul.ExecutionEnv.weiValue := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_executionEnvOp_error_not_relatable
                hExec hRelatable
          | CALLDATALOAD =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.unaryStateOp
                      (fun s v => (s, EvmYul.State.calldataload s v))
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CALLDATALOAD : EvmYul.Operation .Yul))
                        none =
                      EvmYul.Yul.unaryStateOp
                        (fun s v => (s, EvmYul.State.calldataload s v)) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_unaryStateOp_error_not_relatable
                hExec hRelatable
          | CALLDATASIZE =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ ByteArray.size ∘
                        EvmYul.ExecutionEnv.calldata)
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CALLDATASIZE : EvmYul.Operation .Yul))
                        none =
                      EvmYul.Yul.executionEnvOp
                        (.ofNat ∘ ByteArray.size ∘
                          EvmYul.ExecutionEnv.calldata) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_executionEnvOp_error_not_relatable
                hExec hRelatable
          | CALLDATACOPY =>
              simp [Prim.toBasicOp?] at hBasic
              rw [← hBasic] at hOutputs
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
          | GASPRICE =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ EvmYul.ExecutionEnv.gasPrice)
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .GASPRICE : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.executionEnvOp
                        (.ofNat ∘ EvmYul.ExecutionEnv.gasPrice) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_executionEnvOp_error_not_relatable
                hExec hRelatable
          | CODESIZE =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.executionEnvOp
                      (.ofNat ∘ ByteArray.size ∘
                        EvmYul.ExecutionEnv.codeBytes)
                      source args) = .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CODESIZE : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.executionEnvOp
                        (.ofNat ∘ ByteArray.size ∘
                          EvmYul.ExecutionEnv.codeBytes) := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_executionEnvOp_error_not_relatable
                hExec hRelatable
            | CODECOPY | EXTCODECOPY =>
                simp [Prim.toBasicOp?] at hBasic
                rw [← hBasic] at hOutputs
                simp [Expressions.Structured.BasicOp.outputs] at hOutputs
            | EXTCODESIZE =>
                have hExec :
                    yulPrimListResult
                      (EvmYul.Yul.unaryStateOp EvmYul.State.extCodeSize
                        source args) = .error err := by
                  simp [EvmYul.Yul.primCall] at hCall
                  have hStep :
                      EvmYul.step
                          ((.Env .EXTCODESIZE : EvmYul.Operation .Yul))
                          none =
                        EvmYul.Yul.unaryStateOp EvmYul.State.extCodeSize := by
                    rfl
                  rw [hStep] at hCall
                  simpa [yulPrimListResult] using hCall
                exact wrapped_yul_unaryStateOp_error_not_relatable
                  hExec hRelatable
            | EXTCODEHASH =>
                have hExec :
                    yulPrimListResult
                      (EvmYul.Yul.unaryStateOp EvmYul.State.extCodeHash
                        source args) = .error err := by
                  simp [EvmYul.Yul.primCall] at hCall
                  have hStep :
                      EvmYul.step
                          ((.Env .EXTCODEHASH : EvmYul.Operation .Yul))
                          none =
                        EvmYul.Yul.unaryStateOp EvmYul.State.extCodeHash := by
                    rfl
                  rw [hStep] at hCall
                  simpa [yulPrimListResult] using hCall
                exact wrapped_yul_unaryStateOp_error_not_relatable
