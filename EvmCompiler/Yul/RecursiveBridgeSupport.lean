/--
Empty hidden-context sequence soundness at exact source fuel.

At fuel zero the imported empty sequence reports out-of-fuel, which is ruled
out by the source-result relatability filter.  At positive fuel the target
empty block runs regularly and the compatible outcome layout must be the
current source layout.
-/
theorem sourceResultSeqSoundWhenAtExactHiddenCtx_nil_of_compat
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel [] codeOverride
      { stmts := [] } allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.execSeq 0 [] codeOverride source =
            .error .OutOfFuel := by
        simp [EvmYul.Yul.execSeq]
      rw [hZero] at hSource
      subst sourceResult
      have hRelatable :
          SourceResultRelatable (.error (.OutOfFuel : Exception)) :=
        hAllowed hAllow
      cases hRelatable
  | succ fuel =>
      cases hInitial with
      | @ok shared store compiler hShared hVars hDomain =>
          rw [Imported.execSeq_nil_succ fuel codeOverride
              (.Ok shared store : State)] at hSource
          subst sourceResult
          have hOutcomeEq : outcomeLayout = layout := by
            simpa [SourceResultOutcomeLayoutCompatible] using hCompat hAllow
          subst outcomeLayout
          refine ⟨Functions.Source.Outcome.regular compiler, ctx, 1, ?_, ?_⟩
          · simp [Functions.Source.Block.runOpen]
          · exact
              SourceResultOutcomeRel.ok
                (SourceOkOutcomeRel.regular
                  (SourceStateExactRel.toRel
                    (SourceStateExactRel.ok hShared hVars hDomain)))

/--
Checked empty hidden-context sequence bridge.

The concrete list lowerer may be called with any compile fuel; if it succeeds
on `[]`, the emitted block is empty and the semantic proof is exactly
`sourceResultSeqSoundWhenAtExactHiddenCtx_nil_of_compat`.
-/
theorem checkedSeqLoweringSoundWhenFreshNamesAtCompileFuelHiddenCtx_nil_of_compat
    {cfg : StateRelConfig} {reserved layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel compileFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) :
    CheckedSeqLoweringSoundWhenFreshNamesAtCompileFuelHiddenCtx cfg reserved
      layout outcomeLayout terminalRel revertRel prim program ctx sourceFuel
      compileFuel [] codeOverride allowed := by
  intro freshState freshState' lowerBlock _hCovers hLower
  have hLower' :
      (some (({ stmts := [] } : Functions.Block), freshState) :
          Option (Functions.Block × Fresh.State)) =
        some (lowerBlock, freshState') := by
    cases compileFuel with
    | zero =>
        simp [Stmt.List.toBlockFuel?] at hLower
    | succ fuel =>
        cases fuel with
        | zero =>
            simp [Stmt.List.toBlockFuel?, Stmt.List.toFunctionsFuel?] at hLower
        | succ fuel =>
            simpa [Stmt.List.toBlockFuel?, Stmt.List.toFunctionsFuel?]
              using hLower
  injection hLower' with hPair
  have hBlockEq : ({ stmts := [] } : Functions.Block) = lowerBlock :=
    congrArg Prod.fst hPair
  have hStateEq : freshState = freshState' :=
    congrArg Prod.snd hPair
  cases hBlockEq
  cases hStateEq
  change SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
    terminalRel revertRel prim program ctx sourceFuel [] codeOverride
    { stmts := [] } allowed
  exact
    sourceResultSeqSoundWhenAtExactHiddenCtx_nil_of_compat
      (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
      (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
      (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
      (codeOverride := codeOverride) (allowed := allowed) hAllowed hCompat

