                  | none =>
                      let f : EvmYul.Yul.Ast.FunctionDefinition :=
                        .Def [] []
                          [(codeOverride.getD yulContract.code).dispatcher]
                      change
                        SourcePairResultCheckpointAllowed canBreak canContinue
                          canLeave
                          (match EvmYul.Yul.exec fuel' (.Block f.body)
                              codeOverride (default : State) with
                          | Except.error e => Except.error e
                          | Except.ok s2 =>
                              Except.ok
                                ((s2.reviveJump.overwrite?
                                    (.Checkpoint (.Continue shared store) :
                                      State))
                                  |>.setStore
                                    (.Checkpoint (.Continue shared store) :
                                      State),
                                  List.map s2.lookup! f.rets))
                      cases hExec :
                          EvmYul.Yul.exec fuel' (.Block f.body)
                            codeOverride (default : State) with
                      | error err =>
                          simp [hExec, SourcePairResultCheckpointAllowed]
                      | ok bodyState =>
                          simpa [hExec, SourcePairResultCheckpointAllowed,
                            EvmYul.Yul.State.setStore,
