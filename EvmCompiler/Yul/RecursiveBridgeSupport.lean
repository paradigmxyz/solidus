                    (EvmYul.Yul.machineStateOp EvmYul.MachineState.gas
                      source args) = .ok (sourceAfter, values) := by
                simp [EvmYul.Yul.primCall] at hCall
                unfold EvmYul.step at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_machineStateOp_ok_single hExec
          | TLOAD =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.unaryStateOp EvmYul.State.tload
                      source args) = .ok (sourceAfter, values) := by
                simp [EvmYul.Yul.primCall] at hCall
                unfold EvmYul.step at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_unaryStateOp_ok_single hExec
      | Log log =>
          cases log <;> simp [Prim.toBasicOp?] at hBasic <;>
            rw [← hBasic] at hOutputs <;>
            simp [Expressions.Structured.BasicOp.outputs] at hOutputs
      | System sys =>
          cases sys with
          | INVALID =>
              simp [Prim.toBasicOp?] at hBasic
              subst op
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
          | CREATE | CALL | CALLCODE | RETURN | DELEGATECALL | CREATE2
          | STATICCALL | REVERT | SELFDESTRUCT =>
