  runtime :=
    Assembly.RuntimeAssumptions.withNoCallCreate decodeWindow jumpdestCorrect
      outOfGasPolicy currentContractProjection hNoCallCreate
  initialPc := hInitialPc
  initialStack := hInitialStack

