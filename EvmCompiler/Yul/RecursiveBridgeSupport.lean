theorem sourceArgListPreludeTerminalAt_cons_of_tail_pre_exact
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {head : AstExpr} {tail : List AstExpr}
    {codeOverride : Option AstContract}
    {preTail preHead : List Functions.Stmt}
    {lowerHead : Locals.Expr 1} {tmp : Name}
    (hTailTerminal :
      SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program ctx sourceFuel tail codeOverride preTail)
    (hTailRegular :
      SourceArgListPreludeRegularPreExactAt cfg layout prim program ctx
        sourceFuel tail codeOverride preTail)
    (hHeadTerminal :
      ∀ {headFuel : Nat} {ctxHead : Functions.Source.Ctx},
        SourceExprPreludeTerminalAt cfg layout outcomeLayout terminalRel
          revertRel prim program ctxHead headFuel head codeOverride preHead) :
    SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel (head :: tail) codeOverride
      (preTail ++ preHead ++ [Functions.Stmt.let_ tmp lowerHead]) := by
  intro source compiler err hInitial hEval hRelatable
  have hEvalAppend :
      EvmYul.Yul.evalArgs sourceFuel (tail.reverse ++ [head])
          codeOverride source =
        .error err := by
    simpa using hEval
  cases
      evalArgs_append_singleton_error_relatable_split
        (preArgs := tail.reverse) (head := head) hEvalAppend hRelatable with
  | inl hTailErr =>
      have hTailAll :
          SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
            revertRel prim program ctx sourceFuel tail codeOverride
            (preTail ++ (preHead ++ [Functions.Stmt.let_ tmp lowerHead])) :=
        SourceArgListPreludeTerminalAt.append_suffix
          (pre := preTail)
          (suffix := preHead ++ [Functions.Stmt.let_ tmp lowerHead])
          hTailTerminal
      simpa [List.append_assoc] using
        hTailAll hInitial hTailErr hRelatable
  | inr hHeadErr =>
