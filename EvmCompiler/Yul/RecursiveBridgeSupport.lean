      GeneratedForLoopBranchContracts cfg layout konts.leave terminalRel
        revertRel prim program ctx sourceFuel cond post body codeOverride
        reserved pieces allowedInner) :
    GeneratedForLoopKontBranchContracts cfg layout konts terminalRel
      revertRel prim program ctx sourceFuel cond post body codeOverride
      reserved pieces allowedInner where
  bodyError := by
    intro shared sharedAfterCond store storeAfterCond compiler value err
      hExact hEval hNonzero hBody hRelatable
    exact
      (hBranches.bodyError hExact hEval hNonzero hBody hRelatable)
        |>.toKont_leave_layout_no_loop_control
          (hNoBreak := by
            intro sharedBreak storeBreak hExec
            exact
              exec_for_break_false_of_scoped_safe hExpr hSafe hScoped hExec)
          (hNoContinue := by
            intro sharedContinue storeContinue hExec
            exact
              exec_for_continue_false_of_scoped_safe hExpr hSafe hScoped
                hExec)
  bodyBreak := by
    intro shared sharedAfterCond sharedAfterBody store storeAfterCond
      storeAfterBody compiler value hExact hEval hNonzero hBody
    exact hBranches.bodyBreak hExact hEval hNonzero hBody
  bodyLeave := by
    intro shared sharedAfterCond sharedAfterBody store storeAfterCond
      storeAfterBody compiler value hExact hEval hNonzero hBody hSupported
    have hCompat :
        SourceResultOutcomeLayoutCompatible ctx layout konts.leave
          (.ok (.Checkpoint (.Leave sharedAfterBody storeAfterBody))) := by
      simpa [SourceResultOutcomeLayoutCompatible,
        SourceResultModeKontSupported] using hSupported
    exact
      (hBranches.bodyLeave hExact hEval hNonzero hBody hCompat)
        |>.toKont_leave_layout_no_loop_control
          (hNoBreak := by
            intro sharedBreak storeBreak hExec
            exact
              exec_for_break_false_of_scoped_safe hExpr hSafe hScoped hExec)
          (hNoContinue := by
            intro sharedContinue storeContinue hExec
            exact
              exec_for_continue_false_of_scoped_safe hExpr hSafe hScoped
                hExec)
  postError := by
    intro shared sharedAfterCond sharedAfterBody store storeAfterCond
      storeAfterBody compiler value bodyWasContinue err hExact hEval
      hNonzero hBody hPost hRelatable
    exact
      (hBranches.postError hExact hEval hNonzero hBody hPost hRelatable)
        |>.toKont_leave_layout_no_loop_control
          (hNoBreak := by
            intro sharedBreak storeBreak hExec
            exact
              exec_for_break_false_of_scoped_safe hExpr hSafe hScoped hExec)
          (hNoContinue := by
            intro sharedContinue storeContinue hExec
            exact
              exec_for_continue_false_of_scoped_safe hExpr hSafe hScoped
                hExec)
  postLeave := by
    intro shared sharedAfterCond sharedAfterBody sharedAfterPost store
      storeAfterCond storeAfterBody storeAfterPost compiler value
      bodyWasContinue hExact hEval hNonzero hBody hPost hSupported
    have hCompat :
        SourceResultOutcomeLayoutCompatible ctx layout konts.leave
