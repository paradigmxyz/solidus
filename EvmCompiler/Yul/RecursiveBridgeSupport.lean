/--
The imported state installed for a Yul function body has exactly the return
and parameter variables in scope.
-/
theorem StateStoreDomainExact.initcall_of_length
    {shared : EvmYul.SharedState .Yul}
    {callerStore : EvmYul.Yul.VarStore}
    {params rets : List EvmYul.Identifier} {args : List Word}
    (hArgsLength : (identNames params).length ≤ args.length) :
    StateStoreDomainExact (identNames rets ++ identNames params)
      (EvmYul.Yul.State.initcall params rets args
        (.Ok shared callerStore)) := by
  have hReturnsDomain :
      StoreDomainExact (identNames rets).reverse
        (VarStackRel.insertPairs
          (VarStackRel.zeroPairs (identNames rets))
          (default : EvmYul.Yul.VarStore)) := by
    simpa using
      (StoreDomainExact.insertZeros
        (names := identNames rets) (layout := [])
        (store := (default : EvmYul.Yul.VarStore))
        StoreDomainExact.empty)
  have hParamsDomainRaw :
      StoreDomainExact
        ((List.zip (identNames params) args).map Prod.fst ++
          (identNames rets).reverse)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) :=
    StoreDomainExact.insertPairs
      (pairs := List.zip (identNames params) args)
      (layout := (identNames rets).reverse)
      (store :=
        VarStackRel.insertPairs (VarStackRel.zeroPairs (identNames rets))
          (default : EvmYul.Yul.VarStore))
      hReturnsDomain
  have hParamsDomain :
      StoreDomainExact (identNames params ++ (identNames rets).reverse)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) := by
    simpa [List.map_fst_zip hArgsLength] using hParamsDomainRaw
  have hDomain :
      StoreDomainExact (identNames rets ++ identNames params)
        (VarStackRel.insertPairs (List.zip (identNames params) args)
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames rets))
            (default : EvmYul.Yul.VarStore))) :=
    StoreDomainExact.of_mem_iff hParamsDomain (by
      intro name
      simp [List.mem_append, List.mem_reverse, or_comm, or_left_comm,
        or_assoc])
  rw [initcall_ok_insertPairs]
  simpa [StateStoreDomainExact] using hDomain

theorem StateStoreContains.initcall_of_length
    {shared : EvmYul.SharedState .Yul}
    {callerStore : EvmYul.Yul.VarStore}
    {params rets : List EvmYul.Identifier} {args : List Word}
    (hArgsLength : (identNames params).length ≤ args.length) :
    StateStoreContains (identNames rets ++ identNames params)
      (EvmYul.Yul.State.initcall params rets args
        (.Ok shared callerStore)) :=
  StateStoreContains.of_exact
    (StateStoreDomainExact.initcall_of_length
      (shared := shared) (callerStore := callerStore)
      (params := params) (rets := rets) (args := args) hArgsLength)

/--
Successful imported Yul user/dispatcher calls restore the caller varstore.

The recursive bridge needs this as a source-facing domain-preservation fact:
function-call expression evaluation may run arbitrary callee code, but the
Nethermind Yul `call` wrapper revives the caller state and resets the caller
store on a successful return.
-/
theorem call_ok_store_eq
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {args values : List Word}
    {fname : Option EvmYul.Yul.Ast.YulFunctionName}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (h :
      EvmYul.Yul.call fuel args fname codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values)) :
    storeAfter = store := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.call] at h
  | succ fuel =>
      simp [EvmYul.Yul.call, EvmYul.Yul.State.sharedState,
        EvmYul.Yul.State.executionEnv] at h
      cases hFind : shared.accountMap.find? shared.executionEnv.codeOwner with
      | none => simp [hFind] at h
      | some yulContract =>
          simp [hFind] at h
          cases fname with
          | none =>
              let f : EvmYul.Yul.Ast.FunctionDefinition :=
                .Def [] [] [(codeOverride.getD yulContract.code).dispatcher]
              change
                (match EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                    (👌 (EvmYul.Yul.State.Ok shared store).initcall
                      f.params f.rets args) with
                  | Except.error e => Except.error e
                  | Except.ok s2 =>
                      Except.ok
                        ((s2.reviveJump.overwrite? (.Ok shared store)).setStore
                            (.Ok shared store),
                          List.map s2.lookup! f.rets)) =
                  Except.ok (.Ok sharedAfter storeAfter, values) at h
              cases hExec :
                  EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                    (👌 (EvmYul.Yul.State.Ok shared store).initcall
                      f.params f.rets args) with
              | error e => simp [hExec] at h
              | ok s2 =>
                  cases s2 with
                  | Ok ss st =>
                      simp [hExec, EvmYul.Yul.State.setStore,
                        EvmYul.Yul.State.overwrite?,
                        EvmYul.Yul.State.reviveJump] at h
                      exact h.1.2.symm
                  | OutOfFuel =>
                      simp [hExec, EvmYul.Yul.State.setStore,
                        EvmYul.Yul.State.overwrite?,
                        EvmYul.Yul.State.reviveJump] at h
                  | Checkpoint j =>
                      cases j <;>
                        simp [hExec, EvmYul.Yul.State.setStore,
                          EvmYul.Yul.State.overwrite?,
                          EvmYul.Yul.State.reviveJump,
                          EvmYul.Yul.State.revive] at h <;>
                        exact h.1.2.symm
          | some fname' =>
              cases hLookup :
                  (codeOverride.getD yulContract.code).functions.lookup fname' with
              | none => simp [hLookup] at h
              | some f =>
                  simp [hLookup] at h
                  cases hExec :
                      EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                        (👌 (EvmYul.Yul.State.Ok shared store).initcall
                          f.params f.rets args) with
                  | error e => simp [hExec] at h
                  | ok s2 =>
                      cases s2 with
                      | Ok ss st =>
                          simp [hExec, EvmYul.Yul.State.setStore,
                            EvmYul.Yul.State.overwrite?,
                            EvmYul.Yul.State.reviveJump] at h
                          exact h.1.2.symm
                      | OutOfFuel =>
                          simp [hExec, EvmYul.Yul.State.setStore,
                            EvmYul.Yul.State.overwrite?,
                            EvmYul.Yul.State.reviveJump] at h
                      | Checkpoint j =>
                          cases j <;>
                            simp [hExec, EvmYul.Yul.State.setStore,
                              EvmYul.Yul.State.overwrite?,
                              EvmYul.Yul.State.reviveJump,
                              EvmYul.Yul.State.revive] at h <;>
                            exact h.1.2.symm

