    ⟨compilerAfterPre, compilerAfter, ctxAfter, targetFuel, hPreRun,
      hExprRun, hRel⟩
  have hOne :
      Locals.Source.Expr.evalOne prim lowerExpr compilerAfterPre =
        .ok (compilerAfter, value) := by
    unfold Locals.Source.Expr.evalOne
    simp [hExprRun]
