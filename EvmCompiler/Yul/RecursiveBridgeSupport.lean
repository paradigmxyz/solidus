  simpa [StateStoreDomainExact] using hStateDomain

theorem SourceResultStoreContains.loop_succ_succ_of_ok_or_outOfFuel_parts
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {post body : List AstStmt} {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    (hState : StoreDomainContains layout store)
    (hEval :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store)))
    (hEvalOkOrOutOfFuel :
      ∀ {stateAfterCond : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) =
          .ok (stateAfterCond, value) →
        stateAfterCond = .OutOfFuel ∨
          ∃ sharedCond storeCond,
            stateAfterCond = .Ok sharedCond storeCond ∧
            StoreDomainContains layout storeCond)
    (hBodySafe : Safe.stmts body)
    (hBody :
      ∀ {sharedCond : EvmYul.SharedState .Yul}
        {storeCond : EvmYul.Yul.VarStore} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) =
          .ok (.Ok sharedCond storeCond, value) →
        value ≠ ⟨0⟩ →
        StoreDomainContains layout storeCond →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            (.Ok sharedCond storeCond)))
    (hPost :
      ∀ {sharedPost : EvmYul.SharedState .Yul}
        {storePost : EvmYul.Yul.VarStore},
        StoreDomainContains layout storePost →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block post) codeOverride
            (.Ok sharedPost storePost)))
    (hRecur :
      ∀ {loopInput : State},
        StateStoreContains layout loopInput →
        StateCheckpointAllowed false false false loopInput →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
            loopInput)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.loop (fuel + 2) cond post body codeOverride
        (.Ok shared store)) := by
  rw [Imported.loop_succ_succ]
  simp [EvmYul.Yul.State.mkOk] at *
  have hStateOk : StateStoreContains layout (.Ok shared store) := by
    simpa [StateStoreContains] using hState
  cases hEvalResult :
      EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) with
  | error err =>
      simp [hEvalResult, SourceResultStoreContains]
  | ok evalPair =>
      rcases evalPair with ⟨stateAfterCond, value⟩
      cases hEvalOkOrOutOfFuel hEvalResult with
      | inl hOutOfFuel =>
          subst stateAfterCond
          by_cases hZero : value = (⟨0⟩ : Word)
          · simp [hEvalResult, hZero, SourceResultStoreContains,
              StateStoreContains, EvmYul.Yul.State.overwrite?]
          · cases hBodyResult :
                EvmYul.Yul.exec fuel (.Block body) codeOverride .OutOfFuel with
            | error err =>
                simp [hEvalResult, hZero, hBodyResult,
                  SourceResultStoreContains]
            | ok stateAfterBody =>
                have hBodyEq : stateAfterBody = .OutOfFuel :=
                  exec_block_outOfFuel_state_eq_of_safe_primitiveFamilies
                    hBodySafe hBodyResult
                subst stateAfterBody
                simp [hEvalResult, hZero, hBodyResult,
                  SourceResultStoreContains, StateStoreContains,
                  EvmYul.Yul.State.overwrite?]
      | inr hOk =>
          rcases hOk with
            ⟨sharedCond, storeCond, hCondEq, hCondDomain⟩
          subst stateAfterCond
          have hCondContains :
              StateStoreContains layout (.Ok sharedCond storeCond) := by
            simpa [StateStoreContains] using hCondDomain
          by_cases hZero : value = (⟨0⟩ : Word)
          · simpa [hEvalResult, hZero, SourceResultStoreContains] using
              SourceResultStoreContains.of_state
                (StateStoreContains.overwrite? hCondContains hStateOk)
          · have hNonzero : value ≠ (⟨0⟩ : Word) := hZero
            have hBodyContains :
                SourceResultStoreContains layout
                  (EvmYul.Yul.exec fuel (.Block body) codeOverride
                    (.Ok sharedCond storeCond)) :=
              hBody hEvalResult hNonzero hCondDomain
            cases hBodyResult :
                EvmYul.Yul.exec fuel (.Block body) codeOverride
                  (.Ok sharedCond storeCond) with
            | error err =>
                simp [hEvalResult, hZero, hBodyResult,
                  SourceResultStoreContains]
            | ok stateAfterBody =>
                have hBodyStateContains :
                    StateStoreContains layout stateAfterBody :=
                  SourceResultStoreContains.state_of_ok hBodyContains
                    hBodyResult
                cases stateAfterBody with
                | OutOfFuel =>
                    simpa [hEvalResult, hZero, hBodyResult,
                      SourceResultStoreContains] using
                      SourceResultStoreContains.of_state
                        (StateStoreContains.overwrite? hBodyStateContains
                          hStateOk)
                | Checkpoint bodyJump =>
                    cases bodyJump with
                    | Break sharedBreak storeBreak =>
                        simpa [hEvalResult, hZero, hBodyResult,
                          SourceResultStoreContains] using
                          SourceResultStoreContains.of_state
                            (StateStoreContains.overwrite?
                              (StateStoreContains.reviveJump
                                hBodyStateContains)
                              hStateOk)
                    | Leave sharedLeave storeLeave =>
                        simpa [hEvalResult, hZero, hBodyResult,
                          SourceResultStoreContains] using
                          SourceResultStoreContains.of_state
                            (StateStoreContains.overwrite?
                              hBodyStateContains hStateOk)
                    | Continue sharedContinue storeContinue =>
                        have hPostContains :
                            SourceResultStoreContains layout
                              (EvmYul.Yul.exec fuel (.Block post)
                                codeOverride
                                (EvmYul.Yul.State.reviveJump
                                  (.Checkpoint
                                    (.Continue sharedContinue
                                      storeContinue)))) := by
                          simpa [EvmYul.Yul.State.reviveJump,
                            EvmYul.Yul.State.revive] using
                            hPost
                              (by
                                simpa [StateStoreContains] using
                                  hBodyStateContains)
                        cases hPostResult :
                            EvmYul.Yul.exec fuel (.Block post) codeOverride
                              (EvmYul.Yul.State.reviveJump
                                (.Checkpoint
                                  (.Continue sharedContinue
                                    storeContinue))) with
                        | error err =>
                            simp [hEvalResult, hZero, hBodyResult,
                              hPostResult, SourceResultStoreContains]
                        | ok stateAfterPost =>
                            have hPostStateContains :
                                StateStoreContains layout stateAfterPost :=
                              SourceResultStoreContains.state_of_ok
                                hPostContains hPostResult
                            let loopInput : State :=
                              EvmYul.Yul.State.overwrite? stateAfterPost
                                (.Ok shared store)
                            have hLoopInputContains :
                                StateStoreContains layout loopInput := by
                              dsimp [loopInput]
                              exact
                                StateStoreContains.overwrite?
                                  hPostStateContains hStateOk
                            have hLoopContains :
                                SourceResultStoreContains layout
                                  (EvmYul.Yul.exec fuel (.For cond post body)
                                    codeOverride loopInput) :=
                              SourceResultStoreContains.exec_for_of_loop_input
                                (layout := layout) (fuel := fuel)
                                (cond := cond) (post := post) (body := body)
                                (codeOverride := codeOverride)
                                (loopInput := loopInput) hLoopInputContains
                                (fun hAllowed =>
                                  hRecur hLoopInputContains hAllowed)
                            simpa [SourceResultStoreContains.loopPostSuccessResult,
                              hEvalResult, hZero, hBodyResult, hPostResult,
                              loopInput] using
                              SourceResultStoreContains.loop_post_success
                                (layout := layout) (fuel := fuel)
                                (cond := cond) (post := post)
                                (body := body)
                                (codeOverride := codeOverride)
                                (state := (.Ok shared store))
                                (stateAfterPost := stateAfterPost)
                                hStateOk hLoopInputContains hLoopContains
                | Ok sharedBody storeBody =>
                    have hPostContains :
                        SourceResultStoreContains layout
                          (EvmYul.Yul.exec fuel (.Block post) codeOverride
                            (EvmYul.Yul.State.reviveJump
                              (.Ok sharedBody storeBody))) := by
                      simpa [EvmYul.Yul.State.reviveJump] using
                        hPost
                          (by
                            simpa [StateStoreContains] using
                              hBodyStateContains)
                    cases hPostResult :
                        EvmYul.Yul.exec fuel (.Block post) codeOverride
                          (EvmYul.Yul.State.reviveJump
                            (.Ok sharedBody storeBody)) with
                    | error err =>
                        simp [hEvalResult, hZero, hBodyResult, hPostResult,
                          SourceResultStoreContains]
                    | ok stateAfterPost =>
                        have hPostStateContains :
                            StateStoreContains layout stateAfterPost :=
                          SourceResultStoreContains.state_of_ok
                            hPostContains hPostResult
                        let loopInput : State :=
                          EvmYul.Yul.State.overwrite? stateAfterPost
                            (.Ok shared store)
                        have hLoopInputContains :
                            StateStoreContains layout loopInput := by
                          dsimp [loopInput]
                          exact
                            StateStoreContains.overwrite?
                              hPostStateContains hStateOk
                        have hLoopContains :
                            SourceResultStoreContains layout
                              (EvmYul.Yul.exec fuel (.For cond post body)
                                codeOverride loopInput) :=
                          SourceResultStoreContains.exec_for_of_loop_input
                            (layout := layout) (fuel := fuel) (cond := cond)
                            (post := post) (body := body)
                            (codeOverride := codeOverride)
                            (loopInput := loopInput) hLoopInputContains
                            (fun hAllowed =>
                              hRecur hLoopInputContains hAllowed)
                        simpa [SourceResultStoreContains.loopPostSuccessResult,
                          hEvalResult, hZero, hBodyResult, hPostResult,
                          loopInput] using
                          SourceResultStoreContains.loop_post_success
                            (layout := layout) (fuel := fuel) (cond := cond)
                            (post := post) (body := body)
                            (codeOverride := codeOverride)
                            (state := (.Ok shared store))
                            (stateAfterPost := stateAfterPost)
                            hStateOk hLoopInputContains hLoopContains

theorem SourceResultStoreContains.exec_execSeq_ok_of_safe_primitiveFamilies :
    ∀ fuel,
      (∀ {layout : List Name} {stmt : AstStmt}
        {codeOverride : Option AstContract}
        {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore},
        Safe.stmt stmt →
        StoreDomainContains layout store →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel stmt codeOverride (.Ok shared store))) ∧
      (∀ {layout : List Name} {stmts : List AstStmt}
        {codeOverride : Option AstContract}
        {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore},
        Safe.stmts stmts →
        StoreDomainContains layout store →
        SourceResultStoreContains layout
          (EvmYul.Yul.execSeq fuel stmts codeOverride
            (.Ok shared store))) := by
  intro fuel
  induction fuel using Nat.strong_induction_on with
  | h fuel ih =>
      cases fuel with
      | zero =>
          constructor
          · intro layout stmt codeOverride shared store _hSafe _hContains
            simp [EvmYul.Yul.exec, SourceResultStoreContains,
              StateStoreContains]
          · intro layout stmts codeOverride shared store _hSafe _hContains
            simp [EvmYul.Yul.execSeq, SourceResultStoreContains,
              StateStoreContains]
      | succ fuelPred =>
          have ihPred := ih fuelPred (Nat.lt_succ_self fuelPred)
          constructor
          · intro layout stmt codeOverride shared store hSafe hContains
            have hState :
                StateStoreContains layout (.Ok shared store) := by
              simpa [StateStoreContains] using hContains
            cases stmt with
            | Block body =>
                exact
                  SourceResultStoreContains.exec_block_succ_of_execSeq
                    (layout := layout) (fuel := fuelPred) (stmts := body)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hContains
                    ((ihPred).2
                      (by simpa [Safe.stmt] using hSafe) hContains)
            | Let names value? =>
                cases value? with
                | none =>
                    exact
                      SourceResultStoreContains.exec_let_none_succ_of_state
                        (layout := layout) (fuel := fuelPred)
                        (names := names) (codeOverride := codeOverride)
                        (state := .Ok shared store) hState
                | some value =>
                    exact
                      SourceResultStoreContains.exec_let_some_succ_of_evalValues
                        (layout := layout) (fuel := fuelPred)
                        (names := names) (value := value)
                        (codeOverride := codeOverride)
                        (state := .Ok shared store)
                        (StoreDomainExpressionSound.of_primitive_families.evalValues
                          (layout := layout) (fuel := fuelPred)
                          (expr := value) (codeOverride := codeOverride)
                          (state := .Ok shared store)
                          (by simpa [Safe.stmt] using hSafe) hState)
            | Assign names value =>
                exact
                  SourceResultStoreContains.exec_assign_succ_of_evalValues
                    (layout := layout) (fuel := fuelPred)
                    (names := names) (value := value)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store)
                    (StoreDomainExpressionSound.of_primitive_families.evalValues
                      (layout := layout) (fuel := fuelPred)
                      (expr := value) (codeOverride := codeOverride)
                      (state := .Ok shared store)
                      (by simpa [Safe.stmt] using hSafe) hState)
            | ExprStmtCall value =>
                exact
                  StoreDomainExpressionSound.of_primitive_families.exprStmtCall
                    (layout := layout) (fuel := fuelPred.succ)
                    (expr := value) (codeOverride := codeOverride)
                    (state := .Ok shared store)
                    (by simpa [Safe.stmt] using hSafe) hState
            | Switch cond cases defaultBody =>
                rcases hSafe with ⟨hCondSafe, hCasesSafe, hDefaultSafe⟩
                have hEvalContains :
                    SourcePairResultStoreContains layout
                      (EvmYul.Yul.eval fuelPred cond codeOverride
                        (.Ok shared store)) :=
                  StoreDomainExpressionSound.of_primitive_families.eval
                    (layout := layout) (fuel := fuelPred) (expr := cond)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hCondSafe hState
                exact
                  SourceResultStoreContains.exec_switch_succ_of_eval_and_case
                    (layout := layout) (fuel := fuelPred) (cond := cond)
                    (cases := cases) (defaultBody := defaultBody)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hEvalContains
                    (by
                      intro stateAfter value hEval
                      have hCondCases :=
                        eval_ok_or_outOfFuel_domain_contains_of_safe_primitiveFamilies
                          (layout := layout) (fuel := fuelPred)
                          (expr := cond) (codeOverride := codeOverride)
                          (shared := shared) (store := store)
                          (stateAfter := stateAfter) (value := value)
                          hCondSafe hContains hEval
                      have hSelectedSafe :
                          Safe.stmts
                            (EvmYul.Yul.selectSwitchCase value defaultBody
                              cases) :=
                        safe_cases_selectSwitchCase
                          (value := value) hCasesSafe hDefaultSafe
                      cases hCondCases with
                      | inl hOutOfFuel =>
                          subst stateAfter
                          cases hBlock :
                              EvmYul.Yul.exec fuelPred
                                (.Block
                                  (EvmYul.Yul.selectSwitchCase value
                                    defaultBody cases))
                                codeOverride .OutOfFuel with
                          | error err =>
                              simp [hBlock, SourceResultStoreContains]
                          | ok stateAfterBlock =>
                              have hBlockEq :
                                  stateAfterBlock = .OutOfFuel :=
                                exec_block_outOfFuel_state_eq_of_safe_primitiveFamilies
                                  (by simpa [Safe.stmt] using hSelectedSafe)
                                  hBlock
                              subst stateAfterBlock
                              simp [hBlock, SourceResultStoreContains,
                                StateStoreContains]
                      | inr hOk =>
                          rcases hOk with
                            ⟨sharedAfter, storeAfter, hStateEq,
                              hStoreContains⟩
                          subst stateAfter
                          exact
                            (ihPred).1
                              (stmt :=
                                .Block
                                  (EvmYul.Yul.selectSwitchCase value
                                    defaultBody cases))
                              (codeOverride := codeOverride)
                              (shared := sharedAfter) (store := storeAfter)
                              (by simpa [Safe.stmt] using hSelectedSafe)
                              hStoreContains)
            | For cond post body =>
                rcases hSafe with ⟨hCondSafe, hPostSafe, hBodySafe⟩
                cases fuelPred with
                | zero =>
                    simp [EvmYul.Yul.exec, EvmYul.Yul.loop,
                      SourceResultStoreContains, StateStoreContains]
                | succ fuel1 =>
                    cases fuel1 with
                    | zero =>
                        simp [EvmYul.Yul.exec, EvmYul.Yul.loop,
                          SourceResultStoreContains, StateStoreContains]
                    | succ sourceFuel =>
                        rw [Imported.exec_for_succ]
                        exact
                          SourceResultStoreContains.loop_succ_succ_of_ok_or_outOfFuel_parts
                            (layout := layout) (fuel := sourceFuel)
                            (cond := cond) (post := post) (body := body)
                            (codeOverride := codeOverride)
                            (shared := shared) (store := store) hContains
                            (StoreDomainExpressionSound.of_primitive_families.eval
                              (layout := layout) (fuel := sourceFuel)
                              (expr := cond) (codeOverride := codeOverride)
                              (state := .Ok shared store) hCondSafe hState)
                            (fun hEval =>
                              eval_ok_or_outOfFuel_domain_contains_of_safe_primitiveFamilies
                                (layout := layout) (fuel := sourceFuel)
                                (expr := cond) (codeOverride := codeOverride)
                                (shared := shared) (store := store)
                                hCondSafe hContains hEval)
                            hBodySafe
                            (fun hEval hNonzero hCondContains =>
                              (ih sourceFuel (by omega)).1
                                (stmt := .Block body)
                                (codeOverride := codeOverride)
                                (by simpa [Safe.stmt] using hBodySafe)
                                hCondContains)
                            (fun hPostContains =>
                              (ih sourceFuel (by omega)).1
                                (stmt := .Block post)
                                (codeOverride := codeOverride)
                                (by simpa [Safe.stmt] using hPostSafe)
                                hPostContains)
                            (by
                              intro loopInput hLoopInputContains hAllowed
                              cases loopInput with
                              | Ok sharedLoop storeLoop =>
                                  exact
                                    (ih sourceFuel (by omega)).1
                                      (stmt := .For cond post body)
                                      (codeOverride := codeOverride)
                                      (shared := sharedLoop)
                                      (store := storeLoop)
                                      (by
                                        simpa [Safe.stmt] using
                                          And.intro hCondSafe
                                            (And.intro hPostSafe hBodySafe))
                                      (by
                                        simpa [StateStoreContains] using
                                          hLoopInputContains)
                              | OutOfFuel =>
                                  cases hLoop :
                                      EvmYul.Yul.exec sourceFuel
                                        (.For cond post body) codeOverride
                                        .OutOfFuel with
                                  | error err =>
                                      simp [hLoop, SourceResultStoreContains]
                                  | ok stateAfterLoop =>
                                      have hLoopEq :
                                          stateAfterLoop = .OutOfFuel :=
                                        exec_outOfFuel_state_eq_of_safe_primitiveFamilies
                                          (stmt := .For cond post body)
                                          (codeOverride := codeOverride)
                                          (by
                                            simpa [Safe.stmt] using
                                              And.intro hCondSafe
                                                (And.intro hPostSafe
                                                  hBodySafe))
                                          hLoop
                                      subst stateAfterLoop
                                      simp [hLoop, SourceResultStoreContains,
                                        StateStoreContains]
                              | Checkpoint jump =>
                                  cases jump <;>
                                    simp [StateCheckpointAllowed] at hAllowed)
            | If cond body =>
                rcases hSafe with ⟨hCondSafe, hBodySafe⟩
                have hEvalContains :
                    SourcePairResultStoreContains layout
                      (EvmYul.Yul.eval fuelPred cond codeOverride
                        (.Ok shared store)) :=
                  StoreDomainExpressionSound.of_primitive_families.eval
                    (layout := layout) (fuel := fuelPred) (expr := cond)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hCondSafe hState
                exact
                  SourceResultStoreContains.exec_if_succ_of_eval_and_body
                    (layout := layout) (fuel := fuelPred) (cond := cond)
                    (body := body) (codeOverride := codeOverride)
                    (state := .Ok shared store) hEvalContains
                    (by
                      intro stateAfter value hEval _hNonzero
                      have hCondCases :=
                        eval_ok_or_outOfFuel_domain_contains_of_safe_primitiveFamilies
                          (layout := layout) (fuel := fuelPred)
                          (expr := cond) (codeOverride := codeOverride)
                          (shared := shared) (store := store)
                          (stateAfter := stateAfter) (value := value)
                          hCondSafe hContains hEval
                      cases hCondCases with
                      | inl hOutOfFuel =>
                          subst stateAfter
                          cases hBlock :
                              EvmYul.Yul.exec fuelPred (.Block body)
                                codeOverride .OutOfFuel with
                          | error err =>
                              simp [hBlock, SourceResultStoreContains]
                          | ok stateAfterBlock =>
                              have hBlockEq :
                                  stateAfterBlock = .OutOfFuel :=
                                exec_block_outOfFuel_state_eq_of_safe_primitiveFamilies
                                  (by simpa [Safe.stmt] using hBodySafe)
                                  hBlock
                              subst stateAfterBlock
                              simp [hBlock, SourceResultStoreContains,
                                StateStoreContains]
                      | inr hOk =>
                          rcases hOk with
                            ⟨sharedAfter, storeAfter, hStateEq,
                              hStoreContains⟩
                          subst stateAfter
                          exact
                            (ihPred).1 (stmt := .Block body)
                              (codeOverride := codeOverride)
                              (shared := sharedAfter) (store := storeAfter)
                              (by simpa [Safe.stmt] using hBodySafe)
                              hStoreContains)
            | Continue =>
                exact
                  SourceResultStoreContains.exec_continue_succ
                    (layout := layout) (fuel := fuelPred)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hState
            | Break =>
                exact
                  SourceResultStoreContains.exec_break_succ
                    (layout := layout) (fuel := fuelPred)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hState
            | Leave =>
                exact
                  SourceResultStoreContains.exec_leave_succ
                    (layout := layout) (fuel := fuelPred)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hState
          · intro layout stmts codeOverride shared store hSafe hContains
            have hState :
                StateStoreContains layout (.Ok shared store) := by
              simpa [StateStoreContains] using hContains
            cases stmts with
            | nil =>
                exact
                  SourceResultStoreContains.execSeq_nil_succ
                    (layout := layout) (fuel := fuelPred)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hState
            | cons head tail =>
                rcases hSafe with ⟨hHeadSafe, hTailSafe⟩
                have hHeadContains :
                    SourceResultStoreContains layout
                      (EvmYul.Yul.exec fuelPred head codeOverride
                        (.Ok shared store)) :=
                  (ihPred).1 hHeadSafe hContains
                exact
                  SourceResultStoreContains.execSeq_cons_succ
                    (layout := layout) (fuel := fuelPred)
                    (stmt := head) (rest := tail)
                    (codeOverride := codeOverride)
                    (state := .Ok shared store) hHeadContains
                    (by
                      intro sharedHead storeHead hHeadOk
                      have hHeadStateContains :
                          StateStoreContains layout
                            (.Ok sharedHead storeHead) :=
                        SourceResultStoreContains.state_of_ok
                          hHeadContains hHeadOk
                      have hStoreContains :
                          StoreDomainContains layout storeHead := by
                        simpa [StateStoreContains] using
                          hHeadStateContains
                      exact
                        (ihPred).2
                          (layout := layout) (stmts := tail)
                          (codeOverride := codeOverride)
                          (shared := sharedHead) (store := storeHead)
                          hTailSafe hStoreContains)

theorem SourceResultStoreContains.exec_ok_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {stmt : AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    (hSafe : Safe.stmt stmt)
    (hContains : StoreDomainContains layout store) :
    SourceResultStoreContains layout
      (EvmYul.Yul.exec fuel stmt codeOverride (.Ok shared store)) :=
  (SourceResultStoreContains.exec_execSeq_ok_of_safe_primitiveFamilies fuel).1
    hSafe hContains

theorem SourceResultStoreContains.execSeq_ok_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {stmts : List AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    (hSafe : Safe.stmts stmts)
    (hContains : StoreDomainContains layout store) :
    SourceResultStoreContains layout
      (EvmYul.Yul.execSeq fuel stmts codeOverride (.Ok shared store)) :=
  (SourceResultStoreContains.exec_execSeq_ok_of_safe_primitiveFamilies fuel).2
    hSafe hContains

theorem evalValues_lit_ok_store_eq
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {values : List Word} {value : Word}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (hEval :
      EvmYul.Yul.evalValues fuel.succ (.Lit value) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values)) :
    storeAfter = store := by
  simp [EvmYul.Yul.evalValues] at hEval
  exact hEval.1.2.symm

theorem evalValues_var_ok_store_eq
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {values : List Word} {name : EvmYul.Identifier}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (hEval :
      EvmYul.Yul.evalValues fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values)) :
    storeAfter = store := by
  cases hLookup : EvmYul.Yul.State.lookup? name (.Ok shared store) with
  | none =>
      simp [EvmYul.Yul.evalValues, hLookup] at hEval
  | some value =>
      simp [EvmYul.Yul.evalValues, hLookup] at hEval
      exact hEval.1.2.symm

theorem evalValues_lit_ok_domain_exact
    {layout : List Name}
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {values : List Word} {value : Word}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (hDomain : StoreDomainExact layout store)
    (hEval :
      EvmYul.Yul.evalValues fuel.succ (.Lit value) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values)) :
    StoreDomainExact layout storeAfter := by
  rw [evalValues_lit_ok_store_eq hEval]
  exact hDomain

theorem evalValues_var_ok_domain_exact
    {layout : List Name}
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {values : List Word} {name : EvmYul.Identifier}
