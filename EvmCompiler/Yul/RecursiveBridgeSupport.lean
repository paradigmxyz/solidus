varstore, `checkDeclaration` reports the duplicate declaration.
-/
theorem checkDeclaration_error_singleton_of_declared
    {name : EvmYul.Identifier} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {value : Word}
    (hDeclared : store.lookup (identName name) = some value) :
    EvmYul.Yul.checkDeclaration (.Ok shared store) [name] =
      .error (.DuplicateDeclaration name) := by
  have hFirstDup :
      EvmYul.Yul.firstDuplicate? ([name] : List EvmYul.Identifier) = none := by
    rfl
  have hLookup :
      (.Ok shared store : State).lookup? name = some value := by
    simpa [EvmYul.Yul.State.lookup?, identName] using hDeclared
  have hFirstDecl :
      EvmYul.Yul.firstDeclared? (.Ok shared store)
          ([name] : List EvmYul.Identifier) = some name := by
    unfold EvmYul.Yul.firstDeclared?
    simp [hLookup]
  simp [EvmYul.Yul.checkDeclaration, hFirstDup, hFirstDecl]

