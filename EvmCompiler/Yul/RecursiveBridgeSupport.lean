    (args := args.reverse) (safe_exprs_reverse hSafe) hDomain hEval

theorem evalValues_evalArgs_outOfFuel_state_eq_of_safe_primitiveFamilies
    (fuel : Nat) :
    (∀ {expr : AstExpr} {codeOverride : Option AstContract}
      {stateAfter : State} {values : List Word},
      Safe.expr expr →
      EvmYul.Yul.evalValues fuel expr codeOverride .OutOfFuel =
        .ok (stateAfter, values) →
      stateAfter = .OutOfFuel) ∧
    (∀ {args : List AstExpr} {codeOverride : Option AstContract}
      {stateAfter : State} {values : List Word},
      Safe.exprs args →
      EvmYul.Yul.evalArgs fuel args codeOverride .OutOfFuel =
        .ok (stateAfter, values) →
      stateAfter = .OutOfFuel) := by
  refine Nat.strong_induction_on fuel ?_
  intro fuel ih
  cases fuel with
  | zero =>
      constructor
      · intro expr codeOverride stateAfter values _hSafe hEval
        simp [EvmYul.Yul.evalValues] at hEval
      · intro args codeOverride stateAfter values _hSafe hEval
        simp [EvmYul.Yul.evalArgs] at hEval
  | succ fuel' =>
      have ihFuel := ih fuel' (Nat.lt_succ_self fuel')
      constructor
      · intro expr codeOverride stateAfter values hSafe hEval
        cases expr with
        | Lit value =>
            simp [EvmYul.Yul.evalValues] at hEval
            exact hEval.1.symm
        | Var name =>
            simp [EvmYul.Yul.evalValues, EvmYul.Yul.State.lookup?] at hEval
        | Call callee args =>
            cases callee with
            | inl prim =>
                have hSafePrim : Safe.primitive prim := hSafe.1
                have hSafeArgs : Safe.exprs args := hSafe.2
                cases hArgsRaw :
                    EvmYul.Yul.evalArgs fuel' args.reverse codeOverride
                      .OutOfFuel with
                | error err =>
                    simp [EvmYul.Yul.evalValues, hArgsRaw,
                      EvmYul.Yul.reverse'] at hEval
                | ok argPair =>
                    rcases argPair with ⟨stateArgs, argValuesRaw⟩
                    have hArgsEq : stateArgs = .OutOfFuel :=
                      ihFuel.2 (args := args.reverse)
                        (codeOverride := codeOverride)
                        (stateAfter := stateArgs)
                        (values := argValuesRaw)
                        (safe_exprs_reverse hSafeArgs) hArgsRaw
                    subst stateArgs
                    cases hCall :
                        EvmYul.Yul.primCall fuel' .OutOfFuel prim
                          argValuesRaw.reverse with
                    | error err =>
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                    | ok callPair =>
                        rcases callPair with ⟨stateCall, valuesCall⟩
                        have hCallEq : stateCall = .OutOfFuel :=
                          primCall_safe_nonOk_state_eq_of_ok
                            (state := .OutOfFuel) hSafePrim
                            (by intro shared store h; cases h)
                            hCall
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst stateAfter
                        exact hCallEq
            | inr functionName =>
                have hSafeArgs : Safe.exprs args := hSafe.2
                cases hArgsRaw :
                    EvmYul.Yul.evalArgs fuel' args.reverse codeOverride
                      .OutOfFuel with
                | error err =>
                    simp [EvmYul.Yul.evalValues, hArgsRaw,
                      EvmYul.Yul.reverse'] at hEval
                | ok argPair =>
                    rcases argPair with ⟨stateArgs, argValuesRaw⟩
                    have hArgsEq : stateArgs = .OutOfFuel :=
                      ihFuel.2 (args := args.reverse)
                        (codeOverride := codeOverride)
                        (stateAfter := stateArgs)
                        (values := argValuesRaw)
                        (safe_exprs_reverse hSafeArgs) hArgsRaw
                    subst stateArgs
                    cases hCall :
                        EvmYul.Yul.call fuel' argValuesRaw.reverse
                          functionName codeOverride .OutOfFuel with
                    | error err =>
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                    | ok callPair =>
                        rcases callPair with ⟨stateCall, valuesCall⟩
                        have hCallEq : stateCall = .OutOfFuel :=
                          call_outOfFuel_state_eq_of_ok hCall
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst stateAfter
                        exact hCallEq
      · intro args codeOverride stateAfter values hSafe hEval
        cases args with
        | nil =>
            simp [EvmYul.Yul.evalArgs] at hEval
            exact hEval.1.symm
        | cons head tail =>
            have hHeadSafe : Safe.expr head := hSafe.1
            have hTailSafe : Safe.exprs tail := hSafe.2
            cases hHead :
                EvmYul.Yul.eval fuel' head codeOverride .OutOfFuel with
            | error err =>
                simp [EvmYul.Yul.evalArgs, hHead,
                  EvmYul.Yul.evalTail] at hEval
            | ok headPair =>
                rcases headPair with ⟨stateHead, headValue⟩
                cases fuel' with
                | zero =>
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail] at hEval
                | succ fuelTail =>
                    have ihTail :=
                      ih fuelTail
                        (Nat.lt_trans (Nat.lt_succ_self fuelTail)
                          (Nat.lt_succ_self (Nat.succ fuelTail)))
                    have hHeadEq : stateHead = .OutOfFuel := by
                      cases hValues :
                          EvmYul.Yul.evalValues (Nat.succ fuelTail) head
                            codeOverride .OutOfFuel with
                      | error err =>
                          simp [EvmYul.Yul.eval, EvmYul.Yul.head', hValues]
                            at hHead
                      | ok pair =>
                          rcases pair with ⟨stateValues, valueList⟩
                          have hValuesEq : stateValues = .OutOfFuel :=
                            ihFuel.1 (expr := head)
                              (codeOverride := codeOverride)
                              (stateAfter := stateValues)
                              (values := valueList) hHeadSafe hValues
                          simp [EvmYul.Yul.eval, EvmYul.Yul.head', hValues]
                            at hHead
                          rcases hHead with ⟨hState, _hValue⟩
                          subst stateHead
                          exact hValuesEq
                    subst stateHead
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail, EvmYul.Yul.cons'] at hEval
                    cases hTail :
                        EvmYul.Yul.evalArgs fuelTail tail codeOverride
                          .OutOfFuel with
                    | error err =>
                        simp [hTail] at hEval
                    | ok tailPair =>
                        rcases tailPair with ⟨stateTail, tailValues⟩
                        have hTailEq : stateTail = .OutOfFuel :=
                          ihTail.2 (args := tail)
                            (codeOverride := codeOverride)
                            (stateAfter := stateTail)
                            (values := tailValues) hTailSafe hTail
                        simp [hTail] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst stateAfter
                        exact hTailEq

theorem evalValues_outOfFuel_state_eq_of_safe_primitiveFamilies
    {fuel : Nat} {expr : AstExpr} {codeOverride : Option AstContract}
