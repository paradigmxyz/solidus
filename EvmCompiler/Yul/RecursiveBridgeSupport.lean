        (allowed := allowed) (prim := prim) (program := program)
        (canBreak := canBreak) (canContinue := canContinue)
        (canLeave := canLeave) (fuel := sourceFuel) (loopFuel := loopFuel)
        (cond := cond) (post := post) (body := body)
        (codeOverride := codeOverride) (lowerPost := lowerPost)
        (generatedBody :=
          { stmts :=
              pre ++
                [Functions.Stmt.if_
                  (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                  { stmts := [Functions.Stmt.brk] }] ++
                lowerBody.stmts })
        (shared := sharedAfterPost) (store := storeAfterPost)
        (compiler := compilerAfterPost) (loopTrace := loopTrace)
        (sourceDone := sourceResult)
        hScopeContains hSafe hScoped hSourceInnerLoop hAllowed hLoopPath with
    ⟨loopOutcome, hTargetLoop, hLoopMode, hDone⟩
  have hTargetFuelBound :
      minimumTargetFuel ≤
        (Nat.max
          (Nat.max
            (pre.length + Nat.max rawFuel (1 + Nat.max bodyFuel 1))
            postFuel)
          loopFuel).succ.succ := by
    have hLoopLeMax :
        loopFuel ≤
          Nat.max
            (Nat.max
              (pre.length + Nat.max rawFuel (1 + Nat.max bodyFuel 1))
              postFuel)
            loopFuel :=
      Nat.le_max_right _ _
    omega
  refine
    ⟨(Nat.max
        (Nat.max
          (pre.length + Nat.max rawFuel (1 + Nat.max bodyFuel 1))
          postFuel)
        loopFuel).succ.succ, hTargetFuelBound, ?_⟩
  exact
    sourceOpenLoopHeadPathRel_generated_nonzero_body_continue_post_regular_loop
      (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
      (terminalRel := terminalRel) (revertRel := revertRel)
      (allowed := allowed) (prim := prim) (program := program) (ctx := ctx)
      (sourceFuel := sourceFuel) (rawFuel := rawFuel)
      (bodyFuel := bodyFuel) (postFuel := postFuel)
      (loopFuel := loopFuel) (cond := cond) (post := post) (body := body)
      (codeOverride := codeOverride) (shared := shared)
      (sharedAfterCond := sharedAfterCond) (store := store)
      (storeAfterCond := storeAfterCond) (compiler := compiler)
      (compilerAfterBody := compilerAfterBody)
      (compilerAfterPost := compilerAfterPost) (pre := pre)
      (lowerCond := lowerCond) (lowerPost := lowerPost)
      (lowerBody := lowerBody) (value := value) (condTrace := condTrace)
      (bodyTrace := bodyTrace) (postTrace := postTrace)
      (loopTrace := loopTrace) (sourceResult := sourceResult)
