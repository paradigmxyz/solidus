  refine ⟨hSound.1, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hSound.2 hInitial hAllow hSource with
    ⟨sourceOutcome, targetFuel, hTarget, hRel⟩
  exact
    ⟨sourceOutcome, targetFuel, hTarget,
      SourceResultOutcomeRel.relayout_of_compatible_no_checkpoint
