            simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
              Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
              Locals.Source.Expr.eval, Locals.Source.State.insert,
              VarStackRel.zeroWord, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular],
          (by intro other hMem; simp [hMem]),
          SourceStateExactRel.ok hShared
            (sourceStoreRel_cons_insert hVars hFresh)
            (StoreDomainExact.insert hDomain)⟩

/--
Hidden-context regular head bridge for `let x := literal`.
-/
theorem sourceRegularStmtRunHiddenExact_let_lit_single
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} (name : EvmYul.Identifier)
    (value : Word) (codeOverride : Option AstContract)
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hFresh : identName name ∉ layout) :
    SourceRegularStmtRunHiddenExact cfg layout (identName name :: layout)
      prim program ctx sourceFuel.succ.succ
      (.Let [name] (some (.Lit value))) codeOverride
      (.Ok shared store) compiler
      { stmts := [Functions.Stmt.let_ (identName name) (.lit value)] } := by
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomain =>
      have hCheck :
          EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok () :=
        StoreDomainExact.checkDeclaration_ok
          (layout := layout) (store := store) (shared := shared)
          (names := [name]) hDomain (by simp [identNames])
          (by
            intro other hOther
            simp [identNames] at hOther
            simpa [hOther] using hFresh)
      have hSourceHead :
          EvmYul.Yul.exec sourceFuel.succ.succ
              (.Let [name] (some (.Lit value))) codeOverride
              (.Ok shared store) =
            .ok (.Ok shared (store.insert (identName name) value)) := by
        rw [Imported.exec_let_lit_succ]
        simp [hCheck, identName, EvmYul.Yul.evalValues,
          EvmYul.Yul.multifill', EvmYul.Yul.State.multifill,
          EvmYul.Yul.State.insert]
      exact
        ⟨.Ok shared (store.insert (identName name) value),
          compiler.insert (identName name) value,
          { ctx with scope := identName name :: ctx.scope }, 2,
          hSourceHead,
          by
            simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
              Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
              Locals.Source.Expr.eval, Locals.Source.State.insert,
              Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular],
          (by intro other hMem; simp [hMem]),
          SourceStateExactRel.ok hShared
            (sourceStoreRel_cons_insert hVars hFresh)
            (StoreDomainExact.insert hDomain)⟩

/--
Hidden-context regular head bridge for `let x := y`.
-/
theorem sourceRegularStmtRunHiddenExact_let_var_single
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} (name sourceName : EvmYul.Identifier)
    (codeOverride : Option AstContract)
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hFresh : identName name ∉ layout)
    (hSourceMem : identName sourceName ∈ layout) :
    SourceRegularStmtRunHiddenExact cfg layout (identName name :: layout)
      prim program ctx sourceFuel.succ.succ
      (.Let [name] (some (.Var sourceName))) codeOverride
      (.Ok shared store) compiler
      { stmts :=
          [Functions.Stmt.let_ (identName name)
            (.var (identName sourceName))] } := by
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomain =>
      have hCheck :
          EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok () :=
        StoreDomainExact.checkDeclaration_ok
          (layout := layout) (store := store) (shared := shared)
          (names := [name]) hDomain (by simp [identNames])
          (by
            intro other hOther
            simp [identNames] at hOther
            simpa [hOther] using hFresh)
      have hSourceSome :
          (store.lookup (identName sourceName)).isSome = true :=
        StoreDomainExact.contains_of_mem hDomain hSourceMem
      cases hLookupSource : store.lookup (identName sourceName) with
      | none =>
          simp [hLookupSource] at hSourceSome
      | some value =>
          have hLookupSource' :
              Finmap.lookup sourceName store = some value := by
            simpa [identName] using hLookupSource
          have hSourceHead :
              EvmYul.Yul.exec sourceFuel.succ.succ
                  (.Let [name] (some (.Var sourceName))) codeOverride
                  (.Ok shared store) =
                .ok (.Ok shared (store.insert (identName name) value)) := by
            rw [Imported.exec_let_var_succ]
            simp [hCheck, EvmYul.Yul.evalValues,
              EvmYul.Yul.State.lookup?, hLookupSource', identName,
              EvmYul.Yul.multifill', EvmYul.Yul.State.multifill]
            rfl
          have hCompilerSource :
              compiler.vars (identName sourceName) = some value := by
            simpa [hLookupSource] using
              hVars (identName sourceName) hSourceMem
          exact
            ⟨.Ok shared (store.insert (identName name) value),
              compiler.insert (identName name) value,
              { ctx with scope := identName name :: ctx.scope }, 2,
              hSourceHead,
              by
                simp [Functions.Source.Block.runOpen,
                  Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
                  Locals.Source.Expr.evalOne, Locals.Source.Expr.eval,
                  Locals.Source.State.insert, hCompilerSource,
                  Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular],
              (by intro other hMem; simp [hMem]),
              SourceStateExactRel.ok hShared
                (sourceStoreRel_cons_insert hVars hFresh)
                (StoreDomainExact.insert hDomain)⟩

/--
Result sequence soundness where the target context may contain hidden
compiler-only locals in addition to the source-visible `layout`.

The ordinary exact result-sequence interface requires `ctx.scope = layout`.
That is too strong after generated argument preludes, because the compiler
context remembers generated temporaries that the imported Yul varstore never
sees. This hidden-context interface is the compositional bridge for those
tails: source-state exactness is still stated over the source-visible layout,
and the observable result relation is unchanged.
-/
def SourceResultSeqSoundWhenAtExactHiddenCtx (cfg : StateRelConfig)
    (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) : Prop :=
  ∀ {source compiler sourceResult},
    SourceStateExactRel cfg layout source compiler →
    allowed sourceResult →
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      sourceResult →
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel,
      Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
          compiler =
        .ok (sourceOutcome, ctxAfter) ∧
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        sourceResult sourceOutcome

theorem SourceResultSeqSoundWhenAtExactHiddenCtx.of_seqKont_block_same
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hSeq :
      SourceResultSeqKontSoundWhenAtExactHiddenCtx cfg layout
        (SourceModeKontLayouts.block layout layout)
        terminalRel revertRel prim program ctx sourceFuel sourceStmts
        codeOverride lowerBlock allowed) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout layout
      terminalRel revertRel prim program ctx sourceFuel sourceStmts
      codeOverride lowerBlock allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hSeq hInitial hAllow hSource with
    ⟨sourceOutcome, ctxAfter, targetFuel, hRun, hRel⟩
  exact
    ⟨sourceOutcome, ctxAfter, targetFuel, hRun,
      SourceResultKontOutcomeRel.to_outcome_block_same hRel⟩

