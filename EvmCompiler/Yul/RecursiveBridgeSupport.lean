    (hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel stmt codeOverride (.Ok shared store)))
        trace (.ok (.Checkpoint (.Break sharedAfter storeAfter)))) :
    False := by
  have hContains : StoreDomainContains [] store := by
    intro name hMem
    cases hMem
  have hInv :
      OpenResultDoneInvariant
        (YulOpenStateDoneInv
          (StateCheckpointStoreContains [] false false canLeave))
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel stmt codeOverride
            (.Ok shared store))) :=
    yulOpenExec_ok_toOpenResult_doneInvariant_checkpointStoreContains_of_callSafe_scoped
      (stmt := stmt) hSafe hScoped
      hContains
  have hAllowed :
      StateCheckpointAllowed false false canLeave
        (.Checkpoint (.Break sharedAfter storeAfter)) :=
    (OpenResultDoneInvariant.of_resolves hInv hResolve).1
  simpa [StateCheckpointAllowed] using hAllowed

