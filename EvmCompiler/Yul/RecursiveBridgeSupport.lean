        layoutMid prim program ctx sourceFuel targetFuel head codeOverride)
    (hTail :
      ∀ {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        CheckedSeqLoweringSoundWhenFreshNamesAtCompileFuelExact cfg reserved
          layoutMid ctxAfterLayout outcomeLayout terminalRel revertRel prim
