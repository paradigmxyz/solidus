                        hSharedAfter hVarsAfter =>
                        have hRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (Locals.Source.State.restrictTo layout
                                compilerAfter) := by
                          exact
                            sourceStateRel_restrictStoreTo_of_domain
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hDomain (fun name hMem => hMem)
                        simpa [outerOutcome, wrap, hResult] using
                          (SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular hRestricted))
                | brk hRelState =>
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
                        (cfg := cfg) (layout := layout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        hDomain
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.brk hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | cont hRelState =>
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
                        (cfg := cfg) (layout := layout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        hDomain
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.cont hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | leave hRelState =>
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
                        (cfg := cfg) (layout := layout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        hDomain
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.leave hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
      exact ⟨outerOutcome, targetFuel.succ, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

/-
Close an exact open-sequence bridge into an exact scoped-block bridge.

This is the source-facing block abstraction step: the imported side runs the
