  induction left with
  | nil =>
      exact ⟨trivial, by simpa using hHolds⟩
  | cons head tail ih =>
      have hParts :
          Functions.LiveLayout.NoInternalCall.Stmt.Holds head ∧
            Functions.LiveLayout.NoInternalCall.StmtList.Holds
