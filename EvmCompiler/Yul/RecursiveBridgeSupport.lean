theorem sourceResultOutcomeLayoutCompatible_bodyCtx_same_of_checkpoint
    {fn : Functions.FunDef} {sourceResult : Except Exception State}
    (hAllowed :
      SourceResultCheckpointAllowed false false true sourceResult) :
    SourceResultOutcomeLayoutCompatible (Functions.Source.FunDef.bodyCtx fn)
      (fn.returns ++ fn.params) (fn.returns ++ fn.params) sourceResult := by
  cases sourceResult with
  | error err =>
      simp [SourceResultOutcomeLayoutCompatible]
  | ok source =>
      cases source with
      | Ok shared store =>
          simp [SourceResultOutcomeLayoutCompatible]
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutCompatible]
      | Checkpoint jump =>
          cases jump with
          | Break shared store =>
              have hFalse : False := by
                simpa [SourceResultCheckpointAllowed,
                  StateCheckpointAllowed] using hAllowed
              exact False.elim hFalse
          | Continue shared store =>
              have hFalse : False := by
                simpa [SourceResultCheckpointAllowed,
                  StateCheckpointAllowed] using hAllowed
              exact False.elim hFalse
          | Leave shared store =>
              simp [SourceResultOutcomeLayoutCompatible,
                Functions.Source.FunDef.bodyCtx,
                Functions.Source.Ctx.withLeaveScope]

/--
Instantiate the names-aware recursive IH for a concrete successful callee body.

The recursive interface is quantified over checked lowerings and an `allowed`
filter.  User-call proofs, however, know the exact selected callee-body result.
This adapter narrows `allowed` to that singleton result, while keeping the
function-body checkpoint contract explicit.
-/
theorem sourceResultBlockSoundWhenAtExact_of_recursive_actual_ok
    {cfg : StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {bound : Nat}
    {lowerFn : Functions.FunDef}
    {body : List AstStmt} {freshBefore freshAfter : Fresh.State}
    {bodyFuel : Nat} {bodyState : State}
    {codeOverride : Option AstContract}
    (hRecursive :
      RecursiveSourceBridgeWhenUpToAtExactCompatNames cfg terminalRel
        revertRel prim program bound)
    (hFuel : bodyFuel ≤ bound)
    (hCovers :
      FreshCoversLayout (lowerFn.returns ++ lowerFn.params) freshBefore)
    (hLower :
      Stmt.List.toBlock? freshBefore body = some (lowerFn.body, freshAfter))
    (hNoOutOfFuel : bodyState ≠ .OutOfFuel)
    (hCheckpoint :
      SourceResultCheckpointAllowed false false true (.ok bodyState)) :
    SourceResultBlockSoundWhenAtExact cfg
      (lowerFn.returns ++ lowerFn.params)
      (lowerFn.returns ++ lowerFn.params) terminalRel revertRel prim program
      (Functions.Source.FunDef.bodyCtx lowerFn) bodyFuel body codeOverride
      lowerFn.body (fun candidate => candidate = .ok bodyState) := by
  have hAllowed :
      ∀ {candidate}, candidate = .ok bodyState →
        SourceResultRelatable candidate := by
    intro candidate hEq
    subst candidate
    cases bodyState <;> simp [SourceResultRelatable]
    exact hNoOutOfFuel rfl
  have hCompat :
      ∀ {candidate}, candidate = .ok bodyState →
        SourceResultOutcomeLayoutCompatible
          (Functions.Source.FunDef.bodyCtx lowerFn)
          (lowerFn.returns ++ lowerFn.params)
          (lowerFn.returns ++ lowerFn.params) candidate := by
    intro candidate hEq
    subst candidate
    exact
      sourceResultOutcomeLayoutCompatible_bodyCtx_same_of_checkpoint
        (fn := lowerFn) hCheckpoint
  have hScope :
      (Functions.Source.FunDef.bodyCtx lowerFn).scope =
        lowerFn.returns ++ lowerFn.params := by
    simp [Functions.Source.FunDef.bodyCtx]
  exact
    hRecursive.block (reserved := []) hAllowed hCompat hFuel hScope
      (by simpa using hCovers) hLower

/--
Instantiate the names-aware recursive IH for a concrete terminal callee body.

The caller must show that the imported error is one of the relatable terminal
errors (`YulHalt` or `Revert`); other errors remain resource/front-end failures
outside the normal source-tower outcome relation.
-/
theorem sourceResultBlockSoundWhenAtExact_of_recursive_actual_error
    {cfg : StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {bound : Nat}
    {lowerFn : Functions.FunDef}
    {body : List AstStmt} {freshBefore freshAfter : Fresh.State}
    {bodyFuel : Nat} {err : Exception}
    {codeOverride : Option AstContract}
    (hRecursive :
      RecursiveSourceBridgeWhenUpToAtExactCompatNames cfg terminalRel
        revertRel prim program bound)
    (hFuel : bodyFuel ≤ bound)
    (hCovers :
      FreshCoversLayout (lowerFn.returns ++ lowerFn.params) freshBefore)
    (hLower :
      Stmt.List.toBlock? freshBefore body = some (lowerFn.body, freshAfter))
    (hRelatable : SourceResultRelatable (.error err)) :
    SourceResultBlockSoundWhenAtExact cfg
      (lowerFn.returns ++ lowerFn.params)
      (lowerFn.returns ++ lowerFn.params) terminalRel revertRel prim program
      (Functions.Source.FunDef.bodyCtx lowerFn) bodyFuel body codeOverride
      lowerFn.body (fun candidate => candidate = .error err) := by
  have hAllowed :
      ∀ {candidate}, candidate = .error err →
        SourceResultRelatable candidate := by
    intro candidate hEq
    subst candidate
    exact hRelatable
  have hCompat :
      ∀ {candidate}, candidate = .error err →
        SourceResultOutcomeLayoutCompatible
          (Functions.Source.FunDef.bodyCtx lowerFn)
          (lowerFn.returns ++ lowerFn.params)
          (lowerFn.returns ++ lowerFn.params) candidate := by
    intro candidate hEq
    subst candidate
    simp [SourceResultOutcomeLayoutCompatible]
  have hScope :
      (Functions.Source.FunDef.bodyCtx lowerFn).scope =
        lowerFn.returns ++ lowerFn.params := by
    simp [Functions.Source.FunDef.bodyCtx]
  exact
    hRecursive.block (reserved := []) hAllowed hCompat hFuel hScope
      (by simpa using hCovers) hLower

/--
Program-scoped variant of
`sourceResultBlockSoundWhenAtExact_of_recursive_actual_ok`.

The callee body is executed under the concrete source program's contract, so
the program-scoped recursive bridge is sufficient and avoids the old arbitrary
`codeOverride` quantification.
-/
theorem sourceResultBlockSoundWhenAtExact_of_program_recursive_actual_ok
    {cfg : StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {yulProgram : Program} {program : Functions.Program} {bound : Nat}
    {lowerFn : Functions.FunDef}
    {body : List AstStmt} {freshBefore freshAfter : Fresh.State}
    {bodyFuel : Nat} {bodyState : State}
    (hRecursive :
      ProgramRecursiveSourceBridgeWhenUpToAtExactCompatNames cfg terminalRel
        revertRel prim yulProgram program bound)
