def PrimitiveCallStorePreservingForSafe : Prop :=
  ∀ {fuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {args values : List Word},
    Safe.primitive yulPrim →
    EvmYul.Yul.primCall fuel (.Ok shared store) yulPrim args =
      .ok (.Ok sharedAfter storeAfter, values) →
    storeAfter = store

theorem PrimitiveCallStorePreservingForSafe.of_primitive_families :
    PrimitiveCallStorePreservingForSafe := by
  intro fuel yulPrim shared sharedAfter store storeAfter args values hSafe hCall
  cases yulPrim with
  | StopArith op =>
      exact Yul.PrimSemantics.primCall_stopArith_store_eq_of_ok hCall
  | CompBit op =>
      exact Yul.PrimSemantics.primCall_compBit_store_eq_of_ok hCall
  | Keccak op =>
      exact Yul.PrimSemantics.primCall_keccak_store_eq_of_ok hCall
  | Env op =>
      have hSupported : Yul.PrimSemantics.EnvCheckpointSafe op := by
        cases op <;>
          simp [Yul.PrimSemantics.EnvCheckpointSafe, Safe.primitive]
            at hSafe ⊢
      exact Yul.PrimSemantics.primCall_env_store_eq_of_ok hSupported hCall
  | Block op =>
      exact Yul.PrimSemantics.primCall_block_store_eq_of_ok hCall
  | StackMemFlow op =>
      exact Yul.PrimSemantics.primCall_stackMemFlow_store_eq_of_ok hCall
  | Log op =>
      cases op with
      | LOG0 =>
          exact Yul.PrimSemantics.primCall_log0_store_eq_of_ok hCall
      | LOG1 =>
          exact Yul.PrimSemantics.primCall_log1_store_eq_of_ok hCall
      | LOG2 =>
          exact Yul.PrimSemantics.primCall_log2_store_eq_of_ok hCall
      | LOG3 =>
          exact Yul.PrimSemantics.primCall_log3_store_eq_of_ok hCall
      | LOG4 =>
          exact Yul.PrimSemantics.primCall_log4_store_eq_of_ok hCall
  | System op =>
      cases op with
      | CREATE =>
          simp [Safe.primitive] at hSafe
      | CALL =>
          simp [Safe.primitive] at hSafe
      | CALLCODE =>
          simp [Safe.primitive] at hSafe
      | RETURN =>
          exact False.elim
            (Yul.PrimSemantics.primCall_return_impossible_of_ok hCall)
      | DELEGATECALL =>
          simp [Safe.primitive] at hSafe
      | CREATE2 =>
          simp [Safe.primitive] at hSafe
      | STATICCALL =>
          simp [Safe.primitive] at hSafe
      | REVERT =>
          exact False.elim
            (Yul.PrimSemantics.primCall_revert_impossible_of_ok hCall)
      | INVALID =>
          exact False.elim
            (Yul.PrimSemantics.primCall_invalid_impossible_of_ok hCall)
      | SELFDESTRUCT =>
          exact False.elim
            (Yul.PrimSemantics.primCall_selfdestruct_impossible_of_ok hCall)

theorem safe_exprs_mem {args : List AstExpr} {expr : AstExpr}
    (hSafe : Safe.exprs args) (hMem : expr ∈ args) :
    Safe.expr expr := by
  induction args with
  | nil =>
      simp at hMem
  | cons head tail ih =>
      simp [Safe.exprs] at hSafe
      simp at hMem
      rcases hMem with hEq | hTail
      · simpa [hEq] using hSafe.1
      · exact ih hSafe.2 hTail

theorem safe_exprs_append {left right : List AstExpr}
    (hLeft : Safe.exprs left) (hRight : Safe.exprs right) :
    Safe.exprs (left ++ right) := by
  induction left with
  | nil =>
      simpa using hRight
  | cons head tail ih =>
      simp [Safe.exprs] at hLeft
      simp [Safe.exprs, hLeft.1, ih hLeft.2]

theorem safe_exprs_reverse {args : List AstExpr}
    (hSafe : Safe.exprs args) :
    Safe.exprs args.reverse := by
  induction args with
  | nil =>
      simp [Safe.exprs]
  | cons head tail ih =>
      simp [Safe.exprs] at hSafe
      simpa using
        safe_exprs_append (ih hSafe.2)
          (by simp [Safe.exprs, hSafe.1])

theorem family_exprs_append
    {primitive : EvmYul.Operation .Yul → Prop}
    {userCall : Name → Prop}
    {left right : List AstExpr}
    (hLeft : Safe.FeatureCoverage.Family.exprs primitive userCall left)
    (hRight : Safe.FeatureCoverage.Family.exprs primitive userCall right) :
    Safe.FeatureCoverage.Family.exprs primitive userCall (left ++ right) := by
  induction left with
  | nil =>
      simpa using hRight
  | cons head tail ih =>
      simp [Safe.FeatureCoverage.Family.exprs] at hLeft
      simp [Safe.FeatureCoverage.Family.exprs, hLeft.1, ih hLeft.2]

theorem family_exprs_reverse
    {primitive : EvmYul.Operation .Yul → Prop}
    {userCall : Name → Prop}
    {args : List AstExpr}
    (hSafe : Safe.FeatureCoverage.Family.exprs primitive userCall args) :
    Safe.FeatureCoverage.Family.exprs primitive userCall args.reverse := by
  induction args with
  | nil =>
      simp [Safe.FeatureCoverage.Family.exprs]
  | cons head tail ih =>
      simp [Safe.FeatureCoverage.Family.exprs] at hSafe
      simpa using
        family_exprs_append (ih hSafe.2)
          (by simp [Safe.FeatureCoverage.Family.exprs, hSafe.1])

theorem family_exprs_mem
    {primitive : EvmYul.Operation .Yul → Prop}
    {userCall : Name → Prop}
    {args : List AstExpr} {expr : AstExpr}
    (hSafe : Safe.FeatureCoverage.Family.exprs primitive userCall args)
    (hMem : expr ∈ args) :
    Safe.FeatureCoverage.Family.expr primitive userCall expr := by
  induction args with
  | nil =>
      simp at hMem
  | cons head tail ih =>
      simp [Safe.FeatureCoverage.Family.exprs] at hSafe
      simp at hMem
      rcases hMem with hEq | hTail
      · simpa [hEq] using hSafe.1
      · exact ih hSafe.2 hTail

theorem callSafe_exprs_reverse {args : List AstExpr}
    (hSafe : Safe.CallSafe.exprs args) :
    Safe.CallSafe.exprs args.reverse := by
  exact family_exprs_reverse hSafe

theorem callSafe_exprs_mem {args : List AstExpr} {expr : AstExpr}
    (hSafe : Safe.CallSafe.exprs args) (hMem : expr ∈ args) :
    Safe.CallSafe.expr expr := by
  exact family_exprs_mem hSafe hMem

theorem callFamilySafe_exprs_reverse {args : List AstExpr}
    (hSafe : Safe.CallFamilySafe.exprs args) :
    Safe.CallFamilySafe.exprs args.reverse := by
  exact family_exprs_reverse hSafe

theorem callFamilySafe_exprs_mem {args : List AstExpr} {expr : AstExpr}
    (hSafe : Safe.CallFamilySafe.exprs args) (hMem : expr ∈ args) :
    Safe.CallFamilySafe.expr expr := by
  exact family_exprs_mem hSafe hMem

theorem callSafe_exprs_of_callSafe_expr_user_call
    {functionName : Name} {args : List AstExpr}
    (hSafe : Safe.CallSafe.expr (.Call (.inr functionName) args)) :
    Safe.CallSafe.exprs args := by
  simpa [Safe.CallSafe.expr, Safe.FeatureCoverage.Family.expr] using hSafe.2

theorem callFamilySafe_exprs_of_callFamilySafe_expr_user_call
    {functionName : Name} {args : List AstExpr}
    (hSafe : Safe.CallFamilySafe.expr (.Call (.inr functionName) args)) :
    Safe.CallFamilySafe.exprs args := by
