  cases hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) names with
  | error checkErr =>
      have hHead :
          EvmYul.Yul.exec sourceFuel.succ.succ
              (.Assign names (.Call (.inl yulPrim) args))
              codeOverride (.Ok shared store) =
            .error checkErr := by
        simp [Imported.exec_assign_succ, hCheck]
      have hResult : sourceResult = .error checkErr := by
        have hSeqHead :
            EvmYul.Yul.execSeq sourceFuel.succ.succ.succ
                (.Assign names (.Call (.inl yulPrim) args) :: rest)
                codeOverride (.Ok shared store) =
              .error checkErr :=
          Imported.execSeq_cons_error_succ hHead
        rw [hSeqHead] at hExecSeq
        exact hExecSeq.symm
      have hRelCheck : SourceResultRelatable (.error checkErr) := by
        simpa [hResult] using hRelatable
      exact False.elim (checkAssignment_error_not_relatable hCheck hRelCheck)
  | ok unit =>
      cases unit
      have hHead :
          EvmYul.Yul.exec sourceFuel.succ.succ
              (.Assign names (.Call (.inl yulPrim) args))
              codeOverride (.Ok shared store) =
            .error err := by
        simp [Imported.exec_assign_succ, hCheck, EvmYul.Yul.evalValues,
          hArgs, EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall, hPrim,
          EvmYul.Yul.multifill']
