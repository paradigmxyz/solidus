/--
A syntactically well-scoped `for` consumes body `break`/`continue` internally.
So, when it is run as a statement from an ordinary `Ok` state, the whole `for`
cannot itself return a raw `break` checkpoint.
-/
theorem exec_for_break_false_of_scoped_safe
    (hExpr : CheckpointExpressionSound)
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared sharedBreak : EvmYul.SharedState .Yul}
    {store storeBreak : EvmYul.Yul.VarStore}
    (hSafe : Safe.stmt (.For cond post body))
    (hScoped :
      ControlFlow.ScopedStmt canBreak canContinue canLeave
        (.For cond post body))
    (hExec :
      EvmYul.Yul.exec fuel (.For cond post body) codeOverride
        (.Ok shared store) =
          .ok (.Checkpoint (.Break sharedBreak storeBreak))) :
    False := by
  have hScopedTop :
      ControlFlow.ScopedStmt false false canLeave (.For cond post body) := by
    simpa [ControlFlow.ScopedStmt] using hScoped
  have hAllowed :
      SourceResultCheckpointAllowed false false canLeave
        (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
          (.Ok shared store)) :=
    SourceResultCheckpointAllowed.exec_of_scoped_safe
      hExpr hSafe hScopedTop (by simp [StateCheckpointAllowed])
  rw [hExec] at hAllowed
  simpa [SourceResultCheckpointAllowed, StateCheckpointAllowed] using hAllowed

/--
The companion to `exec_for_break_false_of_scoped_safe`: a whole accepted `for`
cannot return a raw `continue` checkpoint either.
-/
theorem exec_for_continue_false_of_scoped_safe
    (hExpr : CheckpointExpressionSound)
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared sharedContinue : EvmYul.SharedState .Yul}
    {store storeContinue : EvmYul.Yul.VarStore}
    (hSafe : Safe.stmt (.For cond post body))
    (hScoped :
      ControlFlow.ScopedStmt canBreak canContinue canLeave
        (.For cond post body))
    (hExec :
      EvmYul.Yul.exec fuel (.For cond post body) codeOverride
        (.Ok shared store) =
          .ok (.Checkpoint (.Continue sharedContinue storeContinue))) :
    False := by
  have hScopedTop :
      ControlFlow.ScopedStmt false false canLeave (.For cond post body) := by
    simpa [ControlFlow.ScopedStmt] using hScoped
  have hAllowed :
      SourceResultCheckpointAllowed false false canLeave
        (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
          (.Ok shared store)) :=
    SourceResultCheckpointAllowed.exec_of_scoped_safe
      hExpr hSafe hScopedTop (by simp [StateCheckpointAllowed])
  rw [hExec] at hAllowed
  simpa [SourceResultCheckpointAllowed, StateCheckpointAllowed] using hAllowed

/--
A singleton block containing a well-scoped `for` also cannot expose a raw
`break` or `continue` result from an ordinary `Ok` state.
-/
theorem sourceResultNoLoopControl_of_exec_block_singleton_for_scoped_safe
    (hExpr : CheckpointExpressionSound)
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    (hSafe : Safe.stmt (.For cond post body))
    (hScoped :
      ControlFlow.ScopedStmt canBreak canContinue canLeave
        (.For cond post body))
    (hExec :
      EvmYul.Yul.exec fuel (.Block [(.For cond post body)]) codeOverride
        (.Ok shared store) = sourceResult) :
    SourceResultNoLoopControl sourceResult := by
  have hSafeBlock : Safe.stmt (.Block [(.For cond post body)]) := by
    simpa [Safe.stmt, Safe.stmts] using hSafe
  have hScopedForTop :
      ControlFlow.ScopedStmt false false canLeave
        (.For cond post body) := by
    simpa [ControlFlow.ScopedStmt] using hScoped
  have hScopedBlock :
      ControlFlow.ScopedStmt false false canLeave
        (.Block [(.For cond post body)]) := by
    simpa [ControlFlow.ScopedStmt, ControlFlow.ScopedStmts]
      using hScopedForTop
  have hAllowed :
      SourceResultCheckpointAllowed false false canLeave
        (EvmYul.Yul.exec fuel (.Block [(.For cond post body)])
          codeOverride (.Ok shared store)) :=
    SourceResultCheckpointAllowed.exec_of_scoped_safe
      hExpr hSafeBlock hScopedBlock (by simp [StateCheckpointAllowed])
  rw [hExec] at hAllowed
  cases sourceResult with
  | error err =>
      simp [SourceResultNoLoopControl]
  | ok source =>
      cases source with
      | Ok sharedAfter storeAfter =>
          simp [SourceResultNoLoopControl]
      | OutOfFuel =>
          simp [SourceResultNoLoopControl]
      | Checkpoint jump =>
          cases jump with
          | Continue sharedContinue storeContinue =>
              simpa [SourceResultCheckpointAllowed,
                StateCheckpointAllowed, SourceResultNoLoopControl]
                using hAllowed
          | Break sharedBreak storeBreak =>
              simpa [SourceResultCheckpointAllowed,
                StateCheckpointAllowed, SourceResultNoLoopControl]
                using hAllowed
          | Leave sharedLeave storeLeave =>
              simp [SourceResultNoLoopControl]

/--
Program-level safe/scoped facts discharge the successful callee-body checkpoint
contract used by recursive user-call proofs.

This keeps the public proof boundary about source acceptedness and primitive
checkpoint behavior, rather than asking every call site to provide a bespoke
body-result predicate.
-/
theorem SourceResultCheckpointAllowed.function_body_ok_of_scoped_safe
    (hExpr : CheckpointExpressionSound)
    {program : Program} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {sharedArgs : EvmYul.SharedState .Yul}
    {storeArgs : EvmYul.Yul.VarStore} {argValues : List Word}
    {bodyFuel : Nat} {bodyState : State}
    (hSafe : Safe.program program)
    (hScoped : ControlFlow.ProgramScoped program)
    (hLookup :
      program.contract.functions.lookup functionName =
        some (.Def params returns body))
    (hExec :
      EvmYul.Yul.exec bodyFuel (.Block body) (some program.contract)
          (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
            params returns argValues) =
        .ok bodyState) :
    SourceResultCheckpointAllowed false false true (.ok bodyState) := by
  have hSafeBody :
      Safe.stmts body :=
    SafeLookup.function_body_safe_of_contract_lookup hSafe hLookup
  have hSafeBlock :
      Safe.stmt (.Block body) := by
    simpa [Safe.stmt] using hSafeBody
  have hScopedBody :
      ControlFlow.ScopedStmts false false true body :=
    ControlFlow.function_body_scoped_of_contract_lookup hScoped hLookup
  have hScopedBlock :
      ControlFlow.ScopedStmt false false true (.Block body) := by
    simpa [ControlFlow.ScopedStmt] using hScopedBody
  have hAllowed :
      SourceResultCheckpointAllowed false false true
        (EvmYul.Yul.exec bodyFuel (.Block body) (some program.contract)
          (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
            params returns argValues)) :=
    SourceResultCheckpointAllowed.exec_of_scoped_safe
      hExpr hSafeBlock hScopedBlock (by
        have hInitial :
            StateCheckpointAllowed false false true
              (.Ok sharedArgs storeArgs) := by
          simp [StateCheckpointAllowed]
        have hStore :
            StateCheckpointAllowed false false true
              (EvmYul.Yul.State.setStore (.Ok sharedArgs storeArgs)
                (default : State)) :=
          StateCheckpointAllowed.setStore hInitial
        have hReturns :
            StateCheckpointAllowed false false true
              (EvmYul.Yul.State.zeroFill returns
                (EvmYul.Yul.State.setStore (.Ok sharedArgs storeArgs)
                  (default : State))) :=
          StateCheckpointAllowed.zeroFill hStore
        have hParams :
            StateCheckpointAllowed false false true
              (EvmYul.Yul.State.multifill params argValues
                (EvmYul.Yul.State.zeroFill returns
                  (EvmYul.Yul.State.setStore (.Ok sharedArgs storeArgs)
                    (default : State)))) :=
          StateCheckpointAllowed.multifill hReturns
        simpa [EvmYul.Yul.State.initcall] using
          StateCheckpointAllowed.mkOk hParams)
  simpa [hExec] using hAllowed

/--
CALL-safe sibling of `function_body_ok_of_scoped_safe`.

Function bodies selected from a `Safe.CallSafe.program` may contain ordinary
`CALL`, so the checkpoint argument is the family-generic CALL-safe expression
contract rather than the old no-external-call `CheckpointExpressionSound`.
-/
theorem SourceResultCheckpointAllowed.function_body_ok_of_scoped_callSafe
    (hExpr :
      FamilyCheckpointExpressionSound Safe.CallSafe.primitive
        Safe.CallSafe.userCall)
    {program : Program} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {sharedArgs : EvmYul.SharedState .Yul}
    {storeArgs : EvmYul.Yul.VarStore} {argValues : List Word}
    {bodyFuel : Nat} {bodyState : State}
    (hSafe : Safe.CallSafe.program program)
    (hScoped : ControlFlow.ProgramScoped program)
    (hLookup :
      program.contract.functions.lookup functionName =
        some (.Def params returns body))
    (hExec :
      EvmYul.Yul.exec bodyFuel (.Block body) (some program.contract)
          (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
            params returns argValues) =
        .ok bodyState) :
    SourceResultCheckpointAllowed false false true (.ok bodyState) := by
  have hSafeBody :
      Safe.CallSafe.stmts body :=
    CallSafeLookup.function_body_safe_of_contract_lookup hSafe hLookup
  have hSafeBlock :
      Safe.CallSafe.stmt (.Block body) := by
    simpa [Safe.CallSafe.stmt] using hSafeBody
  have hScopedBody :
      ControlFlow.ScopedStmts false false true body :=
    ControlFlow.function_body_scoped_of_contract_lookup hScoped hLookup
  have hScopedBlock :
      ControlFlow.ScopedStmt false false true (.Block body) := by
    simpa [ControlFlow.ScopedStmt] using hScopedBody
  have hAllowed :
      SourceResultCheckpointAllowed false false true
        (EvmYul.Yul.exec bodyFuel (.Block body) (some program.contract)
          (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
            params returns argValues)) :=
    SourceResultCheckpointAllowed.exec_of_scoped_callSafe
      hExpr hSafeBlock hScopedBlock (by
        have hInitial :
            StateCheckpointAllowed false false true
              (.Ok sharedArgs storeArgs) := by
          simp [StateCheckpointAllowed]
        have hStore :
            StateCheckpointAllowed false false true
              (EvmYul.Yul.State.setStore (.Ok sharedArgs storeArgs)
                (default : State)) :=
          StateCheckpointAllowed.setStore hInitial
        have hReturns :
            StateCheckpointAllowed false false true
              (EvmYul.Yul.State.zeroFill returns
                (EvmYul.Yul.State.setStore (.Ok sharedArgs storeArgs)
                  (default : State))) :=
          StateCheckpointAllowed.zeroFill hStore
        have hParams :
            StateCheckpointAllowed false false true
              (EvmYul.Yul.State.multifill params argValues
                (EvmYul.Yul.State.zeroFill returns
                  (EvmYul.Yul.State.setStore (.Ok sharedArgs storeArgs)
                    (default : State)))) :=
          StateCheckpointAllowed.multifill hReturns
        simpa [EvmYul.Yul.State.initcall] using
          StateCheckpointAllowed.mkOk hParams)
  simpa [hExec] using hAllowed

