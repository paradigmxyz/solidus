          source compiler lowerHead) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel.succ [head]
      codeOverride lowerHead allowed := by
  intro source compiler sourceResult hInitial _hAllow hSourceSeq
  rcases hHead hInitial with
    ⟨sourceResultHead, sourceOutcome, ctxAfter, targetFuel, hSourceHead,
      hTargetHead, hOutcomeRel, hNonregular⟩
  have hSourceSeqHead :
      EvmYul.Yul.execSeq sourceFuel.succ [head] codeOverride source =
        sourceResultHead := by
    cases hOutcomeRel with
    | ok hOk =>
        cases hOk with
        | regular _hRel =>
            exfalso
            exact hNonregular rfl
        | brk _hRel =>
            exact Imported.execSeq_cons_checkpoint_succ hSourceHead
        | cont _hRel =>
            exact Imported.execSeq_cons_checkpoint_succ hSourceHead
        | leave _hRel =>
            exact Imported.execSeq_cons_checkpoint_succ hSourceHead
    | yulHalt _hRel =>
        exact Imported.execSeq_cons_error_succ hSourceHead
    | revert _hRel =>
        exact Imported.execSeq_cons_error_succ hSourceHead
  have hResultEq : sourceResultHead = sourceResult := by
    rw [hSourceSeqHead] at hSourceSeq
    exact hSourceSeq
  exact
    ⟨sourceOutcome, ctxAfter, targetFuel, hTargetHead,
      by simpa [hResultEq] using hOutcomeRel⟩

