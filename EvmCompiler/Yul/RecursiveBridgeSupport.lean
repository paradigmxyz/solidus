theorem execSeq_assign_prim_call_error_of_evalArgs_ok_primCall_error
    {sourceFuel : Nat} {sourceAfterArgs : State}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {names : List EvmYul.Identifier}
    {yulPrim : EvmYul.Operation .Yul} {args : List AstExpr}
