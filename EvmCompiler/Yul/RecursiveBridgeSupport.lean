theorem SourceExprRawPreludeOpenPathSoundWhen.withCreate
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {results : Nat}
    {lower : Locals.Expr results}
    {allowed : Except Exception (State × List Word) → Prop}
    (hSound :
      SourceExprRawPreludeOpenPathSoundWhen cfg layout terminalRel revertRel
        prim program ctx sourceFuel expr codeOverride pre lower allowed) :
    SourceExprRawPreludeOpenPathSoundWhenWithCreate cfg layout terminalRel
      revertRel prim program ctx sourceFuel expr codeOverride pre lower
      allowed := by
  intro source compiler trace sourceDone hInitial hContains hResolve
    hAllowed hResponses hCreateResponses minimumTargetFuel
  rcases
      hSound hInitial hContains hResolve hAllowed hResponses
        minimumTargetFuel with
    ⟨targetFuel, hMinimumTargetFuel, hPath⟩
  rcases hPath.resolves with
    ⟨sourceDone', targetDone, hSource, hTarget, hDone⟩
  have hSourceDone : sourceDone' = sourceDone :=
    OpenExternal.OpenResultResolves.deterministic hSource hResolve
  subst sourceDone'
  exact
    ⟨targetFuel, hMinimumTargetFuel,
      OpenExternal.OpenResultPathRelWithCreate.of_resolves_of_responsesSatisfy
        hSource hTarget hResponses hCreateResponses hDone⟩

/--
A successful singleton source value path through a raw expression prelude can
only end in a normal Yul source state.

The raw expression completion relation relates successful source values through
`SourceStateRel`, whose only source-state constructor is `.Ok`; stopped target
paths are reserved for source terminal/revert errors.
-/
theorem SourceExprRawPreludeOpenResultPathRel.ok_singleton_source_state
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {trace : OpenExternal.OpenTrace}
    {source :
      OpenExternal.OpenResult Exception (State × List Word)}
    {target :
      OpenExternal.OpenResult Functions.EVMException
        SourceExprPreludeOpen.RawTarget}
    {sourceAfter : State} {value : Word}
    (hPath :
      OpenExternal.OpenResultPathRel
        (RelationallyAdmissibleOpenCallResponseRel cfg)
        (SourceExprRawPreludeOpenDoneRel cfg layout terminalRel revertRel)
        trace source target)
    (hResolve :
      OpenExternal.OpenResultResolves source trace
        (.ok (sourceAfter, [value]))) :
    ∃ shared store, sourceAfter = .Ok shared store := by
  rcases hPath.resolves with
    ⟨sourceDone, targetDone, hSource, _hTarget, hDone⟩
  have hSourceDone :
      sourceDone = (.ok (sourceAfter, [value]) :
        Except Exception (State × List Word)) :=
    OpenExternal.OpenResultResolves.deterministic hSource hResolve
  subst sourceDone
  cases targetDone with
  | error targetErr =>
      simp [SourceExprRawPreludeOpenDoneRel] at hDone
  | ok targetDone =>
      cases targetDone with
      | values target =>
          simp [SourceExprRawPreludeOpenDoneRel,
            SourceArgStackPreludeOpenDoneRel] at hDone
          rcases hDone with ⟨hState, _hValues⟩
          cases hState with
          | ok _hShared _hVars =>
              exact ⟨_, _, rfl⟩
      | stopped target =>
          simp [SourceExprRawPreludeOpenDoneRel] at hDone

/--
Expose the normal-source-state consequence directly from a selected finite
raw-expression prelude path.
-/
theorem SourceExprRawPreludeOpenPathSoundWhen.ok_singleton_source_state
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {results : Nat}
    {lower : Locals.Expr results}
    {allowed : Except Exception (State × List Word) → Prop}
    (hOpen :
      SourceExprRawPreludeOpenPathSoundWhen cfg layout terminalRel revertRel
        prim program ctx sourceFuel expr codeOverride pre lower allowed)
    {sourceState : State} {compiler : Objects.Source.State}
    {trace : OpenExternal.OpenTrace}
    {sourceAfter : State} {value : Word}
    (hInitial : SourceStateRel cfg layout sourceState compiler)
    (hContains : StateStoreContains layout sourceState)
    (hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues sourceFuel expr codeOverride
            sourceState))
        trace (.ok (sourceAfter, [value])))
    (hAllowed : allowed (.ok (sourceAfter, [value])))
    (hResponses : SourceOpenTraceResponsesAdmissible cfg trace) :
    ∃ shared store, sourceAfter = .Ok shared store := by
  rcases hOpen hInitial hContains hResolve hAllowed hResponses 0 with
    ⟨_targetFuel, _hFuel, hPath⟩
  exact
    SourceExprRawPreludeOpenResultPathRel.ok_singleton_source_state
      hPath hResolve

theorem SourceExprRawPreludeOpenPathSoundWhenWithCreate.ok_singleton_source_state
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {results : Nat}
    {lower : Locals.Expr results}
    {allowed : Except Exception (State × List Word) → Prop}
    (hOpen :
      SourceExprRawPreludeOpenPathSoundWhenWithCreate cfg layout terminalRel
        revertRel prim program ctx sourceFuel expr codeOverride pre lower
        allowed)
    {sourceState : State} {compiler : Objects.Source.State}
    {trace : OpenExternal.OpenTrace}
    {sourceAfter : State} {value : Word}
    (hInitial : SourceStateRel cfg layout sourceState compiler)
    (hContains : StateStoreContains layout sourceState)
    (hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues sourceFuel expr codeOverride
            sourceState))
        trace (.ok (sourceAfter, [value])))
    (hAllowed : allowed (.ok (sourceAfter, [value])))
    (hResponses : SourceOpenTraceExternalResponsesAdmissible cfg trace) :
    ∃ shared store, sourceAfter = .Ok shared store := by
  rcases
      hOpen hInitial hContains hResolve hAllowed
        (SourceOpenTraceExternalResponsesAdmissible.to_call hResponses)
        (SourceOpenTraceExternalResponsesAdmissible.to_create hResponses) 0 with
    ⟨_targetFuel, _hFuel, hPath⟩
  exact
    SourceExprRawPreludeOpenResultPathRel.ok_singleton_source_state
      (OpenExternal.OpenResultPathRelWithCreate.toOpenResultPathRel hPath)
      hResolve

def SourceArgRawPreludeOpenDoneRel
    (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (lowerArgs : List (Locals.Expr 1)) :
    Except EvmYul.Yul.Exception (State × List Word) →
      Except Functions.EVMException
        (Functions.Source.Outcome × Functions.Source.Ctx) → Prop
  | .ok sourceResult, .ok (targetOutcome, _ctxAfter) =>
      match targetOutcome.mode with
      | .regular =>
          SourceStateRel cfg layout sourceResult.1 targetOutcome.state ∧
            Functions.Source.ArgList.eval prim lowerArgs
                targetOutcome.state =
              .ok (targetOutcome.state, sourceResult.2.reverse)
      | .brk | .cont | .leave | .halt _ => False
  | _, _ => False

