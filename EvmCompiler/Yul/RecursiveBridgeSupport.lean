/--
Prelude-level generated-temporary `let` user-call bridge with both argument
outcomes.

The generated initializer always runs first.  If imported argument evaluation
succeeds, the hidden prelude and final generated call run normally; if argument
evaluation halts/reverts, the hidden prelude short-circuits and the generated
call is skipped.
-/
theorem sourceResultBlockSoundWhenAtExact_let_user_call_actual_or_arg_terminal_prelude
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat}
    {names : List EvmYul.Identifier} {functionName : Name}
    {args : List AstExpr} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {lowerArgs : List (Locals.Expr 1)}
    {allowed : Except Exception State → Prop}
    (hScope : ctx.scope = layout)
    (hNoDup : (identNames names).Nodup)
    (hFresh : ∀ name, name ∈ identNames names → name ∉ layout)
    (hArgsRegular :
      SourceArgListPreludeRegularAt cfg layout prim program
        { ctx with scope := (identNames names).reverse ++ ctx.scope }
        argFuel args codeOverride pre lowerArgs)
