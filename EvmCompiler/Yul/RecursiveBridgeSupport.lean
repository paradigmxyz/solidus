theorem evalArgs_nil_error_not_relatable
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {source : State} {err : Exception} :
    EvmYul.Yul.evalArgs sourceFuel ([] : List AstExpr) codeOverride source =
        .error err →
      SourceResultRelatable (.error err) →
      False := by
  intro hEval hRelatable
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.evalArgs] at hEval
      subst err
      exact sourceResultRelatable_outOfFuel_false hRelatable
  | succ fuel =>
      simp [EvmYul.Yul.evalArgs] at hEval

theorem evalArgs_cons_error_relatable_split
    {sourceFuel : Nat} {head : AstExpr} {tail : List AstExpr}
    {codeOverride : Option AstContract}
    {source : State} {err : Exception}
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel (head :: tail) codeOverride source =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    ∃ evalFuel,
      sourceFuel = evalFuel.succ ∧
        (EvmYul.Yul.eval evalFuel head codeOverride source = .error err ∨
          ∃ tailFuel,
          ∃ sourceAfterHead : State,
          ∃ value : Word,
            evalFuel = tailFuel.succ ∧
            EvmYul.Yul.eval evalFuel head codeOverride source =
              .ok (sourceAfterHead, value) ∧
            EvmYul.Yul.evalArgs tailFuel tail codeOverride
              sourceAfterHead = .error err) := by
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.evalArgs] at hEval
      subst err
      exact False.elim
        (sourceResultRelatable_outOfFuel_false hRelatable)
  | succ evalFuel =>
      refine ⟨evalFuel, rfl, ?_⟩
      cases hHead :
          EvmYul.Yul.eval evalFuel head codeOverride source with
      | error headErr =>
          left
          have hHeadErr : headErr = err := by
            simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHead]
              at hEval
            exact hEval
          exact by simpa [hHeadErr] using hHead
      | ok headResult =>
          rcases headResult with ⟨sourceAfterHead, value⟩
          cases evalFuel with
          | zero =>
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHead]
                at hEval
              subst err
              exact False.elim
                (sourceResultRelatable_outOfFuel_false hRelatable)
          | succ tailFuel =>
              cases hTail :
                  EvmYul.Yul.evalArgs tailFuel tail codeOverride
                    sourceAfterHead with
              | error tailErr =>
                  right
                  have hTailErr : tailErr = err := by
                    simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                      EvmYul.Yul.cons', hHead, hTail] at hEval
                    exact hEval
                  refine
                    ⟨tailFuel, sourceAfterHead, value, rfl, ?_, ?_⟩
                  · simp [hHead]
                  · simpa [hTailErr] using hTail
              | ok tailResult =>
                  rcases tailResult with ⟨sourceAfterTail, tailValues⟩
                  simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                    EvmYul.Yul.cons', hHead, hTail] at hEval

theorem evalArgs_append_singleton_error_relatable_split
    {sourceFuel : Nat} {preArgs : List AstExpr} {head : AstExpr}
    {codeOverride : Option AstContract}
    {source : State} {err : Exception}
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel (preArgs ++ [head]) codeOverride source =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    (EvmYul.Yul.evalArgs sourceFuel preArgs codeOverride source =
      .error err) ∨
      ∃ headFuel,
      ∃ sourceAfterPrefix : State,
      ∃ prefixValues : List Word,
        EvmYul.Yul.evalArgs sourceFuel preArgs codeOverride source =
          .ok (sourceAfterPrefix, prefixValues) ∧
        EvmYul.Yul.eval headFuel head codeOverride sourceAfterPrefix =
          .error err := by
  induction preArgs generalizing sourceFuel source with
  | nil =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
          subst err
          exact False.elim
            (sourceResultRelatable_outOfFuel_false hRelatable)
      | succ evalFuel =>
          cases hHeadEval :
              EvmYul.Yul.eval evalFuel head codeOverride source with
          | error headErr =>
              right
              have hHeadErr : headErr = err := by
                simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHeadEval]
                  at hEval
                exact hEval
              refine ⟨evalFuel, source, [], ?_, ?_⟩
              · simp [EvmYul.Yul.evalArgs]
              · simpa [hHeadErr] using hHeadEval
          | ok headResult =>
              rcases headResult with ⟨sourceAfterHead, headValue⟩
              cases evalFuel with
              | zero =>
                  simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHeadEval]
                    at hEval
                  subst err
                  exact False.elim
                    (sourceResultRelatable_outOfFuel_false hRelatable)
              | succ tailFuel =>
                  cases tailFuel with
                  | zero =>
                      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                        EvmYul.Yul.cons', hHeadEval] at hEval
                      subst err
                      exact False.elim
                        (sourceResultRelatable_outOfFuel_false hRelatable)
                  | succ tailFuel' =>
                      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                        EvmYul.Yul.cons', hHeadEval] at hEval
  | cons first rest ih =>
      rcases
          evalArgs_cons_error_relatable_split
            (head := first) (tail := rest ++ [head]) hEval hRelatable with
        ⟨evalFuel, hFuelEq, hSplit⟩
      subst sourceFuel
      cases hSplit with
      | inl hFirstErr =>
          left
          simpa [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hFirstErr]
      | inr hTailErr =>
          rcases hTailErr with
            ⟨tailFuel, sourceAfterFirst, firstValue, hEvalFuelEq,
              hFirstOk, hRestHeadErr⟩
          subst evalFuel
          have hRec :=
            ih (sourceFuel := tailFuel) (source := sourceAfterFirst)
              hRestHeadErr
          cases hRec with
          | inl hRestErr =>
              left
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                EvmYul.Yul.cons', hFirstOk, hRestErr]
          | inr hHeadErr =>
              rcases hHeadErr with
                ⟨headFuel, sourceAfterPrefix, restValues, hRestOk,
                  hHeadErr⟩
              right
              refine
                ⟨headFuel, sourceAfterPrefix, firstValue :: restValues,
                  ?_, hHeadErr⟩
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                EvmYul.Yul.cons', hFirstOk, hRestOk]

theorem evalArgs_append_singleton_error_relatable_split_lt
    {sourceFuel : Nat} {preArgs : List AstExpr} {head : AstExpr}
    {codeOverride : Option AstContract}
    {source : State} {err : Exception}
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel (preArgs ++ [head]) codeOverride source =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    (EvmYul.Yul.evalArgs sourceFuel preArgs codeOverride source =
      .error err) ∨
      ∃ headFuel,
      ∃ sourceAfterPrefix : State,
      ∃ prefixValues : List Word,
        headFuel < sourceFuel ∧
        EvmYul.Yul.evalArgs sourceFuel preArgs codeOverride source =
          .ok (sourceAfterPrefix, prefixValues) ∧
        EvmYul.Yul.eval headFuel head codeOverride sourceAfterPrefix =
          .error err := by
  induction preArgs generalizing sourceFuel source with
  | nil =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
          subst err
          exact False.elim
            (sourceResultRelatable_outOfFuel_false hRelatable)
      | succ evalFuel =>
          cases hHeadEval :
              EvmYul.Yul.eval evalFuel head codeOverride source with
          | error headErr =>
              right
              have hHeadErr : headErr = err := by
                simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHeadEval]
                  at hEval
                exact hEval
              refine ⟨evalFuel, source, [], by omega, ?_, ?_⟩
              · simp [EvmYul.Yul.evalArgs]
              · simpa [hHeadErr] using hHeadEval
          | ok headResult =>
              rcases headResult with ⟨sourceAfterHead, headValue⟩
              cases evalFuel with
              | zero =>
                  simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHeadEval]
                    at hEval
                  subst err
                  exact False.elim
                    (sourceResultRelatable_outOfFuel_false hRelatable)
              | succ tailFuel =>
                  cases tailFuel with
                  | zero =>
                      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                        EvmYul.Yul.cons', hHeadEval] at hEval
                      subst err
                      exact False.elim
                        (sourceResultRelatable_outOfFuel_false hRelatable)
                  | succ tailFuel' =>
                      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                        EvmYul.Yul.cons', hHeadEval] at hEval
  | cons first rest ih =>
      rcases
          evalArgs_cons_error_relatable_split
            (head := first) (tail := rest ++ [head]) hEval hRelatable with
        ⟨evalFuel, hFuelEq, hSplit⟩
      subst sourceFuel
      cases hSplit with
      | inl hFirstErr =>
          left
          simpa [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hFirstErr]
      | inr hTailErr =>
          rcases hTailErr with
            ⟨tailFuel, sourceAfterFirst, firstValue, hEvalFuelEq,
              hFirstOk, hRestHeadErr⟩
          subst evalFuel
          have hRec :=
            ih (sourceFuel := tailFuel) (source := sourceAfterFirst)
              hRestHeadErr
          cases hRec with
          | inl hRestErr =>
              left
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                EvmYul.Yul.cons', hFirstOk, hRestErr]
          | inr hHeadErr =>
              rcases hHeadErr with
                ⟨headFuel, sourceAfterPrefix, restValues, hHeadFuelLt,
                  hRestOk, hHeadErr⟩
              right
              refine
                ⟨headFuel, sourceAfterPrefix, firstValue :: restValues,
                  by omega, ?_, hHeadErr⟩
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                EvmYul.Yul.cons', hFirstOk, hRestOk]

theorem evalArgs_append_singleton_ok_split_lt
    {sourceFuel : Nat} {preArgs : List AstExpr} {head : AstExpr}
    {codeOverride : Option AstContract}
    {source sourceAfter : State} {values : List Word}
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel (preArgs ++ [head]) codeOverride
          source =
        .ok (sourceAfter, values)) :
    ∃ headFuel,
    ∃ sourceAfterPrefix : State,
    ∃ prefixValues : List Word,
    ∃ headValue : Word,
      headFuel < sourceFuel ∧
        EvmYul.Yul.evalArgs sourceFuel preArgs codeOverride source =
          .ok (sourceAfterPrefix, prefixValues) ∧
        EvmYul.Yul.eval headFuel head codeOverride sourceAfterPrefix =
          .ok (sourceAfter, headValue) ∧
        values = prefixValues ++ [headValue] := by
  induction preArgs generalizing sourceFuel source values with
  | nil =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
      | succ evalFuel =>
          cases hHead :
              EvmYul.Yul.eval evalFuel head codeOverride source with
          | error headErr =>
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHead]
                at hEval
          | ok headResult =>
              rcases headResult with ⟨sourceAfterHead, headValue⟩
              cases evalFuel with
              | zero =>
                  simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hHead]
                    at hEval
              | succ tailFuel =>
                  cases hTail :
                      EvmYul.Yul.evalArgs tailFuel [] codeOverride
                        sourceAfterHead with
                  | error tailErr =>
                      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                        EvmYul.Yul.cons', hHead, hTail] at hEval
                  | ok tailResult =>
                      rcases tailResult with ⟨sourceAfterTail, tailValues⟩
                      have hTailPair :
                          (sourceAfterHead, []) =
                            (sourceAfterTail, tailValues) := by
                        cases tailFuel with
                        | zero =>
                            simp [EvmYul.Yul.evalArgs] at hTail
                        | succ n =>
                            simpa [EvmYul.Yul.evalArgs] using hTail
                      injection hTailPair with hSourceHeadEq hTailValuesEq
                      cases hSourceHeadEq
                      cases hTailValuesEq
                      have hPair :
                          (sourceAfterHead, [headValue]) =
                            (sourceAfter, values) := by
                        simpa [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                          EvmYul.Yul.cons', hHead, hTail] using hEval
                      injection hPair with hSourceAfter hValues
                      cases hSourceAfter
                      cases hValues
                      refine
                        ⟨tailFuel.succ, source, [], headValue, ?_, ?_, ?_, ?_⟩
                      · omega
                      · simp [EvmYul.Yul.evalArgs]
                      · simpa using hHead
                      · simp
  | cons first rest ih =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
      | succ evalFuel =>
          cases hFirst :
              EvmYul.Yul.eval evalFuel first codeOverride source with
          | error firstErr =>
              simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hFirst]
                at hEval
          | ok firstResult =>
              rcases firstResult with ⟨sourceAfterFirst, firstValue⟩
              cases evalFuel with
              | zero =>
                  simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, hFirst]
                    at hEval
              | succ tailFuel =>
                  cases hRestHead :
                      EvmYul.Yul.evalArgs tailFuel (rest ++ [head])
                        codeOverride sourceAfterFirst with
                  | error restErr =>
                      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                        EvmYul.Yul.cons', hFirst, hRestHead] at hEval
                  | ok restResult =>
                      rcases restResult with ⟨sourceAfterRestHead,
                        restHeadValues⟩
                      have hPair :
                          (sourceAfterRestHead,
                              firstValue :: restHeadValues) =
                            (sourceAfter, values) := by
                        simpa [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                          EvmYul.Yul.cons', hFirst, hRestHead] using hEval
                      injection hPair with hSourceAfter hValues
                      cases hSourceAfter
                      cases hValues
                      rcases ih hRestHead with
                        ⟨headFuel, sourceAfterPrefix, prefixValues,
                          headValue, hHeadFuelLt, hPrefix, hHeadOk,
                          hRestValues⟩
                      refine
                        ⟨headFuel, sourceAfterPrefix,
                          firstValue :: prefixValues, headValue, ?_, ?_,
                          hHeadOk, ?_⟩
                      · omega
                      · simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
                          EvmYul.Yul.cons', hFirst, hPrefix]
                      · simp [hRestValues]

theorem evalArgs_reverse_cons_ok_split_lt
    {sourceFuel : Nat} {head : AstExpr} {tail : List AstExpr}
    {codeOverride : Option AstContract}
    {source sourceAfter : State} {values : List Word}
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel (head :: tail).reverse codeOverride
          source =
        .ok (sourceAfter, values.reverse)) :
    ∃ headFuel,
    ∃ sourceAfterTail : State,
    ∃ tailValues : List Word,
    ∃ headValue : Word,
      headFuel < sourceFuel ∧
        EvmYul.Yul.evalArgs sourceFuel tail.reverse codeOverride source =
          .ok (sourceAfterTail, tailValues.reverse) ∧
        EvmYul.Yul.eval headFuel head codeOverride sourceAfterTail =
          .ok (sourceAfter, headValue) ∧
        values = headValue :: tailValues := by
  have hAppend :
      EvmYul.Yul.evalArgs sourceFuel (tail.reverse ++ [head])
          codeOverride source =
        .ok (sourceAfter, values.reverse) := by
    simpa using hEval
  rcases evalArgs_append_singleton_ok_split_lt hAppend with
    ⟨headFuel, sourceAfterTail, prefixValues, headValue, hHeadFuelLt,
      hTail, hHead, hValuesRev⟩
  let tailValues := prefixValues.reverse
  refine
    ⟨headFuel, sourceAfterTail, tailValues, headValue, hHeadFuelLt, ?_, ?_,
      ?_⟩
  · simpa [tailValues] using hTail
  · exact hHead
  · have hReverse := congrArg List.reverse hValuesRev
    simpa [tailValues] using hReverse

theorem sourceArgListPreludeTerminalAt_nil
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} :
    SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel ([] : List AstExpr) codeOverride
      pre :=
  SourceArgListPreludeTerminalAt.of_no_relatable_evalArgs_error
    (by
      intro source compiler err _hInitial hEval hRelatable
      exact evalArgs_nil_error_not_relatable hEval hRelatable)

theorem directCallArgsSafe_append_of_true
    {left right : List AstExpr}
    (hLeft : Expr.List.directCallArgsSafe? left = true)
    (hRight : Expr.List.directCallArgsSafe? right = true) :
    Expr.List.directCallArgsSafe? (left ++ right) = true := by
  induction left with
  | nil =>
      simpa [Expr.List.directCallArgsSafe?] using hRight
  | cons head rest ih =>
      simp [Expr.List.directCallArgsSafe?] at hLeft

theorem directCallArgsSafe_reverse_of_true
    {args : List AstExpr}
    (hSafe : Expr.List.directCallArgsSafe? args = true) :
    Expr.List.directCallArgsSafe? args.reverse = true := by
  induction args with
  | nil =>
      simp [Expr.List.directCallArgsSafe?]
  | cons head rest ih =>
      simp [Expr.List.directCallArgsSafe?] at hSafe

theorem directCallArgsSafe_eq_true_iff_nil {args : List AstExpr} :
    Expr.List.directCallArgsSafe? args = true ↔ args = [] := by
  cases args with
  | nil =>
      simp [Expr.List.directCallArgsSafe?]
  | cons head rest =>
      simp [Expr.List.directCallArgsSafe?]

theorem toLocals1?_eq_nil_of_directCallArgsSafe
    {args : List AstExpr} {lowerArgs : List (Locals.Expr 1)}
    (hDirect : Expr.List.directCallArgsSafe? args = true)
    (hToLocals : Expr.List.toLocals1? args = some lowerArgs) :
    lowerArgs = [] := by
  have hArgsNil := directCallArgsSafe_eq_true_iff_nil.mp hDirect
  subst args
  simpa [Expr.List.toLocals1?] using hToLocals

def yulPrimListResult :
    Except Exception (State × Option Word) → Except Exception (State × List Word)
  | .ok (state, lit) => .ok (state, lit.toList)
