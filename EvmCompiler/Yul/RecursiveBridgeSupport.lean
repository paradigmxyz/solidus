theorem yulOpen_toOpenResult_loop_succ_succ_eq_runLoopSource
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (state : State) :
    OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.loop fuel.succ.succ cond post body
          codeOverride state) =
      runLoopSource fuel cond post body codeOverride state := by
  simp only [runLoopSource, OpenExternal.YulOpen.loop,
    OpenExternal.YulOpenResult.toOpenResult_bind]
  apply OpenExternal.OpenResult.bind_congr_next
  intro condResult
  by_cases hCond : condResult.2 = EvmYul.UInt256.ofNat 0
  · simp [hCond, OpenExternal.YulOpenResult.ok,
      OpenExternal.OpenResult.ok]
  · simp [hCond]
    rw [OpenExternal.YulOpenResult.toOpenResult_bind]
    apply OpenExternal.OpenResult.bind_congr_next
    intro bodyResult
    cases bodyResult with
    | OutOfFuel =>
        simp [OpenExternal.YulOpenResult.ok,
          OpenExternal.OpenResult.ok]
    | Ok sharedBody storeBody =>
        rw [OpenExternal.YulOpenResult.toOpenResult_bind]
        apply OpenExternal.OpenResult.bind_congr_next
        intro postResult
        cases postResult with
        | OutOfFuel =>
            simp [OpenExternal.YulOpenResult.ok,
              OpenExternal.OpenResult.ok]
        | Ok sharedPost storePost =>
            rw [OpenExternal.YulOpenResult.toOpenResult_bind]
            apply OpenExternal.OpenResult.bind_congr_next
            intro loopResult
            simp [OpenExternal.YulOpenResult.ok,
              OpenExternal.OpenResult.ok]
        | Checkpoint jumpPost =>
            cases jumpPost with
            | Leave sharedLeave storeLeave =>
                simp [OpenExternal.YulOpenResult.ok,
                  OpenExternal.OpenResult.ok]
            | Break sharedBreak storeBreak =>
                rw [OpenExternal.YulOpenResult.toOpenResult_bind]
                apply OpenExternal.OpenResult.bind_congr_next
                intro loopResult
                simp [OpenExternal.YulOpenResult.ok,
                  OpenExternal.OpenResult.ok]
            | Continue sharedContinue storeContinue =>
                rw [OpenExternal.YulOpenResult.toOpenResult_bind]
                apply OpenExternal.OpenResult.bind_congr_next
                intro loopResult
                simp [OpenExternal.YulOpenResult.ok,
                  OpenExternal.OpenResult.ok]
    | Checkpoint jumpBody =>
        cases jumpBody with
        | Break sharedBreak storeBreak =>
            simp [OpenExternal.YulOpenResult.ok,
              OpenExternal.OpenResult.ok]
        | Leave sharedLeave storeLeave =>
            simp [OpenExternal.YulOpenResult.ok,
              OpenExternal.OpenResult.ok]
        | Continue sharedContinue storeContinue =>
            rw [OpenExternal.YulOpenResult.toOpenResult_bind]
            apply OpenExternal.OpenResult.bind_congr_next
            intro postResult
            cases postResult with
            | OutOfFuel =>
                simp [OpenExternal.YulOpenResult.ok,
                  OpenExternal.OpenResult.ok]
            | Ok sharedPost storePost =>
                rw [OpenExternal.YulOpenResult.toOpenResult_bind]
                apply OpenExternal.OpenResult.bind_congr_next
                intro loopResult
                simp [OpenExternal.YulOpenResult.ok,
                  OpenExternal.OpenResult.ok]
            | Checkpoint jumpPost =>
                cases jumpPost with
                | Leave sharedLeave storeLeave =>
                    simp [OpenExternal.YulOpenResult.ok,
                      OpenExternal.OpenResult.ok]
                | Break sharedBreak storeBreak =>
                    rw [OpenExternal.YulOpenResult.toOpenResult_bind]
                    apply OpenExternal.OpenResult.bind_congr_next
                    intro loopResult
                    simp [OpenExternal.YulOpenResult.ok,
                      OpenExternal.OpenResult.ok]
                | Continue sharedContinue storeContinue =>
                    rw [OpenExternal.YulOpenResult.toOpenResult_bind]
                    apply OpenExternal.OpenResult.bind_congr_next
                    intro loopResult
                    simp [OpenExternal.YulOpenResult.ok,
                      OpenExternal.OpenResult.ok]

