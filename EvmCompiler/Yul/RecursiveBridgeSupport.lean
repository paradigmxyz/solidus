theorem SourceResultOutcomeRel.relayout_of_compatible_no_checkpoint
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {ctx : Functions.Source.Ctx}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceResult : Except Exception State}
    {sourceOutcome : Objects.Source.Outcome}
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        sourceResult)
    (hNoCheckpoint : SourceResultNoCheckpoint sourceResult)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        sourceOutcome) :
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult sourceOutcome := by
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hStateRel =>
          cases hStateRel with
          | ok hShared hVars =>
              have hEq : outcomeLayout = layout := by
                simpa [SourceResultOutcomeLayoutCompatible] using hCompat
              subst outcomeLayout
              exact SourceResultOutcomeRel.ok
                (SourceOkOutcomeRel.regular
                  (SourceStateRel.ok hShared hVars))
      | brk hStateRel =>
          cases hStateRel with
          | ok _hShared _hVars =>
              cases hNoCheckpoint
      | cont hStateRel =>
          cases hStateRel with
          | ok _hShared _hVars =>
              cases hNoCheckpoint
      | leave hStateRel =>
          cases hStateRel with
          | ok _hShared _hVars =>
              cases hNoCheckpoint
  | yulHalt hTerminal =>
      exact SourceResultOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact SourceResultOutcomeRel.revert hRevert

/--
At the initial source context, a non-checkpoint imported result is compatible
with the same input/output layout.

This is the small projection needed by top-level dispatcher theorems: regular
and terminal/error results do not need a break/continue/leave handler layout,
while actual checkpoints must be ruled out by a source control-flow condition.
-/
theorem sourceResultOutcomeLayoutCompatible_initial_same_of_no_checkpoint
    {layout : List Name} {sourceResult : Except Exception State}
    (hNoCheckpoint : SourceResultNoCheckpoint sourceResult) :
    SourceResultOutcomeLayoutCompatible Functions.Source.Ctx.initial layout
      layout sourceResult := by
  cases sourceResult with
  | ok source =>
      cases source with
      | Ok shared store =>
          rfl
      | Checkpoint jump =>
          cases hNoCheckpoint
      | OutOfFuel =>
          trivial
  | error err =>
      trivial

theorem SourceStateRel.contains_of_domain
    {cfg : StateRelConfig} {layout : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State} {name : Name}
    (hRel : SourceStateRel cfg layout (.Ok shared store) compiler)
    (hDomain : StoreDomainExact layout store)
    (hMem : name ∈ layout) :
    compiler.vars.contains name = true := by
  cases hRel with
  | ok _hShared hVars =>
      have hSome : (store.lookup name).isSome = true :=
        (hDomain name).mpr hMem
      have hLookup : compiler.vars name = store.lookup name :=
        hVars name hMem
      simpa [Locals.Source.Store.contains, hLookup] using hSome

theorem SourceStateRel.contains_of_store_contains
    {cfg : StateRelConfig} {layout : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State} {name : Name}
    (hRel : SourceStateRel cfg layout (.Ok shared store) compiler)
    (hContains : StoreDomainContains layout store)
    (hMem : name ∈ layout) :
    compiler.vars.contains name = true := by
  cases hRel with
  | ok _hShared hVars =>
      have hSome : (store.lookup name).isSome = true :=
        hContains name hMem
      have hLookup : compiler.vars name = store.lookup name :=
        hVars name hMem
      simpa [Locals.Source.Store.contains, hLookup] using hSome

theorem SourceStateRel.preContains_of_eval_domain
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {results : Nat}
    {expr : Locals.Expr results} {stateBefore stateAfter : Objects.Source.State}
    {values : List Word}
    {sharedAfter : EvmYul.SharedState .Yul}
    {storeAfter : EvmYul.Yul.VarStore} {name : Name}
    (hEval :
      Locals.Source.Expr.eval prim expr stateBefore =
        .ok (stateAfter, values))
    (hRelAfter :
      SourceStateRel cfg layout (.Ok sharedAfter storeAfter) stateAfter)
    (hDomainAfter : StoreDomainExact layout storeAfter)
    (hMem : name ∈ layout) :
    stateBefore.vars.contains name = true := by
  have hContainsAfter :
      stateAfter.vars.contains name = true :=
    hRelAfter.contains_of_domain hDomainAfter hMem
  have hVars :
      stateAfter.vars = stateBefore.vars :=
    Locals.Source.Expr.eval_vars_eq hEval
  simpa [hVars] using hContainsAfter

