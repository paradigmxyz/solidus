theorem to_stmt_head_outer_of_mode_regular_or_leave_or_halt
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {ctx : Functions.Source.Ctx}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {allowed : Except Exception State → Prop}
    {sourceDone : Except Exception State}
    {outcome : Functions.Source.Outcome}
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hDone :
      SourceOpenLoopContinuationPathDoneRel cfg layout outcomeLayout
        terminalRel revertRel allowed sourceDone (.ok outcome))
    (hMode :
      outcome.mode = Locals.Source.Mode.regular ∨
        outcome.mode = Locals.Source.Mode.leave ∨
          ∃ kind : Assembly.HaltKind,
            outcome.mode = Locals.Source.Mode.halt kind) :
    SourceOpenStmtHeadPathDoneRel cfg layout outcomeLayout ctx terminalRel
      revertRel allowed sourceDone
      (.ok
        ((match outcome.mode with
          | .regular =>
              Functions.Source.Outcome.regular
                (outcome.state.restrictTo ctx.scope)
          | .brk | .cont => outcome
          | .leave | .halt _ => outcome), ctx)) := by
  cases hDone with
  | regular hExact =>
      cases hExact with
      | ok hShared hVars hDomain =>
          let hExact' :=
            SourceStateExactRel.ok hShared hVars hDomain
          have hRelRestricted :=
            SourceStateRel.restrictCompilerTo_of_subset
              (SourceStateExactRel.toRel hExact') hScopeContains
          exact
            by
              simpa [Functions.Source.Outcome.regular,
                Locals.Source.Outcome.regular] using
                (SourceOpenStmtHeadPathDoneRel.regular
                  (SourceStateExactRel.ofRelStateDomain hRelRestricted
                    (by simpa [StateStoreDomainExact] using hDomain))
                  hScopeContains (SourceCtxHandlersEq.refl ctx))
  | stopping hNotRegular hOutcome =>
      rcases hMode with hRegular | hStop
      · simpa [hRegular] using
          (SourceOpenStmtHeadPathDoneRel.stopping
            (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
            (ctx := ctx) (terminalRel := terminalRel)
            (revertRel := revertRel) (allowed := allowed)
            hNotRegular
            (by
              intro hAllow
              have hRel :
                  SourceResultOutcomeRel cfg outcomeLayout terminalRel
                    revertRel sourceDone outcome :=
                hOutcome hAllow
              cases hRel with
              | ok hOk =>
                  cases hOk with
                  | regular hStateRel =>
                      cases hStateRel
                      simp [SourceResultNotRegularOk] at hNotRegular
                  | brk hStateRel =>
                      simp [Functions.Source.Outcome.brk,
                        Locals.Source.Outcome.brk] at hRegular
                  | cont hStateRel =>
                      simp [Functions.Source.Outcome.cont,
                        Locals.Source.Outcome.cont] at hRegular
                  | leave hStateRel =>
                      simp [Functions.Source.Outcome.leave,
                        Locals.Source.Outcome.leave] at hRegular
              | yulHalt hTerminal =>
                  simp [Functions.Source.Outcome.halt,
                    Locals.Source.Outcome.halt] at hRegular
              | revert hRevert =>
                  simp [Functions.Source.Outcome.halt,
                    Locals.Source.Outcome.halt] at hRegular))
      · rcases hStop with hLeave | hHalt
        · simpa [hLeave] using
            (SourceOpenStmtHeadPathDoneRel.stopping
              (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
              (ctx := ctx) (terminalRel := terminalRel)
              (revertRel := revertRel) (allowed := allowed)
              hNotRegular hOutcome)
        · rcases hHalt with ⟨kind, hHalt⟩
          simpa [hHalt] using
            (SourceOpenStmtHeadPathDoneRel.stopping
              (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
              (ctx := ctx) (terminalRel := terminalRel)
              (revertRel := revertRel) (allowed := allowed)
              hNotRegular hOutcome)

