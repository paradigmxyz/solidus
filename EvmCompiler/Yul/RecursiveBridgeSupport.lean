-/
theorem compile_whole_program_result_sound_of_programAcceptedRecursiveBridgeAllBoundsReserved_referenceNoOutOfFuel
    {cfg : Reference.StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → Reference.State →
