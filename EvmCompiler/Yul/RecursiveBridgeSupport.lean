    {codeOverride : Option AstContract} {state : State}
    (hEval :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel cond codeOverride state))
    (hCase :
      ∀ {stateAfter : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride state =
          .ok (stateAfter, value) →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel
            (.Block (EvmYul.Yul.selectSwitchCase value defaultBody cases))
            codeOverride stateAfter)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.exec fuel.succ (.Switch cond cases defaultBody)
        codeOverride state) := by
  rw [Imported.exec_switch_succ]
  cases hEvalResult : EvmYul.Yul.eval fuel cond codeOverride state with
  | error err =>
      simp [hEvalResult, SourceResultStoreContains]
  | ok pair =>
      cases pair with
      | mk stateAfter value =>
          simpa [hEvalResult] using
            hCase (stateAfter := stateAfter) (value := value) hEvalResult

def loopPostSuccessResult (fuel : Nat) (cond : AstExpr)
    (post body : List AstStmt) (codeOverride : Option AstContract)
    (state stateAfterPost : State) : Except Exception State :=
  match stateAfterPost with
  | .OutOfFuel =>
      .ok (EvmYul.Yul.State.overwrite? stateAfterPost state)
  | .Checkpoint (.Leave _ _) =>
      .ok (EvmYul.Yul.State.overwrite? stateAfterPost state)
  | _ =>
      match
        EvmYul.Yul.exec fuel (.For cond post body) codeOverride
          (EvmYul.Yul.State.overwrite? stateAfterPost state) with
      | .error err => .error err
      | .ok stateAfterLoop =>
          .ok (EvmYul.Yul.State.overwrite? stateAfterLoop state)

theorem loop_post_success {layout : List Name} {fuel : Nat}
    {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {state stateAfterPost : State}
    (hState : StateStoreContains layout state)
    (hLoopInputState :
      StateStoreContains layout
        (EvmYul.Yul.State.overwrite? stateAfterPost state))
    (hLoop :
      SourceResultStoreContains layout
        (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
          (EvmYul.Yul.State.overwrite? stateAfterPost state))) :
    SourceResultStoreContains layout
      (loopPostSuccessResult fuel cond post body codeOverride state
        stateAfterPost) := by
  revert hLoopInputState hLoop
  cases stateAfterPost with
  | OutOfFuel =>
      intro hLoopInputState _hLoop
      simpa [loopPostSuccessResult, SourceResultStoreContains] using
        SourceResultStoreContains.of_state hLoopInputState
  | Checkpoint jump =>
      cases jump with
      | Leave shared store =>
          intro hLoopInputState _hLoop
          simpa [loopPostSuccessResult, SourceResultStoreContains] using
            SourceResultStoreContains.of_state hLoopInputState
      | Break shared store =>
          intro _hLoopInputState hLoop
          cases hLoopResult :
              EvmYul.Yul.exec fuel (.For cond post body) codeOverride
                (EvmYul.Yul.State.overwrite?
                  (.Checkpoint (.Break shared store)) state) with
          | error err =>
              simp [loopPostSuccessResult, hLoopResult,
                SourceResultStoreContains]
          | ok stateAfterLoop =>
              have hLoopState :
                  StateStoreContains layout stateAfterLoop :=
                SourceResultStoreContains.state_of_ok hLoop hLoopResult
              simpa [loopPostSuccessResult, hLoopResult,
                SourceResultStoreContains] using
                SourceResultStoreContains.of_state
                  (StateStoreContains.overwrite? hLoopState hState)
      | Continue shared store =>
          intro _hLoopInputState hLoop
          cases hLoopResult :
              EvmYul.Yul.exec fuel (.For cond post body) codeOverride
                (EvmYul.Yul.State.overwrite?
                  (.Checkpoint (.Continue shared store)) state) with
          | error err =>
              simp [loopPostSuccessResult, hLoopResult,
                SourceResultStoreContains]
          | ok stateAfterLoop =>
              have hLoopState :
                  StateStoreContains layout stateAfterLoop :=
                SourceResultStoreContains.state_of_ok hLoop hLoopResult
              simpa [loopPostSuccessResult, hLoopResult,
                SourceResultStoreContains] using
                SourceResultStoreContains.of_state
                  (StateStoreContains.overwrite? hLoopState hState)
  | Ok shared store =>
      intro _hLoopInputState hLoop
      cases hLoopResult :
          EvmYul.Yul.exec fuel (.For cond post body) codeOverride
            (EvmYul.Yul.State.overwrite? (.Ok shared store) state) with
      | error err =>
          simp [loopPostSuccessResult, hLoopResult, SourceResultStoreContains]
      | ok stateAfterLoop =>
          have hLoopState :
              StateStoreContains layout stateAfterLoop :=
            SourceResultStoreContains.state_of_ok hLoop hLoopResult
          simpa [loopPostSuccessResult, hLoopResult,
            SourceResultStoreContains] using
            SourceResultStoreContains.of_state
              (StateStoreContains.overwrite? hLoopState hState)

end SourceResultStoreContains

theorem SourceResultStoreContains.loop_checkpoint
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {post body : List AstStmt} {codeOverride : Option AstContract}
    {jump : EvmYul.Yul.Jump}
    (hState : StateStoreContains layout (.Checkpoint jump)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.loop fuel cond post body codeOverride
        (.Checkpoint jump)) := by
  induction fuel using Nat.strong_induction_on with
  | h fuel ih =>
      cases fuel with
      | zero =>
          rw [Imported.loop_zero]
          simp [SourceResultStoreContains]
      | succ fuel1 =>
          cases fuel1 with
          | zero =>
              rw [Imported.loop_one]
              simp [SourceResultStoreContains]
          | succ fuel' =>
              rw [Imported.loop_succ_succ]
              cases hEval :
                  EvmYul.Yul.eval fuel' cond codeOverride
                    (EvmYul.Yul.State.mkOk (.Checkpoint jump)) with
              | error err =>
                  simp [hEval, SourceResultStoreContains]
              | ok evalPair =>
                  rcases evalPair with ⟨stateAfterCond, value⟩
                  by_cases hZero : value = (⟨0⟩ : Word)
                  · simpa [hEval, hZero, SourceResultStoreContains,
                      EvmYul.Yul.State.overwrite?] using hState
                  · cases hBody :
                        EvmYul.Yul.exec fuel' (.Block body) codeOverride
                          stateAfterCond with
                    | error err =>
                        simp [hEval, hZero, hBody,
                          SourceResultStoreContains]
                    | ok stateAfterBody =>
                        cases stateAfterBody with
                        | OutOfFuel =>
                            simpa [hEval, hZero, hBody,
                              SourceResultStoreContains,
                              EvmYul.Yul.State.overwrite?] using hState
                        | Checkpoint bodyJump =>
                            cases bodyJump with
                            | Break shared store =>
                                simpa [hEval, hZero, hBody,
                                  SourceResultStoreContains,
                                  EvmYul.Yul.State.reviveJump,
                                  EvmYul.Yul.State.revive,
                                  EvmYul.Yul.State.overwrite?] using hState
                            | Leave shared store =>
                                simpa [hEval, hZero, hBody,
                                  SourceResultStoreContains,
                                  EvmYul.Yul.State.overwrite?] using hState
                            | Continue shared store =>
                                cases hPost :
                                    EvmYul.Yul.exec fuel' (.Block post)
                                      codeOverride
                                      (EvmYul.Yul.State.reviveJump
                                        (.Checkpoint
                                          (.Continue shared store))) with
                                | error err =>
                                    simp [hEval, hZero, hBody, hPost,
                                      SourceResultStoreContains]
                                | ok stateAfterPost =>
                                    let loopInput : State :=
                                      EvmYul.Yul.State.overwrite?
                                        stateAfterPost (.Checkpoint jump)
                                    have hLoopInputContains :
                                        StateStoreContains layout
                                          loopInput := by
                                      dsimp [loopInput]
                                      simpa [EvmYul.Yul.State.overwrite?]
                                        using hState
                                    have hLoop :
                                        SourceResultStoreContains layout
                                          (EvmYul.Yul.exec fuel'
                                            (.For cond post body) codeOverride
                                            loopInput) := by
                                      dsimp [loopInput]
                                      cases fuel' with
                                      | zero =>
                                          simp [EvmYul.Yul.exec,
                                            EvmYul.Yul.State.overwrite?,
                                            SourceResultStoreContains]
                                      | succ fuel'' =>
                                          simpa [EvmYul.Yul.exec,
                                            EvmYul.Yul.State.overwrite?]
                                            using ih fuel'' (by omega)
                                    simpa [SourceResultStoreContains.loopPostSuccessResult,
                                      hEval, hZero, hBody, hPost, loopInput]
                                      using
                                      SourceResultStoreContains.loop_post_success
                                        (layout := layout) (fuel := fuel')
                                        (cond := cond) (post := post)
                                        (body := body)
                                        (codeOverride := codeOverride)
                                        (state := (.Checkpoint jump))
                                        (stateAfterPost := stateAfterPost)
                                        hState hLoopInputContains hLoop
                        | Ok sharedBody storeBody =>
                            cases hPost :
                                EvmYul.Yul.exec fuel' (.Block post)
                                  codeOverride
                                  (EvmYul.Yul.State.reviveJump
                                    (.Ok sharedBody storeBody)) with
                            | error err =>
                                simp [hEval, hZero, hBody, hPost,
                                  SourceResultStoreContains]
                            | ok stateAfterPost =>
                                let loopInput : State :=
                                  EvmYul.Yul.State.overwrite? stateAfterPost
                                    (.Checkpoint jump)
                                have hLoopInputContains :
                                    StateStoreContains layout loopInput := by
                                  dsimp [loopInput]
                                  simpa [EvmYul.Yul.State.overwrite?]
                                    using hState
                                have hLoop :
                                    SourceResultStoreContains layout
                                      (EvmYul.Yul.exec fuel'
                                        (.For cond post body) codeOverride
                                        loopInput) := by
                                  dsimp [loopInput]
                                  cases fuel' with
                                  | zero =>
                                      simp [EvmYul.Yul.exec,
                                        EvmYul.Yul.State.overwrite?,
                                        SourceResultStoreContains]
                                  | succ fuel'' =>
                                      simpa [EvmYul.Yul.exec,
                                        EvmYul.Yul.State.overwrite?]
                                        using ih fuel'' (by omega)
                                simpa [SourceResultStoreContains.loopPostSuccessResult,
                                  hEval, hZero, hBody, hPost, loopInput]
                                  using
                                  SourceResultStoreContains.loop_post_success
                                    (layout := layout) (fuel := fuel')
                                    (cond := cond) (post := post)
                                    (body := body)
                                    (codeOverride := codeOverride)
                                    (state := (.Checkpoint jump))
                                    (stateAfterPost := stateAfterPost)
                                    hState hLoopInputContains hLoop

theorem SourceResultStoreContains.exec_for_of_loop_input
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {post body : List AstStmt} {codeOverride : Option AstContract}
    {loopInput : State}
    (hContains : StateStoreContains layout loopInput)
    (hRecur :
      StateCheckpointAllowed false false false loopInput →
      SourceResultStoreContains layout
        (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
          loopInput)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
        loopInput) := by
  cases loopInput with
  | Ok shared store =>
      exact hRecur (by simp [StateCheckpointAllowed])
  | OutOfFuel =>
      exact hRecur (by simp [StateCheckpointAllowed])
  | Checkpoint jump =>
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.exec, SourceResultStoreContains]
      | succ fuel' =>
          simpa [EvmYul.Yul.exec] using
            SourceResultStoreContains.loop_checkpoint
              (layout := layout) (fuel := fuel') (cond := cond)
              (post := post) (body := body)
              (codeOverride := codeOverride) (jump := jump)
              (by simpa [StateStoreContains] using hContains)

theorem SourceResultStoreContains.loop_succ_succ_of_parts
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {post body : List AstStmt} {codeOverride : Option AstContract}
    {state : State}
    (hState : StateStoreContains layout state)
    (hEval :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel cond codeOverride
          (EvmYul.Yul.State.mkOk state)))
    (hBody :
      ∀ {stateAfterCond : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride
            (EvmYul.Yul.State.mkOk state) =
          .ok (stateAfterCond, value) →
        value ≠ ⟨0⟩ →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            stateAfterCond))
    (hPost :
      ∀ {postInput : State},
        StateStoreContains layout postInput →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block post) codeOverride postInput))
    (hRecur :
      ∀ {loopInput : State},
        StateStoreContains layout loopInput →
        StateCheckpointAllowed false false false loopInput →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
            loopInput)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.loop (fuel + 2) cond post body codeOverride state) := by
  rw [Imported.loop_succ_succ]
  cases hEvalResult :
      EvmYul.Yul.eval fuel cond codeOverride
        (EvmYul.Yul.State.mkOk state) with
  | error err =>
      simp [hEvalResult, SourceResultStoreContains]
  | ok evalPair =>
      rcases evalPair with ⟨stateAfterCond, value⟩
      have hCondContains : StateStoreContains layout stateAfterCond :=
        SourcePairResultStoreContains.state_of_ok hEval hEvalResult
      by_cases hZero : value = (⟨0⟩ : Word)
      · simpa [hEvalResult, hZero, SourceResultStoreContains] using
          SourceResultStoreContains.of_state
            (StateStoreContains.overwrite? hCondContains hState)
      · have hNonzero : value ≠ (⟨0⟩ : Word) := hZero
        have hBodyContains :
            SourceResultStoreContains layout
              (EvmYul.Yul.exec fuel (.Block body) codeOverride
                stateAfterCond) :=
          hBody hEvalResult hNonzero
        cases hBodyResult :
            EvmYul.Yul.exec fuel (.Block body) codeOverride
              stateAfterCond with
        | error err =>
            simp [hEvalResult, hZero, hBodyResult,
              SourceResultStoreContains]
        | ok stateAfterBody =>
            have hBodyStateContains :
                StateStoreContains layout stateAfterBody :=
              SourceResultStoreContains.state_of_ok hBodyContains hBodyResult
            cases stateAfterBody with
            | OutOfFuel =>
                simpa [hEvalResult, hZero, hBodyResult,
                  SourceResultStoreContains] using
                  SourceResultStoreContains.of_state
                    (StateStoreContains.overwrite?
                      (by simp [StateStoreContains]) hState)
            | Checkpoint bodyJump =>
                cases bodyJump with
                | Break shared store =>
                    simpa [hEvalResult, hZero, hBodyResult,
                      SourceResultStoreContains] using
                      SourceResultStoreContains.of_state
                        (StateStoreContains.overwrite?
                          (StateStoreContains.reviveJump hBodyStateContains)
                          hState)
                | Leave shared store =>
                    simpa [hEvalResult, hZero, hBodyResult,
                      SourceResultStoreContains] using
                      SourceResultStoreContains.of_state
                        (StateStoreContains.overwrite? hBodyStateContains
                          hState)
                | Continue shared store =>
                    have hPostInputContains :
                        StateStoreContains layout
                          (EvmYul.Yul.State.reviveJump
                            (.Checkpoint (.Continue shared store))) :=
                      StateStoreContains.reviveJump hBodyStateContains
                    have hPostContains :
                        SourceResultStoreContains layout
                          (EvmYul.Yul.exec fuel (.Block post) codeOverride
                            (EvmYul.Yul.State.reviveJump
                              (.Checkpoint (.Continue shared store)))) :=
                      hPost hPostInputContains
                    cases hPostResult :
                        EvmYul.Yul.exec fuel (.Block post) codeOverride
                          (EvmYul.Yul.State.reviveJump
                            (.Checkpoint (.Continue shared store))) with
                    | error err =>
                        simp [hEvalResult, hZero, hBodyResult, hPostResult,
                          SourceResultStoreContains]
                    | ok stateAfterPost =>
                        have hPostStateContains :
                            StateStoreContains layout stateAfterPost :=
                          SourceResultStoreContains.state_of_ok
                            hPostContains hPostResult
                        let loopInput : State :=
                          EvmYul.Yul.State.overwrite? stateAfterPost state
                        have hLoopInputContains :
                            StateStoreContains layout loopInput := by
                          dsimp [loopInput]
                          exact
                            StateStoreContains.overwrite? hPostStateContains
                              hState
                        have hLoopContains :
                            SourceResultStoreContains layout
                              (EvmYul.Yul.exec fuel (.For cond post body)
                                codeOverride loopInput) :=
                          SourceResultStoreContains.exec_for_of_loop_input
                            hLoopInputContains
                            (fun hNo =>
                              hRecur hLoopInputContains hNo)
                        simpa [SourceResultStoreContains.loopPostSuccessResult,
                          hEvalResult, hZero, hBodyResult, hPostResult,
                          loopInput] using
                          SourceResultStoreContains.loop_post_success
                            (layout := layout) (fuel := fuel)
                            (cond := cond) (post := post) (body := body)
                            (codeOverride := codeOverride) (state := state)
                            (stateAfterPost := stateAfterPost)
                            hState hLoopInputContains hLoopContains
            | Ok sharedBody storeBody =>
                have hPostInputContains :
                    StateStoreContains layout
                      (EvmYul.Yul.State.reviveJump
                        (.Ok sharedBody storeBody)) :=
                  StateStoreContains.reviveJump hBodyStateContains
                have hPostContains :
                    SourceResultStoreContains layout
                      (EvmYul.Yul.exec fuel (.Block post) codeOverride
                        (EvmYul.Yul.State.reviveJump
                          (.Ok sharedBody storeBody))) :=
                  hPost hPostInputContains
                cases hPostResult :
                    EvmYul.Yul.exec fuel (.Block post) codeOverride
                      (EvmYul.Yul.State.reviveJump
                        (.Ok sharedBody storeBody)) with
                | error err =>
                    simp [hEvalResult, hZero, hBodyResult, hPostResult,
                      SourceResultStoreContains]
                | ok stateAfterPost =>
                    have hPostStateContains :
                        StateStoreContains layout stateAfterPost :=
                      SourceResultStoreContains.state_of_ok hPostContains
                        hPostResult
                    let loopInput : State :=
                      EvmYul.Yul.State.overwrite? stateAfterPost state
                    have hLoopInputContains :
                        StateStoreContains layout loopInput := by
                      dsimp [loopInput]
                      exact
                        StateStoreContains.overwrite? hPostStateContains
                          hState
                    have hLoopContains :
                        SourceResultStoreContains layout
                          (EvmYul.Yul.exec fuel (.For cond post body)
                            codeOverride loopInput) :=
                      SourceResultStoreContains.exec_for_of_loop_input
                        hLoopInputContains
                        (fun hNo => hRecur hLoopInputContains hNo)
                    simpa [SourceResultStoreContains.loopPostSuccessResult,
                      hEvalResult, hZero, hBodyResult, hPostResult,
                      loopInput] using
                      SourceResultStoreContains.loop_post_success
                        (layout := layout) (fuel := fuel) (cond := cond)
                        (post := post) (body := body)
                        (codeOverride := codeOverride) (state := state)
                        (stateAfterPost := stateAfterPost)
                        hState hLoopInputContains hLoopContains

theorem SourceResultStoreContains.loop_succ_succ_of_ok_parts
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {post body : List AstStmt} {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    (hState : StoreDomainContains layout store)
    (hEval :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store)))
    (hEvalOk :
      ∀ {stateAfterCond : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) =
          .ok (stateAfterCond, value) →
        ∃ sharedCond storeCond,
          stateAfterCond = .Ok sharedCond storeCond ∧
          StoreDomainContains layout storeCond)
    (hBody :
      ∀ {sharedCond : EvmYul.SharedState .Yul}
        {storeCond : EvmYul.Yul.VarStore} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) =
          .ok (.Ok sharedCond storeCond, value) →
        value ≠ ⟨0⟩ →
        StoreDomainContains layout storeCond →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            (.Ok sharedCond storeCond)))
    (hPost :
      ∀ {sharedPost : EvmYul.SharedState .Yul}
        {storePost : EvmYul.Yul.VarStore},
        StoreDomainContains layout storePost →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block post) codeOverride
            (.Ok sharedPost storePost)))
    (hRecur :
      ∀ {loopInput : State},
        StateStoreContains layout loopInput →
        StateCheckpointAllowed false false false loopInput →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
            loopInput)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.loop (fuel + 2) cond post body codeOverride
        (.Ok shared store)) := by
  rw [Imported.loop_succ_succ]
  simp [EvmYul.Yul.State.mkOk] at *
  have hStateOk : StateStoreContains layout (.Ok shared store) := by
    simpa [StateStoreContains] using hState
  cases hEvalResult :
      EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) with
  | error err =>
      simp [hEvalResult, SourceResultStoreContains]
  | ok evalPair =>
      rcases evalPair with ⟨stateAfterCond, value⟩
      rcases hEvalOk hEvalResult with
        ⟨sharedCond, storeCond, hCondEq, hCondDomain⟩
      subst stateAfterCond
      have hCondContains :
          StateStoreContains layout (.Ok sharedCond storeCond) := by
        simpa [StateStoreContains] using hCondDomain
      by_cases hZero : value = (⟨0⟩ : Word)
      · simpa [hEvalResult, hZero, SourceResultStoreContains] using
          SourceResultStoreContains.of_state
            (StateStoreContains.overwrite? hCondContains hStateOk)
      · have hNonzero : value ≠ (⟨0⟩ : Word) := hZero
        have hBodyContains :
            SourceResultStoreContains layout
              (EvmYul.Yul.exec fuel (.Block body) codeOverride
                (.Ok sharedCond storeCond)) :=
          hBody hEvalResult hNonzero hCondDomain
        cases hBodyResult :
            EvmYul.Yul.exec fuel (.Block body) codeOverride
              (.Ok sharedCond storeCond) with
        | error err =>
            simp [hEvalResult, hZero, hBodyResult,
              SourceResultStoreContains]
        | ok stateAfterBody =>
            have hBodyStateContains :
                StateStoreContains layout stateAfterBody :=
              SourceResultStoreContains.state_of_ok hBodyContains
                hBodyResult
            cases stateAfterBody with
            | OutOfFuel =>
                simpa [hEvalResult, hZero, hBodyResult,
                  SourceResultStoreContains] using
                  SourceResultStoreContains.of_state
                    (StateStoreContains.overwrite? hBodyStateContains
                      hStateOk)
            | Checkpoint bodyJump =>
                cases bodyJump with
                | Break sharedBreak storeBreak =>
                    simpa [hEvalResult, hZero, hBodyResult,
                      SourceResultStoreContains] using
                      SourceResultStoreContains.of_state
                        (StateStoreContains.overwrite?
                          (StateStoreContains.reviveJump hBodyStateContains)
                          hStateOk)
                | Leave sharedLeave storeLeave =>
                    simpa [hEvalResult, hZero, hBodyResult,
                      SourceResultStoreContains] using
                      SourceResultStoreContains.of_state
                        (StateStoreContains.overwrite? hBodyStateContains
                          hStateOk)
                | Continue sharedContinue storeContinue =>
                    have hPostContains :
                        SourceResultStoreContains layout
                          (EvmYul.Yul.exec fuel (.Block post) codeOverride
                            (EvmYul.Yul.State.reviveJump
                              (.Checkpoint
                                (.Continue sharedContinue storeContinue)))) := by
                      simpa [EvmYul.Yul.State.reviveJump,
                        EvmYul.Yul.State.revive] using
                        hPost
                          (by
                            simpa [StateStoreContains] using
                              hBodyStateContains)
                    cases hPostResult :
                        EvmYul.Yul.exec fuel (.Block post) codeOverride
                          (EvmYul.Yul.State.reviveJump
                            (.Checkpoint
                              (.Continue sharedContinue storeContinue))) with
                    | error err =>
                        simp [hEvalResult, hZero, hBodyResult, hPostResult,
                          SourceResultStoreContains]
                    | ok stateAfterPost =>
                        have hPostStateContains :
                            StateStoreContains layout stateAfterPost :=
                          SourceResultStoreContains.state_of_ok
                            hPostContains hPostResult
                        let loopInput : State :=
                          EvmYul.Yul.State.overwrite? stateAfterPost
                            (.Ok shared store)
                        have hLoopInputContains :
                            StateStoreContains layout loopInput := by
                          dsimp [loopInput]
                          exact
                            StateStoreContains.overwrite?
                              hPostStateContains hStateOk
                        have hLoopContains :
                            SourceResultStoreContains layout
                              (EvmYul.Yul.exec fuel (.For cond post body)
                                codeOverride loopInput) :=
                          SourceResultStoreContains.exec_for_of_loop_input
                            (layout := layout) (fuel := fuel) (cond := cond)
                            (post := post) (body := body)
                            (codeOverride := codeOverride)
                            (loopInput := loopInput) hLoopInputContains
                            (fun hAllowed =>
                              hRecur hLoopInputContains hAllowed)
                        simpa [SourceResultStoreContains.loopPostSuccessResult,
                          hEvalResult, hZero, hBodyResult, hPostResult,
                          loopInput] using
                          SourceResultStoreContains.loop_post_success
                            (layout := layout) (fuel := fuel)
                            (cond := cond) (post := post) (body := body)
                            (codeOverride := codeOverride)
                            (state := (.Ok shared store))
                            (stateAfterPost := stateAfterPost)
                            hStateOk hLoopInputContains hLoopContains
            | Ok sharedBody storeBody =>
                have hPostContains :
                    SourceResultStoreContains layout
                      (EvmYul.Yul.exec fuel (.Block post) codeOverride
                        (EvmYul.Yul.State.reviveJump
                          (.Ok sharedBody storeBody))) := by
                  simpa [EvmYul.Yul.State.reviveJump] using
                    hPost
                      (by
                        simpa [StateStoreContains] using hBodyStateContains)
                cases hPostResult :
                    EvmYul.Yul.exec fuel (.Block post) codeOverride
                      (EvmYul.Yul.State.reviveJump
                        (.Ok sharedBody storeBody)) with
                | error err =>
                    simp [hEvalResult, hZero, hBodyResult, hPostResult,
                      SourceResultStoreContains]
                | ok stateAfterPost =>
                    have hPostStateContains :
                        StateStoreContains layout stateAfterPost :=
                      SourceResultStoreContains.state_of_ok
                        hPostContains hPostResult
                    let loopInput : State :=
                      EvmYul.Yul.State.overwrite? stateAfterPost
                        (.Ok shared store)
                    have hLoopInputContains :
                        StateStoreContains layout loopInput := by
                      dsimp [loopInput]
                      exact
                        StateStoreContains.overwrite? hPostStateContains
                          hStateOk
                    have hLoopContains :
                        SourceResultStoreContains layout
                          (EvmYul.Yul.exec fuel (.For cond post body)
                            codeOverride loopInput) :=
                      SourceResultStoreContains.exec_for_of_loop_input
                        (layout := layout) (fuel := fuel) (cond := cond)
                        (post := post) (body := body)
                        (codeOverride := codeOverride)
                        (loopInput := loopInput) hLoopInputContains
                        (fun hAllowed =>
                          hRecur hLoopInputContains hAllowed)
                    simpa [SourceResultStoreContains.loopPostSuccessResult,
                      hEvalResult, hZero, hBodyResult, hPostResult,
                      loopInput] using
                      SourceResultStoreContains.loop_post_success
                        (layout := layout) (fuel := fuel) (cond := cond)
                        (post := post) (body := body)
                        (codeOverride := codeOverride)
                        (state := (.Ok shared store))
                        (stateAfterPost := stateAfterPost)
                        hStateOk hLoopInputContains hLoopContains

structure StoreDomainCallSound : Prop where
  primCall :
    ∀ {layout : List Name} {fuel : Nat}
      {prim : EvmYul.Operation .Yul} {state : State}
      {args : List Word},
      Safe.primitive prim →
      StateStoreContains layout state →
      SourcePairResultStoreContains layout
        (EvmYul.Yul.primCall fuel state prim args)
  userCall :
    ∀ {layout : List Name} {fuel : Nat}
      {functionName : Name} {args : List Word}
      {codeOverride : Option AstContract} {state : State},
      StateStoreContains layout state →
      SourcePairResultStoreContains layout
        (EvmYul.Yul.call fuel args (some functionName) codeOverride state)

theorem StoreDomainCallSound.of_prim
    (hPrim :
      ∀ {layout : List Name} {fuel : Nat}
        {prim : EvmYul.Operation .Yul} {state : State}
        {args : List Word},
        Safe.primitive prim →
        StateStoreContains layout state →
        SourcePairResultStoreContains layout
          (EvmYul.Yul.primCall fuel state prim args)) :
    StoreDomainCallSound where
  primCall := hPrim
  userCall := fun hContains =>
    SourcePairResultStoreContains.call_of_state hContains

theorem SourcePairResultStoreContains.primCall_of_state_eq_on_ok
    {layout : List Name} {fuel : Nat}
    {prim : EvmYul.Operation .Yul} {state : State}
    {args : List Word}
    (hContains : StateStoreContains layout state)
    (hStateEq :
      ∀ {outState : State} {values : List Word},
        EvmYul.Yul.primCall fuel state prim args =
          .ok (outState, values) →
        outState = state) :
    SourcePairResultStoreContains layout
      (EvmYul.Yul.primCall fuel state prim args) := by
  cases hCall : EvmYul.Yul.primCall fuel state prim args with
  | error err =>
      simp [SourcePairResultStoreContains]
  | ok pair =>
      cases pair with
      | mk outState values =>
          have hEq : outState = state := hStateEq hCall
          subst outState
          exact SourcePairResultStoreContains.ok hContains

theorem SourcePairResultStoreContains.primCall_of_safe_ok
    {layout : List Name} {fuel : Nat}
    {prim : EvmYul.Operation .Yul}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {args : List Word}
    (hSafe : Safe.primitive prim)
    (hContains : StoreDomainContains layout store) :
    SourcePairResultStoreContains layout
      (EvmYul.Yul.primCall fuel (.Ok shared store) prim args) := by
  cases hCall :
      EvmYul.Yul.primCall fuel (.Ok shared store) prim args with
  | error err =>
      simp [SourcePairResultStoreContains]
  | ok pair =>
      cases pair with
      | mk outState values =>
          cases outState with
          | Ok sharedAfter storeAfter =>
              have hStore :
                  storeAfter = store :=
                PrimitiveCallStorePreservingForSafe.of_primitive_families
                  hSafe hCall
              subst storeAfter
              exact
                SourcePairResultStoreContains.ok
                  (by simpa [StateStoreContains] using hContains)
          | OutOfFuel =>
              simp [SourcePairResultStoreContains, StateStoreContains]
          | Checkpoint jump =>
              have hAllowed :
                  SourcePairResultCheckpointAllowed false false false
                    (EvmYul.Yul.primCall fuel (.Ok shared store) prim args) :=
                PrimitiveCallCheckpointAllowedForSafe.of_primitive_families
                  hSafe
              have hJump :
                  StateCheckpointAllowed false false false
                    (.Checkpoint jump) := by
                simpa [SourcePairResultCheckpointAllowed, hCall] using
                  hAllowed
              cases jump <;> simp [StateCheckpointAllowed] at hJump

theorem SourcePairResultStoreContains.primCall_of_safe_nonOk
    {layout : List Name} {fuel : Nat}
    {prim : EvmYul.Operation .Yul} {state : State}
    {args : List Word}
    (hSafe : Safe.primitive prim)
    (hNonOk : ∀ shared store, state ≠ (.Ok shared store : State))
    (hContains : StateStoreContains layout state) :
    SourcePairResultStoreContains layout
      (EvmYul.Yul.primCall fuel state prim args) := by
  cases prim with
  | StopArith op =>
      exact
        SourcePairResultStoreContains.primCall_of_state_eq_on_ok
          hContains Yul.PrimSemantics.primCall_stopArith_state_eq_of_ok
  | CompBit op =>
      exact
        SourcePairResultStoreContains.primCall_of_state_eq_on_ok
          hContains Yul.PrimSemantics.primCall_compBit_state_eq_of_ok
  | Keccak op =>
      cases op
      exact
        SourcePairResultStoreContains.primCall_of_state_eq_on_ok
          hContains
          (Yul.PrimSemantics.primCall_keccak256_state_eq_of_ok_of_nonOk
            hNonOk)
  | Env op =>
      have hSupported : Yul.PrimSemantics.EnvCheckpointSafe op := by
        cases op <;>
          simpa [Yul.PrimSemantics.EnvCheckpointSafe, Safe.primitive]
            using hSafe
      exact
        SourcePairResultStoreContains.primCall_of_state_eq_on_ok
          hContains
          (Yul.PrimSemantics.primCall_env_state_eq_of_ok_of_nonOk
            hSupported hNonOk)
  | Block op =>
      exact
        SourcePairResultStoreContains.primCall_of_state_eq_on_ok
          hContains
          (Yul.PrimSemantics.primCall_block_state_eq_of_ok_of_nonOk
            hNonOk)
  | StackMemFlow op =>
      have hSupported :
          Yul.PrimSemantics.StackMemFlowCheckpointSafe op := by
        cases op <;>
          simpa [Yul.PrimSemantics.StackMemFlowCheckpointSafe,
            Safe.primitive] using hSafe
      exact
        SourcePairResultStoreContains.primCall_of_state_eq_on_ok
          hContains
          (Yul.PrimSemantics.primCall_stackMemFlow_state_eq_of_ok_of_nonOk
            hSupported hNonOk)
  | Log op =>
      cases op with
      | LOG0 =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (Yul.PrimSemantics.primCall_log0_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG1 =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (Yul.PrimSemantics.primCall_log1_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG2 =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (Yul.PrimSemantics.primCall_log2_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG3 =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (Yul.PrimSemantics.primCall_log3_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG4 =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (Yul.PrimSemantics.primCall_log4_state_eq_of_ok_of_nonOk
                hNonOk)
  | System op =>
      cases op with
      | CREATE =>
          simp [Safe.primitive] at hSafe
      | CALL =>
          simp [Safe.primitive] at hSafe
      | CALLCODE =>
          simp [Safe.primitive] at hSafe
      | RETURN =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (fun h =>
                False.elim
                  (Yul.PrimSemantics.primCall_return_impossible_of_ok h))
      | DELEGATECALL =>
          simp [Safe.primitive] at hSafe
      | CREATE2 =>
          simp [Safe.primitive] at hSafe
      | STATICCALL =>
          simp [Safe.primitive] at hSafe
      | REVERT =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (fun h =>
                False.elim
                  (Yul.PrimSemantics.primCall_revert_impossible_of_ok h))
      | INVALID =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (fun h =>
                False.elim
                  (Yul.PrimSemantics.primCall_invalid_impossible_of_ok h))
      | SELFDESTRUCT =>
          exact
            SourcePairResultStoreContains.primCall_of_state_eq_on_ok
              hContains
              (fun h =>
                False.elim
                  (Yul.PrimSemantics.primCall_selfdestruct_impossible_of_ok
                    h))

theorem StoreDomainCallSound.of_primitive_families :
    StoreDomainCallSound :=
  StoreDomainCallSound.of_prim
    (by
      intro layout fuel prim state args hSafe hContains
      cases state with
      | Ok shared store =>
          exact
            SourcePairResultStoreContains.primCall_of_safe_ok
              (layout := layout) (fuel := fuel) (prim := prim)
              (shared := shared) (store := store) (args := args)
              hSafe (by simpa [StateStoreContains] using hContains)
      | OutOfFuel =>
          exact
            SourcePairResultStoreContains.primCall_of_safe_nonOk
              (layout := layout) (fuel := fuel) (prim := prim)
              (state := .OutOfFuel) (args := args) hSafe
              (by intro shared store h; cases h)
              (by simp [StateStoreContains])
      | Checkpoint jump =>
          exact
            SourcePairResultStoreContains.primCall_of_safe_nonOk
              (layout := layout) (fuel := fuel) (prim := prim)
              (state := .Checkpoint jump) (args := args) hSafe
              (by intro shared store h; cases h)
              (by simpa [StateStoreContains] using hContains))

structure StoreDomainExpressionSound : Prop where
  evalValues :
    ∀ {layout : List Name} {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.expr expr →
      StateStoreContains layout state →
      SourcePairResultStoreContains layout
        (EvmYul.Yul.evalValues fuel expr codeOverride state)
  evalArgs :
    ∀ {layout : List Name} {fuel : Nat} {exprs : List AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.exprs exprs →
      StateStoreContains layout state →
      SourcePairResultStoreContains layout
        (EvmYul.Yul.evalArgs fuel exprs codeOverride state)
  eval :
    ∀ {layout : List Name} {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.expr expr →
      StateStoreContains layout state →
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel expr codeOverride state)
  exprStmtCall :
    ∀ {layout : List Name} {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.expr expr →
      StateStoreContains layout state →
      SourceResultStoreContains layout
        (EvmYul.Yul.exec fuel (.ExprStmtCall expr) codeOverride state)

theorem StoreDomainExpressionSound.of_callSound
    (hCall : StoreDomainCallSound) :
    StoreDomainExpressionSound := by
  let hFuel :
        ∀ fuel,
          (∀ {layout : List Name} {expr : AstExpr}
            {codeOverride : Option AstContract} {state : State},
            Safe.expr expr →
            StateStoreContains layout state →
            SourcePairResultStoreContains layout
              (EvmYul.Yul.evalValues fuel expr codeOverride state)) ∧
          (∀ {layout : List Name} {exprs : List AstExpr}
            {codeOverride : Option AstContract} {state : State},
            Safe.exprs exprs →
            StateStoreContains layout state →
            SourcePairResultStoreContains layout
              (EvmYul.Yul.evalArgs fuel exprs codeOverride state)) := by
    intro fuel
    refine Nat.strong_induction_on fuel ?_
    intro fuel ih
    cases fuel with
    | zero =>
        constructor
        · intro layout expr codeOverride state _hSafe _hContains
          simp [EvmYul.Yul.evalValues, SourcePairResultStoreContains]
        · intro layout exprs codeOverride state _hSafe _hContains
          simp [EvmYul.Yul.evalArgs, SourcePairResultStoreContains]
    | succ fuelPred =>
        have ihPred := ih fuelPred (Nat.lt_succ_self fuelPred)
        constructor
        · intro layout expr codeOverride state hSafe hContains
          cases expr with
          | Lit value =>
              simpa [EvmYul.Yul.evalValues, SourcePairResultStoreContains]
                using hContains
          | Var name =>
              cases hLookup : EvmYul.Yul.State.lookup? name state with
              | none =>
                  simp [EvmYul.Yul.evalValues, hLookup,
                    SourcePairResultStoreContains]
              | some value =>
                  simpa [EvmYul.Yul.evalValues, hLookup,
                    SourcePairResultStoreContains] using hContains
          | Call callee args =>
              cases callee with
              | inl prim =>
                  rcases hSafe with ⟨hSafePrim, hSafeArgs⟩
                  simp [EvmYul.Yul.evalValues]
                  have hArgsContains :
                      SourcePairResultStoreContains layout
                        (EvmYul.Yul.reverse'
                          (EvmYul.Yul.evalArgs fuelPred args.reverse
                            codeOverride state)) :=
                    SourcePairResultStoreContains.reverse'
                      ((ihPred).2 (safe_exprs_reverse hSafeArgs) hContains)
                  cases hArgs :
                      EvmYul.Yul.reverse'
                        (EvmYul.Yul.evalArgs fuelPred args.reverse
                          codeOverride state) with
                  | error err =>
                      simp [hArgs, SourcePairResultStoreContains]
                  | ok pair =>
                      cases pair with
                      | mk stateAfter values =>
                          simpa [hArgs] using
                            hCall.primCall hSafePrim
                              (SourcePairResultStoreContains.state_of_ok
                                hArgsContains hArgs)
              | inr functionName =>
                  rcases hSafe with ⟨_hSupported, hSafeArgs⟩
                  simp [EvmYul.Yul.evalValues]
                  have hArgsContains :
                      SourcePairResultStoreContains layout
                        (EvmYul.Yul.reverse'
                          (EvmYul.Yul.evalArgs fuelPred args.reverse
                            codeOverride state)) :=
                    SourcePairResultStoreContains.reverse'
                      ((ihPred).2 (safe_exprs_reverse hSafeArgs) hContains)
                  cases hArgs :
                      EvmYul.Yul.reverse'
                        (EvmYul.Yul.evalArgs fuelPred args.reverse
                          codeOverride state) with
                  | error err =>
                      simp [hArgs, SourcePairResultStoreContains]
                  | ok pair =>
                      cases pair with
                      | mk stateAfter values =>
                          simpa [hArgs] using
                            hCall.userCall
                              (functionName := functionName)
                              (args := values) (codeOverride := codeOverride)
                              (SourcePairResultStoreContains.state_of_ok
                                hArgsContains hArgs)
        · intro layout exprs codeOverride state hSafe hContains
          cases exprs with
          | nil =>
              simpa [EvmYul.Yul.evalArgs, SourcePairResultStoreContains]
                using hContains
          | cons head tail =>
              rcases hSafe with ⟨hHeadSafe, hTailSafe⟩
              cases fuelPred with
              | zero =>
                  simpa [EvmYul.Yul.evalArgs] using
                    (SourcePairResultStoreContains.evalTail_zero
                      (layout := layout) (args := tail)
                      (codeOverride := codeOverride)
                      (sourceResult :=
                        EvmYul.Yul.eval 0 head codeOverride state))
              | succ fuelTail =>
                  have ihTail := ih fuelTail (by omega)
                  have hHeadContains :
                      SourcePairResultStoreContains layout
                        (EvmYul.Yul.eval fuelTail.succ head codeOverride
                          state) :=
                    by
                      simpa [EvmYul.Yul.eval] using
                        SourcePairResultStoreContains.head'
                          ((ihPred).1 (codeOverride := codeOverride)
                            hHeadSafe hContains)
                  exact
                    by
                      simpa [EvmYul.Yul.evalArgs] using
                        SourcePairResultStoreContains.evalTail_succ_of_head_tail
                          hHeadContains
                          (fun hHeadOk =>
                            (ihTail).2 hTailSafe
                              (SourcePairResultStoreContains.state_of_ok
                                hHeadContains hHeadOk))
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro layout fuel expr codeOverride state hSafe hContains
    exact (hFuel fuel).1 hSafe hContains
  · intro layout fuel exprs codeOverride state hSafe hContains
    exact (hFuel fuel).2 hSafe hContains
  · intro layout fuel expr codeOverride state hSafe hContains
    simpa [EvmYul.Yul.eval] using
      SourcePairResultStoreContains.head'
        ((hFuel fuel).1 (codeOverride := codeOverride) hSafe hContains)
  · intro layout fuel expr codeOverride state hSafe hContains
    cases fuel with
    | zero =>
        simp [EvmYul.Yul.exec, SourceResultStoreContains]
    | succ fuelPred =>
        cases expr with
        | Lit value =>
            simp [EvmYul.Yul.exec, SourceResultStoreContains]
        | Var name =>
            simp [EvmYul.Yul.exec, SourceResultStoreContains]
        | Call callee args =>
            cases callee with
            | inl prim =>
                rcases hSafe with ⟨hSafePrim, hSafeArgs⟩
                rw [Imported.exec_expr_prim_call_succ]
                have hArgsContains :
                    SourcePairResultStoreContains layout
                      (EvmYul.Yul.reverse'
                        (EvmYul.Yul.evalArgs fuelPred args.reverse
                          codeOverride state)) :=
                  SourcePairResultStoreContains.reverse'
                    ((hFuel fuelPred).2 (safe_exprs_reverse hSafeArgs)
                      hContains)
                cases hArgs :
                    EvmYul.Yul.reverse'
                      (EvmYul.Yul.evalArgs fuelPred args.reverse codeOverride
                        state) with
                | error err =>
                    simp [hArgs, EvmYul.Yul.execPrimCall,
                      SourceResultStoreContains]
                | ok pair =>
                    cases pair with
                    | mk stateAfter values =>
                        simpa [hArgs, EvmYul.Yul.execPrimCall] using
                          SourceResultStoreContains.multifill'
                            (names := [])
                            (hCall.primCall hSafePrim
                              (SourcePairResultStoreContains.state_of_ok
                                hArgsContains hArgs))
            | inr functionName =>
                rcases hSafe with ⟨_hSupported, hSafeArgs⟩
                rw [Imported.exec_expr_user_call_succ]
                have hArgsContains :
                    SourcePairResultStoreContains layout
                      (EvmYul.Yul.reverse'
                        (EvmYul.Yul.evalArgs fuelPred args.reverse
                          codeOverride state)) :=
                  SourcePairResultStoreContains.reverse'
                    ((hFuel fuelPred).2 (safe_exprs_reverse hSafeArgs)
                      hContains)
                cases hArgs :
                    EvmYul.Yul.reverse'
                      (EvmYul.Yul.evalArgs fuelPred args.reverse codeOverride
                        state) with
                | error err =>
                    simp [hArgs, EvmYul.Yul.execCall,
                      SourceResultStoreContains]
                | ok pair =>
                    cases pair with
                    | mk stateAfter values =>
                        cases fuelPred with
                        | zero =>
                            simp [hArgs, EvmYul.Yul.execCall,
                              SourceResultStoreContains]
                        | succ fuel' =>
                            simpa [hArgs, EvmYul.Yul.execCall] using
                              SourceResultStoreContains.multifill'
                                (names := [])
                                (hCall.userCall
                                  (fuel := fuel')
                                  (functionName := functionName)
                                  (args := values)
                                  (codeOverride := codeOverride)
                                  (SourcePairResultStoreContains.state_of_ok
                                    hArgsContains hArgs))

theorem StoreDomainExpressionSound.of_primitive_families :
    StoreDomainExpressionSound :=
  StoreDomainExpressionSound.of_callSound
    StoreDomainCallSound.of_primitive_families

theorem StateStoreContains.of_pair_result_ok
    {layout : List Name} {α : Type}
    {sourceResult : Except Exception (State × α)}
    {state : State} {value : α}
    (hContains : SourcePairResultStoreContains layout sourceResult)
    (hResult : sourceResult = .ok (state, value)) :
    StateStoreContains layout state :=
  SourcePairResultStoreContains.state_of_ok hContains hResult

theorem StateStoreContains.of_result_ok
    {layout : List Name} {sourceResult : Except Exception State}
    {state : State}
    (hContains : SourceResultStoreContains layout sourceResult)
    (hResult : sourceResult = .ok state) :
    StateStoreContains layout state :=
  SourceResultStoreContains.state_of_ok hContains hResult

theorem StoreDomainExpressionSound.evalArgs_reverse_ok_store_contains_of_exact
    (hExpr : StoreDomainExpressionSound)
    {layout : List Name} {fuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {values : List Word}
    (hSafe : Safe.exprs args)
    (hDomain : StoreDomainExact layout store)
    (hEval :
      EvmYul.Yul.evalArgs fuel args.reverse codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values.reverse)) :
    StoreDomainContains layout storeAfter := by
  have hContains :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.evalArgs fuel args.reverse codeOverride
          (.Ok shared store)) :=
    hExpr.evalArgs (layout := layout) (fuel := fuel)
      (exprs := args.reverse) (codeOverride := codeOverride)
      (state := .Ok shared store) (safe_exprs_reverse hSafe)
      (by
        simpa [StateStoreContains] using
          (StoreDomainContains.of_exact hDomain))
  have hStateContains :
      StateStoreContains layout (.Ok sharedAfter storeAfter) :=
    SourcePairResultStoreContains.state_of_ok
      (layout := layout) hContains hEval
  simpa [StateStoreContains] using hStateContains

theorem call_user_ok_contract_body
    {fuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {args values : List Word} {functionName : Name}
    {contract : AstContract} {stateAfter : State}
    (hCall :
      EvmYul.Yul.call fuel.succ args (some functionName) (some contract)
          (.Ok shared store) =
        .ok (stateAfter, values)) :
    ∃ yulAccount : EvmYul.Account .Yul, ∃ fn : AstFunctionDefinition,
    ∃ bodyState : State,
      shared.accountMap.find? shared.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec fuel (.Block fn.body) (some contract)
          (👌 (EvmYul.Yul.State.Ok shared store).initcall
            fn.params fn.rets args) =
        .ok bodyState ∧
      stateAfter =
        (bodyState.reviveJump.overwrite? (.Ok shared store)).setStore
          (.Ok shared store) ∧
      values = List.map bodyState.lookup! fn.rets := by
  simp [EvmYul.Yul.call, EvmYul.Yul.State.sharedState,
    EvmYul.Yul.State.executionEnv] at hCall
  cases hFind :
      shared.accountMap.find? shared.executionEnv.codeOwner with
  | none =>
      simp [hFind] at hCall
  | some yulAccount =>
      simp [hFind] at hCall
      cases hLookup : contract.functions.lookup functionName with
      | none =>
          simp [hLookup] at hCall
      | some fn =>
          simp [hLookup] at hCall
          cases hExec :
              EvmYul.Yul.exec fuel (.Block fn.body) (some contract)
                (👌 (EvmYul.Yul.State.Ok shared store).initcall
                  fn.params fn.rets args) with
          | error err =>
              simp [hExec] at hCall
          | ok bodyState =>
              simp [hExec] at hCall
              rcases hCall with ⟨hStateAfter, hValues⟩
              exact
                ⟨yulAccount, fn, bodyState, rfl, rfl, hExec,
                  hStateAfter.symm, hValues.symm⟩

theorem execCall_user_ok_contract_body
    {fuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {args : List Word} {functionName : Name} {targets : List Name}
    {contract : AstContract} {stateAfter : State}
    (hExecCall :
      EvmYul.Yul.execCall fuel.succ.succ functionName targets
          (some contract) (.ok (.Ok shared store, args)) =
        .ok stateAfter) :
    ∃ yulAccount : EvmYul.Account .Yul, ∃ fn : AstFunctionDefinition,
    ∃ bodyState : State,
      shared.accountMap.find? shared.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec fuel (.Block fn.body) (some contract)
          (👌 (EvmYul.Yul.State.Ok shared store).initcall
            fn.params fn.rets args) =
        .ok bodyState ∧
      EvmYul.Yul.State.multifill targets
          (List.map bodyState.lookup! fn.rets)
          ((bodyState.reviveJump.overwrite? (.Ok shared store)).setStore
            (.Ok shared store)) =
        stateAfter := by
  have hExecCall' :
      EvmYul.Yul.multifill' targets
          (EvmYul.Yul.call fuel.succ args (some functionName)
            (some contract) (.Ok shared store)) =
        .ok stateAfter := by
    simpa [EvmYul.Yul.execCall] using hExecCall
  cases hCall :
      EvmYul.Yul.call fuel.succ args (some functionName) (some contract)
        (.Ok shared store) with
  | error err =>
      simp [hCall, EvmYul.Yul.multifill'] at hExecCall'
  | ok callResult =>
      rcases callResult with ⟨callState, values⟩
      simp [hCall, EvmYul.Yul.multifill'] at hExecCall'
      rcases
          call_user_ok_contract_body
            (fuel := fuel) (shared := shared) (store := store)
            (args := args) (values := values) (functionName := functionName)
            (contract := contract) (stateAfter := callState) hCall with
        ⟨yulAccount, fn, bodyState, hFind, hLookup, hBody, hCallState,
          hValues⟩
      refine ⟨yulAccount, fn, bodyState, hFind, hLookup, hBody, ?_⟩
      simpa [hCallState, hValues] using hExecCall'

theorem execCall_user_ok_contract_body_exists
    {callFuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {args : List Word} {functionName : Name} {targets : List Name}
    {contract : AstContract} {stateAfter : State}
    (hExecCall :
      EvmYul.Yul.execCall callFuel functionName targets
          (some contract) (.ok (.Ok shared store, args)) =
        .ok stateAfter) :
    ∃ bodyFuel : Nat,
    ∃ yulAccount : EvmYul.Account .Yul, ∃ fn : AstFunctionDefinition,
    ∃ bodyState : State,
      callFuel = bodyFuel.succ.succ ∧
      shared.accountMap.find? shared.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec bodyFuel (.Block fn.body) (some contract)
          (👌 (EvmYul.Yul.State.Ok shared store).initcall
            fn.params fn.rets args) =
        .ok bodyState ∧
      EvmYul.Yul.State.multifill targets
          (List.map bodyState.lookup! fn.rets)
          ((bodyState.reviveJump.overwrite? (.Ok shared store)).setStore
            (.Ok shared store)) =
        stateAfter := by
  cases callFuel with
  | zero =>
      simp [EvmYul.Yul.execCall] at hExecCall
  | succ callFuel' =>
      cases callFuel' with
      | zero =>
          simp [EvmYul.Yul.execCall, EvmYul.Yul.call,
            EvmYul.Yul.multifill'] at hExecCall
      | succ bodyFuel =>
          rcases
              execCall_user_ok_contract_body
                (fuel := bodyFuel) (shared := shared) (store := store)
                (args := args) (functionName := functionName)
                (targets := targets) (contract := contract)
                (stateAfter := stateAfter) hExecCall with
            ⟨yulAccount, fn, bodyState, hFind, hLookup, hBody, hFinal⟩
          exact
            ⟨bodyFuel, yulAccount, fn, bodyState, rfl, hFind, hLookup,
              hBody, hFinal⟩

/--
If an internal user-function `execCall` returns a source-relatable error, that
error is the selected callee body's terminal error.

The alternative `execCall` error sources are out-of-fuel, missing contract,
missing function, or target assignment arity errors; those are intentionally
outside `SourceResultRelatable`.
-/
theorem execCall_user_error_contract_body_exists_of_relatable
    {callFuel : Nat} {state : State}
    {args : List Word} {functionName : Name} {targets : List Name}
    {contract : AstContract} {err : Exception}
    (hExecCall :
      EvmYul.Yul.execCall callFuel functionName targets
          (some contract) (.ok (state, args)) =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    ∃ bodyFuel : Nat,
    ∃ yulAccount : EvmYul.Account .Yul, ∃ fn : AstFunctionDefinition,
      callFuel = bodyFuel.succ.succ ∧
      state.sharedState.accountMap.find? state.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec bodyFuel (.Block fn.body) (some contract)
          (👌 state.initcall fn.params fn.rets args) =
        .error err := by
  cases callFuel with
  | zero =>
      simp [EvmYul.Yul.execCall] at hExecCall
      subst err
      cases hRelatable
  | succ callFuel' =>
      cases callFuel' with
      | zero =>
          simp [EvmYul.Yul.execCall, EvmYul.Yul.call,
            EvmYul.Yul.multifill'] at hExecCall
          subst err
          cases hRelatable
      | succ bodyFuel =>
          cases hFind :
              state.sharedState.accountMap.find? state.executionEnv.codeOwner with
          | none =>
              simp [EvmYul.Yul.execCall, EvmYul.Yul.call, hFind,
                EvmYul.Yul.multifill'] at hExecCall
              subst err
              cases hRelatable
          | some yulAccount =>
              cases hLookup : contract.functions.lookup functionName with
              | none =>
                  simp [EvmYul.Yul.execCall, EvmYul.Yul.call, hFind,
                    hLookup, EvmYul.Yul.multifill'] at hExecCall
                  subst err
                  cases hRelatable
              | some fn =>
                  cases hBody :
                      EvmYul.Yul.exec bodyFuel (.Block fn.body)
                          (some contract)
                          (👌 state.initcall fn.params fn.rets args) with
                  | error bodyErr =>
                      simp [EvmYul.Yul.execCall, EvmYul.Yul.call, hFind,
                        hLookup, hBody, EvmYul.Yul.multifill'] at hExecCall
                      subst err
                      exact
                        ⟨bodyFuel, yulAccount, fn, rfl, rfl, rfl,
                          hBody⟩
                  | ok bodyState =>
                      simp [EvmYul.Yul.execCall, EvmYul.Yul.call, hFind,
                        hLookup, hBody, EvmYul.Yul.multifill'] at hExecCall

theorem call_user_error_contract_body_exists_of_relatable
    {callFuel : Nat} {state : State}
    {args : List Word} {functionName : Name}
    {contract : AstContract} {err : Exception}
    (hCall :
      EvmYul.Yul.call callFuel args (some functionName)
          (some contract) state =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    ∃ bodyFuel : Nat,
    ∃ yulAccount : EvmYul.Account .Yul, ∃ fn : AstFunctionDefinition,
      callFuel = bodyFuel.succ ∧
      state.sharedState.accountMap.find? state.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec bodyFuel (.Block fn.body) (some contract)
          (👌 state.initcall fn.params fn.rets args) =
        .error err := by
  cases callFuel with
  | zero =>
      simp [EvmYul.Yul.call] at hCall
      subst err
      cases hRelatable
  | succ bodyFuel =>
      cases hFind :
          state.sharedState.accountMap.find? state.executionEnv.codeOwner with
      | none =>
          simp [EvmYul.Yul.call, hFind] at hCall
          subst err
          cases hRelatable
      | some yulAccount =>
          cases hLookup : contract.functions.lookup functionName with
          | none =>
              simp [EvmYul.Yul.call, hFind, hLookup] at hCall
              subst err
              cases hRelatable
          | some fn =>
              cases hBody :
                  EvmYul.Yul.exec bodyFuel (.Block fn.body) (some contract)
                      (👌 state.initcall fn.params fn.rets args) with
              | error bodyErr =>
                  simp [EvmYul.Yul.call, hFind, hLookup, hBody] at hCall
                  subst err
                  exact ⟨bodyFuel, yulAccount, fn, rfl, rfl, rfl, hBody⟩
              | ok bodyState =>
                  simp [EvmYul.Yul.call, hFind, hLookup, hBody] at hCall

theorem eval_user_call_error_split_of_relatable
    {sourceFuel : Nat} {functionName : Name} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {source : State} {err : Exception}
    (hEval :
      EvmYul.Yul.eval sourceFuel (.Call (.inr functionName) args)
          codeOverride source =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    ∃ argFuel,
      sourceFuel = argFuel.succ ∧
        (EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
          .error err ∨
          ∃ sourceAfterArgs : State,
          ∃ argValues : List Word,
            EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
              .ok (sourceAfterArgs, argValues.reverse) ∧
            EvmYul.Yul.call argFuel argValues functionName codeOverride
                sourceAfterArgs =
              .error err) := by
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
        at hEval
      subst err
      cases hRelatable
  | succ argFuel =>
      refine ⟨argFuel, rfl, ?_⟩
      cases hArgs :
          EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source with
      | error argErr =>
          left
          have hArgErr : argErr = err := by
            simpa [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
              EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs] using hEval
          simpa [hArgErr] using hArgs
      | ok argResult =>
          rcases argResult with ⟨sourceAfterArgs, rawValues⟩
          cases hCall :
              EvmYul.Yul.call argFuel rawValues.reverse functionName
                codeOverride sourceAfterArgs with
          | error callErr =>
              right
              have hCallErr : callErr = err := by
                simpa [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hCall]
                  using hEval
              refine ⟨sourceAfterArgs, rawValues.reverse, ?_, ?_⟩
              · simpa using hArgs
              · simpa [hCallErr] using hCall
          | ok callResult =>
              rcases callResult with ⟨sourceAfterCall, callValues⟩
              cases callValues with
              | nil =>
                  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                    EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hCall]
                    at hEval
              | cons value rest =>
                  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                    EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hCall]
                    at hEval

theorem eval_user_call_ok_split
    {sourceFuel : Nat} {functionName : Name} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {source sourceAfter : State} {value : Word}
    (hEval :
      EvmYul.Yul.eval sourceFuel (.Call (.inr functionName) args)
          codeOverride source =
        .ok (sourceAfter, value)) :
    ∃ argFuel,
      sourceFuel = argFuel.succ ∧
      ∃ sourceAfterArgs : State,
      ∃ argValues : List Word,
      ∃ returnValues : List Word,
        EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
          .ok (sourceAfterArgs, argValues.reverse) ∧
        EvmYul.Yul.call argFuel argValues functionName codeOverride
            sourceAfterArgs =
          .ok (sourceAfter, returnValues) ∧
        returnValues.head! = value := by
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
        at hEval
  | succ argFuel =>
      refine ⟨argFuel, rfl, ?_⟩
      cases hArgs :
          EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source with
      | error argErr =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
            EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs] at hEval
      | ok argResult =>
          rcases argResult with ⟨sourceAfterArgs, rawValues⟩
          cases hCall :
              EvmYul.Yul.call argFuel rawValues.reverse functionName
                codeOverride sourceAfterArgs with
          | error callErr =>
              simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hCall]
                at hEval
          | ok callResult =>
              rcases callResult with ⟨sourceAfterCall, returnValues⟩
              simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hCall]
                at hEval
              rcases hEval with ⟨hState, hValue⟩
              subst sourceAfterCall
              subst value
              exact
                ⟨sourceAfterArgs, rawValues.reverse, returnValues,
                  by simpa using hArgs, by simpa using hCall, rfl⟩

/--
Decompose a terminal expression-statement user call after its arguments have
already evaluated successfully.

The argument-terminal branch is intentionally not covered here; it belongs to
the terminal argument-prelude wrappers.  This lemma isolates the callee-terminal
branch needed by the recursive user-call successor case.
-/
theorem exec_block_expr_user_call_error_body_exists_of_evalArgs_relatable
    {sourceFuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {sourceAfterArgs : State} {argValues : List Word}
    {functionName : Name} {args : List AstExpr}
    {contract : AstContract} {err : Exception}
    (hArgEval :
      EvmYul.Yul.evalArgs sourceFuel args.reverse (some contract)
          (.Ok shared store) =
        .ok (sourceAfterArgs, argValues.reverse))
    (hExecBlock :
      EvmYul.Yul.exec sourceFuel.succ.succ.succ
          (.Block [.ExprStmtCall (.Call (.inr functionName) args)])
          (some contract) (.Ok shared store) =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    ∃ bodyFuel : Nat,
    ∃ yulAccount : EvmYul.Account .Yul,
    ∃ fn : AstFunctionDefinition,
      bodyFuel ≤ sourceFuel ∧
      sourceAfterArgs.sharedState.accountMap.find?
          sourceAfterArgs.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec bodyFuel (.Block fn.body) (some contract)
          (👌 sourceAfterArgs.initcall fn.params fn.rets argValues) =
        .error err := by
  have hExecCall :
      EvmYul.Yul.execCall sourceFuel functionName [] (some contract)
          (.ok (sourceAfterArgs, argValues)) =
        .error err := by
    rw [Imported.exec_block_cons_succ] at hExecBlock
    simp [EvmYul.Yul.execSeq, Imported.exec_expr_user_call_succ,
      hArgEval, EvmYul.Yul.reverse'] at hExecBlock
    cases hCall :
        EvmYul.Yul.execCall sourceFuel functionName [] (some contract)
          (.ok (sourceAfterArgs, argValues)) with
    | error callErr =>
        have hErr : callErr = err := by
          simpa [hCall] using hExecBlock
        subst callErr
        rfl
    | ok callState =>
        cases callState <;> simp [hCall] at hExecBlock
  rcases
      execCall_user_error_contract_body_exists_of_relatable
        (callFuel := sourceFuel) (state := sourceAfterArgs)
        (args := argValues) (functionName := functionName)
        (targets := []) (contract := contract) hExecCall hRelatable with
    ⟨bodyFuel, yulAccount, fn, hFuelEq, hFind, hLookup, hBody⟩
  have hBodyFuel : bodyFuel ≤ sourceFuel := by omega
  exact ⟨bodyFuel, yulAccount, fn, hBodyFuel, hFind, hLookup, hBody⟩

/--
Split an expression-statement user-call singleton block at the argument
evaluation boundary.

The successful branch is exactly the premise consumed by the existing
`*_actual` user-call wrappers.  The error branch records that the imported run
is already the argument-side error; under the public `SourceResultRelatable`
filter this can only be a Yul halt/revert style result, so it belongs to the
argument-terminal prelude path rather than to the selected-callee path.
-/
theorem exec_block_expr_user_call_evalArgs_split_of_relatable
    {sourceFuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {functionName : Name} {args : List AstExpr}
    {contract : AstContract}
    {sourceResult : Except Exception State}
    (hExecBlock :
      EvmYul.Yul.exec sourceFuel.succ.succ.succ
          (.Block [.ExprStmtCall (.Call (.inr functionName) args)])
          (some contract) (.Ok shared store) =
        sourceResult)
    (hRelatable : SourceResultRelatable sourceResult) :
    (∃ sourceAfterArgs : State,
      ∃ argValues : List Word,
        EvmYul.Yul.evalArgs sourceFuel args.reverse (some contract)
            (.Ok shared store) =
          .ok (sourceAfterArgs, argValues.reverse)) ∨
    (∃ err : Exception,
      EvmYul.Yul.evalArgs sourceFuel args.reverse (some contract)
          (.Ok shared store) =
        .error err ∧
      sourceResult = .error err ∧
      SourceResultRelatable (.error err)) := by
  cases hArgs :
      EvmYul.Yul.evalArgs sourceFuel args.reverse (some contract)
        (.Ok shared store) with
  | ok argResult =>
      rcases argResult with ⟨sourceAfterArgs, rawValues⟩
      refine Or.inl ⟨sourceAfterArgs, rawValues.reverse, ?_⟩
      simpa using hArgs
  | error err =>
      have hResult : sourceResult = .error err := by
        rw [Imported.exec_block_cons_succ] at hExecBlock
        simp [EvmYul.Yul.execSeq, Imported.exec_expr_user_call_succ,
          hArgs, EvmYul.Yul.reverse', Imported.execCall_error]
          at hExecBlock
        exact hExecBlock.symm
      exact Or.inr ⟨err, rfl, hResult, by simpa [hResult] using hRelatable⟩

/--
Split an expression-statement primitive singleton block at the argument
evaluation boundary.

This is the primitive-call sibling of
`exec_block_expr_user_call_evalArgs_split_of_relatable`: before the primitive
suffix can run, the imported Yul evaluator must either produce the argument
values or return exactly the argument-side terminal/revert error.
-/
theorem exec_block_expr_prim_call_evalArgs_split_of_relatable
    {sourceFuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {yulPrim : EvmYul.Operation .Yul} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {sourceResult : Except Exception State}
    (hExecBlock :
      EvmYul.Yul.exec sourceFuel.succ.succ.succ
          (.Block [.ExprStmtCall (.Call (.inl yulPrim) args)])
          codeOverride (.Ok shared store) =
        sourceResult)
    (hRelatable : SourceResultRelatable sourceResult) :
    (∃ sourceAfterArgs : State,
      ∃ argValues : List Word,
        EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
            (.Ok shared store) =
          .ok (sourceAfterArgs, argValues.reverse)) ∨
    (∃ err : Exception,
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
          (.Ok shared store) =
        .error err ∧
      sourceResult = .error err ∧
      SourceResultRelatable (.error err)) := by
  cases hArgs :
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
        (.Ok shared store) with
  | ok argResult =>
      rcases argResult with ⟨sourceAfterArgs, rawValues⟩
      refine Or.inl ⟨sourceAfterArgs, rawValues.reverse, ?_⟩
      simpa using hArgs
  | error err =>
      have hResult : sourceResult = .error err := by
        rw [Imported.exec_block_cons_succ] at hExecBlock
        simp [EvmYul.Yul.execSeq, Imported.exec_expr_prim_call_succ,
          hArgs, EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall]
          at hExecBlock
        exact hExecBlock.symm
      exact Or.inr ⟨err, rfl, hResult, by simpa [hResult] using hRelatable⟩

/--
Split an expression-statement primitive open sequence at the argument
evaluation boundary.

This is the `head :: rest` analogue of
`exec_block_expr_prim_call_evalArgs_split_of_relatable`, used by the recursive
hidden-sequence frontier.
-/
theorem execSeq_expr_prim_call_evalArgs_split_of_relatable
    {sourceFuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {yulPrim : EvmYul.Operation .Yul} {args : List AstExpr}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {sourceResult : Except Exception State}
    (hExecSeq :
      EvmYul.Yul.execSeq sourceFuel.succ.succ
          (.ExprStmtCall (.Call (.inl yulPrim) args) :: rest)
          codeOverride (.Ok shared store) =
        sourceResult)
    (hRelatable : SourceResultRelatable sourceResult) :
    (∃ sourceAfterArgs : State,
      ∃ argValues : List Word,
        EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
            (.Ok shared store) =
          .ok (sourceAfterArgs, argValues.reverse)) ∨
    (∃ err : Exception,
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
          (.Ok shared store) =
        .error err ∧
      sourceResult = .error err ∧
      SourceResultRelatable (.error err)) := by
  cases hArgs :
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
        (.Ok shared store) with
  | ok argResult =>
      rcases argResult with ⟨sourceAfterArgs, rawValues⟩
      refine Or.inl ⟨sourceAfterArgs, rawValues.reverse, ?_⟩
      simpa using hArgs
  | error err =>
      have hHead :
          EvmYul.Yul.exec sourceFuel.succ
              (.ExprStmtCall (.Call (.inl yulPrim) args))
              codeOverride (.Ok shared store) =
            .error err := by
        simp [Imported.exec_expr_prim_call_succ, hArgs,
          EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall]
      have hResult : sourceResult = .error err := by
        have hSeqHead :
            EvmYul.Yul.execSeq sourceFuel.succ.succ
                (.ExprStmtCall (.Call (.inl yulPrim) args) :: rest)
                codeOverride (.Ok shared store) =
              .error err :=
          Imported.execSeq_cons_error_succ hHead
        rw [hSeqHead] at hExecSeq
        exact hExecSeq.symm
      exact Or.inr ⟨err, rfl, hResult, by simpa [hResult] using hRelatable⟩

theorem evalValues_prim_call_ok_of_evalArgs_ok_primCall_ok
    {sourceFuel : Nat} {source sourceAfterArgs sourceAfterPrim : State}
    {yulPrim : EvmYul.Operation .Yul} {args : List AstExpr}
    {codeOverride : Option AstContract} {argValues values : List Word}
    (hArgs :
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
        .ok (sourceAfterArgs, argValues.reverse))
    (hPrim :
      EvmYul.Yul.primCall sourceFuel sourceAfterArgs yulPrim argValues =
