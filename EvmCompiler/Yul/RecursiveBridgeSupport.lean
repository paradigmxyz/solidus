    (sourceResultSeqSoundWhenAtExactHiddenCtx_cons_for_head_of_imported_loop_branches
      (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
      (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
      (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
      (cond := cond) (post := post) (body := body) (rest := rest)
      (codeOverride := codeOverride) (pre := pieces.preCond)
      (lowerCond := pieces.lowerCond) (lowerPost := pieces.lowerPost)
      (lowerBody := pieces.lowerBody) (allowed := allowed)
