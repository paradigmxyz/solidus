theorem of_handler_eq
    {ctx ctx' : Functions.Source.Ctx} {currentLayout : List Name}
    {konts : SourceModeKontLayouts}
    {sourceResult : Except Exception State}
    (hBreak : ctx'.breakScope? = ctx.breakScope?)
    (hContinue : ctx'.continueScope? = ctx.continueScope?)
    (hLeave : ctx'.leaveScope? = ctx.leaveScope?)
    (hSupported :
      SourceResultModeKontSupported ctx currentLayout konts sourceResult) :
    SourceResultModeKontSupported ctx' currentLayout konts sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultModeKontSupported] using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [SourceResultModeKontSupported] using hSupported
      | OutOfFuel =>
          simp [SourceResultModeKontSupported]
      | Checkpoint jump =>
          cases jump
          · rcases hSupported with ⟨continueScope, hScope, hContains⟩
            refine ⟨continueScope, ?_, hContains⟩
            rw [hContinue]
            exact hScope
          · rcases hSupported with ⟨breakScope, hScope, hContains⟩
            refine ⟨breakScope, ?_, hContains⟩
            rw [hBreak]
            exact hScope
          · simpa [SourceResultModeKontSupported, hLeave] using hSupported

theorem of_restrictStoreTo
    {ctx : Functions.Source.Ctx} {currentLayout : List Name}
    {konts : SourceModeKontLayouts} {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    (hSupported :
      SourceResultModeKontSupported ctx currentLayout konts
        (restrictSourceResultTo scope sourceResult)) :
    SourceResultModeKontSupported ctx currentLayout konts sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [restrictSourceResultTo, SourceResultModeKontSupported]
        using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [restrictSourceResultTo, SourceResultModeKontSupported,
            EvmYul.Yul.State.restrictStoreTo] using hSupported
      | OutOfFuel =>
          simp [SourceResultModeKontSupported]
      | Checkpoint jump =>
          cases jump <;>
            simpa [restrictSourceResultTo, SourceResultModeKontSupported,
              EvmYul.Yul.State.restrictStoreTo] using hSupported

theorem mono_currentLayout
    {ctx : Functions.Source.Ctx} {currentLayout currentLayout' : List Name}
    {konts : SourceModeKontLayouts}
    {sourceResult : Except Exception State}
    (hSubset :
      ∀ name : Name, name ∈ currentLayout → name ∈ currentLayout')
    (hSupported :
      SourceResultModeKontSupported ctx currentLayout konts sourceResult) :
    SourceResultModeKontSupported ctx currentLayout' konts sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultModeKontSupported] using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          intro name hMem
          exact hSubset name (hSupported name hMem)
      | OutOfFuel =>
          simp [SourceResultModeKontSupported]
      | Checkpoint jump =>
          cases jump
          · simpa [SourceResultModeKontSupported] using hSupported
          · simpa [SourceResultModeKontSupported] using hSupported
