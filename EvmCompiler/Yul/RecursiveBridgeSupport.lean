          (.ok (Functions.Source.Outcome.cont compilerAfterBody,
            ctxAfterBody)))
    (hTargetPost :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl) lowerPost postFuel compilerAfterBody)
        postTrace (.ok (Functions.Source.Outcome.regular compilerAfterPost)))
