theorem safeBasicZeroOutputPrimCall_error_not_relatable
    {sourceFuel : Nat} {primOp : EvmYul.Operation .Yul}
    {op : Structured.BasicOp}
    {source : State} {args : List Word} {err : Exception}
    (hSafe : Safe.primitive primOp)
    (hBasic : Prim.toBasicOp? primOp = some op)
    (hOutputs : Expressions.Structured.BasicOp.outputs op = 0)
    (hCall :
      EvmYul.Yul.primCall sourceFuel source primOp args = .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    False := by
  cases sourceFuel with
  | zero =>
      simp [EvmYul.Yul.primCall] at hCall
      subst err
      exact sourceResultRelatable_outOfFuel_false hRelatable
  | succ fuel =>
      cases primOp with
      | StopArith stopArith =>
          cases stopArith with
          | STOP =>
              simp [Prim.toBasicOp?] at hBasic
          | ADD | MUL | SUB | DIV | SDIV | MOD | SMOD | ADDMOD | MULMOD
          | EXP | SIGNEXTEND =>
              simp [Prim.toBasicOp?] at hBasic
              rw [← hBasic] at hOutputs
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
      | CompBit compBit =>
          cases compBit <;>
            simp [Prim.toBasicOp?] at hBasic <;>
            rw [← hBasic] at hOutputs <;>
            simp [Expressions.Structured.BasicOp.outputs] at hOutputs
      | Keccak keccak =>
          cases keccak
          simp [Prim.toBasicOp?] at hBasic
          rw [← hBasic] at hOutputs
          simp [Expressions.Structured.BasicOp.outputs] at hOutputs
      | Env env =>
          cases env with
          | ADDRESS | BALANCE | ORIGIN | CALLER | CALLVALUE
          | CALLDATALOAD | CALLDATASIZE | GASPRICE | RETURNDATASIZE =>
              simp [Prim.toBasicOp?] at hBasic
              rw [← hBasic] at hOutputs
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
          | CALLDATACOPY =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.ternaryCopyOp
                      EvmYul.SharedState.calldatacopy source args) =
                    .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CALLDATACOPY : EvmYul.Operation .Yul))
                        none =
                      EvmYul.Yul.ternaryCopyOp
                        EvmYul.SharedState.calldatacopy := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_ternaryCopyOp_error_not_relatable
                hExec hRelatable
          | CODESIZE =>
              simp [Prim.toBasicOp?] at hBasic
              rw [← hBasic] at hOutputs
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
          | CODECOPY =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.ternaryCopyOp
                      EvmYul.SharedState.codeBytesCopy source args) =
                    .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.Env .CODECOPY : EvmYul.Operation .Yul)) none =
                      EvmYul.Yul.ternaryCopyOp
                        EvmYul.SharedState.codeBytesCopy := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_ternaryCopyOp_error_not_relatable
                hExec hRelatable
            | EXTCODESIZE | EXTCODEHASH =>
                simp [Prim.toBasicOp?] at hBasic
                rw [← hBasic] at hOutputs
                simp [Expressions.Structured.BasicOp.outputs] at hOutputs
            | EXTCODECOPY =>
                have hExec :
                    yulPrimListResult
                      (EvmYul.Yul.quaternaryCopyOp
                        EvmYul.SharedState.extCodeCopy' source args) =
                      .error err := by
                  simp [EvmYul.Yul.primCall] at hCall
                  have hStep :
                      EvmYul.step
                          ((.Env .EXTCODECOPY : EvmYul.Operation .Yul))
                          none =
                        EvmYul.Yul.quaternaryCopyOp
                          EvmYul.SharedState.extCodeCopy' := by
                    rfl
                  rw [hStep] at hCall
                  simpa [yulPrimListResult] using hCall
                exact wrapped_yul_quaternaryCopyOp_error_not_relatable
                  hExec hRelatable
          | RETURNDATACOPY =>
              simp [EvmYul.Yul.primCall] at hCall
              have hStep :
                  EvmYul.step
                      ((.Env .RETURNDATACOPY : EvmYul.Operation .Yul))
                      none =
                    (fun yulState lits =>
                      match lits with
                      | [a, b, c] =>
                          if yulState.toSharedState.returnData.size <
                              b.toNat + c.toNat then
                            .error .InvalidMemoryAccess
                          else
                            let mState' :=
                              yulState.toSharedState.toMachineState
                                |>.returndatacopy a b c
                            .ok (yulState.setMachineState mState', .none)
                      | _ => .error .InvalidArguments) := by
                rfl
              rw [hStep] at hCall
              cases args with
              | nil =>
                  simp [yulPrimListResult] at hCall
                  subst err
                  simpa [SourceResultRelatable] using hRelatable
              | cons a rest =>
                  cases rest with
                  | nil =>
                      simp [yulPrimListResult] at hCall
                      subst err
                      simpa [SourceResultRelatable] using hRelatable
                  | cons b tail =>
                      cases tail with
                      | nil =>
                          simp [yulPrimListResult] at hCall
                          subst err
                          simpa [SourceResultRelatable] using hRelatable
                      | cons c tail' =>
                          cases tail' with
                          | nil =>
                              by_cases hBounds :
                                  source.toSharedState.returnData.size <
                                    b.toNat + c.toNat
                              · simp [yulPrimListResult, hBounds] at hCall
                                subst err
                                simpa [SourceResultRelatable] using hRelatable
                              · simp [yulPrimListResult, hBounds] at hCall
                          | cons d tail'' =>
                              simp [yulPrimListResult] at hCall
                              subst err
                              simpa [SourceResultRelatable] using hRelatable
      | Block block =>
          cases block <;>
            simp [Prim.toBasicOp?] at hBasic <;>
            rw [← hBasic] at hOutputs <;>
            simp [Expressions.Structured.BasicOp.outputs] at hOutputs
      | StackMemFlow smsf =>
          cases smsf with
          | POP =>
              simp [EvmYul.Yul.primCall] at hCall
              have hStep :
                  EvmYul.step
                      ((.StackMemFlow .POP : EvmYul.Operation .Yul)) none =
                    (fun yulState _ => .ok (yulState, .none)) := by
                rfl
              rw [hStep] at hCall
              simp [yulPrimListResult] at hCall
          | MLOAD | SLOAD | TLOAD =>
              simp [Prim.toBasicOp?] at hBasic
              rw [← hBasic] at hOutputs
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
          | MSIZE | GAS =>
              simp [Prim.toBasicOp?] at hBasic
          | MSTORE =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.binaryMachineStateOp
                      EvmYul.MachineState.mstore source args) =
                    .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.StackMemFlow .MSTORE : EvmYul.Operation .Yul))
                        none =
                      EvmYul.Yul.binaryMachineStateOp
                        EvmYul.MachineState.mstore := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_binaryMachineStateOp_error_not_relatable
                hExec hRelatable
          | SSTORE =>
              simp [EvmYul.Yul.primCall] at hCall
              have hStep :
                  EvmYul.step
                      ((.StackMemFlow .SSTORE : EvmYul.Operation .Yul))
                      none =
                    EvmYul.Yul.binaryStateOp EvmYul.State.sstore := by
                rfl
              rw [hStep] at hCall
              by_cases hPerm :
                  (EvmYul.Yul.State.executionEnv source).perm = false
              · rw [if_pos hPerm] at hCall
                change
                  (Except.error EvmYul.Yul.Exception.StaticModeViolation :
                    Except Exception (State × List Word)) =
                    Except.error err at hCall
                cases hCall
                simpa [SourceResultRelatable] using hRelatable
              · rw [if_neg hPerm] at hCall
                exact wrapped_yul_binaryStateOp_error_not_relatable
                  (by simpa [yulPrimListResult] using hCall) hRelatable
          | MSTORE8 =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.binaryMachineStateOp
                      EvmYul.MachineState.mstore8 source args) =
                    .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.StackMemFlow .MSTORE8 : EvmYul.Operation .Yul))
                        none =
                      EvmYul.Yul.binaryMachineStateOp
                        EvmYul.MachineState.mstore8 := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_binaryMachineStateOp_error_not_relatable
                hExec hRelatable
          | TSTORE =>
              simp [EvmYul.Yul.primCall] at hCall
              have hStep :
                  EvmYul.step
                      ((.StackMemFlow .TSTORE : EvmYul.Operation .Yul))
                      none =
                    EvmYul.Yul.binaryStateOp EvmYul.State.tstore := by
                rfl
              rw [hStep] at hCall
              by_cases hPerm :
                  (EvmYul.Yul.State.executionEnv source).perm = false
              · rw [if_pos hPerm] at hCall
                change
                  (Except.error EvmYul.Yul.Exception.StaticModeViolation :
                    Except Exception (State × List Word)) =
                    Except.error err at hCall
                cases hCall
                simpa [SourceResultRelatable] using hRelatable
              · rw [if_neg hPerm] at hCall
                exact wrapped_yul_binaryStateOp_error_not_relatable
                  (by simpa [yulPrimListResult] using hCall) hRelatable
          | MCOPY =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.ternaryMachineStateOp
                      EvmYul.MachineState.mcopy source args) =
                    .error err := by
                simp [EvmYul.Yul.primCall] at hCall
                have hStep :
                    EvmYul.step
                        ((.StackMemFlow .MCOPY : EvmYul.Operation .Yul))
                        none =
                      EvmYul.Yul.ternaryMachineStateOp
                        EvmYul.MachineState.mcopy := by
                  rfl
                rw [hStep] at hCall
                simpa [yulPrimListResult] using hCall
              exact wrapped_yul_ternaryMachineStateOp_error_not_relatable
                hExec hRelatable
      | Log log =>
          cases log with
          | LOG0 =>
              exact primCall_log0_error_not_relatable hCall hRelatable
          | LOG1 =>
              exact primCall_log1_error_not_relatable hCall hRelatable
          | LOG2 =>
              exact primCall_log2_error_not_relatable hCall hRelatable
          | LOG3 =>
              exact primCall_log3_error_not_relatable hCall hRelatable
          | LOG4 =>
              exact primCall_log4_error_not_relatable hCall hRelatable
      | System sys =>
          cases sys with
          | INVALID =>
              simp [EvmYul.Yul.primCall] at hCall
              have hStep :
                  EvmYul.step
                      ((.System .INVALID : EvmYul.Operation .Yul)) none =
                    (fun _ _ => .error EvmYul.Yul.Exception.InvalidInstruction) := by
                rfl
              rw [hStep] at hCall
              simp [yulPrimListResult] at hCall
              subst err
              simpa [SourceResultRelatable] using hRelatable
          | CREATE | CALL | CALLCODE | RETURN | DELEGATECALL | CREATE2
          | STATICCALL | REVERT | SELFDESTRUCT =>
              simp [Safe.primitive, Prim.toBasicOp?] at hSafe hBasic

def DirectCallArgEvalNoRel (expr : AstExpr) : Prop :=
  ∀ {sourceFuel : Nat} {codeOverride : Option AstContract}
    {source : State} {err : Exception},
    Expr.directCallArgSafe? expr = true →
    EvmYul.Yul.eval sourceFuel expr codeOverride source = .error err →
    SourceResultRelatable (.error err) →
    False

theorem directCallArgsSafe_evalArgs_error_not_relatable_of_all
    {args : List AstExpr}
    (hAll : ∀ expr, expr ∈ args → DirectCallArgEvalNoRel expr)
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {source : State} {err : Exception}
    (hSafe : Expr.List.directCallArgsSafe? args = true)
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel args codeOverride source = .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    False := by
  induction args generalizing sourceFuel source err with
  | nil =>
      exact evalArgs_nil_error_not_relatable hEval hRelatable
  | cons head rest ih =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
          subst err
          exact sourceResultRelatable_outOfFuel_false hRelatable
      | succ fuel =>
          simp [Expr.List.directCallArgsSafe?] at hSafe

set_option maxHeartbeats 1200000 in
theorem directCallArgSafe_eval_error_not_relatable
    (expr : AstExpr) : DirectCallArgEvalNoRel expr := by
  exact
    EvmYul.Yul.Ast.Expr.rec
      (motive_1 := fun _ => True)
      (motive_2 := DirectCallArgEvalNoRel)
      (motive_3 := fun _ => True)
      (motive_4 := fun _ => True)
      (motive_5 := fun args =>
        ∀ expr, expr ∈ args → DirectCallArgEvalNoRel expr)
      (motive_6 := fun _ => True)
      (motive_7 := fun _ => True)
      (motive_8 := fun _ => True)
      (fun _ _ _ _ => trivial)
      (by
        intro fn args hArgs
        intro sourceFuel codeOverride source err hSafe hEval hRelatable
        cases sourceFuel with
        | zero =>
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
              at hEval
            subst err
            exact sourceResultRelatable_outOfFuel_false hRelatable
        | succ fuel =>
            cases fn with
            | inl yulPrim =>
                cases hPure : Expr.pureAliasPrim? yulPrim <;>
                  cases hArgsSafe : Expr.List.directCallArgsSafe? args <;>
                    simp [Expr.directCallArgSafe?, hPure, hArgsSafe] at hSafe
                cases hArgsEval :
                    EvmYul.Yul.evalArgs fuel args.reverse codeOverride source
                with
                | error argErr =>
                    have hArgErr : argErr = err := by
                      simpa [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                        EvmYul.Yul.reverse', EvmYul.Yul.head', hArgsEval]
                        using hEval
                    subst err
                    exact
                      directCallArgsSafe_evalArgs_error_not_relatable_of_all
                        (args := args.reverse)
                        (hAll := by
                          intro expr hMem
                          exact hArgs expr (by
                            simpa [List.mem_reverse] using hMem))
                        (sourceFuel := fuel) (codeOverride := codeOverride)
                        (source := source) (err := argErr)
                        (directCallArgsSafe_reverse_of_true hArgsSafe)
                        hArgsEval hRelatable
                | ok argResult =>
                    rcases argResult with ⟨sourceAfterArgs, rawValues⟩
                    cases hPrim :
                        EvmYul.Yul.primCall fuel sourceAfterArgs yulPrim
                          rawValues.reverse with
                    | error primErr =>
                        have hPrimErr : primErr = err := by
                          simpa [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                            EvmYul.Yul.reverse', EvmYul.Yul.head',
                            hArgsEval, hPrim] using hEval
                        subst err
                        exact
                          pureAliasPrim_primCall_error_not_relatable hPure
                            hPrim hRelatable
                    | ok primResult =>
                        rcases primResult with ⟨sourceAfterPrim, values⟩
                        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                          EvmYul.Yul.reverse', EvmYul.Yul.head', hArgsEval,
                          hPrim] at hEval
            | inr functionName =>
                simp [Expr.directCallArgSafe?] at hSafe)
      (by
        intro name sourceFuel codeOverride source err hSafe hEval hRelatable
        cases sourceFuel with
        | zero =>
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
              at hEval
            subst err
            exact sourceResultRelatable_outOfFuel_false hRelatable
        | succ fuel =>
            cases hLookup : source.lookup? name with
            | none =>
                simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.head', hLookup] at hEval
                subst err
                simpa [SourceResultRelatable] using hRelatable
            | some value =>
                simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.head', hLookup] at hEval)
      (by
        intro value sourceFuel codeOverride source err hSafe hEval hRelatable
        cases sourceFuel with
        | zero =>
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
              at hEval
            subst err
            exact sourceResultRelatable_outOfFuel_false hRelatable
        | succ fuel =>
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
              at hEval)
      (fun _ _ => trivial)
      (fun _ _ _ => trivial)
      (fun _ _ _ => trivial)
      (fun _ _ => trivial)
      (fun _ _ _ _ _ _ => trivial)
      (fun _ _ _ _ _ _ => trivial)
      (fun _ _ _ _ => trivial)
      trivial
      trivial
      trivial
      trivial
      (fun _ _ _ _ => trivial)
      (by
        intro expr hMem
        cases hMem)
      (by
        intro head tail hHead hTail
        intro expr hMem
        simp at hMem
        cases hMem with
        | inl hEq =>
            subst expr
            exact hHead
        | inr hMemTail =>
            exact hTail expr hMemTail)
      trivial
      (fun _ _ => trivial)
      trivial
      (fun _ _ _ _ => trivial)
      (fun _ _ _ => trivial)
      expr

theorem directCallArgsSafe_evalArgs_error_not_relatable
    {args : List AstExpr} {sourceFuel : Nat}
    {codeOverride : Option AstContract} {source : State}
    {err : Exception}
    (hSafe : Expr.List.directCallArgsSafe? args = true)
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel args codeOverride source = .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    False :=
  directCallArgsSafe_evalArgs_error_not_relatable_of_all
    (args := args)
    (hAll := by
      intro expr _hMem
      exact directCallArgSafe_eval_error_not_relatable expr)
    hSafe hEval hRelatable

theorem sourceExprPreludeTerminalAt_direct
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    (hSafe : Expr.directCallArgSafe? expr = true) :
    SourceExprPreludeTerminalAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel expr codeOverride [] :=
  SourceExprPreludeTerminalAt.of_no_relatable_eval_error
    (by
      intro source compiler err _hInitial hEval hRelatable
      exact
        directCallArgSafe_eval_error_not_relatable expr
          hSafe hEval hRelatable)

/--
Terminal/error bridge for a primitive expression prelude, parameterized by the
one remaining primitive-side error fact.

The generated prelude for a primitive expression only evaluates its arguments.
If imported Yul halts/reverts while evaluating those arguments, the argument
terminal bridge runs that prelude.  If argument evaluation succeeds and the
primitive call itself errors, that error must be outside the source-result
relation for the non-terminal one-result primitive families; callers discharge
that fact once at the primitive-family boundary instead of unfolding opcode
semantics inside the expression-recursion proof.
-/
theorem sourceExprPreludeTerminalAt_prim_of_args_terminal
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {args : List AstExpr} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    (hArgsTerminal :
      ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx},
        argFuel < sourceFuel →
        SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
          revertRel prim program ctxArg argFuel args codeOverride pre)
    (hPrimErr :
      ∀ {argFuel : Nat} {sourceAfterArgs : State} {rawValues : List Word}
        {err : Exception},
        argFuel < sourceFuel →
        EvmYul.Yul.primCall argFuel sourceAfterArgs yulPrim rawValues =
          .error err →
        SourceResultRelatable (.error err) → False) :
    ∀ {exprFuel : Nat} {ctxHead : Functions.Source.Ctx},
      exprFuel < sourceFuel →
      SourceExprPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program ctxHead exprFuel (.Call (.inl yulPrim) args)
        codeOverride pre := by
  intro exprFuel ctxHead hExprFuelLt
  cases exprFuel with
  | zero =>
      exact
        SourceExprPreludeTerminalAt.of_no_relatable_eval_error
          (by
            intro source compiler err _hInitial hEval hRelatable
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
              EvmYul.Yul.head'] at hEval
            subst err
            exact sourceResultRelatable_outOfFuel_false hRelatable)
  | succ argFuel =>
      intro source compiler err hInitial hEval hRelatable
      have hArgFuelLt : argFuel < sourceFuel := by omega
      cases hArgs :
          EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source with
      | error argErr =>
          have hArgErr : argErr = err := by
            simpa [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
              EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs] using hEval
          subst err
          exact (hArgsTerminal hArgFuelLt) hInitial hArgs hRelatable
      | ok argResult =>
          rcases argResult with ⟨sourceAfterArgs, rawValues⟩
          cases hPrim :
              EvmYul.Yul.primCall argFuel sourceAfterArgs yulPrim
                rawValues.reverse with
          | error primErr =>
              have hPrimErrEq : primErr = err := by
                simpa [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hPrim]
                  using hEval
              subst err
              exact False.elim (hPrimErr hArgFuelLt hPrim hRelatable)
          | ok primResult =>
              rcases primResult with ⟨sourceAfterPrim, values⟩
              cases values with
              | nil =>
                  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                    EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hPrim]
                    at hEval
              | cons value rest =>
                  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                    EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs, hPrim]
                    at hEval

theorem sourceArgListPreludeTerminalAt_direct
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {lowerArgs : List (Locals.Expr 1)}
    (hSafe : Expr.List.directCallArgsSafe? args = true)
    (_hLower : Expr.List.toLocals1? args = some lowerArgs) :
    SourceArgListPreludeTerminalAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel args codeOverride [] :=
  SourceArgListPreludeTerminalAt.of_no_relatable_evalArgs_error
    (by
      intro source compiler err _hInitial hEval hRelatable
      exact
        directCallArgsSafe_evalArgs_error_not_relatable
          (directCallArgsSafe_reverse_of_true hSafe) hEval hRelatable)

theorem SourceArgListPreludeRegular.toAt
    {cfg : StateRelConfig}
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lower : List (Locals.Expr 1)}
    (hArgs :
      SourceArgListPreludeRegular cfg layout prim program ctx sourceFuel args
        codeOverride pre lower) :
    SourceArgListPreludeRegularAt cfg layout prim program ctx sourceFuel args
      codeOverride pre lower :=
  ⟨hArgs.2.1, hArgs.2.2⟩

/--
Fuel-bounded regular argument-prelude evidence for user-call arguments.

The recursive successor theorem needs this fact at many generated call sites
and in hidden compiler-only contexts.  Bundling it keeps the public proof
boundary compositional: callers provide one source-facing argument invariant
instead of duplicating direct/generated argument premises on every user-call
case.
-/
structure SourceArgListPreludeRegularAllAt
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program)
    (codeOverride : Option AstContract)
    (coverLayout : List Name)
    (maxFuel : Nat) : Prop where
  direct :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState : Fresh.State} {argList : List AstExpr}
      {lowerArgs : List (Locals.Expr 1)},
      argFuel ≤ maxFuel →
      FreshCoversLayout coverLayout freshState →
      Expr.List.directCallArgsSafe? argList = true →
      Expr.List.toLocals1? argList = some lowerArgs →
      SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
        argList codeOverride [] lowerArgs
  lower :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState freshState' : Fresh.State} {argList : List AstExpr}
      {pre : List Functions.Stmt}
      {lowerArgs : List (Locals.Expr 1)},
      argFuel ≤ maxFuel →
      FreshCoversLayout coverLayout freshState →
      Safe.exprs argList →
      Expr.List.lowerBound1? freshState argList =
        some (pre, lowerArgs, freshState') →
      SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
        argList codeOverride pre lowerArgs

/--
Scoped sibling of `SourceArgListPreludeRegularAllAt`.

The unscoped bundle is still useful for older call sites that already have a
fully-polymorphic expression theorem.  The recursive Nethermind-Yul bridge
needs the source-facing lexical fact explicitly: regular variable reads are
preserved only for variables in the visible `layout`.
-/
structure SourceArgListPreludeRegularAllScopedAt
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program)
    (codeOverride : Option AstContract)
    (coverLayout : List Name)
    (maxFuel : Nat) : Prop where
  direct :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState : Fresh.State} {argList : List AstExpr}
      {lowerArgs : List (Locals.Expr 1)},
      argFuel ≤ maxFuel →
      FreshCoversLayout coverLayout freshState →
      Expr.List.directCallArgsSafe? argList = true →
      Expr.List.toLocals1? argList = some lowerArgs →
      SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
        argList codeOverride [] lowerArgs
  lower :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState freshState' : Fresh.State} {argList : List AstExpr}
      {pre : List Functions.Stmt}
      {lowerArgs : List (Locals.Expr 1)},
      argFuel ≤ maxFuel →
      FreshCoversLayout coverLayout freshState →
      Safe.exprs argList →
      SourceExprsScoped layout argList →
      Expr.List.lowerBound1? freshState argList =
        some (pre, lowerArgs, freshState') →
      SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
        argList codeOverride pre lowerArgs

/--
Checked regular argument-prelude bundle.

This is the source-facing invariant the recursive Yul bridge should eventually
consume.  It carries the lexical expression scoping facts and the user-function
arity contract needed to recurse through nested user-call expressions; the
older `SourceArgListPreludeRegularAllAt` intentionally lacked those facts and
therefore behaved like a proof oracle for nested calls.
-/
structure SourceArgListPreludeRegularAllCheckedAt
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program)
    (contract : AstContract)
    (coverLayout : List Name)
    (maxFuel : Nat) : Prop where
  direct :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState : Fresh.State} {argList : List AstExpr}
      {lowerArgs : List (Locals.Expr 1)},
      argFuel ≤ maxFuel →
      FreshCoversLayout coverLayout freshState →
      Expr.List.directCallArgsSafe? argList = true →
      Expr.List.toLocals1? argList = some lowerArgs →
      SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
        argList (some contract) [] lowerArgs
  lower :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState freshState' : Fresh.State} {argList : List AstExpr}
      {pre : List Functions.Stmt}
      {lowerArgs : List (Locals.Expr 1)},
      argFuel ≤ maxFuel →
      FreshCoversLayout coverLayout freshState →
      Safe.exprs argList →
      SourceExprsScoped layout argList →
      UserCallArity.ExprsOk contract argList →
      Expr.List.lowerBound1? freshState argList =
        some (pre, lowerArgs, freshState') →
      SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
        argList (some contract) pre lowerArgs

