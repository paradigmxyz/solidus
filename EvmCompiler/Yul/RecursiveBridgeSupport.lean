  have hYul : yulPrim = kind.toYulOperation :=
    OpenExternal.CreateKind.toYulOperation_eq_ofYulOperation? hKind
  subst yulPrim
  rw [yulOpen_toOpenResult_evalValues_prim_eq_bind_args]
  refine
    OpenResultDoneInvariant.bind
