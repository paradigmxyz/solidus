    (codeOverride : Option AstContract) (reserved : List Name)
    (pieces : GeneratedForCompiled reserved layout cond post body)
    (allowedInner : Except Exception State → Prop) : Prop :=
  ∀ {shared sharedAfterCond sharedAfterBody sharedAfterPost :
        EvmYul.SharedState .Yul}
    {store storeAfterCond storeAfterBody storeAfterPost :
        EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State} {value : Word}
    {bodyWasContinue : Bool} {loopResult : Except Exception State},
    SourceStateExactRel cfg layout (.Ok shared store) compiler →
    EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
      .ok (.Ok sharedAfterCond storeAfterCond, value) →
    value ≠ EvmYul.UInt256.ofNat 0 →
    (if bodyWasContinue then
        EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
          (.Ok sharedAfterCond storeAfterCond) =
          .ok (.Checkpoint (.Continue sharedAfterBody storeAfterBody))
      else
        EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
          (.Ok sharedAfterCond storeAfterCond) =
          .ok (.Ok sharedAfterBody storeAfterBody)) →
    EvmYul.Yul.exec sourceFuel (.Block post) codeOverride
      (.Ok sharedAfterBody storeAfterBody) =
        .ok (.Ok sharedAfterPost storeAfterPost) →
    EvmYul.Yul.exec sourceFuel (.For cond post body) codeOverride
      (.Ok sharedAfterPost storeAfterPost) = loopResult →
    allowedInner loopResult →
    SourceRegularStmtRunHiddenExact cfg layout layout prim program ctx
      sourceFuel.succ.succ.succ (.For cond post body) codeOverride
      (.Ok shared store) compiler
      (generatedForLowerBlock pieces.preCond pieces.lowerCond
        pieces.lowerPost pieces.lowerBody) ∨
    SourceNonregularStmtRunHiddenExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ.succ.succ
      (.For cond post body) codeOverride (.Ok shared store) compiler
      (generatedForLowerBlock pieces.preCond pieces.lowerCond
        pieces.lowerPost pieces.lowerBody)

/--
Regular-only sibling of `GeneratedForLoopPostRegularBranchContract`.

When the current body/post pass falls through and the recursive loop call also
returns an ordinary `Ok` state, the generated `for` head is regular.  This case
must not require the surrounding sequence's `allowed` predicate, because in a
non-singleton sequence the tail, not the intermediate loop result, determines
the final imported result.
-/
def GeneratedForLoopPostRegularOkBranchContract
    (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (reserved : List Name)
    (pieces : GeneratedForCompiled reserved layout cond post body) : Prop :=
  ∀ {shared sharedAfterCond sharedAfterBody sharedAfterPost sharedLoop :
        EvmYul.SharedState .Yul}
    {store storeAfterCond storeAfterBody storeAfterPost storeLoop :
        EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State} {value : Word}
    {bodyWasContinue : Bool},
    SourceStateExactRel cfg layout (.Ok shared store) compiler →
    EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
      .ok (.Ok sharedAfterCond storeAfterCond, value) →
    value ≠ EvmYul.UInt256.ofNat 0 →
    (if bodyWasContinue then
        EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
          (.Ok sharedAfterCond storeAfterCond) =
          .ok (.Checkpoint (.Continue sharedAfterBody storeAfterBody))
      else
        EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
          (.Ok sharedAfterCond storeAfterCond) =
          .ok (.Ok sharedAfterBody storeAfterBody)) →
    EvmYul.Yul.exec sourceFuel (.Block post) codeOverride
      (.Ok sharedAfterBody storeAfterBody) =
        .ok (.Ok sharedAfterPost storeAfterPost) →
    EvmYul.Yul.exec sourceFuel (.For cond post body) codeOverride
      (.Ok sharedAfterPost storeAfterPost) =
        .ok (.Ok sharedLoop storeLoop) →
    SourceRegularStmtRunHiddenExact cfg layout layout prim program ctx
      sourceFuel.succ.succ.succ (.For cond post body) codeOverride
      (.Ok shared store) compiler
      (generatedForLowerBlock pieces.preCond pieces.lowerCond
        pieces.lowerPost pieces.lowerBody)

theorem exec_block_state_domain_exact_of_execSeq_contains
    {layout : List Name} {fuel : Nat} {stmts : List AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {stateAfter : State}
    (hScope : StoreDomainExact layout store)
    (hSeq :
      SourceResultStoreContains layout
        (EvmYul.Yul.execSeq fuel stmts codeOverride (.Ok shared store)))
    (hExec :
      EvmYul.Yul.exec fuel.succ (.Block stmts) codeOverride
          (.Ok shared store) =
        .ok stateAfter) :
    StateStoreDomainExact layout stateAfter := by
  cases hExecSeq :
      EvmYul.Yul.execSeq fuel stmts codeOverride (.Ok shared store) with
  | error err =>
      simp [EvmYul.Yul.exec, hExecSeq] at hExec
  | ok stateAfterSeq =>
      have hStateAfterSeq :
          StateStoreContains layout stateAfterSeq :=
        SourceResultStoreContains.state_of_ok hSeq hExecSeq
      simp [EvmYul.Yul.exec, hExecSeq] at hExec
      subst stateAfter
      exact
        StateStoreDomainExact.restrictStoreTo_of_contains
          (layout := layout) (scope := store)
          (state := stateAfterSeq) hStateAfterSeq hScope

