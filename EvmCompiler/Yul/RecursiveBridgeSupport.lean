/--
Imported state-store exactness, lifted from raw varstores to the imported Yul
state shape.

This is a private bridge-building invariant: the recursive user-call proof will
eventually derive it from imported execution/domain preservation, not ask for it
at the public theorem boundary.
-/
def StateStoreDomainExact (layout : List Name) : State → Prop
  | .Ok _shared store => StoreDomainExact layout store
  | .Checkpoint (.Break _shared store) => StoreDomainExact layout store
  | .Checkpoint (.Continue _shared store) => StoreDomainExact layout store
  | .Checkpoint (.Leave _shared store) => StoreDomainExact layout store
  | .OutOfFuel => True

theorem SourceStateExactRel.ofRelStateDomain
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateRel cfg layout source compiler)
    (hDomain : StateStoreDomainExact layout source) :
    SourceStateExactRel cfg layout source compiler := by
  cases hRel with
  | @ok shared store compiler hShared hVars =>
      exact
        SourceStateExactRel.ok hShared hVars
          (by simpa [StateStoreDomainExact] using hDomain)

def StateStoreContains (layout : List Name) : State → Prop
  | .Ok _shared store => StoreDomainContains layout store
  | .Checkpoint (.Break _shared store) => StoreDomainContains layout store
  | .Checkpoint (.Continue _shared store) => StoreDomainContains layout store
  | .Checkpoint (.Leave _shared store) => StoreDomainContains layout store
  | .OutOfFuel => True

theorem SourceStateExactRel.stateStoreContains
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateExactRel cfg layout source compiler) :
    StateStoreContains layout source := by
  cases hRel with
  | ok _hShared _hVars hDomain =>
      simpa [StateStoreContains] using StoreDomainContains.of_exact hDomain

theorem StateStoreDomainExact.insert_mem
    {layout : List Name} {state : State}
    {name : EvmYul.Identifier} {value : Word}
    (hDomain : StateStoreDomainExact layout state)
    (hMem : identName name ∈ layout) :
    StateStoreDomainExact layout
      (EvmYul.Yul.State.insert name value state) := by
  cases state with
  | Ok shared store =>
      simpa [StateStoreDomainExact, EvmYul.Yul.State.insert, identName]
        using
          (StoreDomainExact.insert_mem
            (layout := layout) (store := store) (name := identName name)
            (value := value)
            (by simpa [StateStoreDomainExact] using hDomain) hMem)
  | OutOfFuel =>
      simp [StateStoreDomainExact, EvmYul.Yul.State.insert]
  | Checkpoint jump =>
      cases jump <;>
        simpa [StateStoreDomainExact, EvmYul.Yul.State.insert] using
          hDomain

theorem StateStoreDomainExact.multifill_mem
    {layout : List Name} {state : State}
    {names : List EvmYul.Identifier} {values : List Word}
    (hDomain : StateStoreDomainExact layout state)
    (hNames : ∀ name, name ∈ identNames names → name ∈ layout) :
    StateStoreDomainExact layout
      (EvmYul.Yul.State.multifill names values state) := by
  cases state with
  | Ok shared store =>
      let step : EvmYul.Identifier × Word → State → State :=
        fun entry state => EvmYul.Yul.State.insert entry.1 entry.2 state
      have hFold :
          ∀ entries : List (EvmYul.Identifier × Word),
            (∀ name, name ∈ entries.map Prod.fst →
              identName name ∈ layout) →
            StateStoreDomainExact layout
              (List.foldr step (.Ok shared store) entries) := by
        intro entries
        induction entries with
        | nil =>
            intro _hEntries
            simpa [step, StateStoreDomainExact] using hDomain
        | cons entry rest ih =>
            intro hEntries
            cases entry with
            | mk name value =>
                have hRest :
                    StateStoreDomainExact layout
                      (List.foldr step (.Ok shared store) rest) :=
                  ih (by
                    intro query hMem
                    exact hEntries query (by simp [hMem]))
                exact
                  StateStoreDomainExact.insert_mem
                    (layout := layout) (name := name) (value := value)
                    hRest (hEntries name (by simp))
      have hEntries :
          ∀ name, name ∈ (List.zip names values).map Prod.fst →
            identName name ∈ layout := by
        have zip_fst_mem :
            ∀ (xs : List EvmYul.Identifier) (ys : List Word)
              (entry : EvmYul.Identifier × Word),
              entry ∈ List.zip xs ys → entry.1 ∈ xs := by
          intro xs ys entry hEntry
          induction xs generalizing ys with
          | nil =>
              simp at hEntry
          | cons head tail ih =>
              cases ys with
              | nil =>
                  simp at hEntry
              | cons value rest =>
                  simp at hEntry
                  rcases hEntry with hEq | hRest
                  · subst entry
                    simp
                  · simpa using (Or.inr (ih rest hRest) :
                      entry.1 = head ∨ entry.1 ∈ tail)
        intro name hMem
        rw [List.mem_map] at hMem
        rcases hMem with ⟨entry, hEntry, hEq⟩
        cases entry with
        | mk entryName entryValue =>
            simp at hEq
            subst name
            have hNameMem : entryName ∈ names :=
              zip_fst_mem names values (entryName, entryValue) hEntry
            exact hNames (identName entryName)
              (by
                simpa [identNames, identName] using hNameMem)
      simpa [EvmYul.Yul.State.multifill, step] using
        hFold (List.zip names values) hEntries
  | OutOfFuel =>
      simp [StateStoreDomainExact, EvmYul.Yul.State.multifill]
  | Checkpoint jump =>
      cases jump <;>
        simpa [StateStoreDomainExact, EvmYul.Yul.State.multifill] using
          hDomain

