      | ok sourceAfter =>
          cases targetDone with
          | error targetErr =>
              exact OpenExternal.OpenResultPathRelWithCreate.done (by
                intro hAllowed
                exact hDone hAllowed)
          | ok targetAfter =>
              rcases targetAfter with ⟨sourceOutcome, ctxAfter⟩
              cases sourceAfter with
              | Ok sharedAfter storeAfter =>
                  exact OpenExternal.OpenResultPathRelWithCreate.done (by
                    intro hAllowed
                    have hScopeOutcome :
                        ∀ name : Name, name ∈ outcomeLayout →
                          (source.store.lookup name).isSome = true := by
                      intro name hMem
                      apply hScopeLayout
                      simpa [SourceResultOutcomeLayoutSupported] using
                        (hSupported hAllowed name hMem)
                    exact
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        hScopeOutcome
                        (hDone hAllowed))
              | OutOfFuel =>
                  exact OpenExternal.OpenResultPathRelWithCreate.done (by
                    intro hAllowed
                    cases hDone hAllowed with
                    | ok hOk =>
                        cases hOk with
                        | regular hState =>
                            cases hState)
              | Checkpoint jump =>
                  exact OpenExternal.OpenResultPathRelWithCreate.done (by
                    intro hAllowed
                    have hScopeOutcome :
                        ∀ name : Name, name ∈ outcomeLayout →
                          (source.store.lookup name).isSome = true := by
                      intro name hMem
                      apply hScopeLayout
                      cases jump <;>
                        exact (hSupported hAllowed).2 name hMem
                    exact
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        hScopeOutcome
                        (hDone hAllowed))) (by
      intro sourceCall targetCall response hResponse
      exact hResponse) (by
      intro sourceCreate targetCreate response hResponse
      exact hResponse)

/--
Selected open `runScoped` path from a selected open `runOpen` path.

The open compiler block semantics defines scoped execution as open execution
followed by the same mode dispatch as the closed source semantics: regular
outcomes are restricted to the entry scope and abrupt outcomes pass through.
-/
theorem compilerOpen_block_runScoped_resolves_of_runOpen_resolves
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state : Objects.Source.State} {outcome : Objects.Source.Outcome}
    {trace : OpenExternal.OpenTrace}
    (hRunOpen :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx fuel block
          state)
        trace (.ok (outcome, ctxAfter))) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Block.runScoped prim program ctx block fuel
        state)
      trace
      (.ok
        (match outcome.mode with
        | .regular =>
            Functions.Source.Outcome.regular
              (outcome.state.restrictTo ctx.scope)
        | .brk | .cont | .leave | .halt _ => outcome)) := by
  unfold CompilerOpen.FunctionsOpen.Block.runScoped
  let next : Functions.Source.Outcome × Functions.Source.Ctx →
      CompilerOpen.Result Functions.Source.Outcome :=
    fun result =>
      match result.1.mode with
      | .regular =>
          OpenExternal.OpenResult.ok
            (Functions.Source.Outcome.regular
              (result.1.state.restrictTo ctx.scope))
      | .brk | .cont | .leave | .halt _ =>
          OpenExternal.OpenResult.ok result.1
  have hNext :
      OpenExternal.OpenResultResolves (next (outcome, ctxAfter)) []
        (.ok
          (match outcome.mode with
          | .regular =>
              Functions.Source.Outcome.regular
                (outcome.state.restrictTo ctx.scope)
          | .brk | .cont | .leave | .halt _ => outcome)) := by
    rcases outcome with ⟨outcomeState, outcomeMode⟩
    cases outcomeMode <;>
      simp [next, OpenExternal.OpenResult.ok,
        Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]
    all_goals exact OpenExternal.OpenResultResolves.done
  simpa [next] using
    OpenExternal.OpenResultResolves.bind_ok
      (source :=
        CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx fuel block
          state)
      (next := next) hRunOpen hNext

theorem compilerOpen_block_runScoped_resolves_regular_of_runOpen_resolves
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state stateAfter : Objects.Source.State}
    {trace : OpenExternal.OpenTrace}
    (hRunOpen :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx fuel block
          state)
        trace
        (.ok (Functions.Source.Outcome.regular stateAfter, ctxAfter))) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Block.runScoped prim program ctx block fuel
        state)
      trace
      (.ok
        (Functions.Source.Outcome.regular
          (stateAfter.restrictTo ctx.scope))) := by
  simpa [Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]
    using
      compilerOpen_block_runScoped_resolves_of_runOpen_resolves
        (prim := prim) (program := program) (ctx := ctx)
        (ctxAfter := ctxAfter) (block := block) (fuel := fuel)
        (state := state)
        (outcome := Functions.Source.Outcome.regular stateAfter)
        (trace := trace) hRunOpen

theorem compilerOpen_block_runScoped_resolves_leave_or_halt_of_runOpen_resolves
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state : Objects.Source.State} {outcome : Objects.Source.Outcome}
    {trace : OpenExternal.OpenTrace}
    (hMode :
      outcome.mode = .leave ∨
        ∃ kind : Assembly.HaltKind, outcome.mode = .halt kind)
    (hRunOpen :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx fuel block
          state)
        trace (.ok (outcome, ctxAfter))) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Block.runScoped prim program ctx block fuel
        state)
      trace (.ok outcome) := by
  have hScoped :=
    compilerOpen_block_runScoped_resolves_of_runOpen_resolves
      (prim := prim) (program := program) (ctx := ctx)
      (ctxAfter := ctxAfter) (block := block) (fuel := fuel)
      (state := state) (outcome := outcome) (trace := trace) hRunOpen
  rcases outcome with ⟨outcomeState, outcomeMode⟩
  rcases hMode with hLeave | hHalt
  · cases outcomeMode with
    | regular => simp at hLeave
    | brk => simp at hLeave
    | cont => simp at hLeave
    | leave =>
        simpa [Functions.Source.Outcome.leave,
          Locals.Source.Outcome.leave] using hScoped
    | halt kind => simp at hLeave
  · rcases hHalt with ⟨kind, hHalt⟩
    cases outcomeMode with
    | regular => simp at hHalt
    | brk => simp at hHalt
    | cont => simp at hHalt
    | leave => simp at hHalt
    | halt kind' =>
        simpa [Functions.Source.Outcome.halt,
          Locals.Source.Outcome.halt] using hScoped

