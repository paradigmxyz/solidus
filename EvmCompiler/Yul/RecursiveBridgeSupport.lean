      compilerAfterPre.vars.contains name = true :=
    SourceStateRel.preContains_of_evalSeq_domain hArgsRun hRelAfter
      hDomainAfter hMem
  exact
    ⟨compilerAfterPre, compilerAfterArgs, ctxAfter, targetFuel,
      hPreRun, hArgsRun, hRelAfter, hContains⟩

