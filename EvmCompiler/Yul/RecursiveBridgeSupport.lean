      rcases hDone with ⟨hRel, hEval⟩
      have hEvalReverse :
          Functions.Source.ArgList.eval prim
              ((names.map
                (fun name => (.var name : Locals.Expr 1))).reverse)
              targetState =
            .ok (targetState, sourceArgsResult.2) := by
