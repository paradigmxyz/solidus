theorem SourceResultCheckpointAllowed.loop_succ_succ_of_parts
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state)
    (hEval :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel cond codeOverride
          (EvmYul.Yul.State.mkOk state)))
    (hBody :
      ∀ {stateAfterCond : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride
            (EvmYul.Yul.State.mkOk state) =
          .ok (stateAfterCond, value) →
        value ≠ ⟨0⟩ →
        SourceResultCheckpointAllowed true true canLeave
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            stateAfterCond))
    (hPost :
      ∀ {postInput : State},
        StateCheckpointAllowed false false canLeave postInput →
        SourceResultCheckpointAllowed false false canLeave
          (EvmYul.Yul.exec fuel (.Block post) codeOverride postInput))
    (hRecur :
      ∀ {loopInput : State},
        StateCheckpointAllowed canBreak canContinue canLeave loopInput →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
            loopInput)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.loop (fuel + 2) cond post body codeOverride state) := by
  rw [Imported.loop_succ_succ]
  cases hEvalResult :
      EvmYul.Yul.eval fuel cond codeOverride
        (EvmYul.Yul.State.mkOk state) with
  | error err =>
      simp [hEvalResult, SourceResultCheckpointAllowed]
  | ok pair =>
      cases pair with
      | mk stateAfterCond value =>
          by_cases hZero : value = (⟨0⟩ : Word)
          · have hAllowedCond :
                StateCheckpointAllowed canBreak canContinue canLeave
                  stateAfterCond := by
              simpa [SourcePairResultCheckpointAllowed, hEvalResult]
                using hEval
            simpa [hEvalResult, hZero, SourceResultCheckpointAllowed]
              using StateCheckpointAllowed.overwrite? hAllowedCond hState
          · have hNonzero : value ≠ (⟨0⟩ : Word) := hZero
            have hBodyAllowed :
                SourceResultCheckpointAllowed true true canLeave
                  (EvmYul.Yul.exec fuel (.Block body) codeOverride
                    stateAfterCond) :=
              hBody hEvalResult hNonzero
            cases hBodyResult :
                EvmYul.Yul.exec fuel (.Block body) codeOverride
                  stateAfterCond with
            | error err =>
                simp [hEvalResult, hZero, hBodyResult,
                  SourceResultCheckpointAllowed]
            | ok stateAfterBody =>
                cases stateAfterBody with
                | Ok sharedBody storeBody =>
                    have hPostAllowed :
                        SourceResultCheckpointAllowed false false canLeave
                          (EvmYul.Yul.exec fuel (.Block post) codeOverride
                            (EvmYul.Yul.State.reviveJump
                              (.Ok sharedBody storeBody))) :=
                      hPost StateCheckpointAllowed.reviveJump
                    cases hPostResult :
                        EvmYul.Yul.exec fuel (.Block post) codeOverride
                          (EvmYul.Yul.State.reviveJump
                            (.Ok sharedBody storeBody)) with
                    | error err =>
                        simp [hEvalResult, hZero, hBodyResult, hPostResult,
                          SourceResultCheckpointAllowed]
                    | ok stateAfterPost =>
                        have hPostStateAllowed :
                            StateCheckpointAllowed canBreak canContinue
                              canLeave stateAfterPost := by
                          exact
                            StateCheckpointAllowed.of_no_loop_control
                              (by
                                simpa [SourceResultCheckpointAllowed,
                                  hPostResult] using hPostAllowed)
                        cases stateAfterPost with
                        | OutOfFuel =>
                            simpa [hEvalResult, hZero, hBodyResult,
                              hPostResult, SourceResultCheckpointAllowed]
                              using
                                StateCheckpointAllowed.overwrite?
                                  hPostStateAllowed hState
                        | Checkpoint jumpAfterPost =>
                            cases jumpAfterPost with
                            | Leave sharedLeave storeLeave =>
                                simpa [hEvalResult, hZero, hBodyResult,
                                  hPostResult, SourceResultCheckpointAllowed]
                                  using
                                    StateCheckpointAllowed.overwrite?
                                      hPostStateAllowed hState
                            | Break sharedBreak storeBreak =>
                                have hLoopInputAllowed :
                                    StateCheckpointAllowed canBreak
                                      canContinue canLeave
                                      (EvmYul.Yul.State.overwrite?
                                        (.Checkpoint
                                          (.Break sharedBreak storeBreak))
                                        state) :=
                                  StateCheckpointAllowed.overwrite?
                                    hPostStateAllowed hState
                                have hLoopAllowed :
                                    SourceResultCheckpointAllowed canBreak
                                      canContinue canLeave
                                      (EvmYul.Yul.exec fuel
                                        (.For cond post body) codeOverride
                                        (EvmYul.Yul.State.overwrite?
                                          (.Checkpoint
                                            (.Break sharedBreak storeBreak))
                                          state)) :=
                                  hRecur hLoopInputAllowed
                                cases hLoopResult :
                                    EvmYul.Yul.exec fuel
                                      (.For cond post body) codeOverride
                                      (EvmYul.Yul.State.overwrite?
                                        (.Checkpoint
                                          (.Break sharedBreak storeBreak))
                                        state) with
                                | error err =>
                                    simp [hEvalResult, hZero, hBodyResult,
                                      hPostResult, hLoopResult,
                                      SourceResultCheckpointAllowed]
                                | ok stateAfterLoop =>
                                    have hLoopStateAllowed :
                                        StateCheckpointAllowed canBreak
                                          canContinue canLeave
                                          stateAfterLoop := by
                                      simpa [SourceResultCheckpointAllowed,
                                        hLoopResult] using hLoopAllowed
                                    simpa [hEvalResult, hZero, hBodyResult,
                                      hPostResult, hLoopResult,
                                      SourceResultCheckpointAllowed]
                                      using
                                        StateCheckpointAllowed.overwrite?
                                          hLoopStateAllowed hState
                            | Continue sharedContinue storeContinue =>
                                have hLoopInputAllowed :
                                    StateCheckpointAllowed canBreak
                                      canContinue canLeave
                                      (EvmYul.Yul.State.overwrite?
                                        (.Checkpoint
                                          (.Continue sharedContinue
                                            storeContinue))
                                        state) :=
                                  StateCheckpointAllowed.overwrite?
                                    hPostStateAllowed hState
                                have hLoopAllowed :
                                    SourceResultCheckpointAllowed canBreak
                                      canContinue canLeave
                                      (EvmYul.Yul.exec fuel
                                        (.For cond post body) codeOverride
                                        (EvmYul.Yul.State.overwrite?
                                          (.Checkpoint
                                            (.Continue sharedContinue
                                              storeContinue))
                                          state)) :=
                                  hRecur hLoopInputAllowed
                                cases hLoopResult :
                                    EvmYul.Yul.exec fuel
                                      (.For cond post body) codeOverride
                                      (EvmYul.Yul.State.overwrite?
                                        (.Checkpoint
                                          (.Continue sharedContinue
                                            storeContinue))
                                        state) with
                                | error err =>
                                    simp [hEvalResult, hZero, hBodyResult,
                                      hPostResult, hLoopResult,
                                      SourceResultCheckpointAllowed]
                                | ok stateAfterLoop =>
                                    have hLoopStateAllowed :
                                        StateCheckpointAllowed canBreak
                                          canContinue canLeave
                                          stateAfterLoop := by
                                      simpa [SourceResultCheckpointAllowed,
                                        hLoopResult] using hLoopAllowed
                                    simpa [hEvalResult, hZero, hBodyResult,
                                      hPostResult, hLoopResult,
                                      SourceResultCheckpointAllowed]
                                      using
                                        StateCheckpointAllowed.overwrite?
                                          hLoopStateAllowed hState
                        | Ok sharedPost storePost =>
                            have hLoopInputAllowed :
                                StateCheckpointAllowed canBreak canContinue
                                  canLeave
                                  (EvmYul.Yul.State.overwrite?
                                    (.Ok sharedPost storePost) state) :=
                              StateCheckpointAllowed.overwrite?
                                hPostStateAllowed hState
                            have hLoopAllowed :
                                SourceResultCheckpointAllowed canBreak
                                  canContinue canLeave
                                  (EvmYul.Yul.exec fuel (.For cond post body)
                                    codeOverride
                                    (EvmYul.Yul.State.overwrite?
                                      (.Ok sharedPost storePost) state)) :=
                              hRecur hLoopInputAllowed
                            cases hLoopResult :
                                EvmYul.Yul.exec fuel (.For cond post body)
                                  codeOverride
                                  (EvmYul.Yul.State.overwrite?
                                    (.Ok sharedPost storePost) state) with
                            | error err =>
                                simp [hEvalResult, hZero, hBodyResult,
                                  hPostResult, hLoopResult,
                                  SourceResultCheckpointAllowed]
                            | ok stateAfterLoop =>
                                have hLoopStateAllowed :
                                    StateCheckpointAllowed canBreak
                                      canContinue canLeave stateAfterLoop := by
                                  simpa [SourceResultCheckpointAllowed,
                                    hLoopResult] using hLoopAllowed
                                simpa [hEvalResult, hZero, hBodyResult,
                                  hPostResult, hLoopResult,
                                  SourceResultCheckpointAllowed]
                                  using
                                    StateCheckpointAllowed.overwrite?
                                      hLoopStateAllowed hState
                | OutOfFuel =>
                    simpa [hEvalResult, hZero, hBodyResult,
                      SourceResultCheckpointAllowed]
                      using
                        StateCheckpointAllowed.overwrite?
                          (state := .OutOfFuel)
                          (overwriteSource := state)
                          (by simp [StateCheckpointAllowed]) hState
                | Checkpoint jump =>
                    cases jump with
                    | Continue sharedJump storeJump =>
                        have hPostAllowed :
                            SourceResultCheckpointAllowed false false canLeave
                              (EvmYul.Yul.exec fuel (.Block post)
                                codeOverride
                                (EvmYul.Yul.State.reviveJump
                                  (.Checkpoint
                                    (.Continue sharedJump storeJump)))) :=
                          hPost StateCheckpointAllowed.reviveJump
                        cases hPostResult :
                            EvmYul.Yul.exec fuel (.Block post) codeOverride
                              (EvmYul.Yul.State.reviveJump
                                (.Checkpoint
                                  (.Continue sharedJump storeJump))) with
                        | error err =>
                            simp [hEvalResult, hZero, hBodyResult,
                              hPostResult, SourceResultCheckpointAllowed]
                        | ok stateAfterPost =>
                            have hPostStateAllowed :
                                StateCheckpointAllowed canBreak canContinue
                                  canLeave stateAfterPost := by
                              exact
                                StateCheckpointAllowed.of_no_loop_control
                                  (by
                                    simpa [SourceResultCheckpointAllowed,
                                      hPostResult] using hPostAllowed)
                            cases stateAfterPost with
                            | OutOfFuel =>
                                simpa [hEvalResult, hZero, hBodyResult,
                                  hPostResult, SourceResultCheckpointAllowed]
                                  using
                                    StateCheckpointAllowed.overwrite?
                                      hPostStateAllowed hState
                            | Checkpoint jumpAfterPost =>
                                cases jumpAfterPost with
                                | Leave sharedLeave storeLeave =>
                                    simpa [hEvalResult, hZero, hBodyResult,
                                      hPostResult,
                                      SourceResultCheckpointAllowed]
                                      using
                                        StateCheckpointAllowed.overwrite?
                                          hPostStateAllowed hState
                                | Break sharedBreak storeBreak =>
                                    have hLoopInputAllowed :
                                        StateCheckpointAllowed canBreak
                                          canContinue canLeave
                                          (EvmYul.Yul.State.overwrite?
                                            (.Checkpoint
                                              (.Break sharedBreak
                                                storeBreak))
                                            state) :=
                                      StateCheckpointAllowed.overwrite?
                                        hPostStateAllowed hState
                                    have hLoopAllowed :
                                        SourceResultCheckpointAllowed canBreak
                                          canContinue canLeave
                                          (EvmYul.Yul.exec fuel
                                            (.For cond post body)
                                            codeOverride
                                            (EvmYul.Yul.State.overwrite?
                                              (.Checkpoint
                                                (.Break sharedBreak
                                                  storeBreak))
                                              state)) :=
                                      hRecur hLoopInputAllowed
                                    cases hLoopResult :
                                        EvmYul.Yul.exec fuel
                                          (.For cond post body) codeOverride
                                          (EvmYul.Yul.State.overwrite?
                                            (.Checkpoint
                                              (.Break sharedBreak
                                                storeBreak))
                                            state) with
                                    | error err =>
                                        simp [hEvalResult, hZero, hBodyResult,
                                          hPostResult, hLoopResult,
                                          SourceResultCheckpointAllowed]
                                    | ok stateAfterLoop =>
                                        have hLoopStateAllowed :
                                            StateCheckpointAllowed canBreak
                                              canContinue canLeave
                                              stateAfterLoop := by
                                          simpa [SourceResultCheckpointAllowed,
                                            hLoopResult] using hLoopAllowed
                                        simpa [hEvalResult, hZero, hBodyResult,
                                          hPostResult, hLoopResult,
                                          SourceResultCheckpointAllowed]
                                          using
                                            StateCheckpointAllowed.overwrite?
                                              hLoopStateAllowed hState
                                | Continue sharedContinue storeContinue =>
                                    have hLoopInputAllowed :
                                        StateCheckpointAllowed canBreak
                                          canContinue canLeave
                                          (EvmYul.Yul.State.overwrite?
                                            (.Checkpoint
                                              (.Continue sharedContinue
                                                storeContinue))
                                            state) :=
                                      StateCheckpointAllowed.overwrite?
                                        hPostStateAllowed hState
                                    have hLoopAllowed :
                                        SourceResultCheckpointAllowed canBreak
                                          canContinue canLeave
                                          (EvmYul.Yul.exec fuel
                                            (.For cond post body)
                                            codeOverride
                                            (EvmYul.Yul.State.overwrite?
                                              (.Checkpoint
                                                (.Continue sharedContinue
                                                  storeContinue))
                                              state)) :=
                                      hRecur hLoopInputAllowed
                                    cases hLoopResult :
                                        EvmYul.Yul.exec fuel
                                          (.For cond post body) codeOverride
                                          (EvmYul.Yul.State.overwrite?
                                            (.Checkpoint
                                              (.Continue sharedContinue
                                                storeContinue))
                                            state) with
                                    | error err =>
                                        simp [hEvalResult, hZero, hBodyResult,
                                          hPostResult, hLoopResult,
                                          SourceResultCheckpointAllowed]
                                    | ok stateAfterLoop =>
                                        have hLoopStateAllowed :
                                            StateCheckpointAllowed canBreak
                                              canContinue canLeave
                                              stateAfterLoop := by
                                          simpa [SourceResultCheckpointAllowed,
                                            hLoopResult] using hLoopAllowed
                                        simpa [hEvalResult, hZero, hBodyResult,
                                          hPostResult, hLoopResult,
                                          SourceResultCheckpointAllowed]
                                          using
                                            StateCheckpointAllowed.overwrite?
                                              hLoopStateAllowed hState
                            | Ok sharedPost storePost =>
                                have hLoopInputAllowed :
                                    StateCheckpointAllowed canBreak
                                      canContinue canLeave
                                      (EvmYul.Yul.State.overwrite?
                                        (.Ok sharedPost storePost) state) :=
                                  StateCheckpointAllowed.overwrite?
                                    hPostStateAllowed hState
                                have hLoopAllowed :
                                    SourceResultCheckpointAllowed canBreak
                                      canContinue canLeave
                                      (EvmYul.Yul.exec fuel
                                        (.For cond post body) codeOverride
                                        (EvmYul.Yul.State.overwrite?
                                          (.Ok sharedPost storePost) state)) :=
                                  hRecur hLoopInputAllowed
                                cases hLoopResult :
                                    EvmYul.Yul.exec fuel
                                      (.For cond post body) codeOverride
                                      (EvmYul.Yul.State.overwrite?
                                        (.Ok sharedPost storePost) state) with
                                | error err =>
                                    simp [hEvalResult, hZero, hBodyResult,
                                      hPostResult, hLoopResult,
                                      SourceResultCheckpointAllowed]
                                | ok stateAfterLoop =>
                                    have hLoopStateAllowed :
                                        StateCheckpointAllowed canBreak
                                          canContinue canLeave
                                          stateAfterLoop := by
                                      simpa [SourceResultCheckpointAllowed,
                                        hLoopResult] using hLoopAllowed
                                    simpa [hEvalResult, hZero, hBodyResult,
                                      hPostResult, hLoopResult,
                                      SourceResultCheckpointAllowed]
                                      using
                                        StateCheckpointAllowed.overwrite?
                                          hLoopStateAllowed hState
                    | Break sharedJump storeJump =>
                        simpa [hEvalResult, hZero, hBodyResult,
                          SourceResultCheckpointAllowed]
                          using
                            StateCheckpointAllowed.overwrite?
                              (state :=
                                EvmYul.Yul.State.reviveJump
                                  (.Checkpoint
                                    (.Break sharedJump storeJump)))
                              (overwriteSource := state)
                              StateCheckpointAllowed.reviveJump hState
                    | Leave sharedJump storeJump =>
                        have hLeave : canLeave = true := by
                          simpa [SourceResultCheckpointAllowed,
                            StateCheckpointAllowed, hBodyResult]
                            using hBodyAllowed
                        have hLeaveAllowed :
                            StateCheckpointAllowed canBreak canContinue
                              canLeave
                              (.Checkpoint (.Leave sharedJump storeJump)) := by
                          simpa [StateCheckpointAllowed] using hLeave
                        simpa [hEvalResult, hZero, hBodyResult,
                          SourceResultCheckpointAllowed]
                          using
                            StateCheckpointAllowed.overwrite?
                              hLeaveAllowed hState

theorem SourceResultCheckpointAllowed.exec_for_succ_succ_succ_of_scoped_parts
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hScoped : ControlFlow.ScopedStmt canBreak canContinue canLeave
      (.For cond post body))
    (hState : StateCheckpointAllowed canBreak canContinue canLeave state)
    (hEval :
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel cond codeOverride
          (EvmYul.Yul.State.mkOk state)))
    (hBody :
      ∀ {stateAfterCond : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride
            (EvmYul.Yul.State.mkOk state) =
          .ok (stateAfterCond, value) →
        value ≠ ⟨0⟩ →
        ControlFlow.ScopedStmts true true canLeave body →
        SourceResultCheckpointAllowed true true canLeave
          (EvmYul.Yul.exec fuel (.Block body) codeOverride
            stateAfterCond))
    (hPost :
      ∀ {postInput : State},
        StateCheckpointAllowed false false canLeave postInput →
        ControlFlow.ScopedStmts false false canLeave post →
        SourceResultCheckpointAllowed false false canLeave
          (EvmYul.Yul.exec fuel (.Block post) codeOverride postInput))
    (hRecur :
      ∀ {loopInput : State},
        StateCheckpointAllowed canBreak canContinue canLeave loopInput →
        ControlFlow.ScopedStmt canBreak canContinue canLeave
          (.For cond post body) →
        SourceResultCheckpointAllowed canBreak canContinue canLeave
          (EvmYul.Yul.exec fuel (.For cond post body) codeOverride
            loopInput)) :
    SourceResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.exec (fuel + 2).succ (.For cond post body) codeOverride
        state) := by
  have hScopedFor := hScoped
  rcases hScoped with ⟨hPostScoped, hBodyScoped⟩
  rw [Imported.exec_for_succ]
  exact
    SourceResultCheckpointAllowed.loop_succ_succ_of_parts
      (canBreak := canBreak) (canContinue := canContinue)
      (canLeave := canLeave) (fuel := fuel) (cond := cond)
      (post := post) (body := body) (codeOverride := codeOverride)
      (state := state) hState hEval
      (fun hEvalOk hNonzero =>
        hBody hEvalOk hNonzero hBodyScoped)
      (fun hPostInput => hPost hPostInput hPostScoped)
      (fun hLoopInput => hRecur hLoopInput hScopedFor)

/--
Expression-level checkpoint preservation needed by the structured control-flow
induction.

The statement theorem below should not unfold primitive semantics or function
calls itself.  It only needs the expression layer to say that expression
evaluation, value evaluation, and expression-statements preserve the
checkpoint-allowed invariant.
-/
structure CheckpointExpressionSound : Prop where
  evalValues :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.expr expr →
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.evalValues fuel expr codeOverride state)
  eval :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.expr expr →
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.eval fuel expr codeOverride state)
  exprStmtCall :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.expr expr →
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourceResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.exec fuel (.ExprStmtCall expr) codeOverride state)

structure CheckpointCallSound : Prop where
  primCall :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {prim : EvmYul.Operation .Yul}
      {state : State} {args : List Word},
      Safe.primitive prim →
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.primCall fuel state prim args)
  userCall :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {functionName : Name}
      {args : List Word} {codeOverride : Option AstContract}
      {state : State},
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.call fuel args (some functionName) codeOverride state)

structure FamilyCheckpointExpressionSound
    (primitive : EvmYul.Operation .Yul → Prop)
    (userCall : Name → Prop) : Prop where
  evalValues :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.FeatureCoverage.Family.expr primitive userCall expr →
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
        (EvmYul.Yul.evalValues fuel expr codeOverride state)
  eval :
    ∀ {canBreak canContinue canLeave : Bool}
      {fuel : Nat} {expr : AstExpr}
      {codeOverride : Option AstContract} {state : State},
      Safe.FeatureCoverage.Family.expr primitive userCall expr →
      StateCheckpointAllowed canBreak canContinue canLeave state →
      SourcePairResultCheckpointAllowed canBreak canContinue canLeave
