          have hSubset :
              ∀ name : Name, name ∈ outcomeLayout → name ∈ layout := by
            simpa [SourceResultOutcomeLayoutSupported] using hSupported.2
          exact
            SourceResultOutcomeRel.ok
              (SourceOkOutcomeRel.cont
                (SourceStateRel.of_layout_subset
                  (by simpa [SourceModeKontLayouts.block] using hState)
                  hSubset))
