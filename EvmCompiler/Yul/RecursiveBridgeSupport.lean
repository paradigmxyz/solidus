    SourceRegularStmtRunHiddenExact cfg layout layout prim program ctx
      sourceFuel (.For cond post body) codeOverride (.Ok shared store)
      compiler
      (generatedForLowerBlock pieces.preCond pieces.lowerCond
        pieces.lowerPost pieces.lowerBody) := by
  have hEntryDomain : StoreDomainExact layout store :=
    SourceStateExactRel.domain hInitial
  have hStoreContains :
      ∀ name, name ∈ layout → (store.lookup name).isSome = true := by
    intro name hMem
    exact (hEntryDomain name).mpr hMem
  have hSourceSeq :
      EvmYul.Yul.execSeq sourceFuel.succ [(.For cond post body)]
          codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter) :=
    Imported.execSeq_single_succ hSource
  have hSourceBlock :
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Block [(.For cond post body)]) codeOverride (.Ok shared store) =
        .ok ((.Ok sharedAfter storeAfter : State).restrictStoreTo store) := by
    simp [EvmYul.Yul.exec, hSourceSeq, EvmYul.Yul.State.store]
  rcases hBlock hInitial rfl hSourceBlock with
    ⟨sourceOutcome, targetFuel, hTargetScoped, hOutcomeRelBlock⟩
  have hOutcomeRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.ok (.Ok sharedAfter storeAfter : State)) sourceOutcome :=
    SourceResultOutcomeRel.of_restrictStoreTo_scope_contains
      hStoreContains hOutcomeRelBlock
  cases hOutcomeRel with
  | ok hOk =>
      cases hOk with
      | regular hRel =>
          rcases
              Functions.Source.Block.runScoped_regular_eq_restrict
                hTargetScoped with
            ⟨inner, ctxAfter, hTargetOpen, hScopedEq⟩
          have hExactScoped :
              SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
                (inner.restrictTo ctx.scope) := by
            have hExactBlock :=
              SourceStateExactRel.ofRelDomain hRel hDomainAfter
            simpa [hScopedEq] using hExactBlock
          have hExactInner :
              SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
                inner :=
            SourceStateExactRel.of_compiler_restrictTo hExactScoped
              hScopeContains
          exact
            ⟨.Ok sharedAfter storeAfter, inner, ctxAfter, targetFuel,
              hSource, hTargetOpen, (fun _ hMem => hMem), hExactInner⟩

theorem sourceNonregularStmtRunHiddenExact_for_of_singleton_hiddenBlockSound
    {cfg : StateRelConfig} {reserved layout outcomeLayout : List Name}
