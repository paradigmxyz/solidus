theorem evalArgs_literal_list_ok
    (base : Nat) (values : List Word)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.evalArgs
        (_root_.EvmCompiler.Yul.Reference.BridgeFacts.evalArgsAppendFuel base
          (values.map (fun value => (.Lit value : AstExpr))))
        (values.map (fun value => (.Lit value : AstExpr))) codeOverride state =
      .ok (state, values) := by
  induction values generalizing state with
  | nil =>
      simp [_root_.EvmCompiler.Yul.Reference.BridgeFacts.evalArgsAppendFuel,
        EvmYul.Yul.evalArgs]
  | cons value rest ih =>
      simp [_root_.EvmCompiler.Yul.Reference.BridgeFacts.evalArgsAppendFuel,
        EvmYul.Yul.evalArgs,
        EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head',
        EvmYul.Yul.evalTail, EvmYul.Yul.cons', ih]

