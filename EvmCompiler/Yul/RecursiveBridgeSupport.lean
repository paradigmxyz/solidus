/--
The CREATE analogue of `RelationallyAdmissibleOpenResponse`.

Creation responses carry an address instead of a CALL status word, and creation
has no caller-provided output-copy window, but the opaque world-mutation
boundary is the same proof shape: the two semantic worlds remain related after
the response mutation, while the suspended target caller frame keeps the code
and permission needed to resume replay.
-/
structure RelationallyAdmissibleOpenCreateResponse
    (cfg : StateRelConfig) (response : OpenExternal.CreateResponse) : Prop :=
  rel :
    ∀ {sourceShared : EvmYul.SharedState .Yul}
      {compilerShared : EvmYul.SharedState .EVM},
      Reference.SharedStateRel cfg sourceShared compilerShared →
        Reference.SharedStateRel.OpenExternalCreateResponseRel cfg
          sourceShared compilerShared response
  targetCodeStable :
    ∀ {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM},
    Reference.SharedStateRel cfg sourceShared compilerShared →
      (response.internalMutation.apply compilerShared.toState).executionEnv.code =
        compilerShared.executionEnv.code
  targetPermStable :
    ∀ {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM},
    Reference.SharedStateRel cfg sourceShared compilerShared →
      (response.internalMutation.apply compilerShared.toState).executionEnv.perm =
        compilerShared.executionEnv.perm

instance RelationallyAdmissibleOpenCreateResponse.instCoeFun
    {cfg : StateRelConfig} {response : OpenExternal.CreateResponse} :
    CoeFun (RelationallyAdmissibleOpenCreateResponse cfg response)
      (fun _ =>
        ∀ {sourceShared : EvmYul.SharedState .Yul}
          {compilerShared : EvmYul.SharedState .EVM},
          Reference.SharedStateRel cfg sourceShared compilerShared →
            Reference.SharedStateRel.OpenExternalCreateResponseRel cfg
              sourceShared compilerShared response) where
  coe hResponse := hResponse.rel

theorem RelationallyAdmissibleOpenCreateResponse.target_code_stable
    {cfg : StateRelConfig} {response : OpenExternal.CreateResponse}
    (hResponse : RelationallyAdmissibleOpenCreateResponse cfg response)
    {sourceShared : EvmYul.SharedState .Yul}
