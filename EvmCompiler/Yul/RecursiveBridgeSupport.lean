        OpenExternal.OpenResult.ok]
  | leave =>
      simp [runIfTargetAfterRaw, OpenExternal.YulOpenResult.ok,
        OpenExternal.OpenResult.ok]
  | halt kind =>
      simp [runIfTargetAfterRaw, OpenExternal.YulOpenResult.ok,
        OpenExternal.OpenResult.ok]

