theorem exec_block_expr_user_call_ok_execCall_of_evalArgs
    {sourceFuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {sourceAfterArgs : State} {argValues : List Word}
    {functionName : Name} {args : List AstExpr} {contract : AstContract}
    (hArgEval :
      EvmYul.Yul.evalArgs sourceFuel args.reverse (some contract)
          (.Ok shared store) =
        .ok (sourceAfterArgs, argValues.reverse))
    (hExecBlock :
      EvmYul.Yul.exec sourceFuel.succ.succ.succ
          (.Block [.ExprStmtCall (.Call (.inr functionName) args)])
          (some contract) (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter)) :
    ∃ sharedCall : EvmYul.SharedState .Yul,
    ∃ storeCall : EvmYul.Yul.VarStore,
      EvmYul.Yul.execCall sourceFuel functionName [] (some contract)
          (.ok (sourceAfterArgs, argValues)) =
        .ok (.Ok sharedCall storeCall) ∧
      (.Ok sharedCall storeCall : State).restrictStoreTo store =
        .Ok sharedAfter storeAfter := by
  rw [Imported.exec_block_cons_succ] at hExecBlock
  simp [EvmYul.Yul.execSeq, Imported.exec_expr_user_call_succ,
    hArgEval, EvmYul.Yul.reverse'] at hExecBlock
  cases hCall :
      EvmYul.Yul.execCall sourceFuel functionName [] (some contract)
        (.ok (sourceAfterArgs, argValues)) with
  | error err =>
      simp [hCall] at hExecBlock
  | ok callState =>
      cases callState with
      | Ok sharedCall storeCall =>
          simp [hCall] at hExecBlock
          exact ⟨sharedCall, storeCall, rfl, hExecBlock⟩
      | Checkpoint jump =>
          cases jump <;>
            simp [hCall, EvmYul.Yul.State.restrictStoreTo] at hExecBlock
      | OutOfFuel =>
          simp [hCall, EvmYul.Yul.State.restrictStoreTo] at hExecBlock

theorem call_from_ok_ok_checkpoint_false
    {fuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {args returns : List Word}
    {functionName : Name} {codeOverride : Option AstContract}
    {jump : EvmYul.Yul.Jump}
    (hCall :
      EvmYul.Yul.call fuel args (some functionName) codeOverride
          (.Ok shared store) =
        .ok (.Checkpoint jump, returns)) :
    False := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.call] at hCall
  | succ fuel' =>
      simp [EvmYul.Yul.call] at hCall
      split at hCall
      · simp at hCall
      next yulAccount hAccount =>
        split at hCall
        · simp at hCall
        next fn hFn =>
          cases hBody :
              EvmYul.Yul.exec fuel' (.Block fn.body) codeOverride
                (👌 (EvmYul.Yul.State.Ok shared store).initcall
                  fn.params fn.rets args) with
          | error err =>
              rw [hBody] at hCall
              simp at hCall
          | ok bodyState =>
              rw [hBody] at hCall
              simp [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                EvmYul.Yul.State.setStore] at hCall
              have hReturnAllowed :
                  StateCheckpointAllowed false false false
                    (EvmYul.Yul.State.setStore
                      (EvmYul.Yul.State.overwrite?
                        (EvmYul.Yul.State.reviveJump bodyState)
                        (.Ok shared store))
                      (.Ok shared store)) :=
                StateCheckpointAllowed.callReturn_of_ok_caller
                  StateCheckpointAllowed.reviveJump
              have hCheckpointAllowed :
                  StateCheckpointAllowed false false false
                    (.Checkpoint jump) := by
                simpa [EvmYul.Yul.State.reviveJump,
                  EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
                  EvmYul.Yul.State.setStore, hCall.1] using hReturnAllowed
              exact
                StateCheckpointAllowed.no_checkpoint_of_top
                  hCheckpointAllowed

theorem execCall_from_ok_ok_checkpoint_false
    {fuel : Nat} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {args : List Word}
    {names : List EvmYul.Identifier} {functionName : Name}
    {codeOverride : Option AstContract} {jump : EvmYul.Yul.Jump}
    (hExecCall :
      EvmYul.Yul.execCall fuel functionName names codeOverride
          (.ok ((.Ok shared store : State), args)) =
        .ok (.Checkpoint jump)) :
    False := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.execCall] at hExecCall
  | succ fuel' =>
      simp [EvmYul.Yul.execCall] at hExecCall
      cases hCall :
          EvmYul.Yul.call fuel' args (some functionName) codeOverride
            (.Ok shared store) with
      | error err =>
          rw [hCall] at hExecCall
          cases hExecCall
      | ok callResult =>
          rcases callResult with ⟨callState, returns⟩
          rw [hCall] at hExecCall
          cases callState with
          | Ok sharedCall storeCall =>
              simp [EvmYul.Yul.multifill',
                EvmYul.Yul.State.multifill] at hExecCall
              have hCallAllowed :
                  StateCheckpointAllowed false false false
                    (EvmYul.Yul.State.multifill names returns
                      (.Ok sharedCall storeCall)) :=
                StateCheckpointAllowed.multifill
                  (by simp [StateCheckpointAllowed])
              have hCheckpointAllowed :
                  StateCheckpointAllowed false false false
                    (.Checkpoint jump) := by
                have hCallAllowedFold :
                    StateCheckpointAllowed false false false
                      (List.foldr (fun x s => s⟦x.1↦x.2⟧)
                        (.Ok sharedCall storeCall) (names.zip returns)) := by
                  simpa [EvmYul.Yul.State.multifill] using hCallAllowed
                rw [hExecCall] at hCallAllowedFold
                exact hCallAllowedFold
              exact
                StateCheckpointAllowed.no_checkpoint_of_top
                  hCheckpointAllowed
          | OutOfFuel =>
              cases jump <;>
                simp [EvmYul.Yul.multifill',
                  EvmYul.Yul.State.multifill] at hExecCall
          | Checkpoint callJump =>
              exfalso
              exact call_from_ok_ok_checkpoint_false hCall

