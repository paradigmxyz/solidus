          at hExecBlock
        exact hExecBlock.symm
      have hRelCheck : SourceResultRelatable (.error checkErr) := by
        simpa [hResult] using hRelatable
      exact False.elim (checkAssignment_error_not_relatable hCheck hRelCheck)
