theorem PrimitiveCallCheckpointAllowedForSafeNonOk.of_primitive_families :
    PrimitiveCallCheckpointAllowedForSafeNonOk := by
  intro canBreak canContinue canLeave fuel yulPrim state args hSafe hNonOk
    hAllowed
  cases yulPrim with
  | StopArith op =>
      exact SourcePairResultCheckpointAllowed.primCall_stopArith hAllowed
  | CompBit op =>
      exact SourcePairResultCheckpointAllowed.primCall_compBit hAllowed
  | Keccak op =>
      cases op
      exact SourcePairResultCheckpointAllowed.primCall_keccak256_of_nonOk
        hNonOk hAllowed
  | Env op =>
      exact SourcePairResultCheckpointAllowed.primCall_env_of_safe_nonOk
        hSafe hNonOk hAllowed
  | Block op =>
      exact SourcePairResultCheckpointAllowed.primCall_block_of_nonOk
        hNonOk hAllowed
  | StackMemFlow op =>
      exact SourcePairResultCheckpointAllowed.primCall_stackMemFlow_of_safe_nonOk
        hSafe hNonOk hAllowed
  | Log op =>
      cases op with
      | LOG0 =>
          exact
            SourcePairResultCheckpointAllowed.primCall_of_state_eq_on_ok
              hAllowed
              (Yul.PrimSemantics.primCall_log0_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG1 =>
          exact
            SourcePairResultCheckpointAllowed.primCall_of_state_eq_on_ok
              hAllowed
              (Yul.PrimSemantics.primCall_log1_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG2 =>
          exact
            SourcePairResultCheckpointAllowed.primCall_of_state_eq_on_ok
              hAllowed
              (Yul.PrimSemantics.primCall_log2_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG3 =>
          exact
            SourcePairResultCheckpointAllowed.primCall_of_state_eq_on_ok
              hAllowed
              (Yul.PrimSemantics.primCall_log3_state_eq_of_ok_of_nonOk
                hNonOk)
      | LOG4 =>
          exact
            SourcePairResultCheckpointAllowed.primCall_of_state_eq_on_ok
              hAllowed
              (Yul.PrimSemantics.primCall_log4_state_eq_of_ok_of_nonOk
                hNonOk)
  | System op =>
      cases op with
      | CREATE =>
          simp [Safe.primitive] at hSafe
      | CALL =>
          simp [Safe.primitive] at hSafe
      | CALLCODE =>
          simp [Safe.primitive] at hSafe
      | RETURN =>
          exact SourcePairResultCheckpointAllowed.primCall_return hAllowed
      | DELEGATECALL =>
          simp [Safe.primitive] at hSafe
      | CREATE2 =>
          simp [Safe.primitive] at hSafe
      | STATICCALL =>
          simp [Safe.primitive] at hSafe
      | REVERT =>
          exact SourcePairResultCheckpointAllowed.primCall_revert hAllowed
      | INVALID =>
          exact SourcePairResultCheckpointAllowed.primCall_invalid hAllowed
      | SELFDESTRUCT =>
          exact SourcePairResultCheckpointAllowed.primCall_selfdestruct hAllowed

theorem PrimitiveCallCheckpointAllowedForSafe.of_primitive_families :
    PrimitiveCallCheckpointAllowedForSafe := by
  intro canBreak canContinue canLeave fuel yulPrim shared store args hSafe
  cases hCall :
      EvmYul.Yul.primCall fuel (.Ok shared store) yulPrim args with
  | error err =>
      simp [SourcePairResultCheckpointAllowed]
  | ok pair =>
      cases pair with
      | mk outState values =>
          cases outState with
          | Ok sharedAfter storeAfter =>
              simp [SourcePairResultCheckpointAllowed, StateCheckpointAllowed]
          | OutOfFuel =>
              simp [SourcePairResultCheckpointAllowed, StateCheckpointAllowed]
          | Checkpoint jump =>
              exfalso
              cases yulPrim with
              | StopArith op =>
                  have hEq :=
                    Yul.PrimSemantics.primCall_stopArith_state_eq_of_ok
                      hCall
                  cases hEq
              | CompBit op =>
                  have hEq :=
                    Yul.PrimSemantics.primCall_compBit_state_eq_of_ok hCall
                  cases hEq
              | Keccak op =>
                  cases fuel with
                  | zero =>
                      simp [EvmYul.Yul.primCall] at hCall
                  | succ fuel =>
                      cases op
                      simp [EvmYul.Yul.primCall] at hCall
                      have hStep :
                          EvmYul.step
                              ((.Keccak .KECCAK256 :
                                EvmYul.Operation .Yul)) none =
                            EvmYul.Yul.binaryMachineStateOp'
                              EvmYul.MachineState.keccak256 := by
                        rfl
                      rw [hStep] at hCall
                      exact
                        Yul.PrimSemantics.wrapped_binaryMachineStateOp'_not_checkpoint_of_ok
                          hCall
              | Env op =>
                  have hSupported : Yul.PrimSemantics.EnvCheckpointSafe op := by
                    cases op <;>
                      simp [Yul.PrimSemantics.EnvCheckpointSafe,
                        Safe.primitive] at hSafe ⊢
                  exact
                    Yul.PrimSemantics.primCall_env_not_checkpoint_of_ok
                      hSupported hCall
              | Block op =>
                  exact
                    Yul.PrimSemantics.primCall_block_not_checkpoint_of_ok
                      hCall
              | StackMemFlow op =>
                  have hSupported :
                      Yul.PrimSemantics.StackMemFlowCheckpointSafe op := by
                    cases op <;>
                      simp [Yul.PrimSemantics.StackMemFlowCheckpointSafe,
                        Safe.primitive] at hSafe ⊢
                  exact
                    Yul.PrimSemantics.primCall_stackMemFlow_not_checkpoint_of_ok
                      hSupported hCall
              | Log op =>
                  cases op with
                  | LOG0 =>
                      exact
                        Yul.PrimSemantics.primCall_log0_not_checkpoint_of_ok
                          hCall
                  | LOG1 =>
                      exact
                        Yul.PrimSemantics.primCall_log1_not_checkpoint_of_ok
                          hCall
                  | LOG2 =>
                      exact
                        Yul.PrimSemantics.primCall_log2_not_checkpoint_of_ok
                          hCall
                  | LOG3 =>
                      exact
                        Yul.PrimSemantics.primCall_log3_not_checkpoint_of_ok
                          hCall
                  | LOG4 =>
                      exact
                        Yul.PrimSemantics.primCall_log4_not_checkpoint_of_ok
                          hCall
              | System op =>
                  cases op with
                  | CREATE =>
                      simp [Safe.primitive] at hSafe
                  | CALL =>
                      simp [Safe.primitive] at hSafe
                  | CALLCODE =>
                      simp [Safe.primitive] at hSafe
                  | RETURN =>
                      exact
                        Yul.PrimSemantics.primCall_return_impossible_of_ok
                          hCall
                  | DELEGATECALL =>
                      simp [Safe.primitive] at hSafe
                  | CREATE2 =>
                      simp [Safe.primitive] at hSafe
                  | STATICCALL =>
                      simp [Safe.primitive] at hSafe
                  | REVERT =>
                      exact
                        Yul.PrimSemantics.primCall_revert_impossible_of_ok
                          hCall
                  | INVALID =>
                      exact
                        Yul.PrimSemantics.primCall_invalid_impossible_of_ok
                          hCall
                  | SELFDESTRUCT =>
                      exact
                        Yul.PrimSemantics.primCall_selfdestruct_impossible_of_ok
                          hCall

theorem PrimitiveCallCheckpointAllowedForSafeState.of_ok_and_nonOk
    (hPrimCheckpoint : PrimitiveCallCheckpointAllowedForSafe)
    (hPrimNonOk : PrimitiveCallCheckpointAllowedForSafeNonOk) :
    PrimitiveCallCheckpointAllowedForSafeState := by
  intro canBreak canContinue canLeave fuel prim state args hSafe hState
  cases state with
  | Ok shared store =>
      exact SourcePairResultCheckpointAllowed.primCall_of_safe_ok
        hPrimCheckpoint hSafe
  | OutOfFuel =>
      exact hPrimNonOk hSafe (by intro shared store h; cases h) hState
  | Checkpoint jump =>
      exact hPrimNonOk hSafe (by intro shared store h; cases h) hState

