        simp [ExprsNoUserCalls]
    | cons head rest =>
        cases hRest :
            Expr.List.lower1? state rest with
        | none =>
            simp [Expr.List.lower1?, hRest] at hLower
        | some restResult =>
            rcases restResult with ⟨preRest, lowerRest, stateRest⟩
            cases hHead :
                Expr.lower? 1 stateRest head with
            | none =>
                simp [Expr.List.lower1?, hRest, hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨preHead, lowerHead, stateHead⟩
                simp [Expr.List.lower1?, hRest, hHead] at hLower
                rcases hLower with ⟨hPreEq, _hLower, _hState⟩
                cases hPreEq
                rcases generatedPrelude_append_components hPre with
                  ⟨hPreRest, hPreHead⟩
                exact
                  ⟨exprNoUserCalls_of_lower?_generatedPrelude hHead hPreHead,
                    exprsNoUserCalls_of_lower1?_generatedPrelude hRest
                      hPreRest⟩

  theorem exprsNoUserCalls_of_lowerBound1?_generatedPrelude
      {state state' : Fresh.State} {exprs : List AstExpr}
      {pre : List Functions.Stmt}
      {lower : List (Locals.Expr 1)}
      (hLower :
        Expr.List.lowerBound1? state exprs = some (pre, lower, state'))
      (hPre : GeneratedPrelude pre) :
      ExprsNoUserCalls exprs := by
    cases exprs with
    | nil =>
        simp [ExprsNoUserCalls]
    | cons head rest =>
        cases hRest :
            Expr.List.lowerBound1? state rest with
        | none =>
            simp [Expr.List.lowerBound1?, hRest] at hLower
        | some restResult =>
            rcases restResult with ⟨preRest, lowerRest, stateRest⟩
            cases hHead :
                Expr.lower? 1 stateRest head with
            | none =>
                simp [Expr.List.lowerBound1?, hRest, hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨preHead, lowerHead, stateHead⟩
                cases hFresh : Fresh.fresh? stateHead with
                | none =>
                    simp [Expr.List.lowerBound1?, hRest, hHead, hFresh]
                      at hLower
                | some freshResult =>
                    rcases freshResult with ⟨tmp, stateFresh⟩
                    simp [Expr.List.lowerBound1?, hRest, hHead, hFresh]
                      at hLower
                    rcases hLower with ⟨hPreEq, _hLower, _hState⟩
                    cases hPreEq
                    have hPreAssoc :
                        GeneratedPrelude
                          (preRest ++
                            (preHead ++
                              [Functions.Stmt.let_ tmp lowerHead])) := by
                      simpa [List.append_assoc] using hPre
                    rcases generatedPrelude_append_components hPreAssoc with
                      ⟨hPreRest, hPreHeadLet⟩
                    rcases generatedPrelude_append_components hPreHeadLet with
                      ⟨hPreHead, _hLet⟩
                    exact
                      ⟨exprNoUserCalls_of_lower?_generatedPrelude hHead
                          hPreHead,
                        exprsNoUserCalls_of_lowerBound1?_generatedPrelude
                          hRest hPreRest⟩
end

theorem exprNoUserCalls_of_lower1?_generatedPrelude
    {state state' : Fresh.State} {expr : AstExpr}
    {pre : List Functions.Stmt} {lower : Locals.Expr 1}
    (hLower :
      Expr.lower1? state expr = some (pre, lower, state'))
    (hPre : GeneratedPrelude pre) :
    ExprNoUserCalls expr :=
  exprNoUserCalls_of_lower?_generatedPrelude
    (by simpa [Expr.lower1?] using hLower) hPre

mutual
  theorem exprNoUserCalls_of_lower?_noInternalCall
      {results : Nat} {state state' : Fresh.State}
      {expr : AstExpr} {pre : List Functions.Stmt}
      {lower : Locals.Expr results}
      (hLower :
        Expr.lower? results state expr = some (pre, lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.StmtList.Holds pre) :
      ExprNoUserCalls expr := by
    cases expr with
    | Lit value =>
        simp [ExprNoUserCalls]
    | Var name =>
        simp [ExprNoUserCalls]
    | Call callee args =>
        cases callee with
        | inl yulPrim =>
            cases hBasic : Prim.toBasicOp? yulPrim with
            | none =>
                simp [Expr.lower?, hBasic] at hLower
            | some op =>
                cases hArgs :
                    Expr.List.lowerBound1? state args with
                | none =>
                    simp [Expr.lower?, hBasic, hArgs] at hLower
                | some argResult =>
                    rcases argResult with ⟨preArgs, lowerArgs, stateArgs⟩
                    cases hSeq :
                        Expr.List.toStackSeq? lowerArgs
                          (Expressions.Structured.BasicOp.inputs op) with
                    | none =>
                        simp [Expr.lower?, hBasic, hArgs, hSeq] at hLower
                    | some seq =>
                        by_cases hOutputs :
                            Expressions.Structured.BasicOp.outputs op =
                              results
                        · simp [Expr.lower?, hBasic, hArgs, hSeq, hOutputs]
                            at hLower
                          rcases hLower with ⟨hPreEq, _hLower, _hState⟩
                          cases hPreEq
                          exact
                            exprsNoUserCalls_of_lowerBound1?_noInternalCall
                              hArgs hNoCall
                        · simp [Expr.lower?, hBasic, hArgs, hSeq, hOutputs]
                            at hLower
        | inr functionName =>
            cases hUnsupported :
                ObjectBuiltin.unsupported? functionName with
            | true =>
                simp [Expr.lower?, hUnsupported] at hLower
            | false =>
                by_cases hResults : 1 = results
                · cases hDirect : Expr.List.directCallArgsSafe? args with
                  | false =>
                      cases hArgs :
                          Expr.List.lowerBound1? state args with
                      | none =>
                          simp [Expr.lower?, hUnsupported, hResults,
                            hDirect, hArgs] at hLower
                      | some argResult =>
                          rcases argResult with
                            ⟨preArgs, lowerArgs, stateArgs⟩
                          cases hFresh : Fresh.fresh? stateArgs with
                          | none =>
                              simp [Expr.lower?, hUnsupported, hResults,
                                hDirect, hArgs, hFresh] at hLower
                          | some freshResult =>
                              rcases freshResult with ⟨tmp, stateFresh⟩
                              simp [Expr.lower?, hUnsupported, hResults,
                                hDirect, hArgs, hFresh] at hLower
                              rcases hLower with
                                ⟨hPreEq, _hLower, _hState⟩
                              cases hPreEq
                              exact False.elim
                                (noInternalCallStmtList_append_call_false
                                  (pre :=
                                    preArgs ++
                                      [Functions.Stmt.let_ tmp
                                        (.lit Expr.zero)])
                                  (targets := [tmp])
                                  (functionName := functionName)
                                  (args := lowerArgs)
                                  (by
                                    simpa [List.append_assoc] using hNoCall))
                  | true =>
                      cases hArgs : Expr.List.toLocals1? args with
                      | none =>
                          simp [Expr.lower?, hUnsupported, hResults,
                            hDirect, hArgs] at hLower
                      | some lowerArgs =>
                          cases hFresh : Fresh.fresh? state with
                          | none =>
                              simp [Expr.lower?, hUnsupported, hResults,
                                hDirect, hArgs, hFresh] at hLower
                          | some freshResult =>
                              rcases freshResult with ⟨tmp, stateFresh⟩
                              simp [Expr.lower?, hUnsupported, hResults,
                                hDirect, hArgs, hFresh] at hLower
                              rcases hLower with
                                ⟨hPreEq, _hLower, _hState⟩
                              cases hPreEq
                              exact False.elim
                                (noInternalCallStmtList_append_call_false
                                  (pre :=
                                    [Functions.Stmt.let_ tmp (.lit Expr.zero)])
                                  (targets := [tmp])
                                  (functionName := functionName)
                                  (args := lowerArgs)
                                  (by simpa using hNoCall))
                · simp [Expr.lower?, hUnsupported, hResults] at hLower

  theorem exprsNoUserCalls_of_lower1?_noInternalCall
      {state state' : Fresh.State} {exprs : List AstExpr}
      {pre : List Functions.Stmt}
      {lower : List (Locals.Expr 1)}
      (hLower :
        Expr.List.lower1? state exprs = some (pre, lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.StmtList.Holds pre) :
      ExprsNoUserCalls exprs := by
    cases exprs with
    | nil =>
        simp [ExprsNoUserCalls]
    | cons head rest =>
        cases hRest :
            Expr.List.lower1? state rest with
        | none =>
            simp [Expr.List.lower1?, hRest] at hLower
        | some restResult =>
            rcases restResult with ⟨preRest, lowerRest, stateRest⟩
            cases hHead :
                Expr.lower? 1 stateRest head with
            | none =>
                simp [Expr.List.lower1?, hRest, hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨preHead, lowerHead, stateHead⟩
                simp [Expr.List.lower1?, hRest, hHead] at hLower
                rcases hLower with ⟨hPreEq, _hLower, _hState⟩
                cases hPreEq
                rcases noInternalCallStmtList_append_components hNoCall with
                  ⟨hRestNoCall, hHeadNoCall⟩
                exact
                  ⟨exprNoUserCalls_of_lower?_noInternalCall hHead
                      hHeadNoCall,
                    exprsNoUserCalls_of_lower1?_noInternalCall hRest
                      hRestNoCall⟩

  theorem exprsNoUserCalls_of_lowerBound1?_noInternalCall
      {state state' : Fresh.State} {exprs : List AstExpr}
      {pre : List Functions.Stmt}
      {lower : List (Locals.Expr 1)}
      (hLower :
        Expr.List.lowerBound1? state exprs = some (pre, lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.StmtList.Holds pre) :
      ExprsNoUserCalls exprs := by
    cases exprs with
    | nil =>
        simp [ExprsNoUserCalls]
    | cons head rest =>
        cases hRest :
            Expr.List.lowerBound1? state rest with
        | none =>
            simp [Expr.List.lowerBound1?, hRest] at hLower
        | some restResult =>
            rcases restResult with ⟨preRest, lowerRest, stateRest⟩
            cases hHead :
                Expr.lower? 1 stateRest head with
            | none =>
                simp [Expr.List.lowerBound1?, hRest, hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨preHead, lowerHead, stateHead⟩
                cases hFresh : Fresh.fresh? stateHead with
                | none =>
                    simp [Expr.List.lowerBound1?, hRest, hHead, hFresh]
                      at hLower
                | some freshResult =>
                    rcases freshResult with ⟨tmp, stateFresh⟩
                    simp [Expr.List.lowerBound1?, hRest, hHead, hFresh]
                      at hLower
                    rcases hLower with ⟨hPreEq, _hLower, _hState⟩
                    cases hPreEq
                    have hAssoc :
                        Functions.LiveLayout.NoInternalCall.StmtList.Holds
                          (preRest ++
                            (preHead ++
                              [Functions.Stmt.let_ tmp lowerHead])) := by
                      simpa [List.append_assoc] using hNoCall
                    rcases noInternalCallStmtList_append_components hAssoc with
                      ⟨hRestNoCall, hHeadLetNoCall⟩
                    rcases
                        noInternalCallStmtList_append_components
                          hHeadLetNoCall with
                      ⟨hHeadNoCall, _hLetNoCall⟩
                    exact
                      ⟨exprNoUserCalls_of_lower?_noInternalCall hHead
                          hHeadNoCall,
                        exprsNoUserCalls_of_lowerBound1?_noInternalCall
                          hRest hRestNoCall⟩
end

theorem exprNoUserCalls_of_lower1?_noInternalCall
    {state state' : Fresh.State} {expr : AstExpr}
    {pre : List Functions.Stmt} {lower : Locals.Expr 1}
    (hLower :
      Expr.lower1? state expr = some (pre, lower, state'))
    (hNoCall :
      Functions.LiveLayout.NoInternalCall.StmtList.Holds pre) :
    ExprNoUserCalls expr :=
  exprNoUserCalls_of_lower?_noInternalCall
    (by simpa [Expr.lower1?] using hLower) hNoCall

theorem exprsNoUserCalls_append
    {left right : List AstExpr}
    (hLeft : ExprsNoUserCalls left)
    (hRight : ExprsNoUserCalls right) :
    ExprsNoUserCalls (left ++ right) := by
  induction left with
  | nil =>
      simpa [ExprsNoUserCalls] using hRight
  | cons head tail ih =>
      rcases hLeft with ⟨hHead, hTail⟩
      simpa [ExprsNoUserCalls] using And.intro hHead (ih hTail)

theorem exprsNoUserCalls_reverse
    {args : List AstExpr}
    (hNoUser : ExprsNoUserCalls args) :
    ExprsNoUserCalls args.reverse := by
  induction args with
  | nil =>
      simp [ExprsNoUserCalls]
  | cons head tail ih =>
      rcases hNoUser with ⟨hHead, hTail⟩
      simpa using
        exprsNoUserCalls_append (ih hTail)
          (by simpa [ExprsNoUserCalls] using And.intro hHead True.intro)

/--
Expression and argument result shape for expressions that contain no internal
Yul user-function call nodes.

This discharges the evaluator-shape proof completely for the no-user-call
fragment: literals, variables, primitive-call roots, and primitive arguments are
handled by structural recursion plus the imported primitive semantics.  The
remaining unconditional user-call-root contract is therefore only needed for
actual `.Call (.inr ...)` nodes.
-/
theorem eval_evalArgs_resultOkFromOk_of_noUserCalls
    {contract : AstContract}
    (fuel : Nat) :
    (∀ {layout : List Name} {expr : AstExpr},
      Safe.expr expr →
      SourceExprScoped layout expr →
      UserCallArity.ExprOk contract expr →
      ExprNoUserCalls expr →
      ExprEvalResultOkFromOkAt fuel expr (some contract)) ∧
    (∀ {layout : List Name} {args : List AstExpr},
      Safe.exprs args →
      SourceExprsScoped layout args →
      UserCallArity.ExprsOk contract args →
      ExprsNoUserCalls args →
      ExprsEvalArgsResultOkFromOkAt fuel args (some contract)) := by
  refine Nat.strong_induction_on fuel ?_
  intro fuel ih
  cases fuel with
  | zero =>
      constructor
      · intro layout expr hSafe hScoped hOk hNoUser shared store sourceAfter
          value hEval
        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
          EvmYul.Yul.head'] at hEval
      · intro layout args hSafe hScoped hOk hNoUser shared store sourceAfter
          values hEval
        simp [EvmYul.Yul.evalArgs] at hEval
  | succ fuel' =>
      have ihFuel := ih fuel' (Nat.lt_succ_self fuel')
      constructor
      · intro layout expr hSafe hScoped hOk hNoUser shared store sourceAfter
          value hEval
        cases expr with
        | Lit literal =>
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
              EvmYul.Yul.head'] at hEval
            rcases hEval with ⟨hState, _hValue⟩
            subst sourceAfter
            exact ⟨shared, store, rfl⟩
        | Var name =>
            cases hLookup :
                EvmYul.Yul.State.lookup? name (.Ok shared store : State) with
            | none =>
                simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.head', hLookup] at hEval
            | some valueFound =>
                simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.head', hLookup] at hEval
                rcases hEval with ⟨hState, _hValue⟩
                subst sourceAfter
                exact ⟨shared, store, rfl⟩
        | Call callee args =>
            cases callee with
            | inr functionName =>
                cases hNoUser
            | inl prim =>
                have hSafePrim : Safe.primitive prim := hSafe.1
                have hSafeArgs : Safe.exprs args := hSafe.2
                have hScopedArgs : SourceExprsScoped layout args := by
                  simpa [SourceExprScoped] using hScoped
                have hOkArgs : UserCallArity.ExprsOk contract args := by
                  simpa [UserCallArity.ExprOk] using hOk
                have hNoUserArgs : ExprsNoUserCalls args := by
                  simpa [ExprNoUserCalls] using hNoUser
                cases hArgs :
                    EvmYul.Yul.evalArgs fuel' args.reverse (some contract)
                      (.Ok shared store : State) with
                | error err =>
                    simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                      EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs] at hEval
                | ok argPair =>
                    rcases argPair with ⟨stateArgs, argValuesRaw⟩
                    rcases
                        ihFuel.2 (layout := layout) (args := args.reverse)
                          (safe_exprs_reverse hSafeArgs)
                          (SourceExprsScoped.reverse hScopedArgs)
                          (UserCallArity.ExprsOk.reverse hOkArgs)
                          (exprsNoUserCalls_reverse hNoUserArgs)
                          hArgs with
                      ⟨sharedArgs, storeArgs, hStateArgs⟩
                    subst stateArgs
                    cases hCall :
                        EvmYul.Yul.primCall fuel'
                          (.Ok sharedArgs storeArgs : State) prim
                          argValuesRaw.reverse with
                    | error err =>
                        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                          EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs,
                          hCall] at hEval
                    | ok callPair =>
                        rcases callPair with ⟨stateCall, valuesCall⟩
                        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                          EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs,
                          hCall] at hEval
                        rcases hEval with ⟨hState, _hValue⟩
                        subst sourceAfter
                        cases stateCall with
                        | Ok sharedAfter storeAfter =>
                            exact ⟨sharedAfter, storeAfter, rfl⟩
                        | OutOfFuel =>
                            exact False.elim
                              (primCall_safe_not_outOfFuel_of_ok
                                hSafePrim hCall)
                        | Checkpoint jump =>
                            have hAllowed :
                                SourcePairResultCheckpointAllowed false false
                                  false
                                  (EvmYul.Yul.primCall fuel'
                                    (.Ok sharedArgs storeArgs : State) prim
                                    argValuesRaw.reverse) :=
                              PrimitiveCallCheckpointAllowedForSafe.of_primitive_families
                                hSafePrim
                            have hJump :
                                StateCheckpointAllowed false false false
                                  (.Checkpoint jump : State) := by
                              simpa [SourcePairResultCheckpointAllowed,
                                hCall] using hAllowed
                            cases jump <;>
                              simp [StateCheckpointAllowed] at hJump
      · intro layout args hSafe hScoped hOk hNoUser shared store sourceAfter
          values hEval
        cases args with
        | nil =>
            simp [EvmYul.Yul.evalArgs] at hEval
            rcases hEval with ⟨hState, _hValues⟩
            subst sourceAfter
            exact ⟨shared, store, rfl⟩
        | cons head tail =>
            rcases hNoUser with ⟨hHeadNoUser, hTailNoUser⟩
            have hHeadSafe : Safe.expr head := hSafe.1
            have hTailSafe : Safe.exprs tail := hSafe.2
            have hHeadScoped : SourceExprScoped layout head := hScoped.1
            have hTailScoped : SourceExprsScoped layout tail := hScoped.2
            have hHeadOk : UserCallArity.ExprOk contract head := hOk.1
            have hTailOk : UserCallArity.ExprsOk contract tail := hOk.2
            cases hHead :
                EvmYul.Yul.eval fuel' head (some contract)
                  (.Ok shared store : State) with
            | error err =>
                simp [EvmYul.Yul.evalArgs, hHead,
                  EvmYul.Yul.evalTail] at hEval
            | ok headPair =>
                rcases headPair with ⟨stateHead, headValue⟩
                cases fuel' with
                | zero =>
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail] at hEval
                | succ fuelTail =>
                    rcases
                        ihFuel.1 hHeadSafe hHeadScoped hHeadOk hHeadNoUser
                          hHead with
                      ⟨sharedHead, storeHead, hStateHead⟩
                    subst stateHead
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail, EvmYul.Yul.cons'] at hEval
                    cases hTail :
                        EvmYul.Yul.evalArgs fuelTail tail (some contract)
                          (.Ok sharedHead storeHead : State) with
                    | error err =>
                        simp [hTail] at hEval
                    | ok tailPair =>
                        rcases tailPair with ⟨stateTail, tailValues⟩
                        simp [hTail] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst sourceAfter
                        exact
                          (ih fuelTail (by omega)).2 hTailSafe hTailScoped
                            hTailOk hTailNoUser hTail

theorem exprEvalResultOkAt_of_noUserCalls
    {cfg : StateRelConfig} {layout : List Name}
    {contract : AstContract} {fuel : Nat} {expr : AstExpr}
    (hSafe : Safe.expr expr)
    (hScoped : SourceExprScoped layout expr)
    (hOk : UserCallArity.ExprOk contract expr)
    (hNoUser : ExprNoUserCalls expr) :
    ExprEvalResultOkAt cfg layout fuel expr (some contract) :=
  ExprEvalResultOkFromOkAt.to_resultOkAt
    ((eval_evalArgs_resultOkFromOk_of_noUserCalls (contract := contract)
      fuel).1 hSafe hScoped hOk hNoUser)

/--
Expression result shape derived from checked expression lowering plus the
target-side no-internal-call predicate on the emitted prelude.

This is the checker-facing composition of
`exprNoUserCalls_of_lower?_noInternalCall` with the source-only no-user-call
evaluator theorem above.  It is deliberately local to a concrete lowered
expression/prelude, avoiding the overbroad global user-call-root semantic
contract.
-/
theorem exprEvalResultOkAt_of_lower?_noInternalCall
    {cfg : StateRelConfig} {layout : List Name}
    {contract : AstContract} {fuel results : Nat}
    {state state' : Fresh.State} {expr : AstExpr}
    {pre : List Functions.Stmt} {lower : Locals.Expr results}
    (hLower :
      Expr.lower? results state expr = some (pre, lower, state'))
    (hNoCall :
      Functions.LiveLayout.NoInternalCall.StmtList.Holds pre)
    (hSafe : Safe.expr expr)
    (hScoped : SourceExprScoped layout expr)
    (hOk : UserCallArity.ExprOk contract expr) :
    ExprEvalResultOkAt cfg layout fuel expr (some contract) :=
  ExprEvalResultOkFromOkAt.to_resultOkAt
    ((eval_evalArgs_resultOkFromOk_of_noUserCalls (contract := contract)
      fuel).1 hSafe hScoped hOk
        (exprNoUserCalls_of_lower?_noInternalCall hLower hNoCall))

theorem exprEvalResultOkAt_of_lower1?_noInternalCall
    {cfg : StateRelConfig} {layout : List Name}
    {contract : AstContract} {fuel : Nat}
    {state state' : Fresh.State} {expr : AstExpr}
    {pre : List Functions.Stmt} {lower : Locals.Expr 1}
    (hLower :
      Expr.lower1? state expr = some (pre, lower, state'))
    (hNoCall :
      Functions.LiveLayout.NoInternalCall.StmtList.Holds pre)
    (hSafe : Safe.expr expr)
    (hScoped : SourceExprScoped layout expr)
    (hOk : UserCallArity.ExprOk contract expr) :
    ExprEvalResultOkAt cfg layout fuel expr (some contract) :=
  exprEvalResultOkAt_of_lower?_noInternalCall
    (by simpa [Expr.lower1?] using hLower) hNoCall hSafe hScoped hOk

theorem toFunctionsListFuel?_let_expr_single_components
    {fuel : Nat} {state state' : Fresh.State}
    {name : EvmYul.Identifier} {value : AstExpr}
    {lowerHead : List Functions.Stmt}
    (hNotUserCall : ∀ functionName args,
      value ≠ .Call (.inr functionName) args)
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.Let [name] (some value)) =
        some (lowerHead, state')) :
    ∃ pre : List Functions.Stmt, ∃ lowerValue : Locals.Expr 1,
      Expr.lower1? state value = some (pre, lowerValue, state') ∧
      lowerHead = pre ++ [Functions.Stmt.let_ (identName name) lowerValue] := by
  cases value with
  | Call callee args =>
      cases callee with
      | inl prim =>
          cases hExpr : Expr.lower1? state (.Call (.inl prim) args) with
          | none =>
              simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
          | some exprResult =>
              rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
              simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
              rcases hLower with ⟨hHead, hState⟩
              cases hState
              exact ⟨pre, lowerValue, rfl, hHead.symm⟩
      | inr functionName =>
          exact False.elim (hNotUserCall functionName args rfl)
  | Var varName =>
      cases hExpr : Expr.lower1? state (.Var varName) with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
      | some exprResult =>
          rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          exact ⟨pre, lowerValue, rfl, hHead.symm⟩
  | Lit literal =>
      cases hExpr : Expr.lower1? state (.Lit literal) with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
      | some exprResult =>
          rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          exact ⟨pre, lowerValue, rfl, hHead.symm⟩

theorem toFunctionsListFuel?_assign_expr_single_components
    {fuel : Nat} {state state' : Fresh.State}
    {name : EvmYul.Identifier} {value : AstExpr}
    {lowerHead : List Functions.Stmt}
    (hNotUserCall : ∀ functionName args,
      value ≠ .Call (.inr functionName) args)
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.Assign [name] value) =
        some (lowerHead, state')) :
    ∃ pre : List Functions.Stmt, ∃ lowerValue : Locals.Expr 1,
      Expr.lower1? state value = some (pre, lowerValue, state') ∧
      lowerHead = pre ++ [Functions.Stmt.assign (identName name) lowerValue] := by
  cases value with
  | Call callee args =>
      cases callee with
      | inl prim =>
          cases hExpr : Expr.lower1? state (.Call (.inl prim) args) with
          | none =>
              simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
          | some exprResult =>
              rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
              simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
              rcases hLower with ⟨hHead, hState⟩
              cases hState
              exact ⟨pre, lowerValue, rfl, hHead.symm⟩
      | inr functionName =>
          exact False.elim (hNotUserCall functionName args rfl)
  | Var varName =>
      cases hExpr : Expr.lower1? state (.Var varName) with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
      | some exprResult =>
          rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          exact ⟨pre, lowerValue, rfl, hHead.symm⟩
  | Lit literal =>
      cases hExpr : Expr.lower1? state (.Lit literal) with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
      | some exprResult =>
          rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
          simp [Stmt.toFunctionsListFuel?, hExpr] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          exact ⟨pre, lowerValue, rfl, hHead.symm⟩

mutual
  def StmtNoUserCalls : AstStmt → Prop
    | .Block body => StmtsNoUserCalls body
    | .Let _names none => True
    | .Let _names (some value) => ExprNoUserCalls value
    | .Assign _names value => ExprNoUserCalls value
    | .ExprStmtCall value => ExprNoUserCalls value
    | .Switch scrutinee cases defaultBody =>
        ExprNoUserCalls scrutinee ∧ CasesNoUserCalls cases ∧
          StmtsNoUserCalls defaultBody
    | .For cond post body =>
        ExprNoUserCalls cond ∧ StmtsNoUserCalls post ∧
          StmtsNoUserCalls body
    | .If cond body =>
        ExprNoUserCalls cond ∧ StmtsNoUserCalls body
    | .Continue => True
    | .Break => True
    | .Leave => True

  def StmtsNoUserCalls : List AstStmt → Prop
    | [] => True
    | head :: rest => StmtNoUserCalls head ∧ StmtsNoUserCalls rest

  def CasesNoUserCalls : List (Word × List AstStmt) → Prop
    | [] => True
    | (_value, body) :: rest =>
        StmtsNoUserCalls body ∧ CasesNoUserCalls rest
end

theorem stmtsNoUserCalls_head
    {head : AstStmt} {tail : List AstStmt}
    (hNoUser : StmtsNoUserCalls (head :: tail)) :
    StmtNoUserCalls head := by
  simpa [StmtsNoUserCalls] using hNoUser.1

theorem stmtsNoUserCalls_tail
    {head : AstStmt} {tail : List AstStmt}
    (hNoUser : StmtsNoUserCalls (head :: tail)) :
    StmtsNoUserCalls tail := by
  simpa [StmtsNoUserCalls] using hNoUser.2

theorem casesNoUserCalls_head
    {value : Word} {body : List AstStmt}
    {tail : List (Word × List AstStmt)}
    (hNoUser : CasesNoUserCalls ((value, body) :: tail)) :
    StmtsNoUserCalls body := by
  simpa [CasesNoUserCalls] using hNoUser.1

theorem casesNoUserCalls_tail
    {value : Word} {body : List AstStmt}
    {tail : List (Word × List AstStmt)}
    (hNoUser : CasesNoUserCalls ((value, body) :: tail)) :
    CasesNoUserCalls tail := by
  simpa [CasesNoUserCalls] using hNoUser.2

theorem stmtsNoUserCalls_selectSwitchCase
    {value : Word} {defaultBody : List AstStmt}
    {cases : List (Word × List AstStmt)}
    (hCases : CasesNoUserCalls cases)
    (hDefault : StmtsNoUserCalls defaultBody) :
    StmtsNoUserCalls (EvmYul.Yul.selectSwitchCase value defaultBody cases) := by
  induction cases with
  | nil =>
      simpa [EvmYul.Yul.selectSwitchCase] using hDefault
  | cons head tail ih =>
      rcases head with ⟨caseValue, body⟩
      have hBody : StmtsNoUserCalls body :=
        casesNoUserCalls_head hCases
      have hTail : CasesNoUserCalls tail :=
        casesNoUserCalls_tail hCases
      by_cases hEq : caseValue = value
      · simp [EvmYul.Yul.selectSwitchCase, hEq, hBody]
      · simpa [EvmYul.Yul.selectSwitchCase, hEq] using ih hTail

theorem stmtNoUserCalls_let_expr
    {names : List EvmYul.Identifier} {value : AstExpr}
    (hNoUser : StmtNoUserCalls (.Let names (some value))) :
    ExprNoUserCalls value := by
  simpa [StmtNoUserCalls] using hNoUser

