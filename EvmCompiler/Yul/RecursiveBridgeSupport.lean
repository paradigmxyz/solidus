        .ok (.Ok sharedAfter storeAfter, values)) :
    StoreDomainExact layout storeAfter := by
  have hStateDomain :
      StateStoreDomainExact layout (.Ok sharedAfter storeAfter) :=
    evalArgs_reverse_state_domain_exact_of_safe_primitiveFamilies
      (args := args) hSafe (by simpa [StateStoreDomainExact] using hDomain)
