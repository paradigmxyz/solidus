theorem target_mode_regular_or_leave_or_halt_of_source_no_loop_control
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {allowed : Except Exception State → Prop}
    {sourceDone : Except Exception State}
    {outcome : Functions.Source.Outcome}
    (hDone :
      SourceOpenLoopContinuationPathDoneRel cfg layout outcomeLayout
        terminalRel revertRel allowed sourceDone (.ok outcome))
    (hAllowed : SourceResultNotRegularOk sourceDone → allowed sourceDone)
    (hNoBreak :
      ∀ {sharedBreak : EvmYul.SharedState .Yul}
        {storeBreak : EvmYul.Yul.VarStore},
        sourceDone =
          .ok (.Checkpoint (.Break sharedBreak storeBreak)) →
        False)
    (hNoContinue :
      ∀ {sharedContinue : EvmYul.SharedState .Yul}
        {storeContinue : EvmYul.Yul.VarStore},
        sourceDone =
          .ok (.Checkpoint (.Continue sharedContinue storeContinue)) →
        False) :
    outcome.mode = Locals.Source.Mode.regular ∨
      outcome.mode = Locals.Source.Mode.leave ∨
        ∃ kind : Assembly.HaltKind,
          outcome.mode = Locals.Source.Mode.halt kind := by
  have hNotBreak :
      outcome.mode ≠ Locals.Source.Mode.brk :=
    target_mode_ne_brk_of_source_no_break hDone hAllowed hNoBreak
  have hNotContinue :
      outcome.mode ≠ Locals.Source.Mode.cont :=
    target_mode_ne_cont_of_source_no_continue hDone hAllowed hNoContinue
  cases hMode : outcome.mode with
  | regular => exact Or.inl rfl
  | brk => exact False.elim (hNotBreak hMode)
  | cont => exact False.elim (hNotContinue hMode)
  | leave => exact Or.inr (Or.inl rfl)
  | halt kind => exact Or.inr (Or.inr ⟨kind, rfl⟩)

