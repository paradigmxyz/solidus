  simpa [hSeq] using hAllowed

/--
Recover an out-of-fuel head result's `allowed` proof from an allowed
surrounding nonempty source sequence.

This branch is usually discharged immediately by `SourceResultRelatable`, but
keeping the adapter explicit avoids routing through singleton sequence facts.
-/
theorem allowed_of_execSeq_cons_outOfFuel_succ
    {allowed : Except Exception State → Prop}
    {fuel : Nat} {head : AstStmt} {rest : List AstStmt}
    {codeOverride : Option AstContract}
    {source : State} {sourceResult : Except Exception State}
    (hHead :
      EvmYul.Yul.exec fuel head codeOverride source =
        .ok .OutOfFuel)
    (hSeq :
      EvmYul.Yul.execSeq fuel.succ (head :: rest) codeOverride source =
        sourceResult)
    (hAllowed : allowed sourceResult) :
    allowed (.ok .OutOfFuel) := by
  have hSeqHead :
      EvmYul.Yul.execSeq fuel.succ (head :: rest) codeOverride source =
        .ok .OutOfFuel :=
    Imported.execSeq_cons_outOfFuel_succ hHead
  rw [hSeqHead] at hSeq
  simpa [hSeq] using hAllowed

/--
Recover a nonregular head result's `allowed` proof from an allowed surrounding
nonempty source sequence.

This packages the error/checkpoint/out-of-fuel cases behind the semantic fact
that a nonregular head result skips the tail of `execSeq`.
-/
theorem allowed_of_execSeq_cons_nonregular_succ
    {allowed : Except Exception State → Prop}
    {fuel : Nat} {head : AstStmt} {rest : List AstStmt}
    {codeOverride : Option AstContract}
    {source : State} {headResult sourceResult : Except Exception State}
    (hHead :
      EvmYul.Yul.exec fuel head codeOverride source = headResult)
    (hNonregular : SourceResultNotRegularOk headResult)
    (hSeq :
      EvmYul.Yul.execSeq fuel.succ (head :: rest) codeOverride source =
        sourceResult)
    (hAllowed : allowed sourceResult) :
    allowed headResult := by
  cases headResult with
  | error err =>
      exact
        allowed_of_execSeq_cons_error_succ
          (allowed := allowed) (fuel := fuel) (head := head)
          (rest := rest) (codeOverride := codeOverride) (source := source)
          (err := err) (sourceResult := sourceResult) hHead hSeq hAllowed
  | ok state =>
      cases state with
      | Ok shared store =>
          exact False.elim hNonregular
      | OutOfFuel =>
          exact
            allowed_of_execSeq_cons_outOfFuel_succ
              (allowed := allowed) (fuel := fuel) (head := head)
              (rest := rest) (codeOverride := codeOverride)
              (source := source) (sourceResult := sourceResult)
              hHead hSeq hAllowed
      | Checkpoint checkpoint =>
          exact
            allowed_of_execSeq_cons_checkpoint_succ
              (allowed := allowed) (fuel := fuel) (head := head)
              (rest := rest) (codeOverride := codeOverride)
              (source := source) (checkpoint := checkpoint)
              (sourceResult := sourceResult) hHead hSeq hAllowed

/--
Close a hidden-context exact result sequence into a scoped block at a compatible
outcome layout.

This is the block-boundary counterpart of
`SourceResultSeqSoundWhenAtExactHiddenCtx`: generated temporaries may have
extended the target context during the open sequence, but Yul block cleanup and
`Functions.Source.Block.runScoped` expose only the source-visible entry layout
or the selected control-handler layout.
-/
theorem sourceResultBlockSoundWhenAtExact_of_hiddenCtx_compat
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hScope : ctx.scope = layout)
    (hSeq :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
            sourceResult) →
        SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
          terminalRel revertRel prim program ctx sourceFuel body codeOverride
          lowerBody allowedInner) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ body codeOverride lowerBody
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared scope compiler hShared hVars hDomain =>
      let innerResult : Except Exception State :=
        EvmYul.Yul.execSeq sourceFuel body codeOverride
          (.Ok shared scope : State)
      let wrap : Except Exception State → Except Exception State :=
        fun result =>
          match result with
          | .ok state => .ok (state.restrictStoreTo scope)
          | .error err => .error err
      have hOuter :
          EvmYul.Yul.exec sourceFuel.succ (.Block body) codeOverride
              (.Ok shared scope : State) =
            wrap innerResult := by
        unfold innerResult
        cases hExec :
            EvmYul.Yul.execSeq sourceFuel body codeOverride
              (.Ok shared scope : State) with
        | error err =>
            simp [wrap, EvmYul.Yul.exec, hExec]
        | ok state =>
            cases state <;>
              simp [wrap, EvmYul.Yul.exec, EvmYul.Yul.State.store, hExec]
      have hWrapEq : wrap innerResult = sourceResult := by
        simpa [hOuter] using hSource
      let allowedInner : Except Exception State → Prop :=
        fun result => allowed (wrap result)
      have hAllowInner : allowedInner innerResult := by
        change allowed (wrap innerResult)
        simpa [hWrapEq] using hAllow
      have hAllowedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultRelatable sourceResult := by
        intro sourceResult hAllowedWrapped
        exact
          SourceResultRelatable.of_restrictStoreTo
            (scope := scope) (sourceResult := sourceResult)
            (hAllowed hAllowedWrapped)
      have hCompatInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
              sourceResult := by
        intro sourceResult hAllowedWrapped
        exact
          SourceResultOutcomeLayoutCompatible.of_restrictStoreTo
            (scope := scope) (sourceResult := sourceResult)
            (hCompat hAllowedWrapped)
      rcases (hSeq (allowedInner := allowedInner) hAllowedInner hCompatInner)
          (SourceStateExactRel.ok hShared hVars hDomain)
          hAllowInner (by rfl) with
        ⟨sourceOutcome, _ctxAfter, targetFuel, hTargetOpen, hRelInner⟩
      let outerOutcome : Objects.Source.Outcome :=
        match sourceOutcome.mode with
        | .regular =>
            Functions.Source.Outcome.regular
              (sourceOutcome.state.restrictTo layout)
        | .brk | .cont | .leave | .halt _ => sourceOutcome
      have hTargetOuter :
          Functions.Source.Block.runScoped prim program ctx lowerBody targetFuel
              compiler =
            .ok outerOutcome := by
        cases targetFuel with
        | zero =>
            exact False.elim
              (by
                simpa [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid] using hTargetOpen)
        | succ targetFuel' =>
            cases sourceOutcome with
            | mk outcomeState outcomeMode =>
                cases outcomeMode <;>
                  simp [outerOutcome, Functions.Source.Block.runScoped,
                    hTargetOpen, hScope, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular]
      have hRelOuter :
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (wrap innerResult) outerOutcome := by
        cases hResult : innerResult with
        | error err =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | yulHalt hTerminal =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.yulHalt
                    (cfg := cfg) (layout := outcomeLayout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hTerminal)
            | revert hRevert =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.revert
                    (cfg := cfg) (layout := outcomeLayout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hRevert)
        | ok innerState =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                    case ok compilerAfter sharedAfter storeAfter
                        hSharedAfter hVarsAfter =>
                        have hFinalCompat :
                            SourceResultOutcomeLayoutCompatible ctx layout
                              outcomeLayout (wrap innerResult) := by
                          exact hCompat (by
                            change allowed (wrap innerResult)
                            exact hAllowInner)
                        have hOutcomeLayout : outcomeLayout = layout := by
                          simpa [SourceResultOutcomeLayoutCompatible, wrap,
                            hResult, EvmYul.Yul.State.restrictStoreTo] using
                            hFinalCompat
                        subst outcomeLayout
                        have hRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (Locals.Source.State.restrictTo layout
                                compilerAfter) := by
                          exact
                            sourceStateRel_restrictStoreTo_of_domain
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hDomain (fun name hMem => hMem)
                        simpa [outerOutcome, wrap, hResult] using
                          (SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular hRestricted))
                | brk hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hBreakCompat :
                        ctx.breakScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hBreakCompat with ⟨_hBreak, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.brk hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | cont hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hContinueCompat :
                        ctx.continueScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hContinueCompat with
                      ⟨_hContinue, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.cont hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | leave hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hLeaveCompat :
                        ctx.leaveScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hLeaveCompat with ⟨_hLeave, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.leave hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
      exact ⟨outerOutcome, targetFuel, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

/--
Close a same-layout typed-continuation singleton sequence into the ordinary
checked single-statement exact interface.

This is the dispatcher-boundary adapter used by no-user/no-CALL routes: the
source-level block wraps one statement, while the reusable no-user frontier is
phrased as an open singleton sequence with typed continuations.  Same-layout
block continuations collapse back to the ordinary outcome relation.
-/
theorem checkedStmtBlockLoweringSoundWhenFreshNamesAtExact_of_seqKont_block_same_succ
    {cfg : StateRelConfig} {reserved layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {innerFuel : Nat} {sourceStmt : AstStmt}
    {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout layout sourceResult)
    (hScope : ctx.scope = layout)
    (hSeq :
      ∀ {compileFuel : Nat}
        {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultModeKontSupported ctx layout
            (SourceModeKontLayouts.block layout layout) sourceResult) →
        CheckedSeqKontSoundWhenFreshNamesAtCompileFuelHiddenCtx cfg reserved
          layout (SourceModeKontLayouts.block layout layout)
          terminalRel revertRel prim program ctx innerFuel compileFuel
          [sourceStmt] codeOverride allowedInner) :
    CheckedStmtBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
      layout terminalRel revertRel prim program ctx innerFuel.succ sourceStmt
      codeOverride allowed := by
  intro freshState freshState' lowerStmts hCovers hLower
  have hLowerSeq :
      Stmt.List.toBlockFuel? (Stmt.fuel sourceStmt).succ.succ freshState
          [sourceStmt] =
        some ({ stmts := lowerStmts }, freshState') := by
    have hLowerList :
        Stmt.List.toFunctionsFuel? (Stmt.fuel sourceStmt).succ freshState
            [sourceStmt] =
          some (lowerStmts, freshState') := by
      have hLowerRaw :
          Stmt.toFunctionsListFuel? (Stmt.fuel sourceStmt) freshState
              sourceStmt =
            some (lowerStmts, freshState') := by
        simpa [Stmt.toFunctionsList?] using hLower
      cases hFuel : Stmt.fuel sourceStmt with
      | zero =>
          simp [hFuel, Stmt.toFunctionsListFuel?] at hLowerRaw
      | succ fuel' =>
          have hLowerRaw' :
              Stmt.toFunctionsListFuel? (fuel' + 1) freshState sourceStmt =
                some (lowerStmts, freshState') := by
            simpa [hFuel] using hLowerRaw
          have hTail :
              Stmt.List.toFunctionsFuel? (fuel' + 1) freshState' [] =
                some ([], freshState') := by
            simp [Stmt.List.toFunctionsFuel?]
          simp [hFuel, Stmt.List.toFunctionsFuel?, hLowerRaw', hTail,
            List.append_nil]
    simp [Stmt.List.toBlockFuel?, hLowerList]
  exact
    sourceResultBlockSoundWhenAtExact_of_hiddenCtx_compat
      (cfg := cfg) (layout := layout) (outcomeLayout := layout)
      (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
      (program := program) (ctx := ctx) (sourceFuel := innerFuel)
      (body := [sourceStmt]) (codeOverride := codeOverride)
      (lowerBody := { stmts := lowerStmts }) (allowed := allowed)
      hAllowed hCompat hScope
      (by
        intro allowedInner hAllowedInner hCompatInner
        exact
          SourceResultSeqSoundWhenAtExactHiddenCtx.of_seqKont_block_same
            ((hSeq
              (compileFuel := (Stmt.fuel sourceStmt).succ.succ)
              (allowedInner := allowedInner)
              hAllowedInner
              (by
                intro sourceResult hAllow
                exact
                  SourceResultModeKontSupported.block_same_of_compatible
                    (hCompatInner hAllow)))
              hCovers hLowerSeq))

/--
Close a hidden-context exact result sequence into a scoped block while allowing
the target block context to retain compiler-only locals.

Regular block cleanup may restrict the source state to `ctx.scope`, so the only
extra requirement is that all source-visible names remain available in the
current scope.  Abrupt handlers may intentionally target smaller layouts and
are handled separately by `SourceResultOutcomeLayoutCompatible`.  This is the
block boundary needed by
generated control preludes such as lowered `if` conditions.
-/
