    (hCallResponse :
      ∀ {lowerTail : Functions.Block} {sourceCall targetCall response},
        seqCallResponseRel
          { site := sourceCall.site
            resume := fun response =>
              OpenExternal.OpenResult.bind (sourceCall.resume response)
                (fun sourceResult =>
                  let sourceAfter :=
                    EvmYul.Yul.State.multifill [name] sourceResult.2
