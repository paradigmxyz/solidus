    StateCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.State.restrictStoreTo scope state) := by
  cases state with
  | Ok shared store =>
      simp [StateCheckpointAllowed, EvmYul.Yul.State.restrictStoreTo]
  | OutOfFuel =>
      simp [StateCheckpointAllowed, EvmYul.Yul.State.restrictStoreTo]
  | Checkpoint jump =>
      cases jump <;>
        simpa [StateCheckpointAllowed, EvmYul.Yul.State.restrictStoreTo]
          using hAllowed

theorem StateCheckpointAllowed.mono
    {canBreakFrom canContinueFrom canLeaveFrom : Bool}
    {canBreakTo canContinueTo canLeaveTo : Bool}
    {state : State}
    (hBreak : canBreakFrom = true → canBreakTo = true)
    (hContinue : canContinueFrom = true → canContinueTo = true)
    (hLeave : canLeaveFrom = true → canLeaveTo = true)
    (hAllowed :
      StateCheckpointAllowed canBreakFrom canContinueFrom canLeaveFrom state) :
    StateCheckpointAllowed canBreakTo canContinueTo canLeaveTo state := by
  cases state with
  | Ok shared store =>
      simp [StateCheckpointAllowed]
  | OutOfFuel =>
      simp [StateCheckpointAllowed]
  | Checkpoint jump =>
      cases jump
      · exact hContinue hAllowed
      · exact hBreak hAllowed
      · exact hLeave hAllowed

theorem StateCheckpointAllowed.of_no_loop_control
    {canBreak canContinue canLeave : Bool} {state : State}
    (hAllowed : StateCheckpointAllowed false false canLeave state) :
    StateCheckpointAllowed canBreak canContinue canLeave state :=
  StateCheckpointAllowed.mono (by intro h; cases h)
    (by intro h; cases h) (by intro h; exact h) hAllowed

