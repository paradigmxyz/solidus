theorem generatedPrelude_append
    {left right : List Functions.Stmt}
    (hLeft : GeneratedPrelude left)
    (hRight : GeneratedPrelude right) :
    GeneratedPrelude (left ++ right) := by
  induction hLeft with
  | nil =>
      simpa using hRight
  | let_ hRest ih =>
      simpa using GeneratedPrelude.let_ ih

theorem generatedPrelude_append_let
    {pre : List Functions.Stmt} {name : Name} {expr : Locals.Expr 1}
    (hPre : GeneratedPrelude pre) :
    GeneratedPrelude (pre ++ [Functions.Stmt.let_ name expr]) := by
  simpa using
    generatedPrelude_append hPre
      (GeneratedPrelude.let_ GeneratedPrelude.nil)

theorem generatedPrelude_append_components
    {left right : List Functions.Stmt}
    (hPre : GeneratedPrelude (left ++ right)) :
    GeneratedPrelude left ∧ GeneratedPrelude right := by
  induction left with
  | nil =>
      exact ⟨GeneratedPrelude.nil, by simpa using hPre⟩
  | cons head tail ih =>
      cases hPre with
      | let_ hRest =>
          rcases ih hRest with ⟨hTail, hRight⟩
          exact ⟨GeneratedPrelude.let_ hTail, hRight⟩

theorem generatedPrelude_append_call_false
    {pre : List Functions.Stmt} {targets : List Name}
