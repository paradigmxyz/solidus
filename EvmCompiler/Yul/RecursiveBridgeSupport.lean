    EvmYul.Yul.evalValues sourceFuel.succ
        (.Call (.inl yulPrim) args) codeOverride source =
      .ok (sourceAfterPrim, values) := by
  simp [EvmYul.Yul.evalValues, EvmYul.Yul.reverse', hArgs, hPrim]

theorem exec_block_expr_prim_call_error_of_evalArgs_ok_primCall_error
    {sourceFuel : Nat} {source sourceAfterArgs : State}
    {yulPrim : EvmYul.Operation .Yul} {args : List AstExpr}
