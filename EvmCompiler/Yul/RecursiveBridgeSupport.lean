theorem evalValues_user_call_ok_store_eq_of_arg_store
    {fuel : Nat} {shared sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {store storeArgs storeAfter : EvmYul.Yul.VarStore}
    {argValues values : List Word}
    {functionName : EvmYul.Yul.Ast.YulFunctionName}
    {args : List AstExpr} {codeOverride : Option AstContract}
    (hArgs :
      EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs fuel args.reverse codeOverride
            (.Ok shared store)) =
        .ok (.Ok sharedArgs storeArgs, argValues))
    (hArgsStore : storeArgs = store)
    (hEval :
      EvmYul.Yul.evalValues fuel.succ (.Call (.inr functionName) args)
          codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values)) :
    storeAfter = store := by
  have hCall :
      EvmYul.Yul.call fuel argValues functionName codeOverride
          (.Ok sharedArgs storeArgs) =
        .ok (.Ok sharedAfter storeAfter, values) := by
    simpa [EvmYul.Yul.evalValues, hArgs] using hEval
  rw [call_ok_store_eq hCall, hArgsStore]

theorem evalValues_user_call_ok_domain_exact_of_arg_domain
    {layout : List Name}
    {fuel : Nat} {shared sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {store storeArgs storeAfter : EvmYul.Yul.VarStore}
    {argValues values : List Word}
    {functionName : EvmYul.Yul.Ast.YulFunctionName}
    {args : List AstExpr} {codeOverride : Option AstContract}
    (hArgs :
      EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs fuel args.reverse codeOverride
            (.Ok shared store)) =
        .ok (.Ok sharedArgs storeArgs, argValues))
    (hDomainArgs : StoreDomainExact layout storeArgs)
    (hEval :
      EvmYul.Yul.evalValues fuel.succ (.Call (.inr functionName) args)
          codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values)) :
    StoreDomainExact layout storeAfter := by
  have hCall :
      EvmYul.Yul.call fuel argValues functionName codeOverride
          (.Ok sharedArgs storeArgs) =
        .ok (.Ok sharedAfter storeAfter, values) := by
    simpa [EvmYul.Yul.evalValues, hArgs] using hEval
  exact call_ok_domain_exact hDomainArgs hCall

theorem eval_lit_ok_store_eq
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {out value : Word}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (hEval :
      EvmYul.Yul.eval fuel.succ (.Lit value) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, out)) :
    storeAfter = store := by
  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head'] at hEval
  exact hEval.1.2.symm

theorem eval_var_ok_store_eq
    {fuel : Nat} {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {out : Word} {name : EvmYul.Identifier}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (hEval :
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, out)) :
    storeAfter = store := by
  cases hLookup : EvmYul.Yul.State.lookup? name (.Ok shared store) with
  | none =>
      simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, hLookup,
        EvmYul.Yul.head'] at hEval
  | some value =>
      simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, hLookup,
        EvmYul.Yul.head'] at hEval
      exact hEval.1.2.symm

