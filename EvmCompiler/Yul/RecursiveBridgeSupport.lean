theorem StateStoreContains.callRestore
    {layout : List Name} {caller body : State}
    (hCaller : StateStoreContains layout caller) :
    StateStoreContains layout
      (EvmYul.Yul.State.setStore
        (EvmYul.Yul.State.overwrite?
          (EvmYul.Yul.State.reviveJump body) caller) caller) := by
  cases caller with
  | Ok shared store =>
      cases body with
      | Ok bodyShared bodyStore =>
          simpa [StateStoreContains, EvmYul.Yul.State.reviveJump,
            EvmYul.Yul.State.overwrite?, EvmYul.Yul.State.setStore] using
            hCaller
      | OutOfFuel =>
          simp [StateStoreContains, EvmYul.Yul.State.reviveJump,
            EvmYul.Yul.State.overwrite?, EvmYul.Yul.State.setStore]
      | Checkpoint jump =>
          cases jump <;>
            simpa [StateStoreContains, EvmYul.Yul.State.reviveJump,
              EvmYul.Yul.State.revive, EvmYul.Yul.State.overwrite?,
              EvmYul.Yul.State.setStore] using hCaller
  | OutOfFuel =>
      simp [StateStoreContains, EvmYul.Yul.State.overwrite?,
        EvmYul.Yul.State.setStore]
  | Checkpoint jump =>
      cases jump <;>
        simpa [StateStoreContains, EvmYul.Yul.State.overwrite?,
          EvmYul.Yul.State.setStore] using hCaller

