/--
Singleton hidden-context sequence bridge for a regular hidden head.

This is the zero-tail specialization of
`sourceResultSeqSoundWhenAtExactHiddenCtx_cons_regular_hidden`, but stated in a
form that can be used inside frontier proofs after inspecting the source
branch.  The only outer fact needed is layout compatibility for the resulting
regular source state, which identifies the observable outcome layout with the
entry layout.
-/
theorem sourceResultSeqSoundWhenAtExactHiddenCtx_single_regular_hidden
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {head : AstStmt}
    {codeOverride : Option AstContract}
    {lowerHead : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hHead :
      ∀ {source compiler},
        SourceStateExactRel cfg layout source compiler →
        SourceRegularStmtRunHiddenExact cfg layout layout prim program ctx
          sourceFuel head codeOverride source compiler lowerHead) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel.succ [head]
      codeOverride lowerHead allowed := by
  intro source compiler sourceResult hInitial hAllow hSourceSeq
  rcases hHead hInitial with
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSourceHead,
      hTargetHead, _hSubset, hRelAfter⟩
  cases hRelAfter with
  | @ok sharedAfter storeAfter compilerAfter hSharedAfter hVarsAfter
      hDomainAfter =>
      have hRelAfterExact :
          SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
            compilerAfter :=
        SourceStateExactRel.ok hSharedAfter hVarsAfter hDomainAfter
      have hSourceSeqRegular :
          EvmYul.Yul.execSeq sourceFuel.succ [head] codeOverride source =
            .ok (.Ok sharedAfter storeAfter) :=
        by
          cases sourceFuel with
          | zero =>
              have hZero :
                  EvmYul.Yul.exec 0 head codeOverride source =
                    .error .OutOfFuel :=
                Imported.exec_zero head codeOverride source
              rw [hZero] at hSourceHead
              cases hSourceHead
          | succ tailFuel =>
              exact
                Imported.execSeq_cons_ok_result_succ
                  (fuel := tailFuel.succ) (stmt := head) (rest := [])
                  (codeOverride := codeOverride) (state := source)
                  (shared := sharedAfter) (store := storeAfter)
                  (result := .ok (.Ok sharedAfter storeAfter))
                  hSourceHead
                  (Imported.execSeq_nil_succ tailFuel codeOverride
                    (.Ok sharedAfter storeAfter : State))
      have hResultEq :
          (.ok (.Ok sharedAfter storeAfter) : Except Exception State) =
            sourceResult := by
        rw [hSourceSeqRegular] at hSourceSeq
        exact hSourceSeq
      have hAllowRegular :
          allowed (.ok (.Ok sharedAfter storeAfter)) := by
        rw [hResultEq]
        exact hAllow
      have hOutcomeEq : outcomeLayout = layout := by
        simpa [SourceResultOutcomeLayoutCompatible] using
          hCompat hAllowRegular
      subst outcomeLayout
      exact
        ⟨Functions.Source.Outcome.regular compilerAfter, ctxAfter,
          targetFuel, hTargetHead,
          by
            have hRelOk :
                SourceResultOutcomeRel cfg layout terminalRel revertRel
                  (.ok (.Ok sharedAfter storeAfter))
                  (Functions.Source.Outcome.regular compilerAfter) :=
              SourceResultOutcomeRel.ok
                (SourceOkOutcomeRel.regular
                  (SourceStateExactRel.toRel hRelAfterExact))
            simpa [hResultEq] using hRelOk⟩

/--
Singleton hidden-context sequence bridge for a nonregular hidden head.

The head already determines the surrounding sequence result, so the empty tail
is skipped just as in the cons/nonregular composition theorem.
-/
