          EvmYul.Yul.exec innerFuel.succ.succ (.Block [.Block body])
              codeOverride (.Ok shared scope : State) =
            wrap innerResult := by
        unfold innerResult
        cases hExec :
            EvmYul.Yul.exec innerFuel (.Block body) codeOverride
              (.Ok shared scope : State) with
        | error err =>
            simp [wrap, EvmYul.Yul.exec, EvmYul.Yul.execSeq, hExec]
        | ok state =>
            cases innerFuel with
            | zero =>
                have hZero :
                    EvmYul.Yul.exec 0 (.Block body) codeOverride
                        (.Ok shared scope : State) =
                      .error .OutOfFuel :=
                  Imported.exec_zero (.Block body) codeOverride
                    (.Ok shared scope : State)
