    ∃ bodyFuel : Nat,
    ∃ yulAccount : EvmYul.Account .Yul,
    ∃ fn : AstFunctionDefinition,
      bodyFuel ≤ sourceFuel ∧
      sourceAfterArgs.sharedState.accountMap.find?
          sourceAfterArgs.executionEnv.codeOwner =
        some yulAccount ∧
      contract.functions.lookup functionName = some fn ∧
      EvmYul.Yul.exec bodyFuel (.Block fn.body) (some contract)
          (👌 sourceAfterArgs.initcall fn.params fn.rets argValues) =
        .error err := by
  have hExecStmt :
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Assign names (.Call (.inr functionName) args))
          (some contract) (.Ok shared store) =
        .error err := by
