            (SourceModeKontLayouts.block layout outcomeLayout) terminalRel
            revertRel prim program ctx sourceFuel.succ [(.For cond post body)]
            codeOverride lowerBlock allowedFiltered :=
        sourceResultBlockKontSoundWhenAtExactHiddenScope_of_checkedSeqKont
          (cfg := cfg) (reserved := reserved) (layout := layout)
          (konts := SourceModeKontLayouts.block layout outcomeLayout)
          (terminalRel := terminalRel) (revertRel := revertRel)
          (prim := prim) (program := program) (ctx := ctx)
          (sourceFuel := sourceFuel) (compileFuel := compileFuel)
          (body := [(.For cond post body)]) (codeOverride := codeOverride)
          (lowerBody := lowerBlock) (freshState := freshState)
          (freshState' := freshState') (allowed := allowedFiltered)
