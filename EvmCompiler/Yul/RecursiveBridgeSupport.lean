def SourceVarsContains (layout : List Name)
    (vars : Locals.Source.Store) : Prop :=
  ∀ name : Name, name ∈ layout → vars.contains name = true

namespace SourceVarsContains

theorem of_lookupMany {names : List Name}
    {vars : Locals.Source.Store} {values : List Word}
    (hLookup : Functions.Source.Store.lookupMany names vars = some values) :
    SourceVarsContains names vars := by
  intro name hMem
  induction names generalizing values with
  | nil =>
      simp at hMem
  | cons head tail ih =>
      unfold Functions.Source.Store.lookupMany at hLookup
      cases hHead : vars head with
      | none =>
          simp [hHead] at hLookup
      | some value =>
          simp [hHead] at hLookup
          cases hTail :
              Functions.Source.Store.lookupMany tail vars with
          | none =>
              simp [hTail] at hLookup
          | some tailValues =>
              simp [hTail] at hLookup
              rcases hLookup with rfl
              simp only [List.mem_cons] at hMem
              rcases hMem with hEq | hTailMem
              · subst head
                simp [Locals.Source.Store.contains, hHead]
              · exact ih hTail hTailMem

theorem lookupMany_exists {layout names : List Name}
    {vars : Locals.Source.Store}
    (hContains : SourceVarsContains layout vars)
    (hSubset : ∀ name, name ∈ names → name ∈ layout) :
    ∃ values, Functions.Source.Store.lookupMany names vars = some values := by
  induction names with
  | nil =>
      exact ⟨[], by simp [Functions.Source.Store.lookupMany]⟩
  | cons name rest ih =>
      have hNameContains : vars.contains name = true :=
        hContains name (hSubset name (by simp))
      cases hLookup : vars name with
      | none =>
          simp [Locals.Source.Store.contains, hLookup] at hNameContains
      | some value =>
          rcases ih
            (by
              intro other hOther
              exact hSubset other (by simp [hOther])) with
            ⟨tailValues, hTail⟩
          exact
            ⟨value :: tailValues, by
              simp [Functions.Source.Store.lookupMany, hLookup, hTail]⟩

theorem insert {layout : List Name} {vars : Locals.Source.Store}
    {name : Name} {value : Word}
    (hContains : SourceVarsContains layout vars) :
    SourceVarsContains layout
      (Locals.Source.Store.insert vars name value) := by
  intro query hMem
  by_cases hEq : query = name
  · subst query
    simp [Locals.Source.Store.contains, Locals.Source.Store.insert_self]
  · rw [Locals.Source.Store.contains]
    rw [Locals.Source.Store.insert_of_ne hEq]
    exact hContains query hMem

theorem restrictTo {layout scope : List Name}
    {vars : Locals.Source.Store}
    (hContains : SourceVarsContains layout vars)
    (hSubset : ∀ name, name ∈ layout → name ∈ scope) :
    SourceVarsContains layout (Locals.Source.Store.restrictTo scope vars) := by
  intro name hMem
  have hScope : name ∈ scope := hSubset name hMem
  rw [Locals.Source.Store.contains]
  rw [Locals.Source.Store.restrictTo_mem hScope]
  exact hContains name hMem

theorem of_restrictTo {layout scope : List Name}
    {vars : Locals.Source.Store}
    (hContains :
      SourceVarsContains layout
        (Locals.Source.Store.restrictTo scope vars))
    (hSubset : ∀ name, name ∈ layout → name ∈ scope) :
    SourceVarsContains layout vars := by
  intro name hMem
  have hScope : name ∈ scope := hSubset name hMem
  have hHere := hContains name hMem
  simpa [Locals.Source.Store.contains,
    Locals.Source.Store.restrictTo_mem hScope] using hHere

theorem of_eval {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {results : Nat} {expr : Locals.Expr results}
    {state stateAfter : Objects.Source.State} {values : List Word}
    (hContains : SourceVarsContains layout state.vars)
    (hEval :
      Locals.Source.Expr.eval prim expr state = .ok (stateAfter, values)) :
    SourceVarsContains layout stateAfter.vars := by
  have hVars :
      stateAfter.vars = state.vars :=
    Locals.Source.Expr.eval_vars_eq hEval
  intro name hMem
  simpa [hVars] using hContains name hMem

theorem of_evalOne {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {results : Nat} {expr : Locals.Expr results}
    {state stateAfter : Objects.Source.State} {value : Word}
    (hContains : SourceVarsContains layout state.vars)
    (hEval :
      Locals.Source.Expr.evalOne prim expr state =
        .ok (stateAfter, value)) :
    SourceVarsContains layout stateAfter.vars := by
  have hVars :
      stateAfter.vars = state.vars :=
    Locals.Source.Expr.evalOne_vars_eq hEval
  intro name hMem
  simpa [hVars] using hContains name hMem

theorem of_evalSeq {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {results : Nat} {exprs : Locals.ExprSeq results}
    {state stateAfter : Objects.Source.State} {values : List Word}
    (hContains : SourceVarsContains layout state.vars)
    (hEval :
      Locals.Source.Expr.ExprSeq.eval prim exprs state =
        .ok (stateAfter, values)) :
    SourceVarsContains layout stateAfter.vars := by
  have hVars :
      stateAfter.vars = state.vars :=
    Locals.Source.Expr.evalSeq_vars_eq hEval
  intro name hMem
  simpa [hVars] using hContains name hMem

end SourceVarsContains

theorem sourceArgList_eval_vars_eq
    {prim : Objects.Source.PrimitiveSemantics}
    {args : List (Locals.Expr 1)}
    {state stateAfter : Objects.Source.State} {values : List Word}
    (hEval :
      Functions.Source.ArgList.eval prim args state =
        .ok (stateAfter, values)) :
    stateAfter.vars = state.vars := by
  induction args generalizing state stateAfter values with
  | nil =>
      simp [Functions.Source.ArgList.eval] at hEval
      exact hEval.1.symm ▸ rfl
  | cons head tail ih =>
      unfold Functions.Source.ArgList.eval at hEval
      cases hHead :
          Functions.Source.Expr.evalOne prim head state with
      | error err =>
          simp [hHead] at hEval
      | ok headResult =>
          rcases headResult with ⟨stateAfterHead, value⟩
          simp [hHead] at hEval
          cases hTail :
              Functions.Source.ArgList.eval prim tail stateAfterHead with
          | error err =>
              simp [hTail] at hEval
          | ok tailResult =>
              rcases tailResult with ⟨stateAfterTail, tailValues⟩
              simp [hTail] at hEval
              rcases hEval with ⟨hState, _hValues⟩
              subst stateAfterTail
              have hHeadVars :
                  stateAfterHead.vars = state.vars :=
                Locals.Source.Expr.evalOne_vars_eq hHead
              have hTailVars :
                  stateAfter.vars = stateAfterHead.vars :=
                ih hTail
              exact hTailVars.trans hHeadVars

theorem SourceVarsContains.of_argList_eval {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {args : List (Locals.Expr 1)}
    {state stateAfter : Objects.Source.State} {values : List Word}
    (hContains : SourceVarsContains layout state.vars)
    (hEval :
      Functions.Source.ArgList.eval prim args state =
        .ok (stateAfter, values)) :
    SourceVarsContains layout stateAfter.vars := by
  have hVars : stateAfter.vars = state.vars :=
    sourceArgList_eval_vars_eq hEval
  intro name hMem
  simpa [hVars] using hContains name hMem

theorem sourceArgList_eval_var_map_state_eq
    {prim : Objects.Source.PrimitiveSemantics}
    {names : List Name}
    {state stateAfter : Objects.Source.State} {values : List Word}
    (hEval :
      Functions.Source.ArgList.eval prim
          (names.map (fun name => (.var name : Locals.Expr 1))) state =
        .ok (stateAfter, values)) :
    stateAfter = state := by
  induction names generalizing state stateAfter values with
  | nil =>
      simp [Functions.Source.ArgList.eval] at hEval
      exact hEval.1.symm
  | cons name rest ih =>
      unfold Functions.Source.ArgList.eval at hEval
      cases hLookup : state.vars name with
      | none =>
          simp [Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
            Locals.Source.Expr.eval, hLookup, Functions.Source.invalid,
            Locals.Source.invalid, Structured.invalid] at hEval
      | some value =>
          simp [Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
            Locals.Source.Expr.eval, hLookup] at hEval
          cases hRest :
              Functions.Source.ArgList.eval prim
                (rest.map (fun name => (.var name : Locals.Expr 1)))
                state with
          | error err =>
              simp [hRest] at hEval
          | ok restResult =>
              rcases restResult with ⟨stateAfterRest, restValues⟩
              simp [hRest] at hEval
              rcases hEval with ⟨hStateEq, _hValuesEq⟩
              cases hStateEq
              exact ih hRest

theorem sourceArgList_eval_var_map_insert_of_not_mem
    {prim : Objects.Source.PrimitiveSemantics}
    {names : List Name} {tmp : Name} {value : Word}
    {state : Objects.Source.State} {values : List Word}
    (hEval :
      Functions.Source.ArgList.eval prim
          (names.map (fun name => (.var name : Locals.Expr 1))) state =
        .ok (state, values))
    (hFresh : tmp ∉ names) :
    Functions.Source.ArgList.eval prim
        (names.map (fun name => (.var name : Locals.Expr 1)))
        (state.insert tmp value) =
      .ok (state.insert tmp value, values) := by
  induction names generalizing state values with
  | nil =>
      simp [Functions.Source.ArgList.eval] at hEval ⊢
      exact hEval
  | cons name rest ih =>
      unfold Functions.Source.ArgList.eval at hEval ⊢
      have hNameNe : name ≠ tmp := by
        intro hEq
        exact hFresh (by simp [hEq])
      cases hLookup : state.vars name with
      | none =>
          simp [Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
            Locals.Source.Expr.eval, hLookup, Functions.Source.invalid,
            Locals.Source.invalid, Structured.invalid] at hEval
      | some headValue =>
          have hLookupInserted :
              (state.insert tmp value).vars name = some headValue := by
            simpa [Locals.Source.State.insert,
              Locals.Source.Store.insert_of_ne hNameNe] using hLookup
          simp [Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
            Locals.Source.Expr.eval, hLookup, hLookupInserted] at hEval ⊢
          cases hRest :
              Functions.Source.ArgList.eval prim
                (rest.map (fun name => (.var name : Locals.Expr 1)))
                state with
          | error err =>
              simp [hRest] at hEval
          | ok restResult =>
              rcases restResult with ⟨stateAfterRest, restValues⟩
              simp [hRest] at hEval
              rcases hEval with ⟨hStateEq, hValuesEq⟩
              cases hStateEq
              have hRestFresh : tmp ∉ rest := by
                intro hMem
                exact hFresh (by simp [hMem])
              have hRestInserted :
                  Functions.Source.ArgList.eval prim
                      (rest.map
                        (fun name => (.var name : Locals.Expr 1)))
                      (state.insert tmp value) =
                    .ok (state.insert tmp value, restValues) :=
                ih hRest hRestFresh
              simpa [hRestInserted, hValuesEq]

theorem sourceArgList_eval_append
    {prim : Objects.Source.PrimitiveSemantics}
    {left right : List (Locals.Expr 1)}
    {state stateMid stateAfter : Objects.Source.State}
    {leftValues rightValues : List Word}
    (hLeft :
      Functions.Source.ArgList.eval prim left state =
        .ok (stateMid, leftValues))
    (hRight :
      Functions.Source.ArgList.eval prim right stateMid =
        .ok (stateAfter, rightValues)) :
    Functions.Source.ArgList.eval prim (left ++ right) state =
      .ok (stateAfter, leftValues ++ rightValues) := by
  induction left generalizing state stateMid leftValues with
  | nil =>
      simp [Functions.Source.ArgList.eval] at hLeft ⊢
      rcases hLeft with ⟨hState, hValues⟩
      subst stateMid
      subst leftValues
      simpa using hRight
  | cons head tail ih =>
      unfold Functions.Source.ArgList.eval at hLeft ⊢
      cases hHead :
          Functions.Source.Expr.evalOne prim head state with
      | error err =>
          simp [hHead] at hLeft
      | ok headResult =>
          rcases headResult with ⟨stateAfterHead, value⟩
          simp [hHead] at hLeft
          cases hTail :
              Functions.Source.ArgList.eval prim tail stateAfterHead with
          | error err =>
              simp [hTail] at hLeft
          | ok tailResult =>
              rcases tailResult with ⟨stateAfterTail, tailValues⟩
              simp [hTail] at hLeft
              rcases hLeft with ⟨hStateMid, hLeftValues⟩
              subst stateAfterTail
              subst leftValues
              have hTailAppend :
                  Functions.Source.ArgList.eval prim (tail ++ right)
                      stateAfterHead =
                    .ok (stateAfter, tailValues ++ rightValues) :=
                ih hTail hRight
              simp [hHead, hTailAppend]

theorem sourceArgList_eval_var_map_reverse
    {prim : Objects.Source.PrimitiveSemantics}
    {names : List Name}
    {state : Objects.Source.State} {values : List Word}
    (hEval :
      Functions.Source.ArgList.eval prim
          (names.map (fun name => (.var name : Locals.Expr 1))) state =
        .ok (state, values)) :
    Functions.Source.ArgList.eval prim
        ((names.map (fun name => (.var name : Locals.Expr 1))).reverse)
        state =
      .ok (state, values.reverse) := by
  induction names generalizing state values with
  | nil =>
      simp [Functions.Source.ArgList.eval] at hEval ⊢
      simp [hEval]
  | cons name rest ih =>
      unfold Functions.Source.ArgList.eval at hEval
      cases hLookup : state.vars name with
      | none =>
          simp [Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
            Locals.Source.Expr.eval, hLookup, Functions.Source.invalid,
            Locals.Source.invalid, Structured.invalid] at hEval
      | some value =>
          simp [Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
            Locals.Source.Expr.eval, hLookup] at hEval
          cases hRest :
              Functions.Source.ArgList.eval prim
                (rest.map (fun name => (.var name : Locals.Expr 1)))
                state with
          | error err =>
              simp [hRest] at hEval
          | ok restResult =>
              rcases restResult with ⟨stateAfterRest, restValues⟩
              simp [hRest] at hEval
              rcases hEval with ⟨hStateEq, hValuesEq⟩
              subst stateAfterRest
              subst values
              have hRestRev :
                  Functions.Source.ArgList.eval prim
                      ((rest.map
                        (fun name => (.var name : Locals.Expr 1))).reverse)
                      state =
                    .ok (state, restValues.reverse) :=
                ih hRest
              have hOne :
                  Functions.Source.ArgList.eval prim
                      [(.var name : Locals.Expr 1)] state =
                    .ok (state, [value]) := by
                simp [Functions.Source.ArgList.eval,
                  Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
                  Locals.Source.Expr.eval, hLookup]
              have hAppend :
                  Functions.Source.ArgList.eval prim
                      ((rest.map
                        (fun name => (.var name : Locals.Expr 1))).reverse ++
                        [(.var name : Locals.Expr 1)]) state =
                    .ok (state, restValues.reverse ++ [value]) :=
                sourceArgList_eval_append hRestRev hOne
              simpa using hAppend

theorem sourceArgList_eval_var_map_of_reverse
    {prim : Objects.Source.PrimitiveSemantics}
    {names : List Name}
    {state : Objects.Source.State} {values : List Word}
    (hEval :
      Functions.Source.ArgList.eval prim
          ((names.map (fun name => (.var name : Locals.Expr 1))).reverse)
          state =
        .ok (state, values)) :
    Functions.Source.ArgList.eval prim
        (names.map (fun name => (.var name : Locals.Expr 1))) state =
      .ok (state, values.reverse) := by
  have hReverse :=
    sourceArgList_eval_var_map_reverse
      (prim := prim) (names := names.reverse) (state := state)
      (values := values)
      (by simpa [List.map_reverse] using hEval)
  simpa [List.map_reverse] using hReverse

theorem toLocals1?_length
    {args : List AstExpr} {lowerArgs : List (Locals.Expr 1)}
    (hLower : Expr.List.toLocals1? args = some lowerArgs) :
    lowerArgs.length = args.length := by
  induction args generalizing lowerArgs with
  | nil =>
      simp [Expr.List.toLocals1?] at hLower
      cases hLower
      rfl
  | cons head tail ih =>
      simp [Expr.List.toLocals1?] at hLower
      cases hHead : Expr.toLocals? 1 head with
      | none =>
          simp [hHead] at hLower
      | some lowerHead =>
          simp [hHead] at hLower
          cases hTail : Expr.List.toLocals1? tail with
          | none =>
              simp [hTail] at hLower
          | some lowerTail =>
              simp [hTail] at hLower
              cases hLower
              simp [ih hTail]

theorem lowerBound1?_nil_some_components
    {state state' : Fresh.State} {pre : List Functions.Stmt}
    {lowerArgs : List (Locals.Expr 1)}
    (hLower :
      Expr.List.lowerBound1? state [] = some (pre, lowerArgs, state')) :
    pre = [] ∧ lowerArgs = [] ∧ state' = state := by
  have h :
      pre = [] ∧ lowerArgs = [] ∧ state = state' := by
    simpa [Expr.List.lowerBound1?] using hLower
  exact ⟨h.1, h.2.1, h.2.2.symm⟩

theorem lowerBound1?_cons_some_components
    {state stateFresh : Fresh.State} {head : AstExpr}
    {tail : List AstExpr} {pre : List Functions.Stmt}
    {lowerArgs : List (Locals.Expr 1)}
    (hLower :
      Expr.List.lowerBound1? state (head :: tail) =
        some (pre, lowerArgs, stateFresh)) :
    ∃ preTail lowerTail stateTail preHead lowerHead stateHead tmp,
      Expr.List.lowerBound1? state tail =
        some (preTail, lowerTail, stateTail) ∧
      Expr.lower1? stateTail head =
        some (preHead, lowerHead, stateHead) ∧
      Fresh.fresh? stateHead = some (tmp, stateFresh) ∧
      pre = preTail ++ preHead ++ [Functions.Stmt.let_ tmp lowerHead] ∧
      lowerArgs = .var tmp :: lowerTail := by
  simp [Expr.List.lowerBound1?] at hLower
  cases hTail :
      Expr.List.lowerBound1? state tail with
  | none =>
      simp [hTail] at hLower
  | some tailResult =>
      rcases tailResult with ⟨preTail, lowerTail, stateTail⟩
      cases hHead :
          Expr.lower? 1 stateTail head with
      | none =>
          simp [hTail, hHead] at hLower
      | some headResult =>
          rcases headResult with ⟨preHead, lowerHead, stateHead⟩
          have hHeadLower1 :
              Expr.lower1? stateTail head =
                some (preHead, lowerHead, stateHead) := by
            simpa [Expr.lower1?] using hHead
          cases hFresh : Fresh.fresh? stateHead with
          | none =>
              simp [hTail, hHead, hFresh] at hLower
          | some freshResult =>
              rcases freshResult with ⟨tmp, stateFresh'⟩
              have hTuple :
                  (preTail ++ preHead ++
                      [Functions.Stmt.let_ tmp lowerHead],
                    .var tmp :: lowerTail, stateFresh') =
                    (pre, lowerArgs, stateFresh) := by
                simpa [hTail, hHead, hFresh] using hLower
              cases hTuple
              exact
                ⟨preTail, lowerTail, stateTail, preHead, lowerHead,
                  stateHead, tmp, rfl, hHeadLower1, hFresh, rfl, rfl⟩

theorem lower1?_primitive_call_some_components
    {state state' : Fresh.State} {yulPrim : EvmYul.Operation .Yul}
    {args : List AstExpr} {pre : List Functions.Stmt}
    {lower : Locals.Expr 1}
    (hLower :
      Expr.lower1? state (.Call (.inl yulPrim) args) =
        some (pre, lower, state')) :
    ∃ op : Structured.BasicOp,
    ∃ argExprs : List (Locals.Expr 1),
    ∃ seq : Locals.ExprSeq (Expressions.Structured.BasicOp.inputs op),
    ∃ hOutputs : Expressions.Structured.BasicOp.outputs op = 1,
      Prim.toBasicOp? yulPrim = some op ∧
      Expr.List.lowerBound1? state args = some (pre, argExprs, state') ∧
      Expr.List.toStackSeq? argExprs
          (Expressions.Structured.BasicOp.inputs op) =
        some seq ∧
      lower = Expr.cast hOutputs (.prim op seq) := by
  simp [Expr.lower1?, Expr.lower?] at hLower
  cases hBasic : Prim.toBasicOp? yulPrim with
  | none =>
      simp [hBasic] at hLower
  | some op =>
      cases hArgs :
          Expr.List.lowerBound1? state args with
      | none =>
          simp [hBasic, hArgs] at hLower
      | some argResult =>
          rcases argResult with ⟨preArgs, argExprs, stateArgs⟩
          cases hSeq :
              Expr.List.toStackSeq? argExprs
                (Expressions.Structured.BasicOp.inputs op) with
          | none =>
              simp [hBasic, hArgs, hSeq] at hLower
          | some seq =>
              by_cases hOutputs :
                  Expressions.Structured.BasicOp.outputs op = 1
              · have hTuple :
                    (preArgs, Expr.cast hOutputs (.prim op seq), stateArgs) =
                      (pre, lower, state') := by
                    simpa [hBasic, hArgs, hSeq, hOutputs] using hLower
                cases hTuple
                exact
                  ⟨op, argExprs, seq, hOutputs, rfl, rfl, hSeq, rfl⟩
              · simp [hBasic, hArgs, hSeq, hOutputs] at hLower

theorem lower0?_primitive_call_some_components
    {state state' : Fresh.State} {yulPrim : EvmYul.Operation .Yul}
    {args : List AstExpr} {pre : List Functions.Stmt}
    {lower : Locals.Expr 0}
    (hLower :
      Expr.lower0? state (.Call (.inl yulPrim) args) =
        some (pre, lower, state')) :
    ∃ op : Structured.BasicOp,
    ∃ argExprs : List (Locals.Expr 1),
    ∃ seq : Locals.ExprSeq (Expressions.Structured.BasicOp.inputs op),
    ∃ hOutputs : Expressions.Structured.BasicOp.outputs op = 0,
      Prim.toBasicOp? yulPrim = some op ∧
      Expr.List.lowerBound1? state args = some (pre, argExprs, state') ∧
      Expr.List.toStackSeq? argExprs
          (Expressions.Structured.BasicOp.inputs op) =
        some seq ∧
      lower = Expr.cast hOutputs (.prim op seq) := by
  simp [Expr.lower0?, Expr.lower?] at hLower
  cases hBasic : Prim.toBasicOp? yulPrim with
  | none =>
      simp [hBasic] at hLower
  | some op =>
      cases hArgs :
          Expr.List.lowerBound1? state args with
      | none =>
          simp [hBasic, hArgs] at hLower
      | some argResult =>
          rcases argResult with ⟨preArgs, argExprs, stateArgs⟩
          cases hSeq :
              Expr.List.toStackSeq? argExprs
                (Expressions.Structured.BasicOp.inputs op) with
          | none =>
              simp [hBasic, hArgs, hSeq] at hLower
          | some seq =>
              by_cases hOutputs :
                  Expressions.Structured.BasicOp.outputs op = 0
              · have hTuple :
                    (preArgs, Expr.cast hOutputs (.prim op seq), stateArgs) =
                      (pre, lower, state') := by
                    simpa [hBasic, hArgs, hSeq, hOutputs] using hLower
                cases hTuple
                exact
                  ⟨op, argExprs, seq, hOutputs, rfl, rfl, hSeq, rfl⟩
              · simp [hBasic, hArgs, hSeq, hOutputs] at hLower

theorem lower0?_callSafe_primitive_safe_of_lower0?
    {state state' : Fresh.State} {yulPrim : EvmYul.Operation .Yul}
    {args : List AstExpr} {pre : List Functions.Stmt}
    {lower : Locals.Expr 0}
    (hSafe : Safe.CallSafe.primitive yulPrim)
    (hLower :
      Expr.lower0? state (.Call (.inl yulPrim) args) =
        some (pre, lower, state')) :
    Safe.primitive yulPrim := by
  rcases lower0?_primitive_call_some_components hLower with
    ⟨op, _argExprs, _seq, hOutputs, hBasic, _hLowerArgs, _hSeq,
      _hLowerEq⟩
  rcases (Safe.CallSafe.primitive_iff_safe_or_call yulPrim).mp hSafe with
    hSafePrim | hCall
  · exact hSafePrim
  · subst yulPrim
    simp [Prim.toBasicOp?, Expressions.Structured.BasicOp.outputs] at hBasic
    cases hBasic
    simp [Expressions.Structured.BasicOp.outputs] at hOutputs

theorem lower1?_user_call_some_components
    {state state' : Fresh.State} {functionName : Name}
    {args : List AstExpr} {pre : List Functions.Stmt}
    {lower : Locals.Expr 1}
    (hLower :
      Expr.lower1? state (.Call (.inr functionName) args) =
        some (pre, lower, state')) :
    ∃ preArgs : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
    ∃ stateArgs : Fresh.State,
    ∃ tmp : Name,
      ObjectBuiltin.unsupported? functionName = false ∧
      ((Expr.List.directCallArgsSafe? args = true ∧
          Expr.List.toLocals1? args = some lowerArgs ∧
          preArgs = [] ∧ stateArgs = state) ∨
        (Expr.List.directCallArgsSafe? args = false ∧
          Expr.List.lowerBound1? state args =
            some (preArgs, lowerArgs, stateArgs))) ∧
      Fresh.fresh? stateArgs = some (tmp, state') ∧
      pre =
        preArgs ++
          [Functions.Stmt.let_ tmp (.lit Expr.zero),
            Functions.Stmt.call [tmp] functionName lowerArgs] ∧
      lower = .var tmp := by
  simp [Expr.lower1?, Expr.lower?] at hLower
  cases hUnsupported : ObjectBuiltin.unsupported? functionName with
  | true =>
      simp [hUnsupported] at hLower
  | false =>
      simp [hUnsupported] at hLower
      cases hDirect : Expr.List.directCallArgsSafe? args with
      | false =>
          cases hArgs : Expr.List.lowerBound1? state args with
          | none =>
              simp [hDirect, hArgs] at hLower
          | some lowered =>
              rcases lowered with ⟨preArgs, lowerArgs, stateArgs⟩
              cases hFresh : Fresh.fresh? stateArgs with
              | none =>
                  simp [hDirect, hArgs, hFresh] at hLower
              | some freshResult =>
                  rcases freshResult with ⟨tmp, stateFresh⟩
                  have hTuple :
                      (preArgs ++
                          [Functions.Stmt.let_ tmp (.lit Expr.zero),
                            Functions.Stmt.call [tmp] functionName lowerArgs],
                        (.var tmp : Locals.Expr 1), stateFresh) =
                        (pre, lower, state') := by
                    have hCastTmp :
                        ∀ h : 1 = 1,
                          Expr.cast h (.var tmp) =
                            (.var tmp : Locals.Expr 1) := by
                      intro h
                      cases h
                      rfl
                    simpa [hDirect, hArgs, hFresh, hCastTmp] using hLower
                  cases hTuple
                  exact
                    ⟨preArgs, lowerArgs, stateArgs, tmp, rfl,
                      Or.inr ⟨rfl, rfl⟩, hFresh, rfl, rfl⟩
      | true =>
          cases hArgs : Expr.List.toLocals1? args with
          | none =>
              simp [hDirect, hArgs] at hLower
          | some lowerArgs =>
              cases hFresh : Fresh.fresh? state with
              | none =>
                  simp [hDirect, hArgs, hFresh] at hLower
              | some freshResult =>
                  rcases freshResult with ⟨tmp, stateFresh⟩
                  have hTuple :
                      ([Functions.Stmt.let_ tmp (.lit Expr.zero),
                          Functions.Stmt.call [tmp] functionName lowerArgs],
                        (.var tmp : Locals.Expr 1), stateFresh) =
                        (pre, lower, state') := by
                    have hCastTmp :
                        ∀ h : 1 = 1,
                          Expr.cast h (.var tmp) =
                            (.var tmp : Locals.Expr 1) := by
                      intro h
                      cases h
                      rfl
                    simpa [hDirect, hArgs, hFresh, hCastTmp] using hLower
                  cases hTuple
                  exact
                    ⟨[], lowerArgs, state, tmp, rfl,
                      Or.inl ⟨rfl, rfl, rfl, rfl⟩, hFresh, rfl, rfl⟩

theorem lowerBound1?_lowerArg_names_mem_final_used
    {state state' : Fresh.State} {args : List AstExpr}
    {pre : List Functions.Stmt} {lowerArgs : List (Locals.Expr 1)}
    {names : List Name}
    (hLower :
      Expr.List.lowerBound1? state args = some (pre, lowerArgs, state'))
    (hNames :
      lowerArgs = names.map (fun name => (.var name : Locals.Expr 1))) :
    ∀ name, name ∈ names → name ∈ state'.used := by
  have hLowering := Expr.List.boundLowering_of_lowerBound1? hLower
  induction hLowering generalizing names with
  | nil =>
      intro name hMem
      cases names with
      | nil =>
          simp at hMem
      | cons _head _rest =>
          simp at hNames
  | @cons stateRest stateHead stateFresh expr rest preRest preHead lowerRest
      lowerHead tmp hRest hHead hFresh ih =>
      cases names with
      | nil =>
          simp at hNames
      | cons first restNames =>
          simp at hNames
          rcases hNames with ⟨hFirst, hRestNames⟩
          subst first
          intro name hMem
          simp at hMem
          cases hMem with
          | inl hEq =>
              subst name
              simp [fresh?_state_used hFresh]
          | inr hMemRest =>
              have hNameInRestState : name ∈ stateRest.used :=
                ih (Expr.List.BoundLowering.to_lowerBound1? hRest)
                  hRestNames name hMemRest
              have hCoversRest :
                  FreshCoversLayout stateRest.used stateRest := by
                intro other hOther
                exact hOther
              have hCoversHead :
                  FreshCoversLayout stateRest.used stateHead :=
                freshCoversLayout_lower1?_of_some hCoversRest hHead
              have hCoversFresh :
                  FreshCoversLayout stateRest.used stateFresh :=
                freshCoversLayout_fresh? hCoversHead hFresh
              exact hCoversFresh name hNameInRestState

theorem SourceVarsContains.insertMany_preserves {layout names : List Name}
    {values : List Word} {vars vars' : Locals.Source.Store}
    (hInsert :
      Functions.Source.Store.insertMany names values vars = some vars')
    (hContains : SourceVarsContains layout vars) :
    SourceVarsContains layout vars' := by
  induction names generalizing values vars with
  | nil =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.insertMany] at hInsert
          cases hInsert
          exact hContains
      | cons value values =>
          simp [Functions.Source.Store.insertMany] at hInsert
  | cons name rest ih =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.insertMany] at hInsert
      | cons value values =>
          unfold Functions.Source.Store.insertMany at hInsert
          exact ih hInsert (SourceVarsContains.insert hContains)

theorem SourceVarsContains.initReturns_preserves {layout names : List Name}
    {vars : Locals.Source.Store}
    (hContains : SourceVarsContains layout vars) :
    SourceVarsContains layout
      (Functions.Source.Store.initReturns names vars) := by
  induction names generalizing vars with
  | nil =>
      simpa [Functions.Source.Store.initReturns] using hContains
  | cons name rest ih =>
      unfold Functions.Source.Store.initReturns
      exact ih (SourceVarsContains.insert hContains)

theorem SourceVarsContains.insert_self {vars : Locals.Source.Store}
    {name : Name} {value : Word} :
    SourceVarsContains [name]
      (Locals.Source.Store.insert vars name value) := by
  intro query hMem
  simp only [List.mem_singleton] at hMem
  subst query
  simp [Locals.Source.Store.contains, Locals.Source.Store.insert_self]

theorem SourceVarsContains.initReturns_self {names : List Name}
    {vars : Locals.Source.Store} :
    SourceVarsContains names
      (Functions.Source.Store.initReturns names vars) := by
  induction names generalizing vars with
  | nil =>
      intro name hMem
      simp at hMem
  | cons head rest ih =>
      intro query hMem
      unfold Functions.Source.Store.initReturns
      simp only [List.mem_cons] at hMem
      rcases hMem with hEq | hRest
      · subst query
        have hHead :
            SourceVarsContains [head]
              (Locals.Source.Store.insert vars head Functions.Source.zero) :=
          SourceVarsContains.insert_self
        have hPreserved :=
          SourceVarsContains.initReturns_preserves
            (layout := [head]) (names := rest) hHead
        exact hPreserved head (by simp)
      · exact ih (vars := Locals.Source.Store.insert vars head
          Functions.Source.zero) query hRest

theorem SourceVarsContains.assignMany_preserves {layout names : List Name}
    {values : List Word} {vars vars' : Locals.Source.Store}
    (hAssign :
      Functions.Source.Store.assignMany names values vars = some vars')
    (hContains : SourceVarsContains layout vars) :
    SourceVarsContains layout vars' := by
  induction names generalizing values vars with
  | nil =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.assignMany] at hAssign
          cases hAssign
          exact hContains
      | cons value values =>
          simp [Functions.Source.Store.assignMany] at hAssign
  | cons name rest ih =>
      cases values with
      | nil =>
          simp [Functions.Source.Store.assignMany] at hAssign
      | cons value values =>
          unfold Functions.Source.Store.assignMany at hAssign
          cases hNameContains : vars.contains name with
          | false =>
              simp [hNameContains] at hAssign
          | true =>
              simp [hNameContains] at hAssign
              exact ih hAssign (SourceVarsContains.insert hContains)

def SourceOutcomeNonHaltVarsContains (layout : List Name)
    (outcome : Functions.Source.Outcome) : Prop :=
  match outcome.mode with
  | .halt _ => True
  | _ => SourceVarsContains layout outcome.state.vars

def SourceCtxKeepsLayout (layout : List Name)
    (ctx : Functions.Source.Ctx) : Prop :=
  (∀ name : Name, name ∈ layout → name ∈ ctx.scope) ∧
  (∀ scope : List Name, ctx.breakScope? = some scope →
    ∀ name : Name, name ∈ layout → name ∈ scope) ∧
  (∀ scope : List Name, ctx.continueScope? = some scope →
    ∀ name : Name, name ∈ layout → name ∈ scope) ∧
  (∀ scope : List Name, ctx.leaveScope? = some scope →
    ∀ name : Name, name ∈ layout → name ∈ scope)

namespace SourceCtxKeepsLayout

theorem scope {layout : List Name} {ctx : Functions.Source.Ctx}
    (hCtx : SourceCtxKeepsLayout layout ctx) :
    ∀ name : Name, name ∈ layout → name ∈ ctx.scope :=
  hCtx.1

theorem cons_scope {layout : List Name} {ctx : Functions.Source.Ctx}
    {name : Name}
    (hCtx : SourceCtxKeepsLayout layout ctx) :
    SourceCtxKeepsLayout layout { ctx with scope := name :: ctx.scope } := by
  refine ⟨?_, hCtx.2.1, hCtx.2.2.1, hCtx.2.2.2⟩
  intro candidate hMem
  exact List.mem_cons_of_mem name (hCtx.1 candidate hMem)

theorem withoutLoopControl {layout : List Name}
    {ctx : Functions.Source.Ctx}
    (hCtx : SourceCtxKeepsLayout layout ctx) :
    SourceCtxKeepsLayout layout
      (Functions.Source.Ctx.withoutLoopControl ctx) := by
  refine ⟨hCtx.1, ?_, ?_, hCtx.2.2.2⟩
  · intro scope hScope
    simp [Functions.Source.Ctx.withoutLoopControl] at hScope
  · intro scope hScope
    simp [Functions.Source.Ctx.withoutLoopControl] at hScope

theorem withLoopControl {layout breakScope continueScope : List Name}
    {ctx : Functions.Source.Ctx}
    (hCtx : SourceCtxKeepsLayout layout ctx)
    (hBreak : ∀ name : Name, name ∈ layout → name ∈ breakScope)
    (hContinue : ∀ name : Name, name ∈ layout → name ∈ continueScope) :
    SourceCtxKeepsLayout layout
      (Functions.Source.Ctx.withLoopControl ctx breakScope continueScope) := by
  refine ⟨hCtx.1, ?_, ?_, hCtx.2.2.2⟩
  · intro scope hScope
    simp [Functions.Source.Ctx.withLoopControl] at hScope
    cases hScope
    exact hBreak
  · intro scope hScope
    simp [Functions.Source.Ctx.withLoopControl] at hScope
    cases hScope
    exact hContinue

theorem bodyCtx_returns_params {returns params : List Name} :
    SourceCtxKeepsLayout returns
      ({ Functions.Source.Ctx.initial.withLeaveScope (returns ++ params) with
        scope := returns ++ params }) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro name hMem
    exact List.mem_append_left params hMem
  · intro scope hScope
    simp [Functions.Source.Ctx.initial,
      Functions.Source.Ctx.withLeaveScope] at hScope
  · intro scope hScope
    simp [Functions.Source.Ctx.initial,
      Functions.Source.Ctx.withLeaveScope] at hScope
  · intro scope hScope
    simp [Functions.Source.Ctx.initial,
      Functions.Source.Ctx.withLeaveScope] at hScope
    cases hScope
    intro name hMem
    exact List.mem_append_left params hMem

end SourceCtxKeepsLayout

theorem SourceOutcomeNonHaltVarsContains.regular
    {layout : List Name} {state : Objects.Source.State}
    (hContains : SourceVarsContains layout state.vars) :
    SourceOutcomeNonHaltVarsContains layout
      (Functions.Source.Outcome.regular state) := by
  simpa [SourceOutcomeNonHaltVarsContains,
    Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]
    using hContains

theorem SourceOutcomeNonHaltVarsContains.brk
    {layout : List Name} {state : Objects.Source.State}
    (hContains : SourceVarsContains layout state.vars) :
    SourceOutcomeNonHaltVarsContains layout
      (Functions.Source.Outcome.brk state) := by
  simpa [SourceOutcomeNonHaltVarsContains,
    Functions.Source.Outcome.brk, Locals.Source.Outcome.brk]
    using hContains

theorem SourceOutcomeNonHaltVarsContains.cont
    {layout : List Name} {state : Objects.Source.State}
    (hContains : SourceVarsContains layout state.vars) :
    SourceOutcomeNonHaltVarsContains layout
      (Functions.Source.Outcome.cont state) := by
  simpa [SourceOutcomeNonHaltVarsContains,
    Functions.Source.Outcome.cont, Locals.Source.Outcome.cont]
    using hContains

theorem SourceOutcomeNonHaltVarsContains.leave
    {layout : List Name} {state : Objects.Source.State}
    (hContains : SourceVarsContains layout state.vars) :
    SourceOutcomeNonHaltVarsContains layout
      (Functions.Source.Outcome.leave state) := by
  simpa [SourceOutcomeNonHaltVarsContains,
    Functions.Source.Outcome.leave, Locals.Source.Outcome.leave]
    using hContains

theorem SourceOutcomeNonHaltVarsContains.halt
    {layout : List Name} {state : Objects.Source.State}
    {kind : Assembly.HaltKind} :
    SourceOutcomeNonHaltVarsContains layout
      (Functions.Source.Outcome.halt kind state) := by
  simp [SourceOutcomeNonHaltVarsContains, Functions.Source.Outcome.halt,
    Locals.Source.Outcome.halt]

theorem SourceVarsContains.of_evalCondition {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {expr : Locals.Expr 1}
    {state stateAfter : Objects.Source.State} {value : Bool}
    (hContains : SourceVarsContains layout state.vars)
    (hEval :
      Locals.Source.Expr.evalCondition prim expr state =
        .ok (stateAfter, value)) :
    SourceVarsContains layout stateAfter.vars := by
  unfold Locals.Source.Expr.evalCondition at hEval
  cases hEvalOne :
      Locals.Source.Expr.evalOne prim expr state with
  | error err =>
      simp [hEvalOne] at hEval
  | ok pair =>
      rcases pair with ⟨stateAfterOne, word⟩
      simp [hEvalOne] at hEval
      rcases hEval with ⟨hState, _hValue⟩
      subst stateAfterOne
      exact SourceVarsContains.of_evalOne hContains hEvalOne

set_option maxHeartbeats 1000000 in
theorem SourceOutcomeNonHaltVarsContains.source_runs :
    (∀ {layout : List Name}
      {prim : Objects.Source.PrimitiveSemantics}
      {program : Functions.Program} {ctx : Functions.Source.Ctx}
      {fuel : Nat} {block : Functions.Block}
      {state : Objects.Source.State}
      {outcome : Functions.Source.Outcome}
      {ctxAfter : Functions.Source.Ctx},
      SourceCtxKeepsLayout layout ctx →
      SourceVarsContains layout state.vars →
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (outcome, ctxAfter) →
      SourceOutcomeNonHaltVarsContains layout outcome ∧
        (outcome.mode = .regular →
          SourceCtxKeepsLayout layout ctxAfter)) ∧
    (∀ {layout : List Name}
      {prim : Objects.Source.PrimitiveSemantics}
      {program : Functions.Program} {ctx : Functions.Source.Ctx}
      {fuel : Nat} {block : Functions.Block}
      {state : Objects.Source.State}
      {outcome : Functions.Source.Outcome},
      SourceCtxKeepsLayout layout ctx →
      SourceVarsContains layout state.vars →
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome →
      SourceOutcomeNonHaltVarsContains layout outcome) ∧
    (∀ {layout : List Name}
      {prim : Objects.Source.PrimitiveSemantics}
      {program : Functions.Program}
      {loopCtx postBase bodyBase : Functions.Source.Ctx}
      {cond : Locals.Expr 1} {post body : Functions.Block}
      {fuel : Nat} {state : Objects.Source.State}
      {outcome : Functions.Source.Outcome},
      SourceCtxKeepsLayout layout loopCtx →
      SourceCtxKeepsLayout layout postBase →
      SourceCtxKeepsLayout layout bodyBase →
      SourceVarsContains layout state.vars →
      Functions.Source.Stmt.runForLoop prim program loopCtx cond postBase
          post bodyBase body fuel state =
        .ok outcome →
      SourceOutcomeNonHaltVarsContains layout outcome) ∧
    (∀ {layout : List Name}
      {prim : Objects.Source.PrimitiveSemantics}
      {program : Functions.Program} {ctx : Functions.Source.Ctx}
      {fuel : Nat} {stmt : Functions.Stmt}
      {state : Objects.Source.State}
      {outcome : Functions.Source.Outcome}
      {ctxAfter : Functions.Source.Ctx},
      SourceCtxKeepsLayout layout ctx →
      SourceVarsContains layout state.vars →
      Functions.Source.Stmt.run prim program ctx fuel stmt state =
        .ok (outcome, ctxAfter) →
      SourceOutcomeNonHaltVarsContains layout outcome ∧
        (outcome.mode = .regular →
          SourceCtxKeepsLayout layout ctxAfter)) := by
  suffices hFuel :
      ∀ fuel,
        (∀ {layout : List Name}
          {prim : Objects.Source.PrimitiveSemantics}
          {program : Functions.Program} {ctx : Functions.Source.Ctx}
          {block : Functions.Block} {state : Objects.Source.State}
          {outcome : Functions.Source.Outcome}
          {ctxAfter : Functions.Source.Ctx},
          SourceCtxKeepsLayout layout ctx →
          SourceVarsContains layout state.vars →
          Functions.Source.Block.runOpen prim program ctx fuel block state =
            .ok (outcome, ctxAfter) →
          SourceOutcomeNonHaltVarsContains layout outcome ∧
            (outcome.mode = .regular →
              SourceCtxKeepsLayout layout ctxAfter)) ∧
        (∀ {layout : List Name}
          {prim : Objects.Source.PrimitiveSemantics}
          {program : Functions.Program} {ctx : Functions.Source.Ctx}
          {block : Functions.Block} {state : Objects.Source.State}
          {outcome : Functions.Source.Outcome},
          SourceCtxKeepsLayout layout ctx →
          SourceVarsContains layout state.vars →
          Functions.Source.Block.runScoped prim program ctx block fuel state =
            .ok outcome →
          SourceOutcomeNonHaltVarsContains layout outcome) ∧
        (∀ {layout : List Name}
          {prim : Objects.Source.PrimitiveSemantics}
          {program : Functions.Program}
          {loopCtx postBase bodyBase : Functions.Source.Ctx}
          {cond : Locals.Expr 1} {post body : Functions.Block}
          {state : Objects.Source.State}
          {outcome : Functions.Source.Outcome},
          SourceCtxKeepsLayout layout loopCtx →
          SourceCtxKeepsLayout layout postBase →
          SourceCtxKeepsLayout layout bodyBase →
          SourceVarsContains layout state.vars →
          Functions.Source.Stmt.runForLoop prim program loopCtx cond postBase
              post bodyBase body fuel state =
            .ok outcome →
          SourceOutcomeNonHaltVarsContains layout outcome) ∧
        (∀ {layout : List Name}
          {prim : Objects.Source.PrimitiveSemantics}
          {program : Functions.Program} {ctx : Functions.Source.Ctx}
          {stmt : Functions.Stmt} {state : Objects.Source.State}
          {outcome : Functions.Source.Outcome}
          {ctxAfter : Functions.Source.Ctx},
          SourceCtxKeepsLayout layout ctx →
          SourceVarsContains layout state.vars →
          Functions.Source.Stmt.run prim program ctx fuel stmt state =
            .ok (outcome, ctxAfter) →
          SourceOutcomeNonHaltVarsContains layout outcome ∧
            (outcome.mode = .regular →
              SourceCtxKeepsLayout layout ctxAfter)) by
    exact ⟨fun hCtx hVars hRun => (hFuel _).1 hCtx hVars hRun,
      ⟨fun hCtx hVars hRun => (hFuel _).2.1 hCtx hVars hRun,
       ⟨fun hLoop hPost hBody hVars hRun =>
          (hFuel _).2.2.1 hLoop hPost hBody hVars hRun,
        fun hCtx hVars hRun => (hFuel _).2.2.2 hCtx hVars hRun⟩⟩⟩
  intro fuel
  refine Nat.strong_induction_on fuel ?_
  intro fuel ih
  cases fuel with
  | zero =>
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro layout prim program ctx block state outcome ctxAfter hCtx hVars hRun
        cases block with
        | mk stmts =>
            cases stmts <;>
              simp [Functions.Source.Block.runOpen,
                Functions.Source.invalid, Structured.invalid] at hRun
      · intro layout prim program ctx block state outcome hCtx hVars hRun
        unfold Functions.Source.Block.runScoped at hRun
        cases hOpen :
            Functions.Source.Block.runOpen prim program ctx 0 block state with
        | error err =>
            simp [hOpen] at hRun
        | ok pair =>
            rcases pair with ⟨openOutcome, ctxAfter⟩
            have hFalse : False := by
              cases block with
              | mk stmts =>
                  cases stmts <;>
                    simp [Functions.Source.Block.runOpen,
                      Functions.Source.invalid, Structured.invalid] at hOpen
            exact False.elim hFalse
      · intro layout prim program loopCtx postBase bodyBase cond post body state
          outcome hLoopCtx hPostCtx hBodyCtx hVars hRun
        simp [Functions.Source.Stmt.runForLoop, Functions.Source.invalid,
          Structured.invalid] at hRun
      · intro layout prim program ctx stmt state outcome ctxAfter hCtx hVars hRun
        cases stmt with
        | expr expr =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hEval : Locals.Source.Expr.eval prim expr state with
            | error err =>
                simp [hEval] at hRun
            | ok pair =>
                rcases pair with ⟨stateAfter, values⟩
                simp [hEval] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                exact ⟨
                  SourceOutcomeNonHaltVarsContains.regular
                    (SourceVarsContains.of_eval hVars hEval),
                  by intro _; exact hCtx⟩
        | let_ name value =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hEval :
                Locals.Source.Expr.evalOne prim value state with
            | error err =>
                simp [hEval] at hRun
            | ok pair =>
                rcases pair with ⟨stateAfter, value'⟩
                simp [hEval] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hAfter :=
                  SourceVarsContains.of_evalOne hVars hEval
                exact ⟨
                  SourceOutcomeNonHaltVarsContains.regular
                    (SourceVarsContains.insert hAfter),
                  by
                    intro _h
                    exact SourceCtxKeepsLayout.cons_scope hCtx⟩
        | assign name value =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hContainsName : state.vars.contains name with
            | false =>
                simp [hContainsName, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | true =>
                simp [hContainsName] at hRun
                cases hEval :
                    Locals.Source.Expr.evalOne prim value state with
                | error err =>
                    simp [hEval] at hRun
                | ok pair =>
                    rcases pair with ⟨stateAfter, value'⟩
                    simp [hEval] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    have hAfter :=
                      SourceVarsContains.of_evalOne hVars hEval
                    exact ⟨
                      SourceOutcomeNonHaltVarsContains.regular
                        (SourceVarsContains.insert hAfter),
                      by intro _; exact hCtx⟩
        | block body =>
            simp [Functions.Source.Stmt.run, Functions.Source.Block.runScoped,
              Functions.Source.Block.runOpen, Functions.Source.invalid,
              Structured.invalid] at hRun
        | if_ cond body =>
            simp [Functions.Source.Stmt.run, Functions.Source.invalid,
              Structured.invalid] at hRun
        | switch scrutinee cases defaultBody =>
            simp [Functions.Source.Stmt.run, Functions.Source.invalid,
              Structured.invalid] at hRun
        | for_ init cond post body =>
            simp [Functions.Source.Stmt.run, Functions.Source.invalid,
              Structured.invalid] at hRun
        | brk =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hScope : ctx.breakScope? with
            | none =>
                simp [hScope, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | some scope =>
                simp [hScope] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hScopeMem := hCtx.2.1 scope hScope
                exact ⟨SourceOutcomeNonHaltVarsContains.brk
                  (SourceVarsContains.restrictTo hVars hScopeMem),
                  by intro h; cases h⟩
        | cont =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hScope : ctx.continueScope? with
            | none =>
                simp [hScope, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | some scope =>
                simp [hScope] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hScopeMem := hCtx.2.2.1 scope hScope
                exact ⟨SourceOutcomeNonHaltVarsContains.cont
                  (SourceVarsContains.restrictTo hVars hScopeMem),
                  by intro h; cases h⟩
        | leave =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hScope : ctx.leaveScope? with
            | none =>
                simp [hScope, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | some scope =>
                simp [hScope] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hScopeMem := hCtx.2.2.2 scope hScope
                exact ⟨SourceOutcomeNonHaltVarsContains.leave
                  (SourceVarsContains.restrictTo hVars hScopeMem),
                  by intro h; cases h⟩
        | call targets functionName args =>
            simp [Functions.Source.Stmt.run, Functions.Source.invalid,
              Structured.invalid] at hRun
        | terminal kind =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hTerminal : prim.terminal kind state.shared [] with
            | error err =>
                simp [hTerminal] at hRun
            | ok sharedAfter =>
                simp [hTerminal] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                exact ⟨SourceOutcomeNonHaltVarsContains.halt,
                  by intro h; cases h⟩
        | terminalArgs kind args =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hArgs :
                Locals.Source.Expr.ExprSeq.eval prim args state with
            | error err =>
                simp [hArgs] at hRun
            | ok argPair =>
                rcases argPair with ⟨stateAfterArgs, values⟩
                simp [hArgs] at hRun
                cases hTerminal :
                    prim.terminal kind stateAfterArgs.shared values with
                | error err =>
                    simp [hTerminal] at hRun
                | ok sharedAfter =>
                    simp [hTerminal] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    exact ⟨SourceOutcomeNonHaltVarsContains.halt,
                      by intro h; cases h⟩
  | succ fuelPred =>
      have ihPred := ih fuelPred (Nat.lt_succ_self fuelPred)
      have hRunOpenSucc :
          ∀ {layout : List Name}
            {prim : Objects.Source.PrimitiveSemantics}
            {program : Functions.Program} {ctx : Functions.Source.Ctx}
            {block : Functions.Block} {state : Objects.Source.State}
            {outcome : Functions.Source.Outcome}
            {ctxAfter : Functions.Source.Ctx},
            SourceCtxKeepsLayout layout ctx →
            SourceVarsContains layout state.vars →
            Functions.Source.Block.runOpen prim program ctx fuelPred.succ
              block state = .ok (outcome, ctxAfter) →
            SourceOutcomeNonHaltVarsContains layout outcome ∧
              (outcome.mode = .regular →
                SourceCtxKeepsLayout layout ctxAfter) := by
        intro layout prim program ctx block state outcome ctxAfter hCtx hVars
          hRun
        cases block with
        | mk stmts =>
            cases stmts with
            | nil =>
                simp [Functions.Source.Block.runOpen] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                exact ⟨SourceOutcomeNonHaltVarsContains.regular hVars,
                  by intro _; exact hCtx⟩
            | cons stmt rest =>
                unfold Functions.Source.Block.runOpen at hRun
                cases hStmt :
                    Functions.Source.Stmt.run prim program ctx fuelPred stmt
                      state with
                | error err =>
                    simp [hStmt] at hRun
                | ok stmtPair =>
                    rcases stmtPair with ⟨stmtOutcome, stmtCtx⟩
                    simp [hStmt] at hRun
                    have hStmtInfo :=
                      (ihPred.2.2.2 hCtx hVars hStmt)
                    cases hMode : stmtOutcome.mode with
                    | regular =>
                        simp [hMode] at hRun
                        have hStmtCtx : SourceCtxKeepsLayout layout stmtCtx :=
                          hStmtInfo.2 hMode
                        have hStmtVars :
                            SourceVarsContains layout stmtOutcome.state.vars := by
                          simpa [SourceOutcomeNonHaltVarsContains, hMode]
                            using hStmtInfo.1
                        exact ihPred.1 hStmtCtx hStmtVars hRun
                    | brk =>
                        simp [hMode] at hRun
                        rcases hRun with ⟨hOutcome, hCtxAfter⟩
                        subst outcome
                        subst ctxAfter
                        exact ⟨hStmtInfo.1, by
                          intro hRegular
                          cases (hRegular.symm.trans hMode)⟩
                    | cont =>
                        simp [hMode] at hRun
                        rcases hRun with ⟨hOutcome, hCtxAfter⟩
                        subst outcome
                        subst ctxAfter
                        exact ⟨hStmtInfo.1, by
                          intro hRegular
                          cases (hRegular.symm.trans hMode)⟩
                    | leave =>
                        simp [hMode] at hRun
                        rcases hRun with ⟨hOutcome, hCtxAfter⟩
                        subst outcome
                        subst ctxAfter
                        exact ⟨hStmtInfo.1, by
                          intro hRegular
                          cases (hRegular.symm.trans hMode)⟩
                    | halt kind =>
                        simp [hMode] at hRun
                        rcases hRun with ⟨hOutcome, hCtxAfter⟩
                        subst outcome
                        subst ctxAfter
                        exact ⟨hStmtInfo.1, by
                          intro hRegular
                          cases (hRegular.symm.trans hMode)⟩
      have hRunScopedSucc :
          ∀ {layout : List Name}
            {prim : Objects.Source.PrimitiveSemantics}
            {program : Functions.Program} {ctx : Functions.Source.Ctx}
            {block : Functions.Block} {state : Objects.Source.State}
            {outcome : Functions.Source.Outcome},
            SourceCtxKeepsLayout layout ctx →
            SourceVarsContains layout state.vars →
            Functions.Source.Block.runScoped prim program ctx block
              fuelPred.succ state = .ok outcome →
            SourceOutcomeNonHaltVarsContains layout outcome := by
        intro layout prim program ctx block state outcome hCtx hVars hRun
        unfold Functions.Source.Block.runScoped at hRun
        cases hOpen :
            Functions.Source.Block.runOpen prim program ctx fuelPred.succ
              block state with
        | error err =>
            simp [hOpen] at hRun
        | ok openPair =>
            rcases openPair with ⟨openOutcome, openCtx⟩
            have hOpenInfo := (hRunOpenSucc hCtx hVars hOpen)
            cases hMode : openOutcome.mode with
            | regular =>
                simp [hOpen, hMode] at hRun
                subst outcome
                have hOpenVars :
                    SourceVarsContains layout openOutcome.state.vars := by
                  simpa [SourceOutcomeNonHaltVarsContains, hMode]
                    using hOpenInfo.1
                exact
                  SourceOutcomeNonHaltVarsContains.regular
                    (SourceVarsContains.restrictTo hOpenVars hCtx.1)
            | brk =>
                simp [hOpen, hMode] at hRun
                subst outcome
                simpa [SourceOutcomeNonHaltVarsContains, hMode]
                  using hOpenInfo.1
            | cont =>
                simp [hOpen, hMode] at hRun
                subst outcome
                simpa [SourceOutcomeNonHaltVarsContains, hMode]
                  using hOpenInfo.1
            | leave =>
                simp [hOpen, hMode] at hRun
                subst outcome
                simpa [SourceOutcomeNonHaltVarsContains, hMode]
                  using hOpenInfo.1
            | halt kind =>
                simp [hOpen, hMode] at hRun
                subst outcome
                simpa [SourceOutcomeNonHaltVarsContains, hMode]
                  using hOpenInfo.1
      refine ⟨hRunOpenSucc, hRunScopedSucc, ?_, ?_⟩
      · intro layout prim program loopCtx postBase bodyBase cond post body state
          outcome hLoopCtx hPostCtx hBodyCtx hVars hRun
        unfold Functions.Source.Stmt.runForLoop at hRun
        cases hCond :
            Locals.Source.Expr.evalCondition prim cond state with
        | error err =>
            simp [hCond] at hRun
        | ok condPair =>
            rcases condPair with ⟨stateAfterCond, condTrue⟩
            simp [hCond] at hRun
            have hCondVars :
                SourceVarsContains layout stateAfterCond.vars :=
              SourceVarsContains.of_evalCondition hVars hCond
            cases condTrue with
            | false =>
                simp at hRun
                subst outcome
                exact
                  SourceOutcomeNonHaltVarsContains.regular
                    (SourceVarsContains.restrictTo hCondVars hLoopCtx.1)
            | true =>
                simp at hRun
                cases hBodyRun :
                    Functions.Source.Block.runScoped prim program bodyBase body
                      fuelPred stateAfterCond with
                | error err =>
                    simp [hBodyRun] at hRun
                | ok bodyOutcome =>
                    simp [hBodyRun] at hRun
                    have hBodyContains :=
                      ihPred.2.1 hBodyCtx hCondVars hBodyRun
                    cases hBodyMode : bodyOutcome.mode with
                    | brk =>
                        simp [hBodyMode] at hRun
                        subst outcome
                        simpa [SourceOutcomeNonHaltVarsContains, hBodyMode]
                          using hBodyContains
                    | regular =>
                        simp [hBodyMode] at hRun
                        have hBodyVars :
                            SourceVarsContains layout bodyOutcome.state.vars := by
                          simpa [SourceOutcomeNonHaltVarsContains, hBodyMode]
                            using hBodyContains
                        cases hPostRun :
                            Functions.Source.Block.runScoped prim program
                              postBase post fuelPred bodyOutcome.state with
                        | error err =>
                            simp [hPostRun] at hRun
                        | ok postOutcome =>
                            simp [hPostRun] at hRun
                            have hPostContains :=
                              ihPred.2.1 hPostCtx hBodyVars hPostRun
                            cases hPostMode : postOutcome.mode with
                            | regular =>
                                simp [hPostMode] at hRun
                                have hPostVars :
                                    SourceVarsContains layout
                                      postOutcome.state.vars := by
                                  simpa [SourceOutcomeNonHaltVarsContains,
                                    hPostMode] using hPostContains
                                exact
                                  ihPred.2.2.1 hLoopCtx hPostCtx hBodyCtx
                                    hPostVars hRun
                            | brk =>
                                simp [hPostMode, Functions.Source.invalid,
                                  Structured.invalid] at hRun
                            | cont =>
                                simp [hPostMode, Functions.Source.invalid,
                                  Structured.invalid] at hRun
                            | leave =>
                                simp [hPostMode] at hRun
                                subst outcome
                                simpa [SourceOutcomeNonHaltVarsContains,
                                  hPostMode] using hPostContains
                            | halt kind =>
                                simp [hPostMode] at hRun
                                subst outcome
                                simpa [SourceOutcomeNonHaltVarsContains,
                                  hPostMode] using hPostContains
                    | cont =>
                        simp [hBodyMode] at hRun
                        have hBodyVars :
                            SourceVarsContains layout bodyOutcome.state.vars := by
                          simpa [SourceOutcomeNonHaltVarsContains, hBodyMode]
                            using hBodyContains
                        cases hPostRun :
                            Functions.Source.Block.runScoped prim program
                              postBase post fuelPred bodyOutcome.state with
                        | error err =>
                            simp [hPostRun] at hRun
                        | ok postOutcome =>
                            simp [hPostRun] at hRun
                            have hPostContains :=
                              ihPred.2.1 hPostCtx hBodyVars hPostRun
                            cases hPostMode : postOutcome.mode with
                            | regular =>
                                simp [hPostMode] at hRun
                                have hPostVars :
                                    SourceVarsContains layout
                                      postOutcome.state.vars := by
                                  simpa [SourceOutcomeNonHaltVarsContains,
                                    hPostMode] using hPostContains
                                exact
                                  ihPred.2.2.1 hLoopCtx hPostCtx hBodyCtx
                                    hPostVars hRun
                            | brk =>
                                simp [hPostMode, Functions.Source.invalid,
                                  Structured.invalid] at hRun
                            | cont =>
                                simp [hPostMode, Functions.Source.invalid,
                                  Structured.invalid] at hRun
                            | leave =>
                                simp [hPostMode] at hRun
                                subst outcome
                                simpa [SourceOutcomeNonHaltVarsContains,
                                  hPostMode] using hPostContains
                            | halt kind =>
                                simp [hPostMode] at hRun
                                subst outcome
                                simpa [SourceOutcomeNonHaltVarsContains,
                                  hPostMode] using hPostContains
                    | leave =>
                        simp [hBodyMode] at hRun
                        subst outcome
                        simpa [SourceOutcomeNonHaltVarsContains, hBodyMode]
                          using hBodyContains
                    | halt kind =>
                        simp [hBodyMode] at hRun
                        subst outcome
                        simpa [SourceOutcomeNonHaltVarsContains, hBodyMode]
                          using hBodyContains
      · intro layout prim program ctx stmt state outcome ctxAfter hCtx hVars
          hRun
        cases stmt with
        | expr expr =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hEval : Locals.Source.Expr.eval prim expr state with
            | error err =>
                simp [hEval] at hRun
            | ok pair =>
                rcases pair with ⟨stateAfter, values⟩
                simp [hEval] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                exact ⟨
                  SourceOutcomeNonHaltVarsContains.regular
                    (SourceVarsContains.of_eval hVars hEval),
                  by intro _; exact hCtx⟩
        | let_ name value =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hEval :
                Locals.Source.Expr.evalOne prim value state with
            | error err =>
                simp [hEval] at hRun
            | ok pair =>
                rcases pair with ⟨stateAfter, value'⟩
                simp [hEval] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hAfter :=
                  SourceVarsContains.of_evalOne hVars hEval
                exact ⟨
                  SourceOutcomeNonHaltVarsContains.regular
                    (SourceVarsContains.insert hAfter),
                  by
                    intro _h
                    exact SourceCtxKeepsLayout.cons_scope hCtx⟩
        | assign name value =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hContainsName : state.vars.contains name with
            | false =>
                simp [hContainsName, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | true =>
                simp [hContainsName] at hRun
                cases hEval :
                    Locals.Source.Expr.evalOne prim value state with
                | error err =>
                    simp [hEval] at hRun
                | ok pair =>
                    rcases pair with ⟨stateAfter, value'⟩
                    simp [hEval] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    have hAfter :=
                      SourceVarsContains.of_evalOne hVars hEval
                    exact ⟨
                      SourceOutcomeNonHaltVarsContains.regular
                        (SourceVarsContains.insert hAfter),
                      by intro _; exact hCtx⟩
        | block body =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hBody :
                Functions.Source.Block.runScoped prim program ctx body fuelPred.succ
                  state with
            | error err =>
                simp [hBody] at hRun
            | ok bodyOutcome =>
                simp [hBody] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                exact ⟨hRunScopedSucc hCtx hVars hBody,
                  by intro _; exact hCtx⟩
        | if_ cond body =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hCond :
                Locals.Source.Expr.evalCondition prim cond state with
            | error err =>
                simp [hCond] at hRun
            | ok condPair =>
                rcases condPair with ⟨stateAfterCond, condTrue⟩
                simp [hCond] at hRun
                have hCondVars :=
                  SourceVarsContains.of_evalCondition hVars hCond
                cases condTrue with
                | false =>
                    simp at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    exact ⟨SourceOutcomeNonHaltVarsContains.regular hCondVars,
                      by intro _; exact hCtx⟩
                | true =>
                    simp at hRun
                    cases hBody :
                        Functions.Source.Block.runScoped prim program ctx body
                          fuelPred stateAfterCond with
                    | error err =>
                        simp [hBody] at hRun
                    | ok bodyOutcome =>
                        simp [hBody] at hRun
                        rcases hRun with ⟨hOutcome, hCtxAfter⟩
                        subst outcome
                        subst ctxAfter
                        exact ⟨ihPred.2.1 hCtx hCondVars hBody,
                          by intro _; exact hCtx⟩
        | switch scrutinee cases defaultBody =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hEval :
                Locals.Source.Expr.evalOne prim scrutinee state with
            | error err =>
                simp [hEval] at hRun
            | ok evalPair =>
                rcases evalPair with ⟨stateAfterScrutinee, value⟩
                simp [hEval] at hRun
                have hScrutineeVars :=
                  SourceVarsContains.of_evalOne hVars hEval
                cases hSelect :
                    Functions.Source.Switch.select value cases defaultBody with
                | none =>
                    simp [hSelect] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    exact ⟨
                      SourceOutcomeNonHaltVarsContains.regular hScrutineeVars,
                      by intro _; exact hCtx⟩
                | some selected =>
                    simp [hSelect] at hRun
                    cases hBody :
                        Functions.Source.Block.runScoped prim program ctx
                          selected fuelPred stateAfterScrutinee with
                    | error err =>
                        simp [hBody] at hRun
                    | ok bodyOutcome =>
                        simp [hBody] at hRun
                        rcases hRun with ⟨hOutcome, hCtxAfter⟩
                        subst outcome
                        subst ctxAfter
                        exact ⟨ihPred.2.1 hCtx hScrutineeVars hBody,
                          by intro _; exact hCtx⟩
        | for_ init cond post body =>
            simp [Functions.Source.Stmt.run] at hRun
            let initBase := Functions.Source.Ctx.withoutLoopControl ctx
            cases hInit :
                Functions.Source.Block.runOpen prim program initBase fuelPred
                  init state with
            | error err =>
                simp [initBase, hInit] at hRun
            | ok initPair =>
                rcases initPair with ⟨initOutcome, initCtx⟩
                simp [initBase, hInit] at hRun
                have hInitBaseCtx :
                    SourceCtxKeepsLayout layout initBase :=
                  SourceCtxKeepsLayout.withoutLoopControl hCtx
                have hInitInfo :=
                  ihPred.1 hInitBaseCtx hVars hInit
                cases hInitMode : initOutcome.mode with
                | regular =>
                    simp [hInitMode] at hRun
                    have hInitCtxKeeps :
                        SourceCtxKeepsLayout layout initCtx :=
                      hInitInfo.2 hInitMode
                    have hInitVars :
                        SourceVarsContains layout initOutcome.state.vars := by
                      simpa [SourceOutcomeNonHaltVarsContains, hInitMode]
                        using hInitInfo.1
                    let loopCtx := initCtx
                    let postBase :=
                      Functions.Source.Ctx.withoutLoopControl initCtx
                    let bodyBase :=
                      Functions.Source.Ctx.withLoopControl initCtx
                        initCtx.scope initCtx.scope
                    have hPostBaseCtx :
                        SourceCtxKeepsLayout layout postBase :=
                      SourceCtxKeepsLayout.withoutLoopControl hInitCtxKeeps
                    have hBodyBaseCtx :
                        SourceCtxKeepsLayout layout bodyBase :=
                      SourceCtxKeepsLayout.withLoopControl hInitCtxKeeps
                        hInitCtxKeeps.1 hInitCtxKeeps.1
                    cases hLoop :
                        Functions.Source.Stmt.runForLoop prim program loopCtx
                          cond postBase post bodyBase body fuelPred
                          initOutcome.state with
                    | error err =>
                        simp [loopCtx, postBase, bodyBase, hLoop] at hRun
                    | ok loopOutcome =>
                        simp [loopCtx, postBase, bodyBase, hLoop] at hRun
                        have hLoopContains :=
                          ihPred.2.2.1 hInitCtxKeeps hPostBaseCtx
                            hBodyBaseCtx hInitVars hLoop
                        cases hLoopMode : loopOutcome.mode with
                        | regular =>
                            simp [hLoopMode] at hRun
                            rcases hRun with ⟨hOutcome, hCtxAfter⟩
                            subst outcome
                            subst ctxAfter
                            have hLoopVars :
                                SourceVarsContains layout
                                  loopOutcome.state.vars := by
                              simpa [SourceOutcomeNonHaltVarsContains,
                                hLoopMode] using hLoopContains
                            exact ⟨
                              SourceOutcomeNonHaltVarsContains.regular
                                (SourceVarsContains.restrictTo hLoopVars
                                  hCtx.1),
                              by intro _; exact hCtx⟩
                        | brk =>
                            simp [hLoopMode, Functions.Source.invalid,
                              Structured.invalid] at hRun
                        | cont =>
                            simp [hLoopMode, Functions.Source.invalid,
                              Structured.invalid] at hRun
                        | leave =>
                            simp [hLoopMode] at hRun
                            rcases hRun with ⟨hOutcome, hCtxAfter⟩
                            subst outcome
                            subst ctxAfter
                            exact ⟨by
                              simpa [SourceOutcomeNonHaltVarsContains,
                                hLoopMode] using hLoopContains,
                              by
                                intro hRegular
                                cases (hRegular.symm.trans hLoopMode)⟩
                        | halt kind =>
                            simp [hLoopMode] at hRun
                            rcases hRun with ⟨hOutcome, hCtxAfter⟩
                            subst outcome
                            subst ctxAfter
                            exact ⟨by
                              simpa [SourceOutcomeNonHaltVarsContains,
                                hLoopMode] using hLoopContains,
                              by
                                intro hRegular
                                cases (hRegular.symm.trans hLoopMode)⟩
                | brk =>
                    simp [hInitMode, Functions.Source.invalid,
                      Structured.invalid] at hRun
                | cont =>
                    simp [hInitMode, Functions.Source.invalid,
                      Structured.invalid] at hRun
                | leave =>
                    simp [hInitMode] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    exact ⟨by
                      simpa [SourceOutcomeNonHaltVarsContains, hInitMode]
                        using hInitInfo.1,
                      by
                        intro hRegular
                        cases (hRegular.symm.trans hInitMode)⟩
                | halt kind =>
                    simp [hInitMode] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    exact ⟨by
                      simpa [SourceOutcomeNonHaltVarsContains, hInitMode]
                        using hInitInfo.1,
                      by
                        intro hRegular
                        cases (hRegular.symm.trans hInitMode)⟩
        | brk =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hScope : ctx.breakScope? with
            | none =>
                simp [hScope, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | some scope =>
                simp [hScope] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hScopeMem := hCtx.2.1 scope hScope
                exact ⟨SourceOutcomeNonHaltVarsContains.brk
                  (SourceVarsContains.restrictTo hVars hScopeMem),
                  by intro h; cases h⟩
        | cont =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hScope : ctx.continueScope? with
            | none =>
                simp [hScope, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | some scope =>
                simp [hScope] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hScopeMem := hCtx.2.2.1 scope hScope
                exact ⟨SourceOutcomeNonHaltVarsContains.cont
                  (SourceVarsContains.restrictTo hVars hScopeMem),
                  by intro h; cases h⟩
        | leave =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hScope : ctx.leaveScope? with
            | none =>
                simp [hScope, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | some scope =>
                simp [hScope] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                have hScopeMem := hCtx.2.2.2 scope hScope
                exact ⟨SourceOutcomeNonHaltVarsContains.leave
                  (SourceVarsContains.restrictTo hVars hScopeMem),
                  by intro h; cases h⟩
        | call targets functionName args =>
            simp [Functions.Source.Stmt.run] at hRun
            by_cases hNodup : targets.Nodup
            ·
                simp [hNodup] at hRun
                cases hArgs :
                    Functions.Source.ArgList.eval prim args state with
                | error err =>
                    simp [hArgs] at hRun
                | ok argPair =>
                    rcases argPair with ⟨stateAfterArgs, argValues⟩
                    simp [hArgs] at hRun
                    have hArgsVars :=
                      SourceVarsContains.of_argList_eval hVars hArgs
                    cases hFind :
                        Functions.FunList.find? functionName
                          program.functions with
                    | none =>
                        simp [hFind, Functions.Source.invalid,
                          Structured.invalid] at hRun
                    | some fn =>
                        simp [hFind] at hRun
                        cases hBody :
                            Functions.Source.FunDef.runBody prim program fn
                              argValues fuelPred stateAfterArgs.shared with
                        | error err =>
                            simp [hBody] at hRun
                        | ok callResult =>
                            simp [hBody] at hRun
                            cases callResult with
                            | returned sharedAfterCall returnValues =>
                                cases hAssign :
                                    Functions.Source.Store.assignMany targets
                                      returnValues stateAfterArgs.vars with
                                | none =>
                                    simp [hAssign, Functions.Source.invalid,
                                      Structured.invalid] at hRun
                                | some returnStore =>
                                    simp [hAssign] at hRun
                                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                                    subst outcome
                                    subst ctxAfter
                                    exact ⟨
                                      SourceOutcomeNonHaltVarsContains.regular
                                        (SourceVarsContains.assignMany_preserves
                                          hAssign hArgsVars),
                                      by intro _; exact hCtx⟩
                            | halted kind haltedState =>
                                cases hRun
                                exact ⟨SourceOutcomeNonHaltVarsContains.halt,
                                  by intro h; cases h⟩
            ·
                simp [hNodup, Functions.Source.invalid,
                  Structured.invalid] at hRun
        | terminal kind =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hTerminal : prim.terminal kind state.shared [] with
            | error err =>
                simp [hTerminal] at hRun
            | ok sharedAfter =>
                simp [hTerminal] at hRun
                rcases hRun with ⟨hOutcome, hCtxAfter⟩
                subst outcome
                subst ctxAfter
                exact ⟨SourceOutcomeNonHaltVarsContains.halt,
                  by intro h; cases h⟩
        | terminalArgs kind args =>
            simp [Functions.Source.Stmt.run] at hRun
            cases hArgs :
                Locals.Source.Expr.ExprSeq.eval prim args state with
            | error err =>
                simp [hArgs] at hRun
            | ok argPair =>
                rcases argPair with ⟨stateAfterArgs, values⟩
                simp [hArgs] at hRun
                cases hTerminal :
                    prim.terminal kind stateAfterArgs.shared values with
                | error err =>
                    simp [hTerminal] at hRun
                | ok sharedAfter =>
                    simp [hTerminal] at hRun
                    rcases hRun with ⟨hOutcome, hCtxAfter⟩
                    subst outcome
                    subst ctxAfter
                    exact ⟨SourceOutcomeNonHaltVarsContains.halt,
                      by intro h; cases h⟩

theorem SourceOutcomeNonHaltVarsContains.of_runScoped
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {state : Objects.Source.State}
    {outcome : Functions.Source.Outcome}
    (hCtx : SourceCtxKeepsLayout layout ctx)
    (hContains : SourceVarsContains layout state.vars)
    (hRun :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome) :
    SourceOutcomeNonHaltVarsContains layout outcome :=
  SourceOutcomeNonHaltVarsContains.source_runs.2.1 hCtx hContains hRun

theorem SourceVarsContains.of_runOpen_regular
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {state stateAfter : Objects.Source.State}
    (hCtx : SourceCtxKeepsLayout layout ctx)
    (hContains : SourceVarsContains layout state.vars)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.regular stateAfter, ctxAfter)) :
    SourceVarsContains layout stateAfter.vars := by
  have hOutcome :
      SourceOutcomeNonHaltVarsContains layout
        (Functions.Source.Outcome.regular stateAfter) :=
    (SourceOutcomeNonHaltVarsContains.source_runs.1 hCtx hContains hRun).1
  simpa [SourceOutcomeNonHaltVarsContains,
    Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]
    using hOutcome

theorem SourceVarsContains.of_runOpen_regular_argList_eval
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {state stateAfterPre stateAfterArgs : Objects.Source.State}
    {args : List (Locals.Expr 1)} {values : List Word}
    (hCtx : SourceCtxKeepsLayout layout ctx)
    (hContains : SourceVarsContains layout state.vars)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.regular stateAfterPre, ctxAfter))
    (hArgs :
      Functions.Source.ArgList.eval prim args stateAfterPre =
        .ok (stateAfterArgs, values)) :
    SourceVarsContains layout stateAfterArgs.vars :=
  SourceVarsContains.of_argList_eval
    (SourceVarsContains.of_runOpen_regular hCtx hContains hRun) hArgs

theorem SourceVarsContains.of_runOpen_regular_argList_eval_of_initial_exact
    {cfg : StateRelConfig} {layout targetLayout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {state stateAfterPre stateAfterArgs : Objects.Source.State}
    {args : List (Locals.Expr 1)} {values : List Word}
    (hTargets : ∀ name, name ∈ targetLayout → name ∈ layout)
    (hCtx : SourceCtxKeepsLayout targetLayout ctx)
    (hInitial : SourceStateExactRel cfg layout (.Ok shared store) state)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.regular stateAfterPre, ctxAfter))
    (hArgs :
      Functions.Source.ArgList.eval prim args stateAfterPre =
        .ok (stateAfterArgs, values)) :
    SourceVarsContains targetLayout stateAfterArgs.vars := by
  cases hInitial with
  | @ok shared store compilerState hShared hVars hDomain =>
      have hInitialContains :
          SourceVarsContains targetLayout state.vars := by
        intro name hMem
        exact
          SourceStateRel.contains_of_domain
            (SourceStateRel.ok hShared hVars) hDomain
            (hTargets name hMem)
      exact
        SourceVarsContains.of_runOpen_regular_argList_eval
          hCtx hInitialContains hRun hArgs

theorem sourceStoreRel_lookupMany_eq_map_lookup!
    {layout returns : List Name}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    {values : List Word}
    (hRel : SourceStoreRel layout store vars)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout)
    (hLookup :
      Functions.Source.Store.lookupMany returns vars = some values) :
    values =
      returns.map fun name => (store.lookup name).getD (EvmYul.UInt256.ofNat 0) := by
  induction returns generalizing values with
  | nil =>
      simp [Functions.Source.Store.lookupMany] at hLookup
      cases hLookup
      rfl
  | cons name rest ih =>
      unfold Functions.Source.Store.lookupMany at hLookup
      have hNameMem : name ∈ layout := hReturns name (by simp)
      have hNameRel : vars name = store.lookup name := hRel name hNameMem
      cases hVar : vars name with
      | none =>
          simp [hVar] at hLookup
      | some value =>
          simp [hVar] at hLookup
          cases hTail :
              Functions.Source.Store.lookupMany rest vars with
          | none =>
              simp [hTail] at hLookup
          | some tailValues =>
              simp [hTail] at hLookup
              rcases hLookup with rfl
              have hRest :
                  ∀ restName, restName ∈ rest → restName ∈ layout := by
                intro restName hMem
                exact hReturns restName (by simp [hMem])
              have hTailValues :=
                ih hRest hTail
              have hStoreLookup : store.lookup name = some value := by
                simpa [hVar] using hNameRel.symm
              simp [hStoreLookup, hTailValues]

theorem sourceStoreRel_lookupMany_of_domain
    {layout returns : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    (hRel : SourceStoreRel layout store vars)
    (hDomain : StoreDomainExact layout store)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout) :
    Functions.Source.Store.lookupMany returns vars =
      some
        (returns.map fun name =>
          EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
  induction returns with
  | nil =>
      simp [Functions.Source.Store.lookupMany]
  | cons name rest ih =>
      have hNameMem : name ∈ layout := hReturns name (by simp)
      have hStoreSome : (store.lookup name).isSome = true :=
        (hDomain name).mpr hNameMem
      cases hStoreLookup : store.lookup name with
      | none =>
          simp [hStoreLookup] at hStoreSome
      | some value =>
          have hVarLookup : vars name = some value := by
            simpa [hStoreLookup] using hRel name hNameMem
          have hTail :
              Functions.Source.Store.lookupMany rest vars =
                some
                  (rest.map fun name =>
                    EvmYul.Yul.State.lookup! name (.Ok shared store)) :=
            ih (by
              intro other hOther
              exact hReturns other (by simp [hOther]))
          have hLookupBang :
              EvmYul.Yul.State.lookup! name (.Ok shared store) = value := by
            change (store.lookup name).get! = value
            rw [hStoreLookup]
            rfl
          simp [Functions.Source.Store.lookupMany, hVarLookup, hTail,
            hLookupBang]

theorem sourceStoreRel_lookupMany_of_contains
    {layout returns : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    (hRel : SourceStoreRel layout store vars)
    (hContains : StoreDomainContains layout store)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout) :
    Functions.Source.Store.lookupMany returns vars =
      some
        (returns.map fun name =>
          EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
  induction returns with
  | nil =>
      simp [Functions.Source.Store.lookupMany]
  | cons name rest ih =>
      have hNameMem : name ∈ layout := hReturns name (by simp)
      have hStoreSome : (store.lookup name).isSome = true :=
        hContains name hNameMem
      cases hStoreLookup : store.lookup name with
      | none =>
          simp [hStoreLookup] at hStoreSome
      | some value =>
          have hVarLookup : vars name = some value := by
            simpa [hStoreLookup] using hRel name hNameMem
          have hTail :
              Functions.Source.Store.lookupMany rest vars =
                some
                  (rest.map fun name =>
                    EvmYul.Yul.State.lookup! name (.Ok shared store)) :=
            ih (by
              intro other hOther
              exact hReturns other (by simp [hOther]))
          have hLookupBang :
              EvmYul.Yul.State.lookup! name (.Ok shared store) = value := by
            change (store.lookup name).get! = value
            rw [hStoreLookup]
            rfl
          simp [Functions.Source.Store.lookupMany, hVarLookup, hTail,
            hLookupBang]

theorem sourceStoreRel_lookupMany_of_source_contains
    {layout returns : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {vars : Locals.Source.Store}
    (hRel : SourceStoreRel layout store vars)
    (hSourceContains :
      ∀ name, name ∈ returns → vars.contains name = true)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout) :
    Functions.Source.Store.lookupMany returns vars =
      some
        (returns.map fun name =>
          EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
  induction returns with
  | nil =>
      simp [Functions.Source.Store.lookupMany]
  | cons name rest ih =>
      have hNameMem : name ∈ layout := hReturns name (by simp)
      have hNameContains : vars.contains name = true :=
        hSourceContains name (by simp)
      cases hVarLookup : vars name with
      | none =>
          simp [Locals.Source.Store.contains, hVarLookup] at hNameContains
      | some value =>
          have hStoreLookup : store.lookup name = some value := by
            simpa [hVarLookup] using (hRel name hNameMem).symm
          have hTail :
              Functions.Source.Store.lookupMany rest vars =
                some
                  (rest.map fun name =>
                    EvmYul.Yul.State.lookup! name (.Ok shared store)) :=
            ih
              (by
                intro other hOther
                exact hSourceContains other (by simp [hOther]))
              (by
                intro other hOther
                exact hReturns other (by simp [hOther]))
          have hLookupBang :
              EvmYul.Yul.State.lookup! name (.Ok shared store) = value := by
            change (store.lookup name).get! = value
            rw [hStoreLookup]
            rfl
          simp [Functions.Source.Store.lookupMany, hVarLookup, hTail,
            hLookupBang]

theorem sourceStateRel_lookupMany_eq_map_lookup!
    {cfg : StateRelConfig} {layout returns : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {source : Objects.Source.State} {values : List Word}
    (hRel : SourceStateRel cfg layout (.Ok shared store) source)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout)
    (hLookup :
      Functions.Source.Store.lookupMany returns source.vars =
        some values) :
    values =
      returns.map fun name =>
        (EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
  cases hRel with
  | ok _hShared hVars =>
      have hValues :=
        sourceStoreRel_lookupMany_eq_map_lookup!
          (layout := layout) (returns := returns) (store := store)
          (vars := source.vars) hVars hReturns hLookup
      simpa [EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?]
        using hValues

