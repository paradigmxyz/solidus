    {compiler : Objects.Source.State}
    {loopResult : Except Exception State}
    (hBlock :
      SourceResultBlockSoundWhenAtExactHiddenScope cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel.succ.succ
        [(.For cond post body)] codeOverride
        (generatedForLowerBlock pieces.preCond pieces.lowerCond
          pieces.lowerPost pieces.lowerBody)
        (fun result =>
          result = restrictSourceResultTo store loopResult))
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        loopResult)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.For cond post body) codeOverride
        (.Ok shared store) = loopResult)
    (hRelatable : SourceResultRelatable loopResult)
    (hNotRegularOk : SourceResultNotRegularOk loopResult) :
    SourceNonregularStmtRunHiddenExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel (.For cond post body)
      codeOverride (.Ok shared store) compiler
      (generatedForLowerBlock pieces.preCond pieces.lowerCond
        pieces.lowerPost pieces.lowerBody) := by
  have hEntryDomain : StoreDomainExact layout store :=
    SourceStateExactRel.domain hInitial
  have hStoreContains :
      ∀ name, name ∈ layout → (store.lookup name).isSome = true := by
    intro name hMem
    exact (hEntryDomain name).mpr hMem
  have hSourceSeq :
      EvmYul.Yul.execSeq sourceFuel.succ [(.For cond post body)]
          codeOverride (.Ok shared store) = loopResult :=
    Imported.execSeq_single_succ hSource
  have hSourceBlock :
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Block [(.For cond post body)]) codeOverride (.Ok shared store) =
        restrictSourceResultTo store loopResult := by
    simp [restrictSourceResultTo, EvmYul.Yul.exec, hSourceSeq,
      EvmYul.Yul.State.store]
    cases loopResult <;> rfl
  rcases hBlock hInitial rfl hSourceBlock with
    ⟨sourceOutcome, targetFuel, hTargetScoped, hOutcomeRelBlock⟩
  have hOutcomeRel :
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        loopResult sourceOutcome :=
    SourceResultOutcomeRel.of_restrictStoreTo_compatible
      (ctx := ctx) hStoreContains hCompat hRelatable
      (by simpa [restrictSourceResultTo] using hOutcomeRelBlock)
  have hMode : sourceOutcome.mode ≠ Locals.Source.Mode.regular := by
    cases loopResult with
    | error err =>
        exact SourceResultOutcomeRel.mode_ne_regular_of_error hOutcomeRel
    | ok source =>
        cases source with
        | Ok sharedOk storeOk =>
            exact False.elim hNotRegularOk
        | OutOfFuel =>
            exact False.elim
              (sourceResultRelatable_stateOutOfFuel_false hRelatable)
        | Checkpoint jump =>
            exact
              SourceResultOutcomeRel.mode_ne_regular_of_checkpoint
                hOutcomeRel
  rcases
      blockRunOpen_of_runScoped_nonregular
        (prim := prim) (program := program) (ctx := ctx)
        (block :=
          generatedForLowerBlock pieces.preCond pieces.lowerCond
            pieces.lowerPost pieces.lowerBody)
        (fuel := targetFuel) (state := compiler)
        (outcome := sourceOutcome) hTargetScoped hMode with
    ⟨ctxAfter, hTargetOpen⟩
  exact
    ⟨loopResult, sourceOutcome, ctxAfter, targetFuel, hSource,
      hTargetOpen, hOutcomeRel, hMode⟩

