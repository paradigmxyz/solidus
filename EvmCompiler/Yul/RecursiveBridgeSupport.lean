theorem exec_execSeq_outOfFuel_state_eq_of_safe_primitiveFamilies
    (fuel : Nat) :
    (∀ {stmt : AstStmt} {codeOverride : Option AstContract}
      {stateAfter : State},
      Safe.stmt stmt →
      EvmYul.Yul.exec fuel stmt codeOverride .OutOfFuel =
        .ok stateAfter →
      stateAfter = .OutOfFuel) ∧
    (∀ {stmts : List AstStmt} {codeOverride : Option AstContract}
      {stateAfter : State},
      Safe.stmts stmts →
      EvmYul.Yul.execSeq fuel stmts codeOverride .OutOfFuel =
        .ok stateAfter →
      stateAfter = .OutOfFuel) := by
  refine Nat.strong_induction_on fuel ?_
  intro fuel ih
  cases fuel with
  | zero =>
      constructor
      · intro stmt codeOverride stateAfter _hSafe hExec
        simp [EvmYul.Yul.exec] at hExec
      · intro stmts codeOverride stateAfter _hSafe hExec
        simp [EvmYul.Yul.execSeq] at hExec
  | succ fuel' =>
      have ihFuel := ih fuel' (Nat.lt_succ_self fuel')
      constructor
      · intro stmt codeOverride stateAfter hSafe hExec
        cases stmt with
        | Block body =>
            cases hSeq :
                EvmYul.Yul.execSeq fuel' body codeOverride .OutOfFuel with
            | error err =>
                simp [EvmYul.Yul.exec, hSeq] at hExec
            | ok stateSeq =>
                have hSeqEq : stateSeq = .OutOfFuel :=
                  ihFuel.2 (by simpa [Safe.stmt] using hSafe) hSeq
                subst stateSeq
                simp [EvmYul.Yul.exec, hSeq,
                  EvmYul.Yul.State.restrictStoreTo] at hExec
                exact hExec.symm
        | Let names value? =>
            cases value? with
            | none =>
                cases hCheck :
                    EvmYul.Yul.checkDeclaration (.OutOfFuel : State) names with
                | error err =>
                    simp [EvmYul.Yul.exec, hCheck] at hExec
                | ok unit =>
                    simp [EvmYul.Yul.exec, hCheck, zeroFill_outOfFuel] at hExec
                    exact hExec.symm
            | some value =>
                have hValueSafe : Safe.expr value := by
                  simpa [Safe.stmt] using hSafe
                cases hCheck :
                    EvmYul.Yul.checkDeclaration (.OutOfFuel : State) names with
                | error err =>
                    simp [EvmYul.Yul.exec, hCheck] at hExec
                | ok unit =>
                    cases hEval :
                        EvmYul.Yul.evalValues fuel' value codeOverride
                          .OutOfFuel with
                    | error err =>
                        simp [EvmYul.Yul.exec, hCheck, hEval,
                          EvmYul.Yul.multifill'] at hExec
                    | ok pair =>
                        rcases pair with ⟨stateValue, values⟩
                        have hValueEq : stateValue = .OutOfFuel :=
                          evalValues_outOfFuel_state_eq_of_safe_primitiveFamilies
                            hValueSafe hEval
                        subst stateValue
                        simp [EvmYul.Yul.exec, hCheck, hEval,
                          EvmYul.Yul.multifill', multifill_outOfFuel] at hExec
                        exact hExec.symm
        | Assign names value =>
            have hValueSafe : Safe.expr value := by
              simpa [Safe.stmt] using hSafe
            cases hCheck :
                EvmYul.Yul.checkAssignment (.OutOfFuel : State) names with
            | error err =>
                simp [EvmYul.Yul.exec, hCheck] at hExec
            | ok unit =>
                cases hEval :
                    EvmYul.Yul.evalValues fuel' value codeOverride
                      .OutOfFuel with
                | error err =>
                    simp [EvmYul.Yul.exec, hCheck, hEval,
                      EvmYul.Yul.multifill'] at hExec
                | ok pair =>
                    rcases pair with ⟨stateValue, values⟩
                    have hValueEq : stateValue = .OutOfFuel :=
                      evalValues_outOfFuel_state_eq_of_safe_primitiveFamilies
                        hValueSafe hEval
                    subst stateValue
                    simp [EvmYul.Yul.exec, hCheck, hEval,
                      EvmYul.Yul.multifill', multifill_outOfFuel] at hExec
                    exact hExec.symm
        | ExprStmtCall value =>
            have hValueSafe : Safe.expr value := by
              simpa [Safe.stmt] using hSafe
            cases value with
            | Lit value =>
                simp [EvmYul.Yul.exec] at hExec
            | Var name =>
                simp [EvmYul.Yul.exec] at hExec
            | Call callee args =>
                cases callee with
                | inl prim =>
                    have hSafePrim : Safe.primitive prim := hValueSafe.1
                    have hSafeArgs : Safe.exprs args := hValueSafe.2
                    cases hArgs :
                        EvmYul.Yul.evalArgs fuel' args.reverse codeOverride
                          .OutOfFuel with
                    | error err =>
                        simp [EvmYul.Yul.exec, hArgs,
                          EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall]
                          at hExec
                    | ok argPair =>
                        rcases argPair with ⟨stateArgs, argValues⟩
                        have hArgsEq : stateArgs = .OutOfFuel :=
                          evalArgs_reverse_outOfFuel_state_eq_of_safe_primitiveFamilies
                            hSafeArgs hArgs
                        subst stateArgs
                        cases hCall :
                            EvmYul.Yul.primCall fuel' .OutOfFuel prim
                              argValues.reverse with
                        | error err =>
                            simp [EvmYul.Yul.exec, hArgs,
                              EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall,
                              hCall, EvmYul.Yul.multifill'] at hExec
                        | ok callPair =>
                            rcases callPair with ⟨stateCall, valuesCall⟩
                            have hCallEq : stateCall = .OutOfFuel :=
                              primCall_safe_nonOk_state_eq_of_ok
                                (state := .OutOfFuel) hSafePrim
                                (by intro shared store h; cases h)
                                hCall
                            subst stateCall
                            simp [EvmYul.Yul.exec, hArgs,
                              EvmYul.Yul.reverse', EvmYul.Yul.execPrimCall,
                              hCall, EvmYul.Yul.multifill',
                              multifill_outOfFuel] at hExec
                            exact hExec.symm
                | inr functionName =>
                    have hSafeArgs : Safe.exprs args := hValueSafe.2
                    cases hArgs :
                        EvmYul.Yul.evalArgs fuel' args.reverse codeOverride
                          .OutOfFuel with
                    | error err =>
                        simp [EvmYul.Yul.exec, hArgs,
                          EvmYul.Yul.reverse', EvmYul.Yul.execCall]
                          at hExec
                    | ok argPair =>
                        rcases argPair with ⟨stateArgs, argValues⟩
                        have hArgsEq : stateArgs = .OutOfFuel :=
                          evalArgs_reverse_outOfFuel_state_eq_of_safe_primitiveFamilies
                            hSafeArgs hArgs
                        subst stateArgs
                        cases fuel' with
                        | zero =>
                            simp [EvmYul.Yul.exec, hArgs,
                              EvmYul.Yul.reverse', EvmYul.Yul.execCall]
                              at hExec
                        | succ callFuel =>
                            cases hCall :
                                EvmYul.Yul.call callFuel argValues.reverse
                                  functionName codeOverride .OutOfFuel with
                            | error err =>
                                simp [EvmYul.Yul.exec, hArgs,
                                  EvmYul.Yul.reverse',
                                  EvmYul.Yul.execCall, hCall,
                                  EvmYul.Yul.multifill'] at hExec
                            | ok callPair =>
                                rcases callPair with
                                  ⟨stateCall, valuesCall⟩
                                have hCallEq : stateCall = .OutOfFuel :=
                                  call_outOfFuel_state_eq_of_ok hCall
                                subst stateCall
                                simp [EvmYul.Yul.exec, hArgs,
                                  EvmYul.Yul.reverse',
                                  EvmYul.Yul.execCall, hCall,
                                  EvmYul.Yul.multifill',
                                  multifill_outOfFuel] at hExec
                                exact hExec.symm
        | Switch cond cases defaultBody =>
            rcases hSafe with ⟨hCondSafe, hCasesSafe, hDefaultSafe⟩
            cases hEval :
                EvmYul.Yul.eval fuel' cond codeOverride .OutOfFuel with
            | error err =>
                simp [EvmYul.Yul.exec, hEval] at hExec
            | ok evalPair =>
                rcases evalPair with ⟨stateCond, condValue⟩
                have hCondEq : stateCond = .OutOfFuel :=
                  eval_outOfFuel_state_eq_of_safe_primitiveFamilies
                    hCondSafe hEval
                subst stateCond
                cases hBlock :
                    EvmYul.Yul.exec fuel'
                      (.Block
                        (EvmYul.Yul.selectSwitchCase condValue defaultBody
                          cases))
                      codeOverride .OutOfFuel with
                | error err =>
                    simp [EvmYul.Yul.exec, hEval, hBlock] at hExec
                | ok stateBlock =>
                    have hSelectedSafe :
                        Safe.stmt
                          (.Block
                            (EvmYul.Yul.selectSwitchCase condValue
                              defaultBody cases)) := by
                      simpa [Safe.stmt] using
                        safe_cases_selectSwitchCase
                          (value := condValue) hCasesSafe hDefaultSafe
                    have hBlockEq : stateBlock = .OutOfFuel :=
                      ihFuel.1 hSelectedSafe hBlock
                    subst stateBlock
                    simp [EvmYul.Yul.exec, hEval, hBlock] at hExec
                    exact hExec.symm
        | For cond post body =>
            rcases hSafe with ⟨hCondSafe, _hPostSafe, hBodySafe⟩
            cases fuel' with
            | zero =>
                simp [EvmYul.Yul.exec, EvmYul.Yul.loop] at hExec
            | succ fuel1 =>
                cases fuel1 with
                | zero =>
                    simp [EvmYul.Yul.exec, EvmYul.Yul.loop] at hExec
                | succ sourceFuel =>
                    rw [Imported.exec_for_succ] at hExec
                    rw [Imported.loop_succ_succ] at hExec
                    simp [EvmYul.Yul.State.mkOk] at hExec
                    cases hEval :
                        EvmYul.Yul.eval sourceFuel cond codeOverride
                          .OutOfFuel with
                    | error err =>
                        simp [hEval] at hExec
                    | ok evalPair =>
                        rcases evalPair with ⟨stateCond, condValue⟩
                        have hCondEq : stateCond = .OutOfFuel :=
                          eval_outOfFuel_state_eq_of_safe_primitiveFamilies
                            hCondSafe hEval
                        subst stateCond
                        by_cases hZero : condValue = (⟨0⟩ : Word)
                        · simp [hEval, hZero, EvmYul.Yul.State.overwrite?]
                            at hExec
                          exact hExec.symm
                        · cases hBody :
                              EvmYul.Yul.exec sourceFuel (.Block body)
                                codeOverride .OutOfFuel with
                          | error err =>
                              simp [hEval, hZero, hBody] at hExec
                          | ok stateBody =>
                              have hBodyEq : stateBody = .OutOfFuel :=
                                (ih sourceFuel (by omega)).1
                                  (by simpa [Safe.stmt] using hBodySafe)
                                  hBody
                              subst stateBody
                              simp [hEval, hZero, hBody,
                                EvmYul.Yul.State.overwrite?] at hExec
                              exact hExec.symm
        | If cond body =>
            rcases hSafe with ⟨hCondSafe, hBodySafe⟩
            cases hEval :
                EvmYul.Yul.eval fuel' cond codeOverride .OutOfFuel with
            | error err =>
                simp [EvmYul.Yul.exec, hEval] at hExec
            | ok evalPair =>
                rcases evalPair with ⟨stateCond, condValue⟩
                have hCondEq : stateCond = .OutOfFuel :=
                  eval_outOfFuel_state_eq_of_safe_primitiveFamilies
                    hCondSafe hEval
                subst stateCond
                by_cases hZero : condValue = (⟨0⟩ : Word)
                · simp [EvmYul.Yul.exec, hEval, hZero] at hExec
                  exact hExec.symm
                · cases hBody :
                      EvmYul.Yul.exec fuel' (.Block body) codeOverride
                        .OutOfFuel with
                  | error err =>
                      simp [EvmYul.Yul.exec, hEval, hZero, hBody] at hExec
                  | ok stateBody =>
                      have hBodyEq : stateBody = .OutOfFuel :=
                        ihFuel.1 (by simpa [Safe.stmt] using hBodySafe) hBody
                      subst stateBody
                      simp [EvmYul.Yul.exec, hEval, hZero, hBody] at hExec
                      exact hExec.symm
        | Continue =>
            simp [EvmYul.Yul.exec, EvmYul.Yul.State.setContinue] at hExec
            exact hExec.symm
        | Break =>
            simp [EvmYul.Yul.exec, EvmYul.Yul.State.setBreak] at hExec
            exact hExec.symm
        | Leave =>
            simp [EvmYul.Yul.exec, EvmYul.Yul.State.setLeave] at hExec
            exact hExec.symm
      · intro stmts codeOverride stateAfter hSafe hExec
        cases stmts with
        | nil =>
            simp [EvmYul.Yul.execSeq] at hExec
            exact hExec.symm
        | cons head tail =>
            have hHeadSafe : Safe.stmt head := hSafe.1
            cases hHead :
                EvmYul.Yul.exec fuel' head codeOverride .OutOfFuel with
            | error err =>
                simp [EvmYul.Yul.execSeq, hHead] at hExec
            | ok stateHead =>
                have hHeadEq : stateHead = .OutOfFuel :=
                  ihFuel.1 hHeadSafe hHead
                subst stateHead
                simp [EvmYul.Yul.execSeq, hHead] at hExec
                exact hExec.symm

theorem exec_outOfFuel_state_eq_of_safe_primitiveFamilies
    {fuel : Nat} {stmt : AstStmt} {codeOverride : Option AstContract}
    {stateAfter : State}
    (hSafe : Safe.stmt stmt)
    (hExec :
      EvmYul.Yul.exec fuel stmt codeOverride .OutOfFuel =
        .ok stateAfter) :
    stateAfter = .OutOfFuel :=
  (exec_execSeq_outOfFuel_state_eq_of_safe_primitiveFamilies fuel).1
    hSafe hExec

theorem execSeq_outOfFuel_state_eq_of_safe_primitiveFamilies
    {fuel : Nat} {stmts : List AstStmt}
    {codeOverride : Option AstContract} {stateAfter : State}
    (hSafe : Safe.stmts stmts)
    (hExec :
      EvmYul.Yul.execSeq fuel stmts codeOverride .OutOfFuel =
        .ok stateAfter) :
    stateAfter = .OutOfFuel :=
  (exec_execSeq_outOfFuel_state_eq_of_safe_primitiveFamilies fuel).2
    hSafe hExec

theorem exec_block_outOfFuel_state_eq_of_safe_primitiveFamilies
    {fuel : Nat} {stmts : List AstStmt}
    {codeOverride : Option AstContract} {stateAfter : State}
    (hSafe : Safe.stmts stmts)
    (hExec :
      EvmYul.Yul.exec fuel (.Block stmts) codeOverride .OutOfFuel =
        .ok stateAfter) :
    stateAfter = .OutOfFuel :=
  exec_outOfFuel_state_eq_of_safe_primitiveFamilies
    (stmt := .Block stmts) (by simpa [Safe.stmt] using hSafe) hExec

theorem eval_ok_or_outOfFuel_domain_exact_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {stateAfter : State} {value : Word}
    (hSafe : Safe.expr expr)
    (hDomain : StoreDomainExact layout store)
    (hEval :
      EvmYul.Yul.eval fuel expr codeOverride (.Ok shared store) =
        .ok (stateAfter, value)) :
    stateAfter = .OutOfFuel ∨
      ∃ sharedAfter storeAfter,
        stateAfter = .Ok sharedAfter storeAfter ∧
        StoreDomainExact layout storeAfter := by
  have hStateDomain :
      StateStoreDomainExact layout stateAfter :=
    eval_state_domain_exact_of_safe_primitiveFamilies
      hSafe (by simpa [StateStoreDomainExact] using hDomain) hEval
  have hCheckpoint :
      SourcePairResultCheckpointAllowed false false false
        (EvmYul.Yul.eval fuel expr codeOverride (.Ok shared store)) :=
    (CheckpointExpressionSound.of_callSound
      (CheckpointCallSound.of_primitiveCallCheckpointAllowedForSafe
        PrimitiveCallCheckpointAllowedForSafe.of_primitive_families
        PrimitiveCallCheckpointAllowedForSafeNonOk.of_primitive_families)).eval
      hSafe (by simp [StateCheckpointAllowed])
  cases stateAfter with
  | OutOfFuel =>
      exact Or.inl rfl
  | Ok sharedAfter storeAfter =>
      exact
        Or.inr
          ⟨sharedAfter, storeAfter, rfl,
            by simpa [StateStoreDomainExact] using hStateDomain⟩
  | Checkpoint jump =>
      cases jump with
      | Break sharedAfter storeAfter =>
          have hAllowed :
              StateCheckpointAllowed false false false
                (.Checkpoint (.Break sharedAfter storeAfter)) := by
            simpa [SourcePairResultCheckpointAllowed, hEval] using
              hCheckpoint
          simp [StateCheckpointAllowed] at hAllowed
      | Continue sharedAfter storeAfter =>
          have hAllowed :
              StateCheckpointAllowed false false false
                (.Checkpoint (.Continue sharedAfter storeAfter)) := by
            simpa [SourcePairResultCheckpointAllowed, hEval] using
              hCheckpoint
          simp [StateCheckpointAllowed] at hAllowed
      | Leave sharedAfter storeAfter =>
          have hAllowed :
              StateCheckpointAllowed false false false
                (.Checkpoint (.Leave sharedAfter storeAfter)) := by
            simpa [SourcePairResultCheckpointAllowed, hEval] using
              hCheckpoint
          simp [StateCheckpointAllowed] at hAllowed

theorem eval_ok_or_outOfFuel_domain_contains_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {stateAfter : State} {value : Word}
    (hSafe : Safe.expr expr)
    (hContains : StoreDomainContains layout store)
    (hEval :
      EvmYul.Yul.eval fuel expr codeOverride (.Ok shared store) =
        .ok (stateAfter, value)) :
    stateAfter = .OutOfFuel ∨
      ∃ sharedAfter storeAfter,
        stateAfter = .Ok sharedAfter storeAfter ∧
        StoreDomainContains layout storeAfter := by
  have hResultContains :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel expr codeOverride (.Ok shared store)) :=
    StoreDomainExpressionSound.of_primitive_families.eval
      (layout := layout) (fuel := fuel) (expr := expr)
      (codeOverride := codeOverride) (state := .Ok shared store)
      hSafe (by simpa [StateStoreContains] using hContains)
  have hStateContains :
      StateStoreContains layout stateAfter :=
    SourcePairResultStoreContains.state_of_ok hResultContains hEval
  have hCheckpoint :
      SourcePairResultCheckpointAllowed false false false
        (EvmYul.Yul.eval fuel expr codeOverride (.Ok shared store)) :=
    (CheckpointExpressionSound.of_callSound
      (CheckpointCallSound.of_primitiveCallCheckpointAllowedForSafe
        PrimitiveCallCheckpointAllowedForSafe.of_primitive_families
        PrimitiveCallCheckpointAllowedForSafeNonOk.of_primitive_families)).eval
      hSafe (by simp [StateCheckpointAllowed])
  cases stateAfter with
  | OutOfFuel =>
      exact Or.inl rfl
  | Ok sharedAfter storeAfter =>
      exact
        Or.inr
          ⟨sharedAfter, storeAfter, rfl,
            by simpa [StateStoreContains] using hStateContains⟩
  | Checkpoint jump =>
      cases jump with
      | Break sharedAfter storeAfter =>
          have hAllowed :
              StateCheckpointAllowed false false false
                (.Checkpoint (.Break sharedAfter storeAfter)) := by
            simpa [SourcePairResultCheckpointAllowed, hEval] using
              hCheckpoint
          simp [StateCheckpointAllowed] at hAllowed
      | Continue sharedAfter storeAfter =>
          have hAllowed :
              StateCheckpointAllowed false false false
                (.Checkpoint (.Continue sharedAfter storeAfter)) := by
            simpa [SourcePairResultCheckpointAllowed, hEval] using
              hCheckpoint
          simp [StateCheckpointAllowed] at hAllowed
      | Leave sharedAfter storeAfter =>
          have hAllowed :
              StateCheckpointAllowed false false false
                (.Checkpoint (.Leave sharedAfter storeAfter)) := by
            simpa [SourcePairResultCheckpointAllowed, hEval] using
              hCheckpoint
          simp [StateCheckpointAllowed] at hAllowed

theorem eval_ok_domain_exact_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore} {value : Word}
    (hSafe : Safe.expr expr)
