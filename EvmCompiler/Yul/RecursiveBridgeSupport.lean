  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomain =>
      have hInitialExact :
          SourceStateExactRel cfg layout (.Ok shared store) compiler :=
        SourceStateExactRel.ok hShared hVars hDomain
      rcases
          functions_source_initNames_runOpen_regular
            (prim := prim) (program := program) (ctx := ctx)
            (compiler := compiler) (identNames names) hNoDup
            (by
              intro name hMem hCtx
              exact hFresh name hMem (by simpa [hScope] using hCtx)) with
        ⟨compilerAfterInit, hInitRun, hInitShared, hInitPreserve⟩
      have hRelInit :
          SourceStateRel cfg layout (.Ok shared store) compilerAfterInit := by
        refine SourceStateRel.ok ?_ ?_
        · simpa [hInitShared] using hShared
        · intro name hMem
          have hCtxMem : name ∈ ctx.scope := by
            simpa [hScope] using hMem
          rw [hInitPreserve name hCtxMem]
          exact hVars name hMem
      have hRelInitExact :
          SourceStateExactRel cfg layout (.Ok shared store)
            compilerAfterInit :=
        SourceStateExactRel.ofRelDomain hRelInit hDomain
      have hInitContains :
          SourceVarsContains (identNames names) compilerAfterInit.vars :=
        functions_source_initNames_contains_of_runOpen_regular
          (prim := prim) (program := program) (ctx := ctx)
          (compiler := compiler) (compilerAfter := compilerAfterInit)
          (names := identNames names) hNoDup
          (by
            intro name hMem hCtx
            exact hFresh name hMem (by simpa [hScope] using hCtx))
          hInitRun
      cases hArgSplit hInitialExact hAllow hSource with
      | inl hOk =>
          rcases hOk with ⟨sourceAfterArgs, argValues, hArgEval⟩
          rcases hArgsRegular.2 hRelInit hArgEval with
            ⟨compilerAfterPre, compilerAfterArgs, ctxAfterPre, preFuel,
              hPreRun, hArgsRun, hRelArgs⟩
          rcases
              hCallSuccess hInitialExact hAllow hSource hArgEval
                hRelInit hInitContains hPreRun hArgsRun hRelArgs with
            ⟨sourceOutcome, ctxAfterCall, callFuel, hCallRun, hOutcomeRel⟩
          rcases
              Functions.Source.Block.runOpen_append_regular_exists prim program
                pre
                [Functions.Stmt.call (identNames names) functionName lowerArgs]
                { ctx with scope := (identNames names).reverse ++ ctx.scope }
                ctxAfterPre compilerAfterInit compilerAfterPre sourceOutcome
                ctxAfterCall ⟨preFuel, hPreRun⟩ ⟨callFuel, hCallRun⟩ with
            ⟨preCallFuel, hPreCallRun⟩
          rcases
              Functions.Source.Block.runOpen_append_regular_exists prim program
                (Stmt.initNames (identNames names))
                (pre ++ [Functions.Stmt.call (identNames names) functionName
                  lowerArgs])
                ctx
                { ctx with scope := (identNames names).reverse ++ ctx.scope }
                compiler compilerAfterInit sourceOutcome ctxAfterCall
                ⟨(identNames names).length + 1, hInitRun⟩
                ⟨preCallFuel, hPreCallRun⟩ with
            ⟨targetFuel, hTargetOpen⟩
          refine ⟨_, targetFuel, ?_, hOutcomeRel⟩
          cases sourceOutcome with
          | mk sourceState sourceMode =>
              cases sourceMode <;>
                simp [Functions.Source.Block.runScoped, hTargetOpen,
                  Functions.Source.Outcome.regular, Functions.Source.Outcome.brk,
                  Functions.Source.Outcome.cont, Functions.Source.Outcome.leave,
                  Functions.Source.Outcome.halt, Locals.Source.Outcome.regular,
                  Locals.Source.Outcome.brk, Locals.Source.Outcome.cont,
                  Locals.Source.Outcome.leave, Locals.Source.Outcome.halt]
      | inr hErr =>
          rcases hErr with ⟨err, hEvalArgs, hResultEq, hRelatable⟩
          rcases hArgsTerminal hRelInitExact hEvalArgs hRelatable with
            ⟨sourceOutcome, ctxAfterPre, preFuel, hPreRun, hOutcomeRel⟩
          have hMode :
              sourceOutcome.mode ≠ .regular :=
            SourceResultOutcomeRel.mode_ne_regular_of_error hOutcomeRel
          rcases
