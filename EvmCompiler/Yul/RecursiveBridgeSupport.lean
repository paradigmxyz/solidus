    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel lowerFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hHead :
