theorem runLoopSourceAfterHead_nonzero_resolves_inv_body
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {source condState : State}
    {value : Word} {trace : OpenExternal.OpenTrace}
    {sourceDone : Except Exception State}
    (hNonzero : value ≠ EvmYul.UInt256.ofNat 0)
    (hResolve :
      OpenExternal.OpenResultResolves
        (runLoopSourceAfterHead fuel cond post body codeOverride source
          (condState, value))
        trace sourceDone) :
    (∃ err,
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
            condState))
        trace (.error err) ∧
      sourceDone = .error err) ∨
    (∃ bodyTrace suffix bodyResult,
      trace = bodyTrace ++ suffix ∧
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
            condState))
        bodyTrace (.ok bodyResult) ∧
      OpenExternal.OpenResultResolves
        (runLoopSourceAfterBody fuel cond post body codeOverride source
          bodyResult)
        suffix sourceDone) := by
  rw [runLoopSourceAfterHead_nonzero hNonzero] at hResolve
  rcases OpenExternal.OpenResultResolves.bind_inv hResolve with hErr | hOk
  · rcases hErr with ⟨err, hBody, hDone⟩
    exact Or.inl ⟨err, hBody, hDone⟩
  · rcases hOk with
      ⟨bodyTrace, suffix, bodyResult, hTrace, hBody, hSuffix⟩
    exact Or.inr ⟨bodyTrace, suffix, bodyResult, hTrace, hBody, hSuffix⟩

