    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns body)) :
    args.length = params.length := by
  rcases hExpr with ⟨hCall, _hArgs⟩
  rcases hCall with
    ⟨params0, returns0, body0, hLookup0, _hReturnsLen, hArgsLen⟩
  rw [hLookup0] at hLookup
  cases hLookup
  exact hArgsLen

