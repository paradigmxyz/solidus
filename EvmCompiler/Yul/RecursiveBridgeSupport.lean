private def Lower1PreludePreserving (expr : AstExpr) : Prop :=
  ∀ {state pre lower state'},
    Expr.lower1? state expr = some (pre, lower, state') →
      SourceContainsPreservingPrelude pre

private def LowerBoundPreludePreserving (args : List AstExpr) : Prop :=
  ∀ {state pre lowerArgs state'},
    Expr.List.lowerBound1? state args = some (pre, lowerArgs, state') →
      SourceContainsPreservingPrelude pre

