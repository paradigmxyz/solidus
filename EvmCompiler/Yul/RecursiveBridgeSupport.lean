/--
Regular open-sequence bridge whose post-state keeps the exact imported
varstore domain.

This is the exact-domain version of `SourceRegularSeqRunAt`. It is a small
internal interface for regular heads in recursive sequence proofs: when a head
finishes regularly, the tail should receive a full exact-domain relation rather
than rebuilding declaration/assignment validity from a weaker relation.
-/
def SourceRegularSeqRunAtExactDomain (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = layoutAfter ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateExactRel cfg layoutAfter sourceAfter compilerAfter

def SourceRegularSeqSoundAtFuelExactDomain (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block) :
    Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler},
      SourceStateExactRel cfg layout source compiler →
      SourceRegularSeqRunAtExactDomain cfg layout layoutAfter prim program
        ctx sourceFuel targetFuel sourceStmts codeOverride source compiler
        lowerBlock

/--
Regular statement head whose target implementation may be a block of hidden
compiler-only statements.

Unlike `SourceRegularStmtSoundAtExact`, the target side is a `Functions.Block`,
not one `Functions.Stmt`. This is the right interface for source statements
whose lowering emits an argument prelude of generated temporaries before the
real source-visible statement. The relation is exact in the source-visible
layout after the head, while deliberately saying nothing about the concrete
target context scope: generated temporaries may extend it.
-/
def SourceRegularStmtRunHiddenExact (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateExactRel cfg layoutAfter sourceAfter compilerAfter

