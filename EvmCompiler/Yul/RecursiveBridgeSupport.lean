/--
Invert a resolved loop source path at the condition-evaluation boundary.

The error branch means evaluating the condition itself failed. The successful
branch exposes the exact condition trace, the remaining suffix, and the selected
post-condition continuation.
-/
theorem runLoopSource_resolves_inv_evalValues
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {trace : OpenExternal.OpenTrace} {sourceDone : Except Exception State}
    (hResolve :
      OpenExternal.OpenResultResolves
        (runLoopSource fuel cond post body codeOverride source)
        trace sourceDone) :
    (∃ err,
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (EvmYul.Yul.State.mkOk source)))
        trace (.error err) ∧
      sourceDone = .error err) ∨
    (∃ condTrace suffix result,
      trace = condTrace ++ suffix ∧
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (EvmYul.Yul.State.mkOk source)))
        condTrace (.ok result) ∧
      OpenExternal.OpenResultResolves
        (runLoopSourceAfterEvalValues fuel cond post body codeOverride
          source result)
        suffix sourceDone) := by
  rw [runLoopSource_eq_bind_evalValues_after] at hResolve
  rcases OpenExternal.OpenResultResolves.bind_inv hResolve with hErr | hOk
  · rcases hErr with ⟨err, hValues, hDone⟩
    exact Or.inl ⟨err, hValues, hDone⟩
  · rcases hOk with
      ⟨condTrace, suffix, result, hTrace, hValues, hSuffix⟩
    exact Or.inr ⟨condTrace, suffix, result, hTrace, hValues, hSuffix⟩

/--
Singleton-aware source-loop inversion.

The condition expression invariant rules out successful multi-value condition
results, so the dispatcher can continue with the real condition word instead
of carrying an arity-error case.
-/
theorem runLoopSource_resolves_inv_evalValues_singleton
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {trace : OpenExternal.OpenTrace} {sourceDone : Except Exception State}
    (hSingle :
      OpenResultDoneInvariant
        (fun sourceDone =>
          ∀ {sourceAfter values},
            sourceDone = .ok (sourceAfter, values) →
              ∃ value, values = [value])
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (EvmYul.Yul.State.mkOk source))))
    (hResolve :
      OpenExternal.OpenResultResolves
        (runLoopSource fuel cond post body codeOverride source)
        trace sourceDone) :
    (∃ err,
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (EvmYul.Yul.State.mkOk source)))
        trace (.error err) ∧
      sourceDone = .error err) ∨
    (∃ condTrace suffix sourceAfter value,
      trace = condTrace ++ suffix ∧
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (EvmYul.Yul.State.mkOk source)))
        condTrace (.ok (sourceAfter, [value])) ∧
      OpenExternal.OpenResultResolves
        (runLoopSourceAfterHead fuel cond post body codeOverride source
          (sourceAfter, value))
        suffix sourceDone) := by
  rcases runLoopSource_resolves_inv_evalValues hResolve with hErr | hOk
  · rcases hErr with ⟨err, hValues, hDone⟩
    exact Or.inl ⟨err, hValues, hDone⟩
  · rcases hOk with
      ⟨condTrace, suffix, result, hTrace, hValues, hSuffix⟩
    rcases result with ⟨sourceAfter, values⟩
    have hValuesSingleton : ∃ value, values = [value] :=
      (OpenResultDoneInvariant.of_resolves hSingle hValues)
        (show
          (.ok (sourceAfter, values) :
            Except Exception (State × List Word)) =
            .ok (sourceAfter, values) from rfl)
    rcases hValuesSingleton with
      ⟨value, hValuesEq⟩
    subst values
    refine Or.inr
      ⟨condTrace, suffix, sourceAfter, value, hTrace, hValues, ?_⟩
    simpa [runLoopSourceAfterEvalValues, EvmYul.Yul.head'] using hSuffix

/--
Source-loop inversion after the condition has been checked against the raw
expression path relation.

The singleton invariant removes arity errors, and the selected raw expression
path relation forces the successful condition state to be a normal `.Ok`
source state.  This is the first split used by the generated open-loop
dispatcher before it calls the individual false/body/post branch lemmas.
-/
theorem runLoopSource_resolves_inv_evalValues_singleton_ok_source_of_cond_open
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {lowerCond : Locals.Expr 1}
    {condAllowed : Except Exception (State × List Word) → Prop}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {trace : OpenExternal.OpenTrace} {sourceDone : Except Exception State}
    (hCondOpen :
      SourceExprRawPreludeOpenPathSoundWhen cfg layout terminalRel revertRel
        prim program ctx fuel cond codeOverride pre lowerCond condAllowed)
    (hCondAllowedOk :
      ∀ {sourceAfter : State} {value : Word},
        condAllowed (.ok (sourceAfter, [value])))
    (hSingle :
      OpenResultDoneInvariant
        (fun sourceDone =>
          ∀ {sourceAfter values},
            sourceDone = .ok (sourceAfter, values) →
              ∃ value, values = [value])
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (.Ok shared store))))
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hResolve :
      OpenExternal.OpenResultResolves
        (runLoopSource fuel cond post body codeOverride (.Ok shared store))
        trace sourceDone)
    (hResponses : SourceOpenTraceResponsesAdmissible cfg trace) :
    (∃ err,
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (.Ok shared store)))
        trace (.error err) ∧
      sourceDone = .error err) ∨
    (∃ condTrace suffix sharedAfter storeAfter value,
      trace = condTrace ++ suffix ∧
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (.Ok shared store)))
        condTrace
        (.ok ((.Ok sharedAfter storeAfter : State), [value])) ∧
      OpenExternal.OpenResultResolves
        (runLoopSourceAfterHead fuel cond post body codeOverride
          (.Ok shared store)
          ((.Ok sharedAfter storeAfter : State), value))
        suffix sourceDone) := by
  rcases runLoopSource_resolves_inv_evalValues_singleton hSingle hResolve with
    hErr | hOk
  · exact Or.inl hErr
  · rcases hOk with
      ⟨condTrace, suffix, sourceAfter, value, hTrace, hResolveValues,
        hSuffix⟩
    have hCondResponses :
        SourceOpenTraceResponsesAdmissible cfg condTrace := by
      subst trace
      exact OpenExternal.OpenTrace.left_of_append hResponses
    rcases
        SourceExprRawPreludeOpenPathSoundWhen.ok_singleton_source_state
          (hOpen := hCondOpen)
          (sourceState := (.Ok shared store : State))
          (compiler := compiler)
          (trace := condTrace) (sourceAfter := sourceAfter)
          (value := value)
          (SourceStateExactRel.toRel hInitial)
          (SourceStateExactRel.stateStoreContains hInitial)
          hResolveValues hCondAllowedOk
          hCondResponses with
      ⟨sharedAfter, storeAfter, hSourceAfter⟩
    subst sourceAfter
    exact Or.inr
      ⟨condTrace, suffix, sharedAfter, storeAfter, value, hTrace,
        hResolveValues, hSuffix⟩

