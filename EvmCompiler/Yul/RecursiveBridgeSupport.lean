                            StateCheckpointAllowed]
  | Checkpoint jump =>
      cases jump with
      | Continue shared store =>
          cases fuel with
          | zero =>
              simp [EvmYul.Yul.call, SourcePairResultCheckpointAllowed]
          | succ fuel' =>
              simp [EvmYul.Yul.call, EvmYul.Yul.State.sharedState,
