  lower :
    ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
      {freshState freshState' : Fresh.State} {argList : List AstExpr}
      {pre : List Functions.Stmt}
      {lowerArgs : List (Locals.Expr 1)},
