/--
Resource/control side condition for lifting `ExprEvalPreludeSoundOk`.

This is intentionally source-facing: when a related imported expression
evaluation succeeds, the result state is an ordinary Yul `Ok` state rather than
the historical success-valued `OutOfFuel` marker.
-/
def ExprEvalResultOkAt
    (cfg : StateRelConfig)
    (layout : List Name)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract) : Prop :=
  ∀ {source compiler sourceAfter value},
    SourceStateRel cfg layout source compiler →
    EvmYul.Yul.eval sourceFuel expr codeOverride source =
      .ok (sourceAfter, value) →
    ∃ sharedAfter storeAfter, sourceAfter = .Ok sharedAfter storeAfter

namespace ExprEvalResultOkAt

theorem lit
    {cfg : StateRelConfig} {layout : List Name} {sourceFuel : Nat}
    {value : Word} {codeOverride : Option AstContract} :
    ExprEvalResultOkAt cfg layout sourceFuel (.Lit value) codeOverride := by
  intro source compiler sourceAfter resultValue hInitial hEval
  cases hInitial with
  | @ok shared store _compiler _hShared _hVars =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
            EvmYul.Yul.head'] at hEval
      | succ _fuel =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
            EvmYul.Yul.head'] at hEval
          rcases hEval with ⟨hState, _hValue⟩
          subst sourceAfter
          exact ⟨shared, store, rfl⟩

theorem var
    {cfg : StateRelConfig} {layout : List Name} {sourceFuel : Nat}
    {name : EvmYul.Identifier} {codeOverride : Option AstContract} :
    ExprEvalResultOkAt cfg layout sourceFuel (.Var name) codeOverride := by
  intro source compiler sourceAfter resultValue hInitial hEval
  cases hInitial with
  | @ok shared store _compiler _hShared _hVars =>
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
            EvmYul.Yul.head'] at hEval
      | succ _fuel =>
          cases hLookup :
              EvmYul.Yul.State.lookup? name (.Ok shared store : State) with
          | none =>
              simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                EvmYul.Yul.head', hLookup] at hEval
          | some _value =>
              simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                EvmYul.Yul.head', hLookup] at hEval
              rcases hEval with ⟨hState, _hValue⟩
              subst sourceAfter
              exact ⟨shared, store, rfl⟩

end ExprEvalResultOkAt

theorem ExprEvalPreludeSoundOk.toSound
    {cfg : StateRelConfig}
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lower : Locals.Expr 1}
    (hSound :
      ExprEvalPreludeSoundOk cfg layout prim program ctx sourceFuel expr
        codeOverride pre lower)
    (hResultOk :
      ExprEvalResultOkAt cfg layout sourceFuel expr codeOverride) :
    ExprEvalPreludeSound cfg layout prim program ctx sourceFuel expr
      codeOverride pre lower := by
  intro source compiler sourceAfter value hInitial hEval
  rcases hResultOk hInitial hEval with
    ⟨sharedAfter, storeAfter, hStateEq⟩
  subst sourceAfter
  exact hSound hInitial hEval

theorem ExprEvalResultOkAt.of_stateCheckpointAllowed_relatable
    {cfg : StateRelConfig}
    {layout : List Name}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    (hStateAllowed :
      ∀ {source compiler sourceAfter value},
        SourceStateRel cfg layout source compiler →
        EvmYul.Yul.eval sourceFuel expr codeOverride source =
          .ok (sourceAfter, value) →
        StateCheckpointAllowed false false false sourceAfter)
    (hRelatable :
      ∀ {source compiler sourceAfter value},
        SourceStateRel cfg layout source compiler →
        EvmYul.Yul.eval sourceFuel expr codeOverride source =
          .ok (sourceAfter, value) →
        SourceResultRelatable (.ok sourceAfter)) :
    ExprEvalResultOkAt cfg layout sourceFuel expr codeOverride := by
  intro source compiler sourceAfter value hInitial hEval
  have hAllowed := hStateAllowed hInitial hEval
  have hRelatableOk := hRelatable hInitial hEval
  cases sourceAfter with
  | Ok sharedAfter storeAfter =>
      exact ⟨sharedAfter, storeAfter, rfl⟩
  | OutOfFuel =>
      exact False.elim
        (Reference.SourceBridgeFacts.sourceResultRelatable_stateOutOfFuel_false
          hRelatableOk)
  | Checkpoint jump =>
      cases jump <;>
        simp [StateCheckpointAllowed] at hAllowed

theorem ExprEvalResultOkAt.of_checkpointExpressionSound_relatable
    {cfg : StateRelConfig}
    {layout : List Name}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    (hCheckpoint :
      CheckpointExpressionSound)
    (hSafe : Safe.expr expr)
    (hInitialAllowed :
      ∀ {source compiler},
        SourceStateRel cfg layout source compiler →
        StateCheckpointAllowed false false false source)
    (hRelatable :
      ∀ {source compiler sourceAfter value},
        SourceStateRel cfg layout source compiler →
        EvmYul.Yul.eval sourceFuel expr codeOverride source =
          .ok (sourceAfter, value) →
        SourceResultRelatable (.ok sourceAfter)) :
    ExprEvalResultOkAt cfg layout sourceFuel expr codeOverride :=
  ExprEvalResultOkAt.of_stateCheckpointAllowed_relatable
    (by
      intro source compiler sourceAfter value hInitial hEval
      have hAllowed :
          SourcePairResultCheckpointAllowed false false false
            (EvmYul.Yul.eval sourceFuel expr codeOverride source) :=
        hCheckpoint.eval hSafe (hInitialAllowed hInitial)
      exact
        StateCheckpointAllowed.of_pair_result_ok hAllowed hEval)
    hRelatable

theorem ExprEvalPreludeSoundOk.toSound_of_stateCheckpointAllowed_relatable
    {cfg : StateRelConfig}
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lower : Locals.Expr 1}
    (hSound :
      ExprEvalPreludeSoundOk cfg layout prim program ctx sourceFuel expr
