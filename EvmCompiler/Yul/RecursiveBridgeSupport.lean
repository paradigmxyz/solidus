        (∃ sourceAfterArgs : State,
          ∃ argValues : List Word,
            EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
              .ok (sourceAfterArgs, argValues.reverse)) ∨
        (∃ err,
          EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
            .error err ∧
          sourceResult = .error err ∧
          SourceResultRelatable (.error err)))
    (hCallSuccess :
      ∀ {source compiler sourceResult sourceAfterArgs argValues},
        SourceStateExactRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel
            (.Block [.Let names (some (.Call (.inr functionName) args))])
            codeOverride source =
          sourceResult →
        EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
          .ok (sourceAfterArgs, argValues.reverse) →
        ∀ {compilerAfterInit compilerAfterPre compilerAfterArgs :
              Objects.Source.State}
          {ctxAfterPre : Functions.Source.Ctx} {preFuel : Nat},
          SourceStateRel cfg layout source compilerAfterInit →
          SourceVarsContains (identNames names) compilerAfterInit.vars →
          Functions.Source.Block.runOpen prim program
              { ctx with scope :=
                  (identNames names).reverse ++ ctx.scope }
              preFuel { stmts := pre } compilerAfterInit =
            .ok
              (Functions.Source.Outcome.regular compilerAfterPre,
                ctxAfterPre) →
          Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
            .ok (compilerAfterArgs, argValues) →
          SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
          ∃ sourceOutcome : Objects.Source.Outcome,
          ∃ ctxAfterCall : Functions.Source.Ctx,
          ∃ callFuel : Nat,
            Functions.Source.Block.runOpen prim program ctxAfterPre callFuel
                { stmts :=
                    [Functions.Stmt.call (identNames names) functionName
                      lowerArgs] }
                compilerAfterPre =
              .ok (sourceOutcome, ctxAfterCall) ∧
            SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
              sourceResult
              (match sourceOutcome.mode with
               | .regular =>
                  Functions.Source.Outcome.regular
                    (sourceOutcome.state.restrictTo ctx.scope)
               | .brk => sourceOutcome
               | .cont => sourceOutcome
               | .leave => sourceOutcome
               | .halt _kind => sourceOutcome)) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel
      [.Let names (some (.Call (.inr functionName) args))] codeOverride
      { stmts := Stmt.initNames (identNames names) ++ pre ++
          [Functions.Stmt.call (identNames names) functionName lowerArgs] }
