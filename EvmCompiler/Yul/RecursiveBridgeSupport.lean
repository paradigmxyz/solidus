/--
Exact-domain bounded target for the recursive imported-Yul bridge.

This is the induction target that matches the block/declaration proofs: imported
Yul observes the entire varstore domain for declarations, assignments, and block
cleanup, so the bridge boundary records that the imported varstore contains
exactly the visible source layout.  The top-level dispatcher can discharge this
from the empty/default initial varstore; recursive constructors preserve it as
part of their semantic proof.
-/
structure RecursiveSourceBridgeWhenUpToAtExact (cfg : StateRelConfig)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (bound : Nat) : Prop where
  stmt :
    ∀ {layout outcomeLayout : List Name} {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmt : AstStmt}
      {codeOverride : Option AstContract}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedStmtBlockLoweringSoundWhenFreshAtExact cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel sourceStmt
        codeOverride allowed
  block :
    ∀ {layout outcomeLayout : List Name} {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmts : List AstStmt}
      {codeOverride : Option AstContract}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedBlockLoweringSoundWhenFreshAtExact cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel sourceStmts
        codeOverride allowed

/--
Layout-compatible exact-domain recursive bridge.

The older `RecursiveSourceBridgeWhenUpToAtExact` quantifies over an arbitrary
`outcomeLayout`; that is too strong for recursive constructor proofs involving
`break`, `continue`, and `leave`.  This interface adds the missing fact that
every accepted imported result is compatible with the selected outcome layout.
It is the shape the successor induction should ultimately target.
-/
structure RecursiveSourceBridgeWhenUpToAtExactCompat (cfg : StateRelConfig)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (bound : Nat) : Prop where
  stmt :
    ∀ {layout outcomeLayout : List Name} {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmt : AstStmt}
      {codeOverride : Option AstContract}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedStmtBlockLoweringSoundWhenFreshAtExact cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel sourceStmt
        codeOverride allowed
  block :
    ∀ {layout outcomeLayout : List Name} {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmts : List AstStmt}
      {codeOverride : Option AstContract}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedBlockLoweringSoundWhenFreshAtExact cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel sourceStmts
        codeOverride allowed

/--
Names-aware layout-compatible exact-domain recursive bridge.

This is the recursive proof target we ultimately want for imported Yul:
`reserved` records source names already known to the fresh generator but not
necessarily visible in the current lexical layout. The semantic relation and
outcome compatibility remain stated over the visible `layout`.
-/
structure RecursiveSourceBridgeWhenUpToAtExactCompatNames
    (cfg : StateRelConfig)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (bound : Nat) : Prop where
  stmt :
    ∀ {reserved layout outcomeLayout : List Name}
      {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmt : AstStmt}
      {codeOverride : Option AstContract}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedStmtBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
        outcomeLayout terminalRel revertRel prim program ctx sourceFuel
        sourceStmt codeOverride allowed
  block :
    ∀ {reserved layout outcomeLayout : List Name}
      {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmts : List AstStmt}
      {codeOverride : Option AstContract}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
        outcomeLayout terminalRel revertRel prim program ctx sourceFuel
        sourceStmts codeOverride allowed

/--
Program-scoped names-aware exact recursive bridge.

The fully generic bridge above quantifies over an arbitrary `codeOverride`.
That is useful for code that is genuinely independent of the surrounding
contract, but user-function calls need a concrete Yul contract: the recursive
proof must align `contract.functions.lookup` with the compiled
`Functions.Program` table.  This is the contract-scoped induction boundary
used by the final dispatcher proof; it fixes `codeOverride` to the source
program's contract instead of pretending calls can be proved for unrelated
contracts.
-/
structure ProgramRecursiveSourceBridgeWhenUpToAtExactCompatNames
    (cfg : StateRelConfig)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (yulProgram : Program) (program : Functions.Program)
    (bound : Nat) : Prop where
  stmt :
    ∀ {reserved layout outcomeLayout : List Name}
      {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmt : AstStmt}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedStmtBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
        outcomeLayout terminalRel revertRel prim program ctx sourceFuel
        sourceStmt (some yulProgram.contract) allowed
  block :
    ∀ {reserved layout outcomeLayout : List Name}
      {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmts : List AstStmt}
      {allowed : Except Exception State → Prop},
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) →
      (∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult) →
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
        outcomeLayout terminalRel revertRel prim program ctx sourceFuel
        sourceStmts (some yulProgram.contract) allowed

/--
Program-level assumptions for the accepted Nethermind-Yul bridge.

The older recursive bridge targets above are intentionally very general: they
quantify over arbitrary statements and arbitrary code overrides.  The final
Nethermind-Yul theorem is not that broad. It is a theorem for one compiled,
accepted program, so safety, control-flow scoping, user-call arity, and the
chosen object lowering should be carried once at the program boundary instead
of rediscovered or exposed at every user-call lemma.
-/
structure ProgramBridgeContext
    (yulProgram : Program) (program : Functions.Program) : Prop where
  toObjects :
    yulProgram.toObjects? =
      some ({ root := Objects.Object.mk "root" program [] [] } :
        Objects.Program)
  safe : Safe.program yulProgram
  sourceScoped : SourceLexical.ProgramScoped yulProgram
  controlScoped : ControlFlow.ProgramScoped yulProgram
  noShadowing : Safe.NoShadowing.program yulProgram
  userCalls : UserCallArity.ProgramOk yulProgram
  checkpoint : CheckpointExpressionSound

theorem ProgramBridgeContext.dispatcher_facts
    {yulProgram : Program} {program : Functions.Program}
    (context : ProgramBridgeContext yulProgram program) :
    Safe.stmt yulProgram.contract.dispatcher ∧
      ControlFlow.ScopedStmt false false false
        yulProgram.contract.dispatcher ∧
      UserCallArity.StmtOk yulProgram.contract
        yulProgram.contract.dispatcher := by
  constructor
  · simpa [Safe.program, Safe.contract] using context.safe.1
  constructor
  · exact ControlFlow.program_scoped_dispatcher context.controlScoped
  · simpa [UserCallArity.ProgramOk, UserCallArity.ContractOk] using
      context.userCalls.1

theorem ProgramBridgeContext.function_body_facts_of_lookup
    {yulProgram : Program} {program : Functions.Program}
    (context : ProgramBridgeContext yulProgram program)
    {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    (hLookup :
      yulProgram.contract.functions.lookup functionName =
        some (.Def params returns body)) :
    Safe.stmts body ∧
      ControlFlow.ScopedStmts false false true body ∧
      UserCallArity.StmtsOk yulProgram.contract body := by
  constructor
  · exact SafeLookup.function_body_safe_of_contract_lookup
      context.safe hLookup
  constructor
  · exact ControlFlow.function_body_scoped_of_contract_lookup
      context.controlScoped hLookup
  · exact UserCallArity.program_lookup_bodyOk
      context.userCalls hLookup

theorem ProgramBridgeContext.dispatcher_source_scoped
    {yulProgram : Program} {program : Functions.Program}
    (context : ProgramBridgeContext yulProgram program) :
    SourceLexical.StmtScoped [] yulProgram.contract.dispatcher :=
  context.sourceScoped.1

theorem ProgramBridgeContext.function_body_source_scoped_of_lookup
    {yulProgram : Program} {program : Functions.Program}
    (context : ProgramBridgeContext yulProgram program)
    {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    (hLookup :
      yulProgram.contract.functions.lookup functionName =
        some (.Def params returns body)) :
    SourceLexical.StmtsScoped (identNames returns ++ identNames params)
      body :=
    SourceLexical.function_body_scoped_of_contract_lookup
      (program := yulProgram) (functionName := functionName)
      (params := params) (returns := returns) (body := body)
      context.sourceScoped hLookup

theorem ProgramBridgeContext.function_body_source_scoped_of_lookup_lower
    {yulProgram : Program} {program : Functions.Program}
    (context : ProgramBridgeContext yulProgram program)
    {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {lowerFn : Functions.FunDef}
    (hLookup :
      yulProgram.contract.functions.lookup functionName =
        some (.Def params returns body))
    (hLowerParams : lowerFn.params = identNames params)
    (hLowerReturns : lowerFn.returns = identNames returns) :
    SourceLexical.StmtsScoped (lowerFn.returns ++ lowerFn.params) body := by
  have hScoped := context.function_body_source_scoped_of_lookup hLookup
  simpa [hLowerReturns, hLowerParams] using hScoped

/--
CALL-capable variant of `ProgramBridgeContext`.

This is the context surface the ordinary-CALL recursive bridge should migrate
to.  It deliberately carries `Safe.CallSafe.program`, not old `Safe.program`,
so `.System.CALL` is admitted while account-code inspection, creation, and the
remaining external-call family members stay excluded by explicit feature
coverage.
