    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        (.ok (.Checkpoint (.Leave shared store)))) :
    ∀ name : Name, name ∈ outcomeLayout → name ∈ layout := by
  simpa [SourceResultOutcomeLayoutSupported] using hSupported.2

theorem of_compatible
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultOutcomeLayoutSupported]
  | ok source =>
      cases source with
      | Ok shared store =>
          intro name hMem
          have hEq : outcomeLayout = layout := by
            simpa [SourceResultOutcomeLayoutCompatible] using hCompat
          simpa [hEq] using hMem
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutSupported]
      | Checkpoint jump =>
          cases jump <;>
            simpa [SourceResultOutcomeLayoutSupported,
              SourceResultOutcomeLayoutCompatible] using hCompat

theorem to_compatible_of_not_regular_ok
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult)
    (hNotRegular : SourceResultNotRegularOk sourceResult) :
    SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simp [SourceResultOutcomeLayoutCompatible]
  | ok source =>
      cases source with
      | Ok shared store =>
          cases hNotRegular
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutCompatible]
      | Checkpoint jump =>
          cases jump <;>
            simpa [SourceResultOutcomeLayoutSupported,
              SourceResultOutcomeLayoutCompatible] using hSupported

theorem mono_layout
    {ctx : Functions.Source.Ctx} {layout layout' outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hSubset : ∀ name, name ∈ layout → name ∈ layout')
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutSupported ctx layout' outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultOutcomeLayoutSupported]
  | ok source =>
      cases source with
      | Ok shared store =>
          intro name hMem
          exact hSubset name (hSupported name hMem)
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutSupported]
      | Checkpoint jump =>
          cases jump <;>
            exact ⟨hSupported.1,
              fun name hMem => hSubset name (hSupported.2 name hMem)⟩

theorem of_handler_eq
    {ctx ctx' : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hBreak : ctx'.breakScope? = ctx.breakScope?)
    (hContinue : ctx'.continueScope? = ctx.continueScope?)
    (hLeave : ctx'.leaveScope? = ctx.leaveScope?)
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutSupported ctx' layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultOutcomeLayoutSupported]
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [SourceResultOutcomeLayoutSupported] using hSupported
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutSupported]
      | Checkpoint jump =>
          cases jump
          · simpa [SourceResultOutcomeLayoutSupported, hContinue] using
              hSupported
          · simpa [SourceResultOutcomeLayoutSupported, hBreak] using
              hSupported
          · simpa [SourceResultOutcomeLayoutSupported, hLeave] using
              hSupported

theorem of_restrictStoreTo
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {scope : EvmYul.Yul.VarStore} {sourceResult : Except Exception State}
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        (restrictSourceResultTo scope sourceResult)) :
    SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [restrictSourceResultTo, SourceResultOutcomeLayoutSupported]
        using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [restrictSourceResultTo, SourceResultOutcomeLayoutSupported,
            EvmYul.Yul.State.restrictStoreTo] using hSupported
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutSupported]
      | Checkpoint jump =>
          cases jump <;>
            simpa [restrictSourceResultTo,
              SourceResultOutcomeLayoutSupported,
              EvmYul.Yul.State.restrictStoreTo] using hSupported

theorem withoutLoopControl_of_supported_not_regular_no_loop
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult)
    (hNotRegular : SourceResultNotRegularOk sourceResult)
    (hNoBreak :
      ∀ {sharedBreak : EvmYul.SharedState .Yul}
        {storeBreak : EvmYul.Yul.VarStore},
        sourceResult =
          .ok (.Checkpoint (.Break sharedBreak storeBreak)) →
        False)
    (hNoContinue :
      ∀ {sharedContinue : EvmYul.SharedState .Yul}
        {storeContinue : EvmYul.Yul.VarStore},
        sourceResult =
          .ok (.Checkpoint (.Continue sharedContinue storeContinue)) →
        False) :
    SourceResultOutcomeLayoutSupported ctx.withoutLoopControl layout
      outcomeLayout sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultOutcomeLayoutSupported]
  | ok source =>
      cases source with
      | Ok shared store =>
          cases hNotRegular
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutSupported]
      | Checkpoint jump =>
          cases jump with
          | Continue sharedContinue storeContinue =>
              exact False.elim (hNoContinue rfl)
          | Break sharedBreak storeBreak =>
              exact False.elim (hNoBreak rfl)
          | Leave sharedLeave storeLeave =>
              simpa [SourceResultOutcomeLayoutSupported,
                Functions.Source.Ctx.withoutLoopControl] using hSupported

end SourceResultOutcomeLayoutSupported

/--
Source results whose outcome relation does not need an abrupt handler layout.

This is deliberately about imported results, not source syntax: a regular
state, terminal halt, revert, or error can reuse same-layout soundness under a
compatible outcome layout, but a checkpoint must be handled by the corresponding
break/continue/leave constructor.
-/
def SourceResultNoCheckpoint : Except Exception State → Prop
  | .ok (.Checkpoint _jump) => False
  | _ => True

/--
Source results that are not raw loop-control exits.

Whole `for` statements consume `break` and `continue` internally, but they may
still stop by `leave`, halt, revert, or imported errors.  This predicate is the
local filter used when an ordinary leave-layout theorem is reused under typed
continuations.
-/
def SourceResultNoLoopControl : Except Exception State → Prop
  | .ok (.Checkpoint (.Break _ _)) => False
  | .ok (.Checkpoint (.Continue _ _)) => False
  | _ => True

namespace SourceResultModeKontSupported

theorem block_of_outcome_supported_no_loop
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult)
    (hNoLoop : SourceResultNoLoopControl sourceResult) :
    SourceResultModeKontSupported ctx layout
      (SourceModeKontLayouts.block layout outcomeLayout) sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultModeKontSupported]
  | ok source =>
      cases source with
      | Ok shared store =>
          exact
            block_regular (ctx := ctx) (layout := layout)
              (outcomeLayout := outcomeLayout)
      | OutOfFuel =>
          simp [SourceResultModeKontSupported]
      | Checkpoint jump =>
          cases jump with
          | Continue shared store =>
              cases hNoLoop
          | Break shared store =>
              cases hNoLoop
          | Leave shared store =>
              simpa [SourceResultModeKontSupported,
                SourceResultOutcomeLayoutSupported,
                SourceModeKontLayouts.block] using hSupported

end SourceResultModeKontSupported

namespace SourceResultOutcomeRel

theorem to_kont_of_supported_within
    {cfg : StateRelConfig} {layout : List Name}
    {konts : SourceModeKontLayouts} {ctx : Functions.Source.Ctx}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceResult : Except Exception State}
    {sourceOutcome : Objects.Source.Outcome}
    (hSupported :
      SourceResultModeKontSupported ctx layout konts sourceResult)
    (hWithin : SourceModeKontLayouts.ControlWithin layout konts)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        sourceOutcome) :
    SourceResultKontOutcomeRel cfg konts terminalRel revertRel sourceResult
      sourceOutcome := by
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hState =>
          cases hState with
          | ok hShared hVars =>
              have hSubset :
                  ∀ name : Name, name ∈ konts.regular → name ∈ layout := by
                simpa [SourceResultModeKontSupported] using hSupported
              exact SourceResultKontOutcomeRel.ok
                (SourceOkKontOutcomeRel.regular
                  (SourceStateRel.ok hShared
                    (by
                      intro name hMem
                      exact hVars name (hSubset name hMem))))
      | brk hState =>
          exact SourceResultKontOutcomeRel.ok
            (SourceOkKontOutcomeRel.brk
              (sourceStateRel_weaken_sameCompiler hState
                (by
                  intro name hMem
                  exact hWithin.brk name hMem)))
      | cont hState =>
          exact SourceResultKontOutcomeRel.ok
            (SourceOkKontOutcomeRel.cont
              (sourceStateRel_weaken_sameCompiler hState
                (by
                  intro name hMem
                  exact hWithin.cont name hMem)))
      | leave hState =>
          exact SourceResultKontOutcomeRel.ok
            (SourceOkKontOutcomeRel.leave
              (sourceStateRel_weaken_sameCompiler hState
                (by
                  intro name hMem
                  exact hSupported.2 name hMem)))
  | yulHalt hTerminal =>
      exact SourceResultKontOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact SourceResultKontOutcomeRel.revert hRevert

theorem to_kont_of_supported_no_checkpoint
    {cfg : StateRelConfig} {layout : List Name}
    {konts : SourceModeKontLayouts} {ctx : Functions.Source.Ctx}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceResult : Except Exception State}
    {sourceOutcome : Objects.Source.Outcome}
    (hSupported :
      SourceResultModeKontSupported ctx layout konts sourceResult)
    (hNoCheckpoint : SourceResultNoCheckpoint sourceResult)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        sourceOutcome) :
    SourceResultKontOutcomeRel cfg konts terminalRel revertRel sourceResult
      sourceOutcome := by
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hState =>
          cases hState with
          | ok hShared hVars =>
              have hSubset :
                  ∀ name : Name, name ∈ konts.regular → name ∈ layout := by
                simpa [SourceResultModeKontSupported] using hSupported
              exact
                SourceResultKontOutcomeRel.ok
                  (SourceOkKontOutcomeRel.regular
                    (SourceStateRel.ok hShared
                      (by
                        intro name hMem
                        exact hVars name (hSubset name hMem))))
      | brk hState =>
          cases hNoCheckpoint
      | cont hState =>
          cases hNoCheckpoint
      | leave hState =>
          cases hNoCheckpoint
  | yulHalt hTerminal =>
      exact SourceResultKontOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact SourceResultKontOutcomeRel.revert hRevert

end SourceResultOutcomeRel

theorem SourceResultRelatable.of_restrictStoreTo
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    (hRelatable :
      SourceResultRelatable
        (match sourceResult with
         | .ok source => .ok (source.restrictStoreTo scope)
         | .error err => .error err)) :
    SourceResultRelatable sourceResult := by
  cases sourceResult with
  | error err =>
      cases err <;> simpa [SourceResultRelatable] using hRelatable
  | ok source =>
      cases source <;>
        simpa [SourceResultRelatable, EvmYul.Yul.State.restrictStoreTo]
          using hRelatable

theorem SourceResultRelatable.restrictStoreTo
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    (hRelatable : SourceResultRelatable sourceResult) :
    SourceResultRelatable (restrictSourceResultTo scope sourceResult) := by
  cases sourceResult with
  | error err =>
      cases err <;> simpa [restrictSourceResultTo, SourceResultRelatable]
        using hRelatable
  | ok source =>
      cases source with
      | Ok shared store =>
          simp [restrictSourceResultTo, SourceResultRelatable,
            EvmYul.Yul.State.restrictStoreTo]
      | OutOfFuel =>
          exact False.elim
            (sourceResultRelatable_stateOutOfFuel_false hRelatable)
      | Checkpoint jump =>
          cases jump <;>
            simp [restrictSourceResultTo, SourceResultRelatable,
              EvmYul.Yul.State.restrictStoreTo]

theorem SourceResultOutcomeLayoutCompatible.restrictStoreTo
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {scope : EvmYul.Yul.VarStore} {sourceResult : Except Exception State}
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
