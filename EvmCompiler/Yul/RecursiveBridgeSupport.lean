def SourceArgStackPreludeOpenDoneRel
    (cfg : StateRelConfig) (layout : List Name) :
    Except EvmYul.Yul.Exception (State × List Word) →
      Except Functions.EVMException SourceArgPreludeOpenTarget → Prop
  | .ok sourceResult, .ok target =>
      SourceStateRel cfg layout sourceResult.1 target.state ∧
        sourceResult.2 = target.values
  | _, _ => False

/--
Terminal-aware generated-expression completion relation.

Successful source expressions reuse the strict value relation.  Source
`YulHalt` and `Revert` errors correspond only to stopped target preludes with
the matching target halt mode and post-stop compiler state.  Generated
expression preludes are not allowed to leak `break`, `continue`, or `leave`.
-/
def SourceExprRawPreludeOpenDoneRel
    (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop) :
    Except Exception (State × List Word) →
      Except Functions.EVMException SourceExprPreludeOpen.RawTarget → Prop
  | .ok sourceResult, .ok (.values target) =>
      SourceArgStackPreludeOpenDoneRel cfg layout (.ok sourceResult)
        (.ok target)
  | .error (.YulHalt source value), .ok (.stopped (targetOutcome, _)) =>
      match targetOutcome.mode with
      | .halt kind => terminalRel kind value source targetOutcome.state
      | .regular | .brk | .cont | .leave => False
  | .error (.Revert source), .ok (.stopped (targetOutcome, _)) =>
      match targetOutcome.mode with
      | .halt .revert => revertRel source targetOutcome.state
      | .regular | .brk | .cont | .leave | .halt _ => False
  | _, _ => False

/--
One opaque external response is admissible independently of continuation
shape when its reentrant state transformer preserves every already-related
Yul/compiler shared-state pair and leaves the suspended target caller's
installed execution code unchanged.

This is a proof-only certificate, not a concrete outside-world model. The
status word and return data remain arbitrary, and the internal mutation may
replace caller-visible chain state arbitrarily so long as both semantic sides
remain related afterward. The target code/permission stability clauses rule
out only false caller-frame mutations that real EVM call return cannot perform.
-/
structure RelationallyAdmissibleOpenResponse
    (cfg : StateRelConfig) (response : OpenExternal.CallResponse) : Prop :=
  rel :
    ∀ {sourceShared : EvmYul.SharedState .Yul}
      {compilerShared : EvmYul.SharedState .EVM},
      Reference.SharedStateRel cfg sourceShared compilerShared →
        Reference.SharedStateRel.ExternalResponseRelAt cfg sourceShared
          compilerShared response
  targetCodeStable :
    ∀ {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM},
    Reference.SharedStateRel cfg sourceShared compilerShared →
      (response.internalMutation.apply compilerShared.toState).executionEnv.code =
        compilerShared.executionEnv.code
  targetPermStable :
    ∀ {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM},
    Reference.SharedStateRel cfg sourceShared compilerShared →
      (response.internalMutation.apply compilerShared.toState).executionEnv.perm =
        compilerShared.executionEnv.perm

instance RelationallyAdmissibleOpenResponse.instCoeFun
    {cfg : StateRelConfig} {response : OpenExternal.CallResponse} :
    CoeFun (RelationallyAdmissibleOpenResponse cfg response)
      (fun _ =>
        ∀ {sourceShared : EvmYul.SharedState .Yul}
          {compilerShared : EvmYul.SharedState .EVM},
          Reference.SharedStateRel cfg sourceShared compilerShared →
            Reference.SharedStateRel.ExternalResponseRelAt cfg sourceShared
              compilerShared response) where
  coe hResponse := hResponse.rel

theorem RelationallyAdmissibleOpenResponse.target_code_stable
    {cfg : StateRelConfig} {response : OpenExternal.CallResponse}
    (hResponse : RelationallyAdmissibleOpenResponse cfg response)
    {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared compilerShared) :
    (response.internalMutation.apply compilerShared.toState).executionEnv.code =
      compilerShared.executionEnv.code :=
  hResponse.targetCodeStable hShared

theorem RelationallyAdmissibleOpenResponse.evmOpenCall_resume_code_stable
    {cfg : StateRelConfig} {response : OpenExternal.CallResponse}
    {sourceShared : EvmYul.SharedState .Yul}
    {target : EvmYul.EVM.State}
    {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EvmYul.EVM.State}
    (hResponse : RelationallyAdmissibleOpenResponse cfg response)
    (hShared :
      Reference.SharedStateRel cfg sourceShared target.toSharedState)
    (hCall :
      OpenExternal.CallKind.evmOpenCall? target kind = some call) :
    (call.resume response).executionEnv.code =
      target.executionEnv.code := by
  unfold OpenExternal.CallKind.evmOpenCall? at hCall
  cases hSite : OpenExternal.CallKind.evmCallSite? target kind with
  | none =>
      simp [hSite] at hCall
  | some pair =>
      rcases pair with ⟨rest, site⟩
      simp [hSite] at hCall
      cases hCall
      simp [OpenExternal.CallSite.finishShared,
        RelationallyAdmissibleOpenResponse.target_code_stable hResponse hShared]

theorem RelationallyAdmissibleOpenResponse.target_perm_stable
    {cfg : StateRelConfig} {response : OpenExternal.CallResponse}
    (hResponse : RelationallyAdmissibleOpenResponse cfg response)
    {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared compilerShared) :
    (response.internalMutation.apply compilerShared.toState).executionEnv.perm =
