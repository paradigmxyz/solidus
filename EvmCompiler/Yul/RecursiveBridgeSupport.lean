/--
Direct user-call arguments are now only the empty fast path.

The old direct path tried to evaluate direct arguments in source order on the
compiler side while imported Yul evaluates user-call arguments tail-first.  That
requires a purity/commutation theorem for every direct expression.  The compiler
now sends every nonempty argument list through `lowerBound1?`, so the direct
branch is the trivial empty list and the semantic proof is definitionally small.
-/
theorem sourceArgListPreludeRegularAt_of_directCallArgsSafe
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {lowerArgs : List (Locals.Expr 1)}
    (hDirect : Expr.List.directCallArgsSafe? args = true)
    (hLower : Expr.List.toLocals1? args = some lowerArgs) :
    SourceArgListPreludeRegularAt cfg layout prim program ctx sourceFuel args
      codeOverride [] lowerArgs := by
  cases args with
  | nil =>
      simp [Expr.List.toLocals1?] at hLower
      cases hLower
      refine ⟨by simp, ?_⟩
      intro source compiler sourceAfter values hInitial hEval
      cases sourceFuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
      | succ fuel =>
          have hPair :
              (source, []) = (sourceAfter, values.reverse) := by
            simpa [EvmYul.Yul.evalArgs] using hEval
          injection hPair with hSource hValuesRev
          subst sourceAfter
          have hValues : values = [] := by
            have hRev := congrArg List.reverse hValuesRev
            simpa using hRev
          subst values
          exact
            ⟨compiler, compiler, ctx, 1,
              by simp [Functions.Source.Block.runOpen],
              by simp [Functions.Source.ArgList.eval],
              hInitial⟩
  | cons head tail =>
      simp [Expr.List.directCallArgsSafe?] at hDirect

/--
Bundle constructor for the argument-regularity interface.

The direct-argument branch can be supplied by whichever caller-specific
direct-expression theorem is appropriate, while the generated-argument branch
is discharged uniformly from `Expr.List.lowerBound1?` and single-expression
regularity.
-/
theorem sourceArgListPreludeRegularAllAt_of_direct_lowerBound1?_exprEvalSound_covers
    {cfg : StateRelConfig} {layout coverLayout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program}
    {codeOverride : Option AstContract} {maxFuel : Nat}
    (hLayoutSubset : ∀ name, name ∈ layout → name ∈ coverLayout)
    (hDirect :
      ∀ {argFuel : Nat} {ctxArg : Functions.Source.Ctx}
        {freshState : Fresh.State} {argList : List AstExpr}
        {lowerArgs : List (Locals.Expr 1)},
        argFuel ≤ maxFuel →
        FreshCoversLayout coverLayout freshState →
        Expr.List.directCallArgsSafe? argList = true →
        Expr.List.toLocals1? argList = some lowerArgs →
        SourceArgListPreludeRegularAt cfg layout prim program ctxArg argFuel
          argList codeOverride [] lowerArgs)
    (hExpr :
      ∀ {exprState exprState' : Fresh.State} {expr : AstExpr}
        {exprPre : List Functions.Stmt} {lowerExpr : Locals.Expr 1},
        FreshCoversLayout coverLayout exprState →
        Expr.lower1? exprState expr =
          some (exprPre, lowerExpr, exprState') →
        ∀ {exprFuel : Nat} {ctxExpr : Functions.Source.Ctx},
          ExprEvalPreludeSound cfg layout prim program ctxExpr exprFuel expr
            codeOverride exprPre lowerExpr) :
    SourceArgListPreludeRegularAllAt cfg layout prim program codeOverride
      coverLayout maxFuel :=
  ⟨fun hFuel hCovers hSafe hToLocals =>
      hDirect hFuel hCovers hSafe hToLocals,
   fun _hFuel hCovers _hSafe hLower =>
      sourceArgListPreludeRegularAt_of_lowerBound1?_exprEvalSound_covers
        (cfg := cfg) (coverLayout := coverLayout) (layout := layout)
        (prim := prim) (program := program)
        (codeOverride := codeOverride) hLayoutSubset hExpr hCovers hLower⟩

/--
Compiler-derived constructor for the argument-regularity interface.

The direct user-call argument path is now empty-only, and every nonempty list is
proved by the generated `lowerBound1?` induction theorem.  This is the public
constructor the recursive successor proof should consume; it does not expose a
caller-supplied direct-argument proof oracle.
-/
theorem sourceArgListPreludeRegularAllAt_of_lowerBound1?_exprEvalSound_covers
    {cfg : StateRelConfig} {layout coverLayout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program}
    {codeOverride : Option AstContract} {maxFuel : Nat}
    (hLayoutSubset : ∀ name, name ∈ layout → name ∈ coverLayout)
    (hExpr :
      ∀ {exprState exprState' : Fresh.State} {expr : AstExpr}
        {exprPre : List Functions.Stmt} {lowerExpr : Locals.Expr 1},
        FreshCoversLayout coverLayout exprState →
        Expr.lower1? exprState expr =
          some (exprPre, lowerExpr, exprState') →
        ∀ {exprFuel : Nat} {ctxExpr : Functions.Source.Ctx},
          ExprEvalPreludeSound cfg layout prim program ctxExpr exprFuel expr
            codeOverride exprPre lowerExpr) :
    SourceArgListPreludeRegularAllAt cfg layout prim program codeOverride
      coverLayout maxFuel :=
  sourceArgListPreludeRegularAllAt_of_direct_lowerBound1?_exprEvalSound_covers
    (cfg := cfg) (layout := layout) (coverLayout := coverLayout)
    (prim := prim) (program := program) (codeOverride := codeOverride)
    (maxFuel := maxFuel) hLayoutSubset
    (by
      intro argFuel ctxArg freshState argList lowerArgs _hFuel _hCovers
        hDirect hToLocals
      exact
        sourceArgListPreludeRegularAt_of_directCallArgsSafe
          (cfg := cfg) (layout := layout) (prim := prim) (program := program)
          (ctx := ctxArg) (sourceFuel := argFuel)
          (args := argList) (codeOverride := codeOverride)
          (lowerArgs := lowerArgs) hDirect hToLocals)
    hExpr

/--
Scoped compiler-derived constructor for the regular argument-prelude interface.

This is the constructor the recursive Yul bridge should use once lexical
source scoping has been threaded to the call site.  It keeps the direct
empty-argument fast path and discharges generated nonempty argument lists from
`Expr.List.lowerBound1?`, but the expression theorem now receives the
source-visible `SourceExprScoped` premise required by variable reads.
-/
theorem sourceArgListPreludeRegularAllScopedAt_of_lowerBound1?_exprEvalSound_scoped_covers
    {cfg : StateRelConfig} {layout coverLayout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program}
    {codeOverride : Option AstContract} {maxFuel : Nat}
    (hLayoutSubset : ∀ name, name ∈ layout → name ∈ coverLayout)
    (hExpr :
      ∀ {exprState exprState' : Fresh.State} {expr : AstExpr}
        {exprPre : List Functions.Stmt} {lowerExpr : Locals.Expr 1},
        FreshCoversLayout coverLayout exprState →
        SourceExprScoped layout expr →
        Expr.lower1? exprState expr =
          some (exprPre, lowerExpr, exprState') →
        ∀ {exprFuel : Nat} {ctxExpr : Functions.Source.Ctx},
          ExprEvalPreludeSound cfg layout prim program ctxExpr exprFuel expr
            codeOverride exprPre lowerExpr) :
    SourceArgListPreludeRegularAllScopedAt cfg layout prim program codeOverride
      coverLayout maxFuel :=
  ⟨fun {argFuel} {ctxArg} {_freshState} {argList} {lowerArgs}
        _hFuel _hCovers hDirect hToLocals =>
      sourceArgListPreludeRegularAt_of_directCallArgsSafe
        (cfg := cfg) (layout := layout) (prim := prim) (program := program)
        (ctx := ctxArg) (sourceFuel := argFuel)
