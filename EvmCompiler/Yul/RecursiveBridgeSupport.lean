  cases hRel with
  | ok _hShared hVars hDomain =>
      exact
        sourceStoreRel_lookupMany_of_domain
          (layout := layout) (returns := returns) (shared := shared)
          (store := store) (vars := source.vars) hVars hDomain hReturns

