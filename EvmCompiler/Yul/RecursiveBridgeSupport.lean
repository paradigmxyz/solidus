              (by
                simpa [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid] using hTargetOpen)
        | succ targetFuel' =>
            cases sourceOutcome with
            | mk outcomeState outcomeMode =>
                cases outcomeMode <;>
                  simp [outerOutcome, Functions.Source.Block.runScoped,
                    hTargetOpen, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular]
      have hRelOuter :
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (wrap innerResult) outerOutcome := by
        cases hResult : innerResult with
        | error err =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | yulHalt hTerminal =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.yulHalt
                    (cfg := cfg) (layout := outcomeLayout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hTerminal)
            | revert hRevert =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.revert
                    (cfg := cfg) (layout := outcomeLayout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hRevert)
        | ok innerState =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                    case ok compilerAfter sharedAfter storeAfter
                        hSharedAfter hVarsAfter =>
                        have hFinalCompat :
                            SourceResultOutcomeLayoutCompatible ctx layout
                              outcomeLayout (wrap innerResult) := by
                          exact hCompat (by
                            change allowed (wrap innerResult)
                            exact hAllowInner)
                        have hOutcomeLayout : outcomeLayout = layout := by
                          simpa [SourceResultOutcomeLayoutCompatible, wrap,
                            hResult, EvmYul.Yul.State.restrictStoreTo] using
                            hFinalCompat
                        subst outcomeLayout
                        have hStoreScopeContains :
                            ∀ name, name ∈ layout →
                              (scope.lookup name).isSome = true := by
                          intro name hMem
                          exact (hDomain name).mpr hMem
                        have hImportedRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              compilerAfter := by
                          exact
                            SourceStateRel.restrictStoreTo_of_scope_contains
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hStoreScopeContains
                        have hRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (compilerAfter.restrictTo ctx.scope) := by
                          exact
                            SourceStateRel.restrictCompilerTo_of_subset
                              hImportedRestricted
                              hScopeContains
                        simpa [outerOutcome, wrap, hResult] using
                          (SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular hRestricted))
                | brk hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hBreakCompat :
                        ctx.breakScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hBreakCompat with ⟨_hBreak, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.brk hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | cont hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hContinueCompat :
                        ctx.continueScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hContinueCompat with
                      ⟨_hContinue, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.cont hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | leave hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hLeaveCompat :
                        ctx.leaveScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hLeaveCompat with ⟨_hLeave, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.leave hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
      exact ⟨outerOutcome, targetFuel, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

/--
Hidden-scope scoped-block soundness with typed mode continuations.

This is the continuation-layout sibling of
`sourceResultBlockSoundWhenAtExactHiddenScope_of_hiddenCtx_compat`.  It keeps
the block-cleanup proof at the block boundary, while the open sequence carries
separate layouts for regular, break, continue, and leave exits.
-/
def SourceResultBlockKontSoundWhenAtExactHiddenScope
    (cfg : StateRelConfig) (layout : List Name)
    (konts : SourceModeKontLayouts)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat)
    (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) :
    Prop :=
  ∀ {source compiler sourceResult},
    SourceStateExactRel cfg layout source compiler →
    allowed sourceResult →
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      sourceResult →
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ targetFuel,
      Functions.Source.Block.runScoped prim program ctx lowerBlock
          targetFuel compiler =
        .ok sourceOutcome ∧
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        sourceResult sourceOutcome

/--
Close a hidden-context continuation sequence into a scoped block for the
block-shaped continuation layout.
-/
theorem sourceResultBlockKontSoundWhenAtExactHiddenScope_of_seqKont_block_supported
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hSupported :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultModeKontSupported ctx layout
          (SourceModeKontLayouts.block layout outcomeLayout) sourceResult)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hSeq :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultModeKontSupported ctx layout
            (SourceModeKontLayouts.block layout outcomeLayout)
            sourceResult) →
        SourceResultSeqKontSoundWhenAtExactHiddenCtx cfg layout
          (SourceModeKontLayouts.block layout outcomeLayout)
          terminalRel revertRel prim program ctx sourceFuel body codeOverride
          lowerBody allowedInner) :
    SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout
      (SourceModeKontLayouts.block layout outcomeLayout) terminalRel revertRel
      prim program ctx sourceFuel.succ body codeOverride lowerBody allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared scope compiler hShared hVars hDomain =>
      let innerResult : Except Exception State :=
        EvmYul.Yul.execSeq sourceFuel body codeOverride
          (.Ok shared scope : State)
      let wrap : Except Exception State → Except Exception State :=
        fun result => restrictSourceResultTo scope result
      have hOuter :
          EvmYul.Yul.exec sourceFuel.succ (.Block body) codeOverride
              (.Ok shared scope : State) =
            wrap innerResult := by
        unfold innerResult wrap
        cases hExec :
            EvmYul.Yul.execSeq sourceFuel body codeOverride
              (.Ok shared scope : State) with
        | error err =>
            simp [restrictSourceResultTo, EvmYul.Yul.exec, hExec]
        | ok state =>
            cases state <;>
              simp [restrictSourceResultTo, EvmYul.Yul.exec,
                EvmYul.Yul.State.store, hExec]
      have hWrapEq : wrap innerResult = sourceResult := by
        simpa [hOuter] using hSource
      let allowedInner : Except Exception State → Prop :=
        fun result => allowed (wrap result)
      have hAllowInner : allowedInner innerResult := by
        change allowed (wrap innerResult)
        simpa [hWrapEq] using hAllow
      have hAllowedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultRelatable sourceResult := by
        intro sourceResult hAllowedWrapped
        change allowed (wrap sourceResult) at hAllowedWrapped
        exact
          SourceResultRelatable.of_restrictStoreTo
            (scope := scope) (sourceResult := sourceResult)
            (by
              change SourceResultRelatable (wrap sourceResult)
              exact hAllowed hAllowedWrapped)
      have hSupportedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultModeKontSupported ctx layout
              (SourceModeKontLayouts.block layout outcomeLayout)
              sourceResult := by
        intro sourceResult hAllowedWrapped
        change allowed (wrap sourceResult) at hAllowedWrapped
        exact
          SourceResultModeKontSupported.of_restrictStoreTo
            (ctx := ctx) (currentLayout := layout)
            (konts := SourceModeKontLayouts.block layout outcomeLayout)
            (scope := scope) (sourceResult := sourceResult)
            (by
              change
                SourceResultModeKontSupported ctx layout
                  (SourceModeKontLayouts.block layout outcomeLayout)
                  (wrap sourceResult)
              exact hSupported hAllowedWrapped)
      rcases (hSeq (allowedInner := allowedInner) hAllowedInner
          hSupportedInner)
          (SourceStateExactRel.ok hShared hVars hDomain)
          hAllowInner (by rfl) with
        ⟨sourceOutcome, _ctxAfter, targetFuel, hTargetOpen, hRelInner⟩
      let outerOutcome : Objects.Source.Outcome :=
        match sourceOutcome.mode with
        | .regular =>
            Functions.Source.Outcome.regular
              (sourceOutcome.state.restrictTo ctx.scope)
        | .brk | .cont | .leave | .halt _ => sourceOutcome
      have hTargetOuter :
          Functions.Source.Block.runScoped prim program ctx lowerBody targetFuel
              compiler =
            .ok outerOutcome := by
        cases targetFuel with
        | zero =>
            exact False.elim
              (by
                simpa [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid] using hTargetOpen)
        | succ targetFuel' =>
            cases sourceOutcome with
            | mk outcomeState outcomeMode =>
                cases outcomeMode <;>
                  simp [outerOutcome, Functions.Source.Block.runScoped,
                    hTargetOpen, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular]
      have hRelOuter :
          SourceResultKontOutcomeRel cfg
            (SourceModeKontLayouts.block layout outcomeLayout)
            terminalRel revertRel (wrap innerResult) outerOutcome := by
        cases hResult : innerResult with
        | error err =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | yulHalt hTerminal =>
                simpa [outerOutcome, wrap, restrictSourceResultTo, hResult]
                  using
                    (SourceResultKontOutcomeRel.yulHalt
                      (cfg := cfg)
                      (konts :=
                        SourceModeKontLayouts.block layout outcomeLayout)
                      (terminalRel := terminalRel) (revertRel := revertRel)
                      hTerminal)
            | revert hRevert =>
                simpa [outerOutcome, wrap, restrictSourceResultTo, hResult]
                  using
                    (SourceResultKontOutcomeRel.revert
                      (cfg := cfg)
                      (konts :=
                        SourceModeKontLayouts.block layout outcomeLayout)
                      (terminalRel := terminalRel) (revertRel := revertRel)
                      hRevert)
        | ok innerState =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                    case ok compilerAfter sharedAfter storeAfter
                        hSharedAfter hVarsAfter =>
                        have hStoreScopeContains :
                            ∀ name, name ∈ layout →
                              (scope.lookup name).isSome = true := by
                          intro name hMem
                          exact (hDomain name).mpr hMem
                        have hImportedRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              compilerAfter := by
                          exact
                            SourceStateRel.restrictStoreTo_of_scope_contains
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hStoreScopeContains
                        have hRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (compilerAfter.restrictTo ctx.scope) := by
                          exact
                            SourceStateRel.restrictCompilerTo_of_subset
                              hImportedRestricted hScopeContains
                        simpa [outerOutcome, wrap, restrictSourceResultTo,
                          hResult, SourceModeKontLayouts.block] using
                          (SourceResultKontOutcomeRel.ok
                            (SourceOkKontOutcomeRel.regular hRestricted))
                | @brk sharedAfter storeAfter compilerAfter hRelState =>
                    have hStoreScopeContains :
                        ∀ name, name ∈ layout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr hMem
                    have hRelRestricted :
                        SourceStateRel cfg layout
                          (EvmYul.Yul.State.restrictStoreTo scope
                            (.Ok sharedAfter storeAfter : State))
                          compilerAfter := by
                      exact
                        SourceStateRel.restrictStoreTo_of_scope_contains
                          (by
                            simpa [SourceModeKontLayouts.block] using
                              hRelState)
                          hStoreScopeContains
                    simpa [outerOutcome, wrap, restrictSourceResultTo,
                      hResult, SourceModeKontLayouts.block] using
                      (SourceResultKontOutcomeRel.ok
                        (SourceOkKontOutcomeRel.brk hRelRestricted))
                | @cont sharedAfter storeAfter compilerAfter hRelState =>
                    have hStoreScopeContains :
                        ∀ name, name ∈ layout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr hMem
                    have hRelRestricted :
                        SourceStateRel cfg layout
                          (EvmYul.Yul.State.restrictStoreTo scope
                            (.Ok sharedAfter storeAfter : State))
                          compilerAfter := by
                      exact
                        SourceStateRel.restrictStoreTo_of_scope_contains
                          (by
                            simpa [SourceModeKontLayouts.block] using
                              hRelState)
                          hStoreScopeContains
                    simpa [outerOutcome, wrap, restrictSourceResultTo,
                      hResult, SourceModeKontLayouts.block] using
                      (SourceResultKontOutcomeRel.ok
                        (SourceOkKontOutcomeRel.cont hRelRestricted))
                | @leave sharedAfter storeAfter compilerAfter hRelState =>
                    have hFinalSupported :
                        SourceResultModeKontSupported ctx layout
                          (SourceModeKontLayouts.block layout outcomeLayout)
                          (wrap innerResult) := by
                      exact hSupported (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hLeaveSubset :
                        ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      have hLeaveInfo :
                          ctx.leaveScope? = some outcomeLayout ∧
                            ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                        simpa [SourceResultModeKontSupported,
                          SourceModeKontLayouts.block, wrap,
                          restrictSourceResultTo, hResult,
                          EvmYul.Yul.State.restrictStoreTo] using
                          hFinalSupported
                      exact hLeaveInfo.2
                    have hStoreScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hLeaveSubset name hMem)
                    have hRelRestricted :
                        SourceStateRel cfg outcomeLayout
                          (EvmYul.Yul.State.restrictStoreTo scope
                            (.Ok sharedAfter storeAfter : State))
                          compilerAfter := by
                      exact
                        SourceStateRel.restrictStoreTo_of_scope_contains
                          (by
                            simpa [SourceModeKontLayouts.block] using
                              hRelState)
                          hStoreScopeContains
                    simpa [outerOutcome, wrap, restrictSourceResultTo,
                      hResult, SourceModeKontLayouts.block] using
                      (SourceResultKontOutcomeRel.ok
                        (SourceOkKontOutcomeRel.leave hRelRestricted))
      exact ⟨outerOutcome, targetFuel, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

theorem sourceResultBlockSoundWhenAtExactHiddenScope_of_blockKont_supported
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hSupported :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
          sourceResult)
    (hBlock :
      SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout
        (SourceModeKontLayouts.block layout outcomeLayout) terminalRel
        revertRel prim program ctx sourceFuel body codeOverride lowerBody
        allowed) :
    SourceResultBlockSoundWhenAtExactHiddenScope cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel body codeOverride
      lowerBody allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hBlock hInitial hAllow hSource with
    ⟨sourceOutcome, targetFuel, hRun, hRel⟩
  exact
    ⟨sourceOutcome, targetFuel, hRun,
      SourceResultKontOutcomeRel.to_outcome_block_supported hRel
        (hSupported hAllow)⟩

/--
Extract a regular successful block run from typed-continuation hidden-scope
block soundness.

The continuation interface records the regular result at `konts.regular`.  When
that regular continuation is the current source layout, a separate domain proof
upgrades the result back to the exact relation needed by regular statement-head
composition.
-/
theorem SourceResultBlockKontSoundWhenAtExactHiddenScope.ok_regular_exact
    {cfg : StateRelConfig} {layout : List Name}
    {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {source compiler}
    {sharedAfter : EvmYul.SharedState .Yul}
    {storeAfter : EvmYul.Yul.VarStore}
    (hRegular : konts.regular = layout)
    (hBlock :
      SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout konts
        terminalRel revertRel prim program ctx sourceFuel body codeOverride
        lowerBlock
        (fun result =>
          result = (.ok (.Ok sharedAfter storeAfter) :
            Except Exception State)))
    (hInitial : SourceStateExactRel cfg layout source compiler)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride source =
        .ok (.Ok sharedAfter storeAfter))
    (hDomainAfter : StoreDomainExact layout storeAfter) :
    ∃ compilerAfter : Objects.Source.State,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runScoped prim program ctx lowerBlock
          targetFuel compiler =
        .ok (Functions.Source.Outcome.regular compilerAfter) ∧
      SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfter := by
  rcases hBlock hInitial rfl hSource with
    ⟨sourceOutcome, targetFuel, hRun, hRel⟩
  cases sourceOutcome with
  | mk outcomeState outcomeMode =>
      cases hRel with
      | ok hOk =>
          cases hOk with
          | regular hStateRel =>
              have hStateRelLayout :
                  SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
                    outcomeState := by
                simpa [hRegular] using hStateRel
              exact
                ⟨outcomeState, targetFuel, by
                  simpa [Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular] using hRun,
              SourceStateExactRel.ofRelDomain hStateRelLayout
                hDomainAfter⟩

/--
Close a hidden-context continuation sequence into a scoped block for arbitrary
declared continuation layouts.

`ControlWithin` supplies the static shape fact needed for break/continue
cleanup after declarations.  Regular and leave exits obtain their current
layout containment from `SourceResultModeKontSupported`.
-/
theorem sourceResultBlockKontSoundWhenAtExactHiddenScope_of_seqKont_supported
    {cfg : StateRelConfig} {layout : List Name}
    {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hSupported :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultModeKontSupported ctx layout konts sourceResult)
    (hWithin : SourceModeKontLayouts.ControlWithin layout konts)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hSeq :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultModeKontSupported ctx layout konts sourceResult) →
        SourceResultSeqKontSoundWhenAtExactHiddenCtx cfg layout konts
          terminalRel revertRel prim program ctx sourceFuel body codeOverride
          lowerBody allowedInner) :
    SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout konts
      terminalRel revertRel prim program ctx sourceFuel.succ body
      codeOverride lowerBody allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared scope compiler hShared hVars hDomain =>
      let innerResult : Except Exception State :=
        EvmYul.Yul.execSeq sourceFuel body codeOverride
          (.Ok shared scope : State)
      let wrap : Except Exception State → Except Exception State :=
        fun result => restrictSourceResultTo scope result
      have hOuter :
          EvmYul.Yul.exec sourceFuel.succ (.Block body) codeOverride
              (.Ok shared scope : State) =
            wrap innerResult := by
        unfold innerResult wrap
        cases hExec :
            EvmYul.Yul.execSeq sourceFuel body codeOverride
              (.Ok shared scope : State) with
        | error err =>
            simp [restrictSourceResultTo, EvmYul.Yul.exec, hExec]
        | ok state =>
            cases state <;>
              simp [restrictSourceResultTo, EvmYul.Yul.exec,
                EvmYul.Yul.State.store, hExec]
      have hWrapEq : wrap innerResult = sourceResult := by
        simpa [hOuter] using hSource
      let allowedInner : Except Exception State → Prop :=
        fun result => allowed (wrap result)
      have hAllowInner : allowedInner innerResult := by
        change allowed (wrap innerResult)
        simpa [hWrapEq] using hAllow
      have hAllowedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultRelatable sourceResult := by
        intro sourceResult hAllowedWrapped
        change allowed (wrap sourceResult) at hAllowedWrapped
        exact
          SourceResultRelatable.of_restrictStoreTo
            (scope := scope) (sourceResult := sourceResult)
            (by
              change SourceResultRelatable (wrap sourceResult)
              exact hAllowed hAllowedWrapped)
      have hSupportedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultModeKontSupported ctx layout konts sourceResult := by
        intro sourceResult hAllowedWrapped
        change allowed (wrap sourceResult) at hAllowedWrapped
        exact
          SourceResultModeKontSupported.of_restrictStoreTo
            (ctx := ctx) (currentLayout := layout) (konts := konts)
            (scope := scope) (sourceResult := sourceResult)
            (by
              change SourceResultModeKontSupported ctx layout konts
                (wrap sourceResult)
              exact hSupported hAllowedWrapped)
      rcases (hSeq (allowedInner := allowedInner) hAllowedInner
          hSupportedInner)
          (SourceStateExactRel.ok hShared hVars hDomain)
          hAllowInner (by rfl) with
        ⟨sourceOutcome, _ctxAfter, targetFuel, hTargetOpen, hRelInner⟩
      let outerOutcome : Objects.Source.Outcome :=
        match sourceOutcome.mode with
        | .regular =>
            Functions.Source.Outcome.regular
              (sourceOutcome.state.restrictTo ctx.scope)
        | .brk | .cont | .leave | .halt _ => sourceOutcome
      have hTargetOuter :
          Functions.Source.Block.runScoped prim program ctx lowerBody targetFuel
              compiler =
            .ok outerOutcome := by
        cases targetFuel with
        | zero =>
            exact False.elim
              (by
                simpa [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid] using hTargetOpen)
        | succ targetFuel' =>
            cases sourceOutcome with
            | mk outcomeState outcomeMode =>
                cases outcomeMode <;>
                  simp [outerOutcome, Functions.Source.Block.runScoped,
                    hTargetOpen, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular]
      have hRelOuter :
          SourceResultKontOutcomeRel cfg konts terminalRel revertRel
            (wrap innerResult) outerOutcome := by
        cases hResult : innerResult with
        | error err =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | yulHalt hTerminal =>
                simpa [outerOutcome, wrap, restrictSourceResultTo, hResult]
                  using
                    (SourceResultKontOutcomeRel.yulHalt
                      (cfg := cfg) (konts := konts)
                      (terminalRel := terminalRel) (revertRel := revertRel)
                      hTerminal)
            | revert hRevert =>
                simpa [outerOutcome, wrap, restrictSourceResultTo, hResult]
                  using
                    (SourceResultKontOutcomeRel.revert
                      (cfg := cfg) (konts := konts)
                      (terminalRel := terminalRel) (revertRel := revertRel)
                      hRevert)
        | ok innerState =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                    case ok compilerAfter sharedAfter storeAfter
                        hSharedAfter hVarsAfter =>
                        have hFinalSupported :
                            SourceResultModeKontSupported ctx layout konts
                              (wrap innerResult) := by
                          exact hSupported (by
                            change allowed (wrap innerResult)
                            exact hAllowInner)
                        have hRegularSubset :
                            ∀ name, name ∈ konts.regular → name ∈ layout := by
                          simpa [SourceResultModeKontSupported, wrap,
                            restrictSourceResultTo, hResult,
                            EvmYul.Yul.State.restrictStoreTo] using
                            hFinalSupported
                        have hStoreScopeContains :
                            ∀ name, name ∈ konts.regular →
                              (scope.lookup name).isSome = true := by
                          intro name hMem
                          exact (hDomain name).mpr
                            (hRegularSubset name hMem)
                        have hImportedRestricted :
                            SourceStateRel cfg konts.regular
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              compilerAfter := by
                          exact
                            SourceStateRel.restrictStoreTo_of_scope_contains
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hStoreScopeContains
                        have hRestricted :
                            SourceStateRel cfg konts.regular
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (compilerAfter.restrictTo ctx.scope) := by
                          exact
                            SourceStateRel.restrictCompilerTo_of_subset
                              hImportedRestricted
                              (fun name hMem =>
                                hScopeContains name
                                  (hRegularSubset name hMem))
                        simpa [outerOutcome, wrap, restrictSourceResultTo,
                          hResult] using
                          (SourceResultKontOutcomeRel.ok
                            (SourceOkKontOutcomeRel.regular hRestricted))
                | @brk sharedAfter storeAfter compilerAfter hRelState =>
                    have hStoreScopeContains :
                        ∀ name, name ∈ konts.brk →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hWithin.brk name hMem)
                    have hRelRestricted :
                        SourceStateRel cfg konts.brk
                          (EvmYul.Yul.State.restrictStoreTo scope
                            (.Ok sharedAfter storeAfter : State))
                          compilerAfter := by
                      exact
                        SourceStateRel.restrictStoreTo_of_scope_contains
                          hRelState hStoreScopeContains
                    simpa [outerOutcome, wrap, restrictSourceResultTo,
                      hResult] using
                      (SourceResultKontOutcomeRel.ok
                        (SourceOkKontOutcomeRel.brk hRelRestricted))
                | @cont sharedAfter storeAfter compilerAfter hRelState =>
                    have hStoreScopeContains :
                        ∀ name, name ∈ konts.cont →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hWithin.cont name hMem)
                    have hRelRestricted :
                        SourceStateRel cfg konts.cont
                          (EvmYul.Yul.State.restrictStoreTo scope
                            (.Ok sharedAfter storeAfter : State))
                          compilerAfter := by
                      exact
                        SourceStateRel.restrictStoreTo_of_scope_contains
                          hRelState hStoreScopeContains
                    simpa [outerOutcome, wrap, restrictSourceResultTo,
                      hResult] using
                      (SourceResultKontOutcomeRel.ok
                        (SourceOkKontOutcomeRel.cont hRelRestricted))
                | @leave sharedAfter storeAfter compilerAfter hRelState =>
                    have hFinalSupported :
                        SourceResultModeKontSupported ctx layout konts
                          (wrap innerResult) := by
                      exact hSupported (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hLeaveSubset :
                        ∀ name, name ∈ konts.leave → name ∈ layout := by
                      have hLeaveInfo :
                          ctx.leaveScope? = some konts.leave ∧
                            ∀ name, name ∈ konts.leave → name ∈ layout := by
                        simpa [SourceResultModeKontSupported, wrap,
                          restrictSourceResultTo, hResult,
                          EvmYul.Yul.State.restrictStoreTo] using
                          hFinalSupported
                      exact hLeaveInfo.2
                    have hStoreScopeContains :
                        ∀ name, name ∈ konts.leave →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hLeaveSubset name hMem)
                    have hRelRestricted :
                        SourceStateRel cfg konts.leave
                          (EvmYul.Yul.State.restrictStoreTo scope
                            (.Ok sharedAfter storeAfter : State))
                          compilerAfter := by
                      exact
                        SourceStateRel.restrictStoreTo_of_scope_contains
                          hRelState hStoreScopeContains
                    simpa [outerOutcome, wrap, restrictSourceResultTo,
                      hResult] using
                      (SourceResultKontOutcomeRel.ok
                        (SourceOkKontOutcomeRel.leave hRelRestricted))
      exact ⟨outerOutcome, targetFuel, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

/--
Checked lowering adapter for typed-continuation scoped block soundness.

Branch and loop frontiers usually have a checked open-sequence theorem for the
body plus the concrete successful body lowering.  This lemma packages the
standard close-to-scoped-block step so those frontiers only choose the intended
continuation layout and allowed-result predicate.
-/
theorem sourceResultBlockKontSoundWhenAtExactHiddenScope_of_checkedSeqKont
    {cfg : StateRelConfig} {reserved layout : List Name}
    {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel compileFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {freshState freshState' : Fresh.State}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hSupported :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultModeKontSupported ctx layout konts sourceResult)
    (hWithin : SourceModeKontLayouts.ControlWithin layout konts)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hChecked :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultModeKontSupported ctx layout konts sourceResult) →
        CheckedSeqKontSoundWhenFreshNamesAtCompileFuelHiddenCtx cfg reserved
          layout konts terminalRel revertRel prim program ctx sourceFuel
          compileFuel body codeOverride allowedInner)
    (hCovers : FreshCoversLayout (reserved ++ layout) freshState)
    (hLower :
      Stmt.List.toBlockFuel? compileFuel freshState body =
        some (lowerBody, freshState')) :
    SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout konts
      terminalRel revertRel prim program ctx sourceFuel.succ body
      codeOverride lowerBody allowed :=
  sourceResultBlockKontSoundWhenAtExactHiddenScope_of_seqKont_supported
    (cfg := cfg) (layout := layout) (konts := konts)
    (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
    (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
    (body := body) (codeOverride := codeOverride) (lowerBody := lowerBody)
    (allowed := allowed) hAllowed hSupported hWithin hScopeContains
    (by
      intro allowedInner hAllowedInner hSupportedInner
      exact
        hChecked hAllowedInner hSupportedInner hCovers hLower)

/--
Checked adapter from the typed-continuation block bridge to the existing
handler-aware hidden block mode interface.
-/
theorem checkedHiddenBlockModeSoundWhenFreshNamesAtCompileFuelHiddenScope_of_seqKont_block_frontier
    {cfg : StateRelConfig} {reserved layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel compileFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract}
    {canBreak canContinue canLeave : Bool}
    (hCheckpoint : CheckpointExpressionSound)
    (hSafe : Safe.stmts sourceStmts)
    (hScoped :
      ControlFlow.ScopedStmts canBreak canContinue canLeave sourceStmts)
    (hHandlers : HiddenModeHandlersAvailable ctx layout canBreak canContinue)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hSeq :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultModeKontSupported ctx layout
            (SourceModeKontLayouts.block layout outcomeLayout)
            sourceResult) →
        CheckedSeqKontSoundWhenFreshNamesAtCompileFuelHiddenCtx cfg reserved
          layout (SourceModeKontLayouts.block layout outcomeLayout)
          terminalRel revertRel prim program ctx sourceFuel compileFuel
          sourceStmts codeOverride allowedInner) :
    CheckedHiddenBlockModeSoundWhenFreshNamesAtCompileFuelHiddenScope cfg
      reserved layout outcomeLayout terminalRel revertRel prim program ctx
      sourceFuel.succ compileFuel sourceStmts codeOverride := by
  intro freshState freshState' lowerBlock hCovers hLower
  let blockKonts := SourceModeKontLayouts.block layout outcomeLayout
  have hKont :
      ∀ {allowed : Except Exception State → Prop},
        (∀ {sourceResult}, allowed sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowed sourceResult →
          SourceResultModeKontSupported ctx layout blockKonts
            sourceResult) →
        SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout blockKonts
          terminalRel revertRel prim program ctx sourceFuel.succ sourceStmts
          codeOverride lowerBlock allowed := by
    intro allowed hAllowed hSupported
    exact
      sourceResultBlockKontSoundWhenAtExactHiddenScope_of_seqKont_block_supported
        (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
        (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
        (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
        (body := sourceStmts) (codeOverride := codeOverride)
        (lowerBody := lowerBlock) (allowed := allowed)
        hAllowed
        (by
          intro sourceResult hAllow
          simpa [blockKonts] using hSupported hAllow)
        hScopeContains
        (fun {allowedInner} hAllowedInner hSupportedInner =>
          (hSeq (allowedInner := allowedInner) hAllowedInner
            (by
              intro sourceResult hAllow
              simpa [blockKonts] using hSupportedInner hAllow))
            hCovers hLower)
  refine
    { regular := ?_
      brk := ?_
      cont := ?_
      leave := ?_
      halt := ?_ }
  · intro sharedIn sharedOut storeIn storeOut compilerIn hDomainIn
      _hDomainOut hSource hInitial
    let allowed : Except Exception State → Prop :=
      fun result =>
        result =
          (.ok (.Ok sharedOut storeOut) : Except Exception State)
    have hAllowed :
        ∀ {sourceResult}, allowed sourceResult →
          SourceResultRelatable sourceResult := by
      intro sourceResult hEq
      subst sourceResult
      simp [SourceResultRelatable]
    have hSupported :
        ∀ {sourceResult}, allowed sourceResult →
          SourceResultModeKontSupported ctx layout blockKonts
            sourceResult := by
      intro sourceResult hEq
      subst sourceResult
      intro name hMem
      simpa [blockKonts, SourceModeKontLayouts.block] using hMem
    have hInitialExact : SourceStateExactRel cfg layout
        (.Ok sharedIn storeIn) compilerIn :=
      SourceStateExactRel.ofRelDomain hInitial hDomainIn
    rcases (hKont hAllowed hSupported) hInitialExact rfl hSource with
      ⟨sourceOutcome, targetFuel, hRun, hRel⟩
    cases hRel with
    | ok hOk =>
        cases hOk with
        | regular hRelState =>
            exact ⟨_, targetFuel, hRun, by
              simpa [blockKonts, SourceModeKontLayouts.block] using
                hRelState⟩
  · intro sharedIn sharedOut storeIn storeOut compilerIn hDomainIn
      _hDomainOut hSource hInitial
    cases canBreak with
    | false =>
        have hSafeBlock : Safe.stmt (.Block sourceStmts) := by
          simpa [Safe.stmt] using hSafe
        have hScopedBlock :
            ControlFlow.ScopedStmt false canContinue canLeave
              (.Block sourceStmts) := by
          simpa [ControlFlow.ScopedStmt] using hScoped
        have hAllowedResult :
            SourceResultCheckpointAllowed false canContinue canLeave
              (EvmYul.Yul.exec sourceFuel.succ (.Block sourceStmts)
                codeOverride (.Ok sharedIn storeIn)) :=
          SourceResultCheckpointAllowed.exec_of_scoped_safe
            hCheckpoint hSafeBlock hScopedBlock
            (by simp [StateCheckpointAllowed])
        rw [hSource] at hAllowedResult
        simp [SourceResultCheckpointAllowed, StateCheckpointAllowed] at hAllowedResult
    | true =>
        let allowed : Except Exception State → Prop :=
          fun result =>
            result =
              (.ok (.Checkpoint (.Break sharedOut storeOut)) :
                Except Exception State)
        have hAllowed :
            ∀ {sourceResult}, allowed sourceResult →
              SourceResultRelatable sourceResult := by
          intro sourceResult hEq
          subst sourceResult
          simp [SourceResultRelatable]
        have hSupported :
            ∀ {sourceResult}, allowed sourceResult →
              SourceResultModeKontSupported ctx layout blockKonts
                sourceResult := by
          intro sourceResult hEq
          subst sourceResult
          rcases hHandlers.1 rfl with ⟨breakScope, hBreak, hContains⟩
          exact
            SourceResultModeKontSupported.break_of_scope
              (ctx := ctx) (currentLayout := layout)
              (breakScope := breakScope)
              (konts := blockKonts) hBreak
              (by
                intro name hMem
                exact hContains name
                  (by
                    simpa [blockKonts, SourceModeKontLayouts.block] using
                      hMem))
        have hInitialExact : SourceStateExactRel cfg layout
            (.Ok sharedIn storeIn) compilerIn :=
          SourceStateExactRel.ofRelDomain hInitial hDomainIn
        rcases (hKont hAllowed hSupported) hInitialExact rfl hSource with
          ⟨sourceOutcome, targetFuel, hRun, hRel⟩
        cases hRel with
        | ok hOk =>
            cases hOk with
            | regular hRelState =>
                cases hRelState
            | brk hRelState =>
                exact ⟨_, targetFuel, hRun, by
                  simpa [blockKonts, SourceModeKontLayouts.block] using
                    hRelState⟩
  · intro sharedIn sharedOut storeIn storeOut compilerIn hDomainIn
      _hDomainOut hSource hInitial
    cases canContinue with
    | false =>
        have hSafeBlock : Safe.stmt (.Block sourceStmts) := by
          simpa [Safe.stmt] using hSafe
        have hScopedBlock :
            ControlFlow.ScopedStmt canBreak false canLeave
              (.Block sourceStmts) := by
          simpa [ControlFlow.ScopedStmt] using hScoped
        have hAllowedResult :
            SourceResultCheckpointAllowed canBreak false canLeave
              (EvmYul.Yul.exec sourceFuel.succ (.Block sourceStmts)
                codeOverride (.Ok sharedIn storeIn)) :=
          SourceResultCheckpointAllowed.exec_of_scoped_safe
            hCheckpoint hSafeBlock hScopedBlock
            (by simp [StateCheckpointAllowed])
        rw [hSource] at hAllowedResult
        simp [SourceResultCheckpointAllowed, StateCheckpointAllowed] at hAllowedResult
    | true =>
        let allowed : Except Exception State → Prop :=
          fun result =>
            result =
              (.ok (.Checkpoint (.Continue sharedOut storeOut)) :
                Except Exception State)
        have hAllowed :
            ∀ {sourceResult}, allowed sourceResult →
              SourceResultRelatable sourceResult := by
          intro sourceResult hEq
          subst sourceResult
          simp [SourceResultRelatable]
        have hSupported :
            ∀ {sourceResult}, allowed sourceResult →
              SourceResultModeKontSupported ctx layout blockKonts
                sourceResult := by
          intro sourceResult hEq
          subst sourceResult
          rcases hHandlers.2 rfl with ⟨continueScope, hContinue, hContains⟩
          exact
            SourceResultModeKontSupported.continue_of_scope
              (ctx := ctx) (currentLayout := layout)
              (continueScope := continueScope)
              (konts := blockKonts) hContinue
              (by
                intro name hMem
                exact hContains name
                  (by
                    simpa [blockKonts, SourceModeKontLayouts.block] using
                      hMem))
        have hInitialExact : SourceStateExactRel cfg layout
            (.Ok sharedIn storeIn) compilerIn :=
          SourceStateExactRel.ofRelDomain hInitial hDomainIn
        rcases (hKont hAllowed hSupported) hInitialExact rfl hSource with
          ⟨sourceOutcome, targetFuel, hRun, hRel⟩
        cases hRel with
        | ok hOk =>
            cases hOk with
            | regular hRelState =>
                cases hRelState
            | cont hRelState =>
                exact ⟨_, targetFuel, hRun, by
                  simpa [blockKonts, SourceModeKontLayouts.block] using
                    hRelState⟩
  · intro sharedIn sharedOut storeIn storeOut compilerIn hDomainIn hSource
      hCompat hInitial
    let allowed : Except Exception State → Prop :=
      fun result =>
        result =
          (.ok (.Checkpoint (.Leave sharedOut storeOut)) :
            Except Exception State)
    have hAllowed :
        ∀ {sourceResult}, allowed sourceResult →
          SourceResultRelatable sourceResult := by
      intro sourceResult hEq
      subst sourceResult
      simp [SourceResultRelatable]
    have hSupported :
        ∀ {sourceResult}, allowed sourceResult →
          SourceResultModeKontSupported ctx layout blockKonts
            sourceResult := by
      intro sourceResult hEq
      subst sourceResult
      have hLeave :
          ctx.leaveScope? = some outcomeLayout ∧
            ∀ name, name ∈ outcomeLayout → name ∈ layout := by
        simpa [SourceResultOutcomeLayoutCompatible] using hCompat
      exact
        SourceResultModeKontSupported.leave_of_scope
          (ctx := ctx) (currentLayout := layout) (konts := blockKonts)
          hLeave.1
          (by
            intro name hMem
            exact hLeave.2 name
              (by
                simpa [blockKonts, SourceModeKontLayouts.block] using hMem))
    have hInitialExact : SourceStateExactRel cfg layout
        (.Ok sharedIn storeIn) compilerIn :=
      SourceStateExactRel.ofRelDomain hInitial hDomainIn
    rcases (hKont hAllowed hSupported) hInitialExact rfl hSource with
      ⟨sourceOutcome, targetFuel, hRun, hRel⟩
    cases hRel with
    | ok hOk =>
        cases hOk with
        | regular hRelState =>
            cases hRelState
        | leave hRelState =>
            exact ⟨_, targetFuel, hRun, by
              simpa [blockKonts, SourceModeKontLayouts.block] using
                hRelState⟩
  · intro sharedIn storeIn compilerIn sourceResult hDomainIn hSource
      hRelatable hNotRegular hNoCheckpoint hInitial
    let allowed : Except Exception State → Prop :=
      fun result => result = sourceResult
    have hAllowed :
        ∀ {sourceResult'}, allowed sourceResult' →
          SourceResultRelatable sourceResult' := by
      intro sourceResult' hEq
      subst sourceResult'
      exact hRelatable
    have hSupported :
        ∀ {sourceResult'}, allowed sourceResult' →
          SourceResultModeKontSupported ctx layout blockKonts
            sourceResult' := by
      intro sourceResult' hEq
      subst sourceResult'
      cases sourceResult with
      | error err =>
          simp [SourceResultModeKontSupported]
      | ok state =>
          cases state with
          | Ok shared store =>
              simp [SourceResultNotRegularOk] at hNotRegular
          | OutOfFuel =>
              simp [SourceResultModeKontSupported]
          | Checkpoint jump =>
              simp [SourceResultNoCheckpoint] at hNoCheckpoint
    have hInitialExact : SourceStateExactRel cfg layout
        (.Ok sharedIn storeIn) compilerIn :=
      SourceStateExactRel.ofRelDomain hInitial hDomainIn
    rcases (hKont hAllowed hSupported) hInitialExact rfl hSource with
      ⟨sourceOutcome, targetFuel, hRun, hRel⟩
    cases hRel with
    | yulHalt hTerminal =>
        exact ⟨_, _, targetFuel, hRun,
          SourceResultOutcomeRel.yulHalt hTerminal⟩
    | revert hRevert =>
        exact ⟨.revert, _, targetFuel, hRun,
          SourceResultOutcomeRel.revert hRevert⟩
    | ok hOk =>
        cases hOk with
        | regular hRelState =>
            cases hRelState
            simp [SourceResultNotRegularOk] at hNotRegular
        | brk hRelState =>
            simp [SourceResultNoCheckpoint] at hNoCheckpoint
        | cont hRelState =>
            simp [SourceResultNoCheckpoint] at hNoCheckpoint
        | leave hRelState =>
            simp [SourceResultNoCheckpoint] at hNoCheckpoint

