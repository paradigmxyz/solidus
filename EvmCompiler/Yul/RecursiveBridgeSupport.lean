    simpa [Functions.Source.Ctx.initial] using hScope.symm
  subst layout
  exact SourceStateExactRel.ofRelDomain hRel StoreDomainExact.empty

def StoreDomainContains (layout : List Name)
    (store : EvmYul.Yul.VarStore) : Prop :=
  ∀ name : Name, name ∈ layout → (store.lookup name).isSome = true

namespace StoreDomainContains

theorem of_exact {layout : List Name} {store : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store) :
    StoreDomainContains layout store :=
  fun name hMem => (hDomain name).mpr hMem

theorem insert {layout : List Name} {store : EvmYul.Yul.VarStore}
    {name : Name} {value : Word}
    (hContains : StoreDomainContains layout store) :
    StoreDomainContains layout (store.insert name value) := by
  intro query hMem
  by_cases hEq : query = name
  · subst query
    simp [Finmap.lookup_insert]
  · rw [Finmap.lookup_insert_of_ne]
    exact hContains query hMem
    exact hEq

theorem insertPairs (pairs : List (Name × Word)) {layout : List Name}
    {store : EvmYul.Yul.VarStore}
    (hContains : StoreDomainContains layout store) :
    StoreDomainContains layout (VarStackRel.insertPairs pairs store) := by
  induction pairs generalizing store with
  | nil =>
      simpa [VarStackRel.insertPairs] using hContains
  | cons pair rest ih =>
      cases pair with
      | mk name value =>
          simpa [VarStackRel.insertPairs] using
            StoreDomainContains.insert
              (name := name) (value := value) (ih hContains)

theorem zeroFill (names : List Name) {layout : List Name}
    {store : EvmYul.Yul.VarStore}
    (hContains : StoreDomainContains layout store) :
    StoreDomainContains layout
      (VarStackRel.insertPairs (VarStackRel.zeroPairs names) store) :=
  StoreDomainContains.insertPairs (pairs := VarStackRel.zeroPairs names)
    hContains

theorem restrictVarStore
    {layout : List Name} {store scope : EvmYul.Yul.VarStore}
    (hStore : StoreDomainContains layout store)
    (hScope : StoreDomainContains layout scope) :
    StoreDomainContains layout
      (EvmYul.Yul.State.restrictVarStore store scope) := by
  intro name hMem
  have hScopeSome : (scope.lookup name).isSome = true :=
    hScope name hMem
  cases hScopeLookup : scope.lookup name with
  | none =>
      simp [hScopeLookup] at hScopeSome
  | some value =>
      rw [FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
        name hScopeLookup]
      exact hStore name hMem

end StoreDomainContains

theorem StoreDomainExact.restrictVarStore_of_contains
    {layout : List Name} {store scope : EvmYul.Yul.VarStore}
    (hStore : StoreDomainContains layout store)
    (hScope : StoreDomainExact layout scope) :
    StoreDomainExact layout
      (EvmYul.Yul.State.restrictVarStore store scope) := by
  intro name
  constructor
  · intro hLookupSome
    cases hScopeLookup : scope.lookup name with
    | none =>
        have hRestrictedNone :
            (EvmYul.Yul.State.restrictVarStore store scope).lookup name =
              none :=
          FinmapFacts.lookup_restrictVarStore_of_scope_none store scope name
            hScopeLookup
        rw [hRestrictedNone] at hLookupSome
        simp at hLookupSome
    | some value =>
        exact (hScope name).mp (by simp [hScopeLookup])
  · intro hMem
    have hScopeSome : (scope.lookup name).isSome = true :=
      (hScope name).mpr hMem
    cases hScopeLookup : scope.lookup name with
    | none =>
        simp [hScopeLookup] at hScopeSome
    | some value =>
        rw [FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
          name hScopeLookup]
        exact hStore name hMem

theorem StoreDomainExact.restrictVarStore_of_domain
    {layout layoutAfter : List Name}
    {store scope : EvmYul.Yul.VarStore}
    (hStore : StoreDomainExact layoutAfter store)
    (hScope : StoreDomainExact layout scope)
    (hSubset : ∀ name, name ∈ layout → name ∈ layoutAfter) :
    StoreDomainExact layout
      (EvmYul.Yul.State.restrictVarStore store scope) := by
  intro name
  constructor
  · intro hLookupSome
    cases hScopeLookup : scope.lookup name with
    | none =>
        have hRestrictedNone :
            (EvmYul.Yul.State.restrictVarStore store scope).lookup name =
              none :=
          FinmapFacts.lookup_restrictVarStore_of_scope_none store scope name
            hScopeLookup
        rw [hRestrictedNone] at hLookupSome
        simp at hLookupSome
    | some value =>
        exact (hScope name).mp (by simp [hScopeLookup])
  · intro hMem
    have hScopeSome : (scope.lookup name).isSome = true :=
      (hScope name).mpr hMem
    cases hScopeLookup : scope.lookup name with
    | none =>
        simp [hScopeLookup] at hScopeSome
    | some value =>
        have hStoreSome : (store.lookup name).isSome = true :=
          (hStore name).mpr (hSubset name hMem)
        rw [FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
          name hScopeLookup]
        exact hStoreSome

theorem SourceStateExactRel.restrictStoreTo_of_domain
    {cfg : StateRelConfig} {layout layoutAfter : List Name}
    {shared : EvmYul.SharedState .Yul} {store scope : EvmYul.Yul.VarStore}
    {source : Objects.Source.State}
    (hRel :
      SourceStateExactRel cfg layoutAfter (.Ok shared store) source)
    (hDomain : StoreDomainExact layout scope)
    (hSubset : ∀ name, name ∈ layout → name ∈ layoutAfter) :
    SourceStateExactRel cfg layout
      ((.Ok shared store : State).restrictStoreTo scope)
      (source.restrictTo layout) := by
  cases hRel with
  | ok hShared hVars hDomainAfter =>
      simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store]
      exact
        SourceStateExactRel.ok hShared
          (sourceStoreRel_restrictVarStore_of_domain hVars hDomain hSubset)
          (StoreDomainExact.restrictVarStore_of_domain hDomainAfter hDomain
            hSubset)

theorem SourceStateRel.restrictCompilerTo_of_subset
    {cfg : StateRelConfig} {layout scope : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {source : Objects.Source.State}
    (hRel : SourceStateRel cfg layout (.Ok shared store) source)
    (hSubset : ∀ name, name ∈ layout → name ∈ scope) :
    SourceStateRel cfg layout (.Ok shared store)
      (source.restrictTo scope) := by
  cases hRel with
  | ok hShared hVars =>
      exact
        SourceStateRel.ok hShared
          (by
            intro name hMem
            have hScope : name ∈ scope := hSubset name hMem
            simpa [Locals.Source.State.restrictTo,
              Locals.Source.Store.restrictTo_mem hScope]
              using hVars name hMem)

