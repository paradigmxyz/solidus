theorem target_mode_ne_brk_of_source_no_break
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {ctx : Functions.Source.Ctx}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {allowed : Except Exception State → Prop}
    {sourceDone : Except Exception State}
    {outcome : Objects.Source.Outcome}
    {ctxAfter : Functions.Source.Ctx}
    (hDone :
      SourceOpenStmtHeadPathDoneRel cfg layout outcomeLayout ctx terminalRel
        revertRel allowed sourceDone (.ok (outcome, ctxAfter)))
    (hAllowed : SourceResultNotRegularOk sourceDone → allowed sourceDone)
    (hNoBreak :
      ∀ {sharedBreak : EvmYul.SharedState .Yul}
        {storeBreak : EvmYul.Yul.VarStore},
        sourceDone =
          .ok (.Checkpoint (.Break sharedBreak storeBreak)) →
        False) :
    outcome.mode ≠ Locals.Source.Mode.brk := by
  intro hMode
  cases hDone with
  | regular hExact hScope hHandlers =>
      simp [Functions.Source.Outcome.regular,
        Locals.Source.Outcome.regular] at hMode
  | stopping hNotRegular hOutcome =>
      have hRel :
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            sourceDone outcome :=
        hOutcome (hAllowed hNotRegular)
      cases hRel with
      | ok hOk =>
          cases hOk with
          | regular hStateRel =>
              simp [Functions.Source.Outcome.regular,
                Locals.Source.Outcome.regular] at hMode
          | brk hStateRel =>
              exact hNoBreak rfl
          | cont hStateRel =>
              simp [Functions.Source.Outcome.cont,
                Locals.Source.Outcome.cont] at hMode
          | leave hStateRel =>
              simp [Functions.Source.Outcome.leave,
                Locals.Source.Outcome.leave] at hMode
      | yulHalt hTerminal =>
          simp [Functions.Source.Outcome.halt,
            Locals.Source.Outcome.halt] at hMode
      | revert hRevert =>
          simp [Functions.Source.Outcome.halt,
            Locals.Source.Outcome.halt] at hMode

