        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        StoreDomainExact layout storeAfterBody →
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Ok sharedAfterPost storeAfterPost) →
        StoreDomainExact layout storeAfterPost)
    (hPostBreakFalse :
      ∀ {fuel : Nat}
        {sharedAfterBody sharedAfterPost : EvmYul.SharedState .Yul}
        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Checkpoint (.Break sharedAfterPost storeAfterPost)) →
        False)
    (hPostContinueFalse :
      ∀ {fuel : Nat}
        {sharedAfterBody sharedAfterPost : EvmYul.SharedState .Yul}
        {storeAfterBody storeAfterPost : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel (.Block post) codeOverride
          (.Ok sharedAfterBody storeAfterBody) =
            .ok (.Checkpoint (.Continue sharedAfterPost storeAfterPost)) →
        False)
    (hDomain : StoreDomainExact layout store)
    (hExec :
      EvmYul.Yul.exec fuel (.For cond post body) codeOverride
        (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter)) :
    StoreDomainExact layout storeAfter := by
  revert shared store sharedAfter storeAfter
  induction fuel using Nat.strong_induction_on with
  | h fuel ih =>
      intro shared sharedAfter store storeAfter hDomain hExec
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.exec] at hExec
      | succ loopFuel =>
          rw [Imported.exec_for_succ] at hExec
          cases loopFuel with
          | zero =>
              rw [Imported.loop_zero] at hExec
              cases hExec
          | succ loopFuel1 =>
              cases loopFuel1 with
              | zero =>
                  rw [Imported.loop_one] at hExec
                  cases hExec
              | succ sourceFuel =>
                  have hExecOriginal := hExec
                  rw [Imported.loop_succ_succ] at hExec
                  simp [EvmYul.Yul.State.mkOk] at hExec
                  cases hEval :
                      EvmYul.Yul.eval sourceFuel cond codeOverride
                        (.Ok shared store) with
                  | error err =>
                      simp [hEval] at hExec
                  | ok evalPair =>
                      rcases evalPair with ⟨stateAfterCond, value⟩
                      have hCondOk :
                          ∃ sharedCond storeCond,
                            stateAfterCond =
                              .Ok sharedCond storeCond ∧
                            StoreDomainExact layout storeCond := by
                        cases hCondCases :
                            hEvalOkOrOutOfFuel hDomain hEval with
                        | inl hOutOfFuel =>
                            subst stateAfterCond
                            have hExecForOriginal :
                                EvmYul.Yul.exec sourceFuel.succ.succ.succ
                                  (.For cond post body) codeOverride
                                  (.Ok shared store) =
                                  .ok (.Ok sharedAfter storeAfter) := by
                              rw [Imported.exec_for_succ]
                              exact hExecOriginal
                            exact False.elim
                              (hCondOutOfFuelFalse hDomain hEval
                                hExecForOriginal)
                        | inr hOk =>
                            exact hOk
                      rcases hCondOk with
                        ⟨sharedCond, storeCond, hCondEq, hCondDomain⟩
                      subst stateAfterCond
                      by_cases hZero : value = (⟨0⟩ : Word)
                      · simp [hEval, hZero, EvmYul.Yul.State.overwrite?] at hExec
                        rcases hExec with ⟨_hShared, hStore⟩
                        subst storeAfter
                        exact hCondDomain
                      · have hNonzero : value ≠ (⟨0⟩ : Word) := hZero
                        cases hBody :
                            EvmYul.Yul.exec sourceFuel (.Block body)
                              codeOverride (.Ok sharedCond storeCond) with
                        | error err =>
                            simp [hEval, hZero, hBody] at hExec
                        | ok stateAfterBody =>
                            cases stateAfterBody with
                            | OutOfFuel =>
                                simp [hEval, hZero, hBody,
                                  EvmYul.Yul.State.overwrite?] at hExec
                            | Checkpoint bodyJump =>
                                cases bodyJump with
                                | Break sharedBody storeBody =>
                                    have hBodyDomain :
                                        StoreDomainExact layout storeBody :=
                                      hBodyDomainBreak hCondDomain hBody
                                    simp [hEval, hZero, hBody,
                                      EvmYul.Yul.State.overwrite?,
                                      EvmYul.Yul.State.reviveJump,
                                      EvmYul.Yul.State.revive] at hExec
                                    rcases hExec with ⟨_hShared, hStore⟩
                                    subst storeAfter
                                    exact hBodyDomain
                                | Leave sharedBody storeBody =>
                                    simp [hEval, hZero, hBody,
                                      EvmYul.Yul.State.overwrite?] at hExec
                                | Continue sharedBody storeBody =>
                                    have hBodyDomain :
                                        StoreDomainExact layout storeBody :=
                                      hBodyDomainContinue hCondDomain hBody
                                    cases hPost :
                                        EvmYul.Yul.exec sourceFuel
                                          (.Block post) codeOverride
                                          (.Ok sharedBody storeBody) with
                                    | error err =>
                                        simp [hEval, hZero, hBody, hPost,
                                          EvmYul.Yul.State.reviveJump,
                                          EvmYul.Yul.State.revive] at hExec
                                    | ok stateAfterPost =>
                                        cases stateAfterPost with
                                        | OutOfFuel =>
                                            simp [hEval, hZero, hBody, hPost,
                                              EvmYul.Yul.State.reviveJump,
                                              EvmYul.Yul.State.revive,
                                              EvmYul.Yul.State.overwrite?] at hExec
                                        | Checkpoint postJump =>
                                            cases postJump with
                                            | Break sharedPost storePost =>
                                                exact False.elim
                                                  (hPostBreakFalse hPost)
                                            | Continue sharedPost storePost =>
                                                exact False.elim
                                                  (hPostContinueFalse hPost)
                                            | Leave sharedPost storePost =>
                                                simp [hEval, hZero, hBody,
                                                  hPost,
                                                  EvmYul.Yul.State.reviveJump,
                                                  EvmYul.Yul.State.revive,
                                                  EvmYul.Yul.State.overwrite?]
                                                  at hExec
                                        | Ok sharedPost storePost =>
                                            have hPostDomain :
                                                StoreDomainExact layout
                                                  storePost :=
                                              hPostDomainOk hBodyDomain hPost
                                            cases hLoop :
                                                EvmYul.Yul.exec sourceFuel
                                                  (.For cond post body)
                                                  codeOverride
                                                  (.Ok sharedPost storePost) with
                                            | error err =>
                                                simp [hEval, hZero, hBody,
                                                  hPost, hLoop,
                                                  EvmYul.Yul.State.reviveJump,
                                                  EvmYul.Yul.State.revive,
                                                  EvmYul.Yul.State.overwrite?]
                                                  at hExec
                                            | ok stateAfterLoop =>
                                                cases stateAfterLoop with
                                                | OutOfFuel =>
                                                    simp [hEval, hZero, hBody,
                                                      hPost, hLoop,
                                                      EvmYul.Yul.State.reviveJump,
                                                      EvmYul.Yul.State.revive,
                                                      EvmYul.Yul.State.overwrite?]
                                                      at hExec
                                                | Checkpoint loopJump =>
                                                    cases loopJump <;>
                                                      simp [hEval, hZero,
                                                        hBody, hPost, hLoop,
                                                        EvmYul.Yul.State.reviveJump,
                                                        EvmYul.Yul.State.revive,
                                                        EvmYul.Yul.State.overwrite?]
                                                        at hExec
                                                | Ok sharedLoop storeLoop =>
                                                    have hLoopDomain :
                                                        StoreDomainExact layout
                                                          storeLoop :=
                                                      ih sourceFuel (by omega)
                                                        hPostDomain hLoop
                                                    simp [hEval, hZero, hBody,
                                                      hPost, hLoop,
                                                      EvmYul.Yul.State.reviveJump,
                                                      EvmYul.Yul.State.revive,
                                                      EvmYul.Yul.State.overwrite?]
                                                      at hExec
                                                    rcases hExec with
                                                      ⟨_hShared, hStore⟩
                                                    subst storeAfter
                                                    exact hLoopDomain
                            | Ok sharedBody storeBody =>
                                have hBodyDomain :
                                    StoreDomainExact layout storeBody :=
                                  hBodyDomainOk hCondDomain hBody
                                cases hPost :
                                    EvmYul.Yul.exec sourceFuel (.Block post)
                                      codeOverride
                                      (.Ok sharedBody storeBody) with
                                | error err =>
                                    simp [hEval, hZero, hBody, hPost,
                                      EvmYul.Yul.State.reviveJump] at hExec
                                | ok stateAfterPost =>
                                    cases stateAfterPost with
                                    | OutOfFuel =>
                                        simp [hEval, hZero, hBody, hPost,
                                          EvmYul.Yul.State.reviveJump,
                                          EvmYul.Yul.State.overwrite?] at hExec
                                    | Checkpoint postJump =>
                                        cases postJump with
                                        | Break sharedPost storePost =>
                                            exact False.elim
                                              (hPostBreakFalse hPost)
                                        | Continue sharedPost storePost =>
                                            exact False.elim
                                              (hPostContinueFalse hPost)
                                        | Leave sharedPost storePost =>
                                            simp [hEval, hZero, hBody, hPost,
                                              EvmYul.Yul.State.reviveJump,
                                              EvmYul.Yul.State.overwrite?] at hExec
                                    | Ok sharedPost storePost =>
                                        have hPostDomain :
                                            StoreDomainExact layout
                                              storePost :=
                                          hPostDomainOk hBodyDomain hPost
                                        cases hLoop :
                                            EvmYul.Yul.exec sourceFuel
                                              (.For cond post body)
                                              codeOverride
                                              (.Ok sharedPost storePost) with
                                        | error err =>
                                            simp [hEval, hZero, hBody, hPost,
                                              hLoop,
                                              EvmYul.Yul.State.reviveJump,
                                              EvmYul.Yul.State.overwrite?] at hExec
                                        | ok stateAfterLoop =>
                                            cases stateAfterLoop with
                                            | OutOfFuel =>
                                                simp [hEval, hZero, hBody,
                                                  hPost, hLoop,
                                                  EvmYul.Yul.State.reviveJump,
                                                  EvmYul.Yul.State.overwrite?]
                                                  at hExec
                                            | Checkpoint loopJump =>
                                                cases loopJump <;>
                                                  simp [hEval, hZero, hBody,
                                                    hPost, hLoop,
                                                    EvmYul.Yul.State.reviveJump,
                                                    EvmYul.Yul.State.revive,
                                                    EvmYul.Yul.State.overwrite?]
                                                    at hExec
                                            | Ok sharedLoop storeLoop =>
                                                have hLoopDomain :
                                                    StoreDomainExact layout
                                                      storeLoop :=
                                                  ih sourceFuel (by omega)
                                                    hPostDomain hLoop
                                                simp [hEval, hZero, hBody,
                                                  hPost, hLoop,
                                                  EvmYul.Yul.State.reviveJump,
                                                  EvmYul.Yul.State.overwrite?]
                                                  at hExec
                                                rcases hExec with
                                                  ⟨_hShared, hStore⟩
                                                subst storeAfter
                                                exact hLoopDomain

theorem ForOkDomainExactContracts.exec_for_ok
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {post body : List AstStmt} {codeOverride : Option AstContract}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    (hContracts :
      ForOkDomainExactContracts layout cond post body codeOverride)
    (hDomain : StoreDomainExact layout store)
    (hExec :
      EvmYul.Yul.exec fuel (.For cond post body) codeOverride
        (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter)) :
    StoreDomainExact layout storeAfter :=
  exec_for_ok_domain_exact_of_all_fuel_parts
    (layout := layout) (fuel := fuel) (cond := cond) (post := post)
    (body := body) (codeOverride := codeOverride) (shared := shared)
    (sharedAfter := sharedAfter) (store := store) (storeAfter := storeAfter)
    hContracts.evalOkOrOutOfFuel hContracts.condOutOfFuelFalse
    hContracts.bodyOk hContracts.bodyBreak hContracts.bodyContinue
    hContracts.postOk hContracts.postBreakFalse hContracts.postContinueFalse
    hDomain hExec

