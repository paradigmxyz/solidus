theorem zeroFill_outOfFuel (vars : List EvmYul.Identifier) :
    EvmYul.Yul.State.zeroFill vars .OutOfFuel = .OutOfFuel := by
  induction vars with
  | nil =>
      simp [EvmYul.Yul.State.zeroFill]
  | cons head tail ih =>
      change
        EvmYul.Yul.State.insert head ⟨0⟩
          (EvmYul.Yul.State.zeroFill tail .OutOfFuel) =
        .OutOfFuel
      rw [ih]
      simp [EvmYul.Yul.State.insert]

