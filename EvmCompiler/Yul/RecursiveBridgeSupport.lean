            .ok (compilerAfterCond, true) := by
        have hBoolTrue :
            (value != EvmYul.UInt256.ofNat 0) = true :=
          word_bne_zero_true_of_ne hNonzero
        change
          Locals.Source.Expr.evalCondition prim lowerCond compilerAfterPre =
            .ok (compilerAfterCond, true)
        simp [Locals.Source.Expr.evalCondition, hCondRun, hBoolTrue]
      have hIfRun :
          Functions.Source.Block.runOpen prim program ctxAfterPre
              bodyTargetFuel.succ.succ
              { stmts := [Functions.Stmt.if_ lowerCond lowerBody] }
              compilerAfterPre =
            .ok (sourceOutcomeBody, ctxAfterPre) := by
        cases sourceOutcomeBody with
        | mk bodyState bodyMode =>
            cases bodyMode
            · exfalso
              exact hNonregularBody rfl
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
      rcases
