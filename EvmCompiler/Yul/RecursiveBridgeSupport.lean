/--
Recover the direct statement result from a singleton source sequence.

Generated-control frontiers often inspect the single statement first, while
the public bridge is phrased over `execSeq ... [stmt]`. This adapter keeps the
singleton fuel bookkeeping out of the branch proofs.
-/
theorem result_eq_of_execSeq_single_succ
    {fuel : Nat} {stmt : AstStmt} {codeOverride : Option AstContract}
    {source : State} {headResult sourceResult : Except Exception State}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride source = headResult)
    (hSeq :
      EvmYul.Yul.execSeq fuel.succ [stmt] codeOverride source =
        sourceResult) :
    headResult = sourceResult := by
  rw [Imported.execSeq_single_succ hHead] at hSeq
  exact hSeq

/--
Recover the direct statement result's `allowed` proof from an allowed singleton
source sequence.
-/
theorem allowed_of_execSeq_single_succ
    {allowed : Except Exception State → Prop}
    {fuel : Nat} {stmt : AstStmt} {codeOverride : Option AstContract}
    {source : State} {headResult sourceResult : Except Exception State}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride source = headResult)
    (hSeq :
      EvmYul.Yul.execSeq fuel.succ [stmt] codeOverride source =
        sourceResult)
    (hAllowed : allowed sourceResult) :
    allowed headResult := by
  have hEq : headResult = sourceResult :=
    result_eq_of_execSeq_single_succ hHead hSeq
  simpa [hEq] using hAllowed

