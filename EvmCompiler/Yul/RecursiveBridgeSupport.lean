The switch head consumes the raw scrutinee path and either falls through after an
empty selected block or enters the selected body.  Regular completion enters the
tail at the retained hidden context; stopping completion skips the emitted tail.
-/
theorem sourceOpenResultSeqPathSoundWhenAtExactHiddenCtx_cons_switch_expr_prelude_raw
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {bodyFuel : Nat} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody rest : List AstStmt}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {lowerScrutinee : Locals.Expr 1}
    {lowerCases : List (Word × Functions.Block)}
    {lowerDefault : Option Functions.Block}
    {lowerTail : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
