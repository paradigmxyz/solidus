/--
Source-tower block soundness for general uninitialized declarations.

This replaces the singleton-specific proof path with the real Yul shape:
`let x, y, ...` lowers to a sequence of zero-initializing source lets, extends
the open scope in reverse declaration order, and then the enclosing block
cleans those locals back out.
-/
theorem sourceResultBlockSoundWhenAt_let_none
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (names : List EvmYul.Identifier)
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hNoDup : (identNames names).Nodup)
    (hFreshLayout :
      ∀ name, name ∈ identNames names → name ∉ layout) :
    SourceResultBlockSoundWhenAt cfg layout layout terminalRel revertRel
      prim program ctx sourceFuel [.Let names none] codeOverride
      { stmts := Stmt.initNames (identNames names) }
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.exec 0 (.Block [.Let names none]) codeOverride source =
            .error .OutOfFuel :=
        Imported.exec_zero (.Block [.Let names none]) codeOverride source
      rw [hZero] at hSource
      subst sourceResult
      cases hAllowed hAllow
  | succ fuel =>
      cases fuel with
      | zero =>
          have hOne :
              EvmYul.Yul.exec 1 (.Block [.Let names none]) codeOverride
                  source =
                .error .OutOfFuel := by
            simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]
          rw [hOne] at hSource
          subst sourceResult
          cases hAllowed hAllow
      | succ fuel =>
          cases fuel with
          | zero =>
              have hTwo :
                  EvmYul.Yul.exec 2 (.Block [.Let names none]) codeOverride
                      source =
                    .error .OutOfFuel := by
                simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                  EvmYul.Yul.exec]
              rw [hTwo] at hSource
              subst sourceResult
              cases hAllowed hAllow
          | succ fuel =>
              cases hInitial with
              | @ok shared store _ hShared hVars =>
                  cases hCheck :
                      EvmYul.Yul.checkDeclaration (.Ok shared store) names with
                  | error err =>
                      have hErr :
                          EvmYul.Yul.exec fuel.succ.succ.succ
                              (.Block [.Let names none]) codeOverride
                              (.Ok shared store) =
                            .error err := by
                        rw [Imported.exec_block_cons_succ]
                        rw [Imported.execSeq_cons_error_succ]
                        rw [Imported.exec_let_none_succ]
                        rw [hCheck]
                      rw [hErr] at hSource
                      subst sourceResult
                      exact False.elim
                        (checkDeclaration_error_not_relatable hCheck
                          (hAllowed hAllow))
                  | ok unitVal =>
                      have hCheckOk :
                          EvmYul.Yul.checkDeclaration (.Ok shared store)
                              names =
                            .ok () := by
                        simpa using hCheck
                      rcases
                          functions_source_initNames_runOpen_regular
                            (prim := prim) (program := program) (ctx := ctx)
                            (compiler := compiler) (identNames names)
                            hNoDup
                            (by
                              intro name hMem hCtxMem
                              exact hFreshLayout name hMem
                                (by simpa [hScope] using hCtxMem)) with
                        ⟨compilerAfter, hRunOpen, hSharedAfter,
                          hPreserve⟩
                      refine
                        ⟨Functions.Source.Outcome.regular
                            (compilerAfter.restrictTo layout),
                          (identNames names).length + 1, ?_, ?_⟩
                      · unfold Functions.Source.Block.runScoped
                        rw [hRunOpen]
                        simp [Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular, hScope]
                      · rw [← hSource]
                        rw [exec_block_let_none_succ_succ_succ_clean_of_check
                          fuel codeOverride shared store names hCheckOk]
                        exact
                          SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular
                              (SourceStateRel.ok
                                (by
                                  simpa [Locals.Source.State.restrictTo,
                                    hSharedAfter] using hShared)
                                (by
                                  intro other hMem
                                  have hCtxMem : other ∈ ctx.scope := by
                                    simpa [hScope] using hMem
                                  have hPreserveOther :=
                                    hPreserve other hCtxMem
                                  simpa [Locals.Source.State.restrictTo,
                                    Locals.Source.Store.restrictTo_mem hMem,
                                    hPreserveOther] using hVars other hMem)))

/--
Source-tower block soundness for a singleton uninitialized declaration.

The imported side either succeeds with the declared name scoped away by the
enclosing block, or reports a duplicate declaration.  The run-filtered theorem
rules out that duplicate-declaration branch, while the compiler-source side
runs the corresponding generated `let` and then performs the same scoped
cleanup.
-/
theorem sourceResultBlockSoundWhenAt_let_single_none
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (name : EvmYul.Identifier)
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hFreshLayout : identName name ∉ layout) :
    SourceResultBlockSoundWhenAt cfg layout layout terminalRel revertRel
      prim program ctx sourceFuel [.Let [name] none] codeOverride
      { stmts :=
        [Functions.Stmt.let_ (identName name)
          (Locals.Expr.lit VarStackRel.zeroWord)] }
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.exec 0 (.Block [.Let [name] none]) codeOverride source =
            .error .OutOfFuel :=
        Imported.exec_zero (.Block [.Let [name] none]) codeOverride source
      rw [hZero] at hSource
      subst sourceResult
      cases hAllowed hAllow
  | succ fuel =>
      cases fuel with
      | zero =>
          have hOne :
              EvmYul.Yul.exec 1 (.Block [.Let [name] none]) codeOverride
                  source =
                .error .OutOfFuel := by
            simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]
          rw [hOne] at hSource
          subst sourceResult
          cases hAllowed hAllow
      | succ fuel =>
          cases fuel with
          | zero =>
              have hTwo :
                  EvmYul.Yul.exec 2 (.Block [.Let [name] none]) codeOverride
                      source =
                    .error .OutOfFuel := by
                simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                  EvmYul.Yul.exec]
              rw [hTwo] at hSource
              subst sourceResult
              cases hAllowed hAllow
          | succ fuel =>
              cases hInitial with
              | @ok shared store _ hShared hVars =>
                  cases hLookup : store.lookup (identName name) with
                  | none =>
                      refine
                        ⟨Functions.Source.Outcome.regular
                            ((compiler.insert (identName name)
                              VarStackRel.zeroWord).restrictTo layout),
                          2, ?_, ?_⟩
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen,
                          Functions.Source.Stmt.run,
                          Functions.Source.Expr.evalOne,
                          Locals.Source.Expr.evalOne,
                          Locals.Source.Expr.eval,
                          Locals.Source.State.insert,
                          VarStackRel.zeroWord, hScope,
                          Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular]
                      · rw [← hSource]
                        rw [exec_block_let_single_none_succ_succ_succ_clean_of_fresh
                          fuel codeOverride shared store name hLookup]
                        exact
                          SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular
                              (SourceStateRel.ok hShared (by
                                intro other hMem
                                have hNe :
                                    other ≠ identName name := by
                                  intro hEq
                                  exact hFreshLayout (by simpa [hEq] using hMem)
                                have hOriginal :
                                    (compiler.insert (identName name)
                                      VarStackRel.zeroWord).vars other =
                                      compiler.vars other := by
                                  simp [Locals.Source.State.insert,
                                    Locals.Source.Store.insert, hNe]
                                simpa [Locals.Source.State.restrictTo,
                                  Locals.Source.Store.restrictTo, hMem,
                                  hOriginal] using hVars other hMem)))
                  | some oldValue =>
                      have hErr :
                          EvmYul.Yul.exec fuel.succ.succ.succ
                              (.Block [.Let [name] none]) codeOverride
                              (.Ok shared store) =
                            .error (.DuplicateDeclaration name) :=
                        exec_block_let_single_none_succ_succ_succ_error_of_declared
                          fuel codeOverride shared store name hLookup
                      rw [hErr] at hSource
                      subst sourceResult
                      cases hAllowed hAllow

/--
Source-tower block soundness for a singleton literal-initialized declaration.

The initialized local is visible only inside the enclosing Yul block; after
the imported block restriction and the source `runScoped` cleanup, both sides
return to the entry layout. Duplicate declarations are ruled out by the
run-filtered relatability predicate, as in the uninitialized declaration case.
-/
theorem sourceResultBlockSoundWhenAt_let_lit_single
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (name : EvmYul.Identifier) (value : Word)
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hFreshLayout : identName name ∉ layout) :
    SourceResultBlockSoundWhenAt cfg layout layout terminalRel revertRel
      prim program ctx sourceFuel [.Let [name] (some (.Lit value))]
      codeOverride
      { stmts := [Functions.Stmt.let_ (identName name) (.lit value)] }
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.exec 0 (.Block [.Let [name] (some (.Lit value))])
              codeOverride source =
            .error .OutOfFuel :=
        Imported.exec_zero (.Block [.Let [name] (some (.Lit value))])
          codeOverride source
      rw [hZero] at hSource
      subst sourceResult
      cases hAllowed hAllow
  | succ fuel =>
      cases fuel with
      | zero =>
          have hOne :
              EvmYul.Yul.exec 1 (.Block [.Let [name] (some (.Lit value))])
                  codeOverride source =
                .error .OutOfFuel := by
            simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]
          rw [hOne] at hSource
          subst sourceResult
          cases hAllowed hAllow
      | succ fuel =>
          cases fuel with
          | zero =>
              have hTwo :
                  EvmYul.Yul.exec 2
                      (.Block [.Let [name] (some (.Lit value))])
                      codeOverride source =
                    .error .OutOfFuel := by
                simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                  EvmYul.Yul.exec]
              rw [hTwo] at hSource
              subst sourceResult
              cases hAllowed hAllow
          | succ fuel =>
              cases fuel with
              | zero =>
                  cases hInitial with
                  | @ok shared store _ _hShared _hVars =>
                      cases hCheck :
                          EvmYul.Yul.checkDeclaration (.Ok shared store)
                            [name] with
                      | error err =>
                          have hErr :
                              EvmYul.Yul.exec 3
                                  (.Block [.Let [name] (some (.Lit value))])
                                  codeOverride (.Ok shared store) =
                                .error err := by
                            rw [Imported.exec_block_cons_succ]
                            rw [Imported.execSeq_cons_error_succ]
                            rw [Imported.exec_let_lit_succ]
                            rw [hCheck]
                          rw [hErr] at hSource
                          subst sourceResult
                          exact False.elim
                            (checkDeclaration_error_not_relatable hCheck
                              (hAllowed hAllow))
                      | ok unitVal =>
                          have hOut :
                              EvmYul.Yul.exec 3
                                  (.Block [.Let [name] (some (.Lit value))])
                                  codeOverride (.Ok shared store) =
                                .error .OutOfFuel := by
                            rw [Imported.exec_block_cons_succ]
                            rw [Imported.execSeq_cons_error_succ]
                            rw [Imported.exec_let_lit_succ]
                            rw [hCheck]
                            simp [EvmYul.Yul.evalValues,
                              EvmYul.Yul.multifill']
                          rw [hOut] at hSource
                          subst sourceResult
                          cases hAllowed hAllow
              | succ fuel =>
                  cases hInitial with
                  | @ok shared store _ hShared hVars =>
                      cases hLookup : store.lookup (identName name) with
                      | none =>
                          refine
                            ⟨Functions.Source.Outcome.regular
                                ((compiler.insert (identName name) value)
                                  |>.restrictTo layout),
                              2, ?_, ?_⟩
                          · simp [Functions.Source.Block.runScoped,
                              Functions.Source.Block.runOpen,
                              Functions.Source.Stmt.run,
                              Functions.Source.Expr.evalOne,
                              Locals.Source.Expr.evalOne,
                              Locals.Source.Expr.eval,
                              Locals.Source.State.insert, hScope,
                              Functions.Source.Outcome.regular,
                              Locals.Source.Outcome.regular]
                          · rw [← hSource]
                            rw [exec_block_let_single_lit_succ_succ_succ_succ_clean_of_fresh
                              fuel codeOverride shared store name value
                              hLookup]
                            exact
                              SourceResultOutcomeRel.ok
                                (SourceOkOutcomeRel.regular
                                  (SourceStateRel.ok hShared (by
                                    intro other hMem
                                    have hNe :
                                        other ≠ identName name := by
                                      intro hEq
                                      exact hFreshLayout
                                        (by simpa [hEq] using hMem)
                                    have hOriginal :
                                        (compiler.insert (identName name)
                                            value).vars other =
                                          compiler.vars other := by
                                      simp [Locals.Source.State.insert,
                                        Locals.Source.Store.insert, hNe]
                                    simpa [Locals.Source.State.restrictTo,
                                      Locals.Source.Store.restrictTo, hMem,
                                      hOriginal] using hVars other hMem)))
                      | some oldValue =>
                          have hErr :
                              EvmYul.Yul.exec fuel.succ.succ.succ.succ
                                  (.Block [.Let [name] (some (.Lit value))])
                                  codeOverride (.Ok shared store) =
                                .error (.DuplicateDeclaration name) :=
                            exec_block_let_single_lit_succ_succ_succ_succ_error_of_declared
                              fuel codeOverride shared store name value
                              hLookup
                          rw [hErr] at hSource
                          subst sourceResult
                          cases hAllowed hAllow

/--
Checked lowerer-aware uninitialized declaration bridge for arbitrary name
lists.
-/
theorem checkedStmtBlockLoweringSoundWhenFreshAt_let_none
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (names : List EvmYul.Identifier)
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hNoDup : (identNames names).Nodup)
    (hFreshLayout :
      ∀ name, name ∈ identNames names → name ∉ layout) :
    CheckedStmtBlockLoweringSoundWhenFreshAt cfg layout layout terminalRel
      revertRel prim program ctx sourceFuel (.Let names none) codeOverride
  allowed := by
  intro freshState freshState' lowerStmts _hCovers hLower
  have hLower' :
      (some (Stmt.initNames (identNames names), freshState) :
          Option (List Functions.Stmt × Fresh.State)) =
        some (lowerStmts, freshState') := by
    simpa [Stmt.toFunctionsList?, Stmt.fuel, Stmt.toFunctionsListFuel?]
      using hLower
  injection hLower' with hPair
  obtain ⟨hStmts, _hFresh⟩ := Prod.mk.injEq .. |>.mp hPair
  subst hStmts
  exact
    sourceResultBlockSoundWhenAt_let_none names hAllowed hScope hNoDup
      hFreshLayout

/--
Uninitialized declarations are exact-domain sound at any layout-compatible
outcome target.

The declaration can either fail with a front-end error or complete regularly
after block cleanup; neither path produces an abrupt checkpoint, so the generic
no-checkpoint relayout adapter applies.
-/
theorem checkedStmtBlockLoweringSoundWhenFreshAtExact_let_none_of_compat
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (names : List EvmYul.Identifier)
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hScope : ctx.scope = layout)
    (hNoDup : (identNames names).Nodup)
    (hFreshLayout : ∀ name, name ∈ identNames names → name ∉ layout) :
    CheckedStmtBlockLoweringSoundWhenFreshAtExact cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel (.Let names none)
      codeOverride allowed :=
  checkedStmtBlockLoweringSoundWhenFreshAtExact_same_layout_of_compat_no_checkpoint
