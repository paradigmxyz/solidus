/--
Checked regular singleton bridge for a bracketed block whose body is regular.

The statement lowerer may supply any positive body-lowering fuel, so the body
proof is requested as a compile-fuel-parametric regular exact-domain sequence.
The block statement itself falls through at the entry layout because
`runScoped`/Yul block cleanup hide body-local declarations.
-/
theorem checkedRegularStmtSingletonSoundAtExact_block_of_regularSeqExactDomain
    {cfg : StateRelConfig} {layout layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract}
    (hRegular :
      ∀ {compileFuel},
        CheckedRegularSeqLoweringSoundWhenFreshAtCompileFuelExactDomain cfg
          layout layoutAfter prim program ctx sourceFuel targetFuel
          compileFuel body codeOverride) :
    CheckedRegularStmtSingletonSoundAtExact cfg layout layout prim program ctx
      sourceFuel.succ targetFuel (.Block body) codeOverride := by
  intro lowerFuel freshState freshState' lowerHeadStmts hCovers hLower
  cases lowerFuel with
  | zero =>
      simp [Stmt.toFunctionsListFuel?] at hLower
  | succ bodyFuel =>
      rcases
          BridgeFacts.toFunctionsListFuel?_block_components
            (fuel := bodyFuel) hLower with
        ⟨lowerBody, hBodyLower, hLowerHead⟩
      subst lowerHeadStmts
      rcases (hRegular (compileFuel := bodyFuel)) hCovers hBodyLower with
        ⟨hCoversAfter, hSeq⟩
      rcases hSeq with ⟨hScope, hRun⟩
      refine ⟨Functions.Stmt.block lowerBody, rfl, hCoversAfter, ?_⟩
      exact
        sourceRegularStmtSoundAtExact_block_of_regular_block
          (cfg := cfg) (layout := layout) (prim := prim)
          (program := program) (ctx := ctx)
          (sourceFuel := sourceFuel.succ) (targetFuel := targetFuel)
          (body := body) (codeOverride := codeOverride)
          (lowerBlock := lowerBody) hScope
          (fun {source} {compiler} hRel =>
            match hRel with
            | SourceStateExactRel.ok hShared hVars hDomain =>
                sourceRegularBlockRunAtExact_of_seqDomain
                  (cfg := cfg) (layout := layout)
                  (layoutAfter := layoutAfter) (prim := prim)
                  (program := program) (ctx := ctx)
                  (sourceFuel := sourceFuel) (targetFuel := targetFuel)
                  (sourceStmts := body) (codeOverride := codeOverride)
                  (shared := _) (scope := _) (compiler := compiler)
                  (lowerBlock := lowerBody) hDomain
                  (hRun (SourceStateExactRel.ok hShared hVars hDomain)))

/--
Checked regular exact-domain sequence composition for singleton regular heads.

This is the regular-body analogue of the result-sequence checked cons rule in
`BridgeFacts`: it threads the lowerer's fresh state through a singleton regular
head and into the tail, while returning coverage for the original entry layout.
-/
theorem checkedRegularSeqLoweringSoundWhenFreshAtCompileFuelExactDomain_cons_regular_stmt_single
    {cfg : StateRelConfig}
    {layout layoutMid layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel lowerFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    (hLayoutSubset : ∀ name, name ∈ layout → name ∈ layoutMid)
    (hHead :
      CheckedRegularStmtSingletonSoundAtExact cfg layout layoutMid prim
        program ctx sourceFuel targetFuel head codeOverride)
    (hTail :
      ∀ {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        CheckedRegularSeqLoweringSoundWhenFreshAtCompileFuelExactDomain cfg
          layoutMid layoutAfter prim program ctxMid sourceFuel targetFuel
          lowerFuel.succ rest codeOverride) :
    CheckedRegularSeqLoweringSoundWhenFreshAtCompileFuelExactDomain cfg layout
      layoutAfter prim program ctx sourceFuel.succ targetFuel.succ
      lowerFuel.succ.succ (head :: rest) codeOverride := by
  intro freshState freshState' lowerBlock hCovers hLower
  rcases BridgeFacts.listToBlockFuel?_components (fuel := lowerFuel.succ)
      hLower with
    ⟨lower, hFuncs, hBlockEq⟩
  rcases BridgeFacts.listToFunctionsFuel?_cons_components
      (fuel := lowerFuel) hFuncs with
    ⟨lowerHeadStmts, stateHead, lowerRest, hHeadLower, hTailLower,
      hLowerEq⟩
  rcases hHead hCovers hHeadLower with
    ⟨lowerHead, hHeadEq, hCoversMid, hHeadSound⟩
  have hTailBlock :
      Stmt.List.toBlockFuel? lowerFuel.succ stateHead rest =
        some ({ stmts := lowerRest }, freshState') := by
    cases lowerFuel with
    | zero =>
        have hHeadLowerSingleton :
            Stmt.toFunctionsListFuel? 0 freshState head =
              some ([lowerHead], stateHead) := by
          simpa [hHeadEq] using hHeadLower
        simp [Stmt.toFunctionsListFuel?] at hHeadLowerSingleton
    | succ lowerFuel =>
        simpa [Stmt.List.toBlockFuel?, hTailLower]
  rcases
      (hTail (ctxMid := { ctx with scope := layoutMid }) rfl)
        hCoversMid hTailBlock with
    ⟨hCoversAfterMid, hTailSound⟩
  have hBlockEq' :
      lowerBlock = { stmts := lowerHead :: lowerRest } := by
    rw [hBlockEq, hLowerEq, hHeadEq]
    rfl
  cases hBlockEq'
  refine ⟨?_, ?_⟩
  · intro name hMem
    exact hCoversAfterMid name (hLayoutSubset name hMem)
  · exact
      sourceRegularSeqSoundAtFuelExactDomain_cons_regular_stmt
        (cfg := cfg) (layout := layout) (layoutMid := layoutMid)
        (layoutAfter := layoutAfter) (prim := prim) (program := program)
        (ctx := ctx) (sourceFuel := sourceFuel) (targetFuel := targetFuel)
        (head := head) (rest := rest) (codeOverride := codeOverride)
        (lowerHead := lowerHead) (lowerTail := { stmts := lowerRest })
        hHeadSound
        (fun {ctxMid} hCtxMid =>
          ((hTail hCtxMid) hCoversMid hTailBlock).2)

/--
Names-aware regular exact-domain sequence composition for singleton regular
heads.

This is the same compositional proof as
`checkedRegularSeqLoweringSoundWhenFreshAtCompileFuelExactDomain_cons_regular_stmt_single`,
but the fresh-state invariant is `reserved ++ layout`.  That lets the
imported-Yul bridge reserve all contract source names once, then reveal them
lexically as declarations enter scope.
-/
theorem checkedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelExactDomain_cons_regular_stmt_single
    {cfg : StateRelConfig}
    {reserved layout layoutMid layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel lowerFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    (hHead :
      CheckedRegularStmtSingletonSoundAtExactWithNames cfg reserved layout
        layoutMid prim program ctx sourceFuel targetFuel head codeOverride)
    (hTail :
      ∀ {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        CheckedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelExactDomain cfg
          reserved layoutMid layoutAfter prim program ctxMid sourceFuel
          targetFuel lowerFuel.succ rest codeOverride) :
    CheckedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelExactDomain cfg
      reserved layout layoutAfter prim program ctx sourceFuel.succ
      targetFuel.succ lowerFuel.succ.succ (head :: rest) codeOverride := by
  intro freshState freshState' lowerBlock hCovers hLower
  rcases BridgeFacts.listToBlockFuel?_components (fuel := lowerFuel.succ)
      hLower with
    ⟨lower, hFuncs, hBlockEq⟩
  rcases BridgeFacts.listToFunctionsFuel?_cons_components
      (fuel := lowerFuel) hFuncs with
    ⟨lowerHeadStmts, stateHead, lowerRest, hHeadLower, hTailLower,
      hLowerEq⟩
  rcases hHead hCovers hHeadLower with
    ⟨lowerHead, hHeadEq, hCoversMid, hHeadSound⟩
  have hTailBlock :
      Stmt.List.toBlockFuel? lowerFuel.succ stateHead rest =
        some ({ stmts := lowerRest }, freshState') := by
    cases lowerFuel with
    | zero =>
        have hHeadLowerSingleton :
            Stmt.toFunctionsListFuel? 0 freshState head =
              some ([lowerHead], stateHead) := by
          simpa [hHeadEq] using hHeadLower
        simp [Stmt.toFunctionsListFuel?] at hHeadLowerSingleton
    | succ lowerFuel =>
        simpa [Stmt.List.toBlockFuel?, hTailLower]
  rcases
      (hTail (ctxMid := { ctx with scope := layoutMid }) rfl)
        hCoversMid hTailBlock with
    ⟨hCoversAfter, hTailSound⟩
  have hBlockEq' :
      lowerBlock = { stmts := lowerHead :: lowerRest } := by
    rw [hBlockEq, hLowerEq, hHeadEq]
    rfl
  cases hBlockEq'
  exact
    ⟨hCoversAfter,
      sourceRegularSeqSoundAtFuelExactDomain_cons_regular_stmt
        (cfg := cfg) (layout := layout) (layoutMid := layoutMid)
        (layoutAfter := layoutAfter) (prim := prim) (program := program)
        (ctx := ctx) (sourceFuel := sourceFuel) (targetFuel := targetFuel)
        (head := head) (rest := rest) (codeOverride := codeOverride)
        (lowerHead := lowerHead) (lowerTail := { stmts := lowerRest })
        hHeadSound
        (fun {ctxMid} hCtxMid =>
          ((hTail hCtxMid) hCoversMid hTailBlock).2)⟩

/--
Names-aware compile-fuel-parametric regular sequence constructor for
singleton regular heads.

This is the reserved-name analogue of
`checkedRegularSeqLoweringSoundWhenFreshAtCompileFuelParamExactDomain_cons_regular_stmt_single`.
It keeps low-fuel impossibilities local and delegates the real case to the
names-aware exact cons rule.
-/
theorem checkedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelParamExactDomain_cons_regular_stmt_single
    {cfg : StateRelConfig}
    {reserved layout layoutMid layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    (hHead :
      CheckedRegularStmtSingletonSoundAtExactWithNames cfg reserved layout
        layoutMid prim program ctx sourceFuel targetFuel head codeOverride)
    (hTail :
      ∀ {compileFuel : Nat} {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        CheckedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelExactDomain cfg
          reserved layoutMid layoutAfter prim program ctxMid sourceFuel
          targetFuel compileFuel rest codeOverride) :
    ∀ {compileFuel : Nat},
      CheckedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelExactDomain cfg
        reserved layout layoutAfter prim program ctx sourceFuel.succ
        targetFuel.succ compileFuel (head :: rest) codeOverride := by
  intro compileFuel
  cases compileFuel with
  | zero =>
      intro freshState freshState' lowerBlock _hCovers hLower
      simp [Stmt.List.toBlockFuel?] at hLower
  | succ fuel =>
      cases fuel with
      | zero =>
          intro freshState freshState' lowerBlock _hCovers hLower
          simp [Stmt.List.toBlockFuel?, Stmt.List.toFunctionsFuel?] at hLower
      | succ lowerFuel =>
          exact
            checkedRegularSeqLoweringSoundWhenFreshNamesAtCompileFuelExactDomain_cons_regular_stmt_single
              (cfg := cfg) (reserved := reserved) (layout := layout)
              (layoutMid := layoutMid) (layoutAfter := layoutAfter)
              (prim := prim) (program := program) (ctx := ctx)
              (sourceFuel := sourceFuel) (targetFuel := targetFuel)
              (lowerFuel := lowerFuel) (head := head) (rest := rest)
              (codeOverride := codeOverride) hHead
              (fun {ctxMid} hCtxMid =>
                hTail (compileFuel := lowerFuel.succ)
                  (ctxMid := ctxMid) hCtxMid)

/--
Names-aware result-sequence composition for singleton regular heads.

The head uses the names-aware singleton interface, so declarations can be
