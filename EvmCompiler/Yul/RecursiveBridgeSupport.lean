  unfold EvmYul.Yul.checkDeclaration at hCheck
  cases hDup : EvmYul.Yul.firstDuplicate? names with
  | some duplicate =>
      simp [hDup] at hCheck
      cases hCheck
      cases hRelatable
  | none =>
      simp [hDup] at hCheck
      cases hDecl : EvmYul.Yul.firstDeclared? state names with
      | some declared =>
          simp [hDecl] at hCheck
          cases hCheck
          cases hRelatable
      | none =>
          simp [hDecl] at hCheck

