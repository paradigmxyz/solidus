                  change
                    SourcePairResultCheckpointAllowed canBreak canContinue
                      canLeave
                      (match EvmYul.Yul.exec fuel' (.Block f.body)
                          codeOverride (.OutOfFuel : State) with
                      | Except.error e => Except.error e
