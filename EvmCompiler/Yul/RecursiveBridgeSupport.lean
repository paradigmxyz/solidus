theorem runLoopSourceAfterPost_regular_resolves_inv_loop_ok_source
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract}
    {shared store sharedPost : EvmYul.SharedState .Yul}
    {sourceStore storePost : EvmYul.Yul.VarStore}
    {trace : OpenExternal.OpenTrace} {sourceDone : Except Exception State}
    (hResolve :
      OpenExternal.OpenResultResolves
        (runLoopSourceAfterPost fuel cond post body codeOverride
          (.Ok shared sourceStore) (.Ok sharedPost storePost))
        trace sourceDone) :
    ∃ loopDone,
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel (.For cond post body) codeOverride
            (.Ok sharedPost storePost)))
        trace loopDone ∧
      sourceDone = loopDone := by
  rw [runLoopSourceAfterPost_regular] at hResolve
  rcases OpenExternal.OpenResultResolves.bind_inv hResolve with hErr | hOk
  · rcases hErr with ⟨err, hLoop, hDone⟩
    exact ⟨.error err, hLoop, hDone⟩
  · rcases hOk with
      ⟨loopTrace, suffix, loopResult, hTrace, hLoop, hSuffix⟩
    cases hSuffix
    simp only [List.append_nil] at hTrace
    subst trace
    exact
      ⟨.ok loopResult, hLoop,
        by simp [OpenExternal.OpenResult.ok,
          EvmYul.Yul.State.overwrite?]⟩

theorem runLoopSource_eq_bind_evalValues_after
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
