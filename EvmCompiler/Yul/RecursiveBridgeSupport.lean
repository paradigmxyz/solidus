                (Functions.Source.Outcome.regular
                  (condResult.1.restrictTo (ctx.withoutLoopControl).scope)))
          (compiler, true))
        (bodyTrace ++ postTrace) (.ok postOutcome) := by
    simp [bodyNext]
    exact
      OpenExternal.OpenResultResolves.bind_ok
        (next := bodyNext) hBodyMax hAfterBody
  simpa [CompilerOpen.FunctionsOpen.Stmt.runForLoop, bodyNext, loopFuel] using
    OpenExternal.OpenResultResolves.bind_ok hCond hAfterCond

/--
Selected open target path for the generated `for true` continuation itself when
the generated body completes regularly or by `continue`, the generated post
completes regularly, and the recursive loop iteration supplies the remaining
selected path.
-/
theorem compilerOpen_generated_runForLoop_resolves_body_regular_or_continue_post_regular_loop
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {lowerPost generatedBody : Functions.Block}
    {bodyFuel postFuel loopFuel : Nat} {compiler : Objects.Source.State}
    {bodyOutcome postOutcome loopOutcome : Functions.Source.Outcome}
    {bodyTrace postTrace loopTrace : OpenExternal.OpenTrace}
    (hBodyMode :
      bodyOutcome.mode = .regular ∨ bodyOutcome.mode = .cont)
    (hPostMode : postOutcome.mode = .regular)
    (hBody :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody bodyFuel compiler)
        bodyTrace (.ok bodyOutcome))
    (hPost :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl) lowerPost postFuel bodyOutcome.state)
        postTrace (.ok postOutcome))
    (hLoop :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
          (ctx.withoutLoopControl) (.lit (EvmYul.UInt256.ofNat 1))
          (ctx.withoutLoopControl) lowerPost
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody loopFuel postOutcome.state)
        loopTrace (.ok loopOutcome)) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
        (ctx.withoutLoopControl) (.lit (EvmYul.UInt256.ofNat 1))
        (ctx.withoutLoopControl) lowerPost
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        generatedBody
        (Nat.max bodyFuel (Nat.max postFuel loopFuel)).succ compiler)
      (bodyTrace ++ (postTrace ++ loopTrace)) (.ok loopOutcome) := by
  let shellFuel := Nat.max bodyFuel (Nat.max postFuel loopFuel)
  have hBodyLe : bodyFuel ≤ shellFuel := by
    dsimp [shellFuel]
    exact Nat.le_max_left bodyFuel (Nat.max postFuel loopFuel)
  have hPostLe : postFuel ≤ shellFuel := by
    dsimp [shellFuel]
    exact Nat.le_trans (Nat.le_max_left postFuel loopFuel)
      (Nat.le_max_right bodyFuel (Nat.max postFuel loopFuel))
  have hLoopLe : loopFuel ≤ shellFuel := by
    dsimp [shellFuel]
    exact Nat.le_trans (Nat.le_max_right postFuel loopFuel)
      (Nat.le_max_right bodyFuel (Nat.max postFuel loopFuel))
  have hBodyMax :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody shellFuel compiler)
        bodyTrace (.ok bodyOutcome) :=
    CompilerOpen.FunctionsOpen.Block.runScoped_resolves_mono prim program
      hBodyLe hBody
