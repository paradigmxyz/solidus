/--
Lift a checked inner block bridge through an outer block statement, in the
same-layout case.

This is the source-tower counterpart of the old block-prefix backend lemmas,
but it deliberately exposes the real restriction needed at this boundary:
regular block fallthrough closes back to the entry layout, so this theorem is
same-layout.  Abrupt handler layouts need their own statement/list-level
interface rather than an arbitrary `outcomeLayout` parameter.
-/
theorem sourceResultBlockSoundWhenAtExact_block_same_of_inner
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {innerFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hScope : ctx.scope = layout)
    (hInner :
      ∀ {allowedInner : Except Exception State → Prop},
        SourceResultBlockSoundWhenAtExact cfg layout layout terminalRel
          revertRel prim program ctx innerFuel body codeOverride lowerBody
          allowedInner) :
    SourceResultBlockSoundWhenAtExact cfg layout layout terminalRel revertRel
      prim program ctx innerFuel.succ.succ [.Block body] codeOverride
      { stmts := [Functions.Stmt.block lowerBody] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared scope compiler hShared hVars hDomain =>
      let innerResult : Except Exception State :=
        EvmYul.Yul.exec innerFuel (.Block body) codeOverride
          (.Ok shared scope : State)
      let wrap : Except Exception State → Except Exception State :=
        fun result =>
          match result with
          | .ok state => .ok (state.restrictStoreTo scope)
          | .error err => .error err
