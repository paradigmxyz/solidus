theorem primCall_safe_nonOk_state_eq_of_ok
    {fuel : Nat} {prim : EvmYul.Operation .Yul} {state stateAfter : State}
    {args values : List Word}
    (hSafe : Safe.primitive prim)
    (hNonOk : ∀ shared store, state ≠ (.Ok shared store : State))
    (hCall :
      EvmYul.Yul.primCall fuel state prim args = .ok (stateAfter, values)) :
    stateAfter = state := by
  cases prim with
  | StopArith op =>
      exact Yul.PrimSemantics.primCall_stopArith_state_eq_of_ok hCall
  | CompBit op =>
      exact Yul.PrimSemantics.primCall_compBit_state_eq_of_ok hCall
  | Keccak op =>
      cases op
      exact
        Yul.PrimSemantics.primCall_keccak256_state_eq_of_ok_of_nonOk
          hNonOk hCall
  | Env op =>
      have hSupported : Yul.PrimSemantics.EnvCheckpointSafe op := by
        cases op <;>
          simpa [Yul.PrimSemantics.EnvCheckpointSafe, Safe.primitive]
            using hSafe
      exact
        Yul.PrimSemantics.primCall_env_state_eq_of_ok_of_nonOk
          hSupported hNonOk hCall
  | Block op =>
      exact
        Yul.PrimSemantics.primCall_block_state_eq_of_ok_of_nonOk
          hNonOk hCall
  | StackMemFlow op =>
      have hSupported :
          Yul.PrimSemantics.StackMemFlowCheckpointSafe op := by
        cases op <;>
          simpa [Yul.PrimSemantics.StackMemFlowCheckpointSafe,
            Safe.primitive] using hSafe
      exact
        Yul.PrimSemantics.primCall_stackMemFlow_state_eq_of_ok_of_nonOk
          hSupported hNonOk hCall
  | Log op =>
      cases op with
      | LOG0 =>
          exact
            Yul.PrimSemantics.primCall_log0_state_eq_of_ok_of_nonOk
              hNonOk hCall
      | LOG1 =>
          exact
            Yul.PrimSemantics.primCall_log1_state_eq_of_ok_of_nonOk
              hNonOk hCall
      | LOG2 =>
          exact
            Yul.PrimSemantics.primCall_log2_state_eq_of_ok_of_nonOk
              hNonOk hCall
      | LOG3 =>
          exact
            Yul.PrimSemantics.primCall_log3_state_eq_of_ok_of_nonOk
              hNonOk hCall
      | LOG4 =>
          exact
            Yul.PrimSemantics.primCall_log4_state_eq_of_ok_of_nonOk
              hNonOk hCall
  | System op =>
      cases op with
      | CREATE =>
          simp [Safe.primitive] at hSafe
      | CALL =>
          simp [Safe.primitive] at hSafe
      | CALLCODE =>
          simp [Safe.primitive] at hSafe
      | RETURN =>
          exact
            False.elim
              (Yul.PrimSemantics.primCall_return_impossible_of_ok hCall)
      | DELEGATECALL =>
          simp [Safe.primitive] at hSafe
      | CREATE2 =>
          simp [Safe.primitive] at hSafe
      | STATICCALL =>
          simp [Safe.primitive] at hSafe
      | REVERT =>
          exact
            False.elim
              (Yul.PrimSemantics.primCall_revert_impossible_of_ok hCall)
      | INVALID =>
          exact
            False.elim
              (Yul.PrimSemantics.primCall_invalid_impossible_of_ok hCall)
      | SELFDESTRUCT =>
          exact
            False.elim
              (Yul.PrimSemantics.primCall_selfdestruct_impossible_of_ok
                hCall)

theorem primCall_safe_not_outOfFuel_of_ok
    {fuel : Nat} {prim : EvmYul.Operation .Yul}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {args values : List Word}
    (hSafe : Safe.primitive prim)
    (hCall :
      EvmYul.Yul.primCall fuel (.Ok shared store) prim args =
        .ok (.OutOfFuel, values)) :
    False := by
  cases prim with
  | StopArith op =>
      have hEq := Yul.PrimSemantics.primCall_stopArith_state_eq_of_ok hCall
      cases hEq
  | CompBit op =>
      have hEq := Yul.PrimSemantics.primCall_compBit_state_eq_of_ok hCall
      cases hEq
  | Keccak op =>
      cases op
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.primCall] at hCall
      | succ fuel =>
          simp [EvmYul.Yul.primCall] at hCall
          have hStep :
              EvmYul.step
                  ((.Keccak .KECCAK256 : EvmYul.Operation .Yul)) none =
                EvmYul.Yul.binaryMachineStateOp'
                  EvmYul.MachineState.keccak256 := by
            rfl
          rw [hStep] at hCall
          exact
            Yul.PrimSemantics.wrapped_binaryMachineStateOp'_not_outOfFuel_of_ok
              hCall
  | Env op =>
      have hSupported : Yul.PrimSemantics.EnvCheckpointSafe op := by
        cases op <;>
          simp [Yul.PrimSemantics.EnvCheckpointSafe, Safe.primitive]
            at hSafe ⊢
      exact
        Yul.PrimSemantics.primCall_env_not_outOfFuel_of_ok
          hSupported hCall
  | Block op =>
      exact Yul.PrimSemantics.primCall_block_not_outOfFuel_of_ok hCall
  | StackMemFlow op =>
      have hSupported :
          Yul.PrimSemantics.StackMemFlowCheckpointSafe op := by
        cases op <;>
          simp [Yul.PrimSemantics.StackMemFlowCheckpointSafe]
      exact
        Yul.PrimSemantics.primCall_stackMemFlow_not_outOfFuel_of_ok
          hSupported hCall
  | Log op =>
      cases op with
      | LOG0 =>
          exact Yul.PrimSemantics.primCall_log0_not_outOfFuel_of_ok hCall
      | LOG1 =>
          exact Yul.PrimSemantics.primCall_log1_not_outOfFuel_of_ok hCall
      | LOG2 =>
          exact Yul.PrimSemantics.primCall_log2_not_outOfFuel_of_ok hCall
      | LOG3 =>
          exact Yul.PrimSemantics.primCall_log3_not_outOfFuel_of_ok hCall
      | LOG4 =>
          exact Yul.PrimSemantics.primCall_log4_not_outOfFuel_of_ok hCall
  | System op =>
      cases op with
      | CREATE =>
          simp [Safe.primitive] at hSafe
      | CALL =>
          simp [Safe.primitive] at hSafe
      | CALLCODE =>
          simp [Safe.primitive] at hSafe
      | RETURN =>
          exact
            Yul.PrimSemantics.primCall_return_impossible_of_ok hCall
      | DELEGATECALL =>
          simp [Safe.primitive] at hSafe
      | CREATE2 =>
          simp [Safe.primitive] at hSafe
      | STATICCALL =>
          simp [Safe.primitive] at hSafe
      | REVERT =>
          exact
            Yul.PrimSemantics.primCall_revert_impossible_of_ok hCall
      | INVALID =>
          exact
            Yul.PrimSemantics.primCall_invalid_impossible_of_ok hCall
      | SELFDESTRUCT =>
          exact
            Yul.PrimSemantics.primCall_selfdestruct_impossible_of_ok hCall

theorem call_outOfFuel_state_eq_of_ok
    {fuel : Nat} {stateAfter : State} {args values : List Word}
    {fname : Option EvmYul.Yul.Ast.YulFunctionName}
    {codeOverride : Option EvmYul.Yul.Ast.YulContract}
    (h :
      EvmYul.Yul.call fuel args fname codeOverride .OutOfFuel =
        .ok (stateAfter, values)) :
    stateAfter = .OutOfFuel := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.call] at h
  | succ fuel =>
      simp [EvmYul.Yul.call, EvmYul.Yul.State.sharedState,
        EvmYul.Yul.State.executionEnv] at h
      cases hFind :
          (default : EvmYul.SharedState .Yul).accountMap.find?
            (default : EvmYul.ExecutionEnv .Yul).codeOwner with
      | none =>
          simp [hFind] at h
      | some yulContract =>
          simp [hFind] at h
          cases fname with
          | none =>
              let f : EvmYul.Yul.Ast.FunctionDefinition :=
                .Def [] [] [(codeOverride.getD yulContract.code).dispatcher]
              change
                (match EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                    (👌 (EvmYul.Yul.State.OutOfFuel).initcall
                      f.params f.rets args) with
                | Except.error e => Except.error e
                | Except.ok s2 =>
                    Except.ok
                      ((s2.reviveJump.overwrite?
                          (EvmYul.Yul.State.OutOfFuel)).setStore
                          (EvmYul.Yul.State.OutOfFuel),
                        List.map s2.lookup! f.rets)) =
                Except.ok (stateAfter, values) at h
              cases hExec :
                  EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                    (👌 (EvmYul.Yul.State.OutOfFuel).initcall
                      f.params f.rets args) with
              | error e =>
                  simp [hExec] at h
              | ok s2 =>
                  simp [hExec, EvmYul.Yul.State.overwrite?,
                    EvmYul.Yul.State.setStore] at h
                  exact h.1.symm
          | some fname' =>
              cases hLookup :
                  (codeOverride.getD yulContract.code).functions.lookup fname' with
              | none =>
                  simp [hLookup] at h
              | some f =>
                  simp [hLookup] at h
                  cases hExec :
                      EvmYul.Yul.exec fuel (.Block f.body) codeOverride
                        (👌 (EvmYul.Yul.State.OutOfFuel).initcall
                          f.params f.rets args) with
                  | error e =>
                      simp [hExec] at h
                  | ok s2 =>
                      simp [hExec, EvmYul.Yul.State.overwrite?,
                        EvmYul.Yul.State.setStore] at h
                      exact h.1.symm

theorem primCall_safe_state_domain_exact_of_ok
    {layout : List Name}
    {fuel : Nat} {prim : EvmYul.Operation .Yul} {state stateAfter : State}
    {args values : List Word}
    (hSafe : Safe.primitive prim)
    (hDomain : StateStoreDomainExact layout state)
    (hCall :
      EvmYul.Yul.primCall fuel state prim args = .ok (stateAfter, values)) :
    StateStoreDomainExact layout stateAfter := by
  cases state with
  | Ok shared store =>
      cases stateAfter with
      | Ok sharedAfter storeAfter =>
          have hStore : storeAfter = store :=
            PrimitiveCallStorePreservingForSafe.of_primitive_families
              hSafe hCall
          subst storeAfter
          simpa [StateStoreDomainExact] using hDomain
      | OutOfFuel =>
          simp [StateStoreDomainExact]
      | Checkpoint jump =>
          have hAllowed :
              SourcePairResultCheckpointAllowed false false false
                (EvmYul.Yul.primCall fuel (.Ok shared store) prim args) :=
            PrimitiveCallCheckpointAllowedForSafe.of_primitive_families hSafe
          have hJump :
              StateCheckpointAllowed false false false
                (.Checkpoint jump) := by
            simpa [SourcePairResultCheckpointAllowed, hCall] using hAllowed
          cases jump <;> simp [StateCheckpointAllowed] at hJump
  | OutOfFuel =>
      have hEq :
          stateAfter = (.OutOfFuel : State) :=
        primCall_safe_nonOk_state_eq_of_ok
          (state := .OutOfFuel) hSafe (by intro shared store h; cases h)
          hCall
      subst stateAfter
      simp [StateStoreDomainExact]
  | Checkpoint jump =>
      have hEq :
          stateAfter = (.Checkpoint jump : State) :=
        primCall_safe_nonOk_state_eq_of_ok
          (state := .Checkpoint jump) hSafe
          (by intro shared store h; cases h) hCall
      subst stateAfter
      simpa [StateStoreDomainExact] using hDomain

theorem evalValues_evalArgs_state_domain_exact_of_safe_primitiveFamilies
    (fuel : Nat) :
    (∀ {layout : List Name} {expr : AstExpr}
      {codeOverride : Option AstContract} {state stateAfter : State}
      {values : List Word},
      Safe.expr expr →
      StateStoreDomainExact layout state →
      EvmYul.Yul.evalValues fuel expr codeOverride state =
        .ok (stateAfter, values) →
      StateStoreDomainExact layout stateAfter) ∧
    (∀ {layout : List Name} {args : List AstExpr}
      {codeOverride : Option AstContract} {state stateAfter : State}
      {values : List Word},
      Safe.exprs args →
      StateStoreDomainExact layout state →
      EvmYul.Yul.evalArgs fuel args codeOverride state =
        .ok (stateAfter, values) →
      StateStoreDomainExact layout stateAfter) := by
  refine Nat.strong_induction_on fuel ?_
  intro fuel ih
  cases fuel with
  | zero =>
      constructor
      · intro layout expr codeOverride state stateAfter values _hSafe
          _hDomain hEval
        simp [EvmYul.Yul.evalValues] at hEval
      · intro layout args codeOverride state stateAfter values _hSafe
          _hDomain hEval
        simp [EvmYul.Yul.evalArgs] at hEval
  | succ fuel' =>
      have ihFuel := ih fuel' (Nat.lt_succ_self fuel')
      constructor
      · intro layout expr codeOverride state stateAfter values hSafe
          hDomain hEval
        cases expr with
        | Lit value =>
            simp [EvmYul.Yul.evalValues] at hEval
            exact hEval.1.symm ▸ hDomain
        | Var name =>
            cases hLookup : EvmYul.Yul.State.lookup? name state with
            | none =>
                simp [EvmYul.Yul.evalValues, hLookup] at hEval
            | some value =>
                simp [EvmYul.Yul.evalValues, hLookup] at hEval
                exact hEval.1.symm ▸ hDomain
        | Call callee args =>
            cases callee with
            | inl prim =>
                have hSafePrim : Safe.primitive prim := hSafe.1
                have hSafeArgs : Safe.exprs args := hSafe.2
                cases hArgsRaw :
                    EvmYul.Yul.evalArgs fuel' args.reverse codeOverride state with
                | error err =>
                    simp [EvmYul.Yul.evalValues, hArgsRaw,
                      EvmYul.Yul.reverse'] at hEval
                | ok argPair =>
                    rcases argPair with ⟨stateArgs, argValuesRaw⟩
                    have hArgsDomain :
                        StateStoreDomainExact layout stateArgs :=
                      ihFuel.2 (layout := layout) (args := args.reverse)
                        (codeOverride := codeOverride) (state := state)
                        (stateAfter := stateArgs) (values := argValuesRaw)
                        (safe_exprs_reverse hSafeArgs) hDomain hArgsRaw
                    cases hCall :
                        EvmYul.Yul.primCall fuel' stateArgs prim
                          argValuesRaw.reverse with
                    | error err =>
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                    | ok callPair =>
                        rcases callPair with ⟨stateCall, valuesCall⟩
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst stateAfter
                        exact
                          primCall_safe_state_domain_exact_of_ok
                            hSafePrim hArgsDomain hCall
            | inr functionName =>
                have hSafeArgs : Safe.exprs args := hSafe.2
                cases hArgsRaw :
                    EvmYul.Yul.evalArgs fuel' args.reverse codeOverride state with
                | error err =>
                    simp [EvmYul.Yul.evalValues, hArgsRaw,
                      EvmYul.Yul.reverse'] at hEval
                | ok argPair =>
                    rcases argPair with ⟨stateArgs, argValuesRaw⟩
                    have hArgsDomain :
                        StateStoreDomainExact layout stateArgs :=
                      ihFuel.2 (layout := layout) (args := args.reverse)
                        (codeOverride := codeOverride) (state := state)
                        (stateAfter := stateArgs) (values := argValuesRaw)
                        (safe_exprs_reverse hSafeArgs) hDomain hArgsRaw
                    cases hCall :
                        EvmYul.Yul.call fuel' argValuesRaw.reverse
                          functionName codeOverride stateArgs with
                    | error err =>
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                    | ok callPair =>
                        rcases callPair with ⟨stateCall, valuesCall⟩
                        simp [EvmYul.Yul.evalValues, hArgsRaw,
                          EvmYul.Yul.reverse', hCall] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst stateAfter
                        exact
                          call_ok_state_domain_exact_of_state
                            hArgsDomain hCall
      · intro layout args codeOverride state stateAfter values hSafe
          hDomain hEval
        cases args with
        | nil =>
            simp [EvmYul.Yul.evalArgs] at hEval
            exact hEval.1.symm ▸ hDomain
        | cons head tail =>
            have hHeadSafe : Safe.expr head := hSafe.1
            have hTailSafe : Safe.exprs tail := hSafe.2
            cases hHead :
                EvmYul.Yul.eval fuel' head codeOverride state with
            | error err =>
                simp [EvmYul.Yul.evalArgs, hHead,
                  EvmYul.Yul.evalTail] at hEval
            | ok headPair =>
                rcases headPair with ⟨stateHead, headValue⟩
                cases fuel' with
                | zero =>
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail] at hEval
                  | succ fuelTail =>
                    have ihTail :=
                      ih fuelTail
                        (Nat.lt_trans (Nat.lt_succ_self fuelTail)
                          (Nat.lt_succ_self (Nat.succ fuelTail)))
                    have hHeadDomain :
                        StateStoreDomainExact layout stateHead := by
                      cases hValues :
                          EvmYul.Yul.evalValues (Nat.succ fuelTail) head
                            codeOverride state with
                      | error err =>
                          simp [EvmYul.Yul.eval, EvmYul.Yul.head', hValues]
                            at hHead
                      | ok pair =>
                          rcases pair with ⟨stateValues, valueList⟩
                          simp [EvmYul.Yul.eval, EvmYul.Yul.head', hValues]
                            at hHead
                          rcases hHead with ⟨hState, _hValue⟩
                          subst stateValues
                          exact ihFuel.1 hHeadSafe hDomain hValues
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail, EvmYul.Yul.cons'] at hEval
                    cases hTail :
                        EvmYul.Yul.evalArgs fuelTail tail codeOverride
                          stateHead with
                    | error err =>
                        simp [hTail] at hEval
                    | ok tailPair =>
                        rcases tailPair with ⟨stateTail, tailValues⟩
                        simp [hTail] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst stateAfter
                        exact ihTail.2 hTailSafe hHeadDomain hTail

theorem evalValues_state_domain_exact_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract} {state stateAfter : State}
    {values : List Word}
    (hSafe : Safe.expr expr)
