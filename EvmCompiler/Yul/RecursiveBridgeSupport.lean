theorem exec_if_ok_domain_exact_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {cond : AstExpr}
    {body : List AstStmt} {codeOverride : Option AstContract}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    (hSafeCond : Safe.expr cond)
    (hSafeBody : Safe.stmts body)
    (hDomain : StoreDomainExact layout store)
    (hExec :
      EvmYul.Yul.exec fuel.succ (.If cond body) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter)) :
    StoreDomainExact layout storeAfter := by
  rw [Imported.exec_if_succ] at hExec
  cases hEval :
      EvmYul.Yul.eval fuel cond codeOverride (.Ok shared store) with
  | error err =>
      simp [hEval] at hExec
  | ok evalPair =>
      rcases evalPair with ⟨stateAfterCond, value⟩
      have hEvalDomain :
          stateAfterCond = .OutOfFuel ∨
            ∃ sharedCond storeCond,
              stateAfterCond = .Ok sharedCond storeCond ∧
                StoreDomainExact layout storeCond :=
        eval_ok_or_outOfFuel_domain_exact_of_safe_primitiveFamilies
          hSafeCond hDomain hEval
      by_cases hNonzero : value ≠ ({ val := 0 } : Word)
      · cases hEvalDomain with
        | inl hOut =>
            subst stateAfterCond
            have hBodyExec :
                EvmYul.Yul.exec fuel (.Block body) codeOverride .OutOfFuel =
                  .ok (.Ok sharedAfter storeAfter) := by
              simpa [hEval, hNonzero] using hExec
            have hStateEq :
                (.Ok sharedAfter storeAfter : State) = .OutOfFuel :=
              exec_block_outOfFuel_state_eq_of_safe_primitiveFamilies
                hSafeBody hBodyExec
            cases hStateEq
        | inr hOk =>
            rcases hOk with ⟨sharedCond, storeCond, hState, hCondDomain⟩
            subst stateAfterCond
            cases fuel with
            | zero =>
                have hZero :
                    EvmYul.Yul.exec 0 (.Block body) codeOverride
                        (.Ok sharedCond storeCond) =
                      .error .OutOfFuel :=
                  Imported.exec_zero (.Block body) codeOverride
                    (.Ok sharedCond storeCond : State)
                simp [hEval, hNonzero, hZero] at hExec
            | succ bodyFuel =>
                have hBodyExec :
                    EvmYul.Yul.exec bodyFuel.succ (.Block body)
                        codeOverride (.Ok sharedCond storeCond) =
                      .ok (.Ok sharedAfter storeAfter) := by
                  simpa [hEval, hNonzero] using hExec
                exact
                  exec_block_ok_domain_exact_of_execSeq_contains
                    (layout := layout) (fuel := bodyFuel) (stmts := body)
                    (codeOverride := codeOverride) (shared := sharedCond)
                    (sharedAfter := sharedAfter) (store := storeCond)
                    (storeAfter := storeAfter) hCondDomain
                    (SourceResultStoreContains.execSeq_ok_of_safe_primitiveFamilies
                      (layout := layout) (fuel := bodyFuel)
                      (stmts := body) (codeOverride := codeOverride)
                      (shared := sharedCond) (store := storeCond) hSafeBody
                      (StoreDomainContains.of_exact hCondDomain))
                    hBodyExec
      · have hZero : value = ({ val := 0 } : Word) := by
          exact Classical.not_not.mp hNonzero
        subst value
        cases hEvalDomain with
        | inl hOut =>
            subst stateAfterCond
            simp [hEval] at hExec
        | inr hOk =>
            rcases hOk with ⟨sharedCond, storeCond, hState, hCondDomain⟩
            subst stateAfterCond
            have hStateEq :
                (.Ok sharedCond storeCond : State) =
                  .Ok sharedAfter storeAfter := by
              simpa [hEval] using hExec
            cases hStateEq
            exact hCondDomain

theorem exec_switch_ok_domain_exact_of_safe_primitiveFamilies
    {layout : List Name} {fuel : Nat} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody : List AstStmt}
    {codeOverride : Option AstContract}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    (hSafeScrutinee : Safe.expr scrutinee)
    (hSafeCases : Safe.casesSafe cases)
    (hSafeDefault : Safe.stmts defaultBody)
    (hDomain : StoreDomainExact layout store)
    (hExec :
      EvmYul.Yul.exec fuel.succ (.Switch scrutinee cases defaultBody)
          codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter)) :
    StoreDomainExact layout storeAfter := by
  rw [Imported.exec_switch_succ] at hExec
  cases hEval :
      EvmYul.Yul.eval fuel scrutinee codeOverride (.Ok shared store) with
  | error err =>
      simp [hEval] at hExec
  | ok evalPair =>
      rcases evalPair with ⟨stateAfterCond, value⟩
      have hEvalDomain :
          stateAfterCond = .OutOfFuel ∨
            ∃ sharedCond storeCond,
              stateAfterCond = .Ok sharedCond storeCond ∧
                StoreDomainExact layout storeCond :=
        eval_ok_or_outOfFuel_domain_exact_of_safe_primitiveFamilies
          hSafeScrutinee hDomain hEval
      let selectedBody : List AstStmt :=
        EvmYul.Yul.selectSwitchCase value defaultBody cases
      have hSafeSelected : Safe.stmts selectedBody := by
        simpa [selectedBody] using
          safe_cases_selectSwitchCase (value := value) hSafeCases
            hSafeDefault
      cases hEvalDomain with
      | inl hOut =>
          subst stateAfterCond
          have hBodyExec :
              EvmYul.Yul.exec fuel (.Block selectedBody) codeOverride
                  .OutOfFuel =
                .ok (.Ok sharedAfter storeAfter) := by
            simpa [hEval, selectedBody] using hExec
          have hStateEq :
              (.Ok sharedAfter storeAfter : State) = .OutOfFuel :=
            exec_block_outOfFuel_state_eq_of_safe_primitiveFamilies
              hSafeSelected hBodyExec
          cases hStateEq
      | inr hOk =>
          rcases hOk with ⟨sharedCond, storeCond, hState, hCondDomain⟩
          subst stateAfterCond
          cases fuel with
          | zero =>
              have hZero :
                  EvmYul.Yul.exec 0 (.Block selectedBody) codeOverride
                      (.Ok sharedCond storeCond) =
                    .error .OutOfFuel :=
                Imported.exec_zero (.Block selectedBody) codeOverride
                  (.Ok sharedCond storeCond : State)
              simp [hEval, selectedBody, hZero] at hExec
          | succ bodyFuel =>
              have hBodyExec :
                  EvmYul.Yul.exec bodyFuel.succ (.Block selectedBody)
                      codeOverride (.Ok sharedCond storeCond) =
                    .ok (.Ok sharedAfter storeAfter) := by
                simpa [hEval, selectedBody] using hExec
              exact
                exec_block_ok_domain_exact_of_execSeq_contains
                  (layout := layout) (fuel := bodyFuel)
                  (stmts := selectedBody) (codeOverride := codeOverride)
                  (shared := sharedCond) (sharedAfter := sharedAfter)
                  (store := storeCond) (storeAfter := storeAfter)
                  hCondDomain
                  (SourceResultStoreContains.execSeq_ok_of_safe_primitiveFamilies
                    (layout := layout) (fuel := bodyFuel)
                    (stmts := selectedBody) (codeOverride := codeOverride)
                    (shared := sharedCond) (store := storeCond)
                    hSafeSelected (StoreDomainContains.of_exact hCondDomain))
                  hBodyExec

theorem sourceRegularStmtRunHiddenExact_block_of_hiddenBlockSound_ok
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
