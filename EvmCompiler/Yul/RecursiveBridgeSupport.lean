    (hExecSeq :
      EvmYul.Yul.execSeq sourceFuel.succ.succ
          (.ExprStmtCall (.Call (.inl yulPrim) args) :: rest)
          codeOverride source =
        sourceResult) :
    sourceResult = .error err := by
  have hHead :
      EvmYul.Yul.exec sourceFuel.succ
          (.ExprStmtCall (.Call (.inl yulPrim) args)) codeOverride source =
        .error err := by
    simp [Imported.exec_expr_prim_call_succ, hArgs, EvmYul.Yul.reverse',
