            SourceResultOutcomeLayoutCompatible ctxAfterPre layout
              outcomeLayout sourceResult := by
        intro sourceResult hCompat
        exact
          SourceResultOutcomeLayoutCompatible.of_handler_eq
            (ctx := ctx) (ctx' := ctxAfterPre) (layout := layout)
            (outcomeLayout := outcomeLayout) (sourceResult := sourceResult)
            (Functions.SourceDirect.SourceRun.block_runOpen_regular_breakScope
