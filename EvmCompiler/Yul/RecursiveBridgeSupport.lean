  have hTerminalResolvePadded :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctxAfterArgs
          (argsFuel + 2) { stmts := [Functions.Stmt.terminalArgs kind seq] }
          compilerAfterArgs)
        [] (.ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfterArgs)) :=
    CompilerOpen.FunctionsOpen.Block.runOpen_resolves_mono prim program
      (by omega) hTerminalResolve
  have hPrefixTerminal :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx
          (preArgs.length + (argsFuel + 2))
          { stmts := preArgs ++ [Functions.Stmt.terminalArgs kind seq] }
          compiler)
        (argsTrace ++ [])
        (.ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfterArgs)) :=
    compilerOpen_block_runOpen_append_resolves_regular
      (prim := prim) (program := program) (ctx := ctx)
      (ctxAfter := ctxAfterArgs) (headStmts := preArgs)
      (suffix := [Functions.Stmt.terminalArgs kind seq])
      (prefixFuel := argsFuel) (suffixFuel := argsFuel + 2)
      (state := compiler) (compilerAfter := compilerAfterArgs)
      (prefixTrace := argsTrace) (suffixTrace := [])
      (targetDone :=
        .ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfterArgs))
      (by omega) hTargetArgs hTerminalResolvePadded
  have hMode :
      (Functions.Source.Outcome.halt kind
          (compilerAfterArgs.withShared sharedAfter)).mode ≠
        Locals.Source.Mode.regular := by
    simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
  have hWithTail :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx
          ((preArgs ++ [Functions.Stmt.terminalArgs kind seq]).length +
            (argsFuel + terminalFuel + 2))
          { stmts :=
            (preArgs ++ [Functions.Stmt.terminalArgs kind seq]) ++ lowerTail }
          compiler)
        (argsTrace ++ [])
        (.ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfterArgs)) :=
    compilerOpen_block_runOpen_append_resolves_nonregular
      (prim := prim) (program := program) (ctx := ctx)
      (ctxAfter := ctxAfterArgs)
      (headStmts := preArgs ++ [Functions.Stmt.terminalArgs kind seq])
      (suffix := lowerTail) (prefixFuel := preArgs.length + (argsFuel + 2))
      (suffixFuel := argsFuel + terminalFuel + 2) (state := compiler)
      (compilerAfter := compilerAfterArgs.withShared sharedAfter)
      (mode := Locals.Source.Mode.halt kind)
      (prefixTrace := argsTrace ++ [])
      (by
        simp only [List.length_append, List.length_singleton]
        omega) hMode hPrefixTerminal
  simpa [List.append_assoc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
    using hWithTail

