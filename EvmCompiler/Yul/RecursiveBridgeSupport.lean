/--
Terminal-aware generated-argument-prefix completion relation.

The regular branch is the existing raw argument-prefix contract: the generated
statement prefix preserves the visible source state and the lowered pure
argument list computes the reversed source values.  A nested internal call in
that generated prefix may instead halt or revert; those branches retain the
full target statement outcome so the enclosing raw expression can stop without
pretending that argument evaluation returned values.
-/
def SourceArgTerminalRawPreludeOpenDoneRel
    (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (lowerArgs : List (Locals.Expr 1)) :
    Except EvmYul.Yul.Exception (State × List Word) →
      Except Functions.EVMException
        (Functions.Source.Outcome × Functions.Source.Ctx) → Prop
  | .ok sourceResult, .ok (targetOutcome, _ctxAfter) =>
      match targetOutcome.mode with
      | .regular =>
          SourceStateRel cfg layout sourceResult.1 targetOutcome.state ∧
            Functions.Source.ArgList.eval prim lowerArgs
                targetOutcome.state =
              .ok (targetOutcome.state, sourceResult.2.reverse)
      | .brk | .cont | .leave | .halt _ => False
  | .error (.YulHalt source value), .ok (targetOutcome, _ctxAfter) =>
      match targetOutcome.mode with
      | .halt kind => terminalRel kind value source targetOutcome.state
      | .regular | .brk | .cont | .leave => False
  | .error (.Revert source), .ok (targetOutcome, _ctxAfter) =>
      match targetOutcome.mode with
      | .halt .revert => revertRel source targetOutcome.state
      | .regular | .brk | .cont | .leave | .halt _ => False
  | _, _ => False

theorem sourceArgTerminalRawPreludeOpenDoneRel_terminal_suffix_trace_empty
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {argExprs : List (Locals.Expr 1)}
    {argFuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {kind : Assembly.HaltKind} {rest : List AstStmt}
    {codeOverride : Option AstContract}
    {sourceArgsResult : State × List Word}
    {targetArgsResult : Functions.Source.Outcome × Functions.Source.Ctx}
    {compilerAfterArgs : Objects.Source.State}
    {ctxAfterArgs : Functions.Source.Ctx}
    {terminalTrace : OpenExternal.OpenTrace}
    {sourceDone : Except Exception State}
    (hTerminal : Prim.terminal? yulPrim = some kind)
    (hArgsDone :
      SourceArgTerminalRawPreludeOpenDoneRel cfg layout terminalRel revertRel
        prim argExprs (.ok sourceArgsResult) (.ok targetArgsResult))
    (hTargetEq :
      targetArgsResult =
        (Functions.Source.Outcome.regular compilerAfterArgs, ctxAfterArgs))
    (hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.OpenResult.bind
          (OpenExternal.YulOpenResult.toOpenResult
            (OpenExternal.YulOpen.execPrimCall argFuel yulPrim []
              (OpenExternal.YulOpenResult.ok
                (sourceArgsResult.1, sourceArgsResult.2.reverse))))
          (fun sourceAfter =>
            match sourceAfter with
            | .Ok _ _ =>
                OpenExternal.YulOpenResult.toOpenResult
                  (OpenExternal.YulOpen.execSeq argFuel.succ rest
                    codeOverride sourceAfter)
            | .OutOfFuel => .done (.ok sourceAfter)
            | .Checkpoint _ => .done (.ok sourceAfter)))
        terminalTrace sourceDone) :
    terminalTrace = [] := by
  subst targetArgsResult
  rcases sourceArgsResult with ⟨sourceAfter, values⟩
  simp [SourceArgTerminalRawPreludeOpenDoneRel] at hArgsDone
  rcases hArgsDone with ⟨hRelAfter, _hArgEval⟩
  cases hRelAfter with
  | ok hShared hVars =>
      exact
        yulOpen_terminal_prim_suffix_resolves_empty_trace
          (argFuel := argFuel) (yulPrim := yulPrim) (kind := kind)
          (rest := rest) (codeOverride := codeOverride)
          (values := values.reverse) hTerminal hResolve

