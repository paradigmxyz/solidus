      | .Checkpoint _ => .done (.ok sourceAfter))

def runExprStmtTerminalSource
    (argFuel : Nat) (yulPrim : EvmYul.Operation .Yul)
    (args : List AstExpr) (rest : List AstStmt)
    (codeOverride : Option AstContract) (source : State) :
    OpenExternal.OpenResult Exception State :=
  OpenExternal.OpenResult.bind
    (OpenExternal.YulOpenResult.toOpenResult
      (OpenExternal.YulOpen.execPrimCall argFuel yulPrim []
        (OpenExternal.YulOpen.reverseResult
          (OpenExternal.YulOpen.evalArgs argFuel args.reverse codeOverride
            source))))
    (fun sourceAfter =>
      match sourceAfter with
      | .Ok _ _ =>
          OpenExternal.YulOpenResult.toOpenResult
            (OpenExternal.YulOpen.execSeq argFuel.succ rest codeOverride
              sourceAfter)
      | .OutOfFuel => .done (.ok sourceAfter)
      | .Checkpoint _ => .done (.ok sourceAfter))

def runIfSource
    (exprFuel : Nat) (cond : AstExpr) (body : List AstStmt)
    (codeOverride : Option AstContract) (source : State) :
    OpenExternal.OpenResult Exception State :=
  OpenExternal.OpenResult.bind
    (OpenExternal.YulOpenResult.toOpenResult
      (OpenExternal.YulOpen.evalValues exprFuel cond codeOverride source))
    (fun result =>
      OpenExternal.OpenResult.bind
        (.done (EvmYul.Yul.head' (.ok result)))
        (fun condResult =>
          if condResult.2 ≠ EvmYul.UInt256.ofNat 0 then
            OpenExternal.YulOpenResult.toOpenResult
              (OpenExternal.YulOpen.exec exprFuel (.Block body) codeOverride
                condResult.1)
          else
            OpenExternal.OpenResult.ok condResult.1))

def runSwitchSource
    (exprFuel : Nat) (scrutinee : AstExpr)
    (cases : List (Word × List AstStmt)) (defaultBody : List AstStmt)
    (codeOverride : Option AstContract) (source : State) :
    OpenExternal.OpenResult Exception State :=
  OpenExternal.OpenResult.bind
    (OpenExternal.YulOpenResult.toOpenResult
      (OpenExternal.YulOpen.evalValues exprFuel scrutinee codeOverride source))
    (fun result =>
      OpenExternal.OpenResult.bind
        (.done (EvmYul.Yul.head' (.ok result)))
        (fun scrutineeResult =>
          OpenExternal.YulOpenResult.toOpenResult
            (OpenExternal.YulOpen.exec exprFuel
              (.Block
                (EvmYul.Yul.selectSwitchCase scrutineeResult.2 defaultBody
                  cases))
              codeOverride scrutineeResult.1)))

def runLoopSource
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (source : State) :
    OpenExternal.OpenResult Exception State :=
  OpenExternal.OpenResult.bind
    (OpenExternal.YulOpenResult.toOpenResult
      (OpenExternal.YulOpen.eval fuel cond codeOverride
        (EvmYul.Yul.State.mkOk source)))
    (fun condResult =>
      if condResult.2 = EvmYul.UInt256.ofNat 0 then
        OpenExternal.OpenResult.ok
          (EvmYul.Yul.State.overwrite? condResult.1 source)
      else
        OpenExternal.OpenResult.bind
          (OpenExternal.YulOpenResult.toOpenResult
            (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
              condResult.1))
          (fun bodyResult =>
            match bodyResult with
            | .OutOfFuel =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? bodyResult source)
            | .Checkpoint (.Break _ _) =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite?
                    (EvmYul.Yul.State.reviveJump bodyResult) source)
            | .Checkpoint (.Leave _ _) =>
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? bodyResult source)
            | .Checkpoint (.Continue _ _) | _ =>
                OpenExternal.OpenResult.bind
                  (OpenExternal.YulOpenResult.toOpenResult
                    (OpenExternal.YulOpen.exec fuel (.Block post) codeOverride
                      (EvmYul.Yul.State.reviveJump bodyResult)))
                  (fun postResult =>
                    let stateAfterPost :=
                      EvmYul.Yul.State.overwrite? postResult source
                    match postResult with
                    | .OutOfFuel =>
                        OpenExternal.OpenResult.ok stateAfterPost
                    | .Checkpoint (.Leave _ _) =>
                        OpenExternal.OpenResult.ok stateAfterPost
                    | _ =>
                        OpenExternal.OpenResult.bind
                          (OpenExternal.YulOpenResult.toOpenResult
                            (OpenExternal.YulOpen.exec fuel
                              (.For cond post body) codeOverride
                              stateAfterPost))
                          (fun loopResult =>
                            OpenExternal.OpenResult.ok
                              (EvmYul.Yul.State.overwrite? loopResult
                                source)))))

/--
Expose the productive loop condition as a raw open expression path.

Loop preservation ultimately reuses the expression-level CALL proof for the
condition prelude. This equation keeps the pure singleton projection separate
from the `evalValues` trace, which is where external calls can occur.
-/
theorem runLoopSource_eq_bind_evalValues
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (source : State) :
    runLoopSource fuel cond post body codeOverride source =
      OpenExternal.OpenResult.bind
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues fuel cond codeOverride
            (EvmYul.Yul.State.mkOk source)))
        (fun result =>
          OpenExternal.OpenResult.bind
            (.done (EvmYul.Yul.head' (.ok result)) :
              OpenExternal.OpenResult Exception (State × Word))
            (fun condResult =>
              if condResult.2 = EvmYul.UInt256.ofNat 0 then
                OpenExternal.OpenResult.ok
                  (EvmYul.Yul.State.overwrite? condResult.1 source)
              else
                OpenExternal.OpenResult.bind
                  (OpenExternal.YulOpenResult.toOpenResult
                    (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
                      condResult.1))
                  (fun bodyResult =>
                    match bodyResult with
                    | .OutOfFuel =>
                        OpenExternal.OpenResult.ok
                          (EvmYul.Yul.State.overwrite? bodyResult source)
                    | .Checkpoint (.Break _ _) =>
                        OpenExternal.OpenResult.ok
                          (EvmYul.Yul.State.overwrite?
                            (EvmYul.Yul.State.reviveJump bodyResult) source)
                    | .Checkpoint (.Leave _ _) =>
                        OpenExternal.OpenResult.ok
                          (EvmYul.Yul.State.overwrite? bodyResult source)
                    | .Checkpoint (.Continue _ _) | _ =>
                        OpenExternal.OpenResult.bind
                          (OpenExternal.YulOpenResult.toOpenResult
                            (OpenExternal.YulOpen.exec fuel (.Block post)
                              codeOverride
                              (EvmYul.Yul.State.reviveJump bodyResult)))
                          (fun postResult =>
                            let stateAfterPost :=
                              EvmYul.Yul.State.overwrite? postResult source
                            match postResult with
                            | .OutOfFuel =>
                                OpenExternal.OpenResult.ok stateAfterPost
                            | .Checkpoint (.Leave _ _) =>
                                OpenExternal.OpenResult.ok stateAfterPost
                            | _ =>
                                OpenExternal.OpenResult.bind
                                  (OpenExternal.YulOpenResult.toOpenResult
                                    (OpenExternal.YulOpen.exec fuel
                                      (.For cond post body) codeOverride
                                      stateAfterPost))
                                  (fun loopResult =>
                                    OpenExternal.OpenResult.ok
                                      (EvmYul.Yul.State.overwrite? loopResult
                                        source)))))) := by
  unfold runLoopSource
  rw [yulOpen_toOpenResult_eval_eq_bind_evalValues]
  rw [openResult_bind_assoc_sourceBridge]

/-- Continuation selected after the loop post block has produced a state. -/
def runLoopSourceAfterPost
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (postResult : State) :
    OpenExternal.OpenResult Exception State :=
  let stateAfterPost := EvmYul.Yul.State.overwrite? postResult source
  match postResult with
  | .OutOfFuel =>
      OpenExternal.OpenResult.ok stateAfterPost
  | .Checkpoint (.Leave _ _) =>
      OpenExternal.OpenResult.ok stateAfterPost
  | _ =>
      OpenExternal.OpenResult.bind
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel (.For cond post body) codeOverride
            stateAfterPost))
        (fun loopResult =>
          OpenExternal.OpenResult.ok
            (EvmYul.Yul.State.overwrite? loopResult source))

/-- Continuation selected after the loop body block has produced a state. -/
def runLoopSourceAfterBody
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (bodyResult : State) :
    OpenExternal.OpenResult Exception State :=
  match bodyResult with
  | .OutOfFuel =>
      OpenExternal.OpenResult.ok
        (EvmYul.Yul.State.overwrite? bodyResult source)
  | .Checkpoint (.Break _ _) =>
      OpenExternal.OpenResult.ok
        (EvmYul.Yul.State.overwrite?
          (EvmYul.Yul.State.reviveJump bodyResult) source)
  | .Checkpoint (.Leave _ _) =>
      OpenExternal.OpenResult.ok
        (EvmYul.Yul.State.overwrite? bodyResult source)
  | .Checkpoint (.Continue _ _) | _ =>
      OpenExternal.OpenResult.bind
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec fuel (.Block post) codeOverride
            (EvmYul.Yul.State.reviveJump bodyResult)))
        (runLoopSourceAfterPost fuel cond post body codeOverride source)

/-- Continuation selected after the loop condition singleton is known. -/
def runLoopSourceAfterHead
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (condResult : State × Word) :
    OpenExternal.OpenResult Exception State :=
  if condResult.2 = EvmYul.UInt256.ofNat 0 then
    OpenExternal.OpenResult.ok
      (EvmYul.Yul.State.overwrite? condResult.1 source)
  else
    OpenExternal.OpenResult.bind
      (OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.exec fuel (.Block body) codeOverride
          condResult.1))
      (runLoopSourceAfterBody fuel cond post body codeOverride source)

/--
Continuation selected after the loop condition has been evaluated as an
`evalValues` trace.

Naming this continuation lets the productive-loop proof invert the source trace
once, then dispatch on the pure singleton projection and body/post/recursive
branches without repeatedly expanding the whole loop interpreter.
-/
def runLoopSourceAfterEvalValues
    (fuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (result : State × List Word) :
    OpenExternal.OpenResult Exception State :=
  OpenExternal.OpenResult.bind
    (.done (EvmYul.Yul.head' (.ok result)) :
      OpenExternal.OpenResult Exception (State × Word))
    (runLoopSourceAfterHead fuel cond post body codeOverride source)

theorem runLoopSourceAfterHead_zero
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {source condState : State}
    {value : Word}
    (hZero : value = EvmYul.UInt256.ofNat 0) :
    runLoopSourceAfterHead fuel cond post body codeOverride source
        (condState, value) =
      OpenExternal.OpenResult.ok
        (EvmYul.Yul.State.overwrite? condState source) := by
  subst value
  simp [runLoopSourceAfterHead]

theorem runLoopSourceAfterHead_nonzero
    {fuel : Nat} {cond : AstExpr} {post body : List AstStmt}
    {codeOverride : Option AstContract} {source condState : State}
