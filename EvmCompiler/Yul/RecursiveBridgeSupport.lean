    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {blockResult : Except Exception State}
    (hBlock :
      SourceResultBlockKontSoundWhenAtExactHiddenScope cfg layout konts
        terminalRel revertRel prim program ctx sourceFuel.succ body
        codeOverride lowerBody
        (fun result => result = blockResult))
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hSource :
      EvmYul.Yul.exec sourceFuel.succ (.Block body) codeOverride
        (.Ok shared store) = blockResult)
    (hRelatable : SourceResultRelatable blockResult)
    (hNotRegularOk : SourceResultNotRegularOk blockResult) :
    SourceNonregularStmtRunKontHiddenExact cfg layout konts terminalRel
      revertRel prim program ctx sourceFuel.succ (.Block body)
      codeOverride (.Ok shared store) compiler
      { stmts := [Functions.Stmt.block lowerBody] } := by
  rcases hBlock hInitial rfl hSource with
    ⟨sourceOutcome, targetFuel, hTargetScoped, hOutcomeRel⟩
  have hMode : sourceOutcome.mode ≠ Locals.Source.Mode.regular := by
    cases blockResult with
    | error err =>
        cases hOutcomeRel with
        | yulHalt hTerminal =>
            simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
        | revert hRevert =>
            simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
    | ok source =>
        cases source with
        | Ok sharedOk storeOk =>
            exact False.elim hNotRegularOk
        | OutOfFuel =>
            exact False.elim
              (sourceResultRelatable_stateOutOfFuel_false hRelatable)
        | Checkpoint jump =>
            cases hOutcomeRel with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                | brk hRelState =>
                    simp [Functions.Source.Outcome.brk,
                      Locals.Source.Outcome.brk]
                | cont hRelState =>
                    simp [Functions.Source.Outcome.cont,
                      Locals.Source.Outcome.cont]
                | leave hRelState =>
                    simp [Functions.Source.Outcome.leave,
                      Locals.Source.Outcome.leave]
  rcases
      singletonBlockStmtRunOpen_of_runScoped
        (prim := prim) (program := program) (ctx := ctx)
        (block := lowerBody) (fuel := targetFuel) (state := compiler)
        (outcome := sourceOutcome) hTargetScoped with
    ⟨targetFuel', ctxAfter, hTargetOpen⟩
  exact
    ⟨blockResult, sourceOutcome, ctxAfter, targetFuel', hSource,
      hTargetOpen, hOutcomeRel, hMode⟩

