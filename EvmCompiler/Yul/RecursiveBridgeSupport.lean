theorem multifill'_primCall_terminal_nil_error
    {argFuel : Nat} {prim : EvmYul.Operation .Yul}
    {kind : Assembly.HaltKind}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {args : List Word}
    (hTerminal : Prim.terminal? prim = some kind) :
    ∃ err,
      EvmYul.Yul.multifill' []
          (EvmYul.Yul.primCall argFuel (.Ok shared store) prim args) =
        .error err := by
  cases argFuel with
  | zero =>
      exact ⟨.OutOfFuel, by simp [EvmYul.Yul.primCall, EvmYul.Yul.multifill']⟩
  | succ fuel =>
      cases prim <;> simp [Prim.terminal?] at hTerminal
      · rename_i op
        cases op <;> simp at hTerminal
        cases hTerminal
        refine
          ⟨.YulHalt
              ((.Ok shared store : State).setMachineState
                ((.Ok shared store : State).toMachineState.setHReturn
                  ByteArray.empty))
              (EvmYul.UInt256.ofNat 0),
            ?_⟩
        rw [Yul.PrimSemantics.primCall_stop_eq fuel (.Ok shared store) args]
        simp [EvmYul.Yul.multifill']
      · rename_i op
        cases op <;> simp [Prim.terminal?] at hTerminal
        · cases hTerminal
          cases hCall :
              EvmYul.Yul.primCall fuel.succ (.Ok shared store)
                ((.System .RETURN : EvmYul.Operation .Yul)) args with
          | ok out =>
              exact False.elim
                (Yul.PrimSemantics.primCall_return_impossible_of_ok hCall)
          | error err =>
              exact ⟨err, by simp [EvmYul.Yul.multifill']⟩
        · cases hTerminal
          cases hCall :
              EvmYul.Yul.primCall fuel.succ (.Ok shared store)
                ((.System .REVERT : EvmYul.Operation .Yul)) args with
          | ok out =>
              exact False.elim
                (Yul.PrimSemantics.primCall_revert_impossible_of_ok hCall)
          | error err =>
              exact ⟨err, by simp [EvmYul.Yul.multifill']⟩
        · cases hTerminal
          cases hCall :
              EvmYul.Yul.primCall fuel.succ (.Ok shared store)
                ((.System .SELFDESTRUCT : EvmYul.Operation .Yul)) args with
          | ok out =>
              exact False.elim
                (Yul.PrimSemantics.primCall_selfdestruct_impossible_of_ok
                  hCall)
          | error err =>
              exact ⟨err, by simp [EvmYul.Yul.multifill']⟩

theorem yulOpen_terminal_prim_suffix_resolves_empty_trace
    {argFuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {kind : Assembly.HaltKind} {rest : List AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {values : List Word}
    {terminalTrace : OpenExternal.OpenTrace}
    {sourceDone : Except Exception State}
    (hTerminal : Prim.terminal? yulPrim = some kind)
    (hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.OpenResult.bind
          (OpenExternal.YulOpenResult.toOpenResult
            (OpenExternal.YulOpen.execPrimCall argFuel yulPrim []
              (OpenExternal.YulOpenResult.ok
                ((.Ok shared store : State), values))))
          (fun sourceAfter =>
            match sourceAfter with
            | .Ok _ _ =>
                OpenExternal.YulOpenResult.toOpenResult
                  (OpenExternal.YulOpen.execSeq argFuel.succ rest
                    codeOverride sourceAfter)
            | .OutOfFuel => .done (.ok sourceAfter)
            | .Checkpoint _ => .done (.ok sourceAfter)))
        terminalTrace sourceDone) :
    terminalTrace = [] := by
  have hNoOpen :
      OpenExternal.CallKind.yulPrimitiveEvalValuesOpenCall?
          (.Ok shared store : State) yulPrim values =
        none :=
    yulPrimitiveEvalValuesOpenCall?_none_of_terminal hTerminal
  have hNoCreate :
      OpenExternal.CreateKind.yulPrimitiveEvalValuesOpenCreate?
          (.Ok shared store : State) yulPrim values =
        none :=
    yulPrimitiveEvalValuesOpenCreate?_none_of_terminal hTerminal
  have hNoCreateKind :
      OpenExternal.CreateKind.ofYulOperation? yulPrim = none :=
    createKind_ofYulOperation?_none_of_terminal hTerminal
  rcases
      multifill'_primCall_terminal_nil_error
        (argFuel := argFuel) (prim := yulPrim) (kind := kind)
        (shared := shared) (store := store) (args := values)
        hTerminal with
    ⟨err, hErr⟩
  have hExec :
      OpenExternal.YulOpen.execPrimCall argFuel yulPrim []
          (OpenExternal.YulOpenResult.ok
            ((.Ok shared store : State), values)) =
        OpenExternal.YulOpenResult.error err := by
    simp [OpenExternal.YulOpen.execPrimCall, OpenExternal.YulOpenResult.ok,
      OpenExternal.YulOpenResult.error, hNoOpen, hNoCreate, hNoCreateKind,
      hErr]
  have hSource :
      OpenExternal.OpenResult.bind
          (OpenExternal.YulOpenResult.toOpenResult
            (OpenExternal.YulOpen.execPrimCall argFuel yulPrim []
              (OpenExternal.YulOpenResult.ok
                ((.Ok shared store : State), values))))
          (fun sourceAfter =>
            match sourceAfter with
            | .Ok _ _ =>
                OpenExternal.YulOpenResult.toOpenResult
                  (OpenExternal.YulOpen.execSeq argFuel.succ rest
                    codeOverride sourceAfter)
            | .OutOfFuel => .done (.ok sourceAfter)
            | .Checkpoint _ => .done (.ok sourceAfter)) =
        .done (.error err) := by
    rw [hExec]
    rfl
  rw [hSource] at hResolve
  cases hResolve
  rfl

