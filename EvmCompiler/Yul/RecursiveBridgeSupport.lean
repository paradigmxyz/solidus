/--
Run-filtered source-result soundness for a source-order hidden terminal prelude.

This is the same compositional boundary as the stack-order theorem below, but it
is useful when the lowered expression sequence already produces values in the
order expected by the terminal primitive.
-/
theorem sourceResultBlockSoundWhenAt_terminalPrelude_of_preludeRegular
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat} {sourceStmts : List AstStmt}
    {sourceArgs : List AstExpr} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {kind : Assembly.HaltKind} {args : Locals.ExprSeq kind.argCount}
    {allowed : Except Exception State → Prop}
    (hBridge :
      SourceArgPreludeRegular cfg layout prim program ctx argFuel sourceArgs
        codeOverride pre args)
    (hPreShape : GeneratedPrelude pre)
    (hTerminal :
      ∀ {source compiler sourceResult},
        SourceStateRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
          sourceResult →
        ∃ sourceAfterArgs : State,
        ∃ sourceValues : List Word,
          EvmYul.Yul.evalArgs argFuel sourceArgs.reverse codeOverride source =
            .ok (sourceAfterArgs, sourceValues.reverse) ∧
          ∀ {compilerAfterArgs : Objects.Source.State},
            SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
              ∃ sharedAfter : EvmYul.SharedState .EVM,
                prim.terminal kind compilerAfterArgs.shared sourceValues =
                  .ok sharedAfter ∧
                SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
                  sourceResult
                  (Functions.Source.Outcome.halt kind
                    (compilerAfterArgs.withShared sharedAfter))) :
    SourceResultBlockSoundWhenAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel sourceStmts codeOverride
      { stmts := pre ++ [Functions.Stmt.terminalArgs kind args] } allowed := by
  refine ⟨hBridge.1, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hTerminal hInitial hAllow hSource with
    ⟨sourceAfterArgs, sourceValues, hEvalArgs, hTerminalRel⟩
  have hTerminalExists :
      ∀ {compilerAfterArgs : Objects.Source.State},
        SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
          ∃ sharedAfter,
            prim.terminal kind compilerAfterArgs.shared sourceValues =
              .ok sharedAfter := by
    intro compilerAfterArgs hRelArgs
    rcases hTerminalRel hRelArgs with ⟨sharedAfter, hTerminalRun, _hRel⟩
    exact ⟨sharedAfter, hTerminalRun⟩
  rcases
      hBridge.runScoped_terminalArgs hPreShape hInitial hEvalArgs
        hTerminalExists with
    ⟨compilerAfterArgs, sharedAfter, targetFuel, hTargetRun, hRelArgs,
      hTerminalRun⟩
  rcases hTerminalRel hRelArgs with
    ⟨sharedAfter', hTerminalRun', hOutcomeRel⟩
  have hSharedEq : sharedAfter = sharedAfter' := by
    rw [hTerminalRun] at hTerminalRun'
    injection hTerminalRun'
  cases hSharedEq
  exact ⟨Functions.Source.Outcome.halt kind
      (compilerAfterArgs.withShared sharedAfter),
    targetFuel, hTargetRun, hOutcomeRel⟩

