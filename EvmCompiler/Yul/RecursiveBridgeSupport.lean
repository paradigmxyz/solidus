theorem eval_user_call_ok_store_eq_of_arg_store
    {fuel : Nat} {shared sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {store storeArgs storeAfter : EvmYul.Yul.VarStore}
    {argValues : List Word} {out : Word}
    {functionName : EvmYul.Yul.Ast.YulFunctionName}
    {args : List AstExpr} {codeOverride : Option AstContract}
    (hArgs :
      EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs fuel args.reverse codeOverride
            (.Ok shared store)) =
        .ok (.Ok sharedArgs storeArgs, argValues))
    (hArgsStore : storeArgs = store)
    (hEval :
      EvmYul.Yul.eval fuel.succ (.Call (.inr functionName) args)
          codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, out)) :
    storeAfter = store := by
  cases hCall :
      EvmYul.Yul.call fuel argValues functionName codeOverride
        (.Ok sharedArgs storeArgs) with
  | error err =>
      simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, hArgs, hCall,
        EvmYul.Yul.head'] at hEval
  | ok result =>
      rcases result with ⟨sourceAfterCall, retValues⟩
      cases sourceAfterCall with
      | Ok sharedCall storeCall =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, hArgs, hCall,
            EvmYul.Yul.head'] at hEval
          have hCallStore : storeCall = storeArgs :=
            call_ok_store_eq hCall
          exact hEval.1.2.symm.trans (hCallStore.trans hArgsStore)
      | OutOfFuel =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, hArgs, hCall,
            EvmYul.Yul.head'] at hEval
      | Checkpoint j =>
          simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, hArgs, hCall,
            EvmYul.Yul.head'] at hEval

