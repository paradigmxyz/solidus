      ∀ {compileFuel : Nat} {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        CheckedSeqLoweringSoundWhenFreshAtCompileFuelExact cfg layoutMid
          ctxAfterLayout outcomeLayout terminalRel revertRel prim program
          ctxMid sourceFuel targetFuel compileFuel rest codeOverride
          allowed) :
    ∀ {compileFuel : Nat},
      CheckedSeqLoweringSoundWhenFreshAtCompileFuelExact cfg layout
        ctxAfterLayout outcomeLayout terminalRel revertRel prim program ctx
        sourceFuel.succ targetFuel.succ compileFuel (head :: rest)
        codeOverride allowed := by
  intro compileFuel
  cases compileFuel with
  | zero =>
      intro freshState freshState' lowerBlock _hCovers hLower
      simp [Stmt.List.toBlockFuel?] at hLower
  | succ fuel =>
      cases fuel with
      | zero =>
          intro freshState freshState' lowerBlock _hCovers hLower
          simp [Stmt.List.toBlockFuel?, Stmt.List.toFunctionsFuel?] at hLower
      | succ lowerFuel =>
          exact
            BridgeFacts.checkedSeqLoweringSoundWhenFreshAtCompileFuelExact_cons_regular_stmt_single
              (cfg := cfg) (layout := layout) (layoutMid := layoutMid)
              (ctxAfterLayout := ctxAfterLayout)
              (outcomeLayout := outcomeLayout) (terminalRel := terminalRel)
              (revertRel := revertRel) (prim := prim)
              (program := program) (ctx := ctx)
              (sourceFuel := sourceFuel) (targetFuel := targetFuel)
              (lowerFuel := lowerFuel) (head := head) (rest := rest)
              (codeOverride := codeOverride) (allowed := allowed)
              hHead
              (fun {ctxMid} hCtxMid =>
                hTail (compileFuel := lowerFuel.succ)
                  (ctxMid := ctxMid) hCtxMid)

