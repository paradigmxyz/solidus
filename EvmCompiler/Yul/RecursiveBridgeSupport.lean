/--
Selected open target path for the generated `for true` continuation itself when
the generated body exits by `break`.

This is the inner-loop version of the outer statement-shell lemma below. It is
the shape needed by recursive loop preservation after body and post have already
been selected.
-/
theorem compilerOpen_generated_runForLoop_resolves_body_brk
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {lowerPost generatedBody : Functions.Block}
    {bodyFuel : Nat} {compiler compilerAfterBody : Objects.Source.State}
    {trace : OpenExternal.OpenTrace}
    (hBody :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody bodyFuel compiler)
        trace (.ok (Functions.Source.Outcome.brk compilerAfterBody))) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
        (ctx.withoutLoopControl) (.lit (EvmYul.UInt256.ofNat 1))
        (ctx.withoutLoopControl) lowerPost
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        generatedBody bodyFuel.succ compiler)
      trace (.ok (Functions.Source.Outcome.regular compilerAfterBody)) := by
  have hCond :
      OpenExternal.OpenResultResolves
        (CompilerOpen.LocalsExpr.evalCondition prim
          (.lit (EvmYul.UInt256.ofNat 1)) compiler)
        [] (.ok (compiler, true)) :=
    compilerOpen_evalCondition_lit_one_resolves
      (prim := prim) (compiler := compiler)
  let bodyNext : Functions.Source.Outcome →
      CompilerOpen.Result Functions.Source.Outcome :=
    fun bodyOutcome =>
      match bodyOutcome.mode with
      | .brk =>
          OpenExternal.OpenResult.ok
            (Functions.Source.Outcome.regular bodyOutcome.state)
      | .regular =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.FunctionsOpen.Block.runScoped prim program
              (ctx.withoutLoopControl) lowerPost bodyFuel bodyOutcome.state)
            (fun postOutcome =>
              match postOutcome.mode with
              | .regular =>
                  CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
                    (ctx.withoutLoopControl)
                    (.lit (EvmYul.UInt256.ofNat 1))
                    (ctx.withoutLoopControl) lowerPost
                    (ctx.withoutLoopControl.withLoopControl ctx.scope
                      ctx.scope)
                    generatedBody bodyFuel postOutcome.state
              | .brk | .cont => CompilerOpen.invalid
              | .leave | .halt _ => OpenExternal.OpenResult.ok postOutcome)
      | .cont =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.FunctionsOpen.Block.runScoped prim program
              (ctx.withoutLoopControl) lowerPost bodyFuel bodyOutcome.state)
            (fun postOutcome =>
              match postOutcome.mode with
              | .regular =>
                  CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
                    (ctx.withoutLoopControl)
                    (.lit (EvmYul.UInt256.ofNat 1))
                    (ctx.withoutLoopControl) lowerPost
                    (ctx.withoutLoopControl.withLoopControl ctx.scope
                      ctx.scope)
                    generatedBody bodyFuel postOutcome.state
              | .brk | .cont => CompilerOpen.invalid
              | .leave | .halt _ => OpenExternal.OpenResult.ok postOutcome)
      | .leave | .halt _ =>
          OpenExternal.OpenResult.ok bodyOutcome
  have hAfterBody :
      OpenExternal.OpenResultResolves
        (bodyNext (Functions.Source.Outcome.brk compilerAfterBody))
        [] (.ok (Functions.Source.Outcome.regular compilerAfterBody)) := by
    simp [bodyNext, OpenExternal.OpenResult.ok,
      Functions.Source.Outcome.regular, Locals.Source.Outcome.regular,
      Functions.Source.Outcome.brk, Locals.Source.Outcome.brk]
    exact OpenExternal.OpenResultResolves.done
  have hAfterCond :
      OpenExternal.OpenResultResolves
        ((fun condResult : Objects.Source.State × Bool =>
            if condResult.2 then
              OpenExternal.OpenResult.bind
                (CompilerOpen.FunctionsOpen.Block.runScoped prim program
                  (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
                  generatedBody bodyFuel condResult.1)
                bodyNext
            else
              OpenExternal.OpenResult.ok
                (Functions.Source.Outcome.regular
                  (condResult.1.restrictTo (ctx.withoutLoopControl).scope)))
          (compiler, true))
        trace (.ok (Functions.Source.Outcome.regular compilerAfterBody)) := by
    simp [bodyNext]
    simpa [List.append_nil, bodyNext] using
      OpenExternal.OpenResultResolves.bind_ok
        (next := bodyNext) hBody hAfterBody
  simpa [CompilerOpen.FunctionsOpen.Stmt.runForLoop, bodyNext] using
    OpenExternal.OpenResultResolves.bind_ok hCond hAfterCond

/--
Selected open target path for the generated `for true` continuation itself when
the generated body exits by `leave` or `halt`.
-/
theorem compilerOpen_generated_runForLoop_resolves_body_leave_or_halt
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {lowerPost generatedBody : Functions.Block}
    {bodyFuel : Nat} {compiler : Objects.Source.State}
    {bodyOutcome : Functions.Source.Outcome}
    {trace : OpenExternal.OpenTrace}
    (hBodyMode :
      bodyOutcome.mode = .leave ∨
        ∃ kind : Assembly.HaltKind, bodyOutcome.mode = .halt kind)
    (hBody :
      OpenExternal.OpenResultResolves
        (CompilerOpen.FunctionsOpen.Block.runScoped prim program
          (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
          generatedBody bodyFuel compiler)
        trace (.ok bodyOutcome)) :
    OpenExternal.OpenResultResolves
      (CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
        (ctx.withoutLoopControl) (.lit (EvmYul.UInt256.ofNat 1))
        (ctx.withoutLoopControl) lowerPost
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        generatedBody bodyFuel.succ compiler)
      trace (.ok bodyOutcome) := by
  have hCond :
      OpenExternal.OpenResultResolves
        (CompilerOpen.LocalsExpr.evalCondition prim
          (.lit (EvmYul.UInt256.ofNat 1)) compiler)
        [] (.ok (compiler, true)) :=
    compilerOpen_evalCondition_lit_one_resolves
      (prim := prim) (compiler := compiler)
  let bodyNext : Functions.Source.Outcome →
      CompilerOpen.Result Functions.Source.Outcome :=
    fun bodyOutcome =>
      match bodyOutcome.mode with
      | .brk =>
          OpenExternal.OpenResult.ok
            (Functions.Source.Outcome.regular bodyOutcome.state)
      | .regular =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.FunctionsOpen.Block.runScoped prim program
              (ctx.withoutLoopControl) lowerPost bodyFuel bodyOutcome.state)
            (fun postOutcome =>
              match postOutcome.mode with
              | .regular =>
                  CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
                    (ctx.withoutLoopControl)
                    (.lit (EvmYul.UInt256.ofNat 1))
                    (ctx.withoutLoopControl) lowerPost
                    (ctx.withoutLoopControl.withLoopControl ctx.scope
                      ctx.scope)
                    generatedBody bodyFuel postOutcome.state
              | .brk | .cont => CompilerOpen.invalid
              | .leave | .halt _ => OpenExternal.OpenResult.ok postOutcome)
      | .cont =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.FunctionsOpen.Block.runScoped prim program
              (ctx.withoutLoopControl) lowerPost bodyFuel bodyOutcome.state)
            (fun postOutcome =>
              match postOutcome.mode with
              | .regular =>
                  CompilerOpen.FunctionsOpen.Stmt.runForLoop prim program
                    (ctx.withoutLoopControl)
                    (.lit (EvmYul.UInt256.ofNat 1))
                    (ctx.withoutLoopControl) lowerPost
                    (ctx.withoutLoopControl.withLoopControl ctx.scope
                      ctx.scope)
                    generatedBody bodyFuel postOutcome.state
              | .brk | .cont => CompilerOpen.invalid
              | .leave | .halt _ => OpenExternal.OpenResult.ok postOutcome)
      | .leave | .halt _ =>
          OpenExternal.OpenResult.ok bodyOutcome
  have hAfterBody :
      OpenExternal.OpenResultResolves (bodyNext bodyOutcome) []
        (.ok bodyOutcome) := by
    rcases bodyOutcome with ⟨bodyState, bodyMode⟩
    dsimp [bodyNext]
    rcases hBodyMode with hLeave | hHalt
    · cases bodyMode with
      | regular => simp at hLeave
      | brk => simp at hLeave
      | cont => simp at hLeave
      | leave =>
          simp [OpenExternal.OpenResult.ok, Functions.Source.Outcome.leave,
            Locals.Source.Outcome.leave]
          exact OpenExternal.OpenResultResolves.done
      | halt kind => simp at hLeave
    · rcases hHalt with ⟨kind, hHalt⟩
      cases bodyMode with
      | regular => simp at hHalt
      | brk => simp at hHalt
      | cont => simp at hHalt
      | leave => simp at hHalt
      | halt kind' =>
          simp [OpenExternal.OpenResult.ok, Functions.Source.Outcome.halt,
            Locals.Source.Outcome.halt]
