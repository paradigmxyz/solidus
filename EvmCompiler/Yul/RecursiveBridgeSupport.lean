/--
Regular-success argument prelude evidence strong enough for generated bound
arguments: after running the hidden prelude, before reading the generated
temporary variables, the source and target states are already exactly related.

For `Expr.List.lowerBound1?`, the lowered argument list is just generated
variables, so the later `ArgList.eval` readback does not mutate the source
tower state. This interface exposes that cleaner boundary to terminal
composition proofs.
-/
def SourceArgListPreludeRegularPreExactAt
    (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) : Prop :=
  ∀ {source compiler sourceAfter} {values : List Word},
    SourceStateExactRel cfg layout source compiler →
    EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
      .ok (sourceAfter, values.reverse) →
    ∃ compilerAfterPre : Objects.Source.State,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
      SourceStateExactRel cfg layout sourceAfter compilerAfterPre

theorem SourceArgListPreludeRegularAt.run_pre_exact_of_var_args_domain
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lower : List (Locals.Expr 1)}
    (hArgs :
      SourceArgListPreludeRegularAt cfg layout prim program ctx sourceFuel
        args codeOverride pre lower)
    (hLowerVars :
      ∃ names : List Name,
        lower = names.map (fun name => (.var name : Locals.Expr 1)))
    (hDomain :
      ∀ {shared store sharedAfter storeAfter} {values : List Word},
        StoreDomainExact layout store →
        EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
            (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter, values.reverse) →
        StoreDomainExact layout storeAfter) :
    SourceArgListPreludeRegularPreExactAt cfg layout prim program ctx
      sourceFuel args codeOverride pre := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomainInitial =>
      rcases hArgs.2 (SourceStateRel.ok hShared hVars) hEval with
        ⟨compilerAfterPre, compilerAfterArgs, ctxAfter, targetFuel,
          hPreRun, hArgsRun, hRelAfter⟩
      rcases hLowerVars with ⟨lowerNames, hLowerEq⟩
      subst lower
      have hCompilerAfterArgs :
          compilerAfterArgs = compilerAfterPre :=
        sourceArgList_eval_var_map_state_eq hArgsRun
      cases hCompilerAfterArgs
      cases hRelAfter with
      | @ok sharedAfter storeAfter compilerAfterPre hSharedAfter hVarsAfter =>
          have hDomainAfter : StoreDomainExact layout storeAfter :=
            hDomain hDomainInitial (by simpa using hEval)
          exact
            ⟨compilerAfterPre, ctxAfter, targetFuel, hPreRun,
              SourceStateExactRel.ok hSharedAfter hVarsAfter hDomainAfter⟩

