/--
Mode-facing soundness for an arbitrary hidden-scope source block.

Unlike `SourceResultBlockSoundWhenAtExactHiddenScope`, this contract does not
force every checkpoint through the final outcome layout.  That is important for
generated control code: loop-internal `break` and `continue` are consumed by the
generated loop and should only promise the source-visible state relation.
`leave` and terminal/error exits still use the outer outcome layout.
-/
structure HiddenBlockModeSound
    (cfg : StateRelConfig) (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract)
    (lowerBlock : Functions.Block) : Prop where
  regular :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      StoreDomainExact layout storeOut →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride
        (.Ok sharedIn storeIn) = .ok (.Ok sharedOut storeOut) →
      SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
      ∃ compilerOut : Objects.Source.State,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compilerIn =
          .ok (Functions.Source.Outcome.regular compilerOut) ∧
        SourceStateRel cfg layout (.Ok sharedOut storeOut) compilerOut
  brk :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      StoreDomainExact layout storeOut →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride
        (.Ok sharedIn storeIn) =
          .ok (.Checkpoint (.Break sharedOut storeOut)) →
      SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
      ∃ compilerOut : Objects.Source.State,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compilerIn =
          .ok (Functions.Source.Outcome.brk compilerOut) ∧
        SourceStateRel cfg layout (.Ok sharedOut storeOut) compilerOut
  cont :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      StoreDomainExact layout storeOut →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride
        (.Ok sharedIn storeIn) =
          .ok (.Checkpoint (.Continue sharedOut storeOut)) →
      SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
      ∃ compilerOut : Objects.Source.State,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compilerIn =
          .ok (Functions.Source.Outcome.cont compilerOut) ∧
        SourceStateRel cfg layout (.Ok sharedOut storeOut) compilerOut
  leave :
    ∀ {sharedIn sharedOut : EvmYul.SharedState .Yul}
      {storeIn storeOut : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State},
      StoreDomainExact layout storeIn →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride
        (.Ok sharedIn storeIn) =
          .ok (.Checkpoint (.Leave sharedOut storeOut)) →
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        (.ok (.Checkpoint (.Leave sharedOut storeOut))) →
      SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
      ∃ compilerOut : Objects.Source.State,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compilerIn =
          .ok (Functions.Source.Outcome.leave compilerOut) ∧
        SourceStateRel cfg outcomeLayout (.Ok sharedOut storeOut)
          compilerOut
  halt :
    ∀ {sharedIn : EvmYul.SharedState .Yul}
      {storeIn : EvmYul.Yul.VarStore}
      {compilerIn : Objects.Source.State}
      {sourceResult : Except Exception State},
      StoreDomainExact layout storeIn →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride
        (.Ok sharedIn storeIn) = sourceResult →
      SourceResultRelatable sourceResult →
      SourceResultNotRegularOk sourceResult →
      SourceResultNoCheckpoint sourceResult →
      SourceStateRel cfg layout (.Ok sharedIn storeIn) compilerIn →
      ∃ haltKind : Assembly.HaltKind,
      ∃ compilerOut : Objects.Source.State,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compilerIn =
          .ok (Functions.Source.Outcome.halt haltKind compilerOut) ∧
        SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
          sourceResult
          (Functions.Source.Outcome.halt haltKind compilerOut)

def CheckedHiddenBlockModeSoundWhenFreshNamesAtCompileFuelHiddenScope
    (cfg : StateRelConfig) (reserved layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel compileFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) : Prop :=
  ∀ {freshState freshState' lowerBlock},
    FreshCoversLayout (reserved ++ layout) freshState →
    Stmt.List.toBlockFuel? compileFuel freshState sourceStmts =
      some (lowerBlock, freshState') →
    HiddenBlockModeSound cfg layout outcomeLayout terminalRel revertRel prim
      program ctx sourceFuel sourceStmts codeOverride lowerBlock

/--
Exact-domain impossible-branch eliminator for run-filtered block soundness.

This is the exact-domain sibling of
`sourceResultBlockSoundWhenAt_of_exec_outOfFuel`.  It keeps low-fuel branches
in the recursive bridge compositional: once the imported block is known to
reduce to out-of-fuel, the `allowed`/`SourceResultRelatable` filter rules out
the branch before any source-tower execution is needed.
-/
theorem sourceResultBlockSoundWhenAtExact_of_exec_outOfFuel
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hExec :
      ∀ {source compiler},
        SourceStateExactRel cfg layout source compiler →
          EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
            .error .OutOfFuel) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel sourceStmts codeOverride
      lowerBlock allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  rw [hExec hInitial] at hSource
  subst sourceResult
  exact False.elim (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))

private theorem sourceFunDef_runBody_returned_of_bodySound_ok_core
    {cfg : StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {fn : Functions.FunDef}
    {args : List Word} {paramStore : Locals.Source.Store}
    {shared0 : EvmYul.SharedState .EVM}
    {sourceFuel : Nat} {sourceBody : List AstStmt}
    {codeOverride : Option AstContract}
    {sourceInitial bodyState : State}
    {allowed : Except Exception State → Prop}
    (hInsert :
      Functions.Source.Store.insertMany fn.params args
          Locals.Source.Store.empty =
        some paramStore)
    (hSound :
      SourceResultBlockSoundWhenAtExact cfg (fn.returns ++ fn.params)
        (fn.returns ++ fn.params) terminalRel revertRel prim program
        (Functions.Source.FunDef.bodyCtx fn) sourceFuel sourceBody
        codeOverride fn.body allowed)
    (hInitial :
      SourceStateExactRel cfg (fn.returns ++ fn.params) sourceInitial
        ({ shared := shared0,
           vars := Functions.Source.Store.initReturns fn.returns
             paramStore } : Objects.Source.State))
    (hAllowed : allowed (.ok bodyState))
    (hCheckpoint :
      SourceResultCheckpointAllowed false false true (.ok bodyState))
    (hNoOutOfFuel : bodyState ≠ .OutOfFuel)
    (hDomain :
      StateStoreDomainExact (fn.returns ++ fn.params) bodyState)
    (hExec :
      EvmYul.Yul.exec sourceFuel (.Block sourceBody) codeOverride
          sourceInitial =
        .ok bodyState) :
    ∃ bodyFuel : Nat, ∃ returnValues : List Word,
    ∃ bodyCompiler : Objects.Source.State,
      Functions.Source.FunDef.runBody prim program fn args bodyFuel shared0 =
        .ok
          (Functions.Source.CallResult.returned bodyCompiler.shared
            returnValues) ∧
      SourceStateRel cfg (fn.returns ++ fn.params)
        (EvmYul.Yul.State.reviveJump bodyState) bodyCompiler := by
  rcases hSound with ⟨_hScope, hRun⟩
  rcases hRun hInitial hAllowed hExec with
    ⟨sourceOutcome, targetFuel, hRunScoped, hOutcomeRel⟩
  cases hOutcomeRel with
  | ok hOk =>
      cases hOk with
      | @regular _sourceRel bodyCompiler hStateRel =>
          cases hStateRel with
          | @ok shared store _ hShared hVars =>
              have hDomainStore :
                  StoreDomainExact (fn.returns ++ fn.params) store := by
                simpa [StateStoreDomainExact] using hDomain
              let hExact :
                  SourceStateExactRel cfg (fn.returns ++ fn.params)
                    (.Ok shared store) bodyCompiler :=
                SourceStateExactRel.ok hShared hVars hDomainStore
              rcases
                  sourceFunDef_runBody_returned_of_runScoped_regular_exact
                    (cfg := cfg) (prim := prim) (program := program)
                    (fn := fn) (args := args) (paramStore := paramStore)
                    (shared0 := shared0) (out := bodyCompiler)
                    (fuel := targetFuel) (shared := shared)
                    (store := store) hInsert hRunScoped hExact with
                ⟨returnValues, hRunBody⟩
              refine ⟨targetFuel + 1, returnValues, bodyCompiler,
                hRunBody, ?_⟩
              simpa [EvmYul.Yul.State.reviveJump] using
                (SourceStateRel.ok hShared hVars)
      | brk hStateRel =>
          cases hStateRel with
          | ok _hShared _hVars =>
              have hFalse : False := by
                simpa [SourceResultCheckpointAllowed,
                  StateCheckpointAllowed] using hCheckpoint
              exact False.elim hFalse
      | cont hStateRel =>
          cases hStateRel with
          | ok _hShared _hVars =>
              have hFalse : False := by
                simpa [SourceResultCheckpointAllowed,
                  StateCheckpointAllowed] using hCheckpoint
              exact False.elim hFalse
      | @leave shared store bodyCompiler hStateRel =>
          cases hStateRel with
          | ok hShared hVars =>
              have hDomainStore :
                  StoreDomainExact (fn.returns ++ fn.params) store := by
                simpa [StateStoreDomainExact] using hDomain
              let hRel :
                  SourceStateRel cfg (fn.returns ++ fn.params)
                    (.Ok shared store) bodyCompiler :=
                SourceStateRel.ok hShared hVars
              rcases
                  sourceFunDef_runBody_returned_of_runScoped_leave_domain
                    (cfg := cfg) (prim := prim) (program := program)
                    (fn := fn) (args := args) (paramStore := paramStore)
                    (shared0 := shared0) (out := bodyCompiler)
                    (fuel := targetFuel) (shared := shared)
                    (store := store) hInsert hRunScoped hRel
                    hDomainStore with
                ⟨returnValues, hRunBody⟩
              refine ⟨targetFuel + 1, returnValues, bodyCompiler,
                hRunBody, ?_⟩
              simpa [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.revive] using
                (SourceStateRel.ok hShared hVars)

/--
Regular expression-statement user-call continuation from an imported
`execCall` and a recursive body-soundness callback.

This is the expression-statement/no-target specialization of the eventual
recursive user-call case.  It performs the deterministic backend bookkeeping:

* decompose the imported user `execCall`;
* align the selected Nethermind function with the compiled source function;
* derive source parameter binding from call arity;
* initialize the source callee frame exactly;
* turn recursive body soundness into a source `runBody`;
* restore the caller locals while preserving the callee returned shared state.

The remaining callback premises are precisely the facts supplied by the
recursive constructor for the selected callee body and by its local
source-result filter/domain invariants.
-/
theorem sourceNoTargetUserCall_regular_of_execCall_bodySound
    {cfg : StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {yulProgram : Program} {program : Functions.Program}
    {ctx : Functions.Source.Ctx} {layout : List Name}
    {sourceFuel : Nat} {functionName : Name} {args : List AstExpr}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {argValues : List Word}
    {sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {storeArgs storeAfter : EvmYul.Yul.VarStore}
    (hToObjects :
      yulProgram.toObjects? =
        some { root := Objects.Object.mk "root" program [] [] })
    (hNoShadowing : Safe.NoShadowing.program yulProgram)
    (hStmtOk :
      UserCallArity.StmtOk yulProgram.contract
        (.ExprStmtCall (.Call (.inr functionName) args)))
    (hLowerArgsLength : lowerArgs.length = args.length)
    (hCallerArgs :
      SourceStateRel cfg layout (.Ok sharedArgs storeArgs)
        compilerAfterArgs)
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hExecCall :
      EvmYul.Yul.execCall sourceFuel functionName []
          (some yulProgram.contract)
          (.ok (.Ok sharedArgs storeArgs, argValues)) =
        .ok (.Ok sharedAfter storeAfter))
    (hBodySound :
      ∀ {lowerFn : Functions.FunDef}
        {params returns : List EvmYul.Identifier} {body : List AstStmt}
        {freshBefore freshAfter : Fresh.State} {bodyFuel : Nat},
        yulProgram.contract.functions.lookup functionName =
          some (.Def params returns body) →
        Functions.Source.FunList.find? functionName program.functions =
          some lowerFn →
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) →
        lowerFn.params = identNames params →
        lowerFn.returns = identNames returns →
        SourceResultBlockSoundWhenAtExact cfg
          (lowerFn.returns ++ lowerFn.params)
          (lowerFn.returns ++ lowerFn.params) terminalRel revertRel prim
          program (Functions.Source.FunDef.bodyCtx lowerFn) bodyFuel body
          (some yulProgram.contract) lowerFn.body
          (SourceResultCheckpointAllowed false false true))
    (hBodyAllowed :
      ∀ {params returns : List EvmYul.Identifier} {body : List AstStmt}
        {bodyFuel : Nat} {bodyState : State},
        yulProgram.contract.functions.lookup functionName =
          some (.Def params returns body) →
        EvmYul.Yul.exec bodyFuel (.Block body) (some yulProgram.contract)
            (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
              params returns argValues) =
          .ok bodyState →
        SourceResultCheckpointAllowed false false true (.ok bodyState))
    (hBodyDomain :
      ∀ {params returns : List EvmYul.Identifier} {body : List AstStmt}
        {bodyFuel : Nat} {bodyState : State},
        yulProgram.contract.functions.lookup functionName =
          some (.Def params returns body) →
        EvmYul.Yul.exec bodyFuel (.Block body) (some yulProgram.contract)
            (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
              params returns argValues) =
          .ok bodyState →
        StateStoreDomainExact (identNames returns ++ identNames params)
          bodyState) :
    ∃ compilerAfterCall : Objects.Source.State,
    ∃ ctxAfterCall : Functions.Source.Ctx,
    ∃ callFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx callFuel
          { stmts := [Functions.Stmt.call [] functionName lowerArgs] }
          compilerAfterPre =
        .ok
          (Functions.Source.Outcome.regular compilerAfterCall,
            ctxAfterCall) ∧
      SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfterCall := by
  rcases
      execCall_user_ok_contract_body_exists
        (callFuel := sourceFuel) (shared := sharedArgs)
        (store := storeArgs) (args := argValues)
        (functionName := functionName) (targets := [])
        (contract := yulProgram.contract)
        (stateAfter := .Ok sharedAfter storeAfter) hExecCall with
    ⟨bodyFuel, _yulAccount, fnAst, bodyState, _hFuelEq, _hFindAccount,
      hLookupFn, hBodyExec, hFinal⟩
  cases fnAst with
  | Def params returns body =>
      have hLookup :
          yulProgram.contract.functions.lookup functionName =
            some (.Def params returns body) := hLookupFn
      have hBodyExecBlock :
          EvmYul.Yul.exec bodyFuel (.Block body) (some yulProgram.contract)
              (👌 (EvmYul.Yul.State.Ok sharedArgs storeArgs).initcall
                params returns argValues) =
            .ok bodyState := by
        simpa using hBodyExec
      rcases
          FunctionEntryList.toObjects?_find?_of_contract_lookup_toBlock?
            (program := yulProgram) (functionProgram := program)
            (functionName := functionName)
            (fn := .Def params returns body) hToObjects hLookup with
        ⟨lowerFn, hFindLower, params0, returns0, body0, freshBefore,
          freshAfter, hFnEq, hBodyLower, hLowerName, hLowerParams,
          hLowerReturns⟩
      cases hFnEq
      have hReturnsNilAst : returns = [] :=
        UserCallArity.exprStmt_user_lookup_returns_nil hStmtOk hLookup
      have hReturnsNilLower : lowerFn.returns = [] := by
        simpa [hLowerReturns, hReturnsNilAst, identNames]
      have hArgsLengthAst : args.length = params.length :=
        UserCallArity.exprStmt_user_lookup_args_length hStmtOk hLookup
