/--
Canonical response relation for finite open traces.

Generated-prelude and internal-function bind layers pull this relation back
through their continuations internally. At an outer proof boundary it depends
only on the opaque response certificate, not on compiler-generated
continuation shape.
-/
abbrev RelationallyAdmissibleOpenCallResponseRel
    {SourceResult TargetResult : Type _}
    (cfg : StateRelConfig) :
    OpenExternal.OpenCall SourceResult →
      OpenExternal.OpenCall TargetResult →
        OpenExternal.CallResponse → Prop :=
  fun _sourceCall _targetCall response =>
    RelationallyAdmissibleOpenResponse cfg response

abbrev RelationallyAdmissibleOpenCreateResponseRel
    {SourceResult TargetResult : Type _}
    (cfg : StateRelConfig) :
    OpenExternal.OpenCreate SourceResult →
      OpenExternal.OpenCreate TargetResult →
        OpenExternal.CreateResponse → Prop :=
  fun _sourceCreate _targetCreate response =>
    RelationallyAdmissibleOpenCreateResponse cfg response

/--
Every opaque response selected by one finite trace preserves the configured
Yul/compiler shared-state relation.
-/
abbrev SourceOpenTraceResponsesAdmissible
    (cfg : StateRelConfig) (trace : OpenExternal.OpenTrace) : Prop :=
  OpenExternal.OpenTrace.ResponsesSatisfy
    (RelationallyAdmissibleOpenResponse cfg) trace

abbrev SourceOpenTraceCreateResponsesAdmissible
    (cfg : StateRelConfig) (trace : OpenExternal.OpenTrace) : Prop :=
  OpenExternal.OpenTrace.CreateResponsesSatisfy
    (RelationallyAdmissibleOpenCreateResponse cfg)
    trace

def SourceOpenTraceBoundaryResponsePredicate
    (cfg : StateRelConfig) : OpenExternal.BoundaryResponsePredicate :=
  OpenExternal.BoundaryResponsePredicate.both
    (RelationallyAdmissibleOpenResponse cfg)
    (RelationallyAdmissibleOpenCreateResponse cfg)

abbrev SourceOpenTraceExternalResponsesAdmissible
    (cfg : StateRelConfig) (trace : OpenExternal.OpenTrace) : Prop :=
  OpenExternal.OpenTrace.BoundaryResponsesSatisfy
    (SourceOpenTraceBoundaryResponsePredicate cfg) trace

theorem SourceOpenTraceExternalResponsesAdmissible.to_call
    {cfg : StateRelConfig} {trace : OpenExternal.OpenTrace}
    (hResponses : SourceOpenTraceExternalResponsesAdmissible cfg trace) :
    SourceOpenTraceResponsesAdmissible cfg trace := by
  simpa [SourceOpenTraceBoundaryResponsePredicate,
    SourceOpenTraceResponsesAdmissible] using
    OpenExternal.OpenTrace.BoundaryResponsesSatisfy.to_responsesSatisfy
      hResponses

theorem SourceOpenTraceExternalResponsesAdmissible.to_create
    {cfg : StateRelConfig} {trace : OpenExternal.OpenTrace}
    (hResponses : SourceOpenTraceExternalResponsesAdmissible cfg trace) :
    SourceOpenTraceCreateResponsesAdmissible cfg trace := by
  simpa [SourceOpenTraceBoundaryResponsePredicate,
    SourceOpenTraceCreateResponsesAdmissible] using
    OpenExternal.OpenTrace.BoundaryResponsesSatisfy.to_createResponsesSatisfy
      hResponses

theorem SourceOpenTraceExternalResponsesAdmissible.of_call_create
    {cfg : StateRelConfig} {trace : OpenExternal.OpenTrace}
    (hCall : SourceOpenTraceResponsesAdmissible cfg trace)
    (hCreate : SourceOpenTraceCreateResponsesAdmissible cfg trace) :
    SourceOpenTraceExternalResponsesAdmissible cfg trace := by
  simpa [SourceOpenTraceBoundaryResponsePredicate,
    SourceOpenTraceExternalResponsesAdmissible,
    SourceOpenTraceResponsesAdmissible,
    SourceOpenTraceCreateResponsesAdmissible] using
    OpenExternal.OpenTrace.BoundaryResponsesSatisfy.of_responsesSatisfy_of_createResponsesSatisfy
      hCall hCreate

theorem SourceOpenTraceExternalResponsesAdmissible.left_of_append
    {cfg : StateRelConfig} {left right : OpenExternal.OpenTrace}
    (hResponses :
      SourceOpenTraceExternalResponsesAdmissible cfg (left ++ right)) :
    SourceOpenTraceExternalResponsesAdmissible cfg left :=
  OpenExternal.OpenTrace.BoundaryResponsesSatisfy.left_of_append hResponses

theorem SourceOpenTraceExternalResponsesAdmissible.right_of_append
    {cfg : StateRelConfig} {left right : OpenExternal.OpenTrace}
    (hResponses :
      SourceOpenTraceExternalResponsesAdmissible cfg (left ++ right)) :
    SourceOpenTraceExternalResponsesAdmissible cfg right :=
  OpenExternal.OpenTrace.BoundaryResponsesSatisfy.right_of_append hResponses

theorem SourceOpenTraceExternalResponsesAdmissible.append
    {cfg : StateRelConfig} {left right : OpenExternal.OpenTrace}
    (hLeft : SourceOpenTraceExternalResponsesAdmissible cfg left)
    (hRight : SourceOpenTraceExternalResponsesAdmissible cfg right) :
    SourceOpenTraceExternalResponsesAdmissible cfg (left ++ right) :=
  OpenExternal.OpenTrace.BoundaryResponsesSatisfy.append hLeft hRight

theorem SourceOpenTraceResponsesAdmissible.event_target_code_stable
    {cfg : StateRelConfig} {trace : OpenExternal.OpenTrace}
    (hResponses : SourceOpenTraceResponsesAdmissible cfg trace)
    {event : OpenExternal.OpenEvent}
    (hMem : event ∈ trace)
    (hNotCreate : event.create? = none)
    {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared compilerShared) :
    (event.response.internalMutation.apply compilerShared.toState).executionEnv.code =
      compilerShared.executionEnv.code :=
  have hResponse :
      RelationallyAdmissibleOpenResponse cfg event.response := by
    simpa [hNotCreate] using hResponses event hMem
  hResponse.targetCodeStable hShared

theorem SourceOpenTraceResponsesAdmissible.event_target_perm_stable
    {cfg : StateRelConfig} {trace : OpenExternal.OpenTrace}
    (hResponses : SourceOpenTraceResponsesAdmissible cfg trace)
    {event : OpenExternal.OpenEvent}
    (hMem : event ∈ trace)
    (hNotCreate : event.create? = none)
    {sourceShared : EvmYul.SharedState .Yul}
    {compilerShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared compilerShared) :
    (event.response.internalMutation.apply compilerShared.toState).executionEnv.perm =
      compilerShared.executionEnv.perm :=
  have hResponse :
      RelationallyAdmissibleOpenResponse cfg event.response := by
    simpa [hNotCreate] using hResponses event hMem
  hResponse.targetPermStable hShared

/--
Source-facing fuel adequacy for one selected internal-function body clock.

The imported Yul interpreter historically represents exhausted body execution
as a successful `State.OutOfFuel`.  This contract says that every admitted
finite open path from an initialized callee frame finishes in the
compiler-relatable result fragment.  It is a fuel/resource premise, not
compiler evidence or an external-world model.
-/
def SourceOpenInternalUserCallBodyFuelAdequateAt
    (cfg : StateRelConfig) (contract : AstContract) (bodyFuel : Nat) : Prop :=
  ∀ {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {source : State} {trace : OpenExternal.OpenTrace}
    {sourceDone : Except Exception State},
    contract.functions.lookup functionName =
      some (.Def params returns body) →
    StateStoreDomainExact (identNames returns ++ identNames params) source →
    OpenExternal.OpenResultResolves
      (OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.execSeq bodyFuel body (some contract) source))
      trace sourceDone →
    SourceOpenTraceResponsesAdmissible cfg trace →
    SourceResultRelatable sourceDone

/--
Source-facing internal-body fuel adequacy for every positive recursive body
clock up to one enclosing sequence predecessor.

The zero body clock is not an adequacy case: `execSeq 0` is an immediate
`OutOfFuel` source error and is discharged at the direct-call boundary before
the selected callee-body proof is invoked.
-/
def SourceOpenInternalUserCallBodyFuelAdequateUpTo
    (cfg : StateRelConfig) (contract : AstContract) (bound : Nat) : Prop :=
  ∀ {bodyFuel : Nat}, 0 < bodyFuel → bodyFuel ≤ bound →
    SourceOpenInternalUserCallBodyFuelAdequateAt cfg contract bodyFuel

namespace SourceOpenInternalUserCallBodyFuelAdequateAt

theorem of_no_lookup
    {cfg : StateRelConfig} {contract : AstContract} {bodyFuel : Nat}
    (hNoLookup :
      ∀ {functionName : Name}
        {params returns : List EvmYul.Identifier} {body : List AstStmt},
        contract.functions.lookup functionName =
          some (.Def params returns body) →
        False) :
    SourceOpenInternalUserCallBodyFuelAdequateAt cfg contract bodyFuel := by
  intro functionName params returns body source trace sourceDone hLookup
    _hDomain _hResolve _hResponses
  exact False.elim (hNoLookup hLookup)

end SourceOpenInternalUserCallBodyFuelAdequateAt

namespace SourceOpenInternalUserCallBodyFuelAdequateUpTo

theorem zero_bound
    {cfg : StateRelConfig} {contract : AstContract} :
    SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract 0 := by
  intro bodyFuel hPositive hFuel
  omega

theorem of_no_lookup
    {cfg : StateRelConfig} {contract : AstContract} {bound : Nat}
    (hNoLookup :
      ∀ {functionName : Name}
        {params returns : List EvmYul.Identifier} {body : List AstStmt},
        contract.functions.lookup functionName =
          some (.Def params returns body) →
        False) :
    SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract bound := by
  intro bodyFuel _hPositive _hFuel
  exact SourceOpenInternalUserCallBodyFuelAdequateAt.of_no_lookup hNoLookup

theorem of_lookup_none
    {cfg : StateRelConfig} {contract : AstContract} {bound : Nat}
    (hLookupNone :
      ∀ functionName : Name, contract.functions.lookup functionName = none) :
    SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract bound :=
  of_no_lookup
    (cfg := cfg) (contract := contract) (bound := bound)
    (fun {functionName} {_params} {_returns} {_body} hLookup =>
      by
        rw [hLookupNone functionName] at hLookup
        cases hLookup)

theorem of_le
    {cfg : StateRelConfig} {contract : AstContract}
    {bound bodyFuel : Nat}
    (hAdequate :
      SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract bound)
    (hPositive : 0 < bodyFuel)
    (hFuel : bodyFuel ≤ bound) :
    SourceOpenInternalUserCallBodyFuelAdequateAt cfg contract bodyFuel :=
  hAdequate hPositive hFuel

theorem mono
    {cfg : StateRelConfig} {contract : AstContract}
    {bound bound' : Nat}
    (hAdequate :
      SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract bound)
    (hBound : bound' ≤ bound) :
    SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract bound' := by
  intro bodyFuel hPositive hFuel
  exact hAdequate hPositive (Nat.le_trans hFuel hBound)

theorem zero_false_of_lookup_domain
    {cfg : StateRelConfig} {contract : AstContract}
    {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {source : State}
    (hAdequate :
      SourceOpenInternalUserCallBodyFuelAdequateAt cfg contract 0)
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns body))
    (hDomain :
      StateStoreDomainExact (identNames returns ++ identNames params)
        source) :
    False := by
  have hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.execSeq 0 body (some contract) source))
        [] (.error (.OutOfFuel : Exception)) := by
    rw [OpenExternal.YulOpen.execSeq]
    change
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpenResult.error (.OutOfFuel : Exception)))
        [] (.error (.OutOfFuel : Exception))
    rw [OpenExternal.YulOpenResult.error]
    rw [OpenExternal.YulOpenResult.toOpenResult_done]
    exact OpenExternal.OpenResultResolves.done
  have hResponses : SourceOpenTraceResponsesAdmissible cfg [] := by
    intro event hMem
    cases hMem
  have hRelatable :
      SourceResultRelatable (.error (.OutOfFuel : Exception)) :=
    hAdequate hLookup hDomain hResolve hResponses
  simpa [SourceResultRelatable] using hRelatable

theorem one_false_of_lookup_block_nil_domain
    {cfg : StateRelConfig} {contract : AstContract}
    {functionName : Name}
    {params returns : List EvmYul.Identifier} {source : State}
    (hAdequate :
      SourceOpenInternalUserCallBodyFuelAdequateAt cfg contract 1)
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns [.Block []]))
    (hDomain :
      StateStoreDomainExact (identNames returns ++ identNames params)
        source) :
    False := by
  have hResolve :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.execSeq 1 [.Block []] (some contract)
            source))
        [] (.error (.OutOfFuel : Exception)) := by
    simpa [OpenExternal.YulOpen.execSeq, OpenExternal.YulOpen.exec,
      OpenExternal.YulOpenResult.error,
      OpenExternal.YulOpenResult.toOpenResult_done] using
      (OpenExternal.OpenResultResolves.done
        (result := (.error (.OutOfFuel : Exception))))
  have hResponses : SourceOpenTraceResponsesAdmissible cfg [] := by
    intro event hMem
    cases hMem
  have hRelatable :
      SourceResultRelatable (.error (.OutOfFuel : Exception)) :=
    hAdequate hLookup hDomain hResolve hResponses
  simpa [SourceResultRelatable] using hRelatable

theorem one_false_of_lookup_block_nil_domain_upTo
    {cfg : StateRelConfig} {contract : AstContract}
    {bound : Nat} {functionName : Name}
    {params returns : List EvmYul.Identifier} {source : State}
    (hAdequate :
      SourceOpenInternalUserCallBodyFuelAdequateUpTo cfg contract bound)
    (hFuel : 1 ≤ bound)
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns [.Block []]))
    (hDomain :
      StateStoreDomainExact (identNames returns ++ identNames params)
        source) :
    False :=
  one_false_of_lookup_block_nil_domain
    (cfg := cfg) (contract := contract) (functionName := functionName)
    (params := params) (returns := returns) (source := source)
    (hAdequate (by omega) hFuel) hLookup hDomain

end SourceOpenInternalUserCallBodyFuelAdequateUpTo

abbrev SourceExprRawPreludeOpenCallResponseRel : Type :=
  OpenExternal.OpenCall
      (OpenExternal.OpenResult Exception (State × List Word)) →
    OpenExternal.OpenCall SourceExprPreludeOpen.RawResult →
    OpenExternal.CallResponse → Prop

abbrev SourceExprRawPreludeOpenCreateResponseRel : Type :=
  OpenExternal.OpenCreate
      (OpenExternal.OpenResult Exception (State × List Word)) →
    OpenExternal.OpenCreate SourceExprPreludeOpen.RawResult →
    OpenExternal.CreateResponse → Prop

/--
Admit a raw expression-prefix result exactly when it can still contribute to an
enclosing statement path.

Successful prefixes remain available to the enclosing continuation.  Prefix
errors are propagated unchanged by declaration, assignment, and conditional
heads, so they are admitted only when the enclosing statement filter admits the
same error.  In particular, this keeps low-fuel `OutOfFuel` prefixes out of the
public successful-run spine without imposing a static expression reserve.
-/
def SourcePairResultPropagatesErrorTo
    {α : Type _} (allowed : Except Exception α → Prop) :
    Except Exception (State × List Word) → Prop
  | .ok _ => True
  | .error err => allowed (.error err)

/-- Public successful-run filters exclude propagated raw-prefix out-of-fuel. -/
theorem sourcePairResultPropagatesErrorTo_outOfFuel_false
    {allowed : Except Exception State → Prop}
    (hRelatable :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult) :
    SourcePairResultPropagatesErrorTo allowed
        (.error (.OutOfFuel : Exception)) →
      False := by
  intro hAllowed
  exact
    sourceResultRelatable_outOfFuel_false
      (hRelatable (by
        simpa [SourcePairResultPropagatesErrorTo] using hAllowed))

def SourceExprRawPreludeOpenSoundAtExactTarget
    (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) {results : Nat}
    (lower : Locals.Expr results) (targetFuel : Nat)
    (callResponseRel : SourceExprRawPreludeOpenCallResponseRel) : Prop :=
  ∀ {source compiler},
    SourceStateRel cfg layout source compiler →
      StateStoreContains layout source →
      OpenExternal.OpenResultRel callResponseRel
        (SourceExprRawPreludeOpenDoneRel cfg layout terminalRel revertRel)
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues sourceFuel expr codeOverride source))
        (SourceExprPreludeOpen.runRaw prim program ctx targetFuel pre lower
          compiler)

def SourceExprRawPreludeOpenSoundAtExactTargetWithCreate
    (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) {results : Nat}
    (lower : Locals.Expr results) (targetFuel : Nat)
    (callResponseRel : SourceExprRawPreludeOpenCallResponseRel)
    (createResponseRel : SourceExprRawPreludeOpenCreateResponseRel) : Prop :=
  ∀ {source compiler},
    SourceStateRel cfg layout source compiler →
      StateStoreContains layout source →
      OpenExternal.OpenResultRelWithCreate callResponseRel
        (SourceExprRawPreludeOpenDoneRel cfg layout terminalRel revertRel)
        createResponseRel
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.evalValues sourceFuel expr codeOverride source))
        (SourceExprPreludeOpen.runRaw prim program ctx targetFuel pre lower
          compiler)

universe u v w

theorem openResultRel_withCreate_early
    {ε₁ : Type u} {ε₂ : Type v} {α : Type w} {β : Type}
    {callResponseRel :
      OpenExternal.OpenCall (OpenExternal.OpenResult ε₁ α) →
        OpenExternal.OpenCall (OpenExternal.OpenResult ε₂ β) →
          OpenExternal.CallResponse → Prop}
    {createResponseRel :
      OpenExternal.OpenCreate (OpenExternal.OpenResult ε₁ α) →
        OpenExternal.OpenCreate (OpenExternal.OpenResult ε₂ β) →
          OpenExternal.CreateResponse → Prop}
    {doneRel : Except ε₁ α → Except ε₂ β → Prop}
    {source : OpenExternal.OpenResult ε₁ α}
    {target : OpenExternal.OpenResult ε₂ β}
    (hRel :
      OpenExternal.OpenResultRel callResponseRel doneRel source target) :
    OpenExternal.OpenResultRelWithCreate callResponseRel doneRel
      createResponseRel source target := by
  induction hRel with
  | done hDone =>
      exact OpenExternal.OpenResultRelWithCreate.done hDone
  | call hSite _hResume ih =>
      exact OpenExternal.OpenResultRelWithCreate.call hSite (by
        intro response hResponse
        exact ih response hResponse)
  | create hSite _hResume ih =>
      exact OpenExternal.OpenResultRelWithCreate.create hSite (by
        intro response _hResponse
        exact ih response trivial)

theorem SourceExprRawPreludeOpenSoundAtExactTarget.withCreate
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
