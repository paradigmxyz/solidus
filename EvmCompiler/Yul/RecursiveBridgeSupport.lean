    FreshCoversLayout layout freshState →
    Stmt.toFunctionsList? freshState sourceStmt =
      some (lowerStmts, freshState') →
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel [sourceStmt] codeOverride
      { stmts := lowerStmts } allowed

