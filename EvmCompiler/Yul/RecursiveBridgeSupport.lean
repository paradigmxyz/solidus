/--
If every requested name is retained by a source-level scope cleanup, a
successful `lookupMany` on the restricted store can be replayed on the original
store.

This is the source-store half of connecting scoped function-body results back to
`FunDef.runBody`, whose return-variable extraction reads the pre-cleanup open
block state.
-/
theorem sourceStore_lookupMany_of_restrictTo_of_mem
    {names scope : List Name} {store : Locals.Source.Store}
    {values : List Word}
    (hLookup :
      Functions.Source.Store.lookupMany names
          (Locals.Source.Store.restrictTo scope store) =
        some values)
    (hMem : ∀ name, name ∈ names → name ∈ scope) :
    Functions.Source.Store.lookupMany names store = some values := by
  induction names generalizing values with
  | nil =>
      simpa [Functions.Source.Store.lookupMany] using hLookup
  | cons name rest ih =>
      unfold Functions.Source.Store.lookupMany at hLookup ⊢
      have hNameMem : name ∈ scope := hMem name (by simp)
      rw [Locals.Source.Store.restrictTo_mem hNameMem] at hLookup
      cases hHead : store name with
      | none =>
          simp [hHead] at hLookup
      | some value =>
          simp [hHead] at hLookup ⊢
          cases hTail :
              Functions.Source.Store.lookupMany rest
                (Locals.Source.Store.restrictTo scope store) with
          | none =>
              simp [hTail] at hLookup
          | some tailValues =>
              simp [hTail] at hLookup
              rcases hLookup with rfl
              have hRestMem :
                  ∀ other, other ∈ rest → other ∈ scope := by
                intro other hOther
                exact hMem other (by simp [hOther])
              have hTailOrig :
                  Functions.Source.Store.lookupMany rest store =
                    some tailValues :=
                ih hTail hRestMem
              simp [hTailOrig]

/--
Regular scoped function-body runs still expose return variables in the
underlying open-block state.

`Block.runScoped` drops locals at the end of a regular block, while
`FunDef.runBody` reads return variables from the open-block outcome.  When the
recursive bridge has already related the scoped result with an exact imported
domain, this lemma transports the return lookup back through that cleanup.
-/
theorem sourceRunScoped_regular_open_lookupMany_of_exact
    {cfg : StateRelConfig} {layout returns : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state out : Objects.Source.State}
    (hScope : ctx.scope = layout)
    (hRun :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok (Functions.Source.Outcome.regular out))
    (hRel :
      SourceStateExactRel cfg layout (.Ok shared store) out)
    (hReturns : ∀ name, name ∈ returns → name ∈ layout) :
    ∃ inner : Objects.Source.State, ∃ finalCtx : Functions.Source.Ctx,
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.regular inner, finalCtx) ∧
      Functions.Source.Store.lookupMany returns inner.vars =
        some
          (returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
  rcases
      Functions.Source.Block.runScoped_regular_eq_restrict hRun with
    ⟨inner, finalCtx, hOpen, hOut⟩
  have hLookupScoped :
      Functions.Source.Store.lookupMany returns out.vars =
        some
          (returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) :=
    sourceStateExactRel_lookupMany_of_domain
      (cfg := cfg) (layout := layout) (returns := returns)
      (shared := shared) (store := store) (source := out) hRel hReturns
  have hLookupRestricted :
      Functions.Source.Store.lookupMany returns
          (Locals.Source.Store.restrictTo layout inner.vars) =
        some
          (returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
    simpa [hOut, hScope, Locals.Source.State.restrictTo]
      using hLookupScoped
  refine ⟨inner, finalCtx, hOpen, ?_⟩
  exact
    sourceStore_lookupMany_of_restrictTo_of_mem hLookupRestricted hReturns

/--
Regular function-body adapter from the recursive scoped-block boundary to the
source function-call interpreter.

The recursive Yul bridge proves function bodies as scoped blocks.  A regular
source function return, however, is computed by `FunDef.runBody` from the
underlying open-block state.  This theorem packages the exact regular case of
that conversion.
-/
theorem sourceFunDef_runBody_returned_of_runScoped_regular_exact
    {cfg : StateRelConfig}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {fn : Functions.FunDef}
    {args : List Word} {paramStore : Locals.Source.Store}
    {shared0 : EvmYul.SharedState .EVM}
    {out : Objects.Source.State} {fuel : Nat}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    (hInsert :
      Functions.Source.Store.insertMany fn.params args
          Locals.Source.Store.empty =
        some paramStore)
    (hRunScoped :
      Functions.Source.Block.runScoped prim program
          (Functions.Source.FunDef.bodyCtx fn) fn.body fuel
          { shared := shared0,
            vars := Functions.Source.Store.initReturns fn.returns paramStore } =
        .ok (Functions.Source.Outcome.regular out))
    (hRel :
      SourceStateExactRel cfg (fn.returns ++ fn.params)
        (.Ok shared store) out) :
    ∃ returnValues : List Word,
      Functions.Source.FunDef.runBody prim program fn args (fuel + 1)
          shared0 =
        .ok
          (Functions.Source.CallResult.returned out.shared returnValues) := by
  rcases
      Functions.Source.Block.runScoped_regular_eq_restrict hRunScoped with
    ⟨inner, finalCtx, hOpen, hOut⟩
  have hReturnsMem :
      ∀ name, name ∈ fn.returns → name ∈ fn.returns ++ fn.params := by
    intro name hMem
    exact List.mem_append_left _ hMem
  have hLookupScoped :
      Functions.Source.Store.lookupMany fn.returns out.vars =
        some
          (fn.returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) :=
    sourceStateExactRel_lookupMany_of_domain
      (cfg := cfg) (layout := fn.returns ++ fn.params)
      (returns := fn.returns) (shared := shared) (store := store)
      (source := out) hRel hReturnsMem
  have hLookupRestricted :
      Functions.Source.Store.lookupMany fn.returns
          (Locals.Source.Store.restrictTo (fn.returns ++ fn.params)
            inner.vars) =
        some
          (fn.returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
    simpa [hOut, Functions.Source.FunDef.bodyCtx,
      Locals.Source.State.restrictTo] using hLookupScoped
  have hLookupOpen :
      Functions.Source.Store.lookupMany fn.returns inner.vars =
        some
          (fn.returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) :=
    sourceStore_lookupMany_of_restrictTo_of_mem hLookupRestricted hReturnsMem
  have hOpenExplicit :
      Functions.Source.Block.runOpen prim program
          { Functions.Source.Ctx.initial.withLeaveScope
              (fn.returns ++ fn.params) with
            scope := fn.returns ++ fn.params }
          fuel fn.body
          { shared := shared0,
            vars := Functions.Source.Store.initReturns fn.returns
              paramStore } =
        .ok (Functions.Source.Outcome.regular inner, finalCtx) := by
    simpa [Functions.Source.FunDef.bodyCtx] using hOpen
  have hShared : inner.shared = out.shared := by
    simpa [hOut, Locals.Source.State.restrictTo]
  refine
    ⟨fn.returns.map fun name =>
        EvmYul.Yul.State.lookup! name (.Ok shared store), ?_⟩
  unfold Functions.Source.FunDef.runBody
  simp [hInsert, hOpenExplicit, hLookupOpen, hShared,
    Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]

