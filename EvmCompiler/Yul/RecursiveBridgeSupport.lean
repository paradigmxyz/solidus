theorem compileCheckedAssemblyTarget?_eq_some
    {program : Program} {asm : Assembly.Program}
    {target : Assembly.TargetProgram}
    (hCompileTarget :
      compileCheckedAssemblyTarget? program = some (asm, target)) :
    compileChecked? program = some asm ∧ Assembly.compile? asm = some target := by
  unfold compileCheckedAssemblyTarget? at hCompileTarget
  cases hCompile : compileChecked? program with
  | none =>
      simp [hCompile] at hCompileTarget
  | some asm' =>
      simp [hCompile] at hCompileTarget
      cases hAssemble : Assembly.compile? asm' with
      | none =>
          simp [hAssemble] at hCompileTarget
      | some target' =>
          simp [hAssemble] at hCompileTarget
          rcases hCompileTarget with ⟨rfl, rfl⟩
          exact ⟨by simpa [hCompile], hAssemble⟩

