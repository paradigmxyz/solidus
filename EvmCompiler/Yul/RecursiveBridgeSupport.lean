      (.ExprStmtCall (.Call (.inl yulPrim) args) :: rest)
      codeOverride (.Ok shared store) compiler
      { stmts := pre ++ [Functions.Stmt.expr lowerExpr] ++
          lowerTail.stmts } := by
  have hSourceHead :
      EvmYul.Yul.exec sourceFuel.succ
          (.ExprStmtCall (.Call (.inl yulPrim) args)) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter) := by
    rw [Imported.exec_expr_prim_call_succ]
    unfold EvmYul.Yul.execPrimCall
    cases hArgsEval :
        EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
            (.Ok shared store)) with
    | error err =>
        simp [EvmYul.Yul.evalValues, hArgsEval] at hEval
    | ok argResult =>
        rcases argResult with ⟨sourceAfterArgs, argValues⟩
        simp [EvmYul.Yul.evalValues, hArgsEval] at hEval
        simp [hEval, EvmYul.Yul.multifill',
          EvmYul.Yul.State.multifill]
  rcases hExpr hRel hEval with
    ⟨compilerAfterPre, compilerAfterExpr, ctxAfterPre, preFuel,
      hPreRun, hCompilerExpr, hRelAfterExpr⟩
  rcases hTail hPreRun hCompilerExpr hRelAfterExpr with
    ⟨sourceAfter, compilerAfter, ctxAfter, tailFuel, hSourceTail,
      hCompilerTail, hSubset, hTailRel⟩
  have hExprTail :
      Functions.Source.Block.runOpen prim program ctxAfterPre tailFuel.succ
        { stmts := [Functions.Stmt.expr lowerExpr] ++
            lowerTail.stmts } compilerAfterPre =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) := by
    cases lowerTail with
    | mk tailStmts =>
        simpa [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
          hCompilerExpr, Functions.Source.Outcome.regular] using
          hCompilerTail
  rcases
      Functions.Source.Block.runOpen_append_regular_exists prim program
        pre ([Functions.Stmt.expr lowerExpr] ++ lowerTail.stmts)
        ctx ctxAfterPre compiler compilerAfterPre
        (Functions.Source.Outcome.regular compilerAfter) ctxAfter
        ⟨preFuel, hPreRun⟩ ⟨tailFuel.succ, hExprTail⟩ with
    ⟨targetFuel, hCompiler⟩
  refine
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, ?_, ?_, hSubset,
      hTailRel⟩
  · exact Imported.execSeq_cons_ok_succ hSourceHead hSourceTail
  · simpa [List.append_assoc] using hCompiler

theorem sourceFunList_find?_eq_direct
    (functionName : Name) :
    ∀ functions : List Functions.FunDef,
      Functions.Source.FunList.find? functionName functions =
        Functions.FunList.find? functionName functions
  | [] => rfl
  | fn :: rest => by
      by_cases hEq : fn.name = functionName
      · simp [Functions.Source.FunList.find?, Functions.FunList.find?, hEq]
      · simp [Functions.Source.FunList.find?, Functions.FunList.find?, hEq,
          sourceFunList_find?_eq_direct functionName rest]

/--
Source-side singleton user-call reconstruction from an already-checked
`FunDef.runBody`.

This is the narrow interface the recursive call proof wants after it has used
the smaller-fuel body theorem: the statement-level source semantics only needs
argument evaluation, source function lookup, function-body return, and
caller-target assignment.
-/
theorem sourceCallSingletonRunOpen_regular_of_runBody
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {targets : List Name} {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs compilerAfterCall :
      Objects.Source.State}
    {argValues returnValues : List Word} {fn : Functions.FunDef}
    {bodyFuel : Nat}
    (hTargets : targets.Nodup)
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hFind :
      Functions.Source.FunList.find? functionName program.functions =
        some fn)
    (hRunBody :
      Functions.Source.FunDef.runBody prim program fn argValues bodyFuel
          compilerAfterArgs.shared =
        .ok
          (Functions.Source.CallResult.returned
            compilerAfterCall.shared returnValues))
    (hAssign :
      Functions.Source.Store.assignMany targets returnValues
        compilerAfterArgs.vars = some compilerAfterCall.vars) :
    Functions.Source.Block.runOpen prim program ctx (bodyFuel + 2)
        { stmts := [Functions.Stmt.call targets functionName lowerArgs] }
        compilerAfterPre =
      .ok
        (Functions.Source.Outcome.regular compilerAfterCall, ctx) := by
  have hFindDirect :
      Functions.FunList.find? functionName program.functions = some fn := by
    simpa [sourceFunList_find?_eq_direct functionName program.functions]
      using hFind
  have hStmtRun :
      Functions.Source.Stmt.run prim program ctx (bodyFuel + 1)
          (.call targets functionName lowerArgs) compilerAfterPre =
        .ok
          (Functions.Source.Outcome.regular compilerAfterCall, ctx) := by
    unfold Functions.Source.Stmt.run
    simp [hTargets, hArgsRun, hFindDirect, hRunBody, hAssign]
  simp [Functions.Source.Block.runOpen, hStmtRun,
    Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]

/--
Source-side singleton user-call reconstruction for terminal callee exits.

The target list is still checked for source-call wellformedness, but once the
callee body halts there is no caller-side return assignment.
-/
theorem sourceCallSingletonRunOpen_halted_of_runBody
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {targets : List Name} {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs compilerAfterCall :
      Objects.Source.State}
    {argValues : List Word} {fn : Functions.FunDef}
    {bodyFuel : Nat} {kind : Assembly.HaltKind}
    (hTargets : targets.Nodup)
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hFind :
      Functions.Source.FunList.find? functionName program.functions =
        some fn)
    (hRunBody :
      Functions.Source.FunDef.runBody prim program fn argValues bodyFuel
          compilerAfterArgs.shared =
        .ok
          (Functions.Source.CallResult.halted kind compilerAfterCall)) :
    Functions.Source.Block.runOpen prim program ctx (bodyFuel + 2)
        { stmts := [Functions.Stmt.call targets functionName lowerArgs] }
        compilerAfterPre =
      .ok
        (Functions.Source.Outcome.halt kind compilerAfterCall, ctx) := by
  have hFindDirect :
      Functions.FunList.find? functionName program.functions = some fn := by
    simpa [sourceFunList_find?_eq_direct functionName program.functions]
      using hFind
  have hStmtRun :
      Functions.Source.Stmt.run prim program ctx (bodyFuel + 1)
          (.call targets functionName lowerArgs) compilerAfterPre =
        .ok
          (Functions.Source.Outcome.halt kind compilerAfterCall, ctx) := by
    unfold Functions.Source.Stmt.run
    simp [hTargets, hArgsRun, hFindDirect, hRunBody]
  simp [Functions.Source.Block.runOpen, hStmtRun,
    Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]

/--
Source-side no-target user-call reconstruction for zero-return functions.

Imported Yul's raw `multifill []` discards return values, but the source tower
models expression-statement user calls as calls with no assignment targets.
That source statement is regular exactly for callees whose source return list is
empty.  The later Yul arity/typing acceptance condition should discharge
`hReturnsNil`; this lemma keeps the semantic boundary explicit.
-/
theorem sourceCallNoTargetsSingletonRunOpen_regular_of_runBody_nil_returns
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {argValues returnValues : List Word} {fn : Functions.FunDef}
    {bodyFuel : Nat}
    (hReturnsNil : fn.returns = [])
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hFind :
      Functions.Source.FunList.find? functionName program.functions =
        some fn)
    (hRunBody :
      Functions.Source.FunDef.runBody prim program fn argValues bodyFuel
          compilerAfterArgs.shared =
        .ok
          (Functions.Source.CallResult.returned
            compilerAfterArgs.shared returnValues)) :
    Functions.Source.Block.runOpen prim program ctx (bodyFuel + 2)
        { stmts := [Functions.Stmt.call [] functionName lowerArgs] }
        compilerAfterPre =
      .ok
        (Functions.Source.Outcome.regular compilerAfterArgs, ctx) := by
  have hLen :
      returnValues.length = 0 := by
    have hRunLen :=
      Functions.Source.FunDef.runBody_returned_length hRunBody
    simpa [hReturnsNil] using hRunLen
  have hReturnValuesNil : returnValues = [] :=
    List.eq_nil_of_length_eq_zero hLen
  have hAssignNil :
      Functions.Source.Store.assignMany [] []
        compilerAfterArgs.vars = some compilerAfterArgs.vars := by
    simp [Functions.Source.Store.assignMany]
  exact
    sourceCallSingletonRunOpen_regular_of_runBody
      (prim := prim) (program := program) (ctx := ctx)
      (targets := []) (functionName := functionName)
      (lowerArgs := lowerArgs) (compilerAfterPre := compilerAfterPre)
      (compilerAfterArgs := compilerAfterArgs)
      (compilerAfterCall := compilerAfterArgs) (argValues := argValues)
      (returnValues := []) (fn := fn) (bodyFuel := bodyFuel)
      (by simp) hArgsRun hFind (by simpa [hReturnValuesNil] using hRunBody)
      hAssignNil

/--
Source-side singleton no-target user-call reconstruction that preserves the
callee's returned shared state.

For expression-statement user calls, returned values are discarded only when
the selected function has no returns.  The caller locals are restored unchanged,
but the shared state must be the callee's returned shared state, since internal
Yul functions may perform EVM-facing effects before returning.
-/
theorem sourceCallNoTargetsSingletonRunOpen_regular_of_runBody_nil_returns_shared
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {argValues returnValues : List Word} {fn : Functions.FunDef}
    {bodyFuel : Nat} {sharedAfterCall : EvmYul.SharedState .EVM}
    (hReturnsNil : fn.returns = [])
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hFind :
      Functions.Source.FunList.find? functionName program.functions =
        some fn)
    (hRunBody :
      Functions.Source.FunDef.runBody prim program fn argValues bodyFuel
          compilerAfterArgs.shared =
        .ok
          (Functions.Source.CallResult.returned sharedAfterCall
            returnValues)) :
    Functions.Source.Block.runOpen prim program ctx (bodyFuel + 2)
        { stmts := [Functions.Stmt.call [] functionName lowerArgs] }
        compilerAfterPre =
      .ok
        (Functions.Source.Outcome.regular
          { shared := sharedAfterCall, vars := compilerAfterArgs.vars },
          ctx) := by
  have hLen :
      returnValues.length = 0 := by
    have hRunLen :=
      Functions.Source.FunDef.runBody_returned_length hRunBody
    simpa [hReturnsNil] using hRunLen
  have hReturnValuesNil : returnValues = [] :=
    List.eq_nil_of_length_eq_zero hLen
  have hAssignNil :
      Functions.Source.Store.assignMany [] []
        compilerAfterArgs.vars = some compilerAfterArgs.vars := by
    simp [Functions.Source.Store.assignMany]
  exact
    sourceCallSingletonRunOpen_regular_of_runBody
      (prim := prim) (program := program) (ctx := ctx)
      (targets := []) (functionName := functionName)
      (lowerArgs := lowerArgs) (compilerAfterPre := compilerAfterPre)
      (compilerAfterArgs := compilerAfterArgs)
      (compilerAfterCall :=
        { shared := sharedAfterCall, vars := compilerAfterArgs.vars })
      (argValues := argValues)
      (returnValues := []) (fn := fn) (bodyFuel := bodyFuel)
      (by simp) hArgsRun hFind
      (by simpa [hReturnValuesNil] using hRunBody) hAssignNil

/--
Regular no-target user-call continuation from a proved source `runBody` and
the imported Yul caller-restoration step.

This is the reusable core needed by expression-statement user calls: the source
call runs with no target assignment, keeps the caller local store, adopts the
callee's returned shared state, and relates that state to the imported
`execCall` result after Nethermind's `reviveJump`/`overwrite?`/`setStore`
restoration sequence.
-/
theorem sourceNoTargetUserCall_regular_of_runBody_revive
    {cfg : StateRelConfig} {layout bodyLayout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs bodyCompiler : Objects.Source.State}
    {argValues returnValues : List Word} {fn : Functions.FunDef}
    {bodyFuel : Nat}
    {sharedArgs sharedAfter : EvmYul.SharedState .Yul}
    {storeArgs storeAfter : EvmYul.Yul.VarStore}
    {bodyState : State}
    (hCallerArgs :
      SourceStateRel cfg layout (.Ok sharedArgs storeArgs)
        compilerAfterArgs)
    (hBody :
      SourceStateRel cfg bodyLayout
        (EvmYul.Yul.State.reviveJump bodyState) bodyCompiler)
    (hFinal :
      EvmYul.Yul.State.multifill [] returnValues
          (((EvmYul.Yul.State.reviveJump bodyState).overwrite?
            (.Ok sharedArgs storeArgs)).setStore (.Ok sharedArgs storeArgs)) =
        .Ok sharedAfter storeAfter)
    (hReturnsNil : fn.returns = [])
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hFind :
      Functions.Source.FunList.find? functionName program.functions =
        some fn)
    (hRunBody :
      Functions.Source.FunDef.runBody prim program fn argValues bodyFuel
          compilerAfterArgs.shared =
        .ok
          (Functions.Source.CallResult.returned bodyCompiler.shared
            returnValues)) :
    ∃ compilerAfterCall : Objects.Source.State,
    ∃ ctxAfterCall : Functions.Source.Ctx,
    ∃ callFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx callFuel
          { stmts := [Functions.Stmt.call [] functionName lowerArgs] }
          compilerAfterPre =
        .ok
          (Functions.Source.Outcome.regular compilerAfterCall,
            ctxAfterCall) ∧
      SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfterCall := by
  let compilerAfterCall : Objects.Source.State :=
    { shared := bodyCompiler.shared, vars := compilerAfterArgs.vars }
  have hRun :
      Functions.Source.Block.runOpen prim program ctx (bodyFuel + 2)
          { stmts := [Functions.Stmt.call [] functionName lowerArgs] }
          compilerAfterPre =
        .ok
          (Functions.Source.Outcome.regular compilerAfterCall, ctx) := by
    simpa [compilerAfterCall] using
      sourceCallNoTargetsSingletonRunOpen_regular_of_runBody_nil_returns_shared
        (prim := prim) (program := program) (ctx := ctx)
        (functionName := functionName) (lowerArgs := lowerArgs)
        (compilerAfterPre := compilerAfterPre)
        (compilerAfterArgs := compilerAfterArgs)
        (argValues := argValues) (returnValues := returnValues)
        (fn := fn) (bodyFuel := bodyFuel)
        (sharedAfterCall := bodyCompiler.shared)
        hReturnsNil hArgsRun hFind hRunBody
  have hRel :
      SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfterCall := by
    simpa [compilerAfterCall] using
      sourceStateRel_userCall_noTargets_of_revive
        (cfg := cfg) (layout := layout) (bodyLayout := bodyLayout)
        (sharedArgs := sharedArgs) (sharedAfter := sharedAfter)
        (storeArgs := storeArgs) (storeAfter := storeAfter)
        (callerCompiler := compilerAfterArgs)
        (bodyCompiler := bodyCompiler) (bodyState := bodyState)
        (returnValues := returnValues) hCallerArgs hBody hFinal
  exact ⟨compilerAfterCall, ctx, bodyFuel + 2, hRun, hRel⟩

/--
Exact-domain scoped-block soundness.

This is the block-level counterpart of `SourceResultBlockSoundWhenAt` for
proofs that still need the imported varstore domain invariant. It should stay
as a proof-internal bridge: public Yul preservation should eventually discharge
the exact-domain premise from source wellformedness / acceptedness, rather than
ask users to provide it.
-/
def SourceResultBlockSoundWhenAtExact (cfg : StateRelConfig)
    (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat)
    (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) :
    Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler sourceResult},
      SourceStateExactRel cfg layout source compiler →
      allowed sourceResult →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult →
      ∃ sourceOutcome : Objects.Source.Outcome,
      ∃ targetFuel,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compiler =
          .ok sourceOutcome ∧
        SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
          sourceResult sourceOutcome

/--
Exact-domain scoped-block soundness under a hidden compiler context.

This is the same source-facing block contract as
`SourceResultBlockSoundWhenAtExact`, but it deliberately does not require
`ctx.scope = layout`.  It is for generated-prelude frontiers: the compiler
context may remember hidden locals, while the imported Yul state and observable
outcome relation remain scoped to the source-visible `layout`.
-/
def SourceResultBlockSoundWhenAtExactHiddenScope (cfg : StateRelConfig)
    (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat)
    (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) :
    Prop :=
  ∀ {source compiler sourceResult},
    SourceStateExactRel cfg layout source compiler →
    allowed sourceResult →
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      sourceResult →
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ targetFuel,
      Functions.Source.Block.runScoped prim program ctx lowerBlock
          targetFuel compiler =
        .ok sourceOutcome ∧
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        sourceResult sourceOutcome

/--
Ordinary exact block soundness is a hidden-scope block contract.

This is the identity coercion at the generated-control boundary: if the target
context already has exactly the source-visible scope, the stronger ordinary
block theorem can be consumed by APIs that only require the hidden-scope
variant.
-/
theorem SourceResultBlockSoundWhenAtExact.to_hiddenScope
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hBlock :
      SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
        revertRel prim program ctx sourceFuel sourceStmts codeOverride
        lowerBlock allowed) :
    SourceResultBlockSoundWhenAtExactHiddenScope cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel sourceStmts
      codeOverride lowerBlock allowed := by
  intro source compiler sourceResult hInitial hAllow hSource
  exact hBlock.2 hInitial hAllow hSource

/--
Extract a regular successful block run from hidden-scope block soundness.

This is a source-facing adapter used by generated-control frontiers: the body
or post block proof may be supplied as a full result relation, while loop
branch lemmas want the concrete regular run plus exact source relation.
-/
theorem SourceResultBlockSoundWhenAtExactHiddenScope.ok_regular_exact
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {source compiler}
    {sharedAfter : EvmYul.SharedState .Yul}
    {storeAfter : EvmYul.Yul.VarStore}
    (hBlock :
      SourceResultBlockSoundWhenAtExactHiddenScope cfg layout layout
        terminalRel revertRel prim program ctx sourceFuel body codeOverride
        lowerBlock
        (fun result =>
          result = (.ok (.Ok sharedAfter storeAfter) :
            Except Exception State)))
    (hInitial : SourceStateExactRel cfg layout source compiler)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride source =
        .ok (.Ok sharedAfter storeAfter))
    (hDomainAfter : StoreDomainExact layout storeAfter) :
    ∃ compilerAfter : Objects.Source.State,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runScoped prim program ctx lowerBlock
          targetFuel compiler =
        .ok (Functions.Source.Outcome.regular compilerAfter) ∧
      SourceStateExactRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfter := by
  rcases hBlock hInitial rfl hSource with
    ⟨sourceOutcome, targetFuel, hRun, hRel⟩
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hStateRel =>
          exact
            ⟨_, targetFuel, hRun,
              SourceStateExactRel.ofRelDomain hStateRel hDomainAfter⟩

/--
Extract a `break` checkpoint block run from hidden-scope block soundness.
-/
theorem SourceResultBlockSoundWhenAtExactHiddenScope.ok_break
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {source compiler}
    {sharedAfter : EvmYul.SharedState .Yul}
    {storeAfter : EvmYul.Yul.VarStore}
    (hBlock :
      SourceResultBlockSoundWhenAtExactHiddenScope cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel body codeOverride
        lowerBlock
        (fun result =>
          result =
            (.ok (.Checkpoint (.Break sharedAfter storeAfter)) :
              Except Exception State)))
    (hInitial : SourceStateExactRel cfg layout source compiler)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride source =
        .ok (.Checkpoint (.Break sharedAfter storeAfter))) :
    ∃ compilerAfter : Objects.Source.State,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runScoped prim program ctx lowerBlock
          targetFuel compiler =
        .ok (Functions.Source.Outcome.brk compilerAfter) ∧
      SourceStateRel cfg outcomeLayout (.Ok sharedAfter storeAfter)
        compilerAfter := by
  rcases hBlock hInitial rfl hSource with
    ⟨sourceOutcome, targetFuel, hRun, hRel⟩
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hStateRel =>
          cases hStateRel
      | brk hStateRel =>
          exact ⟨_, targetFuel, hRun, hStateRel⟩

theorem SourceResultBlockSoundWhenAtExactHiddenScope.ok_break_project
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {source compiler}
    {sharedAfter : EvmYul.SharedState .Yul}
    {storeAfter : EvmYul.Yul.VarStore}
    (hBlock :
      SourceResultBlockSoundWhenAtExactHiddenScope cfg layout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel body codeOverride
        lowerBlock
        (fun result =>
          result =
            (.ok (.Checkpoint (.Break sharedAfter storeAfter)) :
              Except Exception State)))
    (hInitial : SourceStateExactRel cfg layout source compiler)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.Block body) codeOverride source =
        .ok (.Checkpoint (.Break sharedAfter storeAfter)))
    (hSubset : ∀ name, name ∈ layout → name ∈ outcomeLayout) :
    ∃ compilerAfter : Objects.Source.State,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runScoped prim program ctx lowerBlock
          targetFuel compiler =
        .ok (Functions.Source.Outcome.brk compilerAfter) ∧
      SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
        compilerAfter := by
  rcases
      SourceResultBlockSoundWhenAtExactHiddenScope.ok_break
        (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
        (terminalRel := terminalRel) (revertRel := revertRel)
        (prim := prim) (program := program) (ctx := ctx)
        (sourceFuel := sourceFuel) (body := body)
        (codeOverride := codeOverride) (lowerBlock := lowerBlock)
        (source := source) (compiler := compiler)
        (sharedAfter := sharedAfter) (storeAfter := storeAfter)
        hBlock hInitial hSource with
    ⟨compilerAfter, targetFuel, hRun, hRel⟩
  exact
    ⟨compilerAfter, targetFuel, hRun,
      SourceStateRel.of_layout_subset hRel hSubset⟩

/--
