          (hNoContinue := by
            intro sharedContinue storeContinue hExec
            exact
              exec_for_continue_false_of_scoped_safe hExpr hSafe hScoped
                hExec)
  postRegular := by
    intro shared sharedAfterCond sharedAfterBody sharedAfterPost store
      storeAfterCond storeAfterBody storeAfterPost compiler value
      bodyWasContinue loopResult hExact hEval hNonzero hBody hPost hLoop
      hAllowed
    rcases
        hBranches.postRegular hExact hEval hNonzero hBody hPost hLoop
