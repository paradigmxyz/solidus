theorem RelationallyAdmissibleOpenCreateResponse.evmOpenCreate_resume_code_stable
    {cfg : StateRelConfig} {response : OpenExternal.CreateResponse}
    {sourceShared : EvmYul.SharedState .Yul}
    {target : EvmYul.EVM.State}
    {kind : OpenExternal.CreateKind}
    {create : OpenExternal.OpenCreate EvmYul.EVM.State}
    (hResponse : RelationallyAdmissibleOpenCreateResponse cfg response)
    (hShared :
      Reference.SharedStateRel cfg sourceShared target.toSharedState)
    (hCreate :
      OpenExternal.CreateKind.evmOpenCreate? target kind = some create) :
