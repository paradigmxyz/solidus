theorem exec_if_succ_of_eval_and_body {layout : List Name}
    {fuel : Nat} {cond : AstExpr} {body : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hEval :
      SourcePairResultStoreContains layout
        (EvmYul.Yul.eval fuel cond codeOverride state))
    (hBody :
      ∀ {stateAfter : State} {value : Word},
        EvmYul.Yul.eval fuel cond codeOverride state =
          .ok (stateAfter, value) →
        value ≠ ⟨0⟩ →
        SourceResultStoreContains layout
          (EvmYul.Yul.exec fuel (.Block body) codeOverride stateAfter)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.exec fuel.succ (.If cond body) codeOverride state) := by
  rw [Imported.exec_if_succ]
  cases hEvalResult : EvmYul.Yul.eval fuel cond codeOverride state with
  | error err =>
      simp [hEvalResult, SourceResultStoreContains]
  | ok pair =>
      cases pair with
      | mk stateAfter value =>
          by_cases hNonzero : value ≠ ⟨0⟩
          · simpa [hEvalResult, hNonzero] using
              hBody (stateAfter := stateAfter) (value := value)
                hEvalResult hNonzero
          · have hStateAfter :
                StateStoreContains layout stateAfter :=
              SourcePairResultStoreContains.state_of_ok hEval hEvalResult
            simpa [hEvalResult, hNonzero, SourceResultStoreContains] using
              SourceResultStoreContains.of_state hStateAfter

theorem exec_switch_succ_of_eval_and_case {layout : List Name}
