theorem exprEvalResultOkAt_of_stmtNoUser_if
    {cfg : StateRelConfig} {layout : List Name}
    {contract : AstContract} {fuel : Nat}
    {cond : AstExpr} {body : List AstStmt}
    (hSafe : Safe.expr cond)
