theorem ExprValuePreludeSound.to_evalOne_of_evalValues_single
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceExpr : AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {lowerExpr : Locals.Expr 1}
    (hExpr :
      ExprValuePreludeSound cfg layout prim program ctx sourceFuel sourceExpr
        codeOverride pre lowerExpr)
    (hSingle :
      ∀ {source sourceAfter value},
        EvmYul.Yul.eval sourceFuel sourceExpr codeOverride source =
          .ok (sourceAfter, value) →
        EvmYul.Yul.evalValues sourceFuel sourceExpr codeOverride source =
          .ok (sourceAfter, [value])) :
    ExprEvalPreludeSound cfg layout prim program ctx sourceFuel sourceExpr
      codeOverride pre lowerExpr := by
  intro source compiler sourceAfter value hInitial hEval
