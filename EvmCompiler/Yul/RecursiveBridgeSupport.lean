theorem exprSeq_eval_of_toSeq?_argList_eval
    {prim : Objects.Source.PrimitiveSemantics} :
    ∀ {exprs : List (Locals.Expr 1)} {results : Nat}
      {seq : Locals.ExprSeq results}
      {state stateAfter : Objects.Source.State} {values : List Word},
      Expr.List.toSeq? exprs results = some seq →
      Functions.Source.ArgList.eval prim exprs state =
        .ok (stateAfter, values) →
      Locals.Source.Expr.ExprSeq.eval prim seq state =
        .ok (stateAfter, values)
  | [], results, seq, state, stateAfter, values, hSeq, hEval => by
      cases results with
      | zero =>
          simp [Expr.List.toSeq?] at hSeq
          cases hSeq
          simp [Functions.Source.ArgList.eval] at hEval
          rcases hEval with ⟨hState, hValues⟩
          subst stateAfter
          cases hValues
          rfl
      | succ results =>
          simp [Expr.List.toSeq?] at hSeq
  | head :: tail, results, seq, state, stateAfter, values, hSeq, hEval => by
      cases results with
      | zero =>
          simp [Expr.List.toSeq?] at hSeq
      | succ tailResults =>
          simp [Expr.List.toSeq?] at hSeq
          cases hTailSeq :
              Expr.List.toSeq? tail tailResults with
          | none =>
              simp [hTailSeq] at hSeq
          | some tailSeq =>
              simp [hTailSeq] at hSeq
              cases hSeq
              unfold Functions.Source.ArgList.eval at hEval
              cases hHead :
                  Functions.Source.Expr.evalOne prim head state with
              | error err =>
                  simp [hHead] at hEval
              | ok headResult =>
                  rcases headResult with ⟨stateAfterHead, value⟩
                  simp [hHead] at hEval
                  cases hTail :
                      Functions.Source.ArgList.eval prim tail
                        stateAfterHead with
                  | error err =>
                      simp [hTail] at hEval
                  | ok tailResult =>
                      rcases tailResult with ⟨stateAfterTail, tailValues⟩
                      simp [hTail] at hEval
                      rcases hEval with ⟨hStateAfter, hValues⟩
                      subst stateAfterTail
                      subst values
                      have hHeadEval :
                          Locals.Source.Expr.eval prim head state =
                            .ok (stateAfterHead, [value]) :=
                        Functions.SourceDirect.Expr.eval_of_evalOne hHead
                      have hTailSeqEval :
                          Locals.Source.Expr.ExprSeq.eval prim tailSeq
                              stateAfterHead =
                            .ok (stateAfter, tailValues) :=
                        exprSeq_eval_of_toSeq?_argList_eval hTailSeq hTail
                      rw [exprSeq_eval_seqCast]
                      simp [Locals.Source.Expr.ExprSeq.eval, hHeadEval,
                        hTailSeqEval]

