theorem openResult_bind_congr_next_of_doneInvariant
    {ε α β : Type*}
    {result : OpenExternal.OpenResult ε α}
    {doneInv : Except ε α → Prop}
    {next next' : α → OpenExternal.OpenResult ε β}
    (hInv : OpenResultDoneInvariant doneInv result)
    (hNext :
      ∀ value, doneInv (.ok value) → next value = next' value) :
    OpenExternal.OpenResult.bind result next =
      OpenExternal.OpenResult.bind result next' := by
  induction hInv with
  | done hDone =>
      rename_i doneResult
      cases doneResult with
      | error err =>
          simp
      | ok value =>
          simpa using hNext value hDone
  | call hResume ih =>
      rw [OpenExternal.OpenResult.bind_call, OpenExternal.OpenResult.bind_call]
      congr
      funext response
      exact ih response
  | create hResume ih =>
      rw [OpenExternal.OpenResult.bind_create,
        OpenExternal.OpenResult.bind_create]
      congr
      funext response
      exact ih response

theorem compilerOpen_primitive_eval_doneInvariant_contains
    {prim : Objects.Source.PrimitiveSemantics}
    {op : Structured.BasicOp} {state : Objects.Source.State}
    {values : List Word} {name : Name}
    (hContains : state.vars.contains name = true) :
    OpenResultDoneInvariant
      (fun doneResult =>
        ∀ {stateAfter : Objects.Source.State} {valuesAfter : List Word},
          doneResult = .ok (stateAfter, valuesAfter) →
            stateAfter.vars.contains name = true)
      (CompilerOpen.Primitive.eval prim op state values) := by
  unfold CompilerOpen.Primitive.eval CompilerOpen.Primitive.openCall?
    SourceStateRel.compilerPrimitiveOpenCall?
    CompilerOpen.Primitive.openCreate?
    SourceStateRel.compilerPrimitiveOpenCreate?
  cases hCallKind : OpenExternal.CallKind.ofBasicOp? op with
  | none =>
      cases hCreateKind : OpenExternal.CreateKind.ofBasicOp? op with
      | none =>
          cases hPrim : prim.eval op state.shared values with
          | ok primResult =>
              rcases primResult with ⟨sharedAfter, valuesAfter⟩
              simp [hCallKind, hCreateKind, hPrim,
                Locals.Source.State.withShared]
              exact
                OpenResultDoneInvariant.done (by
                  intro stateAfter valuesAfter' hDone
                  cases hDone
                  exact hContains)
          | error err =>
              simp [hCallKind, hCreateKind, hPrim]
              exact
                OpenResultDoneInvariant.done (by
                  intro stateAfter valuesAfter hDone
                  cases hDone)
      | some createKind =>
          cases hCreate :
              OpenExternal.CreateKind.primitiveSharedOpenCreate?
                state.shared createKind values with
          | none =>
              cases hPrim : prim.eval op state.shared values with
              | ok primResult =>
                  rcases primResult with ⟨sharedAfter, valuesAfter⟩
                  simp [hCallKind, hCreateKind, hCreate, hPrim,
                    Locals.Source.State.withShared]
                  exact
                    OpenResultDoneInvariant.done (by
                      intro stateAfter valuesAfter' hDone
                      cases hDone
                      exact hContains)
              | error err =>
                  simp [hCallKind, hCreateKind, hCreate, hPrim]
                  exact
                    OpenResultDoneInvariant.done (by
                      intro stateAfter valuesAfter hDone
                      cases hDone)
          | some create =>
              simp [hCallKind, hCreateKind, hCreate,
                Locals.Source.State.withShared]
              exact
                OpenResultDoneInvariant.create (by
                  intro response
                  exact
                    OpenResultDoneInvariant.done (by
                      intro stateAfter valuesAfter hDone
                      cases hDone
                      exact hContains))
  | some kind =>
      have hNoCreateKind :
          OpenExternal.CreateKind.ofBasicOp? op = none :=
        createKind_ofBasicOp?_none_of_callKind hCallKind
      cases hCall :
          OpenExternal.CallKind.primitiveSharedOpenCall?
            state.shared kind values with
      | none =>
          cases hPrim : prim.eval op state.shared values with
          | ok primResult =>
              rcases primResult with ⟨sharedAfter, valuesAfter⟩
              simp [hCallKind, hNoCreateKind, hCall, hPrim,
                Locals.Source.State.withShared]
              exact
                OpenResultDoneInvariant.done (by
                  intro stateAfter valuesAfter' hDone
                  cases hDone
                  exact hContains)
          | error err =>
              simp [hCallKind, hNoCreateKind, hCall, hPrim]
              exact
                OpenResultDoneInvariant.done (by
                  intro stateAfter valuesAfter hDone
                  cases hDone)
      | some call =>
          simp [hCallKind, hNoCreateKind, hCall,
            Locals.Source.State.withShared]
          exact
            OpenResultDoneInvariant.call (by
              intro response
              exact
                OpenResultDoneInvariant.done (by
                  intro stateAfter valuesAfter hDone
                  cases hDone
                  exact hContains))

