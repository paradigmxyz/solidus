                      cases hExec :
                          EvmYul.Yul.exec fuel' (.Block fn.body)
                            codeOverride
                              (EvmYul.Yul.State.mkOk
                                (EvmYul.Yul.State.initcall fn.params fn.rets
                                  args (.OutOfFuel : State))) with
                      | error err =>
                          simp [hExec, SourcePairResultCheckpointAllowed,
                            EvmYul.Yul.State.initcall,
                            EvmYul.Yul.State.mkOk]
                      | ok bodyState =>
                          simp [hExec, SourcePairResultCheckpointAllowed,
