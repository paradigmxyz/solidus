theorem SourceStateRel.of_restrictStoreTo_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {shared : EvmYul.SharedState .Yul} {store scope : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    (hRel :
      SourceStateRel cfg layout
        ((.Ok shared store : State).restrictStoreTo scope) compiler)
    (hScope : ∀ name, name ∈ layout → (scope.lookup name).isSome = true) :
    SourceStateRel cfg layout (.Ok shared store) compiler := by
  cases hRel with
  | ok hShared hVars =>
      exact
        SourceStateRel.ok hShared
          (sourceStoreRel_of_restrictVarStore_scope_contains hVars hScope)

theorem SourceOkOutcomeRel.of_restrictStoreTo_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {scope : EvmYul.Yul.VarStore} {source : State}
    {outcome : Objects.Source.Outcome}
    (hScope : ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hRel :
      SourceOkOutcomeRel cfg layout (source.restrictStoreTo scope)
        outcome) :
    SourceOkOutcomeRel cfg layout source outcome := by
  cases source with
  | Ok shared store =>
      cases hRel with
      | regular hStateRel =>
          exact
            SourceOkOutcomeRel.regular
              (SourceStateRel.of_restrictStoreTo_scope_contains hStateRel
                hScope)
  | OutOfFuel =>
      cases hRel with
      | regular hStateRel =>
          cases hStateRel
  | Checkpoint jump =>
      cases jump with
      | Continue shared store =>
          cases hRel with
          | regular hStateRel =>
              cases hStateRel
          | cont hStateRel =>
              exact
                SourceOkOutcomeRel.cont
                  (SourceStateRel.of_restrictStoreTo_scope_contains
                    hStateRel hScope)
      | Break shared store =>
          cases hRel with
          | regular hStateRel =>
              cases hStateRel
          | brk hStateRel =>
              exact
                SourceOkOutcomeRel.brk
                  (SourceStateRel.of_restrictStoreTo_scope_contains
                    hStateRel hScope)
      | Leave shared store =>
          cases hRel with
          | regular hStateRel =>
              cases hStateRel
          | leave hStateRel =>
              exact
                SourceOkOutcomeRel.leave
                  (SourceStateRel.of_restrictStoreTo_scope_contains
                    hStateRel hScope)

def restrictSourceResultTo (scope : EvmYul.Yul.VarStore) :
    Except Exception State → Except Exception State
  | .ok source => .ok (source.restrictStoreTo scope)
  | .error err => .error err

def SourceResultNotRegularOk : Except Exception State → Prop
  | .ok (.Ok _ _) => False
  | _ => True

theorem SourceResultOutcomeRel.of_restrictStoreTo_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    {outcome : Objects.Source.Outcome}
    (hScope : ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (match sourceResult with
         | .ok source => .ok (source.restrictStoreTo scope)
         | .error err => .error err)
        outcome) :
    SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
      outcome := by
  cases sourceResult with
  | error err =>
      simpa using hRel
  | ok source =>
      cases hRel with
      | ok hOk =>
          exact
            SourceResultOutcomeRel.ok
              (SourceOkOutcomeRel.of_restrictStoreTo_scope_contains hScope
                hOk)

theorem StoreDomainExact.restrictVarStore_eq_of_same_domain
    {layout : List Name} {store scope : EvmYul.Yul.VarStore}
    (hStore : StoreDomainExact layout store)
    (hScope : StoreDomainExact layout scope) :
    EvmYul.Yul.State.restrictVarStore store scope = store := by
  apply Finmap.ext_lookup
  intro name
  by_cases hMem : name ∈ layout
  · have hScopeSome : (scope.lookup name).isSome = true :=
      (hScope name).mpr hMem
    cases hScopeLookup : scope.lookup name with
    | none =>
        simp [hScopeLookup] at hScopeSome
    | some value =>
        exact
          FinmapFacts.lookup_restrictVarStore_of_scope_some store scope name
            hScopeLookup
  · cases hStoreLookup : store.lookup name with
    | none =>
        cases hScopeLookup : scope.lookup name with
        | none =>
            rw [FinmapFacts.lookup_restrictVarStore_of_scope_none store scope
              name hScopeLookup]
        | some value =>
            rw [FinmapFacts.lookup_restrictVarStore_of_scope_some store scope
              name hScopeLookup]
            exact hStoreLookup
    | some value =>
        have hLookupSome : (store.lookup name).isSome = true := by
          simp [hStoreLookup]
        have hNameMem : name ∈ layout := (hStore name).mp hLookupSome
        exact False.elim (hMem hNameMem)

theorem State.restrictStoreTo_ok_eq_of_same_domain
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store scope : EvmYul.Yul.VarStore}
    (hStore : StoreDomainExact layout store)
    (hScope : StoreDomainExact layout scope) :
    ((.Ok shared store : State).restrictStoreTo scope) =
      .Ok shared store := by
  simp [EvmYul.Yul.State.restrictStoreTo,
    StoreDomainExact.restrictVarStore_eq_of_same_domain hStore hScope]

theorem stmtRun_regular_of_runScoped_single
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {targetFuel : Nat} {stmt : Functions.Stmt}
    {compiler compilerAfter : Objects.Source.State}
    (hRun :
      Functions.Source.Block.runScoped prim program ctx { stmts := [stmt] }
          targetFuel compiler =
        .ok (Functions.Source.Outcome.regular compilerAfter)) :
    ∃ stmtFuel : Nat, ∃ compilerAfterStmt : Objects.Source.State,
    ∃ stmtCtxAfter : Functions.Source.Ctx,
      Functions.Source.Stmt.run prim program ctx stmtFuel stmt compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterStmt,
          stmtCtxAfter) ∧
      compilerAfter = compilerAfterStmt.restrictTo ctx.scope := by
  cases targetFuel with
  | zero =>
      simp [Functions.Source.Block.runScoped, Functions.Source.Block.runOpen,
        Functions.Source.invalid, Structured.invalid] at hRun
  | succ headFuel =>
      cases headFuel with
      | zero =>
          cases hStmt :
              Functions.Source.Stmt.run prim program ctx 0 stmt compiler with
          | error err =>
              simp [Functions.Source.Block.runScoped,
                Functions.Source.Block.runOpen, Functions.Source.invalid,
                Structured.invalid, hStmt] at hRun
          | ok result =>
              cases result with
              | mk outcome stmtCtxAfter =>
                  cases outcome with
                  | mk state mode =>
                      cases mode <;>
                        simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen,
                          Functions.Source.invalid, Structured.invalid,
                          hStmt, Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular] at hRun
      | succ stmtFuel =>
          cases hStmt :
              Functions.Source.Stmt.run prim program ctx stmtFuel.succ stmt
                compiler with
          | error err =>
              simp [Functions.Source.Block.runScoped,
                Functions.Source.Block.runOpen, Functions.Source.invalid,
                Structured.invalid, hStmt] at hRun
          | ok result =>
              cases result with
              | mk outcome stmtCtxAfter =>
                  cases outcome with
                  | mk state mode =>
                      cases mode
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen, hStmt,
                          Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular] at hRun
                        exact
                          ⟨stmtFuel.succ, state, stmtCtxAfter, hStmt,
                            by simpa using hRun.symm⟩
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen, hStmt,
                          Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular,
                          Functions.Source.Outcome.brk,
                          Locals.Source.Outcome.brk] at hRun
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen, hStmt,
                          Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular,
                          Functions.Source.Outcome.cont,
                          Locals.Source.Outcome.cont] at hRun
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen, hStmt,
                          Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular,
                          Functions.Source.Outcome.leave,
                          Locals.Source.Outcome.leave] at hRun
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen, hStmt,
                          Functions.Source.Outcome.regular,
                          Locals.Source.Outcome.regular,
                          Functions.Source.Outcome.halt,
                          Locals.Source.Outcome.halt] at hRun

theorem stmtRun_nonregular_of_runScoped_single
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {targetFuel : Nat} {stmt : Functions.Stmt}
    {compiler : Objects.Source.State}
    {sourceOutcome : Objects.Source.Outcome}
    (hRun :
      Functions.Source.Block.runScoped prim program ctx { stmts := [stmt] }
          targetFuel compiler =
        .ok sourceOutcome)
    (hNonregular : sourceOutcome.mode ≠ Locals.Source.Mode.regular) :
    ∃ stmtFuel : Nat, ∃ stmtCtxAfter : Functions.Source.Ctx,
      Functions.Source.Stmt.run prim program ctx stmtFuel stmt compiler =
        .ok (sourceOutcome, stmtCtxAfter) := by
  cases targetFuel with
  | zero =>
      simp [Functions.Source.Block.runScoped, Functions.Source.Block.runOpen,
        Functions.Source.invalid, Structured.invalid] at hRun
  | succ headFuel =>
      cases hStmt :
          Functions.Source.Stmt.run prim program ctx headFuel stmt compiler with
      | error err =>
          simp [Functions.Source.Block.runScoped,
            Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid, hStmt] at hRun
      | ok result =>
          cases result with
          | mk outcome stmtCtxAfter =>
              cases hMode : outcome.mode
              · cases headFuel with
                | zero =>
                    simp [Functions.Source.Block.runScoped,
                      Functions.Source.Block.runOpen, Functions.Source.invalid,
                      Structured.invalid, hStmt, hMode,
                      Functions.Source.Outcome.regular,
                      Locals.Source.Outcome.regular] at hRun
                | succ tailFuel =>
                    simp [Functions.Source.Block.runScoped,
                      Functions.Source.Block.runOpen, hStmt, hMode,
                      Functions.Source.Outcome.regular,
                      Locals.Source.Outcome.regular] at hRun
                    subst sourceOutcome
                    exact False.elim (hNonregular rfl)
              · simp [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, hStmt, hMode] at hRun
                subst sourceOutcome
                exact ⟨headFuel, stmtCtxAfter, hStmt⟩
              · simp [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, hStmt, hMode] at hRun
                subst sourceOutcome
                exact ⟨headFuel, stmtCtxAfter, hStmt⟩
              · simp [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, hStmt, hMode] at hRun
                subst sourceOutcome
                exact ⟨headFuel, stmtCtxAfter, hStmt⟩
              · simp [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, hStmt, hMode] at hRun
                subst sourceOutcome
                exact ⟨headFuel, stmtCtxAfter, hStmt⟩

theorem stmtRun_regular_of_runOpen_single
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {targetFuel : Nat} {stmt : Functions.Stmt}
    {compiler compilerAfter : Objects.Source.State}
    (hRun :
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := [stmt] } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter)) :
    ∃ stmtFuel : Nat,
      Functions.Source.Stmt.run prim program ctx stmtFuel stmt compiler =
        .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) := by
  cases targetFuel with
  | zero =>
      simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
        Structured.invalid] at hRun
  | succ headFuel =>
      cases hStmt :
          Functions.Source.Stmt.run prim program ctx headFuel stmt
            compiler with
      | error err =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid, hStmt] at hRun
      | ok result =>
          rcases result with ⟨outcome, stmtCtxAfter⟩
          cases hMode : outcome.mode
          · cases headFuel with
            | zero =>
                simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid, hStmt, hMode,
                  Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] at hRun
            | succ fuel =>
                simp [Functions.Source.Block.runOpen, hStmt, hMode,
                  Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] at hRun
                rcases hRun with ⟨hState, hCtxEq⟩
                cases hCtxEq
                cases outcome with
                | mk outcomeState outcomeMode =>
                    simp at hMode
                    cases hMode
                    cases hState
                    exact
                      ⟨fuel.succ,
                        by
                          simpa [Functions.Source.Outcome.regular,
                            Locals.Source.Outcome.regular] using hStmt⟩
          · simp [Functions.Source.Block.runOpen, hStmt, hMode,
              Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular,
              Functions.Source.Outcome.brk,
              Locals.Source.Outcome.brk] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            simp [Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] at hMode
          · simp [Functions.Source.Block.runOpen, hStmt, hMode,
              Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular,
              Functions.Source.Outcome.cont,
              Locals.Source.Outcome.cont] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            simp [Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] at hMode
          · simp [Functions.Source.Block.runOpen, hStmt, hMode,
              Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular,
              Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            simp [Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] at hMode
          · simp [Functions.Source.Block.runOpen, hStmt, hMode,
              Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular,
              Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            simp [Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] at hMode

theorem stmtRun_nonregular_of_runOpen_single
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {targetFuel : Nat} {stmt : Functions.Stmt}
    {compiler : Objects.Source.State}
    {sourceOutcome : Objects.Source.Outcome}
    (hRun :
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := [stmt] } compiler =
        .ok (sourceOutcome, ctxAfter))
    (hNonregular : sourceOutcome.mode ≠ Locals.Source.Mode.regular) :
    ∃ stmtFuel : Nat, ∃ stmtCtxAfter : Functions.Source.Ctx,
      Functions.Source.Stmt.run prim program ctx stmtFuel stmt compiler =
        .ok (sourceOutcome, stmtCtxAfter) := by
  cases targetFuel with
  | zero =>
      simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
        Structured.invalid] at hRun
  | succ headFuel =>
      cases hStmt :
          Functions.Source.Stmt.run prim program ctx headFuel stmt
            compiler with
      | error err =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid, hStmt] at hRun
      | ok result =>
          rcases result with ⟨outcome, stmtCtxAfter⟩
          cases hMode : outcome.mode
          · cases headFuel with
            | zero =>
                simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid, hStmt, hMode,
                  Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] at hRun
            | succ fuel =>
                simp [Functions.Source.Block.runOpen, hStmt, hMode,
                  Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] at hRun
                rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
                cases hOutcomeEq
                exact False.elim (hNonregular rfl)
          · simp [Functions.Source.Block.runOpen, hStmt, hMode] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            exact ⟨headFuel, stmtCtxAfter, hStmt⟩
          · simp [Functions.Source.Block.runOpen, hStmt, hMode] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            exact ⟨headFuel, stmtCtxAfter, hStmt⟩
          · simp [Functions.Source.Block.runOpen, hStmt, hMode] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            exact ⟨headFuel, stmtCtxAfter, hStmt⟩
          · simp [Functions.Source.Block.runOpen, hStmt, hMode] at hRun
            rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
            cases hOutcomeEq
            exact ⟨headFuel, stmtCtxAfter, hStmt⟩

theorem sourceScopeContains_of_runOpen_regular
    {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {state stateAfter : Objects.Source.State}
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.regular stateAfter, ctxAfter)) :
    ∀ name : Name, name ∈ layout → name ∈ ctxAfter.scope := by
  have hScopeEq :
      ctxAfter.scope = Functions.Scope.Block.outEnv ctx.scope block :=
    Functions.SourceDirect.SourceRun.block_runOpen_regular_scope hRun
  intro name hMem
  rw [hScopeEq]
  exact
    Functions.SourceDirect.SourceScope.block_outEnv_contains_of_contains
      (block := block) (hScopeContains name hMem)

theorem functionsScope_stmtList_outEnv_append_contains
    {env : List Name} {pref suffix : List Functions.Stmt} {name : Name}
    (hMem :
      name ∈ Functions.Scope.StmtList.outEnv env pref) :
    name ∈ Functions.Scope.StmtList.outEnv env (pref ++ suffix) := by
  induction pref generalizing env with
  | nil =>
      simp [Functions.Scope.StmtList.outEnv] at hMem ⊢
      exact
        Functions.SourceDirect.SourceScope.stmtList_outEnv_contains_of_contains
          (stmts := suffix) hMem
  | cons stmt rest ih =>
      simp [Functions.Scope.StmtList.outEnv] at hMem ⊢
      exact ih hMem

theorem functionsScope_stmtList_outEnv_append_suffix_contains
    {env : List Name} {pref suffix : List Functions.Stmt} {name : Name}
    (hMem :
      name ∈
        Functions.Scope.StmtList.outEnv
          (Functions.Scope.StmtList.outEnv env pref) suffix) :
    name ∈ Functions.Scope.StmtList.outEnv env (pref ++ suffix) := by
  induction pref generalizing env with
  | nil =>
      simpa [Functions.Scope.StmtList.outEnv] using hMem
  | cons stmt rest ih =>
      simp [Functions.Scope.StmtList.outEnv] at hMem ⊢
      exact ih hMem

theorem functionsScope_initNames_outEnv_contains
    {env names : List Name} {name : Name}
    (hMem : name ∈ names) :
    name ∈
      Functions.Scope.StmtList.outEnv env (Stmt.initNames names) := by
  induction names generalizing env with
  | nil =>
      cases hMem
  | cons head rest ih =>
      simp [Stmt.initNames, Functions.Scope.StmtList.outEnv,
        Functions.Scope.Stmt.outEnv] at hMem ⊢
      rcases hMem with hEq | hRest
      · subst head
        exact
          Functions.SourceDirect.SourceScope.stmtList_outEnv_contains_of_contains
            (stmts := Stmt.initNames rest) (by simp)
      · exact ih (env := head :: env) hRest

/--
Compatibility between a run-filtered imported result and the layout chosen for
the source outcome relation.

This records a missing side condition for recursive bridge induction: abrupt
checkpoints are not sound at an arbitrary `outcomeLayout`; they must target the
continuation layout carried by the current source context, and that continuation
layout must be a retained subset of the current source layout. Ordinary
successful results keep the entry layout, while terminal/revert errors do not
inspect the layout in `SourceResultOutcomeRel`.
-/
def SourceResultOutcomeLayoutCompatible
    (ctx : Functions.Source.Ctx) (layout outcomeLayout : List Name) :
    Except Exception State → Prop
  | .ok (.Ok _shared _store) => outcomeLayout = layout
  | .ok (.Checkpoint (.Break _shared _store)) =>
      ctx.breakScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok (.Checkpoint (.Continue _shared _store)) =>
      ctx.continueScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok (.Checkpoint (.Leave _shared _store)) =>
      ctx.leaveScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok .OutOfFuel => True
  | .error _err => True

/--
Compositional outcome-layout support for open sequences.

`SourceResultOutcomeLayoutCompatible` is intentionally strong for public exact
block frontiers: a regular result says the selected outcome layout is exactly
the entry layout.  Hidden open-sequence tails need a weaker, structural fact.
After a declaration head the current visible layout grows, while the eventual
observable outcome layout may still be an outer layout.  For regular results it
is enough that the chosen outcome layout is contained in the current visible
layout; abrupt checkpoints still have to target the corresponding handler
layout in the current source context.
-/
def SourceResultOutcomeLayoutSupported
    (ctx : Functions.Source.Ctx) (layout outcomeLayout : List Name) :
    Except Exception State → Prop
  | .ok (.Ok _shared _store) =>
      ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok (.Checkpoint (.Break _shared _store)) =>
      ctx.breakScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok (.Checkpoint (.Continue _shared _store)) =>
      ctx.continueScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok (.Checkpoint (.Leave _shared _store)) =>
      ctx.leaveScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok .OutOfFuel => True
  | .error _err => True

/--
Mode-facing outcome support for hidden generated-control blocks.

This is weaker than `SourceResultOutcomeLayoutSupported` exactly for
`break`/`continue`: generated loops consume those modes internally, so the
handler scope may contain compiler-only locals and only has to retain the
source-visible `layout`.  `leave` remains a final continuation and still uses
`outcomeLayout`.
-/
def SourceResultHiddenModeSupported
    (ctx : Functions.Source.Ctx) (layout outcomeLayout : List Name) :
    Except Exception State → Prop
  | .ok (.Ok _shared _store) => True
  | .ok (.Checkpoint (.Break _shared _store)) =>
      ∃ breakScope : List Name,
        ctx.breakScope? = some breakScope ∧
          ∀ name, name ∈ layout → name ∈ breakScope
  | .ok (.Checkpoint (.Continue _shared _store)) =>
      ∃ continueScope : List Name,
        ctx.continueScope? = some continueScope ∧
          ∀ name, name ∈ layout → name ∈ continueScope
  | .ok (.Checkpoint (.Leave _shared _store)) =>
      ctx.leaveScope? = some outcomeLayout ∧
        ∀ name, name ∈ outcomeLayout → name ∈ layout
  | .ok .OutOfFuel => True
  | .error _err => True

structure SourceModeKontLayouts where
  regular : List Name
  brk : List Name
  cont : List Name
  leave : List Name

namespace SourceModeKontLayouts

def block (layout outcomeLayout : List Name) : SourceModeKontLayouts :=
  { regular := layout
    brk := layout
    cont := layout
    leave := outcomeLayout }

def uniform (layout : List Name) : SourceModeKontLayouts :=
  { regular := layout
    brk := layout
    cont := layout
    leave := layout }

def withRegular (regular : List Name)
    (konts : SourceModeKontLayouts) : SourceModeKontLayouts :=
  { regular := regular
    brk := konts.brk
    cont := konts.cont
    leave := konts.leave }

/--
Static part of the continuation-shape invariant needed by abrupt control
heads.

`SourceResultModeKontSupported` records that the target handler scopes are
installed.  This predicate records the separate fact that the source-visible
values expected by `break` and `continue` are still present in the current
layout.  Declaration heads preserve it by monotonicity of the current layout.
-/
structure ControlWithin (currentLayout : List Name)
    (konts : SourceModeKontLayouts) : Prop where
  brk : ∀ name : Name, name ∈ konts.brk → name ∈ currentLayout
  cont : ∀ name : Name, name ∈ konts.cont → name ∈ currentLayout

theorem block_controlWithin (layout outcomeLayout : List Name) :
    ControlWithin layout (block layout outcomeLayout) where
  brk := by
    intro name hMem
    simpa [block] using hMem
  cont := by
    intro name hMem
    simpa [block] using hMem

theorem uniform_controlWithin (layout : List Name) :
    ControlWithin layout (uniform layout) where
  brk := by
    intro name hMem
    simpa [uniform] using hMem
  cont := by
    intro name hMem
    simpa [uniform] using hMem

theorem uniform_controlWithin_of_subset
    {currentLayout uniformLayout : List Name}
    (hSubset :
      ∀ name : Name, name ∈ uniformLayout → name ∈ currentLayout) :
    ControlWithin currentLayout (uniform uniformLayout) where
  brk := by
    intro name hMem
    exact hSubset name (by simpa [uniform] using hMem)
  cont := by
    intro name hMem
    exact hSubset name (by simpa [uniform] using hMem)

theorem ControlWithin.mono_current
    {currentLayout currentLayout' : List Name}
    {konts : SourceModeKontLayouts}
    (hSubset :
      ∀ name : Name, name ∈ currentLayout → name ∈ currentLayout')
    (hWithin : ControlWithin currentLayout konts) :
    ControlWithin currentLayout' konts where
  brk := by
    intro name hMem
    exact hSubset name (hWithin.brk name hMem)
  cont := by
    intro name hMem
    exact hSubset name (hWithin.cont name hMem)

theorem ControlWithin.withRegular
    {currentLayout : List Name} {konts : SourceModeKontLayouts}
    (regular : List Name)
    (hWithin : ControlWithin currentLayout konts) :
    ControlWithin currentLayout (withRegular regular konts) where
  brk := by
    intro name hMem
    exact hWithin.brk name (by simpa [withRegular] using hMem)
  cont := by
    intro name hMem
    exact hWithin.cont name (by simpa [withRegular] using hMem)

end SourceModeKontLayouts

/--
Outcome relation with one declared layout per source control mode.

This is the typed-continuation counterpart of `SourceResultOutcomeRel`, whose
single layout is correct for ordinary final-outcome theorems but too rigid for
generated control.
-/
inductive SourceOkKontOutcomeRel (cfg : StateRelConfig)
    (konts : SourceModeKontLayouts) :
    State → Objects.Source.Outcome → Prop where
  | regular {source : State} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg konts.regular source compiler) :
      SourceOkKontOutcomeRel cfg konts source
        (Functions.Source.Outcome.regular compiler)
  | brk {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg konts.brk (.Ok shared store) compiler) :
      SourceOkKontOutcomeRel cfg konts
        (.Checkpoint (.Break shared store))
        (Functions.Source.Outcome.brk compiler)
  | cont {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg konts.cont (.Ok shared store) compiler) :
      SourceOkKontOutcomeRel cfg konts
        (.Checkpoint (.Continue shared store))
        (Functions.Source.Outcome.cont compiler)
  | leave {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg konts.leave (.Ok shared store) compiler) :
      SourceOkKontOutcomeRel cfg konts
        (.Checkpoint (.Leave shared store))
        (Functions.Source.Outcome.leave compiler)

inductive SourceResultKontOutcomeRel (cfg : StateRelConfig)
    (konts : SourceModeKontLayouts)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop) :
    Except Exception State → Objects.Source.Outcome → Prop where
  | ok {source : State} {outcome : Objects.Source.Outcome}
      (hRel : SourceOkKontOutcomeRel cfg konts source outcome) :
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        (.ok source) outcome
  | yulHalt {source : State} {value : Word} {kind : Assembly.HaltKind}
      {compiler : Objects.Source.State}
      (hRel : terminalRel kind value source compiler) :
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        (.error (.YulHalt source value))
        (Functions.Source.Outcome.halt kind compiler)
  | revert {source : State} {compiler : Objects.Source.State}
      (hRel : revertRel source compiler) :
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        (.error (.Revert source))
        (Functions.Source.Outcome.halt .revert compiler)

namespace SourceResultKontOutcomeRel

theorem mode_ne_regular_of_error
    {cfg : StateRelConfig} {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {err : Exception} {sourceOutcome : Objects.Source.Outcome}
    (hRel :
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        (.error err) sourceOutcome) :
    sourceOutcome.mode ≠ Locals.Source.Mode.regular := by
  intro hMode
  cases hRel with
  | yulHalt hTerminal =>
      simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt] at hMode
  | revert hRevert =>
      simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt] at hMode

theorem mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {jump : EvmYul.Yul.Jump}
    {sourceOutcome : Objects.Source.Outcome}
    (hRel :
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        (.ok (.Checkpoint jump)) sourceOutcome) :
    sourceOutcome.mode ≠ Locals.Source.Mode.regular := by
  intro hMode
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hState =>
          cases hState
      | brk hState =>
          simp [Functions.Source.Outcome.brk, Locals.Source.Outcome.brk] at hMode
      | cont hState =>
          simp [Functions.Source.Outcome.cont, Locals.Source.Outcome.cont] at hMode
      | leave hState =>
          simp [Functions.Source.Outcome.leave, Locals.Source.Outcome.leave] at hMode

