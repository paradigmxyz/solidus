  | error err =>
      simp [hCheck, SourceResultStoreContains]
  | ok unit =>
      simpa [hCheck] using
        SourceResultStoreContains.multifill' (names := names) hEvalValues

theorem exec_assign_succ_of_evalValues {layout : List Name}
    {fuel : Nat} {names : List EvmYul.Identifier} {value : AstExpr}
