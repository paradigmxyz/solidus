    (hAllowed :
      StateCheckpointAllowed canBreak canContinue canLeave state)
    (hStateEq :
      ∀ {outState : State} {values : List Word},
        EvmYul.Yul.primCall fuel state prim args =
          .ok (outState, values) →
        outState = state) :
    SourcePairResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.primCall fuel state prim args) := by
  cases hCall : EvmYul.Yul.primCall fuel state prim args with
  | error err =>
      simp [SourcePairResultCheckpointAllowed, hCall]
  | ok pair =>
      cases pair with
      | mk outState values =>
          have hEq : outState = state := hStateEq hCall
          subst outState
          exact SourcePairResultCheckpointAllowed.ok hAllowed

