                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                    | some argResult =>
                                        rcases argResult with
                                          ⟨preArgs, lowerArgs, stateArgs⟩
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                        rcases hLower with
                                          ⟨hLowerEq, hStateEq⟩
                                        cases hLowerEq
                                        cases hStateEq
                                        exact False.elim
                                          (noInternalCallStmtList_append_call_false
                                            (pre := preArgs)
                                            (targets := identNames [name])
                                            (functionName := functionName)
                                            (args := lowerArgs)
                                            hNoCall)
                                | true =>
                                    cases hArgs :
                                        Expr.List.toLocals1? args with
                                    | none =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                    | some lowerArgs =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                        rcases hLower with
                                          ⟨hLowerEq, hStateEq⟩
                                        cases hLowerEq
                                        cases hStateEq
                                        exact False.elim
                                          (noInternalCallStmtList_append_call_false
                                            (pre := [])
                                            (targets := identNames [name])
                                            (functionName := functionName)
                                            (args := lowerArgs)
                                            hNoCall)
                        | inl prim =>
                            rcases
                                toFunctionsListFuel?_assign_expr_single_components
                                  (by
                                    intro functionName args hEq
                                    cases hEq)
                                  hLower with
                              ⟨pre, lowerValue, hExprLower, hLowerEq⟩
                            subst lower
                            rcases
                                noInternalCallStmtList_append_single_components
                                  hNoCall with
                              ⟨hPre, _hAssign⟩
                            exact
                              exprNoUserCalls_of_lower1?_noInternalCall
                                hExprLower hPre
                    | Var varName =>
                        rcases
                            toFunctionsListFuel?_assign_expr_single_components
                              (by
                                intro functionName args hEq
                                cases hEq)
                              hLower with
                          ⟨pre, lowerValue, hExprLower, hLowerEq⟩
                        subst lower
                        rcases
                            noInternalCallStmtList_append_single_components
                              hNoCall with
                          ⟨hPre, _hAssign⟩
                        exact
                          exprNoUserCalls_of_lower1?_noInternalCall
                            hExprLower hPre
                    | Lit literal =>
                        rcases
                            toFunctionsListFuel?_assign_expr_single_components
                              (by
                                intro functionName args hEq
                                cases hEq)
                              hLower with
                          ⟨pre, lowerValue, hExprLower, hLowerEq⟩
                        subst lower
                        rcases
                            noInternalCallStmtList_append_single_components
                              hNoCall with
                          ⟨hPre, _hAssign⟩
                        exact
                          exprNoUserCalls_of_lower1?_noInternalCall
                            hExprLower hPre
                | cons next rest =>
                    cases value with
                    | Call callee args =>
                        cases callee with
                        | inr functionName =>
                            cases hUnsupported :
                                ObjectBuiltin.unsupported? functionName with
                            | true =>
                                simp [Stmt.toFunctionsListFuel?,
                                  hUnsupported] at hLower
                            | false =>
                                cases hDirect :
                                    Expr.List.directCallArgsSafe? args with
                                | false =>
                                    cases hArgs :
                                        Expr.List.lowerBound1? state args with
                                    | none =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                    | some argResult =>
                                        rcases argResult with
                                          ⟨preArgs, lowerArgs, stateArgs⟩
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                        rcases hLower with
                                          ⟨hLowerEq, hStateEq⟩
                                        cases hLowerEq
                                        cases hStateEq
                                        exact False.elim
                                          (noInternalCallStmtList_append_call_false
                                            (pre := preArgs)
                                            (targets :=
                                              identNames
                                                (name :: next :: rest))
                                            (functionName := functionName)
                                            (args := lowerArgs) hNoCall)
                                | true =>
                                    cases hArgs :
                                        Expr.List.toLocals1? args with
                                    | none =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                    | some lowerArgs =>
                                        simp [Stmt.toFunctionsListFuel?,
                                          hUnsupported, hDirect, hArgs]
                                          at hLower
                                        rcases hLower with
                                          ⟨hLowerEq, hStateEq⟩
                                        cases hLowerEq
                                        cases hStateEq
                                        exact False.elim
                                          (noInternalCallStmtList_append_call_false
                                            (pre := [])
                                            (targets :=
                                              identNames
                                                (name :: next :: rest))
                                            (functionName := functionName)
                                            (args := lowerArgs) hNoCall)
                        | inl prim =>
                            simp [Stmt.toFunctionsListFuel?] at hLower
                    | Var varName =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
                    | Lit literal =>
                        simp [Stmt.toFunctionsListFuel?] at hLower
        | ExprStmtCall value =>
            cases value with
            | Call callee args =>
                cases callee with
                | inr functionName =>
                    cases hUnsupported :
                        ObjectBuiltin.unsupported? functionName with
                    | true =>
                        simp [Stmt.toFunctionsListFuel?, hUnsupported]
                          at hLower
                    | false =>
                        cases hDirect :
                            Expr.List.directCallArgsSafe? args with
                        | false =>
                            cases hArgs :
                                Expr.List.lowerBound1? state args with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hUnsupported,
                                  hDirect, hArgs] at hLower
                            | some argResult =>
                                rcases argResult with
                                  ⟨preArgs, lowerArgs, stateArgs⟩
                                simp [Stmt.toFunctionsListFuel?, hUnsupported,
                                  hDirect, hArgs] at hLower
                                rcases hLower with ⟨hLowerEq, hStateEq⟩
                                cases hLowerEq
                                cases hStateEq
                                exact False.elim
                                  (noInternalCallStmtList_append_call_false
                                    (pre := preArgs) (targets := [])
                                    (functionName := functionName)
                                    (args := lowerArgs) hNoCall)
                        | true =>
                            cases hArgs :
                                Expr.List.toLocals1? args with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hUnsupported,
                                  hDirect, hArgs] at hLower
                            | some lowerArgs =>
                                simp [Stmt.toFunctionsListFuel?, hUnsupported,
                                  hDirect, hArgs] at hLower
                                rcases hLower with ⟨hLowerEq, hStateEq⟩
                                cases hLowerEq
                                cases hStateEq
                                exact False.elim
                                  (noInternalCallStmtList_append_call_false
                                    (pre := []) (targets := [])
                                    (functionName := functionName)
                                    (args := lowerArgs) hNoCall)
                | inl prim =>
                    cases hTerminal : Prim.terminal? prim with
                    | some kind =>
                        cases hArgs :
                            Expr.List.lowerBound1? state args with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hTerminal,
                              hArgs] at hLower
                        | some argResult =>
                            rcases argResult with
                              ⟨preArgs, lowerArgs, stateArgs⟩
                            cases hSeq :
                                Expr.List.toStackSeq? lowerArgs kind.argCount with
                            | none =>
                                simp [Stmt.toFunctionsListFuel?, hTerminal,
                                  hArgs, hSeq] at hLower
                            | some seq =>
                                simp [Stmt.toFunctionsListFuel?, hTerminal,
                                  hArgs, hSeq] at hLower
                                rcases hLower with ⟨hLowerEq, hStateEq⟩
                                cases hLowerEq
                                cases hStateEq
                                rcases
                                    noInternalCallStmtList_append_single_components
                                      hNoCall with
                                  ⟨hPre, _hTerminal⟩
                                exact
                                  exprsNoUserCalls_of_lowerBound1?_noInternalCall
                                    hArgs hPre
                    | none =>
                        cases hExpr :
                            Expr.lower? 0 state (.Call (.inl prim) args) with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hTerminal,
                              Expr.lower0?, hExpr] at hLower
                        | some exprResult =>
                            rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
                            simp [Stmt.toFunctionsListFuel?, hTerminal,
                              Expr.lower0?, hExpr] at hLower
                            rcases hLower with ⟨hLowerEq, hStateEq⟩
                            cases hLowerEq
                            cases hStateEq
                            rcases
                                noInternalCallStmtList_append_single_components
                                  hNoCall with
                              ⟨hPre, _hExpr⟩
                            exact
                              exprNoUserCalls_of_lower?_noInternalCall
                                hExpr hPre
            | Var name =>
                cases hExpr : Expr.lower? 0 state (.Var name) with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, Expr.lower0?, hExpr]
                      at hLower
                | some exprResult =>
                    rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
                    simp [Stmt.toFunctionsListFuel?, Expr.lower0?, hExpr]
                      at hLower
                    rcases hLower with ⟨hLowerEq, hStateEq⟩
                    cases hLowerEq
                    cases hStateEq
                    rcases
                        noInternalCallStmtList_append_single_components hNoCall
                      with
                      ⟨hPre, _hExpr⟩
                    exact exprNoUserCalls_of_lower?_noInternalCall hExpr hPre
            | Lit literal =>
                cases hExpr : Expr.lower? 0 state (.Lit literal) with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, Expr.lower0?, hExpr]
                      at hLower
                | some exprResult =>
                    rcases exprResult with ⟨pre, lowerValue, stateExpr⟩
                    simp [Stmt.toFunctionsListFuel?, Expr.lower0?, hExpr]
                      at hLower
                    rcases hLower with ⟨hLowerEq, hStateEq⟩
                    cases hLowerEq
                    cases hStateEq
                    rcases
                        noInternalCallStmtList_append_single_components hNoCall
                      with
                      ⟨hPre, _hExpr⟩
                    exact exprNoUserCalls_of_lower?_noInternalCall hExpr hPre
        | Switch scrutinee cases defaultBody =>
            cases hScrutinee :
                Expr.lower1? state scrutinee with
            | none =>
                simp [Stmt.toFunctionsListFuel?, hScrutinee] at hLower
            | some scrutineeResult =>
                rcases scrutineeResult with
                  ⟨preScrutinee, lowerScrutinee, stateScrutinee⟩
                cases hCases :
                    Stmt.CaseList.toFunctionsFuel? fuel stateScrutinee
                      cases with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hScrutinee, hCases]
                      at hLower
                | some casesResult =>
                    rcases casesResult with ⟨lowerCases, stateCases⟩
                    cases defaultBody with
                    | nil =>
                        simp [Stmt.toFunctionsListFuel?, hScrutinee, hCases]
                          at hLower
                        rcases hLower with ⟨hLowerEq, hStateEq⟩
                        cases hLowerEq
                        cases hStateEq
                        rcases
                            noInternalCallStmtList_append_single_components
                              hNoCall with
                          ⟨hPre, hSwitch⟩
                        rcases
                            (by
                              simpa [Functions.LiveLayout.NoInternalCall.Stmt.Holds]
                                using hSwitch :
                              Functions.LiveLayout.NoInternalCall.CaseList.Holds
                                  lowerCases ∧
                                Functions.LiveLayout.NoInternalCall.Default.Holds
                                  none) with
                          ⟨hCasesNo, _hDefaultNo⟩
                        exact
                          ⟨exprNoUserCalls_of_lower1?_noInternalCall
                              hScrutinee hPre,
                            casesNoUserCalls_of_toFunctionsFuel?_noInternalCall
                              hCases hCasesNo,
                            by simp [StmtsNoUserCalls]⟩
                    | cons defaultHead defaultTail =>
                        cases hDefault :
                            Stmt.List.toBlockFuel? fuel stateCases
                              (defaultHead :: defaultTail) with
                        | none =>
                            simp [Stmt.toFunctionsListFuel?, hScrutinee,
                              hCases, hDefault] at hLower
                        | some defaultResult =>
                            rcases defaultResult with
                              ⟨lowerDefault, stateDefault⟩
                            simp [Stmt.toFunctionsListFuel?, hScrutinee,
                              hCases, hDefault] at hLower
                            rcases hLower with ⟨hLowerEq, hStateEq⟩
                            cases hLowerEq
                            cases hStateEq
                            rcases
                                noInternalCallStmtList_append_single_components
                                  hNoCall with
                              ⟨hPre, hSwitch⟩
                            rcases
                                (by
                                  simpa [Functions.LiveLayout.NoInternalCall.Stmt.Holds]
                                    using hSwitch :
                                  Functions.LiveLayout.NoInternalCall.CaseList.Holds
                                      lowerCases ∧
                                    Functions.LiveLayout.NoInternalCall.Default.Holds
                                      (some lowerDefault)) with
                              ⟨hCasesNo, hDefaultNo⟩
                            exact
                              ⟨exprNoUserCalls_of_lower1?_noInternalCall
                                  hScrutinee hPre,
                                casesNoUserCalls_of_toFunctionsFuel?_noInternalCall
                                  hCases hCasesNo,
                                stmtsNoUserCalls_of_toBlockFuel?_noInternalCall
                                  hDefault
                                  (by
                                    simpa [Functions.LiveLayout.NoInternalCall.Default.Holds]
                                      using hDefaultNo)⟩
        | For cond post body =>
            cases hCond : Expr.lower1? state cond with
            | none =>
                simp [Stmt.toFunctionsListFuel?, hCond] at hLower
            | some condResult =>
                rcases condResult with ⟨preCond, lowerCond, stateCond⟩
                cases hPost :
                    Stmt.List.toBlockFuel? fuel stateCond post with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hCond, hPost] at hLower
                | some postResult =>
                    rcases postResult with ⟨lowerPost, statePost⟩
                    cases hBody :
                        Stmt.List.toBlockFuel? fuel statePost body with
                    | none =>
                        simp [Stmt.toFunctionsListFuel?, hCond, hPost, hBody]
                          at hLower
                    | some bodyResult =>
                        rcases bodyResult with ⟨lowerBody, stateBody⟩
                        simp [Stmt.toFunctionsListFuel?, hCond, hPost, hBody]
                          at hLower
                        rcases hLower with ⟨hLowerEq, hStateEq⟩
                        cases hLowerEq
                        cases hStateEq
                        have hForStmt := noInternalCallStmtList_single hNoCall
                        rcases
                            (by
                              simpa [Functions.LiveLayout.NoInternalCall.Stmt.Holds,
                                Functions.LiveLayout.NoInternalCall.Block.Holds]
                                using hForStmt :
                              Functions.LiveLayout.NoInternalCall.Block.Holds
                                  { stmts := [] } ∧
                                Functions.LiveLayout.NoInternalCall.Block.Holds
                                  lowerPost ∧
                                Functions.LiveLayout.NoInternalCall.Block.Holds
                                  { stmts :=
                                    preCond ++
                                      [Functions.Stmt.if_
                                        (.prim .iszero
                                          (Locals.ExprSeq.cons lowerCond
                                            .nil))
                                        { stmts := [Functions.Stmt.brk] }] ++
                                      lowerBody.stmts }) with
                          ⟨_hInit, hPostBodyNo⟩
                        rcases hPostBodyNo with ⟨hPostNo, hBodyWithCondNo⟩
                        have hBodyWithCondList :
                            Functions.LiveLayout.NoInternalCall.StmtList.Holds
                              (preCond ++
                                ([Functions.Stmt.if_
                                  (.prim .iszero
                                    (Locals.ExprSeq.cons lowerCond .nil))
                                  { stmts := [Functions.Stmt.brk] }] ++
                                  lowerBody.stmts)) := by
                          simpa [Functions.LiveLayout.NoInternalCall.Block.Holds,
                            List.append_assoc] using hBodyWithCondNo
                        rcases
                            noInternalCallStmtList_append_components
                              hBodyWithCondList with
                          ⟨hPreCond, hIfAndBodyNo⟩
                        rcases
                            noInternalCallStmtList_append_components
                              hIfAndBodyNo with
                          ⟨_hIfNo, hBodyNoList⟩
                        have hBodyNo :
                            Functions.LiveLayout.NoInternalCall.Block.Holds
                              lowerBody := by
                          cases lowerBody
                          simpa [Functions.LiveLayout.NoInternalCall.Block.Holds]
                            using hBodyNoList
                        exact
                          ⟨exprNoUserCalls_of_lower1?_noInternalCall
                              hCond hPreCond,
                            stmtsNoUserCalls_of_toBlockFuel?_noInternalCall
                              hPost hPostNo,
                            stmtsNoUserCalls_of_toBlockFuel?_noInternalCall
                              hBody hBodyNo⟩
        | If cond body =>
            cases hCond : Expr.lower1? state cond with
            | none =>
                simp [Stmt.toFunctionsListFuel?, hCond] at hLower
            | some condResult =>
                rcases condResult with ⟨preCond, lowerCond, stateCond⟩
                cases hBody :
                    Stmt.List.toBlockFuel? fuel stateCond body with
                | none =>
                    simp [Stmt.toFunctionsListFuel?, hCond, hBody] at hLower
                | some bodyResult =>
                    rcases bodyResult with ⟨lowerBody, stateBody⟩
                    simp [Stmt.toFunctionsListFuel?, hCond, hBody] at hLower
                    rcases hLower with ⟨hLowerEq, hStateEq⟩
                    cases hLowerEq
                    cases hStateEq
                    rcases
                        noInternalCallStmtList_append_single_components hNoCall
                      with
                      ⟨hPreCond, hIfNo⟩
                    have hBodyNo :
                        Functions.LiveLayout.NoInternalCall.Block.Holds
                          lowerBody := by
                      simpa [Functions.LiveLayout.NoInternalCall.Stmt.Holds]
                        using hIfNo
                    exact
                      ⟨exprNoUserCalls_of_lower1?_noInternalCall hCond
                          hPreCond,
                        stmtsNoUserCalls_of_toBlockFuel?_noInternalCall hBody
                          hBodyNo⟩
        | Continue =>
            simp [StmtNoUserCalls]
        | Break =>
            simp [StmtNoUserCalls]
        | Leave =>
            simp [StmtNoUserCalls]

  theorem stmtsNoUserCalls_of_toFunctionsFuel?_noInternalCall
      {fuel : Nat} {state state' : Fresh.State} {stmts : List AstStmt}
      {lower : List Functions.Stmt}
      (hLower :
        Stmt.List.toFunctionsFuel? fuel state stmts = some (lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.StmtList.Holds lower) :
      StmtsNoUserCalls stmts := by
    cases fuel with
    | zero =>
        simp [Stmt.List.toFunctionsFuel?] at hLower
    | succ fuel =>
        cases stmts with
        | nil =>
            simp [StmtsNoUserCalls]
        | cons head rest =>
            cases hHead :
                Stmt.toFunctionsListFuel? fuel state head with
            | none =>
                simp [Stmt.List.toFunctionsFuel?, hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨lowerHead, stateHead⟩
                cases hRest :
                    Stmt.List.toFunctionsFuel? fuel stateHead rest with
                | none =>
                    simp [Stmt.List.toFunctionsFuel?, hHead, hRest] at hLower
                | some restResult =>
                    rcases restResult with ⟨lowerRest, stateRest⟩
                    simp [Stmt.List.toFunctionsFuel?, hHead, hRest] at hLower
                    rcases hLower with ⟨hLowerEq, hStateEq⟩
                    cases hLowerEq
                    cases hStateEq
                    rcases
                        noInternalCallStmtList_append_components hNoCall with
                      ⟨hHeadNo, hRestNo⟩
                    exact
                      ⟨stmtNoUserCalls_of_toFunctionsListFuel?_noInternalCall
                          hHead hHeadNo,
                        stmtsNoUserCalls_of_toFunctionsFuel?_noInternalCall
                          hRest hRestNo⟩

  theorem casesNoUserCalls_of_toFunctionsFuel?_noInternalCall
      {fuel : Nat} {state state' : Fresh.State}
      {cases : List (Word × List AstStmt)}
      {lower : List (Word × Functions.Block)}
      (hLower :
        Stmt.CaseList.toFunctionsFuel? fuel state cases =
          some (lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.CaseList.Holds lower) :
      CasesNoUserCalls cases := by
    cases fuel with
    | zero =>
        simp [Stmt.CaseList.toFunctionsFuel?] at hLower
    | succ fuel =>
        cases cases with
        | nil =>
            simp [CasesNoUserCalls]
        | cons head rest =>
            rcases head with ⟨value, body⟩
            cases hBody :
                Stmt.List.toBlockFuel? fuel state body with
            | none =>
                simp [Stmt.CaseList.toFunctionsFuel?, hBody] at hLower
            | some bodyResult =>
                rcases bodyResult with ⟨lowerBody, stateBody⟩
                cases hRest :
                    Stmt.CaseList.toFunctionsFuel? fuel stateBody rest with
                | none =>
                    simp [Stmt.CaseList.toFunctionsFuel?, hBody, hRest]
                      at hLower
                | some restResult =>
                    rcases restResult with ⟨lowerRest, stateRest⟩
                    simp [Stmt.CaseList.toFunctionsFuel?, hBody, hRest]
                      at hLower
                    rcases hLower with ⟨hLowerEq, hStateEq⟩
                    cases hLowerEq
                    cases hStateEq
                    rcases
                        (by
                          simpa [Functions.LiveLayout.NoInternalCall.CaseList.Holds]
                            using hNoCall :
                          Functions.LiveLayout.NoInternalCall.Block.Holds
                              lowerBody ∧
                            Functions.LiveLayout.NoInternalCall.CaseList.Holds
                              lowerRest) with
                      ⟨hBodyNo, hRestNo⟩
                    exact
                      ⟨stmtsNoUserCalls_of_toBlockFuel?_noInternalCall hBody
                          hBodyNo,
                        casesNoUserCalls_of_toFunctionsFuel?_noInternalCall
                          hRest hRestNo⟩

  theorem stmtsNoUserCalls_of_toBlockFuel?_noInternalCall
      {fuel : Nat} {state state' : Fresh.State} {stmts : List AstStmt}
      {lower : Functions.Block}
      (hLower :
        Stmt.List.toBlockFuel? fuel state stmts = some (lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.Block.Holds lower) :
      StmtsNoUserCalls stmts := by
    cases fuel with
    | zero =>
        simp [Stmt.List.toBlockFuel?] at hLower
    | succ fuel =>
        cases hList :
            Stmt.List.toFunctionsFuel? fuel state stmts with
        | none =>
            simp [Stmt.List.toBlockFuel?, hList] at hLower
        | some listResult =>
            rcases listResult with ⟨lowerStmts, stateList⟩
            simp [Stmt.List.toBlockFuel?, hList] at hLower
            rcases hLower with ⟨hLowerEq, hStateEq⟩
            cases hLowerEq
            cases hStateEq
            exact
              stmtsNoUserCalls_of_toFunctionsFuel?_noInternalCall hList
                (by
                  simpa [Functions.LiveLayout.NoInternalCall.Block.Holds]
                    using hNoCall)
end

/-- Open compiler expression shape for an output-one primitive cast. -/
theorem compilerOpen_localsExpr_evalOne_cast_prim_outputs_one
    {prim : Objects.Source.PrimitiveSemantics}
    {op : Structured.BasicOp}
    {lowerArgs :
    Locals.ExprSeq (Expressions.Structured.BasicOp.inputs op)}
    {state : Objects.Source.State}
    (hOutputs : Expressions.Structured.BasicOp.outputs op = 1) :
    CompilerOpen.LocalsExpr.evalOne prim
        (Expr.cast hOutputs (.prim op lowerArgs)) state =
      OpenExternal.OpenResult.bind
        (CompilerOpen.LocalsExpr.evalSeq prim lowerArgs state)
        (fun argResult =>
          OpenExternal.OpenResult.bind
            (CompilerOpen.Primitive.eval prim op argResult.1 argResult.2)
            fun primResult =>
              match primResult.2 with
              | [value] => .done (.ok (primResult.1, value))
              | _ => CompilerOpen.invalid) := by
  cases op <;>
    simp [Expressions.Structured.BasicOp.outputs, Expr.cast,
      CompilerOpen.LocalsExpr.evalOne, CompilerOpen.LocalsExpr.eval,
      OpenExternal.OpenResult.ok,
      CompilerOpen.invalid, openResult_bind_assoc] at hOutputs ⊢ <;>
    rfl

/--
Names-aware checked result-sequence target for hidden-context exactness.

This is the checked-lowering facade for generated-prelude sequence heads. The
fresh-state invariant is still stated over source-visible names
`reserved ++ layout`, while the semantic target allows the compiler context to
carry hidden generated locals between the head and the tail.
-/
def CheckedSeqLoweringSoundWhenFreshNamesAtCompileFuelHiddenCtx
    (cfg : StateRelConfig) (reserved layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel compileFuel : Nat)
    (sourceStmts : List AstStmt) (codeOverride : Option AstContract)
    (allowed : Except Exception State → Prop) :
    Prop :=
  ∀ {freshState freshState' lowerBlock},
    FreshCoversLayout (reserved ++ layout) freshState →
    Stmt.List.toBlockFuel? compileFuel freshState sourceStmts =
      some (lowerBlock, freshState') →
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel sourceStmts
      codeOverride lowerBlock allowed

theorem CheckedSeqLoweringSoundWhenFreshNamesAtCompileFuelHiddenCtx.of_seqKont_uniform
    {cfg : StateRelConfig} {reserved layout : List Name}
