      (program := program) (ctx := ctx) (innerFuel := sourceFuel.succ)
      (body := body) (codeOverride := codeOverride) (lowerBody := lowerBody)
      (allowed := allowed) hAllowed hCompat hScope
      (fun {allowedInner} _hAllowedInner hCompatInner =>
        sourceResultBlockSoundWhenAtExact_of_regularSeqExactDomain_compat
          (cfg := cfg) (layout := layout) (layoutAfter := layoutAfter)
          (outcomeLayout := outcomeLayout) (terminalRel := terminalRel)
          (revertRel := revertRel) (prim := prim) (program := program)
          (ctx := ctx) (sourceFuel := sourceFuel) (targetFuel := targetFuel)
          (body := body) (codeOverride := codeOverride)
          (lowerBody := lowerBody) (allowed := allowedInner)
