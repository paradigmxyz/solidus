/--
Recover the open-block leave result hidden under `Block.runScoped`.

Scoped execution only restricts the store for regular fallthrough.  Abrupt
control outcomes, including Yul `leave`, are returned unchanged.
-/
theorem sourceRunScoped_leave_eq_open
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state out : Objects.Source.State}
    (hRun :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok (Functions.Source.Outcome.leave out)) :
    ∃ finalCtx : Functions.Source.Ctx,
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.leave out, finalCtx) := by
  unfold Functions.Source.Block.runScoped at hRun
  cases hOpen :
      Functions.Source.Block.runOpen prim program ctx fuel block state with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨outcome, finalCtx⟩
      cases outcome with
      | mk outcomeState mode =>
          cases mode
          · simp [hOpen, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular, Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave] at hRun
          · simp [hOpen, Functions.Source.Outcome.brk,
              Locals.Source.Outcome.brk, Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave] at hRun
          · simp [hOpen, Functions.Source.Outcome.cont,
              Locals.Source.Outcome.cont, Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave] at hRun
          · simp [hOpen, Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave] at hRun
            cases hRun
            exact ⟨finalCtx, by
              simpa [Functions.Source.Outcome.leave,
                Locals.Source.Outcome.leave] using hOpen⟩
          · simp [hOpen, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt, Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave] at hRun

/--
Recover the open-block halt result hidden under `Block.runScoped`.

Scoped execution only restricts the store for regular fallthrough.  Terminal
EVM-level halts are returned unchanged.
-/
theorem sourceRunScoped_halt_eq_open
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state out : Objects.Source.State} {kind : Assembly.HaltKind}
    (hRun :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok (Functions.Source.Outcome.halt kind out)) :
    ∃ finalCtx : Functions.Source.Ctx,
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.halt kind out, finalCtx) := by
  unfold Functions.Source.Block.runScoped at hRun
  cases hOpen :
      Functions.Source.Block.runOpen prim program ctx fuel block state with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨outcome, finalCtx⟩
      cases outcome with
      | mk outcomeState mode =>
          cases mode
          · simp [hOpen, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt] at hRun
          · simp [hOpen, Functions.Source.Outcome.brk,
              Locals.Source.Outcome.brk, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt] at hRun
          · simp [hOpen, Functions.Source.Outcome.cont,
              Locals.Source.Outcome.cont, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt] at hRun
          · simp [hOpen, Functions.Source.Outcome.leave,
              Locals.Source.Outcome.leave, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt] at hRun
          · simp [hOpen, Functions.Source.Outcome.halt,
              Locals.Source.Outcome.halt] at hRun
            rcases hRun with ⟨hKind, hState⟩
            subst kind
            subst out
            exact ⟨finalCtx, by
              simpa [Functions.Source.Outcome.halt,
                Locals.Source.Outcome.halt] using hOpen⟩

/--
Halted function-body adapter from the recursive scoped-block boundary to the
source function-call interpreter.

This is the terminal sibling of the regular/leave returned-value adapters:
once the body runs to `Outcome.halt`, `FunDef.runBody` returns
`CallResult.halted` without looking up return variables.
-/
theorem sourceFunDef_runBody_halted_of_runScoped_halt
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {fn : Functions.FunDef}
    {args : List Word} {paramStore : Locals.Source.Store}
    {shared0 : EvmYul.SharedState .EVM}
    {out : Objects.Source.State} {fuel : Nat}
    {kind : Assembly.HaltKind}
    (hInsert :
      Functions.Source.Store.insertMany fn.params args
          Locals.Source.Store.empty =
        some paramStore)
    (hRunScoped :
      Functions.Source.Block.runScoped prim program
          (Functions.Source.FunDef.bodyCtx fn) fn.body fuel
          { shared := shared0,
            vars := Functions.Source.Store.initReturns fn.returns paramStore } =
        .ok (Functions.Source.Outcome.halt kind out)) :
    Functions.Source.FunDef.runBody prim program fn args (fuel + 1)
        shared0 =
      .ok (Functions.Source.CallResult.halted kind out) := by
  rcases sourceRunScoped_halt_eq_open hRunScoped with ⟨finalCtx, hOpen⟩
  have hOpenExplicit :
      Functions.Source.Block.runOpen prim program
          { Functions.Source.Ctx.initial.withLeaveScope
              (fn.returns ++ fn.params) with
            scope := fn.returns ++ fn.params }
          fuel fn.body
          { shared := shared0,
            vars := Functions.Source.Store.initReturns fn.returns
              paramStore } =
        .ok (Functions.Source.Outcome.halt kind out, finalCtx) := by
    simpa [Functions.Source.FunDef.bodyCtx] using hOpen
  unfold Functions.Source.FunDef.runBody
  simp [hInsert, hOpenExplicit, Functions.Source.Outcome.halt,
    Locals.Source.Outcome.halt]

theorem SourceResultOutcomeRel.error_relayout
    {cfg : StateRelConfig} {layout layout' : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {err : Exception} {outcome : Objects.Source.Outcome}
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.error err) outcome) :
    SourceResultOutcomeRel cfg layout' terminalRel revertRel
      (.error err) outcome := by
  cases hRel with
  | yulHalt hTerminal =>
      exact SourceResultOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact SourceResultOutcomeRel.revert hRevert

/--
Leave function-body adapter from the recursive scoped-block boundary to the
source function-call interpreter.

This is the successful `leave` sibling of
`sourceFunDef_runBody_returned_of_runScoped_regular_exact`.
-/
theorem sourceFunDef_runBody_returned_of_runScoped_leave_domain
    {cfg : StateRelConfig}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {fn : Functions.FunDef}
    {args : List Word} {paramStore : Locals.Source.Store}
    {shared0 : EvmYul.SharedState .EVM}
    {out : Objects.Source.State} {fuel : Nat}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    (hInsert :
      Functions.Source.Store.insertMany fn.params args
          Locals.Source.Store.empty =
        some paramStore)
    (hRunScoped :
      Functions.Source.Block.runScoped prim program
          (Functions.Source.FunDef.bodyCtx fn) fn.body fuel
          { shared := shared0,
            vars := Functions.Source.Store.initReturns fn.returns paramStore } =
        .ok (Functions.Source.Outcome.leave out))
    (hRel :
      SourceStateRel cfg (fn.returns ++ fn.params)
        (.Ok shared store) out)
    (hDomain : StoreDomainExact (fn.returns ++ fn.params) store) :
    ∃ returnValues : List Word,
      Functions.Source.FunDef.runBody prim program fn args (fuel + 1)
          shared0 =
        .ok
          (Functions.Source.CallResult.returned out.shared returnValues) := by
  rcases sourceRunScoped_leave_eq_open hRunScoped with ⟨finalCtx, hOpen⟩
  have hReturnsMem :
      ∀ name, name ∈ fn.returns → name ∈ fn.returns ++ fn.params := by
    intro name hMem
    exact List.mem_append_left _ hMem
  have hLookup :
      Functions.Source.Store.lookupMany fn.returns out.vars =
        some
          (fn.returns.map fun name =>
            EvmYul.Yul.State.lookup! name (.Ok shared store)) := by
    cases hRel with
    | ok _hShared hVars =>
        exact
          sourceStoreRel_lookupMany_of_domain
            (layout := fn.returns ++ fn.params)
            (returns := fn.returns) (shared := shared) (store := store)
            (vars := out.vars) hVars hDomain hReturnsMem
  have hOpenExplicit :
      Functions.Source.Block.runOpen prim program
          { Functions.Source.Ctx.initial.withLeaveScope
              (fn.returns ++ fn.params) with
            scope := fn.returns ++ fn.params }
          fuel fn.body
          { shared := shared0,
            vars := Functions.Source.Store.initReturns fn.returns
              paramStore } =
        .ok (Functions.Source.Outcome.leave out, finalCtx) := by
    simpa [Functions.Source.FunDef.bodyCtx] using hOpen
  refine
    ⟨fn.returns.map fun name =>
        EvmYul.Yul.State.lookup! name (.Ok shared store), ?_⟩
  unfold Functions.Source.FunDef.runBody
  simp [hInsert, hOpenExplicit, hLookup, Functions.Source.Outcome.leave,
    Locals.Source.Outcome.leave]

