theorem noInternalCallStmtList_single
    {stmt : Functions.Stmt}
    (hHolds :
      Functions.LiveLayout.NoInternalCall.StmtList.Holds [stmt]) :
    Functions.LiveLayout.NoInternalCall.Stmt.Holds stmt := by
  simpa [Functions.LiveLayout.NoInternalCall.StmtList.Holds] using hHolds.1

theorem noInternalCallBlock_of_single_block
    {body : Functions.Block}
    (hHolds :
      Functions.LiveLayout.NoInternalCall.StmtList.Holds
        [Functions.Stmt.block body]) :
    Functions.LiveLayout.NoInternalCall.Block.Holds body := by
  have hStmt := noInternalCallStmtList_single hHolds
  simpa [Functions.LiveLayout.NoInternalCall.Stmt.Holds] using hStmt

theorem noInternalCallStmtList_append_single_components
    {left : List Functions.Stmt} {stmt : Functions.Stmt}
    (hHolds :
      Functions.LiveLayout.NoInternalCall.StmtList.Holds (left ++ [stmt])) :
    Functions.LiveLayout.NoInternalCall.StmtList.Holds left ∧
      Functions.LiveLayout.NoInternalCall.Stmt.Holds stmt := by
  rcases noInternalCallStmtList_append_components hHolds with
    ⟨hLeft, hRight⟩
  exact ⟨hLeft, noInternalCallStmtList_single hRight⟩

