/--
Recursive finite-path callback for the direct generated loop continuation.

Ordinary sequence and typed-continuation recursion can rebuild loop bodies and
post blocks, but the generated target loop recursively calls
`Stmt.runForLoop` directly after a regular post.  This callback is the open
CALL analogue of the existing closed `for`/`runForLoop` callback in the
Functions proof: every recursive loop continuation is bounded by the current
source fuel and tied to the checked lowering facts for the generated post and
body.
-/
def CALLOpenLoopContinuationPathRecursiveAt
    (cfg : StateRelConfig)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (yulProgram : Program) (program : Functions.Program)
    (bound : Nat) : Prop :=
  ∀ {sourceFuelRec headCompileFuelRec : Nat}
    {reservedRec layoutRec outcomeLayoutRec : List Name}
    {ctxRec : Functions.Source.Ctx}
    {allowedRec : Except Exception State → Prop}
    {canBreakRec canContinueRec canLeaveRec : Bool}
    {condRec : AstExpr} {postRec bodyRec : List AstStmt}
    {freshStateRec freshStateAfterCondRec freshStateAfterPostRec
      freshStateRec' : Fresh.State}
    {preCondRec : List Functions.Stmt}
    {lowerCondRec : Functions.Expr 1}
    {lowerPostRec lowerBodyRec : Functions.Block},
    sourceFuelRec ≤ bound →
    Safe.CallSafe.stmt (.For condRec postRec bodyRec) →
    ControlFlow.ScopedStmt canBreakRec canContinueRec canLeaveRec
      (.For condRec postRec bodyRec) →
    UserCallArity.StmtOk yulProgram.contract
      (.For condRec postRec bodyRec) →
    SourceLexical.StmtScoped layoutRec (.For condRec postRec bodyRec) →
    SourceNamesReserved reservedRec (Stmt.names (.For condRec postRec bodyRec)) →
    FreshCoversLayout (reservedRec ++ layoutRec) freshStateRec →
    Expr.lower1? freshStateRec condRec =
      some (preCondRec, lowerCondRec, freshStateAfterCondRec) →
    Stmt.List.toBlockFuel? headCompileFuelRec freshStateAfterCondRec postRec =
      some (lowerPostRec, freshStateAfterPostRec) →
    Stmt.List.toBlockFuel? headCompileFuelRec freshStateAfterPostRec bodyRec =
      some (lowerBodyRec, freshStateRec') →
    (∀ {sourceResult}, allowedRec sourceResult →
      SourceResultRelatable sourceResult) →
    (∀ {sourceResult}, allowedRec sourceResult →
      SourceResultOutcomeLayoutSupported ctxRec layoutRec outcomeLayoutRec
        sourceResult) →
    (∀ name : Name, name ∈ layoutRec → name ∈ ctxRec.scope) →
    SourceOpenLoopContinuationPathSoundWhenAtExactHiddenCtx cfg layoutRec
      outcomeLayoutRec terminalRel revertRel prim program ctxRec sourceFuelRec
      condRec postRec bodyRec (some yulProgram.contract) lowerPostRec
      { stmts :=
          preCondRec ++
            [Functions.Stmt.if_
              (.prim .iszero (Locals.ExprSeq.cons lowerCondRec .nil))
              { stmts := [Functions.Stmt.brk] }] ++
            lowerBodyRec.stmts }
      allowedRec

