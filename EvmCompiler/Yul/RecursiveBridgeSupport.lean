        cases stmt with
        | Block body =>
            cases hBody :
                Stmt.List.toBlockFuel? fuel state body with
            | none =>
                simp [Stmt.toFunctionsListFuel?, hBody] at hLower
            | some bodyResult =>
                rcases bodyResult with ⟨lowerBody, stateBody⟩
                simp [Stmt.toFunctionsListFuel?, hBody] at hLower
                rcases hLower with ⟨hLowerEq, hStateEq⟩
                cases hLowerEq
                cases hStateEq
