                                codeOverride
                                  (EvmYul.Yul.State.mkOk
                                    (EvmYul.Yul.State.initcall fn.params
                                      fn.rets args
                                      (.Checkpoint (.Continue shared store) :
                                        State))) with
                          | error err =>
                              simp [hExec, SourcePairResultCheckpointAllowed,
                                EvmYul.Yul.State.initcall,
                                EvmYul.Yul.State.mkOk]
                          | ok bodyState =>
                              simpa [hExec,
                                SourcePairResultCheckpointAllowed,
                                EvmYul.Yul.State.setStore,
                                EvmYul.Yul.State.overwrite?,
                                EvmYul.Yul.State.initcall,
                                EvmYul.Yul.State.mkOk,
                                StateCheckpointAllowed] using hState
      | Break shared store =>
          cases fuel with
          | zero =>
              simp [EvmYul.Yul.call, SourcePairResultCheckpointAllowed]
          | succ fuel' =>
              simp [EvmYul.Yul.call, EvmYul.Yul.State.sharedState,
                EvmYul.Yul.State.executionEnv]
              cases hFind :
                  (default : EvmYul.SharedState .Yul).accountMap.find?
