theorem evalTail_zero {layout : List Name}
    {args : List AstExpr} {codeOverride : Option AstContract}
    {sourceResult : Except Exception (State × Word)} :
    SourcePairResultStoreContains layout
      (EvmYul.Yul.evalTail 0 args codeOverride sourceResult) := by
  cases sourceResult with
  | error err =>
      simp [SourcePairResultStoreContains, EvmYul.Yul.evalTail]
  | ok pair =>
      cases pair
      simp [SourcePairResultStoreContains, EvmYul.Yul.evalTail]

theorem evalTail_succ_of_head_tail {layout : List Name}
    {fuel : Nat} {args : List AstExpr} {codeOverride : Option AstContract}
    {sourceResult : Except Exception (State × Word)}
    (hHead : SourcePairResultStoreContains layout sourceResult)
    (hTail :
      ∀ {stateAfterHead : State} {value : Word},
        sourceResult = .ok (stateAfterHead, value) →
        SourcePairResultStoreContains layout
          (EvmYul.Yul.evalArgs fuel args codeOverride stateAfterHead)) :
    SourcePairResultStoreContains layout
      (EvmYul.Yul.evalTail fuel.succ args codeOverride sourceResult) := by
  cases sourceResult with
  | error err =>
      simp [SourcePairResultStoreContains, EvmYul.Yul.evalTail]
  | ok pair =>
      cases pair with
      | mk stateAfterHead value =>
          simpa [EvmYul.Yul.evalTail] using
            SourcePairResultStoreContains.cons'
              (arg := value)
              (hTail (stateAfterHead := stateAfterHead) (value := value) rfl)

theorem call_of_state {layout : List Name}
    {fuel : Nat} {functionName : Name} {args : List Word}
    {codeOverride : Option AstContract} {state : State}
    (hContains : StateStoreContains layout state) :
    SourcePairResultStoreContains layout
      (EvmYul.Yul.call fuel args (some functionName) codeOverride state) := by
  cases hCall :
      EvmYul.Yul.call fuel args (some functionName) codeOverride state with
  | error err =>
      simp [SourcePairResultStoreContains]
  | ok pair =>
      cases pair with
      | mk stateAfter values =>
          exact
            SourcePairResultStoreContains.ok
              (call_ok_state_contains_of_state hContains hCall)

theorem state_of_ok {layout : List Name} {α : Type}
    {sourceResult : Except Exception (State × α)}
    {state : State} {value : α}
    (hContains : SourcePairResultStoreContains layout sourceResult)
    (hResult : sourceResult = .ok (state, value)) :
    StateStoreContains layout state := by
  subst sourceResult
  simpa [SourcePairResultStoreContains] using hContains

end SourcePairResultStoreContains

namespace SourceResultStoreContains

theorem of_state {layout : List Name} {state : State}
    (hState : StateStoreContains layout state) :
    SourceResultStoreContains layout (.ok state) := by
  simpa [SourceResultStoreContains] using hState

theorem state_of_ok {layout : List Name}
    {sourceResult : Except Exception State} {state : State}
    (hContains : SourceResultStoreContains layout sourceResult)
    (hResult : sourceResult = .ok state) :
    StateStoreContains layout state := by
  subst sourceResult
  simpa [SourceResultStoreContains] using hContains

theorem multifill' {layout : List Name}
    {names : List EvmYul.Identifier}
    {sourceResult : Except Exception (State × List Word)}
    (hContains : SourcePairResultStoreContains layout sourceResult) :
    SourceResultStoreContains layout
      (EvmYul.Yul.multifill' names sourceResult) := by
  cases sourceResult with
  | error err =>
      simp [SourceResultStoreContains, SourcePairResultStoreContains,
        EvmYul.Yul.multifill']
  | ok pair =>
      cases pair with
      | mk state values =>
          exact
            StateStoreContains.multifill
              (names := names) (values := values)
              (by simpa [SourcePairResultStoreContains] using hContains)

theorem execSeq_nil_succ {layout : List Name}
    {fuel : Nat} {codeOverride : Option AstContract} {state : State}
    (hState : StateStoreContains layout state) :
    SourceResultStoreContains layout
      (EvmYul.Yul.execSeq fuel.succ [] codeOverride state) := by
  rw [Imported.execSeq_nil_succ]
  exact SourceResultStoreContains.of_state hState

theorem execSeq_cons_succ {layout : List Name}
    {fuel : Nat} {stmt : AstStmt} {rest : List AstStmt}
    {codeOverride : Option AstContract} {state : State}
    (hHead :
      SourceResultStoreContains layout
        (EvmYul.Yul.exec fuel stmt codeOverride state))
    (hTail :
      ∀ {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore},
        EvmYul.Yul.exec fuel stmt codeOverride state =
          .ok (.Ok shared store) →
        SourceResultStoreContains layout
          (EvmYul.Yul.execSeq fuel rest codeOverride (.Ok shared store))) :
    SourceResultStoreContains layout
      (EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state) := by
  cases hExec : EvmYul.Yul.exec fuel stmt codeOverride state with
  | error err =>
      simp [EvmYul.Yul.execSeq, hExec, SourceResultStoreContains]
  | ok headState =>
      cases headState with
      | Ok shared store =>
          simpa [EvmYul.Yul.execSeq, hExec] using
            hTail (shared := shared) (store := store) hExec
      | OutOfFuel =>
          simp [EvmYul.Yul.execSeq, hExec, SourceResultStoreContains,
            StateStoreContains]
      | Checkpoint jump =>
          simpa [EvmYul.Yul.execSeq, hExec] using hHead

theorem exec_block_succ_of_execSeq {layout : List Name}
    {fuel : Nat} {stmts : List AstStmt} {codeOverride : Option AstContract}
    {state : State}
    (hScope : StoreDomainContains layout (EvmYul.Yul.State.store state))
    (hSeq :
      SourceResultStoreContains layout
        (EvmYul.Yul.execSeq fuel stmts codeOverride state)) :
    SourceResultStoreContains layout
      (EvmYul.Yul.exec fuel.succ (.Block stmts) codeOverride state) := by
  cases hExecSeq : EvmYul.Yul.execSeq fuel stmts codeOverride state with
  | error err =>
      simp [EvmYul.Yul.exec, hExecSeq, SourceResultStoreContains]
  | ok stateAfter =>
      have hStateAfter :
          StateStoreContains layout stateAfter :=
        SourceResultStoreContains.state_of_ok hSeq hExecSeq
      simp [EvmYul.Yul.exec, hExecSeq, SourceResultStoreContains]
      exact StateStoreContains.restrictStoreTo
        (scope := EvmYul.Yul.State.store state) hStateAfter
        hScope

theorem exec_let_none_succ_of_state {layout : List Name}
    {fuel : Nat} {names : List EvmYul.Identifier}
    {codeOverride : Option AstContract} {state : State}
    (hState : StateStoreContains layout state) :
    SourceResultStoreContains layout
      (EvmYul.Yul.exec fuel.succ (.Let names none) codeOverride state) := by
  rw [Imported.exec_let_none_succ]
  cases hCheck : EvmYul.Yul.checkDeclaration state names with
  | error err =>
      simp [hCheck, SourceResultStoreContains]
  | ok unit =>
      simpa [hCheck, SourceResultStoreContains] using
        StateStoreContains.zeroFill (names := names) hState

theorem exec_let_some_succ_of_evalValues {layout : List Name}
    {fuel : Nat} {names : List EvmYul.Identifier} {value : AstExpr}
