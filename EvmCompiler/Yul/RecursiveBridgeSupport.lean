theorem sourceWritesDisjoint_runOpen_regular_agree
    {names : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    ∀ {pre : List Functions.Stmt} {ctx ctxAfter : Functions.Source.Ctx}
      {fuel : Nat} {state stateAfter : Objects.Source.State},
      SourceWritesDisjoint names pre →
      Functions.Source.Block.runOpen prim program ctx fuel
          { stmts := pre } state =
        .ok (Functions.Source.Outcome.regular stateAfter, ctxAfter) →
      SourceVarsAgree names state.vars stateAfter.vars := by
  intro pre
  induction pre with
  | nil =>
      intro ctx ctxAfter fuel state stateAfter _hPre hRun
      rcases
          Functions.Source.Block.runOpen_nil_ok
            (prim := prim) (program := program) (ctx := ctx)
            (fuel := fuel) (state := state)
            (outcome := Functions.Source.Outcome.regular stateAfter)
            (runCtx := ctxAfter) hRun with
        ⟨hOutcome, _hCtx⟩
      have hState : stateAfter = state := by
        simpa [Functions.Source.Outcome.regular,
          Locals.Source.Outcome.regular] using congrArg
            (fun outcome : Functions.Source.Outcome => outcome.state)
            hOutcome
      subst stateAfter
      exact SourceVarsAgree.refl
  | cons stmt rest ih =>
      intro ctx ctxAfter fuel state stateAfter hPre hRun
      cases stmt with
      | expr expr =>
          simp [SourceWritesDisjoint] at hPre
      | let_ name value =>
          have hNameFresh : name ∉ names := by
            simpa [SourceWritesDisjoint] using hPre.1
          have hRest : SourceWritesDisjoint names rest := by
            simpa [SourceWritesDisjoint] using hPre.2
          cases fuel with
          | zero =>
              simp [Functions.Source.Block.runOpen,
                Functions.Source.invalid, Structured.invalid] at hRun
          | succ fuel =>
              simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run]
                at hRun
              cases hEval :
                  Locals.Source.Expr.evalOne prim value state with
              | error err =>
                  simp [hEval] at hRun
              | ok evalResult =>
                  rcases evalResult with ⟨stateAfterValue, value'⟩
                  simp [hEval, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular] at hRun
                  have hEvalAgree :
                      SourceVarsAgree names state.vars
                        stateAfterValue.vars := by
                    intro protectedName hMem
                    have hVars :=
                      Locals.Source.Expr.evalOne_vars_eq hEval
                    simpa [hVars]
                  have hInsertAgree :
                      SourceVarsAgree names stateAfterValue.vars
                        (stateAfterValue.insert name value').vars :=
                    SourceVarsAgree.insert_of_not_mem hNameFresh
                  have hRestAgree :
                      SourceVarsAgree names
                        (stateAfterValue.insert name value').vars
                        stateAfter.vars :=
                    ih
                      (ctx :=
                        { ctx with scope := name :: ctx.scope })
                      (ctxAfter := ctxAfter) (fuel := fuel)
                      (state := stateAfterValue.insert name value')
                      (stateAfter := stateAfter) hRest hRun
                  exact
                    SourceVarsAgree.trans
                      (SourceVarsAgree.trans hEvalAgree hInsertAgree)
                      hRestAgree
      | assign name value =>
          simp [SourceWritesDisjoint] at hPre
      | block body =>
          simp [SourceWritesDisjoint] at hPre
      | if_ cond body =>
          simp [SourceWritesDisjoint] at hPre
      | switch scrutinee cases defaultBody =>
          simp [SourceWritesDisjoint] at hPre
      | for_ init cond post body =>
          simp [SourceWritesDisjoint] at hPre
      | brk =>
          simp [SourceWritesDisjoint] at hPre
      | cont =>
          simp [SourceWritesDisjoint] at hPre
      | leave =>
          simp [SourceWritesDisjoint] at hPre
      | call targets functionName args =>
          have hTargetsFresh :
              ∀ target, target ∈ targets → target ∉ names := by
            simpa [SourceWritesDisjoint] using hPre.1
          have hRest : SourceWritesDisjoint names rest := by
            simpa [SourceWritesDisjoint] using hPre.2
          cases fuel with
          | zero =>
              simp [Functions.Source.Block.runOpen,
                Functions.Source.invalid, Structured.invalid] at hRun
          | succ fuel =>
              cases fuel with
              | zero =>
                  simp [Functions.Source.Block.runOpen,
                    Functions.Source.Stmt.run, Functions.Source.invalid,
                    Structured.invalid] at hRun
              | succ callFuel =>
                  by_cases hTargets : targets.Nodup
                  · simp [Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, hTargets] at hRun
                    cases hArgs :
                        Functions.Source.ArgList.eval prim args state with
                    | error err =>
                        simp [hArgs] at hRun
                    | ok argResult =>
                        rcases argResult with ⟨stateAfterArgs, argValues⟩
                        cases hFind :
                            Functions.FunList.find? functionName
                              program.functions with
                        | none =>
                            simp [hArgs, hFind, Functions.Source.invalid,
                              Structured.invalid] at hRun
                        | some fn =>
                            cases hBody :
                                Functions.Source.FunDef.runBody prim program
                                  fn argValues callFuel
                                  stateAfterArgs.shared with
                            | error err =>
                                simp [hArgs, hFind, hBody] at hRun
                            | ok callResult =>
                                cases callResult with
                                | halted kind haltedState =>
                                    simp [hArgs, hFind, hBody,
                                      Functions.Source.Outcome.halt,
                                      Locals.Source.Outcome.halt] at hRun
                                    cases hRun.1
                                | returned sharedAfterCall returnValues =>
                                    cases hAssign :
                                        Functions.Source.Store.assignMany
                                          targets returnValues
                                          stateAfterArgs.vars with
                                    | none =>
                                        simp [hArgs, hFind, hBody, hAssign,
                                          Functions.Source.invalid,
                                          Structured.invalid] at hRun
                                    | some returnStore =>
                                        simp [hArgs, hFind, hBody, hAssign,
                                          Functions.Source.Outcome.regular,
                                          Locals.Source.Outcome.regular]
                                          at hRun
                                        have hArgsAgree :
                                            SourceVarsAgree names state.vars
                                              stateAfterArgs.vars := by
                                          intro protectedName hMem
                                          have hVars :=
                                            sourceArgList_eval_vars_eq hArgs
                                          simpa [hVars]
                                        have hAssignAgree :
                                            SourceVarsAgree names
                                              stateAfterArgs.vars
                                              returnStore :=
                                          SourceVarsAgree.assignMany_of_not_mem
                                            hAssign hTargetsFresh
                                        have hRestAgree :
                                            SourceVarsAgree names returnStore
                                              stateAfter.vars :=
                                          ih (ctx := ctx)
                                            (ctxAfter := ctxAfter)
                                            (fuel := callFuel.succ)
                                            (state :=
                                              { shared := sharedAfterCall,
                                                vars := returnStore })
                                            (stateAfter := stateAfter)
                                            hRest hRun
                                        exact
                                          SourceVarsAgree.trans
                                            (SourceVarsAgree.trans
                                              hArgsAgree hAssignAgree)
                                            hRestAgree
                  · simp [Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, hTargets,
                      Functions.Source.invalid, Structured.invalid] at hRun
      | terminal kind =>
          simp [SourceWritesDisjoint] at hPre
      | terminalArgs kind args =>
          simp [SourceWritesDisjoint] at hPre

theorem compilerOpen_runOpen_doneInvariant_varsAgree_of_writes
    {names : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    ∀ {pre : List Functions.Stmt}
      {ctx : Functions.Source.Ctx} {state : Objects.Source.State}
      {fuel : Nat},
      SourceWritesDisjoint names pre →
      OpenResultDoneInvariant
        (fun doneResult =>
          ∀ {compilerAfterPre : Objects.Source.State}
            {ctxAfter : Functions.Source.Ctx},
            doneResult =
              .ok (Functions.Source.Outcome.regular compilerAfterPre,
                ctxAfter) →
              SourceVarsAgree names state.vars compilerAfterPre.vars)
        (CompilerOpen.FunctionsOpen.Block.runOpen prim program ctx fuel
          { stmts := pre } state) := by
  intro pre
  induction pre with
  | nil =>
      intro ctx state fuel _hWrites
      cases fuel with
      | zero =>
          simp [CompilerOpen.FunctionsOpen.Block.runOpen,
            CompilerOpen.invalid, Functions.Source.invalid,
            Structured.invalid]
          exact OpenResultDoneInvariant.done (by
            intro compilerAfterPre ctxAfter hDone
            cases hDone)
      | succ fuel =>
          rw [compilerOpen_block_runOpen_nil_succ]
          exact OpenResultDoneInvariant.done (by
            intro compilerAfterPre ctxAfter hDone
            cases hDone
            exact SourceVarsAgree.refl)
  | cons stmt rest ih =>
      intro ctx state fuel hWrites
      cases stmt with
      | expr expr =>
          simp [SourceWritesDisjoint] at hWrites
      | let_ name value =>
          have hNameFresh : name ∉ names := by
            simpa [SourceWritesDisjoint] using hWrites.1
          have hRestWrites : SourceWritesDisjoint names rest := by
            simpa [SourceWritesDisjoint] using hWrites.2
          cases fuel with
          | zero =>
              simp [CompilerOpen.FunctionsOpen.Block.runOpen,
                CompilerOpen.invalid, Functions.Source.invalid,
                Structured.invalid]
              exact OpenResultDoneInvariant.done (by
                intro compilerAfterPre ctxAfter hDone
                cases hDone)
          | succ fuel =>
              rw [compilerOpen_block_runOpen_cons_succ]
              have hStmtInv :
                  OpenResultDoneInvariant
                    (fun doneResult =>
                      ∀ {compilerAfterStmt : Objects.Source.State}
                        {ctxAfterStmt : Functions.Source.Ctx},
                        doneResult =
                          .ok
                            (Functions.Source.Outcome.regular compilerAfterStmt,
                              ctxAfterStmt) →
                        SourceVarsAgree names state.vars
                          compilerAfterStmt.vars)
                    (CompilerOpen.FunctionsOpen.Stmt.run prim program ctx fuel
                      (Functions.Stmt.let_ name value) state) := by
                simp [CompilerOpen.FunctionsOpen.Stmt.run]
                refine
                  OpenResultDoneInvariant.bind
                    (compilerOpen_localsExpr_evalOne_doneInvariant_varsAgree
                      (names := names) (prim := prim) value state)
                    ?_ ?_
                · intro exprResult hExprDone
                  rcases exprResult with ⟨stateAfterExpr, value'⟩
                  exact OpenResultDoneInvariant.done (by
                    intro compilerAfterStmt ctxAfterStmt hDone
                    cases hDone
                    exact
                      SourceVarsAgree.trans (hExprDone rfl)
                        (SourceVarsAgree.insert_of_not_mem hNameFresh))
                · intro err _hExprDone compilerAfterStmt ctxAfterStmt hDone
                  cases hDone
              refine OpenResultDoneInvariant.bind hStmtInv ?_ ?_
              · intro stmtResult hStmtDone
                rcases stmtResult with ⟨stmtOutcome, ctxAfterStmt⟩
                cases stmtOutcome with
                | mk compilerAfterStmt mode =>
                    cases mode with
                    | regular =>
                        refine
                          OpenResultDoneInvariant.imp
                            (ih (ctx := ctxAfterStmt)
                              (state := compilerAfterStmt) (fuel := fuel)
                              hRestWrites)
                            ?_
                        intro doneResult hRestDone compilerAfterPre ctxAfter
                          hDone
                        exact
                          SourceVarsAgree.trans (hStmtDone rfl)
                            (hRestDone hDone)
                    | brk =>
                        exact OpenResultDoneInvariant.done (by
                          intro compilerAfterPre ctxAfter hDone
                          cases hDone)
                    | cont =>
                        exact OpenResultDoneInvariant.done (by
                          intro compilerAfterPre ctxAfter hDone
                          cases hDone)
                    | leave =>
                        exact OpenResultDoneInvariant.done (by
                          intro compilerAfterPre ctxAfter hDone
                          cases hDone)
                    | halt kind =>
                        exact OpenResultDoneInvariant.done (by
                          intro compilerAfterPre ctxAfter hDone
                          cases hDone)
              · intro err _hStmtDone compilerAfterPre ctxAfter hDone
                cases hDone
      | assign name value =>
          simp [SourceWritesDisjoint] at hWrites
      | block body =>
          simp [SourceWritesDisjoint] at hWrites
      | if_ cond body =>
          simp [SourceWritesDisjoint] at hWrites
      | switch scrutinee cases defaultBody =>
          simp [SourceWritesDisjoint] at hWrites
      | for_ init cond post body =>
          simp [SourceWritesDisjoint] at hWrites
      | brk =>
          simp [SourceWritesDisjoint] at hWrites
      | cont =>
          simp [SourceWritesDisjoint] at hWrites
      | leave =>
          simp [SourceWritesDisjoint] at hWrites
      | call targets functionName args =>
          have hTargetsFresh :
              ∀ target, target ∈ targets → target ∉ names := by
            simpa [SourceWritesDisjoint] using hWrites.1
          have hRestWrites : SourceWritesDisjoint names rest := by
            simpa [SourceWritesDisjoint] using hWrites.2
          cases fuel with
          | zero =>
              simp [CompilerOpen.FunctionsOpen.Block.runOpen,
                CompilerOpen.invalid, Functions.Source.invalid,
                Structured.invalid]
              exact OpenResultDoneInvariant.done (by
                intro compilerAfterPre ctxAfter hDone
                cases hDone)
          | succ fuel =>
              rw [compilerOpen_block_runOpen_cons_succ]
              have hStmtInv :
                  OpenResultDoneInvariant
                    (fun doneResult =>
                      ∀ {compilerAfterStmt : Objects.Source.State}
                        {ctxAfterStmt : Functions.Source.Ctx},
                        doneResult =
                          .ok
                            (Functions.Source.Outcome.regular compilerAfterStmt,
                              ctxAfterStmt) →
                        SourceVarsAgree names state.vars
                          compilerAfterStmt.vars)
                    (CompilerOpen.FunctionsOpen.Stmt.run prim program ctx fuel
                      (Functions.Stmt.call targets functionName args) state) := by
                cases fuel with
                | zero =>
                    simp [CompilerOpen.FunctionsOpen.Stmt.run,
                      CompilerOpen.invalid, Functions.Source.invalid,
                      Structured.invalid]
