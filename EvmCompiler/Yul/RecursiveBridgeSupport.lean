end UserCallArity

/--
`Fresh.initial names` covers exactly the source-name set it is initialized
with.

This is the fresh-state invariant the full dispatcher bridge needs for source
locals: source declarations are not fresh temporaries, so block-tail proofs
after `let` need the generator to already know every source name that can
appear later in the contract.
-/
theorem freshCoversLayout_initial_self (names : List Name) :
    FreshCoversLayout names (Fresh.initial names) := by
  intro name hMem
  simpa [Fresh.initial] using hMem

/--
Any layout contained in a contract's collected source-name set is covered by
the actual fresh state used by `Contract.toObjects?`.
-/
theorem freshCoversLayout_of_subset_contractNames_initial
    (contract : AstContract) {layout : List Name}
    (hSubset : ∀ name, name ∈ layout → name ∈ Contract.names contract) :
    FreshCoversLayout layout (Fresh.initial (Contract.names contract)) := by
  intro name hMem
  exact freshCoversLayout_initial_self (Contract.names contract) name
    (hSubset name hMem)

/--
The dispatcher statement's collected source names are covered by the actual
contract-level fresh state used before dispatcher lowering.
-/
theorem freshCoversDispatcherNames_initial (contract : AstContract) :
    FreshCoversLayout (Stmt.names contract.dispatcher)
      (Fresh.initial (Contract.names contract)) := by
  apply freshCoversLayout_of_subset_contractNames_initial contract
  intro name hMem
  simp [Contract.names, hMem]

theorem freshCoversDispatcherNames_initial_rootLayout
    (contract : AstContract) :
    FreshCoversLayout
      (Stmt.names contract.dispatcher ++ Functions.Source.Ctx.initial.scope)
      (Fresh.initial (Contract.names contract)) := by
  simpa [Functions.Source.Ctx.initial] using
    freshCoversDispatcherNames_initial contract

/--
All source names collected from a syntax fragment have been reserved in the
fresh generator's hidden prefix.

This is deliberately separate from lexical scoping: lexical scoping says a
declaration is fresh for the visible source layout, while this predicate says
the compiler's fresh-name state was initialized with that future source name so
generated temporaries cannot collide with it before the declaration is reached.
-/
def SourceNamesReserved (reserved names : List Name) : Prop :=
  ∀ name, name ∈ names → name ∈ reserved

namespace SourceNamesReserved

theorem of_subset {reserved names₁ names₂ : List Name}
    (hSub : ∀ name, name ∈ names₁ → name ∈ names₂)
    (hReserved : SourceNamesReserved reserved names₂) :
    SourceNamesReserved reserved names₁ := by
  intro name hMem
  exact hReserved name (hSub name hMem)

theorem mono_reserved {reserved reserved' names : List Name}
    (hSub : ∀ name, name ∈ reserved → name ∈ reserved')
    (hReserved : SourceNamesReserved reserved names) :
    SourceNamesReserved reserved' names := by
  intro name hMem
  exact hSub name (hReserved name hMem)

theorem stmt_of_cons {reserved : List Name} {head : AstStmt}
    {rest : List AstStmt}
    (hReserved : SourceNamesReserved reserved (Stmt.List.names (head :: rest))) :
    SourceNamesReserved reserved (Stmt.names head) := by
  intro name hMem
  exact hReserved name (by simp [Stmt.List.names, hMem])

theorem tail_of_cons {reserved : List Name} {head : AstStmt}
    {rest : List AstStmt}
    (hReserved : SourceNamesReserved reserved (Stmt.List.names (head :: rest))) :
    SourceNamesReserved reserved (Stmt.List.names rest) := by
  intro name hMem
  exact hReserved name (by simp [Stmt.List.names, hMem])

theorem let_single {reserved : List Name} {name : EvmYul.Identifier}
    {value? : Option AstExpr}
    (hReserved : SourceNamesReserved reserved
      (Stmt.names (.Let [name] value?))) :
    identName name ∈ reserved := by
  cases value? <;>
    exact hReserved (identName name) (by simp [Stmt.names, identNames])

theorem switch_selected {reserved : List Name} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)} {defaultBody : List AstStmt}
    {value : Word}
    (hReserved :
      SourceNamesReserved reserved (Stmt.names (.Switch scrutinee cases defaultBody))) :
    SourceNamesReserved reserved
      (Stmt.List.names (EvmYul.Yul.selectSwitchCase value defaultBody cases)) := by
  induction cases with
  | nil =>
      intro name hMem
      exact hReserved name (by
        simp [Stmt.names]
        exact Or.inr (Or.inr hMem))
  | cons head rest ih =>
      rcases head with ⟨caseValue, body⟩
      intro name hMem
      by_cases hEq : caseValue = value
      · exact hReserved name (by
          subst caseValue
          have hBodyMem : name ∈ Stmt.List.names body := by
            simpa [EvmYul.Yul.selectSwitchCase] using hMem
          simp [Stmt.names]
          exact Or.inr (Or.inl (by
            simp [Stmt.CaseList.names, hBodyMem])))
      · have hRest :
            SourceNamesReserved reserved
              (Stmt.names (.Switch scrutinee rest defaultBody)) := by
          intro other hOther
          exact hReserved other (by
            simp [Stmt.names] at hOther ⊢
            rcases hOther with hExpr | hOther
            · exact Or.inl hExpr
            · rcases hOther with hCase | hDefault
              · exact Or.inr (Or.inl (by
                  simp [Stmt.CaseList.names, hCase]))
              · exact Or.inr (Or.inr hDefault))
        exact ih hRest name (by
          simpa [EvmYul.Yul.selectSwitchCase, hEq] using hMem)

theorem for_post {reserved : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (hReserved :
      SourceNamesReserved reserved (Stmt.names (.For cond post body))) :
    SourceNamesReserved reserved (Stmt.List.names post) := by
  intro name hMem
  exact hReserved name (by
    simp [Stmt.names]
    exact Or.inr (Or.inl hMem))

theorem for_body {reserved : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (hReserved :
      SourceNamesReserved reserved (Stmt.names (.For cond post body))) :
    SourceNamesReserved reserved (Stmt.List.names body) := by
  intro name hMem
  exact hReserved name (by
    simp [Stmt.names]
    exact Or.inr (Or.inr hMem))

theorem for_singleton {reserved : List Name} {cond : AstExpr}
    {post body : List AstStmt}
    (hReserved :
      SourceNamesReserved reserved (Stmt.names (.For cond post body))) :
    SourceNamesReserved reserved (Stmt.List.names [(.For cond post body)]) := by
  intro name hMem
  exact hReserved name (by
    simpa [Stmt.List.names] using hMem)

theorem of_append_left {reserved left right : List Name}
    (hReserved : SourceNamesReserved reserved (left ++ right)) :
    SourceNamesReserved reserved left := by
  intro name hMem
  exact hReserved name (by simp [hMem])

theorem of_append_right {reserved left right : List Name}
    (hReserved : SourceNamesReserved reserved (left ++ right)) :
    SourceNamesReserved reserved right := by
  intro name hMem
  exact hReserved name (by simp [hMem])

theorem weaken_append_left {reserved extra names : List Name}
    (hReserved : SourceNamesReserved reserved names) :
    SourceNamesReserved (extra ++ reserved) names := by
  intro name hMem
  exact List.mem_append.mpr (Or.inr (hReserved name hMem))

theorem weaken_append_right {reserved extra names : List Name}
    (hReserved : SourceNamesReserved reserved names) :
    SourceNamesReserved (reserved ++ extra) names := by
  intro name hMem
  exact List.mem_append.mpr (Or.inl (hReserved name hMem))

end SourceNamesReserved

theorem freshCoversLayout_append_right {front layout : List Name}
    {state : Fresh.State}
    (hCovers : FreshCoversLayout (front ++ layout) state) :
    FreshCoversLayout layout state := by
  intro name hMem
  exact hCovers name (by simp [hMem])

theorem freshCoversLayout_mem_left {front layout : List Name}
    {state : Fresh.State} {name : Name}
    (hCovers : FreshCoversLayout (front ++ layout) state)
    (hMem : name ∈ front) :
    name ∈ state.used := by
  exact hCovers name (by simp [hMem])

theorem freshCoversLayout_append_cons_of_mem {front layout : List Name}
    {state : Fresh.State} {name : Name}
    (hCovers : FreshCoversLayout (front ++ layout) state)
    (hMem : name ∈ front) :
    FreshCoversLayout (front ++ name :: layout) state := by
  apply freshCoversLayout_append_left
  · intro other hOther
    exact freshCoversLayout_mem_left hCovers hOther
  · exact freshCoversLayout_cons
      (freshCoversLayout_mem_left hCovers hMem)
      (freshCoversLayout_append_right hCovers)

theorem freshCoversLayout_append_reverse_append_of_reserved
    {reserved names layout : List Name} {state : Fresh.State}
    (hCovers : FreshCoversLayout (reserved ++ layout) state)
    (hReserved : SourceNamesReserved reserved names) :
    FreshCoversLayout (reserved ++ (names.reverse ++ layout)) state := by
  apply freshCoversLayout_append_left
  · intro name hMem
    exact freshCoversLayout_mem_left hCovers hMem
  · apply freshCoversLayout_append_left
    · intro name hMem
      exact
        freshCoversLayout_mem_left hCovers
          (hReserved name (by simpa using hMem))
    · exact freshCoversLayout_append_right hCovers

theorem toFunctionsListFuel?_let_user_call_eq_succ
    (fuel : Nat) (state : Fresh.State) (names : List EvmYul.Identifier)
    (functionName : Name) (args : List AstExpr) :
    Stmt.toFunctionsListFuel? fuel.succ state
        (.Let names (some (.Call (.inr functionName) args))) =
      match names with
      | [] =>
          if ObjectBuiltin.unsupported? functionName then
            none
          else do
            let (preArgs, lowerArgs, state') ←
              if Expr.List.directCallArgsSafe? args then do
                let lowerArgs ← Expr.List.toLocals1? args
                some ([], lowerArgs, state)
              else
                Expr.List.lowerBound1? state args
            some
              (preArgs ++ [Functions.Stmt.call [] functionName lowerArgs],
                state')
      | [name] =>
          if ObjectBuiltin.unsupported? functionName then
            none
          else
            let lowerNames := identNames [name]
            (do
              let (preArgs, lowerArgs, state') ←
                if Expr.List.directCallArgsSafe? args then do
                  let lowerArgs ← Expr.List.toLocals1? args
                  some ([], lowerArgs, state)
                else
                  Expr.List.lowerBound1? state args
              some
                (Stmt.initNames lowerNames ++ preArgs ++
                  [Functions.Stmt.call lowerNames functionName lowerArgs],
                  state'))
      | name :: next :: rest =>
          if ObjectBuiltin.unsupported? functionName then
            none
          else
            let lowerNames := identNames (name :: next :: rest)
            (do
              let (preArgs, lowerArgs, state') ←
                if Expr.List.directCallArgsSafe? args then do
                  let lowerArgs ← Expr.List.toLocals1? args
                  some ([], lowerArgs, state)
                else
                  Expr.List.lowerBound1? state args
              some
                (Stmt.initNames lowerNames ++ preArgs ++
                  [Functions.Stmt.call lowerNames functionName lowerArgs],
                  state')) := by
  cases names with
  | nil =>
      simp [Stmt.toFunctionsListFuel?]
  | cons name rest =>
      cases rest with
      | nil =>
          simp [Stmt.toFunctionsListFuel?]
      | cons next rest =>
          simp [Stmt.toFunctionsListFuel?]

theorem toFunctionsListFuel?_assign_user_call_eq_succ
    (fuel : Nat) (state : Fresh.State) (names : List EvmYul.Identifier)
    (functionName : Name) (args : List AstExpr) :
    Stmt.toFunctionsListFuel? fuel.succ state
        (.Assign names (.Call (.inr functionName) args)) =
      match names with
      | [] =>
          if ObjectBuiltin.unsupported? functionName then
            none
          else do
            let (preArgs, lowerArgs, state') ←
              if Expr.List.directCallArgsSafe? args then do
                let lowerArgs ← Expr.List.toLocals1? args
                some ([], lowerArgs, state)
              else
                Expr.List.lowerBound1? state args
            some (preArgs ++ [Functions.Stmt.call [] functionName lowerArgs],
              state')
      | [name] =>
          if ObjectBuiltin.unsupported? functionName then
            none
          else
            let lowerNames := identNames [name]
            (do
              let (preArgs, lowerArgs, state') ←
                if Expr.List.directCallArgsSafe? args then do
                  let lowerArgs ← Expr.List.toLocals1? args
                  some ([], lowerArgs, state)
                else
                  Expr.List.lowerBound1? state args
              some
                (preArgs ++ [Functions.Stmt.call lowerNames functionName lowerArgs],
                  state'))
      | name :: next :: rest =>
          if ObjectBuiltin.unsupported? functionName then
            none
          else
            let lowerNames := identNames (name :: next :: rest)
            (do
              let (preArgs, lowerArgs, state') ←
                if Expr.List.directCallArgsSafe? args then do
                  let lowerArgs ← Expr.List.toLocals1? args
                  some ([], lowerArgs, state)
                else
                  Expr.List.lowerBound1? state args
              some
                (preArgs ++ [Functions.Stmt.call lowerNames functionName lowerArgs],
                  state')) := by
  cases names with
  | nil =>
      simp [Stmt.toFunctionsListFuel?]
  | cons name rest =>
      cases rest with
      | nil =>
          simp [Stmt.toFunctionsListFuel?]
      | cons next rest =>
          simp [Stmt.toFunctionsListFuel?]

theorem toFunctionsListFuel?_expr_user_call_eq_succ
    (fuel : Nat) (state : Fresh.State)
    (functionName : Name) (args : List AstExpr) :
    Stmt.toFunctionsListFuel? fuel.succ state
        (.ExprStmtCall (.Call (.inr functionName) args)) =
      (if ObjectBuiltin.unsupported? functionName then
        none
      else
        (do
          let (preArgs, lowerArgs, state') ←
            if Expr.List.directCallArgsSafe? args then do
              let lowerArgs ← Expr.List.toLocals1? args
              some ([], lowerArgs, state)
            else
              Expr.List.lowerBound1? state args
          some
            (preArgs ++ [Functions.Stmt.call [] functionName lowerArgs],
              state'))) := by
  simp [Stmt.toFunctionsListFuel?]

theorem toFunctionsListFuel?_expr_user_call_components_succ
    {fuel : Nat} {state state' : Fresh.State}
    {functionName : Name} {args : List AstExpr}
    {lowerHead : List Functions.Stmt}
    (hName : ObjectBuiltin.unsupported? functionName = false)
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.ExprStmtCall (.Call (.inr functionName) args)) =
        some (lowerHead, state')) :
    ∃ pre : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
      ((Expr.List.directCallArgsSafe? args = true ∧
          Expr.List.toLocals1? args = some lowerArgs ∧
          pre = [] ∧ state' = state) ∨
        (Expr.List.directCallArgsSafe? args = false ∧
          Expr.List.lowerBound1? state args =
            some (pre, lowerArgs, state'))) ∧
      lowerHead =
        pre ++ [Functions.Stmt.call [] functionName lowerArgs] := by
  rw [toFunctionsListFuel?_expr_user_call_eq_succ] at hLower
  simp [hName] at hLower
  cases hDirect : Expr.List.directCallArgsSafe? args with
  | false =>
      cases hArgs : Expr.List.lowerBound1? state args with
      | none =>
          simp [hDirect, hArgs] at hLower
      | some lowered =>
          rcases lowered with ⟨pre, lowerArgs, stateAfterArgs⟩
          simp [hDirect, hArgs] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          refine ⟨pre, lowerArgs, ?_, ?_⟩
          · exact Or.inr ⟨rfl, rfl⟩
          · simpa [List.append_assoc] using hHead.symm
  | true =>
      cases hArgs : Expr.List.toLocals1? args with
      | none =>
          simp [hDirect, hArgs] at hLower
      | some lowerArgs =>
          simp [hDirect, hArgs] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          refine ⟨[], lowerArgs, ?_, ?_⟩
          · exact Or.inl ⟨rfl, rfl, rfl, rfl⟩
          · simpa [List.append_assoc] using hHead.symm

private theorem user_call_arg_lower_components_of_some
    {state state' : Fresh.State}
    {functionName : Name} {args : List AstExpr}
    {callPrefix : List Functions.Stmt} {targets : List Name}
    {lowerHead : List Functions.Stmt}
    (hLower :
      (do
        let (pre, lowerArgs, stateAfterArgs) ←
          if Expr.List.directCallArgsSafe? args then do
            let lowerArgs ← Expr.List.toLocals1? args
            some ([], lowerArgs, state)
          else
            Expr.List.lowerBound1? state args
        some
          (callPrefix ++ pre ++
            [Functions.Stmt.call targets functionName lowerArgs],
            stateAfterArgs)) =
        some (lowerHead, state')) :
    ∃ pre : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
      ((Expr.List.directCallArgsSafe? args = true ∧
          Expr.List.toLocals1? args = some lowerArgs ∧
          pre = [] ∧ state' = state) ∨
        (Expr.List.directCallArgsSafe? args = false ∧
          Expr.List.lowerBound1? state args =
            some (pre, lowerArgs, state'))) ∧
      lowerHead =
        callPrefix ++ pre ++
          [Functions.Stmt.call targets functionName lowerArgs] := by
  cases hDirect : Expr.List.directCallArgsSafe? args with
  | false =>
      cases hArgs : Expr.List.lowerBound1? state args with
      | none =>
          simp [hDirect, hArgs] at hLower
      | some lowered =>
          rcases lowered with ⟨pre, lowerArgs, stateAfterArgs⟩
          simp [hDirect, hArgs] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          refine ⟨pre, lowerArgs, ?_, ?_⟩
          · exact Or.inr ⟨rfl, rfl⟩
          · simpa [List.append_assoc] using hHead.symm
  | true =>
      cases hArgs : Expr.List.toLocals1? args with
      | none =>
          simp [hDirect, hArgs] at hLower
      | some lowerArgs =>
          simp [hDirect, hArgs] at hLower
          rcases hLower with ⟨hHead, hState⟩
          cases hState
          refine ⟨[], lowerArgs, ?_, ?_⟩
          · exact Or.inl ⟨rfl, rfl, rfl, rfl⟩
          · simpa [List.append_assoc] using hHead.symm

theorem toFunctionsListFuel?_assign_user_call_components_succ
    {fuel : Nat} {state state' : Fresh.State}
    {names : List EvmYul.Identifier}
    {functionName : Name} {args : List AstExpr}
    {lowerHead : List Functions.Stmt}
    (_hNames :
      names = [] ∨ (∃ name, names = [name]) ∨
        ∃ name next rest, names = name :: next :: rest)
    (hName : ObjectBuiltin.unsupported? functionName = false)
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.Assign names (.Call (.inr functionName) args)) =
        some (lowerHead, state')) :
    ∃ pre : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
      ((Expr.List.directCallArgsSafe? args = true ∧
          Expr.List.toLocals1? args = some lowerArgs ∧
          pre = [] ∧ state' = state) ∨
        (Expr.List.directCallArgsSafe? args = false ∧
          Expr.List.lowerBound1? state args =
            some (pre, lowerArgs, state'))) ∧
      lowerHead =
        pre ++
          [Functions.Stmt.call (identNames names) functionName lowerArgs] := by
  cases names with
  | nil =>
      rw [toFunctionsListFuel?_assign_user_call_eq_succ] at hLower
      simp [hName] at hLower
      rcases
          user_call_arg_lower_components_of_some
            (callPrefix := []) (targets := identNames ([] : List EvmYul.Identifier))
            hLower with
        ⟨pre, lowerArgs, hArgLower, hHead⟩
      exact ⟨pre, lowerArgs, hArgLower, by simpa using hHead⟩
  | cons name rest =>
      cases rest with
      | nil =>
          rw [toFunctionsListFuel?_assign_user_call_eq_succ] at hLower
          simp [hName] at hLower
          rcases
              user_call_arg_lower_components_of_some
                (callPrefix := []) (targets := identNames [name])
                hLower with
            ⟨pre, lowerArgs, hArgLower, hHead⟩
          exact ⟨pre, lowerArgs, hArgLower, by simpa using hHead⟩
      | cons next rest =>
          rw [toFunctionsListFuel?_assign_user_call_eq_succ] at hLower
          simp [hName] at hLower
          rcases
              user_call_arg_lower_components_of_some
                (callPrefix := [])
                (targets := identNames (name :: next :: rest))
                hLower with
            ⟨pre, lowerArgs, hArgLower, hHead⟩
          exact ⟨pre, lowerArgs, hArgLower, by simpa using hHead⟩

theorem toFunctionsListFuel?_let_user_call_components_succ
    {fuel : Nat} {state state' : Fresh.State}
    {names : List EvmYul.Identifier}
    {functionName : Name} {args : List AstExpr}
    {lowerHead : List Functions.Stmt}
    (_hNames :
      names = [] ∨ (∃ name, names = [name]) ∨
        ∃ name next rest, names = name :: next :: rest)
    (hName : ObjectBuiltin.unsupported? functionName = false)
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.Let names (some (.Call (.inr functionName) args))) =
        some (lowerHead, state')) :
    ∃ pre : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
      ((Expr.List.directCallArgsSafe? args = true ∧
          Expr.List.toLocals1? args = some lowerArgs ∧
          pre = [] ∧ state' = state) ∨
        (Expr.List.directCallArgsSafe? args = false ∧
          Expr.List.lowerBound1? state args =
            some (pre, lowerArgs, state'))) ∧
      lowerHead =
        Stmt.initNames (identNames names) ++ pre ++
          [Functions.Stmt.call (identNames names) functionName lowerArgs] := by
  cases names with
    | nil =>
        rw [toFunctionsListFuel?_let_user_call_eq_succ] at hLower
        simp [hName] at hLower
        have hLower' :
            (do
              let (pre, lowerArgs, stateAfterArgs) ←
                if Expr.List.directCallArgsSafe? args then do
                  let lowerArgs ← Expr.List.toLocals1? args
                  some ([], lowerArgs, state)
                else
                  Expr.List.lowerBound1? state args
              some
                (Stmt.initNames (identNames ([] : List EvmYul.Identifier)) ++
                  pre ++ [Functions.Stmt.call
                    (identNames ([] : List EvmYul.Identifier))
                    functionName lowerArgs],
                  stateAfterArgs)) =
            some (lowerHead, state') := by
          simpa using hLower
        rcases
            user_call_arg_lower_components_of_some
              (callPrefix := Stmt.initNames (identNames ([] : List EvmYul.Identifier)))
              (targets := identNames ([] : List EvmYul.Identifier))
              hLower' with
          ⟨pre, lowerArgs, hArgLower, hHead⟩
        exact ⟨pre, lowerArgs, hArgLower, by simpa using hHead⟩
    | cons name rest =>
        cases rest with
        | nil =>
            rw [toFunctionsListFuel?_let_user_call_eq_succ] at hLower
            simp [hName] at hLower
            have hLower' :
                (do
                  let (pre, lowerArgs, stateAfterArgs) ←
                    if Expr.List.directCallArgsSafe? args then do
                      let lowerArgs ← Expr.List.toLocals1? args
                      some ([], lowerArgs, state)
                    else
                      Expr.List.lowerBound1? state args
                  some
                    (Stmt.initNames (identNames [name]) ++
                      pre ++ [Functions.Stmt.call
                        (identNames [name]) functionName lowerArgs],
                      stateAfterArgs)) =
                some (lowerHead, state') := by
              simpa using hLower
            rcases
                user_call_arg_lower_components_of_some
                  (callPrefix := Stmt.initNames (identNames [name]))
                  (targets := identNames [name])
                  hLower' with
              ⟨pre, lowerArgs, hArgLower, hHead⟩
            exact ⟨pre, lowerArgs, hArgLower, by simpa using hHead⟩
        | cons next rest =>
            rw [toFunctionsListFuel?_let_user_call_eq_succ] at hLower
            simp [hName] at hLower
            have hLower' :
                (do
                  let (pre, lowerArgs, stateAfterArgs) ←
                    if Expr.List.directCallArgsSafe? args then do
                      let lowerArgs ← Expr.List.toLocals1? args
                      some ([], lowerArgs, state)
                    else
                      Expr.List.lowerBound1? state args
                  some
                    (Stmt.initNames
                      (identNames (name :: next :: rest)) ++
                      pre ++ [Functions.Stmt.call
                        (identNames (name :: next :: rest))
                        functionName lowerArgs],
                      stateAfterArgs)) =
                some (lowerHead, state') := by
              simpa using hLower
            rcases
                user_call_arg_lower_components_of_some
                  (callPrefix :=
                    Stmt.initNames (identNames (name :: next :: rest)))
                  (targets := identNames (name :: next :: rest))
                  hLower' with
              ⟨pre, lowerArgs, hArgLower, hHead⟩
            exact ⟨pre, lowerArgs, hArgLower, by simpa using hHead⟩

