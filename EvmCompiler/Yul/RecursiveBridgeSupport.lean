            (lowerPost := pieces.lowerPost) (lowerBody := pieces.lowerBody)
            (err := err) hCondTerminal hExact hEvalError hRelatable)
      (by
        intro shared sharedAfterCond store storeAfterCond compiler hExact
          hEvalZero
        exact
          sourceRegularStmtRunHiddenExact_for_generated_false_of_eval_domain_zero_hidden_scope
            (cfg := cfg) (layout := layout) (prim := prim)
            (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
            (cond := cond) (post := post) (body := body)
            (codeOverride := codeOverride) (shared := shared)
            (sharedAfterCond := sharedAfterCond) (store := store)
            (storeAfterCond := storeAfterCond) (compiler := compiler)
            (pre := pieces.preCond) (lowerCond := pieces.lowerCond)
            (lowerPost := pieces.lowerPost) (lowerBody := pieces.lowerBody)
            hScopeContains hPrim hCondSound hEvalDomain hExact hEvalZero)
      hBranches.bodyError
      hBranches.bodyBreak
      hBranches.bodyLeave
      hBranches.postError
      hBranches.postLeave
