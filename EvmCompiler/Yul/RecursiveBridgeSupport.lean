        have hNonzeroRaw : value ≠ ({ val := 0 } : Word) := by
          simpa using hNonzero
        rw [Imported.exec_if_succ]
        simp [hEval, hNonzeroRaw, hSourceBody]
      have hCompilerCondTrue :
