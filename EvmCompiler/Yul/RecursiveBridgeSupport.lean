/--
Names-aware exact bridge for `stop()`.

`stop` has no argument prelude, so it is more direct than the generic terminal
stack-prelude wrappers above. Low-fuel source runs are rejected by the
relatability filter; productive runs halt through the shared terminal
contract.
-/
theorem checkedStmtBlockLoweringSoundWhenFreshNamesAtExact_stop_call
    {cfg : StateRelConfig} {reserved layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hTerminal :
      ∀ {source compiler},
        SourceStateRel cfg layout source compiler →
        ∃ sharedAfter : EvmYul.SharedState .EVM,
          prim.terminal .stop compiler.shared [] = .ok sharedAfter ∧
          terminalRel .stop (EvmYul.UInt256.ofNat 0)
            (Imported.stopTerminalSourceState source)
            (compiler.withShared sharedAfter)) :
    CheckedStmtBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
      outcomeLayout terminalRel revertRel prim program ctx sourceFuel
      (.ExprStmtCall
        (.Call (.inl ((.StopArith .STOP : EvmYul.Operation .Yul))) []))
      codeOverride allowed := by
  intro freshState freshState' lowerStmts _hCovers hLower
  have hLowerShape :
      lowerStmts =
        [Functions.Stmt.terminalArgs .stop Locals.ExprSeq.nil] := by
    simp [Stmt.toFunctionsList?, Stmt.fuel, Stmt.toFunctionsListFuel?,
      Prim.terminal?, Expr.List.lowerBound1?, Expr.List.toStackSeq?,
      Expr.List.toSeq?, Assembly.HaltKind.argCount] at hLower
    exact hLower.1.symm
  subst lowerStmts
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.exec 0
              (.Block
                [.ExprStmtCall
                  (.Call
                    (.inl ((.StopArith .STOP : EvmYul.Operation .Yul)))
                    [])])
              codeOverride source =
            .error .OutOfFuel :=
        Imported.exec_zero
          (.Block
            [.ExprStmtCall
              (.Call
                (.inl ((.StopArith .STOP : EvmYul.Operation .Yul)))
                [])])
          codeOverride source
      rw [hZero] at hSource
      subst sourceResult
      exact False.elim
        (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
  | succ fuel =>
      cases fuel with
      | zero =>
          have hOne :
              EvmYul.Yul.exec 1
                  (.Block
                    [.ExprStmtCall
                      (.Call
                        (.inl
                          ((.StopArith .STOP : EvmYul.Operation .Yul)))
                        [])])
                  codeOverride source =
                .error .OutOfFuel := by
            simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]
          rw [hOne] at hSource
          subst sourceResult
          exact False.elim
            (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
      | succ fuel =>
          cases fuel with
          | zero =>
              have hTwo :
                  EvmYul.Yul.exec 2
                      (.Block
                        [.ExprStmtCall
                          (.Call
                            (.inl
                              ((.StopArith .STOP :
                                EvmYul.Operation .Yul)))
                            [])])
                      codeOverride source =
                    .error .OutOfFuel := by
                simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                  EvmYul.Yul.exec]
              rw [hTwo] at hSource
              subst sourceResult
              exact False.elim
                (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
          | succ fuel =>
              cases fuel with
              | zero =>
                  have hThree :
                      EvmYul.Yul.exec 3
                          (.Block
                            [.ExprStmtCall
                              (.Call
                                (.inl
                                  ((.StopArith .STOP :
                                    EvmYul.Operation .Yul)))
                                [])])
                          codeOverride source =
                        .error .OutOfFuel := by
                    simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                      EvmYul.Yul.evalArgs, EvmYul.Yul.reverse',
                      Imported.execPrimCall_error]
                  rw [hThree] at hSource
                  subst sourceResult
                  exact False.elim
                    (sourceResultRelatable_outOfFuel_false
                      (hAllowed hAllow))
              | succ fuel =>
                  cases hInitial with
                  | @ok shared store compiler hShared hVars _hDomain =>
                      rcases hTerminal (SourceStateRel.ok hShared hVars) with
                        ⟨sharedAfter, hTerminalRun, hTerminalRel⟩
                      refine
                        ⟨Functions.Source.Outcome.halt .stop
                            (compiler.withShared sharedAfter),
                          1, ?_, ?_⟩
                      · simp [Functions.Source.Block.runScoped,
                          Functions.Source.Block.runOpen,
                          Functions.Source.Stmt.run,
                          Locals.Source.Expr.ExprSeq.eval, hTerminalRun,
                          Locals.Source.State.withShared,
                          Functions.Source.Outcome.halt,
                          Locals.Source.Outcome.halt]
                      · rw [← hSource]
                        rw [Imported.exec_block_stop_succ_succ_succ_succ]
                        exact SourceResultOutcomeRel.yulHalt hTerminalRel

/--
Exact-domain soundness for a terminal-call head followed by an arbitrary tail.

The terminal head halts the source-level function block and the compiler-source
block, so the lowered tail is present only as checked code, not as executed
semantics. This is the terminal counterpart of the `break`/`continue`/`leave`
short-circuit wrappers above.
-/
theorem sourceResultBlockSoundWhenAtExact_cons_terminalStackPrelude_of_preludeRegular_general
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat}
    {yulPrim : EvmYul.Operation .Yul} {kind : Assembly.HaltKind}
    {sourceArgs : List AstExpr} {rest : List AstStmt}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {args : Locals.ExprSeq kind.argCount}
    {lowerTail : List Functions.Stmt}
    {allowed : Except Exception State → Prop}
    (hBridge :
      SourceArgStackPreludeRegular cfg layout prim program ctx argFuel
        sourceArgs codeOverride pre args)
    (hTerminal :
      ∀ {source compiler sourceResult},
        SourceStateRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel
            (.Block (.ExprStmtCall (.Call (.inl yulPrim) sourceArgs) ::
              rest))
            codeOverride source =
          sourceResult →
        ∃ sourceAfterArgs : State,
        ∃ sourceValues : List Word,
          EvmYul.Yul.evalArgs argFuel sourceArgs.reverse codeOverride source =
            .ok (sourceAfterArgs, sourceValues.reverse) ∧
          ∀ {compilerAfterArgs : Objects.Source.State},
            SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
              ∃ sharedAfter : EvmYul.SharedState .EVM,
                prim.terminal kind compilerAfterArgs.shared
                    sourceValues.reverse =
                  .ok sharedAfter ∧
                SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
                  sourceResult
                  (Functions.Source.Outcome.halt kind
                    (compilerAfterArgs.withShared sharedAfter))) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel
      (.ExprStmtCall (.Call (.inl yulPrim) sourceArgs) :: rest) codeOverride
      { stmts := pre ++ [Functions.Stmt.terminalArgs kind args] ++
          lowerTail } allowed := by
  refine ⟨hBridge.1, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  have hInitialRel : SourceStateRel cfg layout source compiler :=
    SourceStateExactRel.toRel hInitial
  rcases hTerminal hInitialRel hAllow hSource with
    ⟨sourceAfterArgs, sourceValues, hEvalArgs, hTerminalRel⟩
  have hTerminalExists :
      ∀ {compilerAfterArgs : Objects.Source.State},
        SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
          ∃ sharedAfter,
            prim.terminal kind compilerAfterArgs.shared sourceValues.reverse =
              .ok sharedAfter := by
    intro compilerAfterArgs hRelArgs
    rcases hTerminalRel hRelArgs with ⟨sharedAfter, hTerminalRun, _hRel⟩
    exact ⟨sharedAfter, hTerminalRun⟩
  rcases
      hBridge.run_terminalArgs_general hInitialRel hEvalArgs
        hTerminalExists with
    ⟨compilerAfterArgs, sharedAfter, ctxAfter, targetFuel, hTargetPrefix,
      hRelArgs, hTerminalRun⟩
  rcases hTerminalRel hRelArgs with
    ⟨sharedAfter', hTerminalRun', hOutcomeRel⟩
  have hSharedEq : sharedAfter = sharedAfter' := by
    rw [hTerminalRun] at hTerminalRun'
    injection hTerminalRun'
  cases hSharedEq
  let terminalOutcome : Objects.Source.Outcome :=
    Functions.Source.Outcome.halt kind
      (compilerAfterArgs.withShared sharedAfter)
  have hNonregular : terminalOutcome.mode ≠ Locals.Source.Mode.regular := by
    simp [terminalOutcome, Functions.Source.Outcome.halt,
      Locals.Source.Outcome.halt, Functions.Source.Outcome.regular,
      Locals.Source.Outcome.regular]
  rcases
      Functions.Source.Block.runOpen_append_nonregular_exists prim program
        (pre ++ [Functions.Stmt.terminalArgs kind args]) lowerTail ctx
        compiler terminalOutcome ctxAfter ⟨targetFuel, by
          simpa [terminalOutcome] using hTargetPrefix⟩ hNonregular with
    ⟨targetFuelWithTail, hTargetWithTail⟩
  have hTargetWithTail' :
      Functions.Source.Block.runOpen prim program ctx targetFuelWithTail
          { stmts := pre ++ Functions.Stmt.terminalArgs kind args ::
              lowerTail } compiler =
        .ok (terminalOutcome, ctxAfter) := by
    simpa [List.append_assoc] using hTargetWithTail
  refine ⟨terminalOutcome, targetFuelWithTail, ?_, hOutcomeRel⟩
  simp [Functions.Source.Block.runScoped, hTargetWithTail', terminalOutcome,
    Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]

