                  rcases freshResult with ⟨tmp, stateFresh⟩
                  simp [hFresh] at hLower
                  rcases hLower with ⟨hPreEq, hLowerEq, _hStateEq⟩
                  have hHeadLower1 :
                      Expr.lower1? stateTail head =
                        some (preHead, lowerHead, stateHead) := by
                    simpa [Expr.lower1?] using hHead
                  have hTailRegular :
                      SourceArgListPreludeRegularAt cfg layout prim program
                        ctx sourceFuel tail (some contract) preTail
                        lowerTail :=
                    ih (ctx := ctx) hCovers hTailSafe hTailScoped hTailOk
                      hTail
                  rcases Expr.List.lowerBound1?_lowerArgs_vars hTail with
                    ⟨lowerNames, hLowerTailVars⟩
                  have hTailNamesCover :
                      FreshCoversLayout lowerNames stateTail := by
                    exact
                      lowerBound1?_lowerArg_names_mem_final_used
                        hTail hLowerTailVars
                  have hHeadWrites :
                      SourceWritesDisjoint lowerNames preHead :=
                    lower1?_sourceWritesDisjoint hTailNamesCover hHeadLower1
                  have hTailNamesCoverHead :
                      FreshCoversLayout lowerNames stateHead :=
                    freshCoversLayout_lower1?_of_some
                      hTailNamesCover hHeadLower1
                  have hTmpFreshLower : tmp ∉ lowerNames := by
                    intro hMem
                    exact fresh?_name_not_mem_used hFresh
                      (hTailNamesCoverHead tmp hMem)
                  have hCoversHead :
                      FreshCoversLayout coverLayout stateHead :=
                    freshCoversLayout_lower1?_of_some
                      hCoversTail hHeadLower1
                  have hTmpFreshLayout : tmp ∉ layout := by
