                      Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, hBreak, compilerBreak,
                      Functions.Source.Outcome.brk, Locals.Source.Outcome.brk]
                  · rw [← hSource]
                    simp [Imported.exec_block_break_succ_succ_succ]
                    exact SourceResultOutcomeRel.ok
                      (SourceOkOutcomeRel.brk hRelBreak)

