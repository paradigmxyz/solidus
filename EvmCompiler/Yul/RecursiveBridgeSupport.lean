theorem params_returns_mem_functionList_names_of_find?
    {entries : List (Name × AstFunctionDefinition)}
    {functionName : Name} {params returns : List EvmYul.Identifier}
    {body : List AstStmt} {name : Name}
    (hFind :
      find? functionName entries = some (.Def params returns body))
    (hMem : name ∈ identNames returns ++ identNames params) :
    name ∈ FunctionList.names entries := by
  induction entries with
  | nil =>
      simp [find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      by_cases hEq : headName = functionName
      · simp [find?, hEq] at hFind
        subst headName
        subst headFn
        have hMemHead : name ∈ identNames params ++ identNames returns := by
          simpa [List.mem_append, or_comm, or_left_comm, or_assoc] using hMem
        rw [List.mem_append] at hMemHead
        rcases hMemHead with hParam | hReturn
        · simp [FunctionList.names, FunctionDefinition.names, hParam]
        · simp [FunctionList.names, FunctionDefinition.names, hReturn]
      · simp [find?, hEq] at hFind
        have hRest : name ∈ FunctionList.names rest := ih hFind
        simp [FunctionList.names, hRest]

theorem params_returns_mem_contract_names_of_lookup
    {contract : AstContract} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {name : Name}
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns body))
    (hMem : name ∈ identNames returns ++ identNames params) :
    name ∈ Contract.names contract := by
  have hFind :
      find? functionName (Contract.functionEntries contract) =
        some (.Def params returns body) :=
    find?_contract_functionEntries_of_lookup contract hLookup
  have hFunctionNames :
      name ∈ FunctionList.names (Contract.functionEntries contract) :=
    params_returns_mem_functionList_names_of_find? hFind hMem
  simp [Contract.names, hFunctionNames]

theorem body_names_mem_functionList_names_of_find?
    {entries : List (Name × AstFunctionDefinition)}
    {functionName : Name} {params returns : List EvmYul.Identifier}
    {body : List AstStmt} {name : Name}
    (hFind :
      find? functionName entries = some (.Def params returns body))
    (hMem : name ∈ Stmt.List.names body) :
    name ∈ FunctionList.names entries := by
  induction entries with
  | nil =>
      simp [find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      by_cases hEq : headName = functionName
      · simp [find?, hEq] at hFind
        subst headName
        subst headFn
        simp [FunctionList.names, FunctionDefinition.names, hMem,
          List.mem_append]
      · simp [find?, hEq] at hFind
        have hRest : name ∈ FunctionList.names rest := ih hFind
        simp [FunctionList.names, hRest]

theorem body_names_mem_contract_names_of_lookup
    {contract : AstContract} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    {name : Name}
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns body))
    (hMem : name ∈ Stmt.List.names body) :
    name ∈ Contract.names contract := by
  have hFind :
      find? functionName (Contract.functionEntries contract) =
        some (.Def params returns body) :=
    find?_contract_functionEntries_of_lookup contract hLookup
  have hFunctionNames :
      name ∈ FunctionList.names (Contract.functionEntries contract) :=
    body_names_mem_functionList_names_of_find? hFind hMem
  simp [Contract.names, hFunctionNames]

theorem sourceNamesReserved_contract_body_of_lookup
    {contract : AstContract} {functionName : Name}
    {params returns : List EvmYul.Identifier} {body : List AstStmt}
    (hLookup :
      contract.functions.lookup functionName =
        some (.Def params returns body)) :
    SourceNamesReserved (Contract.names contract) (Stmt.List.names body) := by
  intro name hMem
  exact body_names_mem_contract_names_of_lookup hLookup hMem

theorem toFunDefsFuel?_find?_some_with_fresh
    {coverLayout : List Name} {fuel : Nat} {state state' : Fresh.State}
    {entries : List (Name × AstFunctionDefinition)}
    {functions : List Functions.FunDef}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hCovers : FreshCoversLayout coverLayout state)
    (hLower :
      FunctionList.toFunDefsFuel? fuel state entries =
        some (functions, state'))
    (hFind : find? functionName entries = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlockFuel? fuel freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns ∧
        FreshCoversLayout coverLayout freshBefore := by
  induction entries generalizing state state' functions with
  | nil =>
      simp [find?] at hFind
  | cons entry rest ih =>
      rcases entry with ⟨headName, headFn⟩
      cases hHead :
          FunctionDefinition.toFunDefFuel? fuel state headName headFn with
      | none =>
          simp [FunctionList.toFunDefsFuel?, hHead] at hLower
      | some headRes =>
          rcases headRes with ⟨lowerHead, stateAfterHead⟩
          have hCoversHead :
              FreshCoversLayout coverLayout stateAfterHead :=
            freshCoversLayout_toFunDefFuel?_of_some hCovers hHead
          cases hRest :
              FunctionList.toFunDefsFuel? fuel stateAfterHead rest with
          | none =>
              simp [FunctionList.toFunDefsFuel?, hHead, hRest] at hLower
          | some restRes =>
              rcases restRes with ⟨lowerRest, stateAfterRest⟩
              simp [FunctionList.toFunDefsFuel?, hHead, hRest] at hLower
              rcases hLower with ⟨hFunctions, hState'⟩
              subst functions
              subst state'
              have hLowerHeadName : lowerHead.name = headName :=
                toFunDefsFuel?_head_name hHead
              by_cases hEq : headName = functionName
              · have hFindHead : headFn = fn := by
                  simpa [find?, hEq] using hFind
                subst fn
                subst functionName
                cases headFn with
                | Def params returns body =>
                    cases hBody :
                        Stmt.List.toBlockFuel? fuel state body with
                    | none =>
                        simp [FunctionDefinition.toFunDefFuel?, hBody]
                          at hHead
                    | some bodyRes =>
                        rcases bodyRes with ⟨lowerBody, stateAfterBody⟩
                        simp [FunctionDefinition.toFunDefFuel?, hBody]
                          at hHead
                        rcases hHead with ⟨hLowerHead, _hStateAfterHead⟩
                        refine
                          ⟨lowerHead, ?_, params, returns, body, state,
                            stateAfterBody, rfl, ?_, ?_, ?_, ?_, hCovers⟩
                        · simp [Functions.Source.FunList.find?,
                            hLowerHeadName]
                        · simpa [← hLowerHead] using hBody
                        · simpa [← hLowerHead]
                        · simpa [← hLowerHead]
                        · simpa [← hLowerHead]
              · simp [find?, hEq] at hFind
                rcases ih hCoversHead hRest hFind with
                  ⟨lowerFn, hLowerFind, params, returns, body, freshBefore,
                    freshAfter, hFn, hBody, hName, hParams, hReturns,
                    hFreshBefore⟩
                refine
                  ⟨lowerFn, ?_, params, returns, body, freshBefore,
                    freshAfter, hFn, hBody, hName, hParams, hReturns,
                    hFreshBefore⟩
                simpa [Functions.Source.FunList.find?, hLowerHeadName, hEq]
                  using hLowerFind

theorem toFunDefs?_find?_of_contract_lookup_toBlock?_fresh
    {contract : AstContract} {state state' : Fresh.State}
    {functions : List Functions.FunDef}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hCovers : FreshCoversLayout (Contract.names contract) state)
    (hLower :
      FunctionList.toFunDefs? state (Contract.functionEntries contract) =
        some (functions, state'))
    (hLookup : contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns ∧
        FreshCoversLayout (lowerFn.returns ++ lowerFn.params)
          freshBefore := by
  have hEntryFind :
      find? functionName (Contract.functionEntries contract) = some fn :=
    find?_contract_functionEntries_of_lookup contract hLookup
  rcases
      toFunDefsFuel?_find?_some_with_fresh
        (coverLayout := Contract.names contract)
        (fuel := FunctionList.fuel (Contract.functionEntries contract))
        (state := state) (state' := state')
        (entries := Contract.functionEntries contract)
        (functions := functions) (functionName := functionName) (fn := fn)
        hCovers (by simpa [FunctionList.toFunDefs?] using hLower)
        hEntryFind with
    ⟨lowerFn, hLowerFind, params, returns, body, freshBefore, freshAfter,
      hFn, hBody, hName, hParams, hReturns, hFreshContract⟩
  have hBodyFuel :
      Stmt.List.fuel body ≤
        FunctionList.fuel (Contract.functionEntries contract) := by
    subst fn
    exact body_fuel_le_functionList_fuel_of_find? hEntryFind
  have hStable :
      Stmt.List.toBlockFuel?
          (FunctionList.fuel (Contract.functionEntries contract))
          freshBefore body =
        Stmt.List.toBlock? freshBefore body :=
    LoweringFuel.list_toBlockFuel?_toBlock? body hBodyFuel
  rw [hStable] at hBody
  have hLookupDef :
      contract.functions.lookup functionName =
        some (.Def params returns body) := by
    simpa [hFn] using hLookup
  have hFreshParamsReturns :
      FreshCoversLayout (lowerFn.returns ++ lowerFn.params)
        freshBefore := by
    intro name hMem
    have hMemIdent : name ∈ identNames returns ++ identNames params := by
      simpa [hReturns, hParams] using hMem
    exact hFreshContract name
      (params_returns_mem_contract_names_of_lookup hLookupDef hMemIdent)
  exact
    ⟨lowerFn, hLowerFind, params, returns, body, freshBefore, freshAfter,
      hFn, hBody, hName, hParams, hReturns, hFreshParamsReturns⟩

theorem toFunDefs?_find?_of_contract_lookup_toBlock?_fresh_contract
    {contract : AstContract} {state state' : Fresh.State}
    {functions : List Functions.FunDef}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hCovers : FreshCoversLayout (Contract.names contract) state)
    (hLower :
      FunctionList.toFunDefs? state (Contract.functionEntries contract) =
        some (functions, state'))
    (hLookup : contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns ∧
        FreshCoversLayout (Contract.names contract) freshBefore := by
  have hEntryFind :
      find? functionName (Contract.functionEntries contract) = some fn :=
    find?_contract_functionEntries_of_lookup contract hLookup
  rcases
      toFunDefsFuel?_find?_some_with_fresh
        (coverLayout := Contract.names contract)
        (fuel := FunctionList.fuel (Contract.functionEntries contract))
        (state := state) (state' := state')
        (entries := Contract.functionEntries contract)
        (functions := functions) (functionName := functionName) (fn := fn)
        hCovers (by simpa [FunctionList.toFunDefs?] using hLower)
        hEntryFind with
    ⟨lowerFn, hLowerFind, params, returns, body, freshBefore, freshAfter,
      hFn, hBody, hName, hParams, hReturns, hFreshContract⟩
  have hBodyFuel :
      Stmt.List.fuel body ≤
        FunctionList.fuel (Contract.functionEntries contract) := by
    subst fn
    exact body_fuel_le_functionList_fuel_of_find? hEntryFind
  have hStable :
      Stmt.List.toBlockFuel?
          (FunctionList.fuel (Contract.functionEntries contract))
          freshBefore body =
        Stmt.List.toBlock? freshBefore body :=
    LoweringFuel.list_toBlockFuel?_toBlock? body hBodyFuel
  rw [hStable] at hBody
  exact
    ⟨lowerFn, hLowerFind, params, returns, body, freshBefore, freshAfter,
      hFn, hBody, hName, hParams, hReturns, hFreshContract⟩

theorem toObjects?_find?_of_contract_lookup_toBlock?_fresh
    {program : Program} {functionProgram : Functions.Program}
    {functionName : Name} {fn : AstFunctionDefinition}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hLookup : program.contract.functions.lookup functionName = some fn) :
    ∃ lowerFn : Functions.FunDef,
      Functions.Source.FunList.find? functionName
          functionProgram.functions = some lowerFn ∧
      ∃ params returns body freshBefore freshAfter,
        fn = .Def params returns body ∧
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) ∧
        lowerFn.name = functionName ∧
        lowerFn.params = identNames params ∧
        lowerFn.returns = identNames returns ∧
        FreshCoversLayout (lowerFn.returns ++ lowerFn.params)
          freshBefore := by
  rcases
      Reference.BridgeFacts.toObjects?_root_components
        (program := program) (functionProgram := functionProgram)
        hToObjects with
    ⟨_bodyStmts, state, functions, state', hBody, hFunctions, hProgram⟩
  cases hProgram
  have hInitialCovers :
      FreshCoversLayout (Contract.names program.contract)
        (Fresh.initial (Contract.names program.contract)) :=
    freshCoversLayout_initial_self (Contract.names program.contract)
  have hDispatcherCovers :
      FreshCoversLayout (Contract.names program.contract) state :=
    freshCoversLayout_toFunctionsListFuel?_of_some
      (fuel := Stmt.fuel program.contract.dispatcher)
      hInitialCovers
      (by simpa [Stmt.toFunctionsList?] using hBody)
  exact
    toFunDefs?_find?_of_contract_lookup_toBlock?_fresh
      (contract := program.contract) (state := state) (state' := state')
      (functions := functions) (functionName := functionName) (fn := fn)
      hDispatcherCovers hFunctions hLookup

