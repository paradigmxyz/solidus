    {pre : List Functions.Stmt} {results : Nat}
    {lower : Locals.Expr results} {targetFuel : Nat}
    {callResponseRel : SourceExprRawPreludeOpenCallResponseRel}
    {createResponseRel : SourceExprRawPreludeOpenCreateResponseRel}
    (hSound :
