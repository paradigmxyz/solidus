theorem reviveJump
    {layout : List Name} {state : State}
    (hState : StateStoreContains layout state) :
    StateStoreContains layout (EvmYul.Yul.State.reviveJump state) := by
  cases state with
  | Ok shared store =>
      simpa [StateStoreContains, EvmYul.Yul.State.reviveJump] using hState
  | OutOfFuel =>
      simp [StateStoreContains, EvmYul.Yul.State.reviveJump]
  | Checkpoint jump =>
      cases jump <;>
        simpa [StateStoreContains, EvmYul.Yul.State.reviveJump,
          EvmYul.Yul.State.revive] using hState

