    {store storeAfter : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    (hSafeBody : Safe.stmts body)
    (hBlock :
      SourceResultBlockSoundWhenAtExactHiddenScope cfg layout layout
        terminalRel revertRel prim program ctx sourceFuel.succ body
        codeOverride lowerBody
        (fun result =>
          result = (.ok (.Ok sharedAfter storeAfter : State) :
            Except Exception State)))
    (hInitial :
      SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hSource :
      EvmYul.Yul.exec sourceFuel.succ (.Block body) codeOverride
        (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter)) :
    SourceRegularStmtRunHiddenExact cfg layout layout prim program ctx
      sourceFuel.succ (.Block body) codeOverride (.Ok shared store)
      compiler { stmts := [Functions.Stmt.block lowerBody] } := by
  have hEntryDomain : StoreDomainExact layout store :=
    SourceStateExactRel.domain hInitial
  have hSeqContains :
      SourceResultStoreContains layout
        (EvmYul.Yul.execSeq sourceFuel body codeOverride
          (.Ok shared store)) :=
    SourceResultStoreContains.execSeq_ok_of_safe_primitiveFamilies
      (layout := layout) (fuel := sourceFuel) (stmts := body)
      (codeOverride := codeOverride) (shared := shared) (store := store)
      hSafeBody (StoreDomainContains.of_exact hEntryDomain)
  have hDomainAfter : StoreDomainExact layout storeAfter :=
    exec_block_ok_domain_exact_of_execSeq_contains
      (layout := layout) (fuel := sourceFuel) (stmts := body)
      (codeOverride := codeOverride) (shared := shared) (store := store)
      (sharedAfter := sharedAfter) (storeAfter := storeAfter)
      hEntryDomain hSeqContains hSource
  rcases hBlock hInitial rfl hSource with
    ⟨sourceOutcome, targetFuel, hTargetScoped, hOutcomeRel⟩
  cases hOutcomeRel with
  | ok hOk =>
      cases hOk with
      | regular hRel =>
          rcases
              singletonBlockStmtRunOpen_of_runScoped
                (prim := prim) (program := program) (ctx := ctx)
                (block := lowerBody) (fuel := targetFuel)
                (state := compiler) hTargetScoped with
            ⟨targetFuel', ctxAfter, hTargetOpen⟩
          exact
            ⟨.Ok sharedAfter storeAfter, _, ctxAfter, targetFuel',
              hSource, by simpa using hTargetOpen, (fun _ hMem => hMem),
              SourceStateExactRel.ofRelDomain hRel hDomainAfter⟩

