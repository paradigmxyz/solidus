      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult sourceOutcome := by
  cases hRel with
  | ok hOk =>
      cases hOk with
      | regular hState =>
          cases hState with
          | ok hShared hVars =>
              have hSubset :
                  ∀ name : Name, name ∈ outcomeLayout → name ∈ layout := by
                simpa [SourceResultOutcomeLayoutSupported] using hSupported
