/--
Simple source-visible heads for the hidden-context sequence dispatcher.

Generated control/primitive/user-call heads are handled by separate wrappers;
this predicate carves out the first accepted dispatcher slice where the
source-visible layout either stays fixed or changes only by one declaration.
-/
inductive SimpleHiddenSeqHead : AstStmt → Prop where
  | brk : SimpleHiddenSeqHead .Break
  | cont : SimpleHiddenSeqHead .Continue
  | leave : SimpleHiddenSeqHead .Leave
  | assign_lit (name : EvmYul.Identifier) (value : Word) :
      SimpleHiddenSeqHead (.Assign [name] (.Lit value))
  | assign_var (name sourceName : EvmYul.Identifier) :
      SimpleHiddenSeqHead (.Assign [name] (.Var sourceName))
  | let_none (name : EvmYul.Identifier) :
      SimpleHiddenSeqHead (.Let [name] none)
  | let_lit (name : EvmYul.Identifier) (value : Word) :
      SimpleHiddenSeqHead (.Let [name] (some (.Lit value)))
  | let_var (name sourceName : EvmYul.Identifier) :
      SimpleHiddenSeqHead (.Let [name] (some (.Var sourceName)))

