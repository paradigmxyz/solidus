/--
Exact-domain base case for the bounded recursive bridge.

At fuel zero the imported interpreter returns `State.OutOfFuel`, which the successful
run filter excludes from `SourceResultRelatable`; the exact-domain state
invariant is therefore never inspected.
-/
theorem recursiveSourceBridgeWhenUpToAtExact_zero
    {cfg : StateRelConfig}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    RecursiveSourceBridgeWhenUpToAtExact cfg terminalRel revertRel prim
      program 0 := by
  refine ⟨?_, ?_⟩
  · intro layout outcomeLayout ctx sourceFuel sourceStmt codeOverride allowed
      hAllowed hFuel hScope
    have hFuelEq : sourceFuel = 0 := Nat.le_zero.mp hFuel
    subst hFuelEq
    intro freshState freshState' lowerStmts _hCovers _hLower
    refine ⟨hScope, ?_⟩
    intro source compiler sourceResult _hInitial hAllow hSource
    have hZero :
        EvmYul.Yul.exec 0 (.Block [sourceStmt]) codeOverride source =
          .error .OutOfFuel :=
      Imported.exec_zero (.Block [sourceStmt]) codeOverride source
    rw [hZero] at hSource
    subst sourceResult
    exact False.elim (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
  · intro layout outcomeLayout ctx sourceFuel sourceStmts codeOverride allowed
      hAllowed hFuel hScope
    have hFuelEq : sourceFuel = 0 := Nat.le_zero.mp hFuel
    subst hFuelEq
    intro freshState freshState' lowerBlock _hCovers _hLower
    refine ⟨hScope, ?_⟩
    intro source compiler sourceResult _hInitial hAllow hSource
    have hZero :
        EvmYul.Yul.exec 0 (.Block sourceStmts) codeOverride source =
          .error .OutOfFuel :=
      Imported.exec_zero (.Block sourceStmts) codeOverride source
    rw [hZero] at hSource
    subst sourceResult
    exact False.elim (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))

