/--
Run-filtered block soundness for a user-function call whose callee terminates.

The argument prelude is compiler-only and runs regularly.  The call itself is
supplied by `hCall`: in the full recursive proof, that continuation is where
the smaller-fuel induction hypothesis proves the callee body and returns the
terminal source/target outcome relation.  This theorem only performs the
compositional plumbing around that call.
-/
theorem sourceResultBlockSoundWhenAt_call_user_terminal_prelude_regular
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat} {sourceStmts : List AstStmt}
    {args : List AstExpr} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {targets : List Name} {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {allowed : Except Exception State → Prop}
    (hScope : ctx.scope = layout)
    (hArgs :
      SourceArgListPreludeRegularAt cfg layout prim program ctx argFuel args
        codeOverride pre lowerArgs)
    (hCall :
      ∀ {source compiler sourceResult},
        SourceStateRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
          sourceResult →
        ∃ sourceAfterArgs : State,
        ∃ argValues : List Word,
          EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
            .ok (sourceAfterArgs, argValues.reverse) ∧
          ∀ {compilerAfterPre compilerAfterArgs : Objects.Source.State}
            {ctxAfterPre : Functions.Source.Ctx} {preFuel : Nat},
            Functions.Source.Block.runOpen prim program ctx preFuel
                { stmts := pre } compiler =
              .ok
                (Functions.Source.Outcome.regular compilerAfterPre,
                  ctxAfterPre) →
            Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
              .ok (compilerAfterArgs, argValues) →
            SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
            ∃ kind : Assembly.HaltKind,
            ∃ compilerAfterCall : Objects.Source.State,
            ∃ ctxAfterCall : Functions.Source.Ctx,
            ∃ callFuel : Nat,
              Functions.Source.Block.runOpen prim program ctxAfterPre callFuel
                  { stmts :=
                      [Functions.Stmt.call targets functionName lowerArgs] }
                  compilerAfterPre =
                .ok
                  (Functions.Source.Outcome.halt kind compilerAfterCall,
                    ctxAfterCall) ∧
              SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
                sourceResult
                (Functions.Source.Outcome.halt kind compilerAfterCall)) :
    SourceResultBlockSoundWhenAt cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel sourceStmts codeOverride
      { stmts := pre ++
          [Functions.Stmt.call targets functionName lowerArgs] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  rcases hCall hInitial hAllow hSource with
    ⟨sourceAfterArgs, argValues, hArgEval, hCallAfterArgs⟩
  rcases hArgs.2 hInitial hArgEval with
    ⟨compilerAfterPre, compilerAfterArgs, ctxAfterPre, preFuel, hPreRun,
      hArgsRun, hRelArgs⟩
  rcases hCallAfterArgs hPreRun hArgsRun hRelArgs with
    ⟨kind, compilerAfterCall, ctxAfterCall, callFuel, hCallRun,
      hOutcomeRel⟩
  rcases
      Functions.Source.Block.runOpen_append_regular_exists prim program
        pre [Functions.Stmt.call targets functionName lowerArgs]
        ctx ctxAfterPre compiler compilerAfterPre
        (Functions.Source.Outcome.halt kind compilerAfterCall)
        ctxAfterCall ⟨preFuel, hPreRun⟩ ⟨callFuel, hCallRun⟩ with
    ⟨targetFuel, hTargetOpen⟩
  refine
    ⟨Functions.Source.Outcome.halt kind compilerAfterCall, targetFuel, ?_,
      hOutcomeRel⟩
  simp [Functions.Source.Block.runScoped, hTargetOpen,
    Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]

/--
Run-filtered block soundness for a user-function call after a regular
compiler-only argument prelude, where the call continuation already accounts
for the `runScoped` cleanup of regular outcomes.

The continuation is allowed to return either a regular source call result or a
terminal halt.  For regular outcomes it must relate the imported result to the
state after restricting back to the current source scope, matching
`Functions.Source.Block.runScoped`.
-/
theorem sourceResultBlockSoundWhenAt_call_user_actual_prelude_regular
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat} {sourceStmts : List AstStmt}
    {args : List AstExpr} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {targets : List Name} {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {allowed : Except Exception State → Prop}
    (hScope : ctx.scope = layout)
    (hArgs :
      SourceArgListPreludeRegularAt cfg layout prim program ctx argFuel args
