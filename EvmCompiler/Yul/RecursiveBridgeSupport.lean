    EvmYul.Yul.exec fuel.succ.succ.succ.succ
        (.Block [.Let [name] (some (.Lit value))]) codeOverride
        (.Ok shared store) =
      .ok (.Ok shared store) := by
  have hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok () :=
    checkDeclaration_ok_singleton (shared := shared) hFresh
  have hHead :
      EvmYul.Yul.exec fuel.succ.succ
          (.Let [name] (some (.Lit value))) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) :=
    BridgeFacts.exec_let_lit_single_ok fuel name value codeOverride shared
      store hCheck
  rw [Imported.exec_block_cons_succ]
  rw [Imported.execSeq_cons_ok_result_succ
    (hHead := hHead)
    (hTail :=
      Imported.execSeq_nil_succ fuel.succ codeOverride
        (.Ok shared (store.insert (identName name) value) : State))]
  simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store]
  rw [restrictVarStore_insert_fresh_to_self store (identName name) value
    hFresh]

