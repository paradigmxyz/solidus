/--
Relation-aware variant of
`sourceResultBlockSoundWhenAtExact_block_same_of_inner`.

This is the shape consumed by the recursive bridge induction: the inner block
theorem may ask each `allowedInner` predicate to prove its accepted imported
results are source-relatable.  The wrapper constructs exactly that predicate
for the single inner run induced by the surrounding block.
-/
theorem sourceResultBlockSoundWhenAtExact_block_same_of_inner_when
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {innerFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hInner :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        SourceResultBlockSoundWhenAtExact cfg layout layout terminalRel
          revertRel prim program ctx innerFuel body codeOverride lowerBody
          allowedInner) :
    SourceResultBlockSoundWhenAtExact cfg layout layout terminalRel revertRel
      prim program ctx innerFuel.succ.succ [.Block body] codeOverride
      { stmts := [Functions.Stmt.block lowerBody] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared scope compiler hShared hVars hDomain =>
      let innerResult : Except Exception State :=
        EvmYul.Yul.exec innerFuel (.Block body) codeOverride
          (.Ok shared scope : State)
      let wrap : Except Exception State → Except Exception State :=
        fun result =>
          match result with
          | .ok state => .ok (state.restrictStoreTo scope)
          | .error err => .error err
      have hOuter :
          EvmYul.Yul.exec innerFuel.succ.succ (.Block [.Block body])
              codeOverride (.Ok shared scope : State) =
            wrap innerResult := by
        unfold innerResult
        cases hExec :
            EvmYul.Yul.exec innerFuel (.Block body) codeOverride
              (.Ok shared scope : State) with
        | error err =>
            simp [wrap, EvmYul.Yul.exec, EvmYul.Yul.execSeq, hExec]
        | ok state =>
            cases innerFuel with
            | zero =>
                have hZero :
                    EvmYul.Yul.exec 0 (.Block body) codeOverride
                        (.Ok shared scope : State) =
                      .error .OutOfFuel :=
                  Imported.exec_zero (.Block body) codeOverride
                    (.Ok shared scope : State)
                rw [hZero] at hExec
                cases hExec
            | succ fuel =>
                cases state <;>
                  simp [wrap, EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                    EvmYul.Yul.State.store, hExec]
      have hWrapEq : wrap innerResult = sourceResult := by
        simpa [hOuter] using hSource
      let allowedInner : Except Exception State → Prop :=
        fun result => allowed (wrap result)
      have hAllowedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultRelatable sourceResult := by
        intro sourceResult hAllowInner
        have hWrapped :
            SourceResultRelatable (wrap sourceResult) :=
          hAllowed hAllowInner
        cases sourceResult with
        | ok source =>
            cases source <;> simpa [wrap, SourceResultRelatable] using hWrapped
        | error err =>
            simpa [wrap] using hWrapped
      have hAllowInner : allowedInner innerResult := by
        change allowed (wrap innerResult)
        simpa [hWrapEq] using hAllow
      rcases (hInner (allowedInner := allowedInner) hAllowedInner).2
          (source := (.Ok shared scope : State)) (compiler := compiler)
          (sourceResult := innerResult)
          (SourceStateExactRel.ok hShared hVars hDomain)
          hAllowInner (by rfl) with
        ⟨sourceOutcome, targetFuel, hTargetInner, hRelInner⟩
      let outerOutcome : Objects.Source.Outcome :=
        match sourceOutcome.mode with
        | .regular =>
            Functions.Source.Outcome.regular
              (sourceOutcome.state.restrictTo layout)
        | .brk | .cont | .leave | .halt _ => sourceOutcome
      have hTargetOuter :
          Functions.Source.Block.runScoped prim program ctx
              { stmts := [Functions.Stmt.block lowerBody] } targetFuel.succ
              compiler =
            .ok outerOutcome := by
        cases targetFuel with
        | zero =>
            exact False.elim
              (by
                simpa [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid] using hTargetInner)
        | succ targetFuel' =>
            cases sourceOutcome with
            | mk outcomeState outcomeMode =>
                cases outcomeMode <;>
                  simp [outerOutcome, Functions.Source.Block.runScoped,
                    Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                    hTargetInner, hScope, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular]
      have hRelOuter :
          SourceResultOutcomeRel cfg layout terminalRel revertRel
            (wrap innerResult) outerOutcome := by
        cases hResult : innerResult with
        | error err =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | yulHalt hTerminal =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.yulHalt
                    (cfg := cfg) (layout := layout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hTerminal)
            | revert hRevert =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.revert
                    (cfg := cfg) (layout := layout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hRevert)
        | ok innerState =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                    case ok compilerAfter sharedAfter storeAfter
                        hSharedAfter hVarsAfter =>
                        have hRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (Locals.Source.State.restrictTo layout
                                compilerAfter) := by
                          exact
                            sourceStateRel_restrictStoreTo_of_domain
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hDomain (fun name hMem => hMem)
                        simpa [outerOutcome, wrap, hResult] using
                          (SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular hRestricted))
                | brk hRelState =>
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
                        (cfg := cfg) (layout := layout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        hDomain
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.brk hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | cont hRelState =>
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
                        (cfg := cfg) (layout := layout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        hDomain
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.cont hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | leave hRelState =>
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
                        (cfg := cfg) (layout := layout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        hDomain
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.leave hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
      exact ⟨outerOutcome, targetFuel.succ, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

/--
Relation-aware bracketed-block closure at a compatible outcome layout.

The surrounding `.Block body` executes the inner block and then applies the
usual block-scope varstore restriction.  The inner theorem receives the
unrestricted inner result, so its compatibility predicate is recovered from the
outer compatible result using
`SourceResultOutcomeLayoutCompatible.of_restrictStoreTo`.
-/
theorem sourceResultBlockSoundWhenAtExact_block_compat_of_inner_when
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {innerFuel : Nat} {body : List AstStmt}
    {codeOverride : Option AstContract} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hScope : ctx.scope = layout)
    (hInner :
      ∀ {allowedInner : Except Exception State → Prop},
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultRelatable sourceResult) →
        (∀ {sourceResult}, allowedInner sourceResult →
          SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
            sourceResult) →
        SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
          revertRel prim program ctx innerFuel body codeOverride lowerBody
          allowedInner) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx innerFuel.succ.succ [.Block body]
      codeOverride { stmts := [Functions.Stmt.block lowerBody] }
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases hInitial with
  | @ok shared scope compiler hShared hVars hDomain =>
      let innerResult : Except Exception State :=
        EvmYul.Yul.exec innerFuel (.Block body) codeOverride
          (.Ok shared scope : State)
      let wrap : Except Exception State → Except Exception State :=
        fun result =>
          match result with
          | .ok state => .ok (state.restrictStoreTo scope)
          | .error err => .error err
      have hOuter :
          EvmYul.Yul.exec innerFuel.succ.succ (.Block [.Block body])
              codeOverride (.Ok shared scope : State) =
            wrap innerResult := by
        unfold innerResult
        cases hExec :
            EvmYul.Yul.exec innerFuel (.Block body) codeOverride
              (.Ok shared scope : State) with
        | error err =>
            simp [wrap, EvmYul.Yul.exec, EvmYul.Yul.execSeq, hExec]
        | ok state =>
            cases innerFuel with
            | zero =>
                have hZero :
                    EvmYul.Yul.exec 0 (.Block body) codeOverride
                        (.Ok shared scope : State) =
                      .error .OutOfFuel :=
                  Imported.exec_zero (.Block body) codeOverride
                    (.Ok shared scope : State)
                rw [hZero] at hExec
                cases hExec
            | succ fuel =>
                cases state <;>
                  simp [wrap, EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                    EvmYul.Yul.State.store, hExec]
      have hWrapEq : wrap innerResult = sourceResult := by
        simpa [hOuter] using hSource
      let allowedInner : Except Exception State → Prop :=
        fun result => allowed (wrap result)
      have hAllowedInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultRelatable sourceResult := by
        intro sourceResult hAllowInner
        have hWrapped :
            SourceResultRelatable (wrap sourceResult) :=
          hAllowed hAllowInner
        cases sourceResult with
        | ok source =>
            cases source <;> simpa [wrap, SourceResultRelatable] using hWrapped
        | error err =>
            simpa [wrap] using hWrapped
      have hCompatInner :
          ∀ {sourceResult}, allowedInner sourceResult →
            SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
              sourceResult := by
        intro sourceResult hAllowInner
        exact
          SourceResultOutcomeLayoutCompatible.of_restrictStoreTo
            (scope := scope) (hCompat hAllowInner)
      have hAllowInner : allowedInner innerResult := by
        change allowed (wrap innerResult)
        simpa [hWrapEq] using hAllow
      rcases
          (hInner (allowedInner := allowedInner) hAllowedInner hCompatInner).2
            (source := (.Ok shared scope : State)) (compiler := compiler)
            (sourceResult := innerResult)
            (SourceStateExactRel.ok hShared hVars hDomain)
            hAllowInner (by rfl) with
        ⟨sourceOutcome, targetFuel, hTargetInner, hRelInner⟩
      let outerOutcome : Objects.Source.Outcome :=
        match sourceOutcome.mode with
        | .regular =>
            Functions.Source.Outcome.regular
              (sourceOutcome.state.restrictTo layout)
        | .brk | .cont | .leave | .halt _ => sourceOutcome
      have hTargetOuter :
          Functions.Source.Block.runScoped prim program ctx
              { stmts := [Functions.Stmt.block lowerBody] } targetFuel.succ
              compiler =
            .ok outerOutcome := by
        cases targetFuel with
        | zero =>
            exact False.elim
              (by
                simpa [Functions.Source.Block.runScoped,
                  Functions.Source.Block.runOpen, Functions.Source.invalid,
                  Structured.invalid] using hTargetInner)
        | succ targetFuel' =>
            cases sourceOutcome with
            | mk outcomeState outcomeMode =>
                cases outcomeMode <;>
                  simp [outerOutcome, Functions.Source.Block.runScoped,
                    Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                    hTargetInner, hScope, Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular]
      have hRelOuter :
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (wrap innerResult) outerOutcome := by
        cases hResult : innerResult with
        | error err =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | yulHalt hTerminal =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.yulHalt
                    (cfg := cfg) (layout := outcomeLayout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hTerminal)
            | revert hRevert =>
                simpa [outerOutcome, wrap, hResult] using
                  (SourceResultOutcomeRel.revert
                    (cfg := cfg) (layout := outcomeLayout)
                    (terminalRel := terminalRel) (revertRel := revertRel)
                    hRevert)
        | ok innerState =>
            have hRelInner' := hRelInner
            rw [hResult] at hRelInner'
            cases hRelInner' with
            | ok hOk =>
                cases hOk with
                | regular hRelState =>
                    cases hRelState
                    case ok compilerAfter sharedAfter storeAfter
                        hSharedAfter hVarsAfter =>
                        have hFinalCompat :
                            SourceResultOutcomeLayoutCompatible ctx layout
                              outcomeLayout (wrap innerResult) := by
                          exact hCompat (by
                            change allowed (wrap innerResult)
                            exact hAllowInner)
                        have hOutcomeLayout : outcomeLayout = layout := by
                          simpa [SourceResultOutcomeLayoutCompatible, wrap,
                            hResult, EvmYul.Yul.State.restrictStoreTo] using
                            hFinalCompat
                        subst outcomeLayout
                        have hRestricted :
                            SourceStateRel cfg layout
                              (EvmYul.Yul.State.restrictStoreTo scope
                                (.Ok sharedAfter storeAfter : State))
                              (Locals.Source.State.restrictTo layout
                                compilerAfter) := by
                          exact
                            sourceStateRel_restrictStoreTo_of_domain
                              (SourceStateRel.ok hSharedAfter hVarsAfter)
                              hDomain (fun name hMem => hMem)
                        simpa [outerOutcome, wrap, hResult] using
                          (SourceResultOutcomeRel.ok
                            (SourceOkOutcomeRel.regular hRestricted))
                | brk hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hBreakCompat :
                        ctx.breakScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hBreakCompat with ⟨_hBreak, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.brk hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | cont hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hContinueCompat :
                        ctx.continueScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hContinueCompat with ⟨_hContinue, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.cont hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
                | leave hRelState =>
                    have hFinalCompat :
                        SourceResultOutcomeLayoutCompatible ctx layout
                          outcomeLayout (wrap innerResult) := by
                      exact hCompat (by
                        change allowed (wrap innerResult)
                        exact hAllowInner)
                    have hLeaveCompat :
                        ctx.leaveScope? = some outcomeLayout ∧
                          ∀ name, name ∈ outcomeLayout → name ∈ layout := by
                      simpa [SourceResultOutcomeLayoutCompatible, wrap,
                        hResult, EvmYul.Yul.State.restrictStoreTo] using
                        hFinalCompat
                    rcases hLeaveCompat with ⟨_hLeave, hSubsetOutcome⟩
                    have hScopeContains :
                        ∀ name, name ∈ outcomeLayout →
                          (scope.lookup name).isSome = true := by
                      intro name hMem
                      exact (hDomain name).mpr (hSubsetOutcome name hMem)
                    have hRelRestricted :=
                      SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
                        (cfg := cfg) (layout := outcomeLayout)
                        (terminalRel := terminalRel) (revertRel := revertRel)
                        (scope := scope) hScopeContains
                        (SourceResultOutcomeRel.ok
                          (SourceOkOutcomeRel.leave hRelState))
                    simpa [outerOutcome, wrap, hResult] using hRelRestricted
      exact ⟨outerOutcome, targetFuel.succ, hTargetOuter, by
        simpa [hWrapEq] using hRelOuter⟩

/--
Bracketed block statement closure for a regular exact-domain body.

The body proof is regular-only, but the surrounding `.Block body` statement is
still presented through the general result/block interface.  This factors the
regular-body source theorem through the already-proved bracketed-block wrapper
so future recursive constructors do not duplicate the outer block cleanup.
