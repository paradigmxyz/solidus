theorem SourcePairResultCheckpointAllowed.call_of_ok_state
    {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {args : List Word}
    {functionName : Option Name} {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore} :
    SourcePairResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.call fuel args functionName codeOverride
        (.Ok shared store)) := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.call, SourcePairResultCheckpointAllowed]
  | succ fuel' =>
      simp [EvmYul.Yul.call, EvmYul.Yul.State.sharedState,
        EvmYul.Yul.State.executionEnv]
      cases hFind : shared.accountMap.find? shared.executionEnv.codeOwner with
      | none => simp [hFind, SourcePairResultCheckpointAllowed]
      | some yulContract =>
          simp [hFind]
          cases functionName with
          | none =>
              let f : EvmYul.Yul.Ast.FunctionDefinition :=
                .Def [] [] [(codeOverride.getD yulContract.code).dispatcher]
              change
                SourcePairResultCheckpointAllowed canBreak canContinue
                  canLeave
                  (match EvmYul.Yul.exec fuel' (.Block f.body) codeOverride
                      (👌 (EvmYul.Yul.State.Ok shared store).initcall
                        f.params f.rets args) with
                  | Except.error e => Except.error e
                  | Except.ok s2 =>
                      Except.ok
                        ((s2.reviveJump.overwrite? (.Ok shared store)).setStore
                          (.Ok shared store),
                          List.map s2.lookup! f.rets))
              cases hExec :
                  EvmYul.Yul.exec fuel' (.Block f.body) codeOverride
                    (👌 (EvmYul.Yul.State.Ok shared store).initcall
                      f.params f.rets args) with
              | error err =>
                  simp [hExec, SourcePairResultCheckpointAllowed]
              | ok bodyState =>
                  cases bodyState <;>
                    simp [hExec, SourcePairResultCheckpointAllowed,
                      EvmYul.Yul.State.setStore,
                      EvmYul.Yul.State.overwrite?,
                      EvmYul.Yul.State.reviveJump,
                      StateCheckpointAllowed]
                  next jump =>
                    cases jump <;>
                      simp [EvmYul.Yul.State.revive,
                        StateCheckpointAllowed]
          | some fname =>
              cases hLookup : (codeOverride.getD yulContract.code).functions.lookup
                  fname with
              | none =>
                  simp [hLookup, SourcePairResultCheckpointAllowed]
              | some fn =>
                  simp [hLookup]
                  cases hExec :
                      EvmYul.Yul.exec fuel' (.Block fn.body) codeOverride
                        (👌 (EvmYul.Yul.State.Ok shared store).initcall
                          fn.params fn.rets args) with
                  | error err =>
                      simp [hExec, SourcePairResultCheckpointAllowed]
                  | ok bodyState =>
                      cases bodyState <;>
                        simp [hExec, SourcePairResultCheckpointAllowed,
                          EvmYul.Yul.State.setStore,
                          EvmYul.Yul.State.overwrite?,
                          EvmYul.Yul.State.reviveJump,
                          StateCheckpointAllowed]
                      next jump =>
                        cases jump <;>
                          simp [EvmYul.Yul.State.revive,
                            StateCheckpointAllowed]

