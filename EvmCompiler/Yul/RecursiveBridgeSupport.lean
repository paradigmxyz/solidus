/--
Hidden-context sequence soundness with typed mode continuations.

This is the intended replacement frontier for generated-control mode proofs.
It is open-sequence shaped like `SourceResultSeqSoundWhenAtExactHiddenCtx`, but
the outcome relation carries one layout per control mode.
-/
def SourceResultSeqKontSoundWhenAtExactHiddenCtx
    (cfg : StateRelConfig) (currentLayout : List Name)
    (konts : SourceModeKontLayouts)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) : Prop :=
  ∀ {source compiler sourceResult},
    SourceStateExactRel cfg currentLayout source compiler →
    allowed sourceResult →
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      sourceResult →
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel,
      Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
          compiler =
        .ok (sourceOutcome, ctxAfter) ∧
      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
        sourceResult sourceOutcome

/--
Checked lowering facade for the typed-continuation hidden sequence frontier.
-/
def CheckedSeqKontSoundWhenFreshNamesAtCompileFuelHiddenCtx
    (cfg : StateRelConfig) (reserved currentLayout : List Name)
    (konts : SourceModeKontLayouts)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel compileFuel : Nat)
    (sourceStmts : List AstStmt) (codeOverride : Option AstContract)
    (allowed : Except Exception State → Prop) : Prop :=
  ∀ {freshState freshState' lowerBlock},
    FreshCoversLayout (reserved ++ currentLayout) freshState →
    Stmt.List.toBlockFuel? compileFuel freshState sourceStmts =
      some (lowerBlock, freshState') →
    SourceResultSeqKontSoundWhenAtExactHiddenCtx cfg currentLayout konts
      terminalRel revertRel prim program ctx sourceFuel sourceStmts
      codeOverride lowerBlock allowed

/--
Continuation-layout support for a hidden source sequence.

`currentLayout` is the layout of the imported Yul store at the current program
point.  The four continuations are the source-visible layouts promised when
the sequence exits in each mode.  Declaration heads can change `regular`
without changing `brk`/`cont`, which is the key distinction missing from the
older single-`outcomeLayout` predicates.
-/
def SourceResultModeKontSupported
    (ctx : Functions.Source.Ctx) (currentLayout : List Name)
    (konts : SourceModeKontLayouts) : Except Exception State → Prop
  | .ok (.Ok _shared _store) =>
      ∀ name, name ∈ konts.regular → name ∈ currentLayout
  | .ok (.Checkpoint (.Break _shared _store)) =>
      ∃ breakScope : List Name,
        ctx.breakScope? = some breakScope ∧
          ∀ name, name ∈ konts.brk → name ∈ breakScope
  | .ok (.Checkpoint (.Continue _shared _store)) =>
      ∃ continueScope : List Name,
        ctx.continueScope? = some continueScope ∧
          ∀ name, name ∈ konts.cont → name ∈ continueScope
  | .ok (.Checkpoint (.Leave _shared _store)) =>
      ctx.leaveScope? = some konts.leave ∧
        ∀ name, name ∈ konts.leave → name ∈ currentLayout
  | .ok .OutOfFuel => True
  | .error _err => True

namespace SourceResultModeKontSupported

theorem regular_of_subset
    {ctx : Functions.Source.Ctx} {currentLayout : List Name}
    {konts : SourceModeKontLayouts}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    (hSubset : ∀ name : Name, name ∈ konts.regular → name ∈ currentLayout) :
    SourceResultModeKontSupported ctx currentLayout konts
      (.ok (.Ok shared store)) :=
  hSubset

