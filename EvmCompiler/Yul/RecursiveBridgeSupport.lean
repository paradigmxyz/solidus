        codeOverride pre lowerExpr)
    (hInitial : SourceStateRel cfg layout (.Ok shared store) compiler)
    (hEval :
      EvmYul.Yul.evalValues sourceFuel sourceExpr codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, values))
    (hDomainAfter : StoreDomainExact layout storeAfter)
