theorem primCall_log0_error_not_relatable
    {fuel : Nat}
    {state : State} {args : List Word} {err : Exception}
    (h :
      EvmYul.Yul.primCall fuel state
          ((.Log .LOG0 : EvmYul.Operation .Yul)) args =
        .error err)
    (hRelatable : SourceResultRelatable (.error err)) :
    False := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.primCall] at h
      subst err
      simpa [SourceResultRelatable] using hRelatable
  | succ fuel =>
      by_cases hStatic : state.executionEnv.perm = false
      · simp [EvmYul.Yul.primCall, hStatic] at h
        cases h
        simpa [SourceResultRelatable] using hRelatable
      · have hWritable : state.executionEnv.perm = true := by
          cases hPerm : state.executionEnv.perm <;> simp [hPerm] at hStatic ⊢
        have hStep :
            EvmYul.step ((.Log .LOG0 : EvmYul.Operation .Yul)) none =
              EvmYul.Yul.log0Op := by
          rfl
        simp [EvmYul.Yul.primCall, hWritable] at h
        rw [hStep] at h
        cases args with
        | nil =>
            simp [EvmYul.Yul.log0Op] at h
        | cons offset rest =>
            cases rest with
            | nil =>
                simp [EvmYul.Yul.log0Op] at h
            | cons size rest =>
                cases rest with
                | nil =>
                    simp [EvmYul.Yul.log0Op] at h
                | cons extra rest =>
                    simp [EvmYul.Yul.log0Op] at h

