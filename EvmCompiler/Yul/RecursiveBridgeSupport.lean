theorem lower1?_sourceContainsPreservingPrelude
    {state state' : Fresh.State} {expr : AstExpr}
    {pre : List Functions.Stmt} {lower : Locals.Expr 1}
    (hLower : Expr.lower1? state expr = some (pre, lower, state')) :
    SourceContainsPreservingPrelude pre :=
  lower1?_sourceContainsPreservingPrelude_aux expr hLower

theorem lowerBound1?_sourceContainsPreservingPrelude
    {state state' : Fresh.State} {args : List AstExpr}
    {pre : List Functions.Stmt} {lowerArgs : List (Locals.Expr 1)}
    (hLower :
      Expr.List.lowerBound1? state args =
        some (pre, lowerArgs, state')) :
    SourceContainsPreservingPrelude pre := by
  induction args generalizing state pre lowerArgs state' with
  | nil =>
      simp [Expr.List.lowerBound1?] at hLower
      rcases hLower with ⟨hPreEq, _hLowerEq, _hStateEq⟩
      cases hPreEq
      exact SourceContainsPreservingPrelude.nil
  | cons head tail ih =>
      simp [Expr.List.lowerBound1?] at hLower
      cases hRest : Expr.List.lowerBound1? state tail with
      | none =>
          simp [hRest] at hLower
      | some restResult =>
          rcases restResult with ⟨preRest, lowerRest, stateRest⟩
          simp [hRest] at hLower
          cases hHead : Expr.lower? 1 stateRest head with
          | none =>
              simp [hHead] at hLower
          | some headResult =>
              rcases headResult with ⟨preHead, lowerHead, stateHead⟩
              simp [hHead] at hLower
              cases hFresh : Fresh.fresh? stateHead with
              | none =>
                  simp [hFresh] at hLower
              | some freshResult =>
                  rcases freshResult with ⟨tmp, stateFresh⟩
                  simp [hFresh] at hLower
                  rcases hLower with ⟨hPreEq, _hLowerEq, _hStateEq⟩
                  have hRestPre : SourceContainsPreservingPrelude preRest :=
                    ih (state := state) (pre := preRest)
                      (lowerArgs := lowerRest) (state' := stateRest) hRest
                  have hHeadLower1 :
                      Expr.lower1? stateRest head =
                        some (preHead, lowerHead, stateHead) := by
                    simpa [Expr.lower1?] using hHead
                  have hHeadPre :
                      SourceContainsPreservingPrelude preHead :=
                    lower1?_sourceContainsPreservingPrelude hHeadLower1
                  cases hPreEq
                  simpa [List.append_assoc] using
                    SourceContainsPreservingPrelude.append hRestPre
                      (SourceContainsPreservingPrelude.append_let hHeadPre)


theorem sourceContainsPreservingPrelude_runOpen_regular
    {names : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    ∀ {pre : List Functions.Stmt} {ctx ctxAfter : Functions.Source.Ctx}
      {fuel : Nat} {state stateAfter : Objects.Source.State},
      SourceContainsPreservingPrelude pre →
      SourceVarsContains names state.vars →
      Functions.Source.Block.runOpen prim program ctx fuel
          { stmts := pre } state =
        .ok (Functions.Source.Outcome.regular stateAfter, ctxAfter) →
      SourceVarsContains names stateAfter.vars := by
  intro pre
  induction pre with
  | nil =>
      intro ctx ctxAfter fuel state stateAfter _hPre hContains hRun
      rcases
          Functions.Source.Block.runOpen_nil_ok
            (prim := prim) (program := program) (ctx := ctx)
            (fuel := fuel) (state := state)
            (outcome := Functions.Source.Outcome.regular stateAfter)
            (runCtx := ctxAfter) hRun with
        ⟨hOutcome, _hCtx⟩
      have hState : stateAfter = state := by
        simpa [Functions.Source.Outcome.regular,
          Locals.Source.Outcome.regular] using congrArg
            (fun outcome : Functions.Source.Outcome => outcome.state)
            hOutcome
      subst stateAfter
      exact hContains
  | cons stmt rest ih =>
      intro ctx ctxAfter fuel state stateAfter hPre hContains hRun
      cases stmt with
      | expr expr =>
          simp [SourceContainsPreservingPrelude] at hPre
      | let_ name value =>
        have hRest : SourceContainsPreservingPrelude rest := by
          simpa [SourceContainsPreservingPrelude] using hPre
        cases fuel with
        | zero =>
            simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
              Structured.invalid] at hRun
        | succ fuel =>
            simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run]
              at hRun
            cases hEval :
                Locals.Source.Expr.evalOne prim value state with
            | error err =>
                simp [hEval] at hRun
            | ok evalResult =>
                rcases evalResult with ⟨stateAfterValue, value'⟩
                simp [hEval, Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] at hRun
                have hAfterLet :
                    SourceVarsContains names
                      (stateAfterValue.insert name value').vars :=
                  SourceVarsContains.insert
                    (SourceVarsContains.of_evalOne hContains hEval)
                exact
                  ih
                    (ctx := { ctx with scope := name :: ctx.scope })
                    (ctxAfter := ctxAfter) (fuel := fuel)
                    (state := stateAfterValue.insert name value')
                    (stateAfter := stateAfter) hRest hAfterLet hRun
      | assign name value =>
          simp [SourceContainsPreservingPrelude] at hPre
      | block body =>
          simp [SourceContainsPreservingPrelude] at hPre
      | if_ cond body =>
          simp [SourceContainsPreservingPrelude] at hPre
      | switch scrutinee cases defaultBody =>
          simp [SourceContainsPreservingPrelude] at hPre
      | for_ init cond post body =>
          simp [SourceContainsPreservingPrelude] at hPre
      | brk =>
          simp [SourceContainsPreservingPrelude] at hPre
      | cont =>
          simp [SourceContainsPreservingPrelude] at hPre
      | leave =>
          simp [SourceContainsPreservingPrelude] at hPre
      | call targets functionName args =>
        have hRest : SourceContainsPreservingPrelude rest := by
          simpa [SourceContainsPreservingPrelude] using hPre
        cases fuel with
        | zero =>
            simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
              Structured.invalid] at hRun
        | succ fuel =>
            cases fuel with
            | zero =>
                simp [Functions.Source.Block.runOpen,
                  Functions.Source.Stmt.run, Functions.Source.invalid,
                  Structured.invalid] at hRun
            | succ bodyFuel =>
                by_cases hTargets : targets.Nodup
                · simp [Functions.Source.Block.runOpen,
                    Functions.Source.Stmt.run, hTargets] at hRun
                  cases hArgs :
                      Functions.Source.ArgList.eval prim args state with
                  | error err =>
                      simp [hArgs] at hRun
                  | ok argResult =>
                      rcases argResult with ⟨stateAfterArgs, argValues⟩
                      have hArgsContains :
                          SourceVarsContains names stateAfterArgs.vars :=
                        SourceVarsContains.of_argList_eval hContains hArgs
                      cases hFind :
                          Functions.FunList.find? functionName
                            program.functions with
                      | none =>
                          simp [hArgs, hFind, Functions.Source.invalid,
                            Structured.invalid] at hRun
                      | some fn =>
                          cases hBody :
                              Functions.Source.FunDef.runBody prim program fn
                                argValues bodyFuel stateAfterArgs.shared with
                          | error err =>
                              simp [hArgs, hFind, hBody] at hRun
                          | ok callResult =>
                              cases callResult with
                              | returned sharedAfterCall returnValues =>
                                  cases hAssign :
                                      Functions.Source.Store.assignMany targets
                                        returnValues stateAfterArgs.vars with
                                  | none =>
                                      simp [hArgs, hFind, hBody, hAssign,
                                        Functions.Source.invalid,
                                        Structured.invalid] at hRun
                                  | some returnStore =>
                                      simp [hArgs, hFind, hBody, hAssign,
                                        Functions.Source.Outcome.regular,
                                        Locals.Source.Outcome.regular] at hRun
                                      have hAfterCall :
                                          SourceVarsContains names returnStore :=
                                        SourceVarsContains.assignMany_preserves
                                          hAssign hArgsContains
                                      exact
                                        ih (ctx := ctx) (ctxAfter := ctxAfter)
                                          (fuel := bodyFuel.succ)
                                          (state :=
                                            { shared := sharedAfterCall,
                                              vars := returnStore })
                                          (stateAfter := stateAfter) hRest
                                          hAfterCall hRun
                              | halted kind haltedState =>
                                  simp [hArgs, hFind, hBody,
                                    Functions.Source.Outcome.halt,
                                    Locals.Source.Outcome.halt] at hRun
                                  rcases hRun with ⟨hOutcomeEq, _hCtxEq⟩
                                  have hModeEq :=
                                    congrArg
                                      (fun outcome : Functions.Source.Outcome =>
                                        outcome.mode)
                                      hOutcomeEq
                                  simp [Functions.Source.Outcome.regular,
                                    Locals.Source.Outcome.regular] at hModeEq
                · simp [Functions.Source.Block.runOpen,
                    Functions.Source.Stmt.run, hTargets,
                    Functions.Source.invalid, Structured.invalid] at hRun
      | terminal kind =>
          simp [SourceContainsPreservingPrelude] at hPre
      | terminalArgs kind args =>
          simp [SourceContainsPreservingPrelude] at hPre

theorem sourceContainsPreservingPrelude_runOpen_regular_argList
    {names : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat}
    {pre : List Functions.Stmt}
    {state stateAfterPre stateAfterArgs : Objects.Source.State}
    {args : List (Locals.Expr 1)} {values : List Word}
    (hPre : SourceContainsPreservingPrelude pre)
    (hContains : SourceVarsContains names state.vars)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel { stmts := pre }
          state =
        .ok (Functions.Source.Outcome.regular stateAfterPre, ctxAfter))
    (hArgs :
      Functions.Source.ArgList.eval prim args stateAfterPre =
        .ok (stateAfterArgs, values)) :
    SourceVarsContains names stateAfterArgs.vars :=
  SourceVarsContains.of_argList_eval
    (sourceContainsPreservingPrelude_runOpen_regular
      (names := names) (prim := prim) (program := program)
      hPre hContains hRun) hArgs

namespace SourceWritesDisjoint

theorem nil {protectedNames : List Name} :
    SourceWritesDisjoint protectedNames [] := by
  simp [SourceWritesDisjoint]

theorem let_ {protectedNames : List Name} {name : Name}
    {expr : Locals.Expr 1} {rest : List Functions.Stmt}
    (hFresh : name ∉ protectedNames)
    (hRest : SourceWritesDisjoint protectedNames rest) :
    SourceWritesDisjoint protectedNames
      (Functions.Stmt.let_ name expr :: rest) := by
  simpa [SourceWritesDisjoint] using And.intro hFresh hRest

theorem call {protectedNames targets : List Name} {functionName : Name}
    {args : List (Locals.Expr 1)} {rest : List Functions.Stmt}
    (hTargets : ∀ name, name ∈ targets → name ∉ protectedNames)
    (hRest : SourceWritesDisjoint protectedNames rest) :
    SourceWritesDisjoint protectedNames
      (Functions.Stmt.call targets functionName args :: rest) := by
  simpa [SourceWritesDisjoint] using And.intro hTargets hRest

theorem append {protectedNames : List Name} {left right : List Functions.Stmt}
    (hLeft : SourceWritesDisjoint protectedNames left)
    (hRight : SourceWritesDisjoint protectedNames right) :
    SourceWritesDisjoint protectedNames (left ++ right) := by
  induction left with
  | nil =>
      simpa [SourceWritesDisjoint] using hRight
  | cons stmt rest ih =>
      cases stmt <;> simp [SourceWritesDisjoint] at hLeft ⊢
      · exact ⟨hLeft.1, ih hLeft.2⟩
      · exact ⟨hLeft.1, ih hLeft.2⟩

theorem singleton_let {protectedNames : List Name} {name : Name}
    {expr : Locals.Expr 1} (hFresh : name ∉ protectedNames) :
    SourceWritesDisjoint protectedNames [Functions.Stmt.let_ name expr] := by
  exact let_ hFresh nil

theorem singleton_call {protectedNames targets : List Name}
    {functionName : Name} {args : List (Locals.Expr 1)}
    (hTargets : ∀ name, name ∈ targets → name ∉ protectedNames) :
    SourceWritesDisjoint protectedNames
      [Functions.Stmt.call targets functionName args] := by
  exact call hTargets nil

theorem append_let {protectedNames : List Name} {pre : List Functions.Stmt}
    {name : Name} {expr : Locals.Expr 1}
    (hPre : SourceWritesDisjoint protectedNames pre)
    (hFresh : name ∉ protectedNames) :
    SourceWritesDisjoint protectedNames
      (pre ++ [Functions.Stmt.let_ name expr]) :=
  append hPre (singleton_let hFresh)

theorem append_let_call {protectedNames : List Name}
    {pre : List Functions.Stmt} {name : Name}
    {expr : Locals.Expr 1} {targets : List Name} {functionName : Name}
    {args : List (Locals.Expr 1)}
    (hPre : SourceWritesDisjoint protectedNames pre)
    (hFresh : name ∉ protectedNames)
    (hTargets : ∀ target, target ∈ targets → target ∉ protectedNames) :
    SourceWritesDisjoint protectedNames
      (pre ++
        [Functions.Stmt.let_ name expr,
          Functions.Stmt.call targets functionName args]) := by
  exact append hPre (let_ hFresh (singleton_call hTargets))

end SourceWritesDisjoint

