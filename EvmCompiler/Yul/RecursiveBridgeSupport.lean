/--
Exact-domain block soundness for a singleton literal assignment.

Assignments do not introduce a new scoped local: imported Yul checks that the
target already exists, writes the literal, and the enclosing block restriction
keeps exactly the entry layout.  The exact-domain premise discharges the
imported assignment check from the current source layout.
-/
theorem sourceResultBlockSoundWhenAtExact_assign_lit_single_of_compat
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (name : EvmYul.Identifier) (value : Word)
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hScope : ctx.scope = layout)
    (hTargetMem : identName name ∈ layout) :
    SourceResultBlockSoundWhenAtExact cfg layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel
      [.Assign [name] (.Lit value)] codeOverride
      { stmts := [Functions.Stmt.assign (identName name) (.lit value)] }
      allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.exec 0 (.Block [.Assign [name] (.Lit value)])
              codeOverride source =
            .error .OutOfFuel :=
        Imported.exec_zero (.Block [.Assign [name] (.Lit value)])
          codeOverride source
      rw [hZero] at hSource
      subst sourceResult
      exact False.elim
        (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
  | succ fuel =>
      cases fuel with
      | zero =>
          have hOne :
              EvmYul.Yul.exec 1 (.Block [.Assign [name] (.Lit value)])
                  codeOverride source =
                .error .OutOfFuel := by
            simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]
          rw [hOne] at hSource
          subst sourceResult
          exact False.elim
            (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
      | succ fuel =>
          cases fuel with
          | zero =>
              have hTwo :
                  EvmYul.Yul.exec 2
                      (.Block [.Assign [name] (.Lit value)])
                      codeOverride source =
                    .error .OutOfFuel := by
                simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
                  EvmYul.Yul.exec]
              rw [hTwo] at hSource
              subst sourceResult
              exact False.elim
                (sourceResultRelatable_outOfFuel_false (hAllowed hAllow))
          | succ fuel =>
              cases fuel with
              | zero =>
                  cases hInitial with
                  | @ok shared store compiler _hShared _hVars hDomain =>
                      have hCheck :
                          EvmYul.Yul.checkAssignment (.Ok shared store)
                              [name] =
                            .ok () :=
                        StoreDomainExact.checkAssignment_ok
                          (layout := layout) (store := store)
                          (shared := shared) (names := [name]) hDomain
                          (by simp [identNames])
                          (by
                            intro assignedName hMem
                            have hEq : assignedName = identName name := by
                              simpa [identNames] using hMem
                            subst assignedName
                            exact hTargetMem)
                      have hOut :
                          EvmYul.Yul.exec 3
                              (.Block [.Assign [name] (.Lit value)])
                              codeOverride (.Ok shared store) =
                            .error .OutOfFuel := by
                        rw [Imported.exec_block_cons_succ]
                        rw [Imported.execSeq_cons_error_succ]
                        rw [Imported.exec_assign_succ]
                        rw [hCheck]
                        simp [EvmYul.Yul.evalValues,
                          EvmYul.Yul.multifill']
                      rw [hOut] at hSource
                      subst sourceResult
                      exact False.elim
                        (sourceResultRelatable_outOfFuel_false
                          (hAllowed hAllow))
              | succ fuel =>
                  cases hInitial with
                  | @ok shared store compiler hShared hVars hDomain =>
                      have hCheck :
                          EvmYul.Yul.checkAssignment (.Ok shared store)
                              [name] =
                            .ok () :=
                        StoreDomainExact.checkAssignment_ok
                          (layout := layout) (store := store)
                          (shared := shared) (names := [name]) hDomain
                          (by simp [identNames])
                          (by
                            intro assignedName hMem
                            have hEq : assignedName = identName name := by
                              simpa [identNames] using hMem
                            subst assignedName
                            exact hTargetMem)
                      rw [exec_block_assign_lit_succ_succ_succ_succ_of_check
                        fuel codeOverride shared store name value hCheck]
                        at hSource
                      subst sourceResult
                      have hOutcomeLayout : outcomeLayout = layout := by
                        simpa [SourceResultOutcomeLayoutCompatible] using
                          hCompat hAllow
                      subst outcomeLayout
                      have hStoreSome :
                          (store.lookup (identName name)).isSome = true :=
                        StoreDomainExact.contains_of_mem hDomain hTargetMem
                      cases hLookupTarget :
                          store.lookup (identName name) with
                      | none =>
                          simp [hLookupTarget] at hStoreSome
                      | some oldValue =>
                          have hCompilerTarget :
                              compiler.vars (identName name) =
                                some oldValue := by
                            simpa [hLookupTarget] using
                              hVars (identName name) hTargetMem
                          have hContains :
                              compiler.vars.contains (identName name) =
                                true := by
                            simp [Locals.Source.Store.contains,
                              hCompilerTarget]
                          let compilerAssigned :=
                            compiler.insert (identName name) value
                          have hRelAfter :
                              SourceStateExactRel cfg layout
                                (.Ok shared
                                  (store.insert (identName name) value))
                                compilerAssigned :=
                            SourceStateExactRel.ok hShared
                              (sourceStoreRel_insert_visible hVars)
                              (StoreDomainExact.insert_mem hDomain
                                hTargetMem)
                          refine
                            ⟨Functions.Source.Outcome.regular
                                (compilerAssigned.restrictTo layout),
                              2, ?_, ?_⟩
                          · simp [compilerAssigned,
                              Functions.Source.Block.runScoped,
                              Functions.Source.Block.runOpen,
                              Functions.Source.Stmt.run,
                              Functions.Source.Expr.evalOne,
                              Locals.Source.Expr.evalOne,
                              Locals.Source.Expr.eval,
                              Locals.Source.State.insert,
                              Locals.Source.State.withVars,
                              Functions.Source.Outcome.regular,
                              Locals.Source.Outcome.regular, hContains,
                              hScope]
                          · exact
                              SourceResultOutcomeRel.ok
                                (SourceOkOutcomeRel.regular
                                  (sourceStateRel_restrictStoreTo_of_domain
                                    hRelAfter.toRel hDomain
                                    (fun _ hMem => hMem)))

