theorem sourceNonregularStmtRunKontHiddenExact_if_true_exists_of_eval_domain_scope
    {cfg : StateRelConfig} {layout : List Name}
    {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {shared sharedAfterCond : EvmYul.SharedState .Yul}
    {store storeAfterCond : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {pre : List Functions.Stmt}
    {cond : AstExpr} {body : List AstStmt}
    {lowerCond : Locals.Expr 1} {lowerBody : Functions.Block}
    {value : Word}
    (sourceFuel : Nat) (codeOverride : Option AstContract)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hEvalDomain :
      StoreDomainExact layout store →
      EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfterCond storeAfterCond, value) →
      StoreDomainExact layout storeAfterCond)
    (hExact : SourceStateExactRel cfg layout (.Ok shared store) compiler)
    (hEval :
      EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfterCond storeAfterCond, value))
    (hNonzero : value ≠ EvmYul.UInt256.ofNat 0)
    (hCond :
      ExprEvalPreludeSound cfg layout prim program ctx sourceFuel cond
        codeOverride pre lowerCond)
    (hBody :
      ∀ {ctxAfterPre compilerAfterCond},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        (∀ {sourceResult},
          SourceResultModeKontSupported ctx layout konts sourceResult →
          SourceResultModeKontSupported ctxAfterPre layout konts
            sourceResult) →
        SourceStateExactRel cfg layout (.Ok sharedAfterCond storeAfterCond)
          compilerAfterCond →
        ∃ sourceResultBody : Except Exception State,
        ∃ sourceOutcomeBody : Objects.Source.Outcome,
        ∃ bodyTargetFuel : Nat,
          EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
              (.Ok sharedAfterCond storeAfterCond) =
            sourceResultBody ∧
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyTargetFuel compilerAfterCond =
            .ok sourceOutcomeBody ∧
          SourceResultKontOutcomeRel cfg konts terminalRel revertRel
            sourceResultBody sourceOutcomeBody ∧
          sourceOutcomeBody.mode ≠ Locals.Source.Mode.regular) :
    SourceNonregularStmtRunKontHiddenExact cfg layout konts terminalRel
      revertRel prim program ctx sourceFuel.succ (.If cond body) codeOverride
      (.Ok shared store) compiler
      { stmts := pre ++ [Functions.Stmt.if_ lowerCond lowerBody] } := by
  cases hExact with
  | @ok shared store compiler hShared hVars hDomain =>
      let hRelInitial :
          SourceStateRel cfg layout (.Ok shared store) compiler :=
        SourceStateRel.ok hShared hVars
      rcases
          hCond.run_exact_of_eval_domain
            (cfg := cfg) (layout := layout) (prim := prim)
            (program := program) (ctx := ctx)
            (sourceFuel := sourceFuel) (sourceExpr := cond)
            (codeOverride := codeOverride) (pre := pre)
            (lowerExpr := lowerCond) (shared := shared)
            (sharedAfter := sharedAfterCond) (store := store)
            (storeAfter := storeAfterCond) (compiler := compiler)
            (value := value) (hEvalDomain := hEvalDomain)
            hDomain hRelInitial hEval with
        ⟨compilerAfterPre, compilerAfterCond, ctxAfterPre, preFuel,
          hPreRun, hCondRun, hRelCondExact⟩
      have hScopeAfter :
          ∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope :=
        sourceScopeContains_of_runOpen_regular
          (layout := layout) (prim := prim) (program := program)
          (ctx := ctx) (ctxAfter := ctxAfterPre)
          (fuel := preFuel) (block := { stmts := pre })
          (state := compiler) (stateAfter := compilerAfterPre)
          hScopeContains hPreRun
      have hKontTransfer :
          ∀ {sourceResult},
            SourceResultModeKontSupported ctx layout konts sourceResult →
            SourceResultModeKontSupported ctxAfterPre layout konts
              sourceResult := by
        intro sourceResult hSupported
        exact
          SourceResultModeKontSupported.of_handler_eq
            (ctx := ctx) (ctx' := ctxAfterPre) (currentLayout := layout)
            (konts := konts) (sourceResult := sourceResult)
            (Functions.SourceDirect.SourceRun.block_runOpen_regular_breakScope
              hPreRun)
            (Functions.SourceDirect.SourceRun.block_runOpen_regular_continueScope
              hPreRun)
            (Functions.SourceDirect.SourceRun.block_runOpen_regular_leaveScope
              hPreRun)
            hSupported
      rcases
          hBody (ctxAfterPre := ctxAfterPre)
            (compilerAfterCond := compilerAfterCond) hScopeAfter
            hKontTransfer hRelCondExact with
        ⟨sourceResultBody, sourceOutcomeBody, bodyTargetFuel, hSourceBody,
          hCompilerBody, hOutcomeRelBody, hNonregularBody⟩
      have hSourceHead :
          EvmYul.Yul.exec sourceFuel.succ (.If cond body) codeOverride
              (.Ok shared store) =
            sourceResultBody := by
        have hNonzeroRaw : value ≠ ({ val := 0 } : Word) := by
          simpa using hNonzero
        rw [Imported.exec_if_succ]
        simp [hEval, hNonzeroRaw, hSourceBody]
      have hCompilerCondTrue :
          Functions.Source.Expr.evalCondition prim lowerCond
              compilerAfterPre =
            .ok (compilerAfterCond, true) := by
        have hBoolTrue :
            (value != EvmYul.UInt256.ofNat 0) = true :=
          word_bne_zero_true_of_ne hNonzero
        change
          Locals.Source.Expr.evalCondition prim lowerCond compilerAfterPre =
            .ok (compilerAfterCond, true)
        simp [Locals.Source.Expr.evalCondition, hCondRun, hBoolTrue]
      have hIfRun :
          Functions.Source.Block.runOpen prim program ctxAfterPre
              bodyTargetFuel.succ.succ
              { stmts := [Functions.Stmt.if_ lowerCond lowerBody] }
              compilerAfterPre =
            .ok (sourceOutcomeBody, ctxAfterPre) := by
        cases sourceOutcomeBody with
        | mk bodyState bodyMode =>
            cases bodyMode
            · exfalso
              exact hNonregularBody rfl
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
            · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondTrue, hCompilerBody]
      rcases
          Functions.Source.Block.runOpen_append_regular_exists prim program
            pre [Functions.Stmt.if_ lowerCond lowerBody]
            ctx ctxAfterPre compiler compilerAfterPre
            sourceOutcomeBody ctxAfterPre ⟨preFuel, hPreRun⟩
            ⟨bodyTargetFuel.succ.succ, hIfRun⟩ with
        ⟨targetFuel, hTarget⟩
      exact
        ⟨sourceResultBody, sourceOutcomeBody, ctxAfterPre, targetFuel,
          hSourceHead, by simpa using hTarget, hOutcomeRelBody,
          hNonregularBody⟩

/--
Singleton generated-prelude `if` sequence bridge.

This is the compositional frontier shape needed by checked structured-control
wrappers.  The condition may introduce hidden compiler temporaries before the
actual target `if`.  If the condition errors, the expression terminal prelude
handles the whole singleton sequence.  If the condition is false, the target
skips the body and returns a regular outcome at the visible layout.  If the
condition is true, the body proof runs in the hidden post-prelude context and
its outcome is returned directly.
-/
theorem sourceResultSeqSoundWhenAtExactHiddenCtx_single_if_of_eval_domain
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat}
    {cond : AstExpr} {body : List AstStmt}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lowerCond : Locals.Expr 1} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hCondTerminal :
      SourceExprPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program ctx sourceFuel cond codeOverride pre)
    (hCondSound :
      ExprEvalPreludeSound cfg layout prim program ctx sourceFuel cond
        codeOverride pre lowerCond)
    (hResultOk :
      ExprEvalResultOkAt cfg layout sourceFuel cond codeOverride)
    (hEvalDomain :
      ∀ {shared store sharedAfter storeAfter value},
        StoreDomainExact layout store →
        EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter, value) →
        StoreDomainExact layout storeAfter)
    (hBody :
      ∀ {sharedAfterCond storeAfterCond ctxAfterPre compilerAfterCond},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        (∀ {sourceResult}, allowed sourceResult →
          SourceResultOutcomeLayoutCompatible ctxAfterPre layout outcomeLayout
            sourceResult) →
        SourceStateExactRel cfg layout
          (.Ok sharedAfterCond storeAfterCond) compilerAfterCond →
        allowed
          (EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
            (.Ok sharedAfterCond storeAfterCond)) →
        ∃ sourceOutcomeBody : Objects.Source.Outcome,
        ∃ bodyTargetFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyTargetFuel compilerAfterCond =
            .ok sourceOutcomeBody ∧
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
              (.Ok sharedAfterCond storeAfterCond))
            sourceOutcomeBody) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel.succ.succ
      [.If cond body] codeOverride
      { stmts := pre ++ [Functions.Stmt.if_ lowerCond lowerBody] }
      allowed := by
  intro source compiler sourceResult hInitial hAllow hSourceSeq
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomain =>
      let hExact :
          SourceStateExactRel cfg layout (.Ok shared store) compiler :=
        SourceStateExactRel.ok hShared hVars hDomain
      let hInitialRel :
          SourceStateRel cfg layout (.Ok shared store) compiler :=
        SourceStateRel.ok hShared hVars
      cases hEval :
          EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) with
      | error err =>
          have hSourceIf :
              EvmYul.Yul.exec sourceFuel.succ (.If cond body) codeOverride
                  (.Ok shared store) =
                .error err := by
            rw [Imported.exec_if_succ]
            simp [hEval]
          have hSourceSeqErr :
              EvmYul.Yul.execSeq sourceFuel.succ.succ [.If cond body]
                  codeOverride (.Ok shared store) =
                .error err :=
            Imported.execSeq_cons_error_succ
              (fuel := sourceFuel.succ) (stmt := .If cond body)
              (rest := []) (codeOverride := codeOverride)
              (state := (.Ok shared store : State)) hSourceIf
          have hResultEq : (.error err : Except Exception State) = sourceResult := by
            rw [hSourceSeqErr] at hSourceSeq
            exact hSourceSeq
          have hRelatableErr : SourceResultRelatable (.error err) := by
            simpa [hResultEq] using hAllowed hAllow
          rcases
              (SourceExprPreludeTerminalAt.append_suffix
                (suffix := [Functions.Stmt.if_ lowerCond lowerBody])
                hCondTerminal) hExact hEval hRelatableErr with
            ⟨sourceOutcome, ctxAfter, targetFuel, hTarget, hOutcomeRel⟩
          exact
            ⟨sourceOutcome, ctxAfter, targetFuel, by simpa using hTarget,
              by simpa [hResultEq] using hOutcomeRel⟩
      | ok evalResult =>
          rcases evalResult with ⟨sourceAfterCond, value⟩
          rcases hResultOk hInitialRel hEval with
            ⟨sharedAfterCond, storeAfterCond, hAfterEq⟩
          subst sourceAfterCond
          by_cases hZero : value = EvmYul.UInt256.ofNat 0
          · subst value
            have hEvalZero :
                EvmYul.Yul.eval sourceFuel cond codeOverride
                    (.Ok shared store) =
                  .ok
                    ((.Ok sharedAfterCond storeAfterCond : State),
                      EvmYul.UInt256.ofNat 0) := by
              simpa using hEval
            rcases
                hCondSound.run_exact_of_eval_domain
                  (cfg := cfg) (layout := layout) (prim := prim)
                  (program := program) (ctx := ctx)
                  (sourceFuel := sourceFuel) (sourceExpr := cond)
                  (codeOverride := codeOverride) (pre := pre)
                  (lowerExpr := lowerCond) (shared := shared)
                  (sharedAfter := sharedAfterCond) (store := store)
                  (storeAfter := storeAfterCond) (compiler := compiler)
                  (value := EvmYul.UInt256.ofNat 0)
                  (hEvalDomain := hEvalDomain) hDomain hInitialRel
                  hEvalZero with
              ⟨compilerAfterPre, compilerAfterCond, ctxAfterPre, preFuel,
                hPreRun, hCondRun, hRelCondExact⟩
            have hSourceIf :
                EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                    codeOverride (.Ok shared store) =
                  .ok (.Ok sharedAfterCond storeAfterCond) := by
              have hZeroRaw :
                  EvmYul.UInt256.ofNat 0 = ({ val := 0 } : Word) := by
                rfl
              rw [Imported.exec_if_succ]
              simp [hEvalZero, hZeroRaw]
            have hSourceSeqRegular :
                EvmYul.Yul.execSeq sourceFuel.succ.succ [.If cond body]
                    codeOverride (.Ok shared store) =
                  .ok (.Ok sharedAfterCond storeAfterCond) :=
              Imported.execSeq_cons_ok_result_succ
                (fuel := sourceFuel.succ) (stmt := .If cond body)
                (rest := []) (codeOverride := codeOverride)
                (state := (.Ok shared store : State))
                (shared := sharedAfterCond) (store := storeAfterCond)
                (result := .ok (.Ok sharedAfterCond storeAfterCond))
                hSourceIf
                (Imported.execSeq_nil_succ sourceFuel codeOverride
                  (.Ok sharedAfterCond storeAfterCond : State))
            have hResultEq :
                (.ok (.Ok sharedAfterCond storeAfterCond) :
                    Except Exception State) = sourceResult := by
              rw [hSourceSeqRegular] at hSourceSeq
              exact hSourceSeq
            have hCompilerCondFalse :
                Functions.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, false) := by
              have hBoolFalse :
                  (EvmYul.UInt256.ofNat 0 != EvmYul.UInt256.ofNat 0) =
                    false :=
                word_bne_zero_false_of_eq rfl
              change
                Locals.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, false)
              simp [Locals.Source.Expr.evalCondition, hCondRun, hBoolFalse]
            have hIfRun :
                Functions.Source.Block.runOpen prim program ctxAfterPre 2
                    { stmts := [Functions.Stmt.if_ lowerCond lowerBody] }
                    compilerAfterPre =
                  .ok (Functions.Source.Outcome.regular compilerAfterCond,
                    ctxAfterPre) := by
              simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondFalse, Functions.Source.Outcome.regular,
                Locals.Source.Outcome.regular]
            rcases
                Functions.Source.Block.runOpen_append_regular_exists prim
                  program pre [Functions.Stmt.if_ lowerCond lowerBody]
                  ctx ctxAfterPre compiler compilerAfterPre
                  (Functions.Source.Outcome.regular compilerAfterCond)
                  ctxAfterPre ⟨preFuel, hPreRun⟩ ⟨2, hIfRun⟩ with
              ⟨targetFuel, hTarget⟩
            have hAllowRegular :
                allowed (.ok (.Ok sharedAfterCond storeAfterCond)) := by
              rw [hResultEq]
              exact hAllow
            have hOutcomeEq : outcomeLayout = layout := by
              simpa [SourceResultOutcomeLayoutCompatible] using
                hCompat hAllowRegular
            subst outcomeLayout
            exact
              ⟨Functions.Source.Outcome.regular compilerAfterCond,
                ctxAfterPre, targetFuel, by simpa using hTarget,
                by
                  have hRelOk :
                      SourceResultOutcomeRel cfg layout terminalRel revertRel
                        (.ok (.Ok sharedAfterCond storeAfterCond))
                        (Functions.Source.Outcome.regular
                          compilerAfterCond) :=
                    SourceResultOutcomeRel.ok
                      (SourceOkOutcomeRel.regular
                        (SourceStateExactRel.toRel hRelCondExact))
                  simpa [hResultEq] using hRelOk⟩
          · have hNonzero : value ≠ EvmYul.UInt256.ofNat 0 := by
              exact hZero
            rcases
                hCondSound.run_exact_of_eval_domain
                  (cfg := cfg) (layout := layout) (prim := prim)
                  (program := program) (ctx := ctx)
                  (sourceFuel := sourceFuel) (sourceExpr := cond)
                  (codeOverride := codeOverride) (pre := pre)
                  (lowerExpr := lowerCond) (shared := shared)
                  (sharedAfter := sharedAfterCond) (store := store)
                  (storeAfter := storeAfterCond) (compiler := compiler)
                  (value := value) (hEvalDomain := hEvalDomain)
                  hDomain hInitialRel hEval with
              ⟨compilerAfterPre, compilerAfterCond, ctxAfterPre, preFuel,
                hPreRun, hCondRun, hRelCondExact⟩
            let bodyResult : Except Exception State :=
              EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
                (.Ok sharedAfterCond storeAfterCond)
            have hSourceIf :
                EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                    codeOverride (.Ok shared store) =
                  bodyResult := by
              have hNonzeroRaw : value ≠ ({ val := 0 } : Word) := by
                simpa using hNonzero
              rw [Imported.exec_if_succ]
              simp [hEval, hNonzeroRaw, bodyResult]
            have hSourceSeqBody :
                EvmYul.Yul.execSeq sourceFuel.succ.succ [.If cond body]
                    codeOverride (.Ok shared store) =
                  bodyResult := by
              cases hBodyResult : bodyResult with
              | error err =>
                  have hSourceIfErr :
                      EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                          codeOverride (.Ok shared store) =
                        .error err := by
                    simpa [hBodyResult] using hSourceIf
                  exact
                    Imported.execSeq_cons_error_succ
                      (fuel := sourceFuel.succ) (stmt := .If cond body)
                      (rest := []) (codeOverride := codeOverride)
                      (state := (.Ok shared store : State)) hSourceIfErr
              | ok bodyState =>
                  cases bodyState with
                  | Ok sharedBody storeBody =>
                      have hSourceIfOk :
                          EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                              codeOverride (.Ok shared store) =
                            .ok (.Ok sharedBody storeBody) := by
                        simpa [hBodyResult] using hSourceIf
                      exact
                        Imported.execSeq_cons_ok_result_succ
                          (fuel := sourceFuel.succ)
                          (stmt := .If cond body) (rest := [])
                          (codeOverride := codeOverride)
                          (state := (.Ok shared store : State))
                          hSourceIfOk
                          (Imported.execSeq_nil_succ sourceFuel codeOverride
                            (.Ok sharedBody storeBody : State))
                  | OutOfFuel =>
                      have hSourceIfOutOfFuel :
                          EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                              codeOverride (.Ok shared store) =
                            .ok .OutOfFuel := by
                        simpa [hBodyResult] using hSourceIf
                      exact
                        Imported.execSeq_cons_outOfFuel_succ
                          (fuel := sourceFuel.succ)
                          (stmt := .If cond body) (rest := [])
                          (codeOverride := codeOverride)
                          (state := (.Ok shared store : State))
                          hSourceIfOutOfFuel
                  | Checkpoint jump =>
                      have hSourceIfCheckpoint :
                          EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                              codeOverride (.Ok shared store) =
                            .ok (.Checkpoint jump) := by
                        simpa [hBodyResult] using hSourceIf
                      exact
                        Imported.execSeq_cons_checkpoint_succ
                          (fuel := sourceFuel.succ)
                          (stmt := .If cond body) (rest := [])
                          (codeOverride := codeOverride)
                          (state := (.Ok shared store : State))
                          hSourceIfCheckpoint
            have hResultEq : bodyResult = sourceResult := by
              rw [hSourceSeqBody] at hSourceSeq
              exact hSourceSeq
            have hAllowBody : allowed bodyResult := by
              simpa [hResultEq] using hAllow
            obtain
                ⟨sourceOutcomeBody, bodyTargetFuel, hTargetBody,
                  hOutcomeRelBody⟩ :=
              hBody (ctxAfterPre := ctxAfterPre)
                (compilerAfterCond := compilerAfterCond)
                (sourceScopeContains_of_runOpen_regular
                  (layout := layout) (prim := prim) (program := program)
                  (ctx := ctx) (ctxAfter := ctxAfterPre)
                  (fuel := preFuel) (block := { stmts := pre })
                  (state := compiler) (stateAfter := compilerAfterPre)
                  hScopeContains hPreRun)
                (by
                  intro bodySourceResult hBodyAllowed
                  exact
                    SourceResultOutcomeLayoutCompatible.of_handler_eq
                      (ctx := ctx) (ctx' := ctxAfterPre)
                      (layout := layout) (outcomeLayout := outcomeLayout)
                      (sourceResult := bodySourceResult)
                      (Functions.SourceDirect.SourceRun.block_runOpen_regular_breakScope
                        hPreRun)
                      (Functions.SourceDirect.SourceRun.block_runOpen_regular_continueScope
                        hPreRun)
                      (Functions.SourceDirect.SourceRun.block_runOpen_regular_leaveScope
                        hPreRun)
                      (hCompat hBodyAllowed))
                hRelCondExact hAllowBody
            have hCompilerCondTrue :
                Functions.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, true) := by
              have hBoolTrue :
                  (value != EvmYul.UInt256.ofNat 0) = true :=
                word_bne_zero_true_of_ne hNonzero
              change
                Locals.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, true)
              simp [Locals.Source.Expr.evalCondition, hCondRun, hBoolTrue]
            have hIfRun :
                Functions.Source.Block.runOpen prim program ctxAfterPre
                    bodyTargetFuel.succ.succ
                    { stmts := [Functions.Stmt.if_ lowerCond lowerBody] }
                    compilerAfterPre =
                  .ok (sourceOutcomeBody, ctxAfterPre) := by
              cases sourceOutcomeBody with
              | mk bodyState bodyMode =>
                  cases bodyMode <;>
                    simp [Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, hCompilerCondTrue,
                      hTargetBody, Functions.Source.Outcome.regular,
                      Locals.Source.Outcome.regular]
            rcases
                Functions.Source.Block.runOpen_append_regular_exists prim
                  program pre [Functions.Stmt.if_ lowerCond lowerBody]
                  ctx ctxAfterPre compiler compilerAfterPre
                  sourceOutcomeBody ctxAfterPre ⟨preFuel, hPreRun⟩
                  ⟨bodyTargetFuel.succ.succ, hIfRun⟩ with
              ⟨targetFuel, hTarget⟩
            exact
              ⟨sourceOutcomeBody, ctxAfterPre, targetFuel,
                by simpa using hTarget,
                by simpa [hResultEq, bodyResult] using hOutcomeRelBody⟩

theorem sourceResultSeqKontSoundWhenAtExactHiddenCtx_single_if_of_eval_domain
    {cfg : StateRelConfig} {layout : List Name}
    {konts : SourceModeKontLayouts}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat}
    {cond : AstExpr} {body : List AstStmt}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lowerCond : Locals.Expr 1} {lowerBody : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hSupported :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultModeKontSupported ctx layout konts
          sourceResult)
    (hWithin : SourceModeKontLayouts.ControlWithin layout konts)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hCondTerminal :
      SourceExprPreludeTerminalAt cfg layout layout terminalRel
        revertRel prim program ctx sourceFuel cond codeOverride pre)
    (hCondSound :
      ExprEvalPreludeSound cfg layout prim program ctx sourceFuel cond
        codeOverride pre lowerCond)
    (hResultOk :
      ExprEvalResultOkAt cfg layout sourceFuel cond codeOverride)
    (hEvalDomain :
      ∀ {shared store sharedAfter storeAfter value},
        StoreDomainExact layout store →
        EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter, value) →
        StoreDomainExact layout storeAfter)
    (hBody :
      ∀ {sharedAfterCond storeAfterCond ctxAfterPre compilerAfterCond},
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        (∀ {sourceResult}, allowed sourceResult →
          SourceResultModeKontSupported ctxAfterPre layout konts
            sourceResult) →
        SourceStateExactRel cfg layout
          (.Ok sharedAfterCond storeAfterCond) compilerAfterCond →
        allowed
          (EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
            (.Ok sharedAfterCond storeAfterCond)) →
        ∃ sourceOutcomeBody : Objects.Source.Outcome,
        ∃ bodyTargetFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyTargetFuel compilerAfterCond =
            .ok sourceOutcomeBody ∧
          SourceResultKontOutcomeRel cfg konts terminalRel revertRel
            (EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
              (.Ok sharedAfterCond storeAfterCond))
            sourceOutcomeBody) :
    SourceResultSeqKontSoundWhenAtExactHiddenCtx cfg layout konts
      terminalRel revertRel prim program ctx sourceFuel.succ.succ
      [.If cond body] codeOverride
      { stmts := pre ++ [Functions.Stmt.if_ lowerCond lowerBody] }
      allowed := by
  intro source compiler sourceResult hInitial hAllow hSourceSeq
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomain =>
      let hExact :
          SourceStateExactRel cfg layout (.Ok shared store) compiler :=
        SourceStateExactRel.ok hShared hVars hDomain
      let hInitialRel :
          SourceStateRel cfg layout (.Ok shared store) compiler :=
        SourceStateRel.ok hShared hVars
      cases hEval :
          EvmYul.Yul.eval sourceFuel cond codeOverride (.Ok shared store) with
      | error err =>
          have hSourceIf :
              EvmYul.Yul.exec sourceFuel.succ (.If cond body) codeOverride
                  (.Ok shared store) =
                .error err := by
            rw [Imported.exec_if_succ]
            simp [hEval]
          have hSourceSeqErr :
              EvmYul.Yul.execSeq sourceFuel.succ.succ [.If cond body]
                  codeOverride (.Ok shared store) =
                .error err :=
            Imported.execSeq_cons_error_succ
              (fuel := sourceFuel.succ) (stmt := .If cond body)
              (rest := []) (codeOverride := codeOverride)
              (state := (.Ok shared store : State)) hSourceIf
          have hResultEq : (.error err : Except Exception State) = sourceResult := by
            rw [hSourceSeqErr] at hSourceSeq
            exact hSourceSeq
          have hRelatableErr : SourceResultRelatable (.error err) := by
            simpa [hResultEq] using hAllowed hAllow
          rcases
              (SourceExprPreludeTerminalAt.append_suffix
                (suffix := [Functions.Stmt.if_ lowerCond lowerBody])
                hCondTerminal) hExact hEval hRelatableErr with
            ⟨sourceOutcome, ctxAfter, targetFuel, hTarget, hOutcomeRel⟩
          have hAllowErr : allowed (.error err) := by
            rw [hResultEq]
            exact hAllow
          have hKontRel :
              SourceResultKontOutcomeRel cfg konts terminalRel revertRel
                (.error err) sourceOutcome :=
            SourceResultOutcomeRel.to_kont_of_supported_within
              (cfg := cfg) (layout := layout) (konts := konts) (ctx := ctx)
              (terminalRel := terminalRel) (revertRel := revertRel)
              (sourceResult := .error err) (sourceOutcome := sourceOutcome)
              (hSupported := hSupported hAllowErr) (hWithin := hWithin)
              (hRel := hOutcomeRel)
          exact
            ⟨sourceOutcome, ctxAfter, targetFuel, by simpa using hTarget,
              by simpa [hResultEq] using hKontRel⟩
      | ok evalResult =>
          rcases evalResult with ⟨sourceAfterCond, value⟩
          rcases hResultOk hInitialRel hEval with
            ⟨sharedAfterCond, storeAfterCond, hAfterEq⟩
          subst sourceAfterCond
          by_cases hZero : value = EvmYul.UInt256.ofNat 0
          · subst value
            have hEvalZero :
                EvmYul.Yul.eval sourceFuel cond codeOverride
                    (.Ok shared store) =
                  .ok
                    ((.Ok sharedAfterCond storeAfterCond : State),
                      EvmYul.UInt256.ofNat 0) := by
              simpa using hEval
            rcases
                hCondSound.run_exact_of_eval_domain
                  (cfg := cfg) (layout := layout) (prim := prim)
                  (program := program) (ctx := ctx)
                  (sourceFuel := sourceFuel) (sourceExpr := cond)
                  (codeOverride := codeOverride) (pre := pre)
                  (lowerExpr := lowerCond) (shared := shared)
                  (sharedAfter := sharedAfterCond) (store := store)
                  (storeAfter := storeAfterCond) (compiler := compiler)
                  (value := EvmYul.UInt256.ofNat 0)
                  (hEvalDomain := hEvalDomain) hDomain hInitialRel
                  hEvalZero with
              ⟨compilerAfterPre, compilerAfterCond, ctxAfterPre, preFuel,
                hPreRun, hCondRun, hRelCondExact⟩
            have hSourceIf :
                EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                    codeOverride (.Ok shared store) =
                  .ok (.Ok sharedAfterCond storeAfterCond) := by
              have hZeroRaw :
                  EvmYul.UInt256.ofNat 0 = ({ val := 0 } : Word) := by
                rfl
              rw [Imported.exec_if_succ]
              simp [hEvalZero, hZeroRaw]
            have hSourceSeqRegular :
                EvmYul.Yul.execSeq sourceFuel.succ.succ [.If cond body]
                    codeOverride (.Ok shared store) =
                  .ok (.Ok sharedAfterCond storeAfterCond) :=
              Imported.execSeq_cons_ok_result_succ
                (fuel := sourceFuel.succ) (stmt := .If cond body)
                (rest := []) (codeOverride := codeOverride)
                (state := (.Ok shared store : State))
                (shared := sharedAfterCond) (store := storeAfterCond)
                (result := .ok (.Ok sharedAfterCond storeAfterCond))
                hSourceIf
                (Imported.execSeq_nil_succ sourceFuel codeOverride
                  (.Ok sharedAfterCond storeAfterCond : State))
            have hResultEq :
                (.ok (.Ok sharedAfterCond storeAfterCond) :
                    Except Exception State) = sourceResult := by
              rw [hSourceSeqRegular] at hSourceSeq
              exact hSourceSeq
            have hCompilerCondFalse :
                Functions.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, false) := by
              have hBoolFalse :
                  (EvmYul.UInt256.ofNat 0 != EvmYul.UInt256.ofNat 0) =
                    false :=
                word_bne_zero_false_of_eq rfl
              change
                Locals.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, false)
              simp [Locals.Source.Expr.evalCondition, hCondRun, hBoolFalse]
            have hIfRun :
                Functions.Source.Block.runOpen prim program ctxAfterPre 2
                    { stmts := [Functions.Stmt.if_ lowerCond lowerBody] }
                    compilerAfterPre =
                  .ok (Functions.Source.Outcome.regular compilerAfterCond,
                    ctxAfterPre) := by
              simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hCompilerCondFalse, Functions.Source.Outcome.regular,
                Locals.Source.Outcome.regular]
            rcases
                Functions.Source.Block.runOpen_append_regular_exists prim
                  program pre [Functions.Stmt.if_ lowerCond lowerBody]
                  ctx ctxAfterPre compiler compilerAfterPre
                  (Functions.Source.Outcome.regular compilerAfterCond)
                  ctxAfterPre ⟨preFuel, hPreRun⟩ ⟨2, hIfRun⟩ with
              ⟨targetFuel, hTarget⟩
            have hAllowRegular :
                allowed (.ok (.Ok sharedAfterCond storeAfterCond)) := by
              rw [hResultEq]
              exact hAllow
            exact
              ⟨Functions.Source.Outcome.regular compilerAfterCond,
                ctxAfterPre, targetFuel, by simpa using hTarget,
                by
                  have hRelVisible :
                      SourceStateRel cfg layout
                        (.Ok sharedAfterCond storeAfterCond)
                        compilerAfterCond :=
                    SourceStateExactRel.toRel hRelCondExact
                  have hRelRegular :
                      SourceStateRel cfg konts.regular
                        (.Ok sharedAfterCond storeAfterCond)
                        compilerAfterCond :=
                    SourceResultOutcomeRel.sourceStateRel_weaken_sameCompiler
                      (cfg := cfg) (layoutSmall := konts.regular)
                      (layoutBig := layout)
                      hRelVisible (hSupported hAllowRegular)
                  have hRelOk :
                      SourceResultKontOutcomeRel cfg konts terminalRel revertRel
                        (.ok (.Ok sharedAfterCond storeAfterCond))
                        (Functions.Source.Outcome.regular
                          compilerAfterCond) :=
                    SourceResultKontOutcomeRel.ok
                      (SourceOkKontOutcomeRel.regular hRelRegular)
                  simpa [hResultEq] using hRelOk⟩
          · have hNonzero : value ≠ EvmYul.UInt256.ofNat 0 := by
              exact hZero
            rcases
                hCondSound.run_exact_of_eval_domain
                  (cfg := cfg) (layout := layout) (prim := prim)
                  (program := program) (ctx := ctx)
                  (sourceFuel := sourceFuel) (sourceExpr := cond)
                  (codeOverride := codeOverride) (pre := pre)
                  (lowerExpr := lowerCond) (shared := shared)
                  (sharedAfter := sharedAfterCond) (store := store)
                  (storeAfter := storeAfterCond) (compiler := compiler)
                  (value := value) (hEvalDomain := hEvalDomain)
                  hDomain hInitialRel hEval with
              ⟨compilerAfterPre, compilerAfterCond, ctxAfterPre, preFuel,
                hPreRun, hCondRun, hRelCondExact⟩
            let bodyResult : Except Exception State :=
              EvmYul.Yul.exec sourceFuel (.Block body) codeOverride
                (.Ok sharedAfterCond storeAfterCond)
            have hSourceIf :
                EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                    codeOverride (.Ok shared store) =
                  bodyResult := by
              have hNonzeroRaw : value ≠ ({ val := 0 } : Word) := by
                simpa using hNonzero
              rw [Imported.exec_if_succ]
              simp [hEval, hNonzeroRaw, bodyResult]
            have hSourceSeqBody :
                EvmYul.Yul.execSeq sourceFuel.succ.succ [.If cond body]
                    codeOverride (.Ok shared store) =
                  bodyResult := by
              cases hBodyResult : bodyResult with
              | error err =>
                  have hSourceIfErr :
                      EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                          codeOverride (.Ok shared store) =
                        .error err := by
                    simpa [hBodyResult] using hSourceIf
                  exact
                    Imported.execSeq_cons_error_succ
                      (fuel := sourceFuel.succ) (stmt := .If cond body)
                      (rest := []) (codeOverride := codeOverride)
                      (state := (.Ok shared store : State)) hSourceIfErr
              | ok bodyState =>
                  cases bodyState with
                  | Ok sharedBody storeBody =>
                      have hSourceIfOk :
                          EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                              codeOverride (.Ok shared store) =
                            .ok (.Ok sharedBody storeBody) := by
                        simpa [hBodyResult] using hSourceIf
                      exact
                        Imported.execSeq_cons_ok_result_succ
                          (fuel := sourceFuel.succ)
                          (stmt := .If cond body) (rest := [])
                          (codeOverride := codeOverride)
                          (state := (.Ok shared store : State))
                          hSourceIfOk
                          (Imported.execSeq_nil_succ sourceFuel codeOverride
                            (.Ok sharedBody storeBody : State))
                  | OutOfFuel =>
                      have hSourceIfOutOfFuel :
                          EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                              codeOverride (.Ok shared store) =
                            .ok .OutOfFuel := by
                        simpa [hBodyResult] using hSourceIf
                      exact
                        Imported.execSeq_cons_outOfFuel_succ
                          (fuel := sourceFuel.succ)
                          (stmt := .If cond body) (rest := [])
                          (codeOverride := codeOverride)
                          (state := (.Ok shared store : State))
                          hSourceIfOutOfFuel
                  | Checkpoint jump =>
                      have hSourceIfCheckpoint :
                          EvmYul.Yul.exec sourceFuel.succ (.If cond body)
                              codeOverride (.Ok shared store) =
                            .ok (.Checkpoint jump) := by
                        simpa [hBodyResult] using hSourceIf
                      exact
                        Imported.execSeq_cons_checkpoint_succ
                          (fuel := sourceFuel.succ)
                          (stmt := .If cond body) (rest := [])
                          (codeOverride := codeOverride)
                          (state := (.Ok shared store : State))
                          hSourceIfCheckpoint
            have hResultEq : bodyResult = sourceResult := by
              rw [hSourceSeqBody] at hSourceSeq
              exact hSourceSeq
            have hAllowBody : allowed bodyResult := by
              simpa [hResultEq] using hAllow
            obtain
                ⟨sourceOutcomeBody, bodyTargetFuel, hTargetBody,
                  hOutcomeRelBody⟩ :=
              hBody (ctxAfterPre := ctxAfterPre)
                (compilerAfterCond := compilerAfterCond)
                (sourceScopeContains_of_runOpen_regular
                  (layout := layout) (prim := prim) (program := program)
                  (ctx := ctx) (ctxAfter := ctxAfterPre)
                  (fuel := preFuel) (block := { stmts := pre })
                  (state := compiler) (stateAfter := compilerAfterPre)
                  hScopeContains hPreRun)
                (by
                  intro bodySourceResult hBodyAllowed
                  exact
                    SourceResultModeKontSupported.of_handler_eq
                      (ctx := ctx) (ctx' := ctxAfterPre)
                      (currentLayout := layout) (konts := konts)
                      (sourceResult := bodySourceResult)
                      (Functions.SourceDirect.SourceRun.block_runOpen_regular_breakScope
                        hPreRun)
                      (Functions.SourceDirect.SourceRun.block_runOpen_regular_continueScope
                        hPreRun)
                      (Functions.SourceDirect.SourceRun.block_runOpen_regular_leaveScope
                        hPreRun)
                      (hSupported hBodyAllowed))
                hRelCondExact hAllowBody
            have hCompilerCondTrue :
                Functions.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, true) := by
              have hBoolTrue :
                  (value != EvmYul.UInt256.ofNat 0) = true :=
                word_bne_zero_true_of_ne hNonzero
              change
                Locals.Source.Expr.evalCondition prim lowerCond
                    compilerAfterPre =
                  .ok (compilerAfterCond, true)
              simp [Locals.Source.Expr.evalCondition, hCondRun, hBoolTrue]
            have hIfRun :
                Functions.Source.Block.runOpen prim program ctxAfterPre
                    bodyTargetFuel.succ.succ
                    { stmts := [Functions.Stmt.if_ lowerCond lowerBody] }
                    compilerAfterPre =
                  .ok (sourceOutcomeBody, ctxAfterPre) := by
              cases sourceOutcomeBody with
              | mk bodyState bodyMode =>
                  cases bodyMode <;>
                    simp [Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, hCompilerCondTrue,
                      hTargetBody, Functions.Source.Outcome.regular,
                      Locals.Source.Outcome.regular]
            rcases
                Functions.Source.Block.runOpen_append_regular_exists prim
                  program pre [Functions.Stmt.if_ lowerCond lowerBody]
                  ctx ctxAfterPre compiler compilerAfterPre
                  sourceOutcomeBody ctxAfterPre ⟨preFuel, hPreRun⟩
                  ⟨bodyTargetFuel.succ.succ, hIfRun⟩ with
              ⟨targetFuel, hTarget⟩
            exact
              ⟨sourceOutcomeBody, ctxAfterPre, targetFuel,
                by simpa using hTarget,
                by simpa [hResultEq, bodyResult] using hOutcomeRelBody⟩

/--
Compositional singleton generated-prelude `switch` bridge.

The scrutinee is compiled through the same generated expression prelude used by
`if`.  After the prelude, target selection has two source-facing cases:
`none`, which corresponds to the patched Yul no-default/no-match empty block,
and `some lowerBody`, which is delegated to a selected-body block proof.
-/
theorem sourceResultSeqSoundWhenAtExactHiddenCtx_single_switch_of_eval_domain
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat}
    {scrutinee : AstExpr} {cases : List (Word × List AstStmt)}
    {defaultBody : List AstStmt}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lowerScrutinee : Locals.Expr 1}
    {lowerCases : List (Word × Functions.Block)}
    {lowerDefault : Option Functions.Block}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope)
    (hScrutineeTerminal :
      SourceExprPreludeTerminalAt cfg layout outcomeLayout terminalRel
        revertRel prim program ctx sourceFuel scrutinee codeOverride pre)
    (hScrutineeSound :
      ExprEvalPreludeSound cfg layout prim program ctx sourceFuel scrutinee
        codeOverride pre lowerScrutinee)
    (hResultOk :
      ExprEvalResultOkAt cfg layout sourceFuel scrutinee codeOverride)
    (hEvalDomain :
      ∀ {shared store sharedAfter storeAfter value},
        StoreDomainExact layout store →
        EvmYul.Yul.eval sourceFuel scrutinee codeOverride
            (.Ok shared store) =
          .ok (.Ok sharedAfter storeAfter, value) →
        StoreDomainExact layout storeAfter)
    (hNoMatch :
      ∀ {value : Word},
        Functions.Switch.select value lowerCases lowerDefault = none →
        EvmYul.Yul.selectSwitchCase value defaultBody cases = [])
    (hSelected :
      ∀ {value : Word} {selectedBody : List AstStmt}
        {lowerBody : Functions.Block}
        {sharedAfterCond : EvmYul.SharedState .Yul}
        {storeAfterCond : EvmYul.Yul.VarStore}
        {ctxAfterPre : Functions.Source.Ctx}
        {compilerAfterCond : Objects.Source.State},
        EvmYul.Yul.selectSwitchCase value defaultBody cases =
          selectedBody →
        Functions.Switch.select value lowerCases lowerDefault =
          some lowerBody →
        (∀ name : Name, name ∈ layout → name ∈ ctxAfterPre.scope) →
        (∀ {sourceResult}, allowed sourceResult →
          SourceResultOutcomeLayoutCompatible ctxAfterPre layout outcomeLayout
            sourceResult) →
        SourceStateExactRel cfg layout
          (.Ok sharedAfterCond storeAfterCond) compilerAfterCond →
        allowed
          (EvmYul.Yul.exec sourceFuel (.Block selectedBody) codeOverride
            (.Ok sharedAfterCond storeAfterCond)) →
        ∃ sourceOutcomeBody : Objects.Source.Outcome,
        ∃ bodyTargetFuel : Nat,
          Functions.Source.Block.runScoped prim program ctxAfterPre lowerBody
              bodyTargetFuel compilerAfterCond =
            .ok sourceOutcomeBody ∧
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (EvmYul.Yul.exec sourceFuel (.Block selectedBody) codeOverride
              (.Ok sharedAfterCond storeAfterCond))
            sourceOutcomeBody) :
    SourceResultSeqSoundWhenAtExactHiddenCtx cfg layout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel.succ.succ
      [.Switch scrutinee cases defaultBody] codeOverride
      { stmts :=
        pre ++ [Functions.Stmt.switch lowerScrutinee lowerCases lowerDefault] }
      allowed := by
  intro source compiler sourceResult hInitial hAllow hSourceSeq
  cases hInitial with
  | @ok shared store compiler hShared hVars hDomain =>
      let hExact :
          SourceStateExactRel cfg layout (.Ok shared store) compiler :=
        SourceStateExactRel.ok hShared hVars hDomain
      let hInitialRel :
          SourceStateRel cfg layout (.Ok shared store) compiler :=
        SourceStateRel.ok hShared hVars
      cases hEval :
          EvmYul.Yul.eval sourceFuel scrutinee codeOverride
            (.Ok shared store) with
      | error err =>
          have hSourceSwitch :
              EvmYul.Yul.exec sourceFuel.succ
                  (.Switch scrutinee cases defaultBody) codeOverride
                  (.Ok shared store) =
                .error err := by
            rw [Imported.exec_switch_succ]
            simp [hEval]
          have hSourceSeqErr :
              EvmYul.Yul.execSeq sourceFuel.succ.succ
                  [.Switch scrutinee cases defaultBody]
                  codeOverride (.Ok shared store) =
                .error err :=
            Imported.execSeq_cons_error_succ
              (fuel := sourceFuel.succ)
              (stmt := .Switch scrutinee cases defaultBody)
              (rest := []) (codeOverride := codeOverride)
              (state := (.Ok shared store : State)) hSourceSwitch
          have hResultEq : (.error err : Except Exception State) = sourceResult := by
            rw [hSourceSeqErr] at hSourceSeq
            exact hSourceSeq
          have hRelatableErr : SourceResultRelatable (.error err) := by
            simpa [hResultEq] using hAllowed hAllow
          rcases
              (SourceExprPreludeTerminalAt.append_suffix
                (suffix :=
                  [Functions.Stmt.switch lowerScrutinee lowerCases
                    lowerDefault])
                hScrutineeTerminal) hExact hEval hRelatableErr with
            ⟨sourceOutcome, ctxAfter, targetFuel, hTarget, hOutcomeRel⟩
          exact
            ⟨sourceOutcome, ctxAfter, targetFuel, by simpa using hTarget,
              by simpa [hResultEq] using hOutcomeRel⟩
      | ok evalResult =>
          rcases evalResult with ⟨sourceAfterCond, value⟩
          rcases hResultOk hInitialRel hEval with
            ⟨sharedAfterCond, storeAfterCond, hAfterEq⟩
          subst sourceAfterCond
          rcases
              hScrutineeSound.run_exact_of_eval_domain
                (cfg := cfg) (layout := layout) (prim := prim)
                (program := program) (ctx := ctx)
                (sourceFuel := sourceFuel) (sourceExpr := scrutinee)
                (codeOverride := codeOverride) (pre := pre)
                (lowerExpr := lowerScrutinee) (shared := shared)
                (sharedAfter := sharedAfterCond) (store := store)
                (storeAfter := storeAfterCond) (compiler := compiler)
                (value := value) (hEvalDomain := hEvalDomain)
                hDomain hInitialRel hEval with
            ⟨compilerAfterPre, compilerAfterCond, ctxAfterPre, preFuel,
              hPreRun, hScrutineeRun, hRelCondExact⟩
          let selectedBody : List AstStmt :=
            EvmYul.Yul.selectSwitchCase value defaultBody cases
          let bodyResult : Except Exception State :=
            EvmYul.Yul.exec sourceFuel (.Block selectedBody) codeOverride
              (.Ok sharedAfterCond storeAfterCond)
          have hSourceSwitch :
              EvmYul.Yul.exec sourceFuel.succ
                  (.Switch scrutinee cases defaultBody) codeOverride
                  (.Ok shared store) =
                bodyResult := by
            rw [Imported.exec_switch_succ]
            simp [hEval, selectedBody, bodyResult]
          have hSourceSeqBody :
