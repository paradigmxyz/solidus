            pre [Functions.Stmt.if_ lowerCond lowerBody]
            ctx ctxAfterPre compiler compilerAfterPre
            sourceOutcomeBody ctxAfterPre ⟨preFuel, hPreRun⟩
            ⟨bodyTargetFuel.succ.succ, hIfRun⟩ with
        ⟨targetFuel, hTarget⟩
      exact
        ⟨sourceResultBody, sourceOutcomeBody, ctxAfterPre, targetFuel,
          hSourceHead, by simpa using hTarget, hOutcomeRelBody,
          hNonregularBody⟩

/--
Scope-aware true/nonregular generated-prelude `if` bridge with typed
