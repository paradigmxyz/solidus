        Stmt.toFunctionsListFuel? fuel state stmt = some (lower, state'))
      (hNoCall :
        Functions.LiveLayout.NoInternalCall.StmtList.Holds lower) :
      StmtNoUserCalls stmt := by
    cases fuel with
    | zero =>
        simp [Stmt.toFunctionsListFuel?] at hLower
