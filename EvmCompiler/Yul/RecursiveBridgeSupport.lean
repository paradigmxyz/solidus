    ⟨stmtFuel, stmtCtxAfter, hStmtRun⟩
  exact
    ⟨stmtFuel, loopResult, sourceOutcome, stmtCtxAfter, hSource, hStmtRun,
      hScope, hOutcomeRel, hMode⟩

theorem blockRunOpen_of_runScoped_nonregular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state : Objects.Source.State} {outcome : Objects.Source.Outcome}
    (hRun :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome)
    (hMode : outcome.mode ≠ Locals.Source.Mode.regular) :
    ∃ ctxAfter : Functions.Source.Ctx,
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (outcome, ctxAfter) := by
  unfold Functions.Source.Block.runScoped at hRun
  cases hOpen :
      Functions.Source.Block.runOpen prim program ctx fuel block state with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨openOutcome, ctxAfter⟩
      cases openOutcome with
      | mk openState openMode =>
          cases openMode
          · simp [hOpen, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] at hRun
            subst outcome
            exact False.elim (hMode rfl)
          · simp [hOpen] at hRun
            subst outcome
            exact ⟨ctxAfter, by simpa [hOpen]⟩
          · simp [hOpen] at hRun
            subst outcome
            exact ⟨ctxAfter, by simpa [hOpen]⟩
          · simp [hOpen] at hRun
            subst outcome
            exact ⟨ctxAfter, by simpa [hOpen]⟩
          · simp [hOpen] at hRun
            subst outcome
            exact ⟨ctxAfter, by simpa [hOpen]⟩

theorem singletonBlockStmtRunOpen_of_runScoped
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {block : Functions.Block} {fuel : Nat}
    {state : Objects.Source.State} {outcome : Objects.Source.Outcome}
    (hRun :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome) :
    ∃ targetFuel : Nat, ∃ ctxAfter : Functions.Source.Ctx,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := [Functions.Stmt.block block] } state =
        .ok (outcome, ctxAfter) := by
  cases fuel with
  | zero =>
      simp [Functions.Source.Block.runScoped, Functions.Source.Block.runOpen,
        Functions.Source.invalid, Structured.invalid] at hRun
  | succ fuel =>
      refine ⟨fuel.succ.succ, ctx, ?_⟩
      cases outcome with
      | mk outcomeState outcomeMode =>
          cases outcomeMode <;>
            simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
              hRun, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular]

theorem sourceRegularStmtRunHiddenExact_for_of_singleton_hiddenBlockSound_ok
    {cfg : StateRelConfig} {reserved layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
