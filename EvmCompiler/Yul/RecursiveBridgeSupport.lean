theorem sourceUserCallBodyDoneRel_of_seq_checkpoint_contains
    {cfg : StateRelConfig} {bodyLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
