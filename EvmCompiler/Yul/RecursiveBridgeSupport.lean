                refine ⟨lowerHeadStmts.length + headFuel, by omega, ?_⟩
                exact
                    OpenExternal.OpenResultPathRel.of_resolves_of_responsesSatisfy
                      hSourceSeqResolve hTargetFull hResponses (by
                        intro _hAllowed
