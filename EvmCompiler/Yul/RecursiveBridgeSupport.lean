context.

This is the terminal-call sibling of `SourceArgStackPreludeRegularAt`: the
source relation remains over the visible `layout`, while the target context may
already contain compiler-only names introduced by earlier generated code.
-/
theorem SourceArgStackPreludeRegularAt.run_terminalArgs_general
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {kind : Assembly.HaltKind}
    {lower : Locals.ExprSeq kind.argCount}
    {source sourceAfter : State} {compiler : Objects.Source.State}
    {values : List Word}
    (hBridge :
      SourceArgStackPreludeRegularAt cfg layout prim program ctx sourceFuel
        args codeOverride pre lower)
    (hInitial : SourceStateRel cfg layout source compiler)
    (hEval :
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source =
        .ok (sourceAfter, values.reverse))
    (hTerminal :
      ∀ {compilerAfterArgs : Objects.Source.State},
        SourceStateRel cfg layout sourceAfter compilerAfterArgs →
          ∃ sharedAfter,
            prim.terminal kind compilerAfterArgs.shared values.reverse =
              .ok sharedAfter) :
    ∃ compilerAfterArgs : Objects.Source.State,
    ∃ sharedAfter : EvmYul.SharedState .EVM,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre ++ [Functions.Stmt.terminalArgs kind lower] }
          compiler =
        .ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfter) ∧
      SourceStateRel cfg layout sourceAfter compilerAfterArgs ∧
      prim.terminal kind compilerAfterArgs.shared values.reverse =
        .ok sharedAfter := by
  rcases hBridge hInitial hEval with
    ⟨compilerAfterPre, compilerAfterArgs, ctxAfter, preFuel,
      hPreRun, hArgsRun, hRelArgs⟩
  rcases hTerminal hRelArgs with ⟨sharedAfter, hTerminalRun⟩
  have hTail :
      Functions.Source.Block.runOpen prim program ctxAfter 1
          { stmts := [Functions.Stmt.terminalArgs kind lower] }
          compilerAfterPre =
        .ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter), ctxAfter) := by
    simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
      hArgsRun, hTerminalRun, Functions.Source.Outcome.halt,
      Locals.Source.Outcome.halt]
  rcases
      Functions.Source.Block.runOpen_append_regular_exists prim program
        pre [Functions.Stmt.terminalArgs kind lower] ctx ctxAfter compiler
        compilerAfterPre
        (Functions.Source.Outcome.halt kind
          (compilerAfterArgs.withShared sharedAfter))
        ctxAfter ⟨preFuel, hPreRun⟩ ⟨1, hTail⟩ with
    ⟨targetFuel, hCombined⟩
  exact ⟨compilerAfterArgs, sharedAfter, ctxAfter, targetFuel, hCombined,
    hRelArgs, hTerminalRun⟩

