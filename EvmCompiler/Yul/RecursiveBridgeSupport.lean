/--
Regular hidden-head bridge for a generated `for` under a hidden target context
whose body and post block both fall through regularly.

The recursive loop step still runs in the original target context `ctx`; only
the generated body/post subcontexts use full hidden handler scopes.
-/
def SourceRegularGeneratedForLoopStmtRun
    (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) (lowerCond : Functions.Expr 1)
    (lowerPost lowerBody : Functions.Block)
    (source : State) (compiler : Objects.Source.State) : Prop :=
  ∃ targetFuel : Nat, ∃ sourceAfter : State,
  ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.exec sourceFuel (.For cond post body) codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Stmt.run prim program ctx targetFuel
        (Functions.Stmt.for_ { stmts := [] }
          (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
          { stmts :=
              pre ++
                (Functions.Stmt.if_
                  (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                  { stmts := [Functions.Stmt.brk] } ::
                lowerBody.stmts) })
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    (∀ name : Name, name ∈ layout → name ∈ layout) ∧
    SourceStateExactRel cfg layout sourceAfter compilerAfter

def SourceNonregularGeneratedForLoopStmtRun
    (cfg : StateRelConfig) (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (cond : AstExpr) (post body : List AstStmt)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) (lowerCond : Functions.Expr 1)
    (lowerPost lowerBody : Functions.Block)
    (source : State) (compiler : Objects.Source.State) : Prop :=
  ∃ targetFuel : Nat, ∃ sourceResult : Except Exception State,
  ∃ sourceOutcome : Objects.Source.Outcome,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.exec sourceFuel (.For cond post body) codeOverride source =
      sourceResult ∧
    Functions.Source.Stmt.run prim program ctx targetFuel
        (Functions.Stmt.for_ { stmts := [] }
          (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
          { stmts :=
              pre ++
                (Functions.Stmt.if_
                  (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                  { stmts := [Functions.Stmt.brk] } ::
                lowerBody.stmts) })
        compiler =
      .ok (sourceOutcome, ctxAfter) ∧
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult sourceOutcome ∧
    sourceOutcome.mode ≠ Locals.Source.Mode.regular

