The caller-side singleton block has four successor ticks around the argument
prelude and assignment path; the recursive callee proof only needs
`sourceFuel.succ ≤ bound`, recovered from `hSuccFuel`.
-/
theorem checkedStmtBlockLoweringSoundWhenFreshNamesAtExact_assign_user_call_of_program_recursive_actual_succ
    {cfg : StateRelConfig} {reserved layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {yulProgram : Program} {program : Functions.Program}
    {bound : Nat}
    {ctx : Functions.Source.Ctx} {sourceFuel : Nat}
    {names : List EvmYul.Identifier} {functionName : Name}
    {args : List AstExpr}
    {allowed : Except Exception State → Prop}
    (hRecursive :
      ProgramRecursiveSourceBridgeWhenUpToAtExactCompatNames cfg terminalRel
        revertRel prim yulProgram program bound)
    (hSuccFuel : sourceFuel.succ.succ.succ.succ ≤ bound.succ)
    (hAllowedRel :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout)
    (hCompat :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
          sourceResult)
    (hCheckpoint : CheckpointExpressionSound)
    (hSafe : Safe.program yulProgram)
    (hScoped : ControlFlow.ProgramScoped yulProgram)
    (hToObjects :
      yulProgram.toObjects? =
        some { root := Objects.Object.mk "root" program [] [] })
    (hNoShadowing : Safe.NoShadowing.program yulProgram)
    (hStmtOk :
      UserCallArity.StmtOk yulProgram.contract
        (.Assign names (.Call (.inr functionName) args)))
    (hNames :
      names = [] ∨ (∃ name, names = [name]) ∨
      ∃ name next rest, names = name :: next :: rest)
    (hTargetsNoDup : (identNames names).Nodup)
    (hSafeStmt :
      Safe.stmt (.Assign names (.Call (.inr functionName) args)))
    (hArgsDirect :
      ∀ {freshState lowerArgs},
        FreshCoversLayout (reserved ++ layout) freshState →
        Expr.List.directCallArgsSafe? args = true →
        Expr.List.toLocals1? args = some lowerArgs →
        SourceArgListPreludeRegularAt cfg layout prim program ctx sourceFuel
          args (some yulProgram.contract) [] lowerArgs)
    (hArgsLower :
      ∀ {freshState freshState' pre lowerArgs},
        FreshCoversLayout (reserved ++ layout) freshState →
        Expr.List.directCallArgsSafe? args = false →
        Expr.List.lowerBound1? freshState args =
          some (pre, lowerArgs, freshState') →
        SourceArgListPreludeRegularAt cfg layout prim program ctx sourceFuel
          args (some yulProgram.contract) pre lowerArgs)
    (hArgEval :
      ∀ {shared store compiler sourceResult},
        SourceStateExactRel cfg layout (.Ok shared store) compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel.succ.succ.succ.succ
            (.Block [.Assign names (.Call (.inr functionName) args)])
            (some yulProgram.contract) (.Ok shared store) =
          sourceResult →
        ∃ sourceAfterArgs : State,
        ∃ argValues : List Word,
          EvmYul.Yul.evalArgs sourceFuel args.reverse
              (some yulProgram.contract) (.Ok shared store) =
            .ok (sourceAfterArgs, argValues.reverse))
    (hBodyFresh :
      ∀ {lowerFn : Functions.FunDef}
        {params returns : List EvmYul.Identifier} {body : List AstStmt}
        {freshBefore freshAfter : Fresh.State},
        yulProgram.contract.functions.lookup functionName =
          some (.Def params returns body) →
        Functions.Source.FunList.find? functionName program.functions =
          some lowerFn →
        Stmt.List.toBlock? freshBefore body =
          some (lowerFn.body, freshAfter) →
        lowerFn.params = identNames params →
        lowerFn.returns = identNames returns →
        FreshCoversLayout (lowerFn.returns ++ lowerFn.params)
          freshBefore) :
    CheckedStmtBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
      outcomeLayout terminalRel revertRel prim program ctx
      sourceFuel.succ.succ.succ.succ
      (.Assign names (.Call (.inr functionName) args))
      (some yulProgram.contract) allowed :=
  checkedStmtBlockLoweringSoundWhenFreshNamesAtExact_assign_user_call_of_program_recursive_actual
    (cfg := cfg) (reserved := reserved) (layout := layout)
    (outcomeLayout := outcomeLayout) (terminalRel := terminalRel)
    (revertRel := revertRel) (prim := prim) (yulProgram := yulProgram)
    (program := program) (bound := bound) (ctx := ctx)
    (sourceFuel := sourceFuel) (names := names)
    (functionName := functionName) (args := args) (allowed := allowed)
    hRecursive (by omega) hAllowedRel hScope hCompat hCheckpoint hSafe
    hScoped hToObjects hNoShadowing hStmtOk hNames hTargetsNoDup
    (safe_exprs_of_safe_assign_user_call hSafeStmt)
    (unsupported_false_of_safe_assign_user_call hSafeStmt)
    hArgsDirect hArgsLower hArgEval hBodyFresh

