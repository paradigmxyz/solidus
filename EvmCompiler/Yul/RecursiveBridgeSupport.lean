theorem UserCallArity.ExprsOk.append
    {contract : AstContract} {left right : List AstExpr}
    (hLeft : UserCallArity.ExprsOk contract left)
    (hRight : UserCallArity.ExprsOk contract right) :
    UserCallArity.ExprsOk contract (left ++ right) := by
  induction left with
  | nil =>
      simpa using hRight
  | cons head tail ih =>
      simp [UserCallArity.ExprsOk] at hLeft
      simp [UserCallArity.ExprsOk, hLeft.1, ih hLeft.2]

theorem UserCallArity.ExprsOk.reverse
    {contract : AstContract} {args : List AstExpr}
    (hOk : UserCallArity.ExprsOk contract args) :
    UserCallArity.ExprsOk contract args.reverse := by
  induction args with
  | nil =>
      simp [UserCallArity.ExprsOk]
  | cons head tail ih =>
      simp [UserCallArity.ExprsOk] at hOk
      simpa using
        UserCallArity.ExprsOk.append (ih hOk.2)
          (by simp [UserCallArity.ExprsOk, hOk.1])

/--
Source-only expression result shape from an arbitrary ordinary imported Yul
state.

This is deliberately independent of `SourceStateRel`: it is the induction
principle needed for expression arguments, whose successful evaluation changes
the source state before the next argument is evaluated.
-/
def ExprEvalResultOkFromOkAt
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract) : Prop :=
  ∀ {shared store sourceAfter value},
    EvmYul.Yul.eval sourceFuel expr codeOverride (.Ok shared store) =
      .ok (sourceAfter, value) →
    ∃ sharedAfter storeAfter, sourceAfter = .Ok sharedAfter storeAfter

def ExprsEvalArgsResultOkFromOkAt
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract) : Prop :=
  ∀ {shared store sourceAfter values},
    EvmYul.Yul.evalArgs sourceFuel args codeOverride (.Ok shared store) =
      .ok (sourceAfter, values) →
    ∃ sharedAfter storeAfter, sourceAfter = .Ok sharedAfter storeAfter

namespace ExprEvalResultOkFromOkAt

theorem to_resultOkAt
    {cfg : StateRelConfig} {layout : List Name} {sourceFuel : Nat}
    {expr : AstExpr} {codeOverride : Option AstContract}
    (hFromOk :
      ExprEvalResultOkFromOkAt sourceFuel expr codeOverride) :
    ExprEvalResultOkAt cfg layout sourceFuel expr codeOverride := by
  intro source compiler sourceAfter value hInitial hEval
  cases hInitial with
  | @ok shared store _compiler _hShared _hVars =>
      exact hFromOk hEval

end ExprEvalResultOkFromOkAt

/--
Expression and argument result shape from arbitrary ordinary states, reducing
the only non-derived branch to internal user-call roots.

Primitive-call roots are discharged from the imported primitive semantics plus
the recursive argument invariant; literals and variables are direct.
-/
theorem eval_evalArgs_resultOkFromOk_of_userCallResultOk
    {contract : AstContract}
    (hUser :
      ∀ {layout : List Name} {fuel : Nat}
        {functionName : Name} {args : List AstExpr},
        Safe.expr (.Call (.inr functionName) args) →
        SourceExprScoped layout (.Call (.inr functionName) args) →
        UserCallArity.ExprOk contract (.Call (.inr functionName) args) →
        ExprEvalResultOkFromOkAt fuel (.Call (.inr functionName) args)
          (some contract))
    (fuel : Nat) :
    (∀ {layout : List Name} {expr : AstExpr},
      Safe.expr expr →
      SourceExprScoped layout expr →
      UserCallArity.ExprOk contract expr →
      ExprEvalResultOkFromOkAt fuel expr (some contract)) ∧
    (∀ {layout : List Name} {args : List AstExpr},
      Safe.exprs args →
      SourceExprsScoped layout args →
      UserCallArity.ExprsOk contract args →
      ExprsEvalArgsResultOkFromOkAt fuel args (some contract)) := by
  refine Nat.strong_induction_on fuel ?_
  intro fuel ih
  cases fuel with
  | zero =>
      constructor
      · intro layout expr hSafe hScoped hOk shared store sourceAfter value hEval
        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
          EvmYul.Yul.head'] at hEval
      · intro layout args hSafe hScoped hOk shared store sourceAfter values
          hEval
        simp [EvmYul.Yul.evalArgs] at hEval
  | succ fuel' =>
      have ihFuel := ih fuel' (Nat.lt_succ_self fuel')
      constructor
      · intro layout expr hSafe hScoped hOk shared store sourceAfter value
          hEval
        cases expr with
        | Lit literal =>
            simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
              EvmYul.Yul.head'] at hEval
            rcases hEval with ⟨hState, _hValue⟩
            subst sourceAfter
            exact ⟨shared, store, rfl⟩
        | Var name =>
            cases hLookup :
                EvmYul.Yul.State.lookup? name (.Ok shared store : State) with
            | none =>
                simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.head', hLookup] at hEval
            | some valueFound =>
                simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                  EvmYul.Yul.head', hLookup] at hEval
                rcases hEval with ⟨hState, _hValue⟩
                subst sourceAfter
                exact ⟨shared, store, rfl⟩
        | Call callee args =>
            cases callee with
            | inr functionName =>
                exact hUser hSafe hScoped hOk hEval
            | inl prim =>
                have hSafePrim : Safe.primitive prim := hSafe.1
                have hSafeArgs : Safe.exprs args := hSafe.2
                have hScopedArgs : SourceExprsScoped layout args := by
                  simpa [SourceExprScoped] using hScoped
                have hOkArgs : UserCallArity.ExprsOk contract args := by
                  simpa [UserCallArity.ExprOk] using hOk
                cases hArgs :
                    EvmYul.Yul.evalArgs fuel' args.reverse (some contract)
                      (.Ok shared store : State) with
                | error err =>
                    simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                      EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs] at hEval
                | ok argPair =>
                    rcases argPair with ⟨stateArgs, argValuesRaw⟩
                    rcases
                        ihFuel.2 (layout := layout) (args := args.reverse)
                          (safe_exprs_reverse hSafeArgs)
                          (SourceExprsScoped.reverse hScopedArgs)
                          (UserCallArity.ExprsOk.reverse hOkArgs)
                          hArgs with
                      ⟨sharedArgs, storeArgs, hStateArgs⟩
                    subst stateArgs
                    cases hCall :
                        EvmYul.Yul.primCall fuel'
                          (.Ok sharedArgs storeArgs : State) prim
                          argValuesRaw.reverse with
                    | error err =>
                        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                          EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs,
                          hCall] at hEval
                    | ok callPair =>
                        rcases callPair with ⟨stateCall, valuesCall⟩
                        simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues,
                          EvmYul.Yul.reverse', EvmYul.Yul.head', hArgs,
                          hCall] at hEval
                        rcases hEval with ⟨hState, _hValue⟩
                        subst sourceAfter
                        cases stateCall with
                        | Ok sharedAfter storeAfter =>
                            exact ⟨sharedAfter, storeAfter, rfl⟩
                        | OutOfFuel =>
                            exact False.elim
                              (primCall_safe_not_outOfFuel_of_ok
                                hSafePrim hCall)
                        | Checkpoint jump =>
                            have hAllowed :
                                SourcePairResultCheckpointAllowed false false
                                  false
                                  (EvmYul.Yul.primCall fuel'
                                    (.Ok sharedArgs storeArgs : State) prim
                                    argValuesRaw.reverse) :=
                              PrimitiveCallCheckpointAllowedForSafe.of_primitive_families
                                hSafePrim
                            have hJump :
                                StateCheckpointAllowed false false false
                                  (.Checkpoint jump : State) := by
                              simpa [SourcePairResultCheckpointAllowed,
                                hCall] using hAllowed
                            cases jump <;>
                              simp [StateCheckpointAllowed] at hJump
      · intro layout args hSafe hScoped hOk shared store sourceAfter values
          hEval
        cases args with
        | nil =>
            simp [EvmYul.Yul.evalArgs] at hEval
            rcases hEval with ⟨hState, _hValues⟩
            subst sourceAfter
            exact ⟨shared, store, rfl⟩
        | cons head tail =>
            have hHeadSafe : Safe.expr head := hSafe.1
            have hTailSafe : Safe.exprs tail := hSafe.2
            have hHeadScoped : SourceExprScoped layout head := hScoped.1
            have hTailScoped : SourceExprsScoped layout tail := hScoped.2
            have hHeadOk : UserCallArity.ExprOk contract head := hOk.1
            have hTailOk : UserCallArity.ExprsOk contract tail := hOk.2
            cases hHead :
                EvmYul.Yul.eval fuel' head (some contract)
                  (.Ok shared store : State) with
            | error err =>
                simp [EvmYul.Yul.evalArgs, hHead,
                  EvmYul.Yul.evalTail] at hEval
            | ok headPair =>
                rcases headPair with ⟨stateHead, headValue⟩
                cases fuel' with
                | zero =>
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail] at hEval
                | succ fuelTail =>
                    rcases
                        ihFuel.1 hHeadSafe hHeadScoped hHeadOk hHead with
                      ⟨sharedHead, storeHead, hStateHead⟩
                    subst stateHead
                    simp [EvmYul.Yul.evalArgs, hHead,
                      EvmYul.Yul.evalTail, EvmYul.Yul.cons'] at hEval
                    cases hTail :
                        EvmYul.Yul.evalArgs fuelTail tail (some contract)
                          (.Ok sharedHead storeHead : State) with
                    | error err =>
                        simp [hTail] at hEval
                    | ok tailPair =>
                        rcases tailPair with ⟨stateTail, tailValues⟩
                        simp [hTail] at hEval
                        rcases hEval with ⟨hState, _hValues⟩
                        subst sourceAfter
                        exact
                          (ih fuelTail (by omega)).2 hTailSafe hTailScoped
                            hTailOk hTail

