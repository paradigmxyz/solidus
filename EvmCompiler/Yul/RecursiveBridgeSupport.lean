      (by
        intro shared store compiler err hExact hEvalError hRelatable
        exact
          sourceNonregularStmtRunHiddenExact_for_generated_condition_terminal_hidden_scope
            (cfg := cfg) (layout := layout)
            (outcomeLayout := outcomeLayout) (terminalRel := terminalRel)
            (revertRel := revertRel) (prim := prim) (program := program)
            (ctx := ctx) (sourceFuel := sourceFuel) (cond := cond)
