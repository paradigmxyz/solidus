          lowerStmts = lower := hLowerStmtsEq
          _ = lowerHead ++ lowerRest := hLowerEq
          _ = (preArgs ++ [Functions.Stmt.terminalArgs kind seq]) ++
              lowerRest := by rw [hLowerShape]
      cases hBlockEq'
      exact
        sourceResultBlockSoundWhenAtExact_cons_terminalStackPrelude_of_preludeRegular_general
          (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
          (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
          (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
          (argFuel := argFuel) (yulPrim := yulPrim) (kind := kind)
          (sourceArgs := sourceArgs) (rest := rest)
          (codeOverride := codeOverride) (pre := preArgs) (args := seq)
          (lowerTail := lowerRest) (allowed := allowed) hArgSound' hTerminal

/--
Names-aware checked block wrapper for a terminal-call head followed by an
arbitrary tail.
-/
theorem checkedBlockLoweringSoundWhenFreshNamesAtExact_cons_terminalStackPrelude_of_preludeRegular_general
    {cfg : StateRelConfig} {reserved layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat}
    {yulPrim : EvmYul.Operation .Yul} {kind : Assembly.HaltKind}
    {sourceArgs : List AstExpr} {rest : List AstStmt}
    {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hTerminalOp : Prim.terminal? yulPrim = some kind)
    (hArgSound :
      ∀ {freshState stateAfterArgs pre lowerArgs seq},
        FreshCoversLayout layout freshState →
        Expr.List.lowerBound1? freshState sourceArgs =
          some (pre, lowerArgs, stateAfterArgs) →
        Expr.List.toStackSeq? lowerArgs kind.argCount = some seq →
          SourceArgStackPreludeRegular cfg layout prim program ctx argFuel
            sourceArgs codeOverride pre seq)
    (hTerminal :
      ∀ {source compiler sourceResult},
        SourceStateRel cfg layout source compiler →
        allowed sourceResult →
        EvmYul.Yul.exec sourceFuel
            (.Block (.ExprStmtCall (.Call (.inl yulPrim) sourceArgs) ::
              rest))
            codeOverride source =
          sourceResult →
        ∃ sourceAfterArgs : State,
        ∃ sourceValues : List Word,
          EvmYul.Yul.evalArgs argFuel sourceArgs.reverse codeOverride source =
            .ok (sourceAfterArgs, sourceValues.reverse) ∧
          ∀ {compilerAfterArgs : Objects.Source.State},
            SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
              ∃ sharedAfter : EvmYul.SharedState .EVM,
                prim.terminal kind compilerAfterArgs.shared
                    sourceValues.reverse =
                  .ok sharedAfter ∧
                SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
                  sourceResult
                  (Functions.Source.Outcome.halt kind
                    (compilerAfterArgs.withShared sharedAfter))) :
    CheckedBlockLoweringSoundWhenFreshNamesAtExact cfg reserved layout
      outcomeLayout terminalRel revertRel prim program ctx sourceFuel
      (.ExprStmtCall (.Call (.inl yulPrim) sourceArgs) :: rest) codeOverride
      allowed :=
  checkedBlockLoweringSoundWhenFreshNamesAtExact_of_freshAtExact
    (checkedBlockLoweringSoundWhenFreshAtExact_cons_terminalStackPrelude_of_preludeRegular_general
      (cfg := cfg) (layout := layout) (outcomeLayout := outcomeLayout)
      (terminalRel := terminalRel) (revertRel := revertRel) (prim := prim)
      (program := program) (ctx := ctx) (sourceFuel := sourceFuel)
      (argFuel := argFuel) (yulPrim := yulPrim) (kind := kind)
      (sourceArgs := sourceArgs) (rest := rest)
      (codeOverride := codeOverride) (allowed := allowed)
      hTerminalOp hArgSound hTerminal)

/--
Restricting a store extended by one fresh zero-filled Yul local back to the
original store domain recovers the original store.

This is the store-level fact behind the `let x` block case: the declaration is
visible inside the block, but the enclosing Yul block restricts the store back
to its entry domain.
-/
theorem restrictVarStore_insert_fresh_to_self
    (store : EvmYul.Yul.VarStore) (name : EvmYul.Identifier)
    (value : Word)
    (hFresh : store.lookup name = none) :
    EvmYul.Yul.State.restrictVarStore (store.insert name value) store =
      store := by
  apply Finmap.ext_lookup
  intro key
  cases hScope : store.lookup key with
  | none =>
      exact
        FinmapFacts.lookup_restrictVarStore_of_scope_none
          (store.insert name value) store key hScope
  | some oldValue =>
      have hRestricted :
          (EvmYul.Yul.State.restrictVarStore (store.insert name value)
              store).lookup key =
            (store.insert name value).lookup key :=
        FinmapFacts.lookup_restrictVarStore_of_scope_some
          (store.insert name value) store key hScope
      have hNe : key ≠ name := by
        intro hEq
        subst key
        simp [hFresh] at hScope
      rw [hRestricted]
      rw [Finmap.lookup_insert_of_ne]
      · exact hScope
      · exact hNe

/--
Restricting a store extended by a finite list of fresh compiler-generated
bindings back to the original store domain recovers the original store.
-/
theorem restrictVarStore_insertPairs_fresh_to_self
    (store : EvmYul.Yul.VarStore) (pairs : List (Name × Word))
    (hFresh :
      ∀ name, name ∈ pairs.map Prod.fst → store.lookup name = none) :
    EvmYul.Yul.State.restrictVarStore
        (VarStackRel.insertPairs pairs store) store =
      store := by
  apply Finmap.ext_lookup
  intro key
  cases hScope : store.lookup key with
  | none =>
      exact
        FinmapFacts.lookup_restrictVarStore_of_scope_none
          (VarStackRel.insertPairs pairs store) store key hScope
  | some oldValue =>
      have hRestricted :
          (EvmYul.Yul.State.restrictVarStore
              (VarStackRel.insertPairs pairs store) store).lookup key =
            (VarStackRel.insertPairs pairs store).lookup key :=
        FinmapFacts.lookup_restrictVarStore_of_scope_some
          (VarStackRel.insertPairs pairs store) store key hScope
      have hPreserve :
          (VarStackRel.insertPairs pairs store).lookup key =
            store.lookup key :=
        BridgeFacts.lookup_insertPairs_preserve
          (pairs := pairs) (store := store) (name := key)
          (by
            intro pairName hMem hEq
            subst pairName
            have hFreshKey : store.lookup key = none :=
              hFresh key hMem
            rw [hScope] at hFreshKey
            cases hFreshKey)
      rw [hRestricted, hPreserve]
      exact hScope

/--
State-level form of `restrictVarStore_insert_fresh_to_self` for the singleton
`zeroFill` produced by `let x` declarations with no initializer.
-/
theorem zeroFill_single_restrictStoreTo_of_fresh
    (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore)
    (name : EvmYul.Identifier)
    (hFresh : store.lookup (identName name) = none) :
    (((.Ok shared store : State).zeroFill [name]).restrictStoreTo
        (.Ok shared store : State).store) =
      (.Ok shared store : State) := by
  have hFresh' : store.lookup name = none := by
    simpa [identName] using hFresh
  change
    (.Ok shared
      (EvmYul.Yul.State.restrictVarStore
        (store.insert name (EvmYul.UInt256.ofNat 0)) store) : State) =
      .Ok shared store
  rw [restrictVarStore_insert_fresh_to_self store name
    (EvmYul.UInt256.ofNat 0) hFresh']

/--
State-level form of `restrictVarStore_insertPairs_fresh_to_self` for the
general `zeroFill` produced by uninitialized Yul declarations.
-/
theorem zeroFill_restrictStoreTo_of_fresh
    (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore)
    (names : List EvmYul.Identifier)
    (hFresh :
      ∀ name, name ∈ identNames names → store.lookup name = none) :
    (((.Ok shared store : State).zeroFill names).restrictStoreTo
        (.Ok shared store : State).store) =
      (.Ok shared store : State) := by
  have hZero :
      (.Ok shared store : State).zeroFill names =
        .Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store) :=
    VarStackRel.insertZeros_identifiers_ok shared store names
  rw [hZero]
  change
    (.Ok shared
      (EvmYul.Yul.State.restrictVarStore
        (VarStackRel.insertPairs
          (VarStackRel.zeroPairs (identNames names)) store) store) :
        State) =
      .Ok shared store
  rw [restrictVarStore_insertPairs_fresh_to_self]
  intro name hMem
  exact hFresh name (by simpa [VarStackRel.zeroPairs] using hMem)

/--
Successful declaration checking means none of the declared identifiers was
present in the entry varstore.
-/
theorem checkDeclaration_ok_lookup_none
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {names : List EvmYul.Identifier}
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) names = .ok ()) :
    ∀ name, name ∈ identNames names → store.lookup name = none := by
  unfold EvmYul.Yul.checkDeclaration at hCheck
  cases hDup : EvmYul.Yul.firstDuplicate? names with
  | some duplicate =>
      simp [hDup] at hCheck
  | none =>
      simp [hDup] at hCheck
      cases hDecl : EvmYul.Yul.firstDeclared? (.Ok shared store) names with
      | some declared =>
          simp [hDecl] at hCheck
      | none =>
          intro name hMem
          unfold EvmYul.Yul.firstDeclared? at hDecl
          have hFind :=
            List.find?_eq_none.mp hDecl
          have hNameMem : name ∈ names := by
            simpa [identNames, identName] using hMem
          cases hLookup : store.lookup name with
          | none =>
              rfl
          | some value =>
              have hNotTrue :=
                hFind name hNameMem
              have hLookupState :
                  (.Ok shared store : State).lookup? name = some value := by
                simpa [EvmYul.Yul.State.lookup?] using hLookup
              have hSomeTrue :
                  (((.Ok shared store : State).lookup? name).isSome) =
                    true := by
                simp [hLookupState]
              exact False.elim (hNotTrue hSomeTrue)

/--
Clean block execution fact for uninitialized declarations: if declaration
checking succeeds, the enclosing block's store cleanup removes the newly
zero-filled locals and recovers the entry state.
-/
theorem exec_block_let_none_succ_succ_succ_clean_of_check
    (fuel : Nat)
    (codeOverride : Option AstContract)
    (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore)
    (names : List EvmYul.Identifier)
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) names = .ok ()) :
    EvmYul.Yul.exec fuel.succ.succ.succ (.Block [.Let names none])
        codeOverride (.Ok shared store) =
      .ok (.Ok shared store) := by
  have hHead :
      EvmYul.Yul.exec fuel.succ (.Let names none) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store)) :=
    BridgeFacts.exec_let_none_ok fuel names codeOverride shared store hCheck
  have hTail :
      EvmYul.Yul.execSeq fuel.succ [] codeOverride
          (.Ok shared
            (VarStackRel.insertPairs
              (VarStackRel.zeroPairs (identNames names)) store)) =
        .ok (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store)) :=
    Imported.execSeq_nil_succ fuel codeOverride
      (.Ok shared
        (VarStackRel.insertPairs
          (VarStackRel.zeroPairs (identNames names)) store))
  have hSeq :
      EvmYul.Yul.execSeq fuel.succ.succ [.Let names none] codeOverride
          (.Ok shared store) =
        .ok (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store)) :=
    Imported.execSeq_cons_ok_succ (fuel := fuel.succ)
      (stmt := .Let names none) (rest := []) hHead hTail
  rw [Imported.exec_block_cons_succ]
  rw [hSeq]
  have hRestrictInserted :
      EvmYul.Yul.State.restrictStoreTo
          (.Ok shared store : State).store
          (.Ok shared
            (VarStackRel.insertPairs
              (VarStackRel.zeroPairs (identNames names)) store)) =
        (.Ok shared store : State) := by
    change
      (.Ok shared
        (EvmYul.Yul.State.restrictVarStore
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store) store) :
          State) =
        .Ok shared store
    rw [restrictVarStore_insertPairs_fresh_to_self]
    intro name hMem
    exact checkDeclaration_ok_lookup_none hCheck name
      (by simpa [VarStackRel.zeroPairs] using hMem)
  simpa using hRestrictInserted

/--
Running the generated source-tower zero-initializers extends the source context
by exactly those names, in stack order, and preserves every variable from the
entry scope.
-/
theorem functions_source_initNames_runOpen_regular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {compiler : Objects.Source.State} :
    ∀ (names : List Name),
      names.Nodup →
      (∀ name, name ∈ names → name ∉ ctx.scope) →
      ∃ compilerAfter,
        Functions.Source.Block.runOpen prim program ctx (names.length + 1)
            { stmts := Stmt.initNames names } compiler =
          .ok (Functions.Source.Outcome.regular compilerAfter,
            { ctx with scope := names.reverse ++ ctx.scope }) ∧
        compilerAfter.shared = compiler.shared ∧
        ∀ name, name ∈ ctx.scope →
          compilerAfter.vars name = compiler.vars name
  | [], _hNoDup, _hFresh => by
      refine ⟨compiler, ?_, rfl, ?_⟩
      · simp [Stmt.initNames, Functions.Source.Block.runOpen]
      · intro name _hMem
        rfl
  | name :: rest, hNoDup, hFresh => by
      have hRestNoDup : rest.Nodup := (List.nodup_cons.mp hNoDup).2
      have hNameFreshRest : name ∉ rest := (List.nodup_cons.mp hNoDup).1
      let compilerHead := compiler.insert name Stmt.zero
      let ctxHead : Functions.Source.Ctx :=
        { ctx with scope := name :: ctx.scope }
      have hRestFresh :
          ∀ restName, restName ∈ rest → restName ∉ ctxHead.scope := by
        intro restName hRestMem hCtxMem
        have hCtxMem' :
            restName = name ∨ restName ∈ ctx.scope := by
          simpa [ctxHead] using hCtxMem
        rcases hCtxMem' with hEq | hOuter
        · subst restName
          exact hNameFreshRest hRestMem
        · exact hFresh restName (by simp [hRestMem]) hOuter
      rcases
          functions_source_initNames_runOpen_regular
            (prim := prim) (program := program) (ctx := ctxHead)
            (compiler := compilerHead) rest hRestNoDup hRestFresh with
        ⟨compilerAfter, hRestRun, hShared, hPreserveRest⟩
      refine ⟨compilerAfter, ?_, ?_, ?_⟩
      · have hHead :
            Functions.Source.Stmt.run prim program ctx rest.length.succ
                (Functions.Stmt.let_ name
                  (Locals.Expr.lit Stmt.zero)) compiler =
              .ok (Functions.Source.Outcome.regular compilerHead, ctxHead) := by
            simp [Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
              Locals.Source.Expr.evalOne, Locals.Source.Expr.eval,
              compilerHead, ctxHead, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular]
        exact
          (by
            simpa [Stmt.initNames, Functions.Source.Block.runOpen, hHead,
              ctxHead, compilerHead, List.append_assoc]
              using hRestRun)
      · simpa [compilerHead] using hShared
      · intro key hKey
        have hKeyHead : key ∈ ctxHead.scope := by
          simp [ctxHead, hKey]
        have hAfterHead :
            compilerHead.vars key = compiler.vars key := by
          have hNe : key ≠ name := by
            intro hEq
            exact hFresh name (by simp) (by simpa [hEq] using hKey)
          simp [compilerHead, Locals.Source.State.insert,
            Locals.Source.Store.insert_of_ne hNe]
        exact (hPreserveRest key hKeyHead).trans hAfterHead

/--
The generated zero-initializers used for hidden result slots really create
those slots in the source store.  This packages the source-side fact needed by
`let targets := userCall(...)`: after `initNames`, every generated target is
present before the hidden argument prelude starts.
-/
theorem functions_source_initNames_runOpen_regular_with_contains
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {compiler : Objects.Source.State} :
    ∀ (names : List Name),
      names.Nodup →
      (∀ name, name ∈ names → name ∉ ctx.scope) →
      ∃ compilerAfter,
        Functions.Source.Block.runOpen prim program ctx (names.length + 1)
            { stmts := Stmt.initNames names } compiler =
          .ok (Functions.Source.Outcome.regular compilerAfter,
            { ctx with scope := names.reverse ++ ctx.scope }) ∧
        compilerAfter.shared = compiler.shared ∧
        (∀ name, name ∈ ctx.scope →
          compilerAfter.vars name = compiler.vars name) ∧
        SourceVarsContains names compilerAfter.vars
  | [], _hNoDup, _hFresh => by
      refine ⟨compiler, ?_, rfl, ?_, ?_⟩
      · simp [Stmt.initNames, Functions.Source.Block.runOpen]
      · intro name _hMem
        rfl
      · intro name hMem
        simp at hMem
  | name :: rest, hNoDup, hFresh => by
      have hRestNoDup : rest.Nodup := (List.nodup_cons.mp hNoDup).2
      have hNameFreshRest : name ∉ rest := (List.nodup_cons.mp hNoDup).1
      let compilerHead := compiler.insert name Stmt.zero
      let ctxHead : Functions.Source.Ctx :=
        { ctx with scope := name :: ctx.scope }
      have hRestFresh :
          ∀ restName, restName ∈ rest → restName ∉ ctxHead.scope := by
        intro restName hRestMem hCtxMem
        have hCtxMem' :
            restName = name ∨ restName ∈ ctx.scope := by
          simpa [ctxHead] using hCtxMem
        rcases hCtxMem' with hEq | hOuter
        · subst restName
          exact hNameFreshRest hRestMem
        · exact hFresh restName (by simp [hRestMem]) hOuter
      rcases
          functions_source_initNames_runOpen_regular_with_contains
            (prim := prim) (program := program) (ctx := ctxHead)
            (compiler := compilerHead) rest hRestNoDup hRestFresh with
        ⟨compilerAfter, hRestRun, hShared, hPreserveRest,
          hContainsRest⟩
      refine ⟨compilerAfter, ?_, ?_, ?_, ?_⟩
      · have hHead :
            Functions.Source.Stmt.run prim program ctx rest.length.succ
                (Functions.Stmt.let_ name
                  (Locals.Expr.lit Stmt.zero)) compiler =
              .ok (Functions.Source.Outcome.regular compilerHead, ctxHead) := by
            simp [Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
              Locals.Source.Expr.evalOne, Locals.Source.Expr.eval,
              compilerHead, ctxHead, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular]
        exact
          (by
            simpa [Stmt.initNames, Functions.Source.Block.runOpen, hHead,
              ctxHead, compilerHead, List.append_assoc]
              using hRestRun)
      · simpa [compilerHead] using hShared
      · intro key hKey
        have hKeyHead : key ∈ ctxHead.scope := by
          simp [ctxHead, hKey]
        have hAfterHead :
            compilerHead.vars key = compiler.vars key := by
          have hNe : key ≠ name := by
            intro hEq
            exact hFresh name (by simp) (by simpa [hEq] using hKey)
          simp [compilerHead, Locals.Source.State.insert,
            Locals.Source.Store.insert_of_ne hNe]
        exact (hPreserveRest key hKeyHead).trans hAfterHead
      · intro key hKey
        simp only [List.mem_cons] at hKey
        rcases hKey with hEq | hRest
        · subst key
          have hKeyHead : name ∈ ctxHead.scope := by
            simp [ctxHead]
          have hPreserved :
              compilerAfter.vars name = compilerHead.vars name :=
            hPreserveRest name hKeyHead
          have hHeadContains :
              SourceVarsContains [name] compilerHead.vars := by
            simpa [compilerHead, Locals.Source.State.insert] using
              (SourceVarsContains.insert_self
                (vars := compiler.vars) (name := name)
                (value := Stmt.zero))
          rw [Locals.Source.Store.contains]
          rw [hPreserved]
          exact hHeadContains name (by simp)
        · exact hContainsRest key hRest

theorem functions_source_initNames_contains_of_runOpen_regular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {compiler compilerAfter : Objects.Source.State}
    {names : List Name}
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ ctx.scope)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx (names.length + 1)
          { stmts := Stmt.initNames names } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfter,
          { ctx with scope := names.reverse ++ ctx.scope })) :
    SourceVarsContains names compilerAfter.vars := by
  rcases
      functions_source_initNames_runOpen_regular_with_contains
        (prim := prim) (program := program) (ctx := ctx)
        (compiler := compiler) names hNoDup hFresh with
    ⟨expected, hExpected, _hShared, _hPreserve, hContains⟩
  rw [hRun] at hExpected
  cases hExpected
  exact hContains

theorem functions_source_initNames_argList_contains_of_runOpen_regular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {compiler compilerAfterInit compilerAfterArgs : Objects.Source.State}
    {names : List Name} {args : List (Locals.Expr 1)}
    {values : List Word}
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ ctx.scope)
    (hInitRun :
      Functions.Source.Block.runOpen prim program ctx (names.length + 1)
          { stmts := Stmt.initNames names } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterInit,
          { ctx with scope := names.reverse ++ ctx.scope }))
    (hArgs :
      Functions.Source.ArgList.eval prim args compilerAfterInit =
        .ok (compilerAfterArgs, values)) :
    SourceVarsContains names compilerAfterArgs.vars :=
  SourceVarsContains.of_argList_eval
    (functions_source_initNames_contains_of_runOpen_regular
      (prim := prim) (program := program) (ctx := ctx)
      (compiler := compiler) (compilerAfter := compilerAfterInit)
      (names := names) hNoDup hFresh hInitRun)
    hArgs

theorem functions_source_empty_prelude_argList_contains_of_runOpen_regular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat}
    {compiler compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {names : List Name} {args : List (Locals.Expr 1)}
    {values : List Word}
    (hContains : SourceVarsContains names compiler.vars)
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel { stmts := [] }
          compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter))
    (hArgs :
      Functions.Source.ArgList.eval prim args compilerAfterPre =
        .ok (compilerAfterArgs, values)) :
    SourceVarsContains names compilerAfterArgs.vars := by
  have hNil :=
    Functions.Source.Block.runOpen_nil_ok (prim := prim) (program := program)
      (ctx := ctx) (fuel := fuel) (state := compiler)
      (outcome := Functions.Source.Outcome.regular compilerAfterPre)
      (runCtx := ctxAfter) hRun
  rcases hNil with ⟨hOutcome, _hCtx⟩
  have hCompilerAfterPre : compilerAfterPre = compiler := by
    simpa [Functions.Source.Outcome.regular,
      Locals.Source.Outcome.regular] using congrArg
        (fun outcome : Functions.Source.Outcome => outcome.state) hOutcome
  subst compilerAfterPre
  exact SourceVarsContains.of_argList_eval hContains hArgs

/--
Expression-lowering preludes contain only source declarations and internal
user-function calls.  Those statements may change values, shared state, and
fresh temporary locals, but on a regular run they do not remove any already
present source variable.
-/
def SourceContainsPreservingPrelude : List Functions.Stmt → Prop
  | [] => True
  | Functions.Stmt.let_ _ _ :: rest =>
      SourceContainsPreservingPrelude rest
  | Functions.Stmt.call _ _ _ :: rest =>
      SourceContainsPreservingPrelude rest
  | _ :: _ => False

def SourceWritesDisjoint (protectedNames : List Name) :
    List Functions.Stmt → Prop
  | [] => True
  | Functions.Stmt.let_ name _ :: rest =>
      name ∉ protectedNames ∧ SourceWritesDisjoint protectedNames rest
  | Functions.Stmt.call targets _ _ :: rest =>
      (∀ name, name ∈ targets → name ∉ protectedNames) ∧
        SourceWritesDisjoint protectedNames rest
  | _ :: _ => False

def SourceVarsAgree (names : List Name)
    (before after : Locals.Source.Store) : Prop :=
  ∀ name, name ∈ names → after name = before name

namespace SourceContainsPreservingPrelude

theorem nil : SourceContainsPreservingPrelude [] := by
  simp [SourceContainsPreservingPrelude]

theorem let_ {name : Name} {expr : Locals.Expr 1}
    {rest : List Functions.Stmt}
    (hRest : SourceContainsPreservingPrelude rest) :
    SourceContainsPreservingPrelude
      (Functions.Stmt.let_ name expr :: rest) := by
  simpa [SourceContainsPreservingPrelude] using hRest

theorem call {targets : List Name} {functionName : Name}
