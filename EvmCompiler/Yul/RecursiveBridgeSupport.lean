  | error err =>
      simpa [SourceResultOutcomeLayoutCompatible]
        using hCompat
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [SourceResultOutcomeLayoutCompatible,
            EvmYul.Yul.State.restrictStoreTo] using hCompat
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutCompatible,
            EvmYul.Yul.State.restrictStoreTo]
      | Checkpoint jump =>
          cases jump <;>
            simpa [SourceResultOutcomeLayoutCompatible,
              EvmYul.Yul.State.restrictStoreTo] using hCompat

theorem SourceResultOutcomeLayoutCompatible.of_restrictStoreTo
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {scope : EvmYul.Yul.VarStore} {sourceResult : Except Exception State}
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        (match sourceResult with
         | .ok source => .ok (source.restrictStoreTo scope)
         | .error err => .error err)) :
    SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultOutcomeLayoutCompatible]
        using hCompat
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [SourceResultOutcomeLayoutCompatible,
            EvmYul.Yul.State.restrictStoreTo] using hCompat
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutCompatible]
      | Checkpoint jump =>
          cases jump <;>
            simpa [SourceResultOutcomeLayoutCompatible,
              EvmYul.Yul.State.restrictStoreTo] using hCompat

theorem SourceResultOutcomeRel.of_restrictStoreTo_compatible
    {cfg : StateRelConfig} {ctx : Functions.Source.Ctx}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    {outcome : Objects.Source.Outcome}
    (hScope : ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        sourceResult)
    (hRelatable : SourceResultRelatable sourceResult)
    (hRel :
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        (restrictSourceResultTo scope sourceResult) outcome) :
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult outcome := by
  cases sourceResult with
  | error err =>
      simpa [restrictSourceResultTo] using hRel
  | ok source =>
      cases source with
      | Ok shared store =>
          have hEq : outcomeLayout = layout := by
            simpa [SourceResultOutcomeLayoutCompatible] using hCompat
          subst outcomeLayout
          exact
            SourceResultOutcomeRel.of_restrictStoreTo_scope_contains
              (layout := layout) hScope
              (by simpa [restrictSourceResultTo] using hRel)
      | OutOfFuel =>
          exact False.elim
            (sourceResultRelatable_stateOutOfFuel_false hRelatable)
      | Checkpoint jump =>
          cases jump with
          | Break shared store =>
              have hSubset :
                  ∀ name : Name, name ∈ outcomeLayout → name ∈ layout := by
                have hCompatBreak :
                    ctx.breakScope? = some outcomeLayout ∧
                      ∀ name : Name, name ∈ outcomeLayout →
                        name ∈ layout := by
                  simpa [SourceResultOutcomeLayoutCompatible] using hCompat
                exact hCompatBreak.2
              exact
                SourceResultOutcomeRel.of_restrictStoreTo_scope_contains
                  (layout := outcomeLayout)
                  (fun name hMem => hScope name (hSubset name hMem))
                  (by simpa [restrictSourceResultTo] using hRel)
          | Continue shared store =>
              have hSubset :
                  ∀ name : Name, name ∈ outcomeLayout → name ∈ layout := by
                have hCompatContinue :
                    ctx.continueScope? = some outcomeLayout ∧
                      ∀ name : Name, name ∈ outcomeLayout →
                        name ∈ layout := by
                  simpa [SourceResultOutcomeLayoutCompatible] using hCompat
                exact hCompatContinue.2
              exact
                SourceResultOutcomeRel.of_restrictStoreTo_scope_contains
                  (layout := outcomeLayout)
                  (fun name hMem => hScope name (hSubset name hMem))
                  (by simpa [restrictSourceResultTo] using hRel)
          | Leave shared store =>
              have hSubset :
                  ∀ name : Name, name ∈ outcomeLayout → name ∈ layout := by
                have hCompatLeave :
                    ctx.leaveScope? = some outcomeLayout ∧
                      ∀ name : Name, name ∈ outcomeLayout →
                        name ∈ layout := by
                  simpa [SourceResultOutcomeLayoutCompatible] using hCompat
                exact hCompatLeave.2
              exact
                SourceResultOutcomeRel.of_restrictStoreTo_scope_contains
                  (layout := outcomeLayout)
                  (fun name hMem => hScope name (hSubset name hMem))
                  (by simpa [restrictSourceResultTo] using hRel)

theorem SourceResultOutcomeLayoutCompatible.of_handler_eq
    {ctx ctx' : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hBreak : ctx'.breakScope? = ctx.breakScope?)
    (hContinue : ctx'.continueScope? = ctx.continueScope?)
    (hLeave : ctx'.leaveScope? = ctx.leaveScope?)
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutCompatible ctx' layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultOutcomeLayoutCompatible] using hCompat
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [SourceResultOutcomeLayoutCompatible] using hCompat
      | OutOfFuel =>
          simp [SourceResultOutcomeLayoutCompatible]
      | Checkpoint jump =>
          cases jump
          · simpa [SourceResultOutcomeLayoutCompatible, hContinue] using hCompat
          · simpa [SourceResultOutcomeLayoutCompatible, hBreak] using hCompat
          · simpa [SourceResultOutcomeLayoutCompatible, hLeave] using hCompat

/--
Generated preludes may extend the source context with compiler-only names, but
regular execution preserves the control handlers.  Keep that fact bundled so
generated-control callbacks can transport continuation/layout compatibility
without re-opening three separate `runOpen` lemmas at every branch.
-/
structure SourceCtxHandlersEq
    (ctx ctx' : Functions.Source.Ctx) : Prop where
  breakScope : ctx'.breakScope? = ctx.breakScope?
  continueScope : ctx'.continueScope? = ctx.continueScope?
  leaveScope : ctx'.leaveScope? = ctx.leaveScope?

namespace SourceCtxHandlersEq

theorem refl (ctx : Functions.Source.Ctx) : SourceCtxHandlersEq ctx ctx :=
  ⟨rfl, rfl, rfl⟩

theorem trans
    {ctx ctx' ctx'' : Functions.Source.Ctx}
    (hLeft : SourceCtxHandlersEq ctx ctx')
    (hRight : SourceCtxHandlersEq ctx' ctx'') :
    SourceCtxHandlersEq ctx ctx'' :=
  ⟨hRight.breakScope.trans hLeft.breakScope,
    hRight.continueScope.trans hLeft.continueScope,
    hRight.leaveScope.trans hLeft.leaveScope⟩

theorem of_runOpen_regular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfter : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {state stateAfter : Objects.Source.State}
    (hRun :
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (Functions.Source.Outcome.regular stateAfter, ctxAfter)) :
    SourceCtxHandlersEq ctx ctxAfter :=
  ⟨Functions.SourceDirect.SourceRun.block_runOpen_regular_breakScope hRun,
    Functions.SourceDirect.SourceRun.block_runOpen_regular_continueScope hRun,
    Functions.SourceDirect.SourceRun.block_runOpen_regular_leaveScope hRun⟩

theorem compat
    {ctx ctx' : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hHandlers : SourceCtxHandlersEq ctx ctx')
    (hCompat :
      SourceResultOutcomeLayoutCompatible ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutCompatible ctx' layout outcomeLayout
      sourceResult :=
  SourceResultOutcomeLayoutCompatible.of_handler_eq
    hHandlers.breakScope hHandlers.continueScope hHandlers.leaveScope hCompat

theorem supported
    {ctx ctx' : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hHandlers : SourceCtxHandlersEq ctx ctx')
    (hSupported :
      SourceResultOutcomeLayoutSupported ctx layout outcomeLayout
        sourceResult) :
    SourceResultOutcomeLayoutSupported ctx' layout outcomeLayout
      sourceResult :=
  SourceResultOutcomeLayoutSupported.of_handler_eq
    hHandlers.breakScope hHandlers.continueScope hHandlers.leaveScope
    hSupported

end SourceCtxHandlersEq

namespace SourceResultModeKontSupported

theorem block_break_of_loop_handlers
    {ctx ctxAfter : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    (hHandlers :
      SourceCtxHandlersEq
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        ctxAfter)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope) :
    SourceResultModeKontSupported ctxAfter layout
      (SourceModeKontLayouts.block layout outcomeLayout)
      (.ok (.Checkpoint (.Break shared store))) := by
  exact
    break_of_scope
      (ctx := ctxAfter) (currentLayout := layout)
      (breakScope := ctx.scope)
      (konts := SourceModeKontLayouts.block layout outcomeLayout)
      (by
        rw [hHandlers.breakScope]
        simp [Functions.Source.Ctx.withoutLoopControl,
          Functions.Source.Ctx.withLoopControl])
      (by
        intro name hMem
        simpa [SourceModeKontLayouts.block] using
          hScopeContains name hMem)

theorem block_continue_of_loop_handlers
    {ctx ctxAfter : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    (hHandlers :
      SourceCtxHandlersEq
        (ctx.withoutLoopControl.withLoopControl ctx.scope ctx.scope)
        ctxAfter)
    (hScopeContains : ∀ name : Name, name ∈ layout → name ∈ ctx.scope) :
    SourceResultModeKontSupported ctxAfter layout
      (SourceModeKontLayouts.block layout outcomeLayout)
      (.ok (.Checkpoint (.Continue shared store))) := by
  exact
    continue_of_scope
      (ctx := ctxAfter) (currentLayout := layout)
      (continueScope := ctx.scope)
      (konts := SourceModeKontLayouts.block layout outcomeLayout)
      (by
        rw [hHandlers.continueScope]
        simp [Functions.Source.Ctx.withoutLoopControl,
          Functions.Source.Ctx.withLoopControl])
      (by
        intro name hMem
        simpa [SourceModeKontLayouts.block] using
          hScopeContains name hMem)

end SourceResultModeKontSupported

/--
Regular compiler-open prefixes may add hidden locals, but they retain every
caller-visible name and preserve all control handlers.
-/
structure SourceCtxExtends
    (ctx ctx' : Functions.Source.Ctx) : Prop where
  scopeContains : ∀ name : Name, name ∈ ctx.scope → name ∈ ctx'.scope
  handlersEq : SourceCtxHandlersEq ctx ctx'

namespace SourceCtxExtends

theorem refl (ctx : Functions.Source.Ctx) : SourceCtxExtends ctx ctx :=
  ⟨fun _name hMem => hMem, SourceCtxHandlersEq.refl ctx⟩

theorem trans
    {ctx ctx' ctx'' : Functions.Source.Ctx}
    (hLeft : SourceCtxExtends ctx ctx')
    (hRight : SourceCtxExtends ctx' ctx'') :
    SourceCtxExtends ctx ctx'' :=
  ⟨fun name hMem => hRight.scopeContains name (hLeft.scopeContains name hMem),
    SourceCtxHandlersEq.trans hLeft.handlersEq hRight.handlersEq⟩

theorem cons (ctx : Functions.Source.Ctx) (name : Name) :
    SourceCtxExtends ctx { ctx with scope := name :: ctx.scope } :=
  ⟨fun oldName hMem => by simp [hMem],
    ⟨rfl, rfl, rfl⟩⟩

theorem append_left (ctx : Functions.Source.Ctx) (names : List Name) :
    SourceCtxExtends ctx { ctx with scope := names ++ ctx.scope } :=
  ⟨fun oldName hMem => by simp [hMem],
    ⟨rfl, rfl, rfl⟩⟩

end SourceCtxExtends

def HiddenModeHandlersAvailable
    (ctx : Functions.Source.Ctx) (layout : List Name)
    (canBreak canContinue : Bool) : Prop :=
  (canBreak = true →
    ∃ breakScope : List Name,
      ctx.breakScope? = some breakScope ∧
        ∀ name : Name, name ∈ layout → name ∈ breakScope) ∧
  (canContinue = true →
    ∃ continueScope : List Name,
      ctx.continueScope? = some continueScope ∧
        ∀ name : Name, name ∈ layout → name ∈ continueScope)

namespace HiddenModeHandlersAvailable

theorem noLoop (ctx : Functions.Source.Ctx) (layout : List Name) :
    HiddenModeHandlersAvailable ctx layout false false := by
  refine And.intro ?_ ?_
  · intro h
    cases h
  · intro h
    cases h

theorem loopHandlers
    {ctxBase ctx : Functions.Source.Ctx} {layout : List Name}
    (hHandlers :
      SourceCtxHandlersEq
        (ctxBase.withoutLoopControl.withLoopControl ctxBase.scope
          ctxBase.scope) ctx)
    (hLoopScopeContains :
      ∀ name : Name, name ∈ layout → name ∈ ctxBase.scope) :
    HiddenModeHandlersAvailable ctx layout true true := by
  refine ⟨?_, ?_⟩
  · intro _h
    refine ⟨ctxBase.scope, ?_⟩
    exact
      ⟨by
        rw [hHandlers.breakScope]
        simp [Functions.Source.Ctx.withoutLoopControl,
          Functions.Source.Ctx.withLoopControl],
       hLoopScopeContains⟩
  · intro _h
    refine ⟨ctxBase.scope, ?_⟩
    exact
      ⟨by
        rw [hHandlers.continueScope]
        simp [Functions.Source.Ctx.withoutLoopControl,
          Functions.Source.Ctx.withLoopControl],
       hLoopScopeContains⟩

end HiddenModeHandlersAvailable

namespace SourceResultHiddenModeSupported

theorem to_modeKont_block
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hSupported :
      SourceResultHiddenModeSupported ctx layout outcomeLayout sourceResult) :
    SourceResultModeKontSupported ctx layout
      (SourceModeKontLayouts.block layout outcomeLayout) sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultHiddenModeSupported, SourceResultModeKontSupported,
        SourceModeKontLayouts.block] using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          intro name hMem
          exact hMem
      | OutOfFuel =>
          simp [SourceResultModeKontSupported, SourceModeKontLayouts.block]
      | Checkpoint jump =>
          cases jump
          · simpa [SourceResultHiddenModeSupported,
              SourceResultModeKontSupported, SourceModeKontLayouts.block]
              using hSupported
          · simpa [SourceResultHiddenModeSupported,
              SourceResultModeKontSupported, SourceModeKontLayouts.block]
              using hSupported
          · simpa [SourceResultHiddenModeSupported,
              SourceResultModeKontSupported, SourceModeKontLayouts.block]
              using hSupported

theorem of_modeKont_block
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hSupported :
      SourceResultModeKontSupported ctx layout
        (SourceModeKontLayouts.block layout outcomeLayout) sourceResult) :
    SourceResultHiddenModeSupported ctx layout outcomeLayout sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultHiddenModeSupported, SourceResultModeKontSupported,
        SourceModeKontLayouts.block] using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          simp [SourceResultHiddenModeSupported]
      | OutOfFuel =>
          simp [SourceResultHiddenModeSupported]
      | Checkpoint jump =>
          cases jump
          · simpa [SourceResultHiddenModeSupported,
              SourceResultModeKontSupported, SourceModeKontLayouts.block]
              using hSupported
          · simpa [SourceResultHiddenModeSupported,
              SourceResultModeKontSupported, SourceModeKontLayouts.block]
              using hSupported
          · simpa [SourceResultHiddenModeSupported,
              SourceResultModeKontSupported, SourceModeKontLayouts.block]
              using hSupported

theorem of_handler_eq
    {ctx ctx' : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hBreak : ctx'.breakScope? = ctx.breakScope?)
    (hContinue : ctx'.continueScope? = ctx.continueScope?)
    (hLeave : ctx'.leaveScope? = ctx.leaveScope?)
    (hSupported :
      SourceResultHiddenModeSupported ctx layout outcomeLayout
        sourceResult) :
    SourceResultHiddenModeSupported ctx' layout outcomeLayout
      sourceResult := by
  cases sourceResult with
  | error err =>
      simpa [SourceResultHiddenModeSupported] using hSupported
  | ok source =>
      cases source with
      | Ok shared store =>
          simpa [SourceResultHiddenModeSupported] using hSupported
      | OutOfFuel =>
          simp [SourceResultHiddenModeSupported]
      | Checkpoint jump =>
          cases jump
          · rcases hSupported with ⟨continueScope, hScope, hContains⟩
            refine ⟨continueScope, ?_, hContains⟩
            rw [hContinue]
            exact hScope
          · rcases hSupported with ⟨breakScope, hScope, hContains⟩
            refine ⟨breakScope, ?_, hContains⟩
            rw [hBreak]
            exact hScope
          · simpa [SourceResultHiddenModeSupported, hLeave] using hSupported

theorem break_of_handlers
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {canContinue : Bool}
    (hHandlers : HiddenModeHandlersAvailable ctx layout true canContinue) :
    SourceResultHiddenModeSupported ctx layout outcomeLayout
      (.ok (.Checkpoint (.Break shared store))) := by
  exact hHandlers.1 rfl

theorem continue_of_handlers
    {ctx : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {canBreak : Bool}
    (hHandlers : HiddenModeHandlersAvailable ctx layout canBreak true) :
    SourceResultHiddenModeSupported ctx layout outcomeLayout
      (.ok (.Checkpoint (.Continue shared store))) := by
  exact hHandlers.2 rfl

end SourceResultHiddenModeSupported

namespace SourceCtxHandlersEq

theorem hiddenModeSupported
    {ctx ctx' : Functions.Source.Ctx} {layout outcomeLayout : List Name}
    {sourceResult : Except Exception State}
    (hHandlers : SourceCtxHandlersEq ctx ctx')
    (hSupported :
      SourceResultHiddenModeSupported ctx layout outcomeLayout
        sourceResult) :
    SourceResultHiddenModeSupported ctx' layout outcomeLayout
      sourceResult :=
  SourceResultHiddenModeSupported.of_handler_eq
    hHandlers.breakScope hHandlers.continueScope hHandlers.leaveScope
    hSupported

theorem modeKontSupported
    {ctx ctx' : Functions.Source.Ctx} {currentLayout : List Name}
    {konts : SourceModeKontLayouts}
    {sourceResult : Except Exception State}
    (hHandlers : SourceCtxHandlersEq ctx ctx')
    (hSupported :
      SourceResultModeKontSupported ctx currentLayout konts sourceResult) :
    SourceResultModeKontSupported ctx' currentLayout konts sourceResult :=
  SourceResultModeKontSupported.of_handler_eq
    hHandlers.breakScope hHandlers.continueScope hHandlers.leaveScope
    hSupported

end SourceCtxHandlersEq

def StateCheckpointAllowed (canBreak canContinue canLeave : Bool) :
    State → Prop
  | .Checkpoint (.Break _shared _store) => canBreak = true
  | .Checkpoint (.Continue _shared _store) => canContinue = true
  | .Checkpoint (.Leave _shared _store) => canLeave = true
  | _ => True

def SourceResultCheckpointAllowed (canBreak canContinue canLeave : Bool) :
    Except Exception State → Prop
  | .ok state => StateCheckpointAllowed canBreak canContinue canLeave state
  | _ => True

def SourcePairResultCheckpointAllowed {α : Type}
    (canBreak canContinue canLeave : Bool) :
    Except Exception (State × α) → Prop
  | .ok (state, _value) =>
      StateCheckpointAllowed canBreak canContinue canLeave state
  | .error _err => True

theorem SourcePairResultCheckpointAllowed.ok
    {α : Type} {canBreak canContinue canLeave : Bool}
    {state : State} {value : α}
    (hAllowed :
      StateCheckpointAllowed canBreak canContinue canLeave state) :
    SourcePairResultCheckpointAllowed canBreak canContinue canLeave
      (.ok (state, value)) := by
  simpa [SourcePairResultCheckpointAllowed] using hAllowed

theorem SourcePairResultCheckpointAllowed.error
    {α : Type} {canBreak canContinue canLeave : Bool}
    {err : Exception} :
    SourcePairResultCheckpointAllowed (α := α)
      canBreak canContinue canLeave (.error err) := by
  simp [SourcePairResultCheckpointAllowed]

def PrimitiveCallCheckpointAllowedForSafe : Prop :=
  ∀ {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {args : List Word},
    Safe.primitive yulPrim →
    SourcePairResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.primCall fuel (.Ok shared store) yulPrim args)

def PrimitiveCallCheckpointAllowedForSafeState : Prop :=
  ∀ {canBreak canContinue canLeave : Bool}
    {fuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {state : State} {args : List Word},
    Safe.primitive yulPrim →
    StateCheckpointAllowed canBreak canContinue canLeave state →
    SourcePairResultCheckpointAllowed canBreak canContinue canLeave
      (EvmYul.Yul.primCall fuel state yulPrim args)

