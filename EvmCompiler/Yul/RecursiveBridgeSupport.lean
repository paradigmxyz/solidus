/--
Adapter from the existing source-tower argument-prelude theorem to the
regular-success interface used by recursive bridge constructor proofs.
-/
theorem sourceArgPreludeRegular_of_exprArgPreludeSound
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt} {results : Nat}
    {lower : Locals.ExprSeq results}
    (hScope : ctx.scope = layout)
    (hSound :
      ExprArgPreludeSound cfg layout prim program ctx sourceFuel args
        codeOverride pre lower) :
    SourceArgPreludeRegular cfg layout prim program ctx sourceFuel args
  codeOverride pre lower := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceAfter values hInitial hEval
  have hReverse :
      EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source) =
        .ok (sourceAfter, values) := by
    simp [EvmYul.Yul.reverse', hEval]
  exact hSound hInitial hReverse

