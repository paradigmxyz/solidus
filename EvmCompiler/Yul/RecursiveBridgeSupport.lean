                          simp [hExec, EvmYul.Yul.State.setStore,
                            EvmYul.Yul.State.overwrite?,
                            EvmYul.Yul.State.reviveJump] at h
                          rcases h with ⟨hStateAfter, _hValues⟩
                          subst stateAfter
                          simpa [StateStoreDomainExact] using hDomain
                      | OutOfFuel =>
                          simp [hExec, EvmYul.Yul.State.setStore,
                            EvmYul.Yul.State.overwrite?,
                            EvmYul.Yul.State.reviveJump] at h
                          rcases h with ⟨hStateAfter, _hValues⟩
                          subst stateAfter
                          simp [StateStoreDomainExact]
                      | Checkpoint j =>
                          cases j <;>
                            simp [hExec, EvmYul.Yul.State.setStore,
                              EvmYul.Yul.State.overwrite?,
                              EvmYul.Yul.State.reviveJump,
                              EvmYul.Yul.State.revive] at h <;>
                            rcases h with ⟨hStateAfter, _hValues⟩ <;>
                            subst stateAfter <;>
