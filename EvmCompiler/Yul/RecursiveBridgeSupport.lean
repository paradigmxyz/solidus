      | StackMemFlow smsf =>
          cases smsf with
          | POP | MSTORE | SSTORE | MSTORE8 | TSTORE | MCOPY =>
              simp [Prim.toBasicOp?] at hBasic
              subst op
              simp [Expressions.Structured.BasicOp.outputs] at hOutputs
          | MLOAD =>
              exact yul_primCall_mload_ok_single hCall
          | SLOAD =>
              have hExec :
                  yulPrimListResult
                    (EvmYul.Yul.unaryStateOp EvmYul.State.sload
                      source args) = .ok (sourceAfter, values) := by
                simp [EvmYul.Yul.primCall] at hCall
