/--
Source-side singleton user-call reconstruction from decomposed callee-body
evidence.

The recursive Yul bridge decomposes an imported call into argument values,
callee body execution, returned values, and caller assignment. This lemma is the
matching source-tower step: once the recursive IH supplies the body run and the
return extraction/assignment facts are known, the source `Functions.Stmt.call`
singleton block runs regularly.
-/
theorem sourceCallSingletonRunOpen_regular_of_body
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {targets : List Name} {functionName : Name}
    {lowerArgs : List (Locals.Expr 1)}
    {compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {argValues : List Word} {fn : Functions.FunDef}
    {paramStore : Locals.Source.Store}
    {bodyOutcome : Objects.Source.Outcome}
    {bodyCtx' : Functions.Source.Ctx}
    {returnValues : List Word} {returnStore : Locals.Source.Store}
    {bodyFuel : Nat}
    (hTargets : targets.Nodup)
    (hArgsRun :
      Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
        .ok (compilerAfterArgs, argValues))
    (hFind :
      Functions.Source.FunList.find? functionName program.functions =
        some fn)
    (hInsert :
      Functions.Source.Store.insertMany fn.params argValues
        Locals.Source.Store.empty = some paramStore)
    (hBodyRun :
      Functions.Source.Block.runOpen prim program
          (Functions.Source.FunDef.bodyCtx fn) bodyFuel fn.body
          { shared := compilerAfterArgs.shared,
            vars := Functions.Source.Store.initReturns fn.returns paramStore } =
        .ok (bodyOutcome, bodyCtx'))
    (hMode : bodyOutcome.mode = .regular ∨ bodyOutcome.mode = .leave)
    (hLookup :
      Functions.Source.Store.lookupMany fn.returns bodyOutcome.state.vars =
        some returnValues)
    (hAssign :
      Functions.Source.Store.assignMany targets returnValues
        compilerAfterArgs.vars = some returnStore) :
    Functions.Source.Block.runOpen prim program ctx (bodyFuel + 3)
        { stmts := [Functions.Stmt.call targets functionName lowerArgs] }
        compilerAfterPre =
      .ok
        (Functions.Source.Outcome.regular
          { shared := bodyOutcome.state.shared, vars := returnStore },
          ctx) := by
  have hBodyReturned :
      Functions.Source.FunDef.runBody prim program fn argValues
          (bodyFuel + 1) compilerAfterArgs.shared =
      .ok
        (Functions.Source.CallResult.returned
          bodyOutcome.state.shared returnValues) := by
    have hBodyRunExplicit :
        Functions.Source.Block.runOpen prim program
            { Functions.Source.Ctx.initial.withLeaveScope
                (fn.returns ++ fn.params) with
              scope := fn.returns ++ fn.params }
            bodyFuel fn.body
            { shared := compilerAfterArgs.shared,
              vars := Functions.Source.Store.initReturns fn.returns paramStore } =
          .ok (bodyOutcome, bodyCtx') := by
      simpa [Functions.Source.FunDef.bodyCtx] using hBodyRun
    cases hMode with
    | inl hRegular =>
        unfold Functions.Source.FunDef.runBody
        simp [hInsert, hBodyRunExplicit, hRegular, hLookup]
    | inr hLeave =>
        unfold Functions.Source.FunDef.runBody
        simp [hInsert, hBodyRunExplicit, hLeave, hLookup]
  have hFindDirect :
      Functions.FunList.find? functionName program.functions = some fn := by
    simpa [sourceFunList_find?_eq_direct functionName program.functions]
      using hFind
  have hStmtRun :
      Functions.Source.Stmt.run prim program ctx (bodyFuel + 2)
          (.call targets functionName lowerArgs) compilerAfterPre =
        .ok
          (Functions.Source.Outcome.regular
            { shared := bodyOutcome.state.shared, vars := returnStore },
            ctx) := by
    unfold Functions.Source.Stmt.run
    simp [hTargets, hArgsRun, hFindDirect, hBodyReturned, hAssign]
  simp [Functions.Source.Block.runOpen, hStmtRun,
    Functions.Source.Outcome.regular, Locals.Source.Outcome.regular]

/--
Regular sequence bridge for a user-function call expression statement with a
hidden argument-list prelude.

The theorem deliberately does not prove the callee body here. Instead, the
`hCall` continuation is exactly where the recursive proof will use its
smaller-fuel hypothesis to handle returned-value and terminal callee behavior.
-/
theorem sourceRegularSeqRunBridgeHidden_cons_expr_user_call_prelude_regular
    {cfg : StateRelConfig} {layout layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {rest : List AstStmt} {pre : List Functions.Stmt}
    {lowerTail : Functions.Block}
    {functionName : Name} {args : List AstExpr}
    {lowerArgs : List (Locals.Expr 1)}
    (sourceFuel : Nat) (codeOverride : Option AstContract)
    (hRel : SourceStateRel cfg layout (.Ok shared store) compiler)
    (hExec :
      EvmYul.Yul.exec sourceFuel.succ
          (.ExprStmtCall (.Call (.inr functionName) args)) codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter))
    (hArgs :
      SourceArgListPreludeRegularAt cfg layout prim program ctx sourceFuel args
        codeOverride pre lowerArgs)
    (hCall :
      ∀ {sourceAfterArgs : State}
        {compilerAfterPre compilerAfterArgs : Objects.Source.State}
        {ctxAfterPre : Functions.Source.Ctx} {preFuel : Nat}
        {argValues : List Word},
        Functions.Source.Block.runOpen prim program ctx preFuel
            { stmts := pre } compiler =
          .ok
            (Functions.Source.Outcome.regular compilerAfterPre,
              ctxAfterPre) →
        Functions.Source.ArgList.eval prim lowerArgs compilerAfterPre =
          .ok (compilerAfterArgs, argValues) →
        SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
        EvmYul.Yul.execCall sourceFuel functionName [] codeOverride
            (.ok (sourceAfterArgs, argValues)) =
          .ok (.Ok sharedAfter storeAfter) →
        ∃ compilerAfterCall : Objects.Source.State,
        ∃ ctxAfterCall : Functions.Source.Ctx,
        ∃ callFuel : Nat,
          Functions.Source.Block.runOpen prim program ctxAfterPre callFuel
              { stmts := [Functions.Stmt.call [] functionName lowerArgs] }
              compilerAfterPre =
            .ok
              (Functions.Source.Outcome.regular compilerAfterCall,
                ctxAfterCall) ∧
          SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
            compilerAfterCall)
    (hTail :
      ∀ {compilerAfterCall : Objects.Source.State}
        {ctxAfterCall : Functions.Source.Ctx},
        SourceStateRel cfg layout (.Ok sharedAfter storeAfter)
          compilerAfterCall →
        SourceRegularSeqRunBridgeHidden cfg layout layoutAfter prim program
          ctxAfterCall sourceFuel.succ rest codeOverride
          (.Ok sharedAfter storeAfter) compilerAfterCall lowerTail) :
    SourceRegularSeqRunBridgeHidden cfg layout layoutAfter prim program ctx
      sourceFuel.succ.succ
      (.ExprStmtCall (.Call (.inr functionName) args) :: rest)
      codeOverride (.Ok shared store) compiler
      { stmts := pre ++ [Functions.Stmt.call [] functionName lowerArgs] ++
          lowerTail.stmts } := by
  cases hRaw :
      EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
        (.Ok shared store) with
  | error err =>
      simp [Imported.exec_expr_user_call_succ, EvmYul.Yul.reverse', hRaw,
        Imported.execCall_error] at hExec
  | ok raw =>
      rcases raw with ⟨sourceAfterArgs, rawValues⟩
      let argValues := rawValues.reverse
      have hArgEval :
          EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride
              (.Ok shared store) =
            .ok (sourceAfterArgs, argValues.reverse) := by
        simpa [argValues] using hRaw
      have hExecCall :
          EvmYul.Yul.execCall sourceFuel functionName [] codeOverride
              (.ok (sourceAfterArgs, argValues)) =
            .ok (.Ok sharedAfter storeAfter) := by
        simpa [Imported.exec_expr_user_call_succ, EvmYul.Yul.reverse',
          hRaw, argValues] using hExec
      rcases hArgs.2 hRel hArgEval with
        ⟨compilerAfterPre, compilerAfterArgs, ctxAfterPre, preFuel,
          hPreRun, hArgsRun, hRelArgs⟩
      rcases hCall hPreRun hArgsRun hRelArgs hExecCall with
        ⟨compilerAfterCall, ctxAfterCall, callFuel, hCallBlock, hRelCall⟩
      rcases hTail (compilerAfterCall := compilerAfterCall)
          (ctxAfterCall := ctxAfterCall) hRelCall with
        ⟨sourceAfter, compilerAfter, ctxAfter, tailFuel, hSourceTail,
          hCompilerTail, hSubset, hTailRel⟩
      rcases
          Functions.Source.Block.runOpen_append_regular_exists prim program
            [Functions.Stmt.call [] functionName lowerArgs] lowerTail.stmts
            ctxAfterPre ctxAfterCall compilerAfterPre compilerAfterCall
            (Functions.Source.Outcome.regular compilerAfter) ctxAfter
            ⟨callFuel, hCallBlock⟩
            ⟨tailFuel, by
              cases lowerTail
              simpa using hCompilerTail⟩ with
        ⟨callTailFuel, hCallTail⟩
      rcases
          Functions.Source.Block.runOpen_append_regular_exists prim program
            pre
            ([Functions.Stmt.call [] functionName lowerArgs] ++
              lowerTail.stmts)
            ctx ctxAfterPre compiler compilerAfterPre
            (Functions.Source.Outcome.regular compilerAfter) ctxAfter
            ⟨preFuel, hPreRun⟩ ⟨callTailFuel, hCallTail⟩ with
        ⟨targetFuel, hCompiler⟩
      refine
        ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, ?_, ?_, hSubset,
          hTailRel⟩
      · exact Imported.execSeq_cons_ok_succ hExec hSourceTail
      · simpa [List.append_assoc] using hCompiler

/--
Regular sequence bridge for an assignment whose right-hand side is a
user-function call with a hidden argument-list prelude.

The actual callee/return-value assignment proof is supplied by `hCall`; this
lemma only sequences the generated argument prelude, the single lowered
