theorem oracleRelSafe_singleton_op_of_replay
    {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    (hReplay :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace')) :
    OracleRelSafe [Structured.BasicInstr.op op] := by
  cases hObserver : basicOpObserver? op with
  | none =>
      rcases replay_eval_nonObserver_preserves_trace hObserver hReplay with
        ⟨hEval, _hTrace⟩
      dsimp [Locals.Source.PrimitiveSemantics.structured] at hEval
      by_cases hLen :
          values.length = Expressions.Structured.BasicOp.inputs op
      · cases hCont :
          Locals.Source.PrimitiveSemantics.sourceContinuingStep? op with
        | none =>
            simp [hLen, hCont] at hEval
        | some step =>
            exact
              oracleRelSafe_singleton_op_nonObserver_of_sourceContinuingStep
                hObserver hCont
      · simp [hLen] at hEval
  | some _kind =>
      cases op <;> simp [basicOpObserver?] at hObserver
      all_goals
        first
        | exact oracleRelSafe_singleton_msize
        | exact oracleRelSafe_singleton_gas

