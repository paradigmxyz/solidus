theorem stepWithOracle_gas (program : Assembly.Program) (pc : Nat)
    (state : EVMState) (trace : Trace) :
    BasicInstr.stepWithOracle program pc (.op .gas) state trace =
      match trace with
      | { kind := .gas, value := value } :: rest =>
          .ok
            ({ state.replaceStackAndIncrPC
                (state.stack.push
                  (EvmYul.MachineState.gas state.toMachineState)) with
                stack := value :: state.stack },
              rest)
      | _ => .error .InvalidInstruction := by
  let post :=
    state.replaceStackAndIncrPC
      (state.stack.push (EvmYul.MachineState.gas state.toMachineState))
  have hStepPost :
      Assembly.Target.stepInstr
          (Assembly.TargetInstr.prim Assembly.PrimOp.gas) state =
        .ok post := by
    change
      EvmYul.EVM.machineStateOp EvmYul.MachineState.gas state =
        .ok post
    simp [post, EvmYul.EVM.machineStateOp, Id.run,
      EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
      EvmYul.MachineState.gas]
  cases trace with
  | nil =>
      simp [BasicInstr.stepWithOracle, Structured.BasicInstr.toAssembly,
        Structured.BasicOp.toPrimOp, Assembly.Source.stepAtResultWithOracle,
        Assembly.Source.stepAtResult, Assembly.Source.stepAt,
        hStepPost, post,
        Assembly.Instr.haltKind?, Assembly.PrimOp.haltKind?,
        Assembly.ResourceObserver.ofInstr?,
        Assembly.ResourceObserver.ofPrimOp?,
        Assembly.ResourceObserver.applyOracleFromPostState,
        Assembly.ResourceObserver.consume]
  | cons observation rest =>
      cases observation with
      | mk kind value =>
          cases kind <;>
            simp [BasicInstr.stepWithOracle, Structured.BasicInstr.toAssembly,
              Structured.BasicOp.toPrimOp,
              Assembly.Source.stepAtResultWithOracle,
              Assembly.Source.stepAtResult, Assembly.Source.stepAt,
              hStepPost, post,
              Assembly.StepResult.state, Assembly.StepResult.withState,
              Assembly.Instr.haltKind?, Assembly.PrimOp.haltKind?,
              Assembly.ResourceObserver.ofInstr?,
              Assembly.ResourceObserver.ofPrimOp?,
              Assembly.ResourceObserver.applyOracleFromPostState,
              Assembly.ResourceObserver.consume,
              Assembly.ResourceObserver.overwriteTop,
              EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
              EvmYul.MachineState.gas]

