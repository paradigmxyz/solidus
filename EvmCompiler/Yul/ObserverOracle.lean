                                                some (idx + 1) := by
                                            rcases hCtx with
                                              ⟨hLayout, _hBreak, _hContinue,
                                                _hLeave, _hRetc⟩
                                            simpa [hLayout] using
                                              (Locals.Layout.lookupDepth?_of_get?_nodup
                                                hName hNoDup)
                                          rw [hDepth] at hDepthFromName
                                          cases hDepthFromName
                                          rfl
                                        subst depth
                                        rcases
                                            Stmt.compileAssignWithOracle_of_evalOne_sourceOwned
                                              (asmProgram := asmProgram)
                                              (program := program)
                                              (sourceCtx := sourceCtx)
                                              (targetCtx := targetCtx)
                                              (fuel := fuel + 1) (pc := pc)
                                              (name := name) (idx := idx)
                                              (expr := expr) (state := state)
                                              (stateAfterValue :=
                                                stateAfterValue)
                                              (value := value)
                                              (target := target)
                                              (code := headCode)
                                              hCtx hNoDup hName hBound hOwned
                                              hAccess hRel hHeadCode
                                              hEvalOne with
                                          ⟨swapOp', evmAfterHead,
                                            hCompileStmt, _hStmtRun, hRunCode,
                                            hHeadRel, _hCtxHead⟩
                                        have hSwapExpected :
                                            Locals.StackOp.swap? (idx + 1) =
                                              some swapOp := hSwap
                                        have hSwapOpEq : swapOp' = swapOp := by
                                          have hCodeEq := hCompileStmt
                                          simp [Locals.Stmt.compile, hDepth,
                                            hHeadCode, hSwapExpected,
                                            Locals.codeStmt] at hCodeEq
                                          exact hCodeEq.symm
                                        subst swapOp'
                                        have hHeadRelState :
                                            Locals.SourceLowering.StateRel
                                              sourceCtx.scope
                                              stateAfterAssign.source
                                              (target.withEVM evmAfterHead) := by
                                          simpa [stateAfterAssign,
                                            State.withVars] using hHeadRel
                                        have hStmtReplay :
                                            ExpressionsReplay.Stmt.runWithOracle
                                                asmProgram pc exprProgram
                                                (fuel + 1)
                                                (Expressions.Stmt.code
                                                  (headCode ++
                                                    [Structured.BasicInstr.op
                                                      swapOp,
                                                      Structured.BasicInstr.op
                                                        .pop]))
                                                target state.trace =
                                              .ok
                                                (Expressions.Outcome.regular
                                                  (target.withEVM
                                                    evmAfterHead),
                                                  stateAfterAssign.trace) := by
                                          simpa [stateAfterAssign,
                                            State.withVars] using
                                            (ExpressionsReplay.Stmt.runWithOracle_code_of_run
                                              (asmProgram := asmProgram)
                                              (pc := pc) (fuel := fuel + 1)
                                              (program := exprProgram)
                                              hRunCode)
                                        rcases
                                            ih hCleanupScope hCtx hNoDup
                                              hHeadRelState hRestCompile
                                              hCleanup hRestRun with
                                          ⟨targetOut, hRestReplay,
                                            hFinalRel⟩
                                        have hReplayFull :
                                            ExpressionsReplay.Block.runWithOracle
                                                asmProgram pc exprProgram
                                                ((fuel + 1) + 1)
                                                { stmts :=
                                                    Expressions.Stmt.code
                                                      (headCode ++
                                                        [Structured.BasicInstr.op
                                                          swapOp,
                                                          Structured.BasicInstr.op
                                                            .pop]) ::
                                                      (restCode ++
                                                        Locals.codeStmt
                                                          cleanup) }
                                                target state.trace =
                                              .ok
                                                (Expressions.Outcome.regular
                                                  targetOut,
                                                  openState.trace) :=
                                          ExpressionsReplay.Block.runWithOracle_cons_regular_of_runs
                                            (asmProgram := asmProgram)
                                            (pc := pc) (fuel := fuel + 1)
                                            (program := exprProgram)
                                            (stmt :=
                                              Expressions.Stmt.code
                                                (headCode ++
                                                  [Structured.BasicInstr.op
                                                    swapOp,
                                                    Structured.BasicInstr.op
                                                      .pop]))
                                            (rest :=
                                              restCode ++
                                                Locals.codeStmt cleanup)
                                            (state := target)
                                            (stateAfterStmt :=
                                              target.withEVM evmAfterHead)
                                            (trace := state.trace)
                                            (traceAfterStmt :=
                                              stateAfterAssign.trace)
                                            (result :=
                                              (Expressions.Outcome.regular
                                                targetOut,
                                                openState.trace))
                                            hStmtReplay hRestReplay
                                        exact
                                          ⟨targetOut,
                                            by
                                              simpa [Locals.codeStmt,
                                                List.append_assoc] using
                                                hReplayFull,
                                            hFinalRel⟩
                          · have hContainsFalse :
                                Locals.Source.Store.contains state.vars name =
                                  false := by
                              cases hValue :
                                  Locals.Source.Store.contains state.vars name <;>
                                simp [hValue] at hContains ⊢
                            simp [Stmt.run, hContainsFalse, invalid,
                              Structured.invalid] at hRun

theorem compileScoped_atomicPrefixBlockWithOracle
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {exprProgram : Expressions.Program}
    {sourceCtx : Ctx} {targetCtx targetCtxOut : Locals.Ctx}
    {fuel pc : Nat} {stmts : List Locals.Stmt}
    {state : State} {target : Locals.RunState}
    {code : List Expressions.Stmt} {lowerBody : Expressions.Block}
    {outcome : Outcome}
    (hPrefix : AtomicPrefix sourceCtx stmts)
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hRel : Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompileOpen :
      Locals.Block.compileOpen targetCtx { stmts := stmts } =
        some (code, targetCtxOut))
    (hFinish :
      Locals.finishScoped targetCtx targetCtxOut code = some lowerBody)
    (hRun :
      Block.runScoped program sourceCtx { stmts := stmts } fuel state =
        .ok outcome) :
    ∃ targetOut,
      ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
          (fuel + 1) lowerBody target state.trace =
        .ok (Expressions.Outcome.regular targetOut, outcome.state.trace) ∧
      outcome.mode = .regular ∧
      Locals.SourceLowering.StateRel sourceCtx.scope
        outcome.state.source targetOut ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  unfold Block.runScoped at hRun
  cases hOpen :
      Block.runOpen program sourceCtx fuel { stmts := stmts } state with
  | error err =>
      simp [hOpen] at hRun
  | ok openResult =>
      rcases openResult with ⟨openOutcome, sourceCtxOut⟩
      rcases
          compileOpen_atomicPrefixWithOracle
            (asmProgram := asmProgram) (program := program)
            (sourceCtx := sourceCtx) (targetCtx := targetCtx)
            (fuel := fuel) (pc := pc) (stmts := stmts)
            (state := state) (target := target) (code := code)
            (sourceCtxOut := sourceCtxOut)
            (targetCtxOut := targetCtxOut) (outcome := openOutcome)
            hPrefix hCtx hNoDup hRel hCompileOpen hOpen with
        ⟨_targetOpen, _hReplayOpen, hOpenMode, _hOpenRel,
          _hFinalCtxRel⟩
      simp [hOpen] at hRun
      cases openOutcome with
      | mk openState openMode =>
          cases hOpenMode
          simp [Outcome.regular] at hRun
          cases hRun
          unfold Locals.finishScoped at hFinish
          cases hCleanup :
              targetCtxOut.cleanupTo? targetCtx.layout.length with
          | none =>
              simp [hCleanup] at hFinish
          | some cleanup =>
              simp [hCleanup] at hFinish
              cases hFinish
              have hOpenRegular :
                  Block.runOpen program sourceCtx fuel { stmts := stmts }
                      state =
                    .ok (Outcome.regular openState, sourceCtxOut) := by
                simpa [Outcome.regular] using hOpen
              have hCleanupSourceDepth :
                  targetCtxOut.cleanupTo? sourceCtx.scope.length =
                    some cleanup := by
                rcases hCtx with
                  ⟨hLayout, _hBreak, _hContinue, _hLeave, _hRetc⟩
                simpa [hLayout] using hCleanup
              rcases
                  compileOpen_atomicPrefixBlockWithCleanupWithOracle
                    (asmProgram := asmProgram) (program := program)
                    (exprProgram := exprProgram)
                    (sourceCtx := sourceCtx) (targetCtx := targetCtx)
                    (cleanupScope := sourceCtx.scope)
                    (fuel := fuel) (pc := pc) (stmts := stmts)
                    (state := state) (openState := openState)
                    (target := target) (code := code)
                    (sourceCtxOut := sourceCtxOut)
                    (targetCtxOut := targetCtxOut)
                    (cleanup := cleanup)
                    hPrefix
                    (Locals.SourceLowering.CleanupScopeRel.refl
                      sourceCtx.scope)
                    hCtx hNoDup hRel hCompileOpen hCleanupSourceDepth
                    hOpenRegular with
                ⟨targetOut, hReplay, hFinalRel⟩
              refine ⟨targetOut, ?_, rfl, ?_, hCtx⟩
              · simpa [State.restrictTo] using hReplay
              · simpa [State.restrictTo] using hFinalRel

theorem compileScoped_atomicPrefixWithOracle
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {sourceCtx : Ctx} {targetCtx targetCtxOut : Locals.Ctx}
    {fuel pc : Nat} {stmts : List Locals.Stmt}
    {state : State} {target : Locals.RunState}
    {code : List Expressions.Stmt} {lowerBody : Expressions.Block}
    {outcome : Outcome}
    (hPrefix : AtomicPrefix sourceCtx stmts)
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hRel : Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompileOpen :
      Locals.Block.compileOpen targetCtx { stmts := stmts } =
        some (code, targetCtxOut))
    (hFinish :
      Locals.finishScoped targetCtx targetCtxOut code = some lowerBody)
    (hRun :
      Block.runScoped program sourceCtx { stmts := stmts } fuel state =
        .ok outcome) :
    ∃ targetOut,
      ExpressionsReplay.StmtList.runCodeWithOracle asmProgram pc
          lowerBody.stmts target state.trace =
        .ok (Expressions.Outcome.regular targetOut, outcome.state.trace) ∧
      outcome.mode = .regular ∧
      Locals.SourceLowering.StateRel sourceCtx.scope
        outcome.state.source targetOut ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  unfold Block.runScoped at hRun
  cases hOpen :
      Block.runOpen program sourceCtx fuel { stmts := stmts } state with
  | error err =>
      simp [hOpen] at hRun
  | ok openResult =>
      rcases openResult with ⟨openOutcome, sourceCtxOut⟩
      simp [hOpen] at hRun
      rcases
          compileOpen_atomicPrefixWithOracle
            (asmProgram := asmProgram) (program := program)
            (sourceCtx := sourceCtx) (targetCtx := targetCtx)
            (fuel := fuel) (pc := pc) (stmts := stmts)
            (state := state) (target := target) (code := code)
            (sourceCtxOut := sourceCtxOut)
            (targetCtxOut := targetCtxOut) (outcome := openOutcome)
            hPrefix hCtx hNoDup hRel hCompileOpen hOpen with
        ⟨targetOpen, hReplayOpen, hOpenMode, hOpenRel, hFinalCtxRel⟩
      cases openOutcome with
      | mk openState openMode =>
          cases hOpenMode
          simp [Outcome.regular] at hRun
          cases hRun
          unfold Locals.finishScoped at hFinish
          cases hCleanup :
              targetCtxOut.cleanupTo? targetCtx.layout.length with
          | none =>
              simp [hCleanup] at hFinish
          | some cleanup =>
              simp [hCleanup] at hFinish
              cases hFinish
              have hOpenRegular :
                  Block.runOpen program sourceCtx fuel { stmts := stmts }
                      state =
                    .ok (Outcome.regular openState, sourceCtxOut) := by
                simpa [Outcome.regular] using hOpen
              have hScopeSource :
                  Locals.SourceLowering.CleanupScopeRel sourceCtxOut.scope
                    sourceCtx.scope :=
                Block.runOpen_regular_cleanupScopeRel hOpenRegular
              have hScopeTarget :
                  Locals.SourceLowering.CleanupScopeRel targetCtxOut.layout
                    sourceCtx.scope := by
                rcases hFinalCtxRel with
                  ⟨hLayout, _hBreak, _hContinue, _hLeave, _hRetc⟩
                simpa [hLayout] using hScopeSource
              have hCleanupSourceDepth :
                  targetCtxOut.cleanupTo? sourceCtx.scope.length =
                    some cleanup := by
                rcases hCtx with
                  ⟨hLayout, _hBreak, _hContinue, _hLeave, _hRetc⟩
                simpa [hLayout] using hCleanup
              have hOpenRelTarget :
                  Locals.SourceLowering.StateRel targetCtxOut.layout
                    openState.source targetOpen := by
                rcases hFinalCtxRel with
                  ⟨hLayout, _hBreak, _hContinue, _hLeave, _hRetc⟩
                simpa [hLayout] using hOpenRel
              rcases
                  ExpressionsReplay.StmtList.runCodeWithOracle_cleanupTo_scope_exists
                    (asmProgram := asmProgram)
                    (pc :=
                      pc +
                        ExpressionsReplay.StmtList.byteLength code)
                    (ctx := targetCtxOut) (scope := sourceCtx.scope)
                    (source := openState.source) (target := targetOpen)
                    (cleanup := cleanup) (trace := openState.trace)
                    hScopeTarget hOpenRelTarget hCleanupSourceDepth with
                ⟨targetClean, hReplayCleanup, hCleanRel, _hReturns⟩
              have hFullReplay :
                  ExpressionsReplay.StmtList.runCodeWithOracle asmProgram pc
                      (code ++ Locals.codeStmt cleanup) target state.trace =
                    .ok (Expressions.Outcome.regular targetClean,
                      openState.trace) :=
                ExpressionsReplay.StmtList.runCodeWithOracle_append_regular_of_run
                  hReplayOpen hReplayCleanup
              refine ⟨targetClean, ?_, rfl, ?_, hCtx⟩
              · simpa [State.restrictTo] using hFullReplay
              · simpa [State.restrictTo] using hCleanRel

end Block

