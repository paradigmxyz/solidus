            (Structured.Block.compileFromCtx post
              { ctx with breakLabel? := none, continueLabel? := none }
              postSupply).code
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        (Assembly.Program.byteLength
          (Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel))
        cond source trace =
          .ok (stateAfterCond, true, traceAfterCond))
    (hBodyRun :
      Block.runWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            (Structured.Block.compileFromCtx post
              { ctx with breakLabel? := none, continueLabel? := none }
              postSupply).code
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        bodyReplayPc program fuel body stateAfterCond traceAfterCond =
          .ok (Structured.Outcome.cont bodyState, traceAfterBody))
    (hPostRun :
      Block.runWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            (Structured.Block.compileFromCtx post
              { ctx with breakLabel? := none, continueLabel? := none }
              postSupply).code
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        postReplayPc program fuel post bodyState traceAfterBody =
          .ok (Structured.Outcome.regular postState, traceAfterPost))
    (hLoop :
      ∀ {targetAtLoop : EVMState},
        targetAtLoop.pc = Assembly.Program.pcAfter pre →
          Structured.Preservation.Frame.StateRel postState targetAtLoop tokens →
            ARunResultWithOracle
              (pre ++
                Structured.Preservation.ForLoop.coreCode cond
                  (Structured.Block.compileFromCtx body
                    { ctx with
                      breakLabel? := some endLabel
                      continueLabel? := some postLabel }
                    bodySupply).code
                  (Structured.Block.compileFromCtx post
                    { ctx with breakLabel? := none, continueLabel? := none }
                    postSupply).code
                  loopLabel bodyLabel postLabel endLabel ++ suffix)
              targetAtLoop traceAfterPost
              (fun result traceFinal =>
                traceFinal = traceOut ∧
                  Structured.Preservation.CompiledOutcomeRel
                    (pre ++
                      Structured.Preservation.ForLoop.coreCode cond
                        (Structured.Block.compileFromCtx body
                          { ctx with
                            breakLabel? := some endLabel
                            continueLabel? := some postLabel }
                          bodySupply).code
                        (Structured.Block.compileFromCtx post
                          { ctx with breakLabel? := none, continueLabel? := none }
                          postSupply).code
                        loopLabel bodyLabel postLabel endLabel ++ suffix)
                    ctx
                    (Assembly.Program.pcAfter
                      (pre ++
                        Structured.Preservation.ForLoop.coreCode cond
                          (Structured.Block.compileFromCtx body
                            { ctx with
                              breakLabel? := some endLabel
                              continueLabel? := some postLabel }
                            bodySupply).code
                          (Structured.Block.compileFromCtx post
                            { ctx with breakLabel? := none, continueLabel? := none }
                            postSupply).code
                          loopLabel bodyLabel postLabel endLabel))
                    outcome result tokens)) :
    ARunResultWithOracle
      (pre ++
        Structured.Preservation.ForLoop.coreCode cond
          (Structured.Block.compileFromCtx body
            { ctx with
              breakLabel? := some endLabel
              continueLabel? := some postLabel }
            bodySupply).code
          (Structured.Block.compileFromCtx post
            { ctx with breakLabel? := none, continueLabel? := none }
            postSupply).code
          loopLabel bodyLabel postLabel endLabel ++ suffix)
      target trace
      (fun result traceFinal =>
        traceFinal = traceOut ∧
          Structured.Preservation.CompiledOutcomeRel
            (pre ++
              Structured.Preservation.ForLoop.coreCode cond
                (Structured.Block.compileFromCtx body
                  { ctx with
                    breakLabel? := some endLabel
                    continueLabel? := some postLabel }
                  bodySupply).code
                (Structured.Block.compileFromCtx post
                  { ctx with breakLabel? := none, continueLabel? := none }
                  postSupply).code
                loopLabel bodyLabel postLabel endLabel ++ suffix)
            ctx
            (Assembly.Program.pcAfter
              (pre ++
                Structured.Preservation.ForLoop.coreCode cond
                  (Structured.Block.compileFromCtx body
                    { ctx with
                      breakLabel? := some endLabel
                      continueLabel? := some postLabel }
                    bodySupply).code
                  (Structured.Block.compileFromCtx post
                    { ctx with breakLabel? := none, continueLabel? := none }
                    postSupply).code
                  loopLabel bodyLabel postLabel endLabel))
            outcome result tokens) := by
  let bodyCtx : Structured.CompileContext :=
    { ctx with
      breakLabel? := some endLabel
      continueLabel? := some postLabel }
  let postCtx : Structured.CompileContext :=
    { ctx with breakLabel? := none, continueLabel? := none }
  let bodyCode := (Structured.Block.compileFromCtx body bodyCtx bodySupply).code
  let postCode := (Structured.Block.compileFromCtx post postCtx postSupply).code
  let postPre :=
    Structured.Preservation.ForLoop.postPre pre cond bodyCode loopLabel bodyLabel
      postLabel endLabel
  have hEnterPost :=
    body_cont_enter_post
      (program := program) (ctx := ctx) (pre := pre) (suffix := suffix)
      (postCode := postCode) (cond := cond) (body := body)
      (bodySupply := bodySupply) (loopLabel := loopLabel)
      (bodyLabel := bodyLabel) (postLabel := postLabel)
      (endLabel := endLabel) (fuel := fuel) (source := source)
      (stateAfterCond := stateAfterCond) (bodyState := bodyState)
      (target := target) (tokens := tokens) (trace := trace)
      (traceAfterCond := traceAfterCond)
      (traceAfterBody := traceAfterBody) (replayPc := bodyReplayPc)
      hCondRelSafe hCondFrame hBody
      (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hLayout)
      (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hResolve)
      (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hExact)
      hPc hRel
      (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hCond)
      (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hBodyRun)
  refine
    ARunResultWithOracle.bind_running
      (program :=
        pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix)
      (middle := fun targetAtPost traceAtPost =>
        traceAtPost = traceAfterBody ∧
          Structured.Preservation.Frame.StateRel bodyState targetAtPost
            tokens ∧
          targetAtPost.pc = Assembly.Program.pcAfter postPre)
      ?_ ?_
  · simpa [bodyCtx, postCtx, bodyCode, postCode, postPre] using hEnterPost
  · intro targetAtPost traceAtPost hAtPost
    rcases hAtPost with ⟨hTraceAtPost, hRelAtPost, hPcAtPost⟩
    subst traceAtPost
    have hBackToLoop :=
      post_regular_jump_loop
        (program := program) (ctx := ctx) (pre := pre) (suffix := suffix)
        (bodyCode := bodyCode) (cond := cond) (post := post)
        (postSupply := postSupply) (loopLabel := loopLabel)
        (bodyLabel := bodyLabel) (postLabel := postLabel)
        (endLabel := endLabel) (fuel := fuel) (bodyState := bodyState)
        (postState := postState) (target := targetAtPost)
        (tokens := tokens) (trace := traceAfterBody)
        (traceAfterPost := traceAfterPost) (replayPc := postReplayPc)
        hPost
        (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hLayout)
        (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hResolve)
        (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hExact)
        hPcAtPost hRelAtPost
        (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hPostRun)
    have hBackToLoopRunning :
        ARunResultWithOracle
          (pre ++
            Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
              loopLabel bodyLabel postLabel endLabel ++ suffix)
          targetAtPost traceAfterBody
          (fun result traceAtLoop =>
            match result with
            | .running targetAtLoop =>
                traceAtLoop = traceAfterPost ∧
                  Structured.Preservation.Frame.StateRel postState targetAtLoop
                    tokens ∧
                  targetAtLoop.pc = Assembly.Program.pcAfter pre
            | .halted _ => False) := by
      refine ARunResultWithOracle.mono hBackToLoop ?_
      intro result traceAtLoop hResult
      rcases hResult with ⟨hTraceAtLoop, hResult⟩
      cases result with
      | halted halt =>
          exact hResult
      | running targetAtLoop =>
          exact ⟨hTraceAtLoop, hResult⟩
    refine
      ARunResultWithOracle.bind_running
        (program :=
          pre ++
            Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
              loopLabel bodyLabel postLabel endLabel ++ suffix)
        (middle := fun targetAtLoop traceAtLoop =>
          traceAtLoop = traceAfterPost ∧
            Structured.Preservation.Frame.StateRel postState targetAtLoop
              tokens ∧
            targetAtLoop.pc = Assembly.Program.pcAfter pre)
        ?_ ?_
    · simpa [bodyCtx, postCtx, bodyCode, postCode] using hBackToLoopRunning
    · intro targetAtLoop traceAtLoop hAtLoop
      rcases hAtLoop with ⟨hTraceAtLoop, hRelLoop, hPcLoop⟩
      subst traceAtLoop
      simpa [bodyCtx, postCtx, bodyCode, postCode] using
        hLoop hPcLoop hRelLoop

set_option maxHeartbeats 1200000 in
theorem preserves_run {program : Structured.Program}
    {ctx : Structured.CompileContext}
    {cond : Structured.Code} {body post : Structured.Block}
    {bodySupply postSupply : Structured.LabelSupply}
    {loopLabel bodyLabel postLabel endLabel : Assembly.Label}
    (hCondRelSafe : Code.OracleRelSafe cond)
    (hCondFrame : Code.OracleFrameSafe cond)
    (hBody :
      BlockPreservesWithOracle program
        { ctx with
          breakLabel? := some endLabel
          continueLabel? := some postLabel }
        bodySupply body)
    (hPost :
      BlockPreservesWithOracle program
        { ctx with breakLabel? := none, continueLabel? := none }
        postSupply post) :
    ∀ {pre suffix : Assembly.Program} {fuel : Nat}
      {source : Structured.RunState} {outcome : Structured.Outcome}
      {target : EVMState} {tokens : List Word}
      {trace traceOut : Trace} {replayPc : Nat},
      Structured.Preservation.ForLoop.Layout pre suffix cond
        (Structured.Block.compileFromCtx body
          { ctx with
            breakLabel? := some endLabel
            continueLabel? := some postLabel }
          bodySupply).code
        (Structured.Block.compileFromCtx post
          { ctx with breakLabel? := none, continueLabel? := none }
          postSupply).code
        loopLabel bodyLabel postLabel endLabel →
      Structured.Preservation.ContextLabelsResolve
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            (Structured.Block.compileFromCtx post
              { ctx with breakLabel? := none, continueLabel? := none }
              postSupply).code
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        ctx →
      Structured.Preservation.ExactLabels
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            (Structured.Block.compileFromCtx post
              { ctx with breakLabel? := none, continueLabel? := none }
              postSupply).code
            loopLabel bodyLabel postLabel endLabel ++ suffix) →
      target.pc = Assembly.Program.pcAfter pre →
      Structured.Preservation.Frame.StateRel source target tokens →
      Stmt.runForLoopWithOracle
          (pre ++
            Structured.Preservation.ForLoop.coreCode cond
              (Structured.Block.compileFromCtx body
                { ctx with
                  breakLabel? := some endLabel
                  continueLabel? := some postLabel }
                bodySupply).code
              (Structured.Block.compileFromCtx post
                { ctx with breakLabel? := none, continueLabel? := none }
                postSupply).code
              loopLabel bodyLabel postLabel endLabel ++ suffix)
          replayPc program fuel cond post body source trace =
        .ok (outcome, traceOut) →
      ARunResultWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            (Structured.Block.compileFromCtx post
              { ctx with breakLabel? := none, continueLabel? := none }
              postSupply).code
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        target trace
        (fun result traceFinal =>
          traceFinal = traceOut ∧
            Structured.Preservation.CompiledOutcomeRel
              (pre ++
                Structured.Preservation.ForLoop.coreCode cond
                  (Structured.Block.compileFromCtx body
                    { ctx with
                      breakLabel? := some endLabel
                      continueLabel? := some postLabel }
                    bodySupply).code
                  (Structured.Block.compileFromCtx post
                    { ctx with breakLabel? := none, continueLabel? := none }
                    postSupply).code
                  loopLabel bodyLabel postLabel endLabel ++ suffix)
              ctx
              (Assembly.Program.pcAfter
                (pre ++
                  Structured.Preservation.ForLoop.coreCode cond
                    (Structured.Block.compileFromCtx body
                      { ctx with
                        breakLabel? := some endLabel
                        continueLabel? := some postLabel }
                      bodySupply).code
                    (Structured.Block.compileFromCtx post
                      { ctx with breakLabel? := none, continueLabel? := none }
                      postSupply).code
                    loopLabel bodyLabel postLabel endLabel))
              outcome result tokens) := by
  intro pre suffix fuel source outcome target tokens trace traceOut replayPc
    hLayout hResolve hExact hPc hRel hRun
  induction fuel generalizing pre suffix source outcome target tokens trace
      traceOut replayPc with
  | zero =>
      simp [Stmt.runForLoopWithOracle, Structured.invalid] at hRun
  | succ fuel ih =>
      let bodyCtx : Structured.CompileContext :=
        { ctx with
          breakLabel? := some endLabel
          continueLabel? := some postLabel }
      let postCtx : Structured.CompileContext :=
        { ctx with breakLabel? := none, continueLabel? := none }
      let bodyCode := (Structured.Block.compileFromCtx body bodyCtx bodySupply).code
      let postCode := (Structured.Block.compileFromCtx post postCtx postSupply).code
      let full :=
        pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix
      let loopCondPc :=
        Assembly.Program.byteLength
          (Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel)
      replace hRun :
          Stmt.runForLoopWithOracle full replayPc program (fuel + 1) cond post
              body source trace =
            .ok (outcome, traceOut) := by
        simpa [bodyCtx, postCtx, bodyCode, postCode, full] using hRun
      cases hCondRun :
          Code.runConditionWithOracle full replayPc cond source trace with
      | error err =>
          simp [Stmt.runForLoopWithOracle, hCondRun] at hRun
      | ok condResult =>
          rcases condResult with
            ⟨stateAfterCond, condTrue, traceAfterCond⟩
          have hCondAtLoop :
              Code.runConditionWithOracle full loopCondPc cond source trace =
                .ok (stateAfterCond, condTrue, traceAfterCond) := by
            have hPcIrrel :=
              Code.runConditionWithOracle_pc_irrel full loopCondPc replayPc cond
                source trace
            rw [hPcIrrel]
            exact hCondRun
          cases condTrue with
          | false =>
              simp [Stmt.runForLoopWithOracle, hCondRun,
                Structured.Outcome.regular] at hRun
              rcases hRun with ⟨hOutcome, hTraceOut⟩
              cases hOutcome
              simpa [bodyCtx, postCtx, bodyCode, postCode, full,
                hTraceOut] using
                false_case (ctx := ctx) (pre := pre) (suffix := suffix)
                  (bodyCode := bodyCode) (postCode := postCode)
                  (cond := cond) (loopLabel := loopLabel)
                  (bodyLabel := bodyLabel) (postLabel := postLabel)
                  (endLabel := endLabel)
                  (source := source) (stateAfterCond := stateAfterCond)
                  (target := target) (tokens := tokens) (trace := trace)
                  (traceAfterCond := traceAfterCond)
                  hCondRelSafe hCondFrame
                  (by simpa [bodyCtx, postCtx, bodyCode, postCode] using hLayout)
                  hPc hRel
                  (by simpa [full, loopCondPc] using hCondAtLoop)
          | true =>
              simp [Stmt.runForLoopWithOracle, hCondRun] at hRun
              cases hBodyRun :
                  Block.runWithOracle full replayPc program fuel body
                    stateAfterCond traceAfterCond with
              | error err =>
                  simp [hBodyRun] at hRun
              | ok bodyResult =>
                  rcases bodyResult with ⟨bodyOutcome, traceAfterBody⟩
                  rcases bodyOutcome with ⟨bodyState, bodyMode⟩
                  cases bodyMode with
                  | regular =>
                      have hBodyRunRegular :
                          Block.runWithOracle full replayPc program fuel body
                              stateAfterCond traceAfterCond =
                            .ok (Structured.Outcome.regular bodyState,
                              traceAfterBody) := by
                        simpa [Structured.Outcome.regular] using hBodyRun
                      simp [hBodyRun, Structured.Outcome.regular] at hRun
                      cases hPostRun :
                          Block.runWithOracle full replayPc program fuel post
                            bodyState traceAfterBody with
                      | error err =>
                          simp [hPostRun] at hRun
                      | ok postResult =>
                          rcases postResult with ⟨postOutcome, traceAfterPost⟩
                          rcases postOutcome with ⟨postState, postMode⟩
                          cases postMode with
                          | regular =>
                              have hPostRunRegular :
                                  Block.runWithOracle full replayPc program fuel
                                      post bodyState traceAfterBody =
                                    .ok (Structured.Outcome.regular postState,
                                      traceAfterPost) := by
                                simpa [Structured.Outcome.regular] using
                                  hPostRun
                              simp [hPostRun, Structured.Outcome.regular] at hRun
                              exact
                                regular_post_regular_case
                                  (program := program) (ctx := ctx) (pre := pre)
                                  (suffix := suffix) (cond := cond)
                                  (body := body) (post := post)
                                  (bodySupply := bodySupply)
                                  (postSupply := postSupply)
                                  (loopLabel := loopLabel)
                                  (bodyLabel := bodyLabel)
                                  (postLabel := postLabel)
                                  (endLabel := endLabel)
                                  (fuel := fuel) (source := source)
                                  (stateAfterCond := stateAfterCond)
                                  (bodyState := bodyState)
                                  (postState := postState)
                                  (outcome := outcome) (target := target)
                                  (tokens := tokens) (trace := trace)
                                  (traceAfterCond := traceAfterCond)
                                  (traceAfterBody := traceAfterBody)
                                  (traceAfterPost := traceAfterPost)
                                  (traceOut := traceOut)
                                  (bodyReplayPc := replayPc)
                                  (postReplayPc := replayPc)
                                  hCondRelSafe hCondFrame hBody hPost
                                  hLayout hResolve hExact hPc hRel
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full, loopCondPc] using
                                    hCondAtLoop)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hBodyRunRegular)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hPostRunRegular)
                                  (by
                                    intro targetAtLoop hPcLoop hRelLoop
                                    exact
                                      ih
                                        (pre := pre) (suffix := suffix)
                                        (source := postState)
                                        (outcome := outcome)
                                        (target := targetAtLoop)
                                        (tokens := tokens)
                                        (trace := traceAfterPost)
                                        (traceOut := traceOut)
                                        (replayPc := replayPc)
                                        hLayout hResolve hExact hPcLoop hRelLoop
                                        (by
                                          simpa [bodyCtx, postCtx, bodyCode,
                                            postCode, full] using hRun))
                          | brk =>
                              simp [hPostRun, Structured.Outcome.brk,
                                Structured.invalid] at hRun
                          | cont =>
                              simp [hPostRun, Structured.Outcome.cont,
                                Structured.invalid] at hRun
                          | leave =>
                              have hPostRunLeave :
                                  Block.runWithOracle full replayPc program fuel
                                      post bodyState traceAfterBody =
                                    .ok (Structured.Outcome.leave postState,
                                      traceAfterPost) := by
                                simpa [Structured.Outcome.leave] using hPostRun
                              simp [hPostRun, Structured.Outcome.leave] at hRun
                              rcases hRun with ⟨hOutcome, hTraceOut⟩
                              cases hOutcome
                              simpa [hTraceOut] using
                                regular_post_leave_case
                                  (program := program) (ctx := ctx) (pre := pre)
                                  (suffix := suffix) (cond := cond)
                                  (body := body) (post := post)
                                  (bodySupply := bodySupply)
                                  (postSupply := postSupply)
                                  (loopLabel := loopLabel)
                                  (bodyLabel := bodyLabel)
                                  (postLabel := postLabel)
                                  (endLabel := endLabel)
                                  (fuel := fuel) (source := source)
                                  (stateAfterCond := stateAfterCond)
                                  (bodyState := bodyState)
                                  (postState := postState)
                                  (target := target) (tokens := tokens)
                                  (trace := trace)
                                  (traceAfterCond := traceAfterCond)
                                  (traceAfterBody := traceAfterBody)
                                  (traceOut := traceAfterPost)
                                  (bodyReplayPc := replayPc)
                                  (postReplayPc := replayPc)
                                  hCondRelSafe hCondFrame hBody hPost
                                  hLayout hResolve hExact hPc hRel
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full, loopCondPc] using
                                    hCondAtLoop)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hBodyRunRegular)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hPostRunLeave)
                          | halt kind =>
                              have hPostRunHalt :
                                  Block.runWithOracle full replayPc program fuel
                                      post bodyState traceAfterBody =
                                    .ok (Structured.Outcome.halt kind postState,
                                      traceAfterPost) := by
                                simpa [Structured.Outcome.halt] using hPostRun
                              simp [hPostRun, Structured.Outcome.halt] at hRun
                              rcases hRun with ⟨hOutcome, hTraceOut⟩
                              cases hOutcome
                              simpa [hTraceOut] using
                                regular_post_halt_case
                                  (program := program) (ctx := ctx) (pre := pre)
                                  (suffix := suffix) (cond := cond)
                                  (body := body) (post := post)
                                  (bodySupply := bodySupply)
                                  (postSupply := postSupply)
                                  (loopLabel := loopLabel)
                                  (bodyLabel := bodyLabel)
                                  (postLabel := postLabel)
                                  (endLabel := endLabel)
                                  (fuel := fuel) (source := source)
                                  (stateAfterCond := stateAfterCond)
                                  (bodyState := bodyState)
                                  (postState := postState)
                                  (target := target) (tokens := tokens)
                                  (kind := kind) (trace := trace)
                                  (traceAfterCond := traceAfterCond)
                                  (traceAfterBody := traceAfterBody)
                                  (traceOut := traceAfterPost)
                                  (bodyReplayPc := replayPc)
                                  (postReplayPc := replayPc)
                                  hCondRelSafe hCondFrame hBody hPost
                                  hLayout hResolve hExact hPc hRel
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full, loopCondPc] using
                                    hCondAtLoop)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hBodyRunRegular)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hPostRunHalt)
                  | brk =>
                      have hBodyRunBrk :
                          Block.runWithOracle full replayPc program fuel body
                              stateAfterCond traceAfterCond =
                            .ok (Structured.Outcome.brk bodyState,
                              traceAfterBody) := by
                        simpa [Structured.Outcome.brk] using hBodyRun
                      simp [hBodyRun, Structured.Outcome.brk,
                        Structured.Outcome.regular] at hRun
                      rcases hRun with ⟨hOutcome, hTraceOut⟩
                      cases hOutcome
                      simpa [hTraceOut] using
                        body_brk_case
                          (program := program) (ctx := ctx) (pre := pre)
                          (suffix := suffix) (postCode := postCode)
                          (cond := cond) (body := body)
                          (bodySupply := bodySupply) (loopLabel := loopLabel)
                          (bodyLabel := bodyLabel) (postLabel := postLabel)
                          (endLabel := endLabel) (fuel := fuel)
                          (source := source)
                          (stateAfterCond := stateAfterCond)
                          (bodyState := bodyState) (target := target)
                          (tokens := tokens) (trace := trace)
                          (traceAfterCond := traceAfterCond)
                          (traceAfterBody := traceAfterBody)
                          (replayPc := replayPc)
                          hCondRelSafe hCondFrame hBody
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode]
                            using hLayout)
                          hResolve hExact hPc hRel
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode,
                            full, loopCondPc] using hCondAtLoop)
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode,
                            full] using hBodyRunBrk)
                  | cont =>
                      have hBodyRunCont :
                          Block.runWithOracle full replayPc program fuel body
                              stateAfterCond traceAfterCond =
                            .ok (Structured.Outcome.cont bodyState,
                              traceAfterBody) := by
                        simpa [Structured.Outcome.cont] using hBodyRun
                      simp [hBodyRun, Structured.Outcome.cont] at hRun
                      cases hPostRun :
                          Block.runWithOracle full replayPc program fuel post
                            bodyState traceAfterBody with
                      | error err =>
                          simp [hPostRun] at hRun
                      | ok postResult =>
                          rcases postResult with ⟨postOutcome, traceAfterPost⟩
                          rcases postOutcome with ⟨postState, postMode⟩
                          cases postMode with
                          | regular =>
                              have hPostRunRegular :
                                  Block.runWithOracle full replayPc program fuel
                                      post bodyState traceAfterBody =
                                    .ok (Structured.Outcome.regular postState,
                                      traceAfterPost) := by
                                simpa [Structured.Outcome.regular] using
                                  hPostRun
                              simp [hPostRun, Structured.Outcome.regular] at hRun
                              exact
                                cont_post_regular_case
                                  (program := program) (ctx := ctx) (pre := pre)
                                  (suffix := suffix) (cond := cond)
                                  (body := body) (post := post)
                                  (bodySupply := bodySupply)
                                  (postSupply := postSupply)
                                  (loopLabel := loopLabel)
                                  (bodyLabel := bodyLabel)
                                  (postLabel := postLabel)
                                  (endLabel := endLabel)
                                  (fuel := fuel) (source := source)
                                  (stateAfterCond := stateAfterCond)
                                  (bodyState := bodyState)
                                  (postState := postState)
                                  (outcome := outcome) (target := target)
                                  (tokens := tokens) (trace := trace)
                                  (traceAfterCond := traceAfterCond)
                                  (traceAfterBody := traceAfterBody)
                                  (traceAfterPost := traceAfterPost)
                                  (traceOut := traceOut)
                                  (bodyReplayPc := replayPc)
                                  (postReplayPc := replayPc)
                                  hCondRelSafe hCondFrame hBody hPost
                                  hLayout hResolve hExact hPc hRel
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full, loopCondPc] using
                                    hCondAtLoop)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hBodyRunCont)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hPostRunRegular)
                                  (by
                                    intro targetAtLoop hPcLoop hRelLoop
                                    exact
                                      ih
                                        (pre := pre) (suffix := suffix)
                                        (source := postState)
                                        (outcome := outcome)
                                        (target := targetAtLoop)
                                        (tokens := tokens)
                                        (trace := traceAfterPost)
                                        (traceOut := traceOut)
                                        (replayPc := replayPc)
                                        hLayout hResolve hExact hPcLoop hRelLoop
                                        (by
                                          simpa [bodyCtx, postCtx, bodyCode,
                                            postCode, full] using hRun))
                          | brk =>
                              simp [hPostRun, Structured.Outcome.brk,
                                Structured.invalid] at hRun
                          | cont =>
                              simp [hPostRun, Structured.Outcome.cont,
                                Structured.invalid] at hRun
                          | leave =>
                              have hPostRunLeave :
                                  Block.runWithOracle full replayPc program fuel
                                      post bodyState traceAfterBody =
                                    .ok (Structured.Outcome.leave postState,
                                      traceAfterPost) := by
                                simpa [Structured.Outcome.leave] using hPostRun
                              simp [hPostRun, Structured.Outcome.leave] at hRun
                              rcases hRun with ⟨hOutcome, hTraceOut⟩
                              cases hOutcome
                              simpa [hTraceOut] using
                                cont_post_leave_case
                                  (program := program) (ctx := ctx) (pre := pre)
                                  (suffix := suffix) (cond := cond)
                                  (body := body) (post := post)
                                  (bodySupply := bodySupply)
                                  (postSupply := postSupply)
                                  (loopLabel := loopLabel)
                                  (bodyLabel := bodyLabel)
                                  (postLabel := postLabel)
                                  (endLabel := endLabel)
                                  (fuel := fuel) (source := source)
                                  (stateAfterCond := stateAfterCond)
                                  (bodyState := bodyState)
                                  (postState := postState)
                                  (target := target) (tokens := tokens)
                                  (trace := trace)
                                  (traceAfterCond := traceAfterCond)
                                  (traceAfterBody := traceAfterBody)
                                  (traceOut := traceAfterPost)
                                  (bodyReplayPc := replayPc)
                                  (postReplayPc := replayPc)
                                  hCondRelSafe hCondFrame hBody hPost
                                  hLayout hResolve hExact hPc hRel
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full, loopCondPc] using
                                    hCondAtLoop)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hBodyRunCont)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hPostRunLeave)
                          | halt kind =>
                              have hPostRunHalt :
                                  Block.runWithOracle full replayPc program fuel
                                      post bodyState traceAfterBody =
                                    .ok (Structured.Outcome.halt kind postState,
                                      traceAfterPost) := by
                                simpa [Structured.Outcome.halt] using hPostRun
                              simp [hPostRun, Structured.Outcome.halt] at hRun
                              rcases hRun with ⟨hOutcome, hTraceOut⟩
                              cases hOutcome
                              simpa [hTraceOut] using
                                cont_post_halt_case
                                  (program := program) (ctx := ctx) (pre := pre)
                                  (suffix := suffix) (cond := cond)
                                  (body := body) (post := post)
                                  (bodySupply := bodySupply)
                                  (postSupply := postSupply)
                                  (loopLabel := loopLabel)
                                  (bodyLabel := bodyLabel)
                                  (postLabel := postLabel)
                                  (endLabel := endLabel)
                                  (fuel := fuel) (source := source)
                                  (stateAfterCond := stateAfterCond)
                                  (bodyState := bodyState)
                                  (postState := postState)
                                  (target := target) (tokens := tokens)
                                  (kind := kind) (trace := trace)
                                  (traceAfterCond := traceAfterCond)
                                  (traceAfterBody := traceAfterBody)
                                  (traceOut := traceAfterPost)
                                  (bodyReplayPc := replayPc)
                                  (postReplayPc := replayPc)
                                  hCondRelSafe hCondFrame hBody hPost
                                  hLayout hResolve hExact hPc hRel
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full, loopCondPc] using
                                    hCondAtLoop)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hBodyRunCont)
                                  (by simpa [bodyCtx, postCtx, bodyCode,
                                    postCode, full] using hPostRunHalt)
                  | leave =>
                      have hBodyRunLeave :
                          Block.runWithOracle full replayPc program fuel body
                              stateAfterCond traceAfterCond =
                            .ok (Structured.Outcome.leave bodyState,
                              traceAfterBody) := by
                        simpa [Structured.Outcome.leave] using hBodyRun
                      simp [hBodyRun, Structured.Outcome.leave] at hRun
                      rcases hRun with ⟨hOutcome, hTraceOut⟩
                      cases hOutcome
                      simpa [hTraceOut] using
                        body_leave_case
                          (program := program) (ctx := ctx) (pre := pre)
                          (suffix := suffix) (postCode := postCode)
                          (cond := cond) (body := body)
                          (bodySupply := bodySupply) (loopLabel := loopLabel)
                          (bodyLabel := bodyLabel) (postLabel := postLabel)
                          (endLabel := endLabel) (fuel := fuel)
                          (source := source)
                          (stateAfterCond := stateAfterCond)
                          (bodyState := bodyState) (target := target)
                          (tokens := tokens) (trace := trace)
                          (traceAfterCond := traceAfterCond)
                          (traceAfterBody := traceAfterBody)
                          (replayPc := replayPc)
                          hCondRelSafe hCondFrame hBody
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode]
                            using hLayout)
                          hResolve hExact hPc hRel
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode,
                            full, loopCondPc] using hCondAtLoop)
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode,
                            full] using hBodyRunLeave)
                  | halt kind =>
                      have hBodyRunHalt :
                          Block.runWithOracle full replayPc program fuel body
                              stateAfterCond traceAfterCond =
                            .ok (Structured.Outcome.halt kind bodyState,
                              traceAfterBody) := by
                        simpa [Structured.Outcome.halt] using hBodyRun
                      simp [hBodyRun, Structured.Outcome.halt] at hRun
                      rcases hRun with ⟨hOutcome, hTraceOut⟩
                      cases hOutcome
                      simpa [hTraceOut] using
                        body_halt_case
                          (program := program) (ctx := ctx) (pre := pre)
                          (suffix := suffix) (postCode := postCode)
                          (cond := cond) (body := body)
                          (bodySupply := bodySupply) (loopLabel := loopLabel)
                          (bodyLabel := bodyLabel) (postLabel := postLabel)
                          (endLabel := endLabel) (fuel := fuel)
                          (source := source)
                          (stateAfterCond := stateAfterCond)
                          (bodyState := bodyState) (target := target)
                          (tokens := tokens) (kind := kind) (trace := trace)
                          (traceAfterCond := traceAfterCond)
                          (traceAfterBody := traceAfterBody)
                          (replayPc := replayPc)
                          hCondRelSafe hCondFrame hBody
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode]
                            using hLayout)
                          hResolve hExact hPc hRel
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode,
                            full, loopCondPc] using hCondAtLoop)
                          (by simpa [bodyCtx, postCtx, bodyCode, postCode,
                            full] using hBodyRunHalt)

end ForLoopPreservationWithOracle

namespace SwitchPreservationWithOracle

def CasesPreservesWithOracle (program : Structured.Program)
    (ctx : Structured.CompileContext)
    (endLabel : Assembly.Label) (base : Structured.LabelSupply) :
    Structured.LabelSupply → Nat → List (Word × Structured.Block) → Prop
  | _supply, _idx, [] => True
  | supply, idx, (_value, body) :: rest =>
      let compiledBody := Structured.Block.compileFromCtx body ctx supply
      BlockPreservesWithOracle program ctx supply body ∧
        CasesPreservesWithOracle program ctx endLabel base
          compiledBody.next (idx + 1) rest

def DefaultPreservesWithOracle (program : Structured.Program)
    (ctx : Structured.CompileContext)
    (supply : Structured.LabelSupply) : Option Structured.Block → Prop
  | none => True
  | some body => BlockPreservesWithOracle program ctx supply body

theorem casesPreservesWithOracle_head {program : Structured.Program}
    {ctx : Structured.CompileContext}
    {endLabel : Assembly.Label} {base supply : Structured.LabelSupply}
    {idx : Nat}
    {value : Word} {body : Structured.Block}
    {rest : List (Word × Structured.Block)}
    (hCases :
      CasesPreservesWithOracle program ctx endLabel base supply idx
        ((value, body) :: rest)) :
    BlockPreservesWithOracle program ctx supply body := by
  exact hCases.1

theorem casesPreservesWithOracle_tail {program : Structured.Program}
    {ctx : Structured.CompileContext}
    {endLabel : Assembly.Label} {base supply : Structured.LabelSupply}
    {idx : Nat}
    {value : Word} {body : Structured.Block}
    {rest : List (Word × Structured.Block)}
    (hCases :
      CasesPreservesWithOracle program ctx endLabel base supply idx
        ((value, body) :: rest)) :
    CasesPreservesWithOracle program ctx endLabel base
      (Structured.Block.compileFromCtx body ctx supply).next (idx + 1)
      rest := by
  exact hCases.2

theorem defaultPreservesWithOracle_some {program : Structured.Program}
    {ctx : Structured.CompileContext}
    {supply : Structured.LabelSupply} {body : Structured.Block}
    (hDefault :
      DefaultPreservesWithOracle program ctx supply (some body)) :
    BlockPreservesWithOracle program ctx supply body := by
  exact hDefault

theorem casesPreservesWithOracle_of_all {program : Structured.Program}
    {ctx : Structured.CompileContext}
    {endLabel : Assembly.Label} {base supply : Structured.LabelSupply}
    {idx : Nat} {cases : List (Word × Structured.Block)}
    (hAll :
      ∀ bodySupply value body, (value, body) ∈ cases →
        BlockPreservesWithOracle program ctx bodySupply body) :
    CasesPreservesWithOracle program ctx endLabel base supply idx cases := by
  induction cases generalizing supply idx with
  | nil =>
      trivial
  | cons head rest ih =>
      rcases head with ⟨value, body⟩
      refine ⟨hAll supply value body ?_, ?_⟩
      · simp
      · exact
          ih
            (supply :=
              (Structured.Block.compileFromCtx body ctx supply).next)
            (idx := idx + 1)
            (by
              intro bodySupply value' body' hMem
              exact hAll bodySupply value' body' (by simp [hMem]))

theorem switchTestCode_observer_free (probe : Word) :
    ∀ instr ∈ Structured.Stmt.switchTestCode probe,
      Assembly.ResourceObserver.ofInstr? instr.toAssembly = none := by
  intro instr hMem
  simp [Structured.Stmt.switchTestCode] at hMem
  rcases hMem with hMem | hMem
  · subst instr
    simp [Structured.BasicInstr.toAssembly,
      Assembly.ResourceObserver.ofInstr?, basicOpObserver?]
  · rcases hMem with hMem | hMem
    · subst instr
      simp [Structured.BasicInstr.toAssembly,
        Assembly.ResourceObserver.ofInstr?]
    · subst instr
      simp [Structured.BasicInstr.toAssembly,
        Assembly.ResourceObserver.ofInstr?, basicOpObserver?]

theorem switchTestCode_oracleRelSafe (probe : Word) :
    Code.OracleRelSafe (Structured.Stmt.switchTestCode probe) :=
  Code.oracleRelSafe_of_runnerSafe_nonObserver
    (Structured.Preservation.Code.switchTestCode_runnerSafe probe)
    (switchTestCode_observer_free probe)

theorem frameSafe_singleton_eq :
    Structured.Code.FrameSafe [Structured.BasicInstr.op .eq] := by
  intro state final hidden hRun
  cases hStack : state.stack with
  | nil =>
      simp [Structured.Code.run, Structured.BasicInstr.step,
        Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
        Assembly.Target.stepInstr, Assembly.PrimOp.step,
        Assembly.PrimOp.continuingStep?, Assembly.PrimStep.run,
        EvmYul.EVM.execBinOp, EvmYul.Stack.pop2, hStack] at hRun
  | cons a rest1 =>
      cases hRest1 : rest1 with
      | nil =>
          simp [Structured.Code.run, Structured.BasicInstr.step,
            Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
            Assembly.Target.stepInstr, Assembly.PrimOp.step,
            Assembly.PrimOp.continuingStep?, Assembly.PrimStep.run,
            EvmYul.EVM.execBinOp, EvmYul.Stack.pop2, hStack, hRest1] at hRun
      | cons b rest =>
          simp [Structured.Code.run, Structured.BasicInstr.step,
            Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
            Assembly.Target.stepInstr, Assembly.PrimOp.step,
            Assembly.PrimOp.continuingStep?, Assembly.PrimStep.run,
            EvmYul.EVM.execBinOp, EvmYul.Stack.pop2, EvmYul.Stack.push,
            hStack, hRest1, EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC, Id.run] at hRun ⊢
          cases hRun
          simp [EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC]

theorem switchTestCode_oracleFrameSafe (probe : Word) :
    Code.OracleFrameSafe (Structured.Stmt.switchTestCode probe) := by
  unfold Structured.Stmt.switchTestCode
  refine
    Code.oracleFrameSafe_cons
      (instr := Structured.BasicInstr.op .dup1)
      (rest := [Structured.BasicInstr.push probe, Structured.BasicInstr.op .eq])
      ?_ ?_
  · exact
      Code.oracleFrameSafe_singleton_op_nonObserver
        (op := Structured.BasicOp.dup1)
        (by simp [basicOpObserver?])
        (Structured.Preservation.Code.frameSafe_basicOp_dup
          (op := Structured.BasicOp.dup1) (n := 1)
          (by
            simp [Structured.BasicOp.toPrimOp,
              Assembly.PrimOp.continuingStep?]))
  · refine
      Code.oracleFrameSafe_cons
        (instr := Structured.BasicInstr.push probe)
        (rest := [Structured.BasicInstr.op .eq])
        (Code.oracleFrameSafe_singleton_push probe) ?_
    refine
      Code.oracleFrameSafe_cons
        (instr := Structured.BasicInstr.op .eq)
        (rest := [])
        ?_ Code.oracleFrameSafe_nil
    exact
      Code.oracleFrameSafe_singleton_op_nonObserver
        (op := Structured.BasicOp.eq)
        (by simp [basicOpObserver?])
        frameSafe_singleton_eq

theorem switchTestCode_runConditionWithOracle
    {program : Assembly.Program} {pc : Nat}
    {source : Structured.RunState}
    {stack : EvmYul.Stack Word} {value probe : Word}
    {trace : Trace}
    (hPop : source.evm.stack.pop = some (stack, value)) :
    ∃ final,
      Code.runConditionWithOracle program pc
          (Structured.Stmt.switchTestCode probe) source trace =
        .ok (final, probe = value, trace) ∧
      final.returns = source.returns ∧
      final.evm.stack = source.evm.stack ∧
      Structured.Preservation.eraseControl final.evm =
        Structured.Preservation.eraseControl source.evm := by
  rcases
      Structured.Preservation.SwitchPreservation.test_runConditionState
        (source := source) (stack := stack) (value := value)
        (probe := probe) hPop with
    ⟨final, hRun, hReturns, hStack, hErase⟩
  have hBridge :=
    Code.runConditionWithOracle_of_observer_free
      (code := Structured.Stmt.switchTestCode probe)
      (switchTestCode_observer_free probe)
      program pc source trace
  rw [hRun] at hBridge
  exact ⟨final, hBridge, hReturns, hStack, hErase⟩

theorem test_jumpi_result_ctx {pre post : Assembly.Program}
    {label : Assembly.Label} {dest : Nat}
    {source : Structured.RunState} {target : EVMState}
    {tokens : List Word}
    {stack : EvmYul.Stack Word} {value probe : Word}
    {trace : Trace}
    (hFits :
      Structured.Preservation.Code.PCFitsFrom pre
        (Structured.Stmt.switchTestCode probe))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc
          (pre ++ (Structured.Stmt.switchTestCode probe).toAssembly ++
            [Assembly.Instr.jumpi label] ++ post) label = some dest)
    (hPop : source.evm.stack.pop = some (stack, value)) :
    ARunResultWithOracle
      (pre ++ (Structured.Stmt.switchTestCode probe).toAssembly ++
        [Assembly.Instr.jumpi label] ++ post)
      target trace
      (fun result traceFinal =>
        traceFinal = trace ∧
          match result with
          | .running target' =>
              Structured.Preservation.Frame.StateRel source target' tokens ∧
              target'.pc =
                if probe = value then
                  EvmYul.UInt256.ofNat dest
                else
                  Assembly.Program.pcAfter
                    (pre ++ (Structured.Stmt.switchTestCode probe).toAssembly ++
                      [Assembly.Instr.jumpi label])
          | .halted _ => False) := by
  rcases
      switchTestCode_runConditionWithOracle
        (program :=
          pre ++ (Structured.Stmt.switchTestCode probe).toAssembly ++
            [Assembly.Instr.jumpi label] ++ post)
        (pc := Assembly.Program.byteLength pre)
        (source := source) (stack := stack) (value := value)
        (probe := probe) (trace := trace) hPop with
    ⟨final, hRun, hReturns, hStack, hErase⟩
  have hJump :=
    Frame.StateRel.runConditionWithOracle_jumpi_result_ctx
      (code := Structured.Stmt.switchTestCode probe) (label := label)
      (dest := dest) (pre := pre) (post := post)
      (switchTestCode_oracleRelSafe probe)
      (switchTestCode_oracleFrameSafe probe)
      hFits hPc hRel hLabel hRun
  exact ARunResultWithOracle.mono hJump (by
    intro result traceFinal hResult
    rcases hResult with ⟨hTrace, hResult⟩
    exact
      ⟨hTrace,
        by
          cases result with
          | halted halt =>
              exact hResult
          | running target' =>
              rcases hResult with ⟨hFinalRel, hTargetPc⟩
              have hSourceRel :
                  Structured.Preservation.Frame.StateRel source target'
                    tokens :=
                Structured.Preservation.Frame.StateRel.cast_source
                  hFinalRel hReturns.symm hStack.symm hErase.symm
              exact ⟨hSourceRel, by simpa using hTargetPc⟩⟩)

theorem test_true_result_ctx {pre post : Assembly.Program}
    {label : Assembly.Label} {dest : Nat}
    {source : Structured.RunState} {target : EVMState}
    {tokens : List Word}
    {stack : EvmYul.Stack Word} {value probe : Word}
    {trace : Trace}
    (hEq : probe = value)
    (hFits :
      Structured.Preservation.Code.PCFitsFrom pre
        (Structured.Stmt.switchTestCode probe))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc
          (pre ++ (Structured.Stmt.switchTestCode probe).toAssembly ++
            [Assembly.Instr.jumpi label] ++ post) label = some dest)
    (hPop : source.evm.stack.pop = some (stack, value)) :
    ARunResultWithOracle
      (pre ++ (Structured.Stmt.switchTestCode probe).toAssembly ++
        [Assembly.Instr.jumpi label] ++ post)
      target trace
      (fun result traceFinal =>
        traceFinal = trace ∧
          match result with
          | .running target' =>
              Structured.Preservation.Frame.StateRel source target' tokens ∧
              target'.pc = EvmYul.UInt256.ofNat dest
          | .halted _ => False) := by
  exact ARunResultWithOracle.mono
    (test_jumpi_result_ctx (pre := pre) (post := post)
      (label := label) (dest := dest) (source := source)
      (target := target) (tokens := tokens) (stack := stack)
      (value := value) (probe := probe) (trace := trace)
      hFits hPc hRel hLabel hPop)
    (by
      intro result traceFinal hResult
      rcases hResult with ⟨hTrace, hResult⟩
      exact
        ⟨hTrace,
          by
            cases result with
            | halted halt =>
                exact hResult
            | running target' =>
                simpa [hEq] using hResult⟩)

theorem test_false_result_ctx {pre post : Assembly.Program}
    {label : Assembly.Label} {dest : Nat}
    {source : Structured.RunState} {target : EVMState}
