                        cases hBody :
                            Block.runWithOracle asmProgram pc program fuel
                              proc.body callState trace with
                        | error err =>
                            simp [hLookup, hSplit, callEVM, callState,
                              hBody] at hRun
                        | ok bodyResult =>
                            rcases bodyResult with
                              ⟨bodyOutcome, traceAfterCall⟩
                            have hBody' :
                                Block.runWithOracle asmProgram pc program
                                    fuel' proc.body callState trace =
                                  .ok (bodyOutcome, traceAfterCall) :=
                              Block.runWithOracle_mono asmProgram pc program
                                hFuelLe hBody
                            cases hBodyMode : bodyOutcome.mode <;>
                              simp [hLookup, hSplit, callEVM, callState,
                                hBody, hBody', hBodyMode] at hRun ⊢ <;>
                              exact hRun
    | terminal kind =>
        simpa [Stmt.runWithOracle] using hRun
end

