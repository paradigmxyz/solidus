theorem runWithOracle_codeStmt_of_run
    {asmProgram : Assembly.Program} {pc fuel : Nat}
    {program : Expressions.Program} {code : Structured.Code}
    {state : Expressions.RunState} {trace trace' : Trace} {evm' : EVMState}
    (hRun :
      StructuredReplay.Code.runWithOracle asmProgram pc code state.evm trace =
        .ok (evm', trace')) :
    runWithOracle asmProgram pc program (fuel + 2)
        { stmts := Locals.codeStmt code } state trace =
      .ok (Expressions.Outcome.regular (state.withEVM evm'), trace') := by
  have hStmt :
      Stmt.runWithOracle asmProgram pc program (fuel + 1)
          (Expressions.Stmt.code code) state trace =
        .ok (Expressions.Outcome.regular (state.withEVM evm'), trace') :=
    Stmt.runWithOracle_code_of_run
      (asmProgram := asmProgram) (pc := pc) (fuel := fuel + 1)
      (program := program) hRun
  have hNil :
      runWithOracle asmProgram pc program (fuel + 1) { stmts := [] }
          (state.withEVM evm') trace' =
        .ok (Expressions.Outcome.regular (state.withEVM evm'), trace') :=
    runWithOracle_nil asmProgram pc program fuel (state.withEVM evm') trace'
  simpa [Locals.codeStmt] using
    runWithOracle_cons_regular_of_runs
      (asmProgram := asmProgram) (pc := pc) (fuel := fuel + 1)
      (program := program) (stmt := Expressions.Stmt.code code)
      (rest := []) (state := state) (stateAfterStmt := state.withEVM evm')
        (trace := trace) (traceAfterStmt := trace')
        (result :=
          (Expressions.Outcome.regular (state.withEVM evm'), trace'))
        hStmt hNil

  theorem runWithOracle_codeStmt_source_runNResultWithOracle_segment_of_oracleStepPC
      {pre post : Assembly.Program} {code : Structured.Code}
      {program : Expressions.Program} {fuel : Nat}
      {state state' : Expressions.RunState} {trace trace' : Trace}
      (hStepPC : StructuredReplay.Code.OracleStepPC code)
      (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
      (hPc : state.evm.pc = Assembly.Program.pcAfter pre)
      (hRun :
        runWithOracle (pre ++ code.toAssembly ++ post)
            (Assembly.Program.byteLength pre) program (fuel + 2)
            { stmts := Locals.codeStmt code } state trace =
          .ok (Expressions.Outcome.regular state', trace')) :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ post) code.length state.evm trace =
        .ok (.running state'.evm, trace') ∧
      state'.evm.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly) ∧
      state' = state.withEVM state'.evm := by
    cases hCodeRun :
        StructuredReplay.Code.runWithOracle
          (pre ++ (code.toAssembly ++ post))
          (Assembly.Program.byteLength pre) code state.evm trace with
    | error err =>
        simp [runWithOracle, Stmt.runWithOracle, Locals.codeStmt,
          hCodeRun] at hRun
    | ok codePair =>
        rcases codePair with ⟨evmMid, traceMid⟩
        simp [runWithOracle, Stmt.runWithOracle, Locals.codeStmt,
          hCodeRun, Expressions.Outcome.regular] at hRun
        have hCodeRun' :
            StructuredReplay.Code.runWithOracle
              (pre ++ code.toAssembly ++ post)
              (Assembly.Program.byteLength pre) code state.evm trace =
            .ok (evmMid, traceMid) := by
          simpa [List.append_assoc] using hCodeRun
        rcases
            StructuredReplay.Code.runWithOracle_source_runNResultWithOracle_segment_of_oracleStepPC
              hStepPC hFits hPc hCodeRun' with
          ⟨hSource, hEndPc⟩
        rcases hRun with ⟨hState, hTrace⟩
        cases hState
        cases hTrace
        exact
          ⟨by simpa [Structured.RunState.withEVM] using hSource,
            by simpa [Structured.RunState.withEVM] using hEndPc,
            rfl⟩

  theorem runWithOracle_codeStmt_source_runNResultWithOracle_rel_segment
      {pre post : Assembly.Program} {code : Structured.Code}
      {program : Expressions.Program} {fuel : Nat}
      {state state' : Expressions.RunState} {target : EVMState}
      {trace trace' : Trace}
      (hRelSafe : StructuredReplay.Code.OracleRelSafe code)
      (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
      (hPc : target.pc = Assembly.Program.pcAfter pre)
      (hData : Structured.Preservation.SameData target state.evm)
      (hRun :
        runWithOracle (pre ++ code.toAssembly ++ post)
            (Assembly.Program.byteLength pre) program (fuel + 2)
            { stmts := Locals.codeStmt code } state trace =
          .ok (Expressions.Outcome.regular state', trace')) :
      ∃ target',
        Assembly.Source.runNResultWithOracle
            (pre ++ code.toAssembly ++ post) code.length target trace =
          .ok (.running target', trace') ∧
        Structured.Preservation.SameData target' state'.evm ∧
        target'.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly) ∧
        state' = state.withEVM state'.evm := by
    cases hCodeRun :
        StructuredReplay.Code.runWithOracle
          (pre ++ (code.toAssembly ++ post))
          (Assembly.Program.byteLength pre) code state.evm trace with
    | error err =>
        simp [runWithOracle, Stmt.runWithOracle, Locals.codeStmt,
          hCodeRun] at hRun
    | ok codePair =>
        rcases codePair with ⟨evmMid, traceMid⟩
        simp [runWithOracle, Stmt.runWithOracle, Locals.codeStmt,
          hCodeRun, Expressions.Outcome.regular] at hRun
        have hCodeRun' :
            StructuredReplay.Code.runWithOracle
              (pre ++ code.toAssembly ++ post)
              (Assembly.Program.byteLength pre) code state.evm trace =
            .ok (evmMid, traceMid) := by
          simpa [List.append_assoc] using hCodeRun
        rcases
            StructuredReplay.Code.runWithOracle_source_runNResultWithOracle_rel_segment
              hRelSafe hFits hPc hData hCodeRun' with
          ⟨targetFinal, hSource, hFinalData, hEndPc⟩
        rcases hRun with ⟨hState, hTrace⟩
        cases hState
        cases hTrace
        exact
          ⟨targetFinal,
            by simpa [Structured.RunState.withEVM] using hSource,
            by simpa [Structured.RunState.withEVM] using hFinalData,
            by simpa [Structured.RunState.withEVM] using hEndPc,
            rfl⟩

  theorem runWithOracle_codeStmt_source_runNResultWithOracle_segment_of_runnerSafe
      {pre post : Assembly.Program} {code : Structured.Code}
      {program : Expressions.Program} {fuel : Nat}
    {state state' : Expressions.RunState} {trace trace' : Trace}
    (hSafe : Structured.Preservation.Code.RunnerSafe code)
    (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
    (hPc : state.evm.pc = Assembly.Program.pcAfter pre)
    (hRun :
      runWithOracle (pre ++ code.toAssembly ++ post)
          (Assembly.Program.byteLength pre) program (fuel + 2)
          { stmts := Locals.codeStmt code } state trace =
        .ok (Expressions.Outcome.regular state', trace')) :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ post) code.length state.evm trace =
        .ok (.running state'.evm, trace') ∧
      state'.evm.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly) ∧
      state' = state.withEVM state'.evm :=
    runWithOracle_codeStmt_source_runNResultWithOracle_segment_of_oracleStepPC
      (StructuredReplay.Code.oracleStepPC_of_runnerSafe hSafe) hFits hPc hRun

  theorem runWithOracle_codeStmt_source_runNResultWithOracle_bind_of_oracleStepPC
      {pre post : Assembly.Program} {code : Structured.Code}
      {program : Expressions.Program} {fuel restFuel : Nat}
      {state state' : Expressions.RunState}
      {trace trace' traceOut : Trace}
      {result : Assembly.StepResult}
      (hStepPC : StructuredReplay.Code.OracleStepPC code)
      (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
      (hPc : state.evm.pc = Assembly.Program.pcAfter pre)
      (hRun :
        runWithOracle (pre ++ code.toAssembly ++ post)
            (Assembly.Program.byteLength pre) program (fuel + 2)
            { stmts := Locals.codeStmt code } state trace =
          .ok (Expressions.Outcome.regular state', trace'))
      (hTail :
        Assembly.Source.runNResultWithOracle
            (pre ++ code.toAssembly ++ post) restFuel state'.evm trace' =
          .ok (result, traceOut)) :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ post) (code.length + restFuel)
          state.evm trace =
        .ok (result, traceOut) ∧
      state'.evm.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly) ∧
      state' = state.withEVM state'.evm := by
    rcases
        runWithOracle_codeStmt_source_runNResultWithOracle_segment_of_oracleStepPC
          hStepPC hFits hPc hRun with
      ⟨hHead, hEndPc, hStateShape⟩
    exact
      ⟨Assembly.Source.runNResultWithOracle_running_bind hHead hTail,
        hEndPc, hStateShape⟩

  theorem runWithOracle_codeStmt_source_runNResultWithOracle_bind_of_runnerSafe
      {pre post : Assembly.Program} {code : Structured.Code}
      {program : Expressions.Program} {fuel restFuel : Nat}
    {state state' : Expressions.RunState}
    {trace trace' traceOut : Trace}
    {result : Assembly.StepResult}
    (hSafe : Structured.Preservation.Code.RunnerSafe code)
    (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
    (hPc : state.evm.pc = Assembly.Program.pcAfter pre)
    (hRun :
      runWithOracle (pre ++ code.toAssembly ++ post)
          (Assembly.Program.byteLength pre) program (fuel + 2)
          { stmts := Locals.codeStmt code } state trace =
        .ok (Expressions.Outcome.regular state', trace'))
    (hTail :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ post) restFuel state'.evm trace' =
        .ok (result, traceOut)) :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ post) (code.length + restFuel)
          state.evm trace =
        .ok (result, traceOut) ∧
      state'.evm.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly) ∧
      state' = state.withEVM state'.evm :=
    runWithOracle_codeStmt_source_runNResultWithOracle_bind_of_oracleStepPC
      (StructuredReplay.Code.oracleStepPC_of_runnerSafe hSafe) hFits hPc
      hRun hTail

theorem runWithOracle_cleanupTo_scope_exists
    {asmProgram : Assembly.Program} {pc fuel : Nat}
    {program : Expressions.Program}
    {ctx : Locals.Ctx} {scope : List Name}
    {source : Locals.Source.State} {target : Locals.RunState}
    {cleanup : Structured.Code} {trace : Trace}
    (hScope : Locals.SourceLowering.CleanupScopeRel ctx.layout scope)
    (hRel : Locals.SourceLowering.StateRel ctx.layout source target)
    (hCleanup : ctx.cleanupTo? scope.length = some cleanup) :
    ∃ cleaned,
      runWithOracle asmProgram pc program (fuel + 2)
          { stmts := Locals.codeStmt cleanup } target trace =
        .ok (Expressions.Outcome.regular cleaned, trace) ∧
      Locals.SourceLowering.StateRel scope (source.restrictTo scope) cleaned ∧
      cleaned.returns = target.returns := by
  have hDepth : scope.length ≤ ctx.layout.length :=
    Locals.SourceLowering.CleanupScopeRel.depth_le hScope
  rcases hRel with ⟨hSharedRel, hStackRel⟩
  rcases hStackRel with ⟨hStackLen, hStackLookup⟩
  let n := ctx.layout.length - scope.length
  have hRunLen : n ≤ target.evm.stack.length := by
    dsimp [n]
    omega
  have hCleanupCode :
      cleanup =
        List.replicate n (Structured.BasicInstr.op .pop) := by
    unfold Locals.Ctx.cleanupTo? at hCleanup
    simp [hDepth] at hCleanup
    exact hCleanup.symm
  rcases
      StructuredReplay.Code.runWithOracle_replicate_pop_exists
        asmProgram pc target.evm trace n hRunLen with
    ⟨evmClean, hRun, hCleanStack, hCleanShared⟩
  have hRunCleanup :
      StructuredReplay.Code.runWithOracle asmProgram pc cleanup
          target.evm trace =
        .ok (evmClean, trace) := by
    simpa [hCleanupCode] using hRun
  refine ⟨target.withEVM evmClean, ?_, ?_, rfl⟩
  · exact runWithOracle_codeStmt_of_run hRunCleanup
  · constructor
    · simpa [Structured.RunState.withEVM, Locals.Source.State.restrictTo,
        hCleanShared] using hSharedRel
    · constructor
      · have hScopeN : ctx.layout.drop n = scope := by
          simpa [n] using hScope
        have hScopeLen :
            (ctx.layout.drop n).length = scope.length := by
          rw [hScopeN]
        simpa [Structured.RunState.withEVM, hCleanStack, hStackLen] using
          hScopeLen
      · intro idx name hName
        have hScopeN : ctx.layout.drop n = scope := by
          simpa [n] using hScope
        have hLayoutAt :
            ctx.layout[n + idx]? = some name := by
          have hDropAt :
              (ctx.layout.drop n)[idx]? = some name := by
            rw [hScopeN]
            exact hName
          simpa [List.getElem?_drop] using hDropAt
        have hStackAt := hStackLookup hLayoutAt
        have hNameMem : name ∈ scope :=
          List.mem_of_getElem? hName
        simp [Structured.RunState.withEVM, hCleanStack, List.getElem?_drop,
          Locals.Source.State.restrictTo, Locals.Source.Store.restrictTo, n,
          hNameMem, hStackAt]

end Block

end ExpressionsReplay

mutual
  def ExprObserverFree {results : Nat} :
      Locals.Expr results → Prop
    | .lit _value => True
    | .var _name => True
    | .code _code => False
    | .prim op args =>
        basicOpObserver? op = none ∧ ExprSeqObserverFree args

  def ExprSeqObserverFree {results : Nat} :
      Locals.ExprSeq results → Prop
    | .nil => True
    | .cons head tail =>
        ExprObserverFree head ∧ ExprSeqObserverFree tail
end

mutual
  inductive BlockObserverFree : Locals.Block → Prop where
    | mk {stmts : List Locals.Stmt}
        (hStmts : StmtListObserverFree stmts) :
        BlockObserverFree ⟨stmts⟩

  inductive StmtObserverFree : Locals.Stmt → Prop where
    | expr {results : Nat} {expr : Locals.Expr results}
        (hExpr : ExprObserverFree expr) :
        StmtObserverFree (.expr expr)
    | exprs {results : Nat} {exprs : Locals.ExprSeq results}
        (hExprs : ExprSeqObserverFree exprs) :
        StmtObserverFree (.exprs exprs)
    | let_ {name : Name} {value : Locals.Expr 1}
        (hValue : ExprObserverFree value) :
        StmtObserverFree (.let_ name value)
    | assign {name : Name} {value : Locals.Expr 1}
        (hValue : ExprObserverFree value) :
        StmtObserverFree (.assign name value)
    | assignTop {name : Name} :
        StmtObserverFree (.assignTop name)
    | assignTopWithOffset {offset : Nat} {name : Name} :
        StmtObserverFree (.assignTopWithOffset offset name)
    | promoteName {name : Name} :
        StmtObserverFree (.promoteName name)
    | cleanupTo {targetLayout : Locals.Layout} :
        StmtObserverFree (.cleanupTo targetLayout)
    | block {body : Locals.Block}
        (hBody : BlockObserverFree body) :
        StmtObserverFree (.block body)
    | if_ {cond : Locals.Expr 1} {body : Locals.Block}
        (hCond : ExprObserverFree cond)
        (hBody : BlockObserverFree body) :
        StmtObserverFree (.if_ cond body)
    | switch {scrutinee : Locals.Expr 1}
        {cases : List (Word × Locals.Block)}
        {defaultBody : Option Locals.Block}
        (hScrutinee : ExprObserverFree scrutinee)
        (hCases :
          ∀ value body, (value, body) ∈ cases →
            BlockObserverFree body)
        (hDefault :
          ∀ body, defaultBody = some body → BlockObserverFree body) :
        StmtObserverFree (.switch scrutinee cases defaultBody)
    | for_ {init : Locals.Block} {cond : Locals.Expr 1}
        {post body : Locals.Block}
        (hInit : BlockObserverFree init)
        (hCond : ExprObserverFree cond)
        (hPost : BlockObserverFree post)
        (hBody : BlockObserverFree body) :
        StmtObserverFree (.for_ init cond post body)
    | brk : StmtObserverFree .brk
    | cont : StmtObserverFree .cont
    | leave : StmtObserverFree .leave
    | call {name : Name} : StmtObserverFree (.call name)
    | terminal {kind : Assembly.HaltKind} :
        StmtObserverFree (.terminal kind)
    | terminalArgs {kind : Assembly.HaltKind}
        {args : Locals.ExprSeq kind.argCount}
        (hArgs : ExprSeqObserverFree args) :
        StmtObserverFree (.terminalArgs kind args)

  inductive StmtListObserverFree : List Locals.Stmt → Prop where
    | nil : StmtListObserverFree []
    | cons {stmt : Locals.Stmt} {rest : List Locals.Stmt}
        (hStmt : StmtObserverFree stmt)
        (hRest : StmtListObserverFree rest) :
        StmtListObserverFree (stmt :: rest)
end

theorem blockObserverFree_of_select
    {scrutinee : Word} {cases : List (Word × Locals.Block)}
    {defaultBody : Option Locals.Block} {selected : Locals.Block}
    (hCases :
      ∀ value body, (value, body) ∈ cases → BlockObserverFree body)
    (hDefault :
      ∀ body, defaultBody = some body → BlockObserverFree body)
    (hSelect : Locals.Source.Switch.select scrutinee cases defaultBody =
      some selected) :
    BlockObserverFree selected := by
  induction cases with
  | nil =>
      simp [Locals.Source.Switch.select] at hSelect
      exact hDefault selected hSelect
  | cons head rest ih =>
      rcases head with ⟨caseValue, caseBlock⟩
      by_cases hMatch : caseValue = scrutinee
      · simp [Locals.Source.Switch.select, hMatch] at hSelect
        cases hSelect
        exact hCases caseValue selected (by simp)
      · simp [Locals.Source.Switch.select, hMatch] at hSelect
        exact ih
          (by
            intro restValue restBody hMem
            exact hCases restValue restBody (by simp [hMem]))
          hSelect

namespace SourceReplay

abbrev Store := Locals.Source.Store
abbrev SourceState := Locals.Source.State
abbrev Ctx := Locals.Source.Ctx
abbrev Mode := Locals.Source.Mode

abbrev invalid {α : Type} : Except EVMException α :=
  Structured.invalid

structure State where
  source : SourceState
  trace : Trace

namespace State

def shared (state : State) : EvmYul.SharedState .EVM :=
  state.source.shared

def vars (state : State) : Store :=
  state.source.vars

def withSource (state : State) (source : SourceState) : State :=
  { state with source := source }

def withTrace (state : State) (trace : Trace) : State :=
  { state with trace := trace }

def withShared (state : State) (shared : EvmYul.SharedState .EVM) :
    State :=
  state.withSource (state.source.withShared shared)

def withVars (state : State) (vars : Store) : State :=
  state.withSource (state.source.withVars vars)

def restrictTo (scope : List Name) (state : State) : State :=
  state.withSource (state.source.restrictTo scope)

def insert (state : State) (name : Name) (value : Word) : State :=
  state.withSource (state.source.insert name value)

def initial (shared : EvmYul.SharedState .EVM) (trace : Trace) : State :=
  { source := Locals.Source.Program.initialState shared, trace := trace }

@[simp] theorem withSource_source (state : State) (source : SourceState) :
    (state.withSource source).source = source := rfl

@[simp] theorem withSource_trace (state : State) (source : SourceState) :
    (state.withSource source).trace = state.trace := rfl

@[simp] theorem withTrace_source (state : State) (trace : Trace) :
    (state.withTrace trace).source = state.source := rfl

@[simp] theorem withTrace_trace (state : State) (trace : Trace) :
    (state.withTrace trace).trace = trace := rfl

@[simp] theorem withShared_source (state : State)
    (shared : EvmYul.SharedState .EVM) :
    (state.withShared shared).source = state.source.withShared shared := rfl

@[simp] theorem withShared_trace (state : State)
    (shared : EvmYul.SharedState .EVM) :
    (state.withShared shared).trace = state.trace := rfl

@[simp] theorem withVars_source (state : State) (vars : Store) :
    (state.withVars vars).source = state.source.withVars vars := rfl

@[simp] theorem withVars_trace (state : State) (vars : Store) :
    (state.withVars vars).trace = state.trace := rfl

@[simp] theorem restrictTo_source (state : State) (scope : List Name) :
    (state.restrictTo scope).source = state.source.restrictTo scope := rfl

@[simp] theorem restrictTo_trace (state : State) (scope : List Name) :
    (state.restrictTo scope).trace = state.trace := rfl

@[simp] theorem insert_source (state : State) (name : Name) (value : Word) :
    (state.insert name value).source = state.source.insert name value := rfl

@[simp] theorem insert_trace (state : State) (name : Name) (value : Word) :
    (state.insert name value).trace = state.trace := rfl

end State

structure Outcome where
  state : State
  mode : Mode

namespace Outcome

def regular (state : State) : Outcome :=
  { state := state, mode := .regular }

def brk (state : State) : Outcome :=
