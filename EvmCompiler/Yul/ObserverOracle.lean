def StmtPreservesWithOracle (program : Structured.Program)
    (ctx : Structured.CompileContext) (supply : Structured.LabelSupply)
    (stmt : Structured.Stmt) : Prop :=
  ∀ {pre post : Assembly.Program} {fuel : Nat}
    {source : Structured.RunState} {outcome : Structured.Outcome}
    {target : EVMState} {tokens : List Word}
    {trace traceOut : Trace} {replayPc : Nat},
    Structured.Preservation.AssemblyProgram.PCFitsFrom pre
        (Structured.Stmt.compileFromCtxCore stmt ctx supply).code →
      Structured.Preservation.ContextLabelsResolve
        (pre ++ (Structured.Stmt.compileFromCtxCore stmt ctx supply).code ++
          post) ctx →
      Structured.Preservation.ExactLabels
        (pre ++ (Structured.Stmt.compileFromCtxCore stmt ctx supply).code ++
          post) →
      target.pc = Assembly.Program.pcAfter pre →
      Structured.Preservation.Frame.StateRel source target tokens →
      Stmt.runWithOracle
          (pre ++ (Structured.Stmt.compileFromCtxCore stmt ctx supply).code ++
            post)
          replayPc program fuel stmt source trace =
        .ok (outcome, traceOut) →
      ARunResultWithOracle
        (pre ++ (Structured.Stmt.compileFromCtxCore stmt ctx supply).code ++
          post)
        target trace
        (fun result traceFinal =>
          traceFinal = traceOut ∧
            Structured.Preservation.CompiledOutcomeRel
              (pre ++
                (Structured.Stmt.compileFromCtxCore stmt ctx supply).code ++
                post)
              ctx
              (Assembly.Program.pcAfter
                (pre ++
                  (Structured.Stmt.compileFromCtxCore stmt ctx supply).code))
              outcome result tokens)

def BlockPreservesWithOracle (program : Structured.Program)
    (ctx : Structured.CompileContext) (supply : Structured.LabelSupply)
    (block : Structured.Block) : Prop :=
  ∀ {pre post : Assembly.Program} {fuel : Nat}
    {source : Structured.RunState} {outcome : Structured.Outcome}
    {target : EVMState} {tokens : List Word}
    {trace traceOut : Trace} {replayPc : Nat},
    Structured.Preservation.AssemblyProgram.PCFitsFrom pre
        (Structured.Block.compileFromCtx block ctx supply).code →
      Structured.Preservation.ContextLabelsResolve
        (pre ++ (Structured.Block.compileFromCtx block ctx supply).code ++
          post) ctx →
      Structured.Preservation.ExactLabels
        (pre ++ (Structured.Block.compileFromCtx block ctx supply).code ++
          post) →
      target.pc = Assembly.Program.pcAfter pre →
      Structured.Preservation.Frame.StateRel source target tokens →
      Block.runWithOracle
          (pre ++ (Structured.Block.compileFromCtx block ctx supply).code ++
            post)
          replayPc program fuel block source trace =
        .ok (outcome, traceOut) →
      ARunResultWithOracle
        (pre ++ (Structured.Block.compileFromCtx block ctx supply).code ++
          post)
        target trace
        (fun result traceFinal =>
          traceFinal = traceOut ∧
            Structured.Preservation.CompiledOutcomeRel
              (pre ++
                (Structured.Block.compileFromCtx block ctx supply).code ++
                post)
              ctx
              (Assembly.Program.pcAfter
                (pre ++
                  (Structured.Block.compileFromCtx block ctx supply).code))
              outcome result tokens)

namespace ForLoopPreservationWithOracle

theorem false_case {ctx : Structured.CompileContext}
    {pre suffix bodyCode postCode : Assembly.Program}
    {cond : Structured.Code}
    {loopLabel bodyLabel postLabel endLabel : Assembly.Label}
    {source stateAfterCond : Structured.RunState} {target : EVMState}
    {tokens : List Word} {trace traceAfterCond : Trace}
    (hCondRelSafe : Code.OracleRelSafe cond)
    (hCondFrame : Code.OracleFrameSafe cond)
    (hLayout :
      Structured.Preservation.ForLoop.Layout pre suffix cond bodyCode postCode
        loopLabel bodyLabel postLabel endLabel)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hCond :
      Code.runConditionWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        (Assembly.Program.byteLength
          (Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel))
        cond source trace =
          .ok (stateAfterCond, false, traceAfterCond)) :
    ARunResultWithOracle
      (pre ++
        Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
          loopLabel bodyLabel postLabel endLabel ++ suffix)
      target trace
      (fun result traceFinal =>
        traceFinal = traceAfterCond ∧
          Structured.Preservation.CompiledOutcomeRel
            (pre ++
              Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
                loopLabel bodyLabel postLabel endLabel ++ suffix)
            ctx
            (Assembly.Program.pcAfter
              (pre ++
                Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
                  loopLabel bodyLabel postLabel endLabel))
            (Structured.Outcome.regular stateAfterCond) result tokens) := by
  let loopPre :=
    Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel
  let afterJumpi :=
    Structured.Preservation.ForLoop.afterCondJumpi pre cond loopLabel bodyLabel
  let bodyLabelPre :=
    Structured.Preservation.ForLoop.bodyLabelPre pre cond loopLabel bodyLabel
      endLabel
  let endLabelPre :=
    Structured.Preservation.ForLoop.endLabelPre pre cond bodyCode postCode
      loopLabel bodyLabel postLabel endLabel
  have hLoopLabelRun :=
    Frame.StateRel.label_runResultWithOracle_at
      (label := loopLabel) (pre := pre)
      (post :=
        cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel] ++
          suffix)
      (source := source) (target := target) (tokens := tokens)
      (trace := trace)
      hLayout.fitLoopLabel hPc hRel
  refine
    ARunResultWithOracle.bind_running
      (program :=
        pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix)
      (middle := fun targetAtCond traceAtCond =>
        traceAtCond = trace ∧
          Structured.Preservation.Frame.StateRel source targetAtCond tokens ∧
          targetAtCond.pc = Assembly.Program.pcAfter loopPre)
      ?_ ?_
  · exact ARunResultWithOracle.mono
      (by
        simpa [Structured.Preservation.ForLoop.coreCode,
          Structured.Preservation.ForLoop.afterLoopLabel, loopPre,
          List.append_assoc] using hLoopLabelRun)
      (by
        intro result traceMid hResult
        rcases hResult with ⟨hTraceMid, hResult⟩
        cases result with
        | halted halt =>
            exact hResult
        | running targetAtCond =>
            exact ⟨hTraceMid, by simpa [loopPre] using hResult⟩)
  · intro targetAtCond traceAtCond hAtCond
    rcases hAtCond with ⟨hTraceAtCond, hRelAtCond, hPcAtCond⟩
    subst traceAtCond
    have hBodyLabel :
        Assembly.Program.labelPc
            (loopPre ++ cond.toAssembly ++ [Assembly.Instr.jumpi bodyLabel] ++
              ([Assembly.Instr.jump endLabel,
                Assembly.Instr.label bodyLabel] ++ bodyCode ++
                [Assembly.Instr.label postLabel] ++ postCode ++
                [Assembly.Instr.jump loopLabel,
                  Assembly.Instr.label endLabel] ++ suffix))
            bodyLabel =
          some (Assembly.Program.byteLength bodyLabelPre) := by
      simpa [Structured.Preservation.ForLoop.coreCode,
        Structured.Preservation.ForLoop.afterLoopLabel,
        Structured.Preservation.ForLoop.afterCondJumpi,
        Structured.Preservation.ForLoop.bodyLabelPre, loopPre, afterJumpi,
        bodyLabelPre, List.append_assoc] using hLayout.bodyLabelPc
    have hCondJump :=
      Frame.StateRel.runConditionWithOracle_jumpi_result_ctx
        (code := cond) (label := bodyLabel)
        (dest := Assembly.Program.byteLength bodyLabelPre)
        (pre := loopPre)
        (post :=
          [Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
            bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
            [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel] ++
            suffix)
        hCondRelSafe hCondFrame hLayout.fitCond hPcAtCond hRelAtCond
        hBodyLabel
        (by
          simpa [Structured.Preservation.ForLoop.coreCode,
            Structured.Preservation.ForLoop.afterLoopLabel, loopPre,
            List.append_assoc] using hCond)
    have hCondFalse :
        ARunResultWithOracle
          (pre ++
            Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
              loopLabel bodyLabel postLabel endLabel ++ suffix)
          targetAtCond trace
          (fun result traceMid =>
            match result with
            | .running targetAfterCond =>
                traceMid = traceAfterCond ∧
                  Structured.Preservation.Frame.StateRel stateAfterCond
                    targetAfterCond tokens ∧
                  targetAfterCond.pc = Assembly.Program.pcAfter afterJumpi
            | .halted _ => False) := by
      exact ARunResultWithOracle.mono
        (by
          simpa [Structured.Preservation.ForLoop.coreCode,
            Structured.Preservation.ForLoop.afterLoopLabel,
            Structured.Preservation.ForLoop.afterCondJumpi, loopPre,
            afterJumpi, List.append_assoc] using hCondJump)
        (by
          intro result traceMid hResult
          rcases hResult with ⟨hTraceMid, hResult⟩
          cases result with
          | halted halt =>
              exact hResult
          | running targetAfterCond =>
              exact
                ⟨hTraceMid,
                  by
                    simpa [afterJumpi,
                      Structured.Preservation.ForLoop.afterCondJumpi,
                      Structured.Preservation.ForLoop.afterLoopLabel, loopPre,
                      List.append_assoc] using hResult⟩)
    refine ARunResultWithOracle.bind_running hCondFalse ?_
    intro targetAfterCond traceMid hAfterCond
    rcases hAfterCond with ⟨hTraceMid, hRelAfterCond, hPcAfterCond⟩
    subst traceMid
    have hEndLabel :
        Assembly.Program.labelPc
            (afterJumpi ++ [Assembly.Instr.jump endLabel] ++
              ([Assembly.Instr.label bodyLabel] ++ bodyCode ++
                [Assembly.Instr.label postLabel] ++ postCode ++
                [Assembly.Instr.jump loopLabel]) ++
              [Assembly.Instr.label endLabel] ++ suffix)
            endLabel =
          some
            (Assembly.Program.byteLength
              (afterJumpi ++ [Assembly.Instr.jump endLabel] ++
                ([Assembly.Instr.label bodyLabel] ++ bodyCode ++
                  [Assembly.Instr.label postLabel] ++ postCode ++
                  [Assembly.Instr.jump loopLabel]))) := by
      simpa [Structured.Preservation.ForLoop.coreCode,
        Structured.Preservation.ForLoop.afterLoopLabel,
        Structured.Preservation.ForLoop.afterCondJumpi,
        Structured.Preservation.ForLoop.bodyLabelPre,
        Structured.Preservation.ForLoop.bodyPre,
        Structured.Preservation.ForLoop.postLabelPre,
        Structured.Preservation.ForLoop.postPre,
        Structured.Preservation.ForLoop.endLabelPre, loopPre, afterJumpi,
        bodyLabelPre, endLabelPre, List.append_assoc] using hLayout.endLabelPc
    have hJumpEnd :=
      Frame.StateRel.jump_then_label_runResultWithOracle_at
        (label := endLabel) (pre := afterJumpi)
        (between :=
          [Assembly.Instr.label bodyLabel] ++ bodyCode ++
            [Assembly.Instr.label postLabel] ++ postCode ++
            [Assembly.Instr.jump loopLabel])
        (post := suffix) (source := stateAfterCond)
        (target := targetAfterCond) (tokens := tokens)
        (trace := traceAfterCond)
        hLayout.fitJumpEnd
        (by
          simpa [Structured.Preservation.ForLoop.afterCondJumpi,
            Structured.Preservation.ForLoop.bodyLabelPre,
            Structured.Preservation.ForLoop.bodyPre,
            Structured.Preservation.ForLoop.postLabelPre,
            Structured.Preservation.ForLoop.postPre,
            Structured.Preservation.ForLoop.endLabelPre, afterJumpi,
            endLabelPre, List.append_assoc] using hLayout.fitEndLabel)
        hPcAfterCond hRelAfterCond hEndLabel
    exact ARunResultWithOracle.mono
      (by
        simpa [Structured.Preservation.ForLoop.coreCode,
          Structured.Preservation.ForLoop.afterLoopLabel,
          Structured.Preservation.ForLoop.afterCondJumpi,
          Structured.Preservation.ForLoop.bodyLabelPre,
          Structured.Preservation.ForLoop.bodyPre,
          Structured.Preservation.ForLoop.postLabelPre,
          Structured.Preservation.ForLoop.postPre,
          Structured.Preservation.ForLoop.endLabelPre, loopPre, afterJumpi,
          bodyLabelPre, endLabelPre, List.append_assoc] using hJumpEnd)
      (by
        intro result traceFinal hResult
        rcases hResult with ⟨hTraceFinal, hResult⟩
        exact
          ⟨hTraceFinal,
            by
              cases result with
              | halted halt =>
                  exact hResult
              | running targetFinal =>
                  simpa [Structured.Preservation.ForLoop.coreCode,
                    Structured.Preservation.ForLoop.afterLoopLabel,
                    Structured.Preservation.ForLoop.afterCondJumpi,
                    Structured.Preservation.ForLoop.bodyLabelPre,
                    Structured.Preservation.ForLoop.bodyPre,
                    Structured.Preservation.ForLoop.postLabelPre,
                    Structured.Preservation.ForLoop.postPre,
                    Structured.Preservation.ForLoop.endLabelPre, loopPre,
                    afterJumpi, bodyLabelPre, endLabelPre,
                    Structured.Preservation.CompiledOutcomeRel,
                    Structured.Outcome.regular, List.append_assoc] using
                    hResult⟩)

theorem enter_body {pre suffix bodyCode postCode : Assembly.Program}
    {cond : Structured.Code}
    {loopLabel bodyLabel postLabel endLabel : Assembly.Label}
    {source stateAfterCond : Structured.RunState} {target : EVMState}
    {tokens : List Word} {trace traceAfterCond : Trace}
    (hCondRelSafe : Code.OracleRelSafe cond)
    (hCondFrame : Code.OracleFrameSafe cond)
    (hLayout :
      Structured.Preservation.ForLoop.Layout pre suffix cond bodyCode postCode
        loopLabel bodyLabel postLabel endLabel)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hCond :
      Code.runConditionWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix)
        (Assembly.Program.byteLength
          (Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel))
        cond source trace =
          .ok (stateAfterCond, true, traceAfterCond)) :
    ARunResultWithOracle
      (pre ++
        Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
          loopLabel bodyLabel postLabel endLabel ++ suffix)
      target trace
      (fun result traceFinal =>
        traceFinal = traceAfterCond ∧
          match result with
          | .running targetAtBody =>
              Structured.Preservation.Frame.StateRel stateAfterCond
                targetAtBody tokens ∧
              targetAtBody.pc =
                Assembly.Program.pcAfter
                  (Structured.Preservation.ForLoop.bodyPre pre cond loopLabel
                    bodyLabel endLabel)
          | .halted _ => False) := by
  let loopPre :=
    Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel
  let bodyLabelPre :=
    Structured.Preservation.ForLoop.bodyLabelPre pre cond loopLabel bodyLabel
      endLabel
  let bodyPre :=
    Structured.Preservation.ForLoop.bodyPre pre cond loopLabel bodyLabel
      endLabel
  have hLoopLabelRun :=
    Frame.StateRel.label_runResultWithOracle_at
      (label := loopLabel) (pre := pre)
      (post :=
        cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel] ++
          suffix)
      (source := source) (target := target) (tokens := tokens)
      (trace := trace)
      hLayout.fitLoopLabel hPc hRel
  refine
    ARunResultWithOracle.bind_running
      (program :=
        pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix)
      (middle := fun targetAtCond traceAtCond =>
        traceAtCond = trace ∧
          Structured.Preservation.Frame.StateRel source targetAtCond tokens ∧
          targetAtCond.pc = Assembly.Program.pcAfter loopPre)
      ?_ ?_
  · exact ARunResultWithOracle.mono
      (by
        simpa [Structured.Preservation.ForLoop.coreCode,
          Structured.Preservation.ForLoop.afterLoopLabel, loopPre,
          List.append_assoc] using hLoopLabelRun)
      (by
        intro result traceMid hResult
        rcases hResult with ⟨hTraceMid, hResult⟩
        cases result with
        | halted halt =>
            exact hResult
        | running targetAtCond =>
            exact ⟨hTraceMid, by simpa [loopPre] using hResult⟩)
  · intro targetAtCond traceAtCond hAtCond
    rcases hAtCond with ⟨hTraceAtCond, hRelAtCond, hPcAtCond⟩
    subst traceAtCond
    have hBodyLabel :
        Assembly.Program.labelPc
            (loopPre ++ cond.toAssembly ++ [Assembly.Instr.jumpi bodyLabel] ++
              ([Assembly.Instr.jump endLabel,
                Assembly.Instr.label bodyLabel] ++ bodyCode ++
                [Assembly.Instr.label postLabel] ++ postCode ++
                [Assembly.Instr.jump loopLabel,
                  Assembly.Instr.label endLabel] ++ suffix))
            bodyLabel =
          some (Assembly.Program.byteLength bodyLabelPre) := by
      simpa [Structured.Preservation.ForLoop.coreCode,
        Structured.Preservation.ForLoop.afterLoopLabel,
        Structured.Preservation.ForLoop.afterCondJumpi,
        Structured.Preservation.ForLoop.bodyLabelPre, loopPre,
        bodyLabelPre, List.append_assoc] using hLayout.bodyLabelPc
    have hCondJump :=
      Frame.StateRel.runConditionWithOracle_jumpi_result_ctx
        (code := cond) (label := bodyLabel)
        (dest := Assembly.Program.byteLength bodyLabelPre)
        (pre := loopPre)
        (post :=
          [Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
            bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
            [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel] ++
            suffix)
        hCondRelSafe hCondFrame hLayout.fitCond hPcAtCond hRelAtCond
        hBodyLabel
        (by
          simpa [Structured.Preservation.ForLoop.coreCode,
            Structured.Preservation.ForLoop.afterLoopLabel, loopPre,
            List.append_assoc] using hCond)
    have hCondTrue :
        ARunResultWithOracle
          (pre ++
            Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
              loopLabel bodyLabel postLabel endLabel ++ suffix)
          targetAtCond trace
          (fun result traceMid =>
            match result with
            | .running targetAfterCond =>
                traceMid = traceAfterCond ∧
                  Structured.Preservation.Frame.StateRel stateAfterCond
                    targetAfterCond tokens ∧
                  targetAfterCond.pc = Assembly.Program.pcAfter bodyLabelPre
            | .halted _ => False) := by
      exact ARunResultWithOracle.mono
        (by
          simpa [Structured.Preservation.ForLoop.coreCode,
            Structured.Preservation.ForLoop.afterLoopLabel,
            Structured.Preservation.ForLoop.afterCondJumpi, loopPre,
            bodyLabelPre, List.append_assoc] using hCondJump)
        (by
          intro result traceMid hResult
          rcases hResult with ⟨hTraceMid, hResult⟩
          cases result with
          | halted halt =>
              exact hResult
          | running targetAfterCond =>
              exact ⟨hTraceMid, by simpa [bodyLabelPre] using hResult⟩)
    refine ARunResultWithOracle.bind_running hCondTrue ?_
    intro targetAfterCond traceMid hAfterCond
    rcases hAfterCond with ⟨hTraceMid, hRelAfterCond, hPcAfterCond⟩
    subst traceMid
    have hBodyLabelRun :=
      Frame.StateRel.label_runResultWithOracle_at
        (label := bodyLabel) (pre := bodyLabelPre)
        (post :=
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
            [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel] ++
            suffix)
        (source := stateAfterCond) (target := targetAfterCond)
        (tokens := tokens) (trace := traceAfterCond)
        hLayout.fitBodyLabel hPcAfterCond hRelAfterCond
    exact ARunResultWithOracle.mono
      (by
        simpa [Structured.Preservation.ForLoop.coreCode,
          Structured.Preservation.ForLoop.afterLoopLabel,
          Structured.Preservation.ForLoop.afterCondJumpi,
          Structured.Preservation.ForLoop.bodyLabelPre,
          Structured.Preservation.ForLoop.bodyPre, loopPre, bodyLabelPre,
          bodyPre, List.append_assoc] using hBodyLabelRun)
      (by
        intro result traceFinal hResult
        rcases hResult with ⟨hTraceFinal, hResult⟩
        exact
          ⟨hTraceFinal,
            by
              cases result with
              | halted halt =>
                  exact hResult
              | running targetAtBody =>
                  simpa [Structured.Preservation.ForLoop.bodyPre,
                    Structured.Preservation.ForLoop.bodyLabelPre,
                    Structured.Preservation.ForLoop.afterCondJumpi,
                    Structured.Preservation.ForLoop.afterLoopLabel,
                    bodyPre, bodyLabelPre, loopPre, List.append_assoc] using hResult⟩)

theorem body_brk_case {program : Structured.Program}
    {ctx : Structured.CompileContext}
    {pre suffix postCode : Assembly.Program}
    {cond : Structured.Code} {body : Structured.Block}
    {bodySupply : Structured.LabelSupply}
    {loopLabel bodyLabel postLabel endLabel : Assembly.Label}
    {fuel : Nat}
    {source stateAfterCond bodyState : Structured.RunState}
    {target : EVMState} {tokens : List Word}
    {trace traceAfterCond traceAfterBody : Trace} {replayPc : Nat}
    (hCondRelSafe : Code.OracleRelSafe cond)
    (hCondFrame : Code.OracleFrameSafe cond)
    (hBody :
      BlockPreservesWithOracle program
        { ctx with
          breakLabel? := some endLabel
          continueLabel? := some postLabel }
        bodySupply body)
    (hLayout :
      Structured.Preservation.ForLoop.Layout pre suffix cond
        (Structured.Block.compileFromCtx body
          { ctx with
            breakLabel? := some endLabel
            continueLabel? := some postLabel }
          bodySupply).code
        postCode loopLabel bodyLabel postLabel endLabel)
    (hResolve :
      Structured.Preservation.ContextLabelsResolve
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            postCode loopLabel bodyLabel postLabel endLabel ++ suffix)
        ctx)
    (hExact :
      Structured.Preservation.ExactLabels
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            postCode loopLabel bodyLabel postLabel endLabel ++ suffix))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hCond :
      Code.runConditionWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            postCode loopLabel bodyLabel postLabel endLabel ++ suffix)
        (Assembly.Program.byteLength
          (Structured.Preservation.ForLoop.afterLoopLabel pre loopLabel))
        cond source trace =
          .ok (stateAfterCond, true, traceAfterCond))
    (hBodyRun :
      Block.runWithOracle
        (pre ++
          Structured.Preservation.ForLoop.coreCode cond
            (Structured.Block.compileFromCtx body
              { ctx with
                breakLabel? := some endLabel
                continueLabel? := some postLabel }
              bodySupply).code
            postCode loopLabel bodyLabel postLabel endLabel ++ suffix)
        replayPc program fuel body stateAfterCond traceAfterCond =
          .ok (Structured.Outcome.brk bodyState, traceAfterBody)) :
    ARunResultWithOracle
      (pre ++
        Structured.Preservation.ForLoop.coreCode cond
          (Structured.Block.compileFromCtx body
            { ctx with
              breakLabel? := some endLabel
              continueLabel? := some postLabel }
            bodySupply).code
          postCode loopLabel bodyLabel postLabel endLabel ++ suffix)
      target trace
      (fun result traceFinal =>
        traceFinal = traceAfterBody ∧
          Structured.Preservation.CompiledOutcomeRel
            (pre ++
              Structured.Preservation.ForLoop.coreCode cond
                (Structured.Block.compileFromCtx body
                  { ctx with
                    breakLabel? := some endLabel
                    continueLabel? := some postLabel }
                  bodySupply).code
                postCode loopLabel bodyLabel postLabel endLabel ++ suffix)
            ctx
            (Assembly.Program.pcAfter
              (pre ++
                Structured.Preservation.ForLoop.coreCode cond
                  (Structured.Block.compileFromCtx body
                    { ctx with
                      breakLabel? := some endLabel
                      continueLabel? := some postLabel }
                    bodySupply).code
                  postCode loopLabel bodyLabel postLabel endLabel))
            (Structured.Outcome.regular bodyState) result tokens) := by
  let bodyCtx : Structured.CompileContext :=
    { ctx with
      breakLabel? := some endLabel
      continueLabel? := some postLabel }
  let bodyCode := (Structured.Block.compileFromCtx body bodyCtx bodySupply).code
  let bodyPre :=
    Structured.Preservation.ForLoop.bodyPre pre cond loopLabel bodyLabel endLabel
  let endLabelPre :=
    Structured.Preservation.ForLoop.endLabelPre pre cond bodyCode postCode
      loopLabel bodyLabel postLabel endLabel
  have hEnter :=
    enter_body
      (pre := pre) (suffix := suffix) (bodyCode := bodyCode)
      (postCode := postCode) (cond := cond) (loopLabel := loopLabel)
      (bodyLabel := bodyLabel) (postLabel := postLabel)
      (endLabel := endLabel) (source := source)
      (stateAfterCond := stateAfterCond) (target := target)
      (tokens := tokens) (trace := trace)
      (traceAfterCond := traceAfterCond)
      hCondRelSafe hCondFrame
      (by simpa [bodyCtx, bodyCode] using hLayout)
      hPc hRel
      (by simpa [bodyCtx, bodyCode] using hCond)
  refine
    ARunResultWithOracle.bind_running
      (program :=
        pre ++
          Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
            loopLabel bodyLabel postLabel endLabel ++ suffix)
      (middle := fun targetAtBody traceMid =>
        traceMid = traceAfterCond ∧
          Structured.Preservation.Frame.StateRel stateAfterCond
            targetAtBody tokens ∧
          targetAtBody.pc = Assembly.Program.pcAfter bodyPre)
      ?_ ?_
  · exact ARunResultWithOracle.mono
      (by simpa [bodyCtx, bodyCode, bodyPre] using hEnter)
      (by
        intro result traceMid hResult
        rcases hResult with ⟨hTraceMid, hResult⟩
        cases result with
        | halted halt =>
            exact hResult
        | running targetAtBody =>
            exact ⟨hTraceMid, hResult⟩)
  · intro targetAtBody traceMid hAtBody
    rcases hAtBody with ⟨hTraceMid, hRelAtBody, hPcAtBody⟩
    subst traceMid
    have hBodyCtxResolve :
        Structured.Preservation.ContextLabelsResolve
          (pre ++
            Structured.Preservation.ForLoop.coreCode cond bodyCode postCode
              loopLabel bodyLabel postLabel endLabel ++ suffix)
          bodyCtx :=
      Structured.Preservation.ContextLabelsResolve.with_break_continue
        (ctx := ctx)
        (breakLabel := endLabel) (continueLabel := postLabel)
        (by simpa [bodyCtx, bodyCode] using hResolve)
        ⟨Assembly.Program.byteLength endLabelPre, by
          simpa [bodyCtx, bodyCode, endLabelPre] using hLayout.endLabelPc⟩
        ⟨Assembly.Program.byteLength
            (Structured.Preservation.ForLoop.postLabelPre pre cond bodyCode
              loopLabel bodyLabel endLabel),
          by simpa [bodyCtx, bodyCode] using hLayout.postLabelPc⟩
    have hBodyResolve :
        Structured.Preservation.ContextLabelsResolve
          (bodyPre ++ bodyCode ++
            ([Assembly.Instr.label postLabel] ++ postCode ++
              [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel] ++
              suffix))
          bodyCtx := by
      simpa [bodyCtx, bodyCode, Structured.Preservation.ForLoop.coreCode,
        Structured.Preservation.ForLoop.afterLoopLabel,
        Structured.Preservation.ForLoop.afterCondJumpi,
        Structured.Preservation.ForLoop.bodyLabelPre,
        Structured.Preservation.ForLoop.bodyPre, bodyPre,
        List.append_assoc] using hBodyCtxResolve
    have hBodyExact :
