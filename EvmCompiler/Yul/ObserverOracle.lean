mutual
  theorem Block.runWithOracle_mono
      (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program) :
      ∀ {fuel fuel' : Nat} {block : Expressions.Block}
        {state : Expressions.RunState} {trace : Trace}
        {result : Expressions.Outcome × Trace},
        fuel ≤ fuel' →
        Block.runWithOracle asmProgram pc program fuel block state trace =
          .ok result →
        Block.runWithOracle asmProgram pc program fuel' block state trace =
          .ok result := by
    intro fuel fuel' block state trace result hLe hRun
    cases fuel with
    | zero =>
        cases block
        simp [Block.runWithOracle, Structured.invalid] at hRun
    | succ fuel =>
        cases fuel' with
        | zero =>
            omega
        | succ fuel' =>
            have hFuelLe : fuel ≤ fuel' := Nat.succ_le_succ_iff.mp hLe
            cases block with
            | mk stmts =>
                cases stmts with
                | nil =>
                    simpa [Block.runWithOracle] using hRun
                | cons stmt rest =>
                    cases hStmt :
                        Stmt.runWithOracle asmProgram pc program fuel stmt
                          state trace with
                    | error err =>
                        simp [Block.runWithOracle, hStmt] at hRun
                    | ok stmtResult =>
                        rcases stmtResult with
                          ⟨stmtOutcome, traceAfterStmt⟩
                        have hStmt' :
                            Stmt.runWithOracle asmProgram pc program fuel'
                                stmt state trace =
                              .ok (stmtOutcome, traceAfterStmt) :=
                          Stmt.runWithOracle_mono asmProgram pc program
                            hFuelLe hStmt
                        cases hMode : stmtOutcome.mode with
                        | regular =>
                            simp [Block.runWithOracle, hStmt, hStmt',
                              hMode] at hRun ⊢
                            exact
                              Block.runWithOracle_mono asmProgram pc program
                                hFuelLe hRun
                        | brk =>
                            simp [Block.runWithOracle, hStmt, hStmt',
                              hMode] at hRun ⊢
                            exact hRun
                        | cont =>
                            simp [Block.runWithOracle, hStmt, hStmt',
                              hMode] at hRun ⊢
                            exact hRun
                        | leave =>
                            simp [Block.runWithOracle, hStmt, hStmt',
                              hMode] at hRun ⊢
                            exact hRun
                        | halt kind =>
                            simp [Block.runWithOracle, hStmt, hStmt',
                              hMode] at hRun ⊢
                            exact hRun

