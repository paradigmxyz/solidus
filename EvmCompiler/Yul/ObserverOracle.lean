          outcome.state.trace) :=
    ExpressionsReplay.Block.runWithOracle_cons_regular_of_runs
      (asmProgram := asmProgram) (pc := pc)
      (fuel := (fuel + 1) + restSlack) (program := exprProgram)
      (stmt :=
        Expressions.Stmt.switch
          (Expressions.Expr.code (results := 1) scrutineeCode)
          lowerCases lowerDefault)
      (rest := restCode)
      (state := target) (stateAfterStmt := targetAfterBody)
      (trace := state.trace) (traceAfterStmt := stateAfterBody.trace)
      (result :=
        (Expressions.Outcome.regular targetOut, outcome.state.trace))
      hStmtReplaySlack hReplayRest
  refine ⟨targetOut, ?_, ?_, hReplayFull, hMode, hFinalRel,
    hFinalCtxRel⟩
  · simp [Locals.Block.compileOpen, hCompileStmt, hCompileRest]
  · simp [Block.runOpen, hStmtRun, hRestRun]

theorem compileOpen_singleton_ifTrueAtomicPrefixWithOracle_of_evalCondition_sourceOwned
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {exprProgram : Expressions.Program}
    {sourceCtx : Ctx} {targetCtx bodyCtx : Locals.Ctx}
    {fuel pc : Nat} {cond : Locals.Expr 1}
    {bodyStmts : List Locals.Stmt}
    {state stateAfterCond stateAfterBody : State}
    {target : Locals.RunState} {condCode : Structured.Code}
    {bodyCode : List Expressions.Stmt} {lowerBody : Expressions.Block}
    (hBodyPrefix : AtomicPrefix sourceCtx bodyStmts)
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible sourceCtx.scope 0 cond)
    (hRel :
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompileCond :
      Locals.Expr.compileCode targetCtx 0 cond = some condCode)
    (hCompileBody :
      Locals.Block.compileOpen targetCtx { stmts := bodyStmts } =
        some (bodyCode, bodyCtx))
    (hFinishBody :
      Locals.finishScoped targetCtx bodyCtx bodyCode = some lowerBody)
    (hEvalCond :
      Expr.evalCondition cond state = .ok (stateAfterCond, true))
    (hBodyRun :
      Block.runScoped program sourceCtx { stmts := bodyStmts } fuel
          stateAfterCond =
        .ok (Outcome.regular stateAfterBody)) :
    ∃ targetAfterBody,
      Locals.Block.compileOpen targetCtx
          { stmts := [Locals.Stmt.if_ cond { stmts := bodyStmts }] } =
        some
          ([Expressions.Stmt.if_
            (Expressions.Expr.code (results := 1) condCode)
            lowerBody],
            targetCtx) ∧
      Block.runOpen program sourceCtx ((fuel + 1) + 1)
          { stmts := [Locals.Stmt.if_ cond { stmts := bodyStmts }] }
          state =
        .ok (Outcome.regular stateAfterBody, sourceCtx) ∧
      ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
          (((fuel + 1) + 1) + 1)
          { stmts :=
              [Expressions.Stmt.if_
                (Expressions.Expr.code (results := 1) condCode)
                lowerBody] }
          target state.trace =
        .ok (Expressions.Outcome.regular targetAfterBody,
          stateAfterBody.trace) ∧
      Locals.SourceLowering.StateRel sourceCtx.scope
        stateAfterBody.source targetAfterBody ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  have hCompileRest :
      Locals.Block.compileOpen targetCtx { stmts := [] } =
        some ([], targetCtx) := by
    simp [Locals.Block.compileOpen]
  have hRestRun :
      Block.runOpen program sourceCtx (fuel + 1) { stmts := [] }
          stateAfterBody =
        .ok (Outcome.regular stateAfterBody, sourceCtx) := by
    simp [Block.runOpen]
  have hRestReplay :
      ∀ targetAfterBody,
        Locals.SourceLowering.StateRel sourceCtx.scope
          stateAfterBody.source targetAfterBody →
        ∃ targetOut,
          ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
              ((fuel + 1) + 1) { stmts := [] } targetAfterBody
              stateAfterBody.trace =
            .ok (Expressions.Outcome.regular targetOut,
              stateAfterBody.trace) ∧
          (Outcome.regular stateAfterBody).mode = .regular ∧
          Locals.SourceLowering.StateRel sourceCtx.scope
            stateAfterBody.source targetOut ∧
          Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
    intro targetAfterBody hTargetRel
    refine ⟨targetAfterBody, ?_, rfl, hTargetRel, hCtx⟩
    exact
      ExpressionsReplay.Block.runWithOracle_nil asmProgram pc exprProgram
        (fuel + 1) targetAfterBody stateAfterBody.trace
  rcases
      compileOpen_cons_ifTrueAtomicPrefixWithOracle_of_evalCondition_sourceOwned
        (asmProgram := asmProgram) (program := program)
        (exprProgram := exprProgram)
        (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtx)
        (targetCtx := targetCtx) (bodyCtx := bodyCtx)
        (targetCtxOut := targetCtx) (fuel := fuel) (pc := pc)
        (cond := cond) (bodyStmts := bodyStmts) (rest := [])
        (state := state) (stateAfterCond := stateAfterCond)
        (stateAfterBody := stateAfterBody) (target := target)
        (condCode := condCode) (bodyCode := bodyCode)
        (lowerBody := lowerBody) (restCode := [])
        (outcome := Outcome.regular stateAfterBody)
        hBodyPrefix hCtx hNoDup hOwned hAccess hRel hCompileCond
        hCompileBody hFinishBody hCompileRest hEvalCond hBodyRun hRestRun
        hRestReplay with
    ⟨targetAfterBody, hCompileOpen, hRunOpen, hReplay, _hMode,
      hFinalRel, hFinalCtx⟩
  refine ⟨targetAfterBody, ?_, ?_, ?_, hFinalRel, hFinalCtx⟩
  · simpa using hCompileOpen
  · simpa using hRunOpen
  · simpa using hReplay

def AtomicSwitchCases
    (ctx : Ctx) (cases : List (Word × Locals.Block)) : Prop :=
  ∀ value body, (value, body) ∈ cases → AtomicPrefix ctx body.stmts

def AtomicSwitchDefault
    (ctx : Ctx) (defaultBody : Option Locals.Block) : Prop :=
  ∀ body, defaultBody = some body → AtomicPrefix ctx body.stmts

theorem atomicPrefix_of_switch_select
    {ctx : Ctx} {scrutinee : Word}
    {cases : List (Word × Locals.Block)}
    {defaultBody : Option Locals.Block} {selected : Locals.Block}
    (hCases : AtomicSwitchCases ctx cases)
    (hDefault : AtomicSwitchDefault ctx defaultBody)
    (hSelect :
      Locals.Source.Switch.select scrutinee cases defaultBody =
        some selected) :
    AtomicPrefix ctx selected.stmts := by
  induction cases with
  | nil =>
      simp [Locals.Source.Switch.select] at hSelect
      exact hDefault selected hSelect
  | cons head rest ih =>
      rcases head with ⟨caseValue, caseBlock⟩
      by_cases hMatch : caseValue = scrutinee
      · simp [Locals.Source.Switch.select, hMatch] at hSelect
        cases hSelect
        exact hCases caseValue selected (by simp)
      · simp [Locals.Source.Switch.select, hMatch] at hSelect
        exact ih
          (by
            intro restValue restBody hMem
            exact hCases restValue restBody (by simp [hMem]))
          hSelect

inductive AtomicIfPrefix : Ctx → List Locals.Stmt → Prop where
  | nil (ctx : Ctx) :
      AtomicIfPrefix ctx []
  | expr (ctx : Ctx) {expr : Locals.Expr 0} {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hRest : AtomicIfPrefix ctx rest) :
      AtomicIfPrefix ctx (Locals.Stmt.expr expr :: rest)
  | let_ (ctx : Ctx) {name : Name} {expr : Locals.Expr 1}
      {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hFresh : name ∉ ctx.scope)
      (hRest :
        AtomicIfPrefix { ctx with scope := name :: ctx.scope } rest) :
      AtomicIfPrefix ctx (Locals.Stmt.let_ name expr :: rest)
  | assign (ctx : Ctx) {name : Name} {idx : Nat}
      {expr : Locals.Expr 1} {rest : List Locals.Stmt}
      (hName : ctx.scope[idx]? = some name)
      (hBound : idx + 1 ≤ 16)
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hRest : AtomicIfPrefix ctx rest) :
      AtomicIfPrefix ctx (Locals.Stmt.assign name expr :: rest)
  | branch (ctx : Ctx) {cond : Locals.Expr 1}
      {bodyStmts rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned cond)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 cond)
      (hBody : AtomicPrefix ctx bodyStmts)
      (hRest : AtomicIfPrefix ctx rest) :
      AtomicIfPrefix ctx
        (Locals.Stmt.if_ cond { stmts := bodyStmts } :: rest)

inductive AtomicSwitchPrefix : Ctx → List Locals.Stmt → Prop where
  | nil (ctx : Ctx) :
      AtomicSwitchPrefix ctx []
  | expr (ctx : Ctx) {expr : Locals.Expr 0} {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hRest : AtomicSwitchPrefix ctx rest) :
      AtomicSwitchPrefix ctx (Locals.Stmt.expr expr :: rest)
  | let_ (ctx : Ctx) {name : Name} {expr : Locals.Expr 1}
      {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hFresh : name ∉ ctx.scope)
      (hRest :
        AtomicSwitchPrefix { ctx with scope := name :: ctx.scope } rest) :
      AtomicSwitchPrefix ctx (Locals.Stmt.let_ name expr :: rest)
  | assign (ctx : Ctx) {name : Name} {idx : Nat}
      {expr : Locals.Expr 1} {rest : List Locals.Stmt}
      (hName : ctx.scope[idx]? = some name)
      (hBound : idx + 1 ≤ 16)
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hRest : AtomicSwitchPrefix ctx rest) :
      AtomicSwitchPrefix ctx (Locals.Stmt.assign name expr :: rest)
  | branch (ctx : Ctx) {cond : Locals.Expr 1}
      {bodyStmts rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned cond)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 cond)
      (hBody : AtomicPrefix ctx bodyStmts)
      (hRest : AtomicSwitchPrefix ctx rest) :
      AtomicSwitchPrefix ctx
        (Locals.Stmt.if_ cond { stmts := bodyStmts } :: rest)
  | switch (ctx : Ctx) {scrutinee : Locals.Expr 1}
      {cases : List (Word × Locals.Block)}
      {defaultBody : Option Locals.Block}
      {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned scrutinee)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 scrutinee)
      (hCases : AtomicSwitchCases ctx cases)
      (hDefault : AtomicSwitchDefault ctx defaultBody)
      (hRest : AtomicSwitchPrefix ctx rest) :
      AtomicSwitchPrefix ctx
        (Locals.Stmt.switch scrutinee cases defaultBody :: rest)

inductive AtomicSwitchForPrefixSlack :
    Nat → Ctx → List Locals.Stmt → Prop where
  | nil (ctx : Ctx) :
      AtomicSwitchForPrefixSlack 1 ctx []
  | expr (ctx : Ctx) {slack : Nat}
      {expr : Locals.Expr 0} {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hRest : AtomicSwitchForPrefixSlack slack ctx rest) :
      AtomicSwitchForPrefixSlack slack ctx (Locals.Stmt.expr expr :: rest)
  | let_ (ctx : Ctx) {slack : Nat}
      {name : Name} {expr : Locals.Expr 1}
      {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hFresh : name ∉ ctx.scope)
      (hRest :
        AtomicSwitchForPrefixSlack slack
          { ctx with scope := name :: ctx.scope } rest) :
      AtomicSwitchForPrefixSlack slack ctx
        (Locals.Stmt.let_ name expr :: rest)
  | assign (ctx : Ctx) {slack : Nat}
      {name : Name} {idx : Nat}
      {expr : Locals.Expr 1} {rest : List Locals.Stmt}
      (hName : ctx.scope[idx]? = some name)
      (hBound : idx + 1 ≤ 16)
      (hOwned : Locals.Source.Expr.SourceOwned expr)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 expr)
      (hRest : AtomicSwitchForPrefixSlack slack ctx rest) :
      AtomicSwitchForPrefixSlack slack ctx
        (Locals.Stmt.assign name expr :: rest)
  | branch (ctx : Ctx) {slack : Nat}
      {cond : Locals.Expr 1}
      {bodyStmts rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned cond)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 cond)
      (hBody : AtomicPrefix ctx bodyStmts)
      (hRest : AtomicSwitchForPrefixSlack slack ctx rest) :
      AtomicSwitchForPrefixSlack slack ctx
        (Locals.Stmt.if_ cond { stmts := bodyStmts } :: rest)
  | switch (ctx : Ctx) {slack : Nat}
      {scrutinee : Locals.Expr 1}
      {cases : List (Word × Locals.Block)}
      {defaultBody : Option Locals.Block}
      {rest : List Locals.Stmt}
      (hOwned : Locals.Source.Expr.SourceOwned scrutinee)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible ctx.scope 0 scrutinee)
      (hCases : AtomicSwitchCases ctx cases)
      (hDefault : AtomicSwitchDefault ctx defaultBody)
      (hRest : AtomicSwitchForPrefixSlack slack ctx rest) :
      AtomicSwitchForPrefixSlack slack ctx
        (Locals.Stmt.switch scrutinee cases defaultBody :: rest)
  | for_ (ctx : Ctx) {restSlack : Nat}
      {init post body : Locals.Block} {cond : Locals.Expr 1}
      {rest : List Locals.Stmt}
      (hInitPrefix :
        AtomicSwitchPrefix ctx.withoutLoopControl init.stmts)
      (hLoopNoDup :
        (Locals.Scope.Block.outEnv ctx.scope init).Nodup)
      (hOwned : Locals.Source.Expr.SourceOwned cond)
      (hAccess :
        Locals.SourceLowering.Expr.Accessible
          (Locals.Scope.Block.outEnv ctx.scope init) 0 cond)
      (hPostPrefix :
        ∀ (loopCtx : Ctx),
          loopCtx.scope = Locals.Scope.Block.outEnv ctx.scope init →
            AtomicSwitchPrefix loopCtx.withoutLoopControl post.stmts)
      (hBodyPrefix :
        ∀ (loopCtx : Ctx),
          loopCtx.scope = Locals.Scope.Block.outEnv ctx.scope init →
            AtomicSwitchPrefix
              (loopCtx.withLoopControl loopCtx.scope loopCtx.scope)
              body.stmts)
      (hRest : AtomicSwitchForPrefixSlack restSlack ctx rest) :
      AtomicSwitchForPrefixSlack (restSlack + 1) ctx
        (Locals.Stmt.for_ init cond post body :: rest)

theorem atomicSwitchForPrefixSlack_pos
    {slack : Nat} {ctx : Ctx} {stmts : List Locals.Stmt}
    (hPrefix : AtomicSwitchForPrefixSlack slack ctx stmts) :
    1 ≤ slack := by
  induction hPrefix
  case nil =>
    omega
  case expr ih =>
    exact ih
  case let_ ih =>
    exact ih
  case assign ih =>
    exact ih
  case branch ih =>
    exact ih
  case switch ih =>
    exact ih
  case for_ ih =>
    omega

theorem runOpen_atomicSwitchPrefix_mode_regular
    {program : Locals.Program} :
    ∀ {sourceCtx : Ctx} {fuel : Nat} {stmts : List Locals.Stmt}
      {state : State} {outcome : Outcome} {sourceCtxOut : Ctx},
      AtomicSwitchPrefix sourceCtx stmts →
      Block.runOpen program sourceCtx fuel { stmts := stmts } state =
        .ok (outcome, sourceCtxOut) →
      outcome.mode = .regular := by
  intro sourceCtx fuel stmts state outcome sourceCtxOut hPrefix hRun
  induction hPrefix generalizing fuel state outcome sourceCtxOut
  case nil sourceCtx =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Block.runOpen] at hRun
          rcases hRun with ⟨hOutcome, _hCtxOut⟩
          cases hOutcome
          rfl
  case expr sourceCtx expr rest hOwned hAccess hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Block.runOpen] at hRun
          cases hEval : Expr.eval expr state with
          | error err =>
              simp [Stmt.run, hEval] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterExpr, values⟩
              simp [Stmt.run, hEval] at hRun
              cases hRestRun :
                  Block.runOpen program sourceCtx fuel { stmts := rest }
                    stateAfterExpr with
              | error err =>
                  rw [hRestRun] at hRun
                  simp at hRun
              | ok restRunResult =>
                  rcases restRunResult with
                    ⟨restOutcome, restSourceCtxOut⟩
                  rw [hRestRun] at hRun
                  simp at hRun
                  rcases hRun with ⟨hOutcome, _hCtxOut⟩
                  cases hOutcome
                  exact ih hRestRun
  case let_ sourceCtx name expr rest hOwned hAccess hFresh hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          let sourceCtxAfter : Ctx :=
            { sourceCtx with scope := name :: sourceCtx.scope }
          simp [Block.runOpen] at hRun
          cases hEvalOne : Expr.evalOne expr state with
          | error err =>
              simp [Stmt.run, hEvalOne] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterValue, value⟩
              simp [Stmt.run, hEvalOne, sourceCtxAfter] at hRun
              cases hRestRun :
                  Block.runOpen program sourceCtxAfter fuel
                    { stmts := rest } (stateAfterValue.insert name value) with
              | error err =>
                  rw [hRestRun] at hRun
                  simp at hRun
              | ok restRunResult =>
                  rcases restRunResult with
                    ⟨restOutcome, restSourceCtxOut⟩
                  rw [hRestRun] at hRun
                  simp at hRun
                  rcases hRun with ⟨hOutcome, _hCtxOut⟩
                  cases hOutcome
                  exact ih hRestRun
  case assign sourceCtx name idx expr rest hName hBound hOwned hAccess hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Block.runOpen] at hRun
          by_cases hContains :
              Locals.Source.Store.contains state.vars name = true
          · simp [Stmt.run, hContains] at hRun
            cases hEvalOne : Expr.evalOne expr state with
            | error err =>
                simp [hEvalOne] at hRun
            | ok evalResult =>
                rcases evalResult with ⟨stateAfterValue, value⟩
                simp [hEvalOne] at hRun
                let stateAfterAssign :=
                  stateAfterValue.withVars
                    (Locals.Source.Store.insert stateAfterValue.vars name value)
                cases hRestRun :
                    Block.runOpen program sourceCtx fuel { stmts := rest }
                      stateAfterAssign with
                | error err =>
                    rw [hRestRun] at hRun
                    simp [stateAfterAssign] at hRun
                | ok restRunResult =>
                    rcases restRunResult with
                      ⟨restOutcome, restSourceCtxOut⟩
                    rw [hRestRun] at hRun
                    simp [stateAfterAssign] at hRun
                    rcases hRun with ⟨hOutcome, _hCtxOut⟩
                    cases hOutcome
                    exact ih hRestRun
          · have hContainsFalse :
                Locals.Source.Store.contains state.vars name = false := by
              cases hValue :
                  Locals.Source.Store.contains state.vars name <;>
                simp [hValue] at hContains ⊢
            simp [Stmt.run, hContainsFalse, invalid, Structured.invalid]
              at hRun
  case branch sourceCtx cond bodyStmts rest hOwned hAccess hBody hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ stmtFuel =>
          cases stmtFuel with
          | zero =>
              simp [Block.runOpen, Stmt.run, invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              simp [Block.runOpen] at hRun
              cases hEvalCond : Expr.evalCondition cond state with
              | error err =>
                  simp [Stmt.run, hEvalCond] at hRun
              | ok condResult =>
                  rcases condResult with ⟨stateAfterCond, condTrue⟩
                  cases condTrue
                  · simp [Stmt.run, hEvalCond] at hRun
                    cases hRestRun :
                        Block.runOpen program sourceCtx (fuel + 1)
                          { stmts := rest } stateAfterCond with
                    | error err =>
                        rw [hRestRun] at hRun
                        simp at hRun
                    | ok restRunResult =>
                        rcases restRunResult with
                          ⟨restOutcome, restSourceCtxOut⟩
                        rw [hRestRun] at hRun
                        simp at hRun
                        rcases hRun with ⟨hOutcome, _hCtxOut⟩
                        cases hOutcome
                        exact ih hRestRun
                  · simp [Stmt.run, hEvalCond] at hRun
                    cases hBodyRun :
                        Block.runScoped program sourceCtx
                          { stmts := bodyStmts } fuel stateAfterCond with
                    | error err =>
                        rw [hBodyRun] at hRun
                        simp at hRun
                    | ok bodyOutcome =>
                        rcases bodyOutcome with ⟨stateAfterBody, bodyMode⟩
                        have hBodyMode : bodyMode = .regular := by
                          have hMode :=
                            runScoped_atomicPrefix_mode_regular hBody hBodyRun
                          simpa using hMode
                        cases hBodyMode
                        simp [Outcome.regular, hBodyRun] at hRun
                        cases hRestRun :
                            Block.runOpen program sourceCtx (fuel + 1)
                              { stmts := rest } stateAfterBody with
                        | error err =>
                            rw [hRestRun] at hRun
                            simp [Outcome.regular] at hRun
                        | ok restRunResult =>
                            rcases restRunResult with
                              ⟨restOutcome, restSourceCtxOut⟩
                            rw [hRestRun] at hRun
                            simp [Outcome.regular] at hRun
                            rcases hRun with ⟨hOutcome, _hCtxOut⟩
                            cases hOutcome
                            exact ih hRestRun
  case switch sourceCtx scrutinee cases defaultBody rest hOwned hAccess
      hCases hDefault hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ stmtFuel =>
          cases stmtFuel with
          | zero =>
              simp [Block.runOpen, Stmt.run, invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              simp [Block.runOpen] at hRun
              cases hEvalOne : Expr.evalOne scrutinee state with
              | error err =>
                  simp [Stmt.run, hEvalOne] at hRun
              | ok evalResult =>
                  rcases evalResult with ⟨stateAfterScrutinee, value⟩
                  cases hSelect :
                      Locals.Source.Switch.select value cases defaultBody with
                  | none =>
                      simp [Stmt.run, hEvalOne, hSelect] at hRun
                      cases hRestRun :
                          Block.runOpen program sourceCtx (fuel + 1)
                            { stmts := rest } stateAfterScrutinee with
                      | error err =>
                          rw [hRestRun] at hRun
                          simp at hRun
                      | ok restRunResult =>
                          rcases restRunResult with
                            ⟨restOutcome, restSourceCtxOut⟩
                          rw [hRestRun] at hRun
                          simp at hRun
                          rcases hRun with ⟨hOutcome, _hCtxOut⟩
                          cases hOutcome
                          exact ih hRestRun
                  | some selected =>
                      rcases selected with ⟨bodyStmts⟩
                      simp [Stmt.run, hEvalOne, hSelect] at hRun
                      cases hBodyRun :
                          Block.runScoped program sourceCtx
                            { stmts := bodyStmts } fuel
                            stateAfterScrutinee with
                      | error err =>
                          rw [hBodyRun] at hRun
                          simp at hRun
                      | ok bodyOutcome =>
                          rcases bodyOutcome with
                            ⟨stateAfterBody, bodyMode⟩
                          have hBodyPrefix :
                              AtomicPrefix sourceCtx bodyStmts :=
                            atomicPrefix_of_switch_select hCases hDefault
                              hSelect
                          have hBodyMode : bodyMode = .regular := by
                            have hMode :=
                              runScoped_atomicPrefix_mode_regular
                                hBodyPrefix hBodyRun
                            simpa using hMode
                          cases hBodyMode
                          simp [Outcome.regular, hBodyRun] at hRun
                          cases hRestRun :
                              Block.runOpen program sourceCtx (fuel + 1)
                                { stmts := rest } stateAfterBody with
                          | error err =>
                              rw [hRestRun] at hRun
                              simp [Outcome.regular] at hRun
                          | ok restRunResult =>
                              rcases restRunResult with
                                ⟨restOutcome, restSourceCtxOut⟩
                              rw [hRestRun] at hRun
                              simp [Outcome.regular] at hRun
                              rcases hRun with ⟨hOutcome, _hCtxOut⟩
                              cases hOutcome
                              exact ih hRestRun

theorem runOpen_atomicSwitchPrefix_mode_regular_of_block
    {program : Locals.Program}
    {sourceCtx : Ctx} {fuel : Nat} {block : Locals.Block}
    {state : State} {outcome : Outcome} {sourceCtxOut : Ctx}
    (hPrefix : AtomicSwitchPrefix sourceCtx block.stmts)
    (hRun :
      Block.runOpen program sourceCtx fuel block state =
        .ok (outcome, sourceCtxOut)) :
    outcome.mode = .regular := by
  cases block with
  | mk stmts =>
      exact runOpen_atomicSwitchPrefix_mode_regular hPrefix hRun

theorem runScoped_atomicSwitchPrefix_mode_regular
    {program : Locals.Program}
    {sourceCtx : Ctx} {fuel : Nat} {stmts : List Locals.Stmt}
    {state : State} {outcome : Outcome}
    (hPrefix : AtomicSwitchPrefix sourceCtx stmts)
    (hRun :
      Block.runScoped program sourceCtx { stmts := stmts } fuel state =
        .ok outcome) :
    outcome.mode = .regular := by
  unfold Block.runScoped at hRun
  cases hOpen :
      Block.runOpen program sourceCtx fuel { stmts := stmts } state with
  | error err =>
      simp [hOpen] at hRun
  | ok openResult =>
      rcases openResult with ⟨openOutcome, sourceCtxOut⟩
      have hMode :=
        runOpen_atomicSwitchPrefix_mode_regular hPrefix hOpen
      cases openOutcome with
      | mk openState openMode =>
          cases hMode
          simp [hOpen, Outcome.regular] at hRun
          cases hRun
          rfl

theorem runScoped_atomicSwitchPrefix_mode_regular_of_block
    {program : Locals.Program}
    {sourceCtx : Ctx} {fuel : Nat} {block : Locals.Block}
    {state : State} {outcome : Outcome}
    (hPrefix : AtomicSwitchPrefix sourceCtx block.stmts)
    (hRun :
      Block.runScoped program sourceCtx block fuel state =
        .ok outcome) :
    outcome.mode = .regular := by
  cases block with
  | mk stmts =>
      exact runScoped_atomicSwitchPrefix_mode_regular hPrefix hRun

theorem runForLoop_atomicSwitchPrefix_mode_regular
    {program : Locals.Program} :
    ∀ {loopCtx postBase bodyBase : Ctx} {fuel : Nat}
      {cond : Locals.Expr 1} {post body : Locals.Block}
      {state : State} {outcome : Outcome},
      AtomicSwitchPrefix postBase post.stmts →
      AtomicSwitchPrefix bodyBase body.stmts →
      Stmt.runForLoop program loopCtx cond postBase post bodyBase body fuel
          state =
        .ok outcome →
      outcome.mode = .regular := by
  intro loopCtx postBase bodyBase fuel cond post body state outcome
    hPostPrefix hBodyPrefix hRun
  induction fuel generalizing state outcome with
  | zero =>
      simp [Stmt.runForLoop, invalid, Structured.invalid] at hRun
  | succ fuel ih =>
      cases hEvalCond : Expr.evalCondition cond state with
      | error err =>
          simp [Stmt.runForLoop, hEvalCond] at hRun
      | ok condResult =>
          rcases condResult with ⟨stateAfterCond, condTrue⟩
          cases condTrue
          · simp [Stmt.runForLoop, hEvalCond] at hRun
            cases hRun
            rfl
          · cases hBodyRun :
                Block.runScoped program bodyBase body fuel
                  stateAfterCond with
            | error err =>
                simp [Stmt.runForLoop, hEvalCond, hBodyRun] at hRun
            | ok bodyOutcome =>
                rcases bodyOutcome with ⟨stateAfterBody, bodyMode⟩
                have hBodyMode : bodyMode = .regular := by
                  have hMode :=
                    runScoped_atomicSwitchPrefix_mode_regular_of_block
                      hBodyPrefix hBodyRun
                  simpa using hMode
                cases hBodyMode
                cases hPostRun :
                    Block.runScoped program postBase post fuel
                      stateAfterBody with
                | error err =>
                    simp [Stmt.runForLoop, hEvalCond, hBodyRun, hPostRun,
                      Outcome.regular] at hRun
                | ok postOutcome =>
                    rcases postOutcome with ⟨stateAfterPost, postMode⟩
                    have hPostMode : postMode = .regular := by
                      have hMode :=
                        runScoped_atomicSwitchPrefix_mode_regular_of_block
                          hPostPrefix hPostRun
                      simpa using hMode
                    cases hPostMode
                    cases hLoopRun :
                        Stmt.runForLoop program loopCtx cond postBase post
                          bodyBase body fuel stateAfterPost with
                    | error err =>
                        simp [Stmt.runForLoop, hEvalCond, hBodyRun,
                          hPostRun, hLoopRun, Outcome.regular] at hRun
                    | ok loopOutcome =>
                        simp [Stmt.runForLoop, hEvalCond, hBodyRun,
                          hPostRun, hLoopRun, Outcome.regular] at hRun
                        cases hRun
                        exact ih hLoopRun

theorem runOpen_atomicSwitchForPrefixSlack_mode_regular
    {program : Locals.Program} :
    ∀ {slack : Nat} {sourceCtx : Ctx} {fuel : Nat}
      {stmts : List Locals.Stmt} {state : State}
      {outcome : Outcome} {sourceCtxOut : Ctx},
      AtomicSwitchForPrefixSlack slack sourceCtx stmts →
      Block.runOpen program sourceCtx fuel { stmts := stmts } state =
        .ok (outcome, sourceCtxOut) →
      outcome.mode = .regular := by
  intro slack sourceCtx fuel stmts state outcome sourceCtxOut hPrefix hRun
  induction hPrefix generalizing fuel state outcome sourceCtxOut
  case nil sourceCtx =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Block.runOpen] at hRun
          rcases hRun with ⟨hOutcome, _hCtxOut⟩
          cases hOutcome
          rfl
  case expr sourceCtx slack expr rest hOwned hAccess hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Block.runOpen] at hRun
          cases hEval : Expr.eval expr state with
          | error err =>
              simp [Stmt.run, hEval] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterExpr, values⟩
              simp [Stmt.run, hEval] at hRun
              cases hRestRun :
                  Block.runOpen program sourceCtx fuel { stmts := rest }
                    stateAfterExpr with
              | error err =>
                  rw [hRestRun] at hRun
                  simp at hRun
              | ok restRunResult =>
                  rcases restRunResult with
                    ⟨restOutcome, restSourceCtxOut⟩
                  rw [hRestRun] at hRun
                  simp at hRun
                  rcases hRun with ⟨hOutcome, _hCtxOut⟩
                  cases hOutcome
                  exact ih hRestRun
  case let_ sourceCtx slack name expr rest hOwned hAccess hFresh hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          let sourceCtxAfter : Ctx :=
            { sourceCtx with scope := name :: sourceCtx.scope }
          simp [Block.runOpen] at hRun
          cases hEvalOne : Expr.evalOne expr state with
          | error err =>
              simp [Stmt.run, hEvalOne] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterValue, value⟩
              simp [Stmt.run, hEvalOne, sourceCtxAfter] at hRun
              cases hRestRun :
                  Block.runOpen program sourceCtxAfter fuel
                    { stmts := rest } (stateAfterValue.insert name value) with
              | error err =>
                  rw [hRestRun] at hRun
                  simp at hRun
              | ok restRunResult =>
                  rcases restRunResult with
                    ⟨restOutcome, restSourceCtxOut⟩
                  rw [hRestRun] at hRun
                  simp at hRun
                  rcases hRun with ⟨hOutcome, _hCtxOut⟩
                  cases hOutcome
                  exact ih hRestRun
  case assign sourceCtx slack name idx expr rest hName hBound hOwned hAccess
      hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Block.runOpen] at hRun
          by_cases hContains :
              Locals.Source.Store.contains state.vars name = true
          · simp [Stmt.run, hContains] at hRun
            cases hEvalOne : Expr.evalOne expr state with
            | error err =>
                simp [hEvalOne] at hRun
            | ok evalResult =>
                rcases evalResult with ⟨stateAfterValue, value⟩
                simp [hEvalOne] at hRun
                let stateAfterAssign :=
                  stateAfterValue.withVars
                    (Locals.Source.Store.insert stateAfterValue.vars name value)
                cases hRestRun :
                    Block.runOpen program sourceCtx fuel { stmts := rest }
                      stateAfterAssign with
                | error err =>
                    rw [hRestRun] at hRun
                    simp [stateAfterAssign] at hRun
                | ok restRunResult =>
                    rcases restRunResult with
                      ⟨restOutcome, restSourceCtxOut⟩
                    rw [hRestRun] at hRun
                    simp [stateAfterAssign] at hRun
                    rcases hRun with ⟨hOutcome, _hCtxOut⟩
                    cases hOutcome
                    exact ih hRestRun
          · have hContainsFalse :
                Locals.Source.Store.contains state.vars name = false := by
              cases hValue :
                  Locals.Source.Store.contains state.vars name <;>
                simp [hValue] at hContains ⊢
            simp [Stmt.run, hContainsFalse, invalid, Structured.invalid]
              at hRun
  case branch sourceCtx slack cond bodyStmts rest hOwned hAccess hBody hRest
      ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ stmtFuel =>
          cases stmtFuel with
          | zero =>
              simp [Block.runOpen, Stmt.run, invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              simp [Block.runOpen] at hRun
              cases hEvalCond : Expr.evalCondition cond state with
              | error err =>
                  simp [Stmt.run, hEvalCond] at hRun
              | ok condResult =>
                  rcases condResult with ⟨stateAfterCond, condTrue⟩
                  cases condTrue
                  · simp [Stmt.run, hEvalCond] at hRun
                    cases hRestRun :
                        Block.runOpen program sourceCtx (fuel + 1)
                          { stmts := rest } stateAfterCond with
                    | error err =>
                        rw [hRestRun] at hRun
                        simp at hRun
                    | ok restRunResult =>
                        rcases restRunResult with
                          ⟨restOutcome, restSourceCtxOut⟩
                        rw [hRestRun] at hRun
                        simp at hRun
                        rcases hRun with ⟨hOutcome, _hCtxOut⟩
                        cases hOutcome
                        exact ih hRestRun
                  · simp [Stmt.run, hEvalCond] at hRun
                    cases hBodyRun :
                        Block.runScoped program sourceCtx
                          { stmts := bodyStmts } fuel stateAfterCond with
                    | error err =>
                        rw [hBodyRun] at hRun
                        simp at hRun
                    | ok bodyOutcome =>
                        rcases bodyOutcome with ⟨stateAfterBody, bodyMode⟩
                        have hBodyMode : bodyMode = .regular := by
                          have hMode :=
                            runScoped_atomicPrefix_mode_regular hBody hBodyRun
                          simpa using hMode
                        cases hBodyMode
                        simp [Outcome.regular, hBodyRun] at hRun
                        cases hRestRun :
                            Block.runOpen program sourceCtx (fuel + 1)
                              { stmts := rest } stateAfterBody with
                        | error err =>
                            rw [hRestRun] at hRun
                            simp [Outcome.regular] at hRun
                        | ok restRunResult =>
                            rcases restRunResult with
                              ⟨restOutcome, restSourceCtxOut⟩
                            rw [hRestRun] at hRun
                            simp [Outcome.regular] at hRun
                            rcases hRun with ⟨hOutcome, _hCtxOut⟩
                            cases hOutcome
                            exact ih hRestRun
  case switch sourceCtx slack scrutinee cases defaultBody rest hOwned hAccess
      hCases hDefault hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ stmtFuel =>
          cases stmtFuel with
          | zero =>
              simp [Block.runOpen, Stmt.run, invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              simp [Block.runOpen] at hRun
              cases hEvalOne : Expr.evalOne scrutinee state with
              | error err =>
                  simp [Stmt.run, hEvalOne] at hRun
              | ok evalResult =>
                  rcases evalResult with ⟨stateAfterScrutinee, value⟩
                  cases hSelect :
                      Locals.Source.Switch.select value cases defaultBody with
                  | none =>
                      simp [Stmt.run, hEvalOne, hSelect] at hRun
                      cases hRestRun :
                          Block.runOpen program sourceCtx (fuel + 1)
                            { stmts := rest } stateAfterScrutinee with
                      | error err =>
                          rw [hRestRun] at hRun
                          simp at hRun
                      | ok restRunResult =>
                          rcases restRunResult with
                            ⟨restOutcome, restSourceCtxOut⟩
                          rw [hRestRun] at hRun
                          simp at hRun
                          rcases hRun with ⟨hOutcome, _hCtxOut⟩
                          cases hOutcome
                          exact ih hRestRun
                  | some selected =>
                      rcases selected with ⟨bodyStmts⟩
                      simp [Stmt.run, hEvalOne, hSelect] at hRun
                      cases hBodyRun :
                          Block.runScoped program sourceCtx
                            { stmts := bodyStmts } fuel
                            stateAfterScrutinee with
                      | error err =>
                          rw [hBodyRun] at hRun
                          simp at hRun
                      | ok bodyOutcome =>
                          rcases bodyOutcome with
                            ⟨stateAfterBody, bodyMode⟩
                          have hBodyPrefix :
                              AtomicPrefix sourceCtx bodyStmts :=
                            atomicPrefix_of_switch_select hCases hDefault
                              hSelect
                          have hBodyMode : bodyMode = .regular := by
                            have hMode :=
                              runScoped_atomicPrefix_mode_regular
                                hBodyPrefix hBodyRun
                            simpa using hMode
                          cases hBodyMode
                          simp [Outcome.regular, hBodyRun] at hRun
                          cases hRestRun :
                              Block.runOpen program sourceCtx (fuel + 1)
                                { stmts := rest } stateAfterBody with
                          | error err =>
                              rw [hRestRun] at hRun
                              simp [Outcome.regular] at hRun
                          | ok restRunResult =>
                              rcases restRunResult with
                                ⟨restOutcome, restSourceCtxOut⟩
                              rw [hRestRun] at hRun
                              simp [Outcome.regular] at hRun
                              rcases hRun with ⟨hOutcome, _hCtxOut⟩
                              cases hOutcome
                              exact ih hRestRun
  case for_ sourceCtx restSlack init post body cond rest hInitPrefix
      hLoopNoDup hOwned hAccess hPostPrefix hBodyPrefix hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ stmtFuel =>
          cases stmtFuel with
          | zero =>
              simp [Block.runOpen, Stmt.run, invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              simp [Block.runOpen] at hRun
              cases hInitRun :
                  Block.runOpen program sourceCtx.withoutLoopControl fuel init
                    state with
              | error err =>
                  simp [Stmt.run, hInitRun] at hRun
              | ok initResult =>
                  rcases initResult with ⟨initOutcome, loopCtx⟩
                  cases initOutcome with
                  | mk stateAfterInit initMode =>
                      have hInitMode : initMode = .regular := by
                        have hMode :=
                          runOpen_atomicSwitchPrefix_mode_regular_of_block
                            hInitPrefix hInitRun
                        simpa using hMode
                      cases hInitMode
                      have hLoopScope :
                          loopCtx.scope =
                            Locals.Scope.Block.outEnv sourceCtx.scope init := by
                        have hScope :=
                          Block.runOpen_regular_scope
                            (program := program)
                            (ctx := sourceCtx.withoutLoopControl)
                            (ctx' := loopCtx) (fuel := fuel)
                            (block := init) (state := state)
                            (out := stateAfterInit)
                            (by simpa [Outcome.regular] using hInitRun)
                        simpa [Locals.Source.Ctx.withoutLoopControl]
                          using hScope
                      let postBase : Ctx := loopCtx.withoutLoopControl
                      let bodyBase : Ctx :=
                        loopCtx.withLoopControl loopCtx.scope loopCtx.scope
                      cases hLoopRun :
                          Stmt.runForLoop program loopCtx cond postBase post
                            bodyBase body fuel stateAfterInit with
                      | error err =>
                          simp [Stmt.run, hInitRun, hLoopRun, postBase,
                            bodyBase, Outcome.regular] at hRun
                      | ok loopOutcome =>
                          have hLoopMode : loopOutcome.mode = .regular :=
                            runForLoop_atomicSwitchPrefix_mode_regular
                              (hPostPrefix loopCtx hLoopScope)
                              (hBodyPrefix loopCtx hLoopScope)
                              (by
                                simpa [postBase, bodyBase] using hLoopRun)
                          cases loopOutcome with
                          | mk loopState loopMode =>
                              cases hLoopMode
                              let stateAfterLoop :=
                                loopState.restrictTo sourceCtx.scope
                              simp [Stmt.run, hInitRun, hLoopRun, postBase,
                                bodyBase, Outcome.regular, stateAfterLoop]
                                at hRun
                              cases hRestRun :
                                  Block.runOpen program sourceCtx (fuel + 1)
                                    { stmts := rest } stateAfterLoop with
                              | error err =>
                                  rw [hRestRun] at hRun
                                  simp at hRun
                              | ok restRunResult =>
                                  rcases restRunResult with
                                    ⟨restOutcome, restSourceCtxOut⟩
                                  rw [hRestRun] at hRun
                                  simp at hRun
                                  rcases hRun with ⟨hOutcome, _hCtxOut⟩
                                  cases hOutcome
                                  exact ih hRestRun

