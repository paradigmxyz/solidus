      Assembly.Compiled.runNResultWithOracle asm fuel initial trace =
        .ok (result, rest) ∧
      Assembly.Target.runNResultWithOracle target fuel initial trace =
        .ok (result, rest) := by
  rcases source_run_preserved_by_compile hCompile hSource with
    ⟨hAccepted, hTrace, hCompiled⟩
  exact ⟨hAccepted, hTrace, hCompiled, hTarget⟩

theorem block_trace_induces_target_run_exists_of_compile
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {fuel : Nat} {initial : EVMState} {trace rest : Trace}
    {result : Assembly.StepResult}
    (hCompile : Assembly.compile? asm = some target)
    {hTrace :
      Assembly.Preservation.BlockTraceResultWithOracle asm target fuel
        initial trace rest result}
    (hSafe :
      Assembly.Preservation.BlockTraceResultWithOracle.TargetPcSafe
        hTrace) :
    ∃ targetFuel,
      Assembly.Target.runNResultWithOracle target targetFuel initial trace =
        .ok (result, rest) :=
  Assembly.Preservation.BlockTraceResultWithOracle.target_runNResultWithOracle_exists
    (Assembly.Preservation.compile?_some_assemble hCompile) hSafe

theorem block_trace_induces_target_run_exists_of_compile_byteLength_lt
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {fuel : Nat} {initial : EVMState} {trace rest : Trace}
    {result : Assembly.StepResult}
    (hCompile : Assembly.compile? asm = some target)
    (hTrace :
      Assembly.Preservation.BlockTraceResultWithOracle asm target fuel
        initial trace rest result)
    (hLen : Assembly.Program.byteLength asm < EvmYul.UInt256.size) :
    ∃ targetFuel,
      Assembly.Target.runNResultWithOracle target targetFuel initial trace =
        .ok (result, rest) :=
  Assembly.Preservation.BlockTraceResultWithOracle.target_runNResultWithOracle_exists_of_byteLength_lt
    (Assembly.Preservation.compile?_some_assemble hCompile) hTrace hLen

theorem source_run_induces_target_run_exists_of_compile_byteLength_lt
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {fuel : Nat} {initial : EVMState} {trace rest : Trace}
    {result : Assembly.StepResult}
    (hCompile : Assembly.compile? asm = some target)
    (hSource :
      Assembly.Source.runNResultWithOracle asm fuel initial trace =
        .ok (result, rest))
    (hLen : Assembly.Program.byteLength asm < EvmYul.UInt256.size) :
    Assembly.Accepted asm ∧
      Assembly.Preservation.BlockTraceResultWithOracle asm target fuel
        initial trace rest result ∧
      Assembly.Compiled.runNResultWithOracle asm fuel initial trace =
        .ok (result, rest) ∧
      ∃ targetFuel,
        Assembly.Target.runNResultWithOracle target targetFuel initial trace =
          .ok (result, rest) := by
  rcases source_run_preserved_by_compile hCompile hSource with
    ⟨hAccepted, hTrace, hCompiled⟩
  exact
    ⟨hAccepted, hTrace, hCompiled,
      block_trace_induces_target_run_exists_of_compile_byteLength_lt
        hCompile hTrace hLen⟩

end AssemblyOracle

structure TargetDryRun where
  target : Assembly.TargetProgram
  fuel : Nat
  initial : EVMState
  result : Assembly.StepResult
  trace : Trace
  run :
    Assembly.Target.runNResultWithObservers target fuel initial =
      .ok (result, trace)

namespace TargetDryRun

theorem ordinary_run (dryRun : TargetDryRun) :
    Assembly.Target.runNResult dryRun.target dryRun.fuel dryRun.initial =
      .ok dryRun.result :=
  Assembly.Target.runNResultWithObservers_sound dryRun.run

theorem oracle_run (dryRun : TargetDryRun) (rest : Trace) :
    Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
        dryRun.initial (dryRun.trace ++ rest) =
      .ok (dryRun.result, rest) :=
  Assembly.Target.runNResultWithOracle_of_withObservers dryRun.run

theorem oracle_run_empty (dryRun : TargetDryRun) :
    Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
        dryRun.initial dryRun.trace =
      .ok (dryRun.result, []) := by
  simpa using oracle_run dryRun []

theorem result_eq_of_targetOracle_run
    (dryRun : TargetDryRun) {rest rest' : Trace}
    {result : Assembly.StepResult}
    (hTarget :
      Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
          dryRun.initial (dryRun.trace ++ rest) =
        .ok (result, rest')) :
    result = dryRun.result ∧ rest' = rest :=
  AssemblyOracle.target_run_result_unique hTarget (oracle_run dryRun rest)

theorem result_eq_of_halted_targetOracle_run_le
    (dryRun : TargetDryRun) {targetFuel : Nat}
    {rest rest' : Trace} {halt : Assembly.Halt}
    (hTarget :
      Assembly.Target.runNResultWithOracle dryRun.target targetFuel
          dryRun.initial (dryRun.trace ++ rest) =
        .ok (.halted halt, rest'))
    (hFuelLe : targetFuel ≤ dryRun.fuel) :
    .halted halt = dryRun.result ∧ rest' = rest := by
  rcases Nat.exists_eq_add_of_le hFuelLe with ⟨extra, hFuelEq⟩
  have hTargetDryFuel :
      Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
          dryRun.initial (dryRun.trace ++ rest) =
        .ok (.halted halt, rest') := by
    rw [hFuelEq]
    exact Assembly.Target.runNResultWithOracle_halted_add hTarget
  exact result_eq_of_targetOracle_run dryRun hTargetDryFuel

theorem result_eq_of_halted_targetOracle_run_of_dryRun_halted
    (dryRun : TargetDryRun) {targetFuel : Nat}
    {rest rest' : Trace} {halt dryHalt : Assembly.Halt}
    (hDryHalt : dryRun.result = .halted dryHalt)
    (hTarget :
      Assembly.Target.runNResultWithOracle dryRun.target targetFuel
          dryRun.initial (dryRun.trace ++ rest) =
        .ok (.halted halt, rest')) :
    .halted halt = dryRun.result ∧ rest' = rest := by
  by_cases hFuelLe : targetFuel ≤ dryRun.fuel
  · exact result_eq_of_halted_targetOracle_run_le dryRun hTarget hFuelLe
  · have hDryFuelLe : dryRun.fuel ≤ targetFuel := by
      omega
    rcases Nat.exists_eq_add_of_le hDryFuelLe with ⟨extra, hFuelEq⟩
    have hDryRunAtFuel :
        Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
            dryRun.initial (dryRun.trace ++ rest) =
          .ok (.halted dryHalt, rest) := by
      simpa [hDryHalt] using oracle_run dryRun rest
    have hDryRunAtTargetFuel :
        Assembly.Target.runNResultWithOracle dryRun.target targetFuel
            dryRun.initial (dryRun.trace ++ rest) =
          .ok (.halted dryHalt, rest) := by
      rw [hFuelEq]
      exact Assembly.Target.runNResultWithOracle_halted_add hDryRunAtFuel
    rcases
        AssemblyOracle.target_run_result_unique hTarget
          hDryRunAtTargetFuel with
      ⟨hResult, hRest⟩
    exact ⟨by simpa [hDryHalt] using hResult, hRest⟩

theorem sourceOracle_run_matches_targetOracle_of_compile
    {asm : Assembly.Program} (dryRun : TargetDryRun) (rest : Trace)
    (hCompile : Assembly.compile? asm = some dryRun.target)
    (hSource :
      Assembly.Source.runNResultWithOracle asm dryRun.fuel
          dryRun.initial (dryRun.trace ++ rest) =
        .ok (dryRun.result, rest)) :
    Assembly.Accepted asm ∧
      Assembly.Preservation.BlockTraceResultWithOracle asm dryRun.target
        dryRun.fuel dryRun.initial (dryRun.trace ++ rest) rest
        dryRun.result ∧
      Assembly.Compiled.runNResultWithOracle asm dryRun.fuel
        dryRun.initial (dryRun.trace ++ rest) =
          .ok (dryRun.result, rest) ∧
      Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
        dryRun.initial (dryRun.trace ++ rest) =
          .ok (dryRun.result, rest) := by
  exact
    AssemblyOracle.source_run_matches_target_run_of_compile
      hCompile hSource (oracle_run dryRun rest)

theorem sourceOracle_run_empty_matches_targetOracle_of_compile
    {asm : Assembly.Program} (dryRun : TargetDryRun)
    (hCompile : Assembly.compile? asm = some dryRun.target)
    (hSource :
      Assembly.Source.runNResultWithOracle asm dryRun.fuel
          dryRun.initial dryRun.trace =
        .ok (dryRun.result, [])) :
    Assembly.Accepted asm ∧
      Assembly.Preservation.BlockTraceResultWithOracle asm dryRun.target
        dryRun.fuel dryRun.initial dryRun.trace [] dryRun.result ∧
      Assembly.Compiled.runNResultWithOracle asm dryRun.fuel
        dryRun.initial dryRun.trace =
          .ok (dryRun.result, []) ∧
      Assembly.Target.runNResultWithOracle dryRun.target dryRun.fuel
        dryRun.initial dryRun.trace =
          .ok (dryRun.result, []) := by
  simpa using
    sourceOracle_run_matches_targetOracle_of_compile
      (asm := asm) dryRun [] hCompile (by simpa using hSource)

theorem result_eq_of_halted_sourceOracle_run_of_compile_byteLength_lt
    {asm : Assembly.Program} (dryRun : TargetDryRun)
    {sourceFuel : Nat} {rest rest' : Trace} {halt : Assembly.Halt}
    (hCompile : Assembly.compile? asm = some dryRun.target)
    (hSource :
      Assembly.Source.runNResultWithOracle asm sourceFuel dryRun.initial
          (dryRun.trace ++ rest) =
        .ok (.halted halt, rest'))
    (hLen : Assembly.Program.byteLength asm < EvmYul.UInt256.size) :
    Assembly.Accepted asm ∧
      Assembly.Preservation.BlockTraceResultWithOracle asm dryRun.target
        sourceFuel dryRun.initial (dryRun.trace ++ rest) rest'
        (.halted halt) ∧
      Assembly.Compiled.runNResultWithOracle asm sourceFuel dryRun.initial
          (dryRun.trace ++ rest) =
        .ok (.halted halt, rest') ∧
      ∃ targetFuel,
        Assembly.Target.runNResultWithOracle dryRun.target targetFuel
            dryRun.initial (dryRun.trace ++ rest) =
          .ok (.halted halt, rest') ∧
        (targetFuel ≤ dryRun.fuel →
          .halted halt = dryRun.result ∧ rest' = rest) := by
  rcases
      AssemblyOracle.source_run_induces_target_run_exists_of_compile_byteLength_lt
        hCompile hSource hLen with
    ⟨hAccepted, hTrace, hCompiled, targetFuel, hTarget⟩
  exact
    ⟨hAccepted, hTrace, hCompiled, targetFuel, hTarget,
      fun hFuelLe =>
        result_eq_of_halted_targetOracle_run_le dryRun hTarget hFuelLe⟩

theorem result_eq_of_halted_sourceOracle_run_of_compile_byteLength_lt_of_dryRun_halted
    {asm : Assembly.Program} (dryRun : TargetDryRun)
    {sourceFuel : Nat} {rest rest' : Trace}
    {halt dryHalt : Assembly.Halt}
    (hDryHalt : dryRun.result = .halted dryHalt)
    (hCompile : Assembly.compile? asm = some dryRun.target)
    (hSource :
      Assembly.Source.runNResultWithOracle asm sourceFuel dryRun.initial
          (dryRun.trace ++ rest) =
        .ok (.halted halt, rest'))
    (hLen : Assembly.Program.byteLength asm < EvmYul.UInt256.size) :
    Assembly.Accepted asm ∧
      Assembly.Preservation.BlockTraceResultWithOracle asm dryRun.target
        sourceFuel dryRun.initial (dryRun.trace ++ rest) rest'
        (.halted halt) ∧
      Assembly.Compiled.runNResultWithOracle asm sourceFuel dryRun.initial
          (dryRun.trace ++ rest) =
        .ok (.halted halt, rest') ∧
      .halted halt = dryRun.result ∧
      rest' = rest := by
  rcases
      AssemblyOracle.source_run_induces_target_run_exists_of_compile_byteLength_lt
        hCompile hSource hLen with
    ⟨hAccepted, hTrace, hCompiled, targetFuel, hTarget⟩
  rcases
      result_eq_of_halted_targetOracle_run_of_dryRun_halted
        dryRun hDryHalt hTarget with
      ⟨hResult, hRest⟩
  exact ⟨hAccepted, hTrace, hCompiled, hResult, hRest⟩

theorem result_eq_of_halted_sourceOracle_run_empty_of_compile_byteLength_lt_of_dryRun_halted
    {asm : Assembly.Program} (dryRun : TargetDryRun)
    {sourceFuel : Nat} {halt dryHalt : Assembly.Halt}
    (hDryHalt : dryRun.result = .halted dryHalt)
    (hCompile : Assembly.compile? asm = some dryRun.target)
    (hSource :
      Assembly.Source.runNResultWithOracle asm sourceFuel dryRun.initial
