def consume (kind : Observer) : Trace →
    Except EVMException (Word × Trace)
  | [] => .error .InvalidInstruction
  | observation :: rest =>
      if observation.kind = kind then
        .ok (observation.value, rest)
      else
        .error .InvalidInstruction

structure OraclePrimitiveSemantics where
  eval :
    Structured.BasicOp → EvmYul.SharedState .EVM → List Word → Trace →
      Except EVMException (EvmYul.SharedState .EVM × List Word × Trace)
  terminal :
    Assembly.HaltKind → EvmYul.SharedState .EVM → List Word → Trace →
      Except EVMException (EvmYul.SharedState .EVM × Trace)

def replayPrimitiveSemantics : OraclePrimitiveSemantics where
  eval op shared values trace :=
    match basicOpObserver? op with
    | some kind =>
        match values with
        | [] =>
            match consume kind trace with
            | .ok (value, trace') => .ok (shared, [value], trace')
            | .error err => .error err
        | _ :: _ => .error .StackUnderflow
    | none =>
        match Locals.Source.PrimitiveSemantics.structured.eval op shared values with
        | .ok (shared', values') => .ok (shared', values', trace)
        | .error err => .error err
  terminal kind shared values trace :=
    match Locals.Source.PrimitiveSemantics.structured.terminal kind shared values with
    | .ok shared' => .ok (shared', trace)
    | .error err => .error err

theorem consume_cons_same (kind : Observer) (value : Word) (trace : Trace) :
    consume kind ({ kind := kind, value := value } :: trace) =
      .ok (value, trace) := by
  simp [consume]

theorem replay_eval_gas_cons
    (shared : EvmYul.SharedState .EVM) (value : Word) (trace : Trace) :
    replayPrimitiveSemantics.eval .gas shared []
        ({ kind := .gas, value := value } :: trace) =
      .ok (shared, [value], trace) := by
  simp [replayPrimitiveSemantics, consume]

theorem replay_eval_msize_cons
    (shared : EvmYul.SharedState .EVM) (value : Word) (trace : Trace) :
    replayPrimitiveSemantics.eval .msize shared []
        ({ kind := .msize, value := value } :: trace) =
      .ok (shared, [value], trace) := by
  simp [replayPrimitiveSemantics, consume]

theorem replay_eval_nonObserver_preserves_trace
    {op : Structured.BasicOp} {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    (hObserver : basicOpObserver? op = none)
    (hEval :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace')) :
    Locals.Source.PrimitiveSemantics.structured.eval op shared values =
        .ok (shared', values') ∧
      trace' = trace := by
  simp [replayPrimitiveSemantics, hObserver] at hEval
  cases hStructured :
      Locals.Source.PrimitiveSemantics.structured.eval op shared values with
  | error err =>
      simp [hStructured] at hEval
  | ok result =>
      rcases result with ⟨structuredShared, structuredValues⟩
      simp [hStructured] at hEval
      rcases hEval with ⟨hShared, hValues, hTrace⟩
      exact ⟨by simp [hShared, hValues], hTrace.symm⟩

theorem replay_terminal_preserves_trace
    {kind : Assembly.HaltKind}
    {shared shared' : EvmYul.SharedState .EVM}
    {values : List Word} {trace trace' : Trace}
    (hEval :
      replayPrimitiveSemantics.terminal kind shared values trace =
        .ok (shared', trace')) :
    Locals.Source.PrimitiveSemantics.structured.terminal kind shared values =
        .ok shared' ∧
      trace' = trace := by
  simp [replayPrimitiveSemantics] at hEval
  cases hTerminal :
      Locals.Source.PrimitiveSemantics.structured.terminal kind shared values with
  | error err =>
      simp [hTerminal] at hEval
  | ok terminalShared =>
      simp [hTerminal] at hEval
      rcases hEval with ⟨hShared, hTrace⟩
      exact ⟨by simp [hShared], hTrace.symm⟩

theorem replay_eval_length
    {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    (hEval :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace')) :
    values'.length = Expressions.Structured.BasicOp.outputs op := by
  cases hObserver : basicOpObserver? op with
  | none =>
      rcases replay_eval_nonObserver_preserves_trace hObserver hEval with
        ⟨hStructured, _hTrace⟩
      exact
        Locals.SourceLowering.PrimitiveSemantics.structured_eval_length
          hStructured
  | some _kind =>
      cases op <;> simp [basicOpObserver?] at hObserver
      · cases values with
        | nil =>
            cases trace with
            | nil =>
                simp [replayPrimitiveSemantics, consume] at hEval
            | cons observation rest =>
                rcases observation with ⟨obsKind, obsValue⟩
                by_cases hKind : obsKind = Assembly.ResourceObserver.msize
                · simp [replayPrimitiveSemantics, consume, hKind] at hEval
                  rcases hEval with ⟨_hShared, hValues, _hTrace⟩
                  subst values'
                  simp [Expressions.Structured.BasicOp.outputs]
                · simp [replayPrimitiveSemantics, consume, hKind] at hEval
        | cons _ _ =>
            simp [replayPrimitiveSemantics] at hEval
      · cases values with
        | nil =>
            cases trace with
            | nil =>
                simp [replayPrimitiveSemantics, consume] at hEval
            | cons observation rest =>
                rcases observation with ⟨obsKind, obsValue⟩
                by_cases hKind : obsKind = Assembly.ResourceObserver.gas
                · simp [replayPrimitiveSemantics, consume, hKind] at hEval
                  rcases hEval with ⟨_hShared, hValues, _hTrace⟩
                  subst values'
                  simp [Expressions.Structured.BasicOp.outputs]
                · simp [replayPrimitiveSemantics, consume, hKind] at hEval
        | cons _ _ =>
            simp [replayPrimitiveSemantics] at hEval

namespace ReplayPrimitiveStep

def stepTrace (op : Structured.BasicOp) (state : EVMState) : Trace :=
  match basicOpObserver? op with
  | some kind => Assembly.ResourceObserver.recordFromPostState kind state
  | none => []

theorem eval_step_nonObserver_sound
    {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm evm' : EVMState} {baseStack : EvmYul.Stack Word}
    (hObserver : basicOpObserver? op = none)
    (hReplay :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack)
    (hStep : Structured.BasicOp.step op evm = .ok evm') :
    evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  rcases replay_eval_nonObserver_preserves_trace hObserver hReplay with
    ⟨hEval, _hTrace⟩
  exact Locals.SourceLowering.PrimitiveSemantics.structured_eval_step
    hEval hShared hStack hStep

theorem eval_step_gas_sound
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm evm' : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.eval .gas shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack)
    (hStep : Structured.BasicOp.step .gas evm = .ok evm')
    (hTrace : trace = stepTrace .gas evm' ++ trace') :
    evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  cases values with
  | nil =>
      cases trace with
      | nil =>
          simp [replayPrimitiveSemantics, consume] at hReplay
      | cons observation rest =>
          by_cases hKind : observation.kind = Assembly.ResourceObserver.gas
          · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
            rcases hReplay with ⟨hShared', hValues', hTrace'⟩
            subst shared'
            subst values'
            subst trace'
            change
              EvmYul.EVM.machineStateOp EvmYul.MachineState.gas evm =
                .ok evm' at hStep
            unfold EvmYul.EVM.machineStateOp at hStep
            simp [Id.run, EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
              EvmYul.MachineState.gas] at hStep
            cases hStep
            simp [stepTrace, Assembly.ResourceObserver.recordFromPostState,
              hStack] at hTrace ⊢
            have hValue : observation.value = evm.gasAvailable := by
              exact congrArg Assembly.ResourceObservation.value hTrace
            exact ⟨hShared, by simp [hValue]⟩
          · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
  | cons _ _ =>
      simp [replayPrimitiveSemantics] at hReplay

theorem eval_step_msize_sound
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm evm' : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.eval .msize shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack)
    (hStep : Structured.BasicOp.step .msize evm = .ok evm')
    (hTrace : trace = stepTrace .msize evm' ++ trace') :
    evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  cases values with
  | nil =>
      cases trace with
      | nil =>
          simp [replayPrimitiveSemantics, consume] at hReplay
      | cons observation rest =>
          by_cases hKind : observation.kind = Assembly.ResourceObserver.msize
          · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
            rcases hReplay with ⟨hShared', hValues', hTrace'⟩
            subst shared'
            subst values'
            subst trace'
            change
              EvmYul.EVM.machineStateOp EvmYul.MachineState.msize evm =
                .ok evm' at hStep
            unfold EvmYul.EVM.machineStateOp at hStep
            simp [Id.run, EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC, EvmYul.Stack.push] at hStep
            cases hStep
            simp [stepTrace, Assembly.ResourceObserver.recordFromPostState,
              hStack] at hTrace ⊢
            have hValue :
                observation.value =
                  EvmYul.MachineState.msize evm.toMachineState := by
              exact congrArg Assembly.ResourceObservation.value hTrace
            exact ⟨hShared, by simp [hValue]⟩
          · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
  | cons _ _ =>
      simp [replayPrimitiveSemantics] at hReplay

theorem eval_step_trace_sound
    {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm evm' : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack)
    (hStep : Structured.BasicOp.step op evm = .ok evm')
    (hTrace : trace = stepTrace op evm' ++ trace') :
    evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  cases hObserver : basicOpObserver? op with
  | none =>
      exact eval_step_nonObserver_sound
        hObserver hReplay hShared hStack hStep
  | some _kind =>
      cases op <;> simp [basicOpObserver?] at hObserver
      · exact eval_step_msize_sound
          hReplay hShared hStack hStep hTrace
      · exact eval_step_gas_sound
          hReplay hShared hStack hStep hTrace

theorem eval_assembly_prim_step_exists
    {program : Assembly.Program} {pc : Nat}
    {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack) :
    ∃ evm',
      Assembly.Source.stepAtResultWithOracle program pc
          (.prim op.toPrimOp) evm trace =
        .ok (.running evm', trace') ∧
      evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  cases hObserver : basicOpObserver? op with
  | none =>
      rcases replay_eval_nonObserver_preserves_trace hObserver hReplay with
        ⟨hEval, hTrace⟩
      rcases
          Locals.SourceLowering.PrimitiveSemantics.structured_eval_step_exists
            hEval hShared hStack with
        ⟨evm', hStep, hShared', hStack'⟩
      change
        Assembly.Target.stepInstr (Assembly.TargetInstr.prim op.toPrimOp) evm =
          .ok evm' at hStep
      refine ⟨evm', ?_, hShared', ?_⟩
      · unfold Assembly.Source.stepAtResultWithOracle
        unfold Assembly.Source.stepAtResult Assembly.Source.stepAt
        have hNoHalt :
            (Assembly.Instr.prim op.toPrimOp).haltKind? = none := by
          simp [Assembly.Instr.haltKind?]
        simp [hStep, hObserver, hTrace, hNoHalt,
          Assembly.ResourceObserver.ofInstr?]
      · simpa [hTrace] using hStack'
  | some kind =>
      cases op <;> simp [basicOpObserver?] at hObserver
      · -- msize
        subst kind
        cases values with
        | nil =>
            cases trace with
            | nil =>
                simp [replayPrimitiveSemantics, consume] at hReplay
            | cons observation rest =>
                rcases observation with ⟨obsKind, obsValue⟩
                by_cases hKind : obsKind = Assembly.ResourceObserver.msize
                · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
                  rcases hReplay with ⟨hShared', hValues', hTrace'⟩
                  subst shared'
                  subst values'
                  subst trace'
                  subst obsKind
                  let post :=
                    evm.replaceStackAndIncrPC
                      (evm.stack.push
                        (EvmYul.MachineState.msize evm.toMachineState))
                  let final := { post with stack := obsValue :: evm.stack }
                  have hStepPost :
                      Assembly.Target.stepInstr
                          (Assembly.TargetInstr.prim Assembly.PrimOp.msize)
                          evm =
                        .ok post := by
                    change
                      EvmYul.EVM.machineStateOp EvmYul.MachineState.msize
                          evm =
                        .ok post
                    simp [post, EvmYul.EVM.machineStateOp, Id.run,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC, EvmYul.Stack.push]
                  refine ⟨final, ?_, ?_, ?_⟩
                  · unfold Assembly.Source.stepAtResultWithOracle
                    unfold Assembly.Source.stepAtResult Assembly.Source.stepAt
                    simp [hStepPost, Structured.BasicOp.toPrimOp, post, final,
                      Assembly.StepResult.state, Assembly.StepResult.withState,
                      Assembly.Instr.haltKind?, Assembly.PrimOp.haltKind?,
                      Assembly.ResourceObserver.ofInstr?,
                      Assembly.ResourceObserver.ofPrimOp?,
                      Assembly.ResourceObserver.applyOracleFromPostState,
                      Assembly.ResourceObserver.consume,
                      Assembly.ResourceObserver.overwriteTop,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
                      Bind.bind, Except.bind]
                  · simp [final, post, hShared,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC]
                  · simp [final, hStack]
                · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
        | cons _ _ =>
            simp [replayPrimitiveSemantics] at hReplay
      · -- gas
        subst kind
        cases values with
        | nil =>
            cases trace with
            | nil =>
                simp [replayPrimitiveSemantics, consume] at hReplay
            | cons observation rest =>
                rcases observation with ⟨obsKind, obsValue⟩
                by_cases hKind : obsKind = Assembly.ResourceObserver.gas
                · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
                  rcases hReplay with ⟨hShared', hValues', hTrace'⟩
                  subst shared'
                  subst values'
                  subst trace'
                  subst obsKind
                  let post :=
                    evm.replaceStackAndIncrPC
                      (evm.stack.push
                        (EvmYul.MachineState.gas evm.toMachineState))
                  let final := { post with stack := obsValue :: evm.stack }
                  have hStepPost :
                      Assembly.Target.stepInstr
                          (Assembly.TargetInstr.prim Assembly.PrimOp.gas)
                          evm =
                        .ok post := by
                    change
                      EvmYul.EVM.machineStateOp EvmYul.MachineState.gas
                          evm =
                        .ok post
                    simp [post, EvmYul.EVM.machineStateOp, Id.run,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
                      EvmYul.MachineState.gas]
                  refine ⟨final, ?_, ?_, ?_⟩
                  · unfold Assembly.Source.stepAtResultWithOracle
                    unfold Assembly.Source.stepAtResult Assembly.Source.stepAt
                    simp [hStepPost, Structured.BasicOp.toPrimOp, post, final,
                      Assembly.StepResult.state, Assembly.StepResult.withState,
                      Assembly.Instr.haltKind?, Assembly.PrimOp.haltKind?,
                      Assembly.ResourceObserver.ofInstr?,
                      Assembly.ResourceObserver.ofPrimOp?,
                      Assembly.ResourceObserver.applyOracleFromPostState,
                      Assembly.ResourceObserver.consume,
                      Assembly.ResourceObserver.overwriteTop,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
                      EvmYul.MachineState.gas, Bind.bind, Except.bind]
                  · simp [final, post, hShared,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC]
                  · simp [final, hStack]
                · simp [replayPrimitiveSemantics, consume, hKind] at hReplay
        | cons _ _ =>
            simp [replayPrimitiveSemantics] at hReplay

theorem terminal_assembly_step_exists
    {program : Assembly.Program} {pc : Nat}
    {kind : Assembly.HaltKind}
    {shared shared' : EvmYul.SharedState .EVM}
    {values : List Word} {trace trace' : Trace}
    {evm : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.terminal kind shared values trace =
        .ok (shared', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack) :
    ∃ evm',
      Assembly.Source.stepAtResultWithOracle program pc
          (.prim kind.toPrimOp) evm trace =
        .ok (.halted
          { kind := kind, state := evm', output := kind.output evm' },
          trace') ∧
      evm'.toSharedState = shared' := by
  rcases replay_terminal_preserves_trace hReplay with
    ⟨hTerminal, hTrace⟩
  rcases
      Locals.SourceLowering.PrimitiveSemantics.structured_terminal_step_exists
        hTerminal hShared hStack with
    ⟨evm', hStep, hShared'⟩
  change
    Assembly.Target.stepInstr
        (Assembly.TargetInstr.prim kind.toPrimOp) evm =
      .ok evm' at hStep
  refine ⟨evm', ?_, hShared'⟩
  unfold Assembly.Source.stepAtResultWithOracle
  unfold Assembly.Source.stepAtResult Assembly.Source.stepAt
  simp [hStep, hTrace, Assembly.Instr.haltKind?,
    haltKind_toPrimOp_haltKind?_some,
    Assembly.ResourceObserver.ofInstr?]

end ReplayPrimitiveStep

structure PrimitiveAssemblyOracleSound
    (prim : OraclePrimitiveSemantics) : Prop where
  eval_step_exists :
    ∀ {program : Assembly.Program} {pc : Nat}
      {op : Structured.BasicOp}
      {shared shared' : EvmYul.SharedState .EVM}
      {values values' : List Word} {trace trace' : Trace}
      {evm : EVMState} {baseStack : EvmYul.Stack Word},
      prim.eval op shared values trace =
        .ok (shared', values', trace') →
      evm.toSharedState = shared →
      evm.stack = values.reverse ++ baseStack →
        ∃ evm',
          Assembly.Source.stepAtResultWithOracle program pc
              (.prim op.toPrimOp) evm trace =
            .ok (.running evm', trace') ∧
          evm'.toSharedState = shared' ∧
          evm'.stack = values'.reverse ++ baseStack
  eval_length :
    ∀ {op : Structured.BasicOp}
      {shared shared' : EvmYul.SharedState .EVM}
      {values values' : List Word} {trace trace' : Trace},
      prim.eval op shared values trace =
        .ok (shared', values', trace') →
      values'.length = Expressions.Structured.BasicOp.outputs op
  terminal_step_exists :
    ∀ {program : Assembly.Program} {pc : Nat}
      {kind : Assembly.HaltKind}
      {shared shared' : EvmYul.SharedState .EVM}
      {values : List Word} {trace trace' : Trace}
      {evm : EVMState} {baseStack : EvmYul.Stack Word},
      prim.terminal kind shared values trace =
        .ok (shared', trace') →
      evm.toSharedState = shared →
      evm.stack = values.reverse ++ baseStack →
        ∃ evm',
          Assembly.Source.stepAtResultWithOracle program pc
              (.prim kind.toPrimOp) evm trace =
            .ok (.halted
              { kind := kind, state := evm', output := kind.output evm' },
              trace') ∧
          evm'.toSharedState = shared'

theorem replayPrimitiveAssemblySound :
    PrimitiveAssemblyOracleSound replayPrimitiveSemantics where
  eval_step_exists hEval hShared hStack :=
    ReplayPrimitiveStep.eval_assembly_prim_step_exists
      hEval hShared hStack
  eval_length hEval :=
    replay_eval_length hEval
  terminal_step_exists hEval hShared hStack :=
    ReplayPrimitiveStep.terminal_assembly_step_exists
      hEval hShared hStack

namespace StructuredReplay

def ARunResultWithOracle (program : Assembly.Program) (state : EVMState)
    (trace : Trace) (post : Assembly.StepResult → Trace → Prop) : Prop :=
  ∃ fuel result trace',
    Assembly.Source.runNResultWithOracle program fuel state trace =
      .ok (result, trace') ∧
      post result trace'

namespace ARunResultWithOracle

theorem exact {program : Assembly.Program} {fuel : Nat}
    {state : EVMState} {trace trace' : Trace}
    {result : Assembly.StepResult}
    {post : Assembly.StepResult → Trace → Prop}
    (hRun :
      Assembly.Source.runNResultWithOracle program fuel state trace =
        .ok (result, trace'))
    (hPost : post result trace') :
    ARunResultWithOracle program state trace post := by
  exact ⟨fuel, result, trace', hRun, hPost⟩

theorem pure {program : Assembly.Program} {state : EVMState}
    {trace : Trace} {post : Assembly.StepResult → Trace → Prop}
    (hPost : post (.running state) trace) :
    ARunResultWithOracle program state trace post := by
  exact ⟨0, .running state, trace, rfl, hPost⟩

theorem bind_running {program : Assembly.Program}
    {state : EVMState} {trace : Trace}
    {middle : EVMState → Trace → Prop}
    {post : Assembly.StepResult → Trace → Prop}
    (hRun :
      ARunResultWithOracle program state trace
        (fun result traceMid =>
          match result with
          | .running mid => middle mid traceMid
          | .halted _ => False))
    (hNext :
      ∀ mid traceMid, middle mid traceMid →
        ARunResultWithOracle program mid traceMid post) :
    ARunResultWithOracle program state trace post := by
  rcases hRun with ⟨firstFuel, firstResult, traceMid, hFirst, hMiddle⟩
  cases firstResult with
  | halted halt =>
      cases hMiddle
  | running mid =>
      rcases hNext mid traceMid hMiddle with
        ⟨secondFuel, result, traceOut, hSecond, hPost⟩
      exact
        ⟨firstFuel + secondFuel, result, traceOut,
          (Assembly.Source.runNResultWithOracle_running_bind hFirst hSecond),
          hPost⟩

theorem mono {program : Assembly.Program} {state : EVMState}
    {trace : Trace}
    {post₁ post₂ : Assembly.StepResult → Trace → Prop}
    (hRun : ARunResultWithOracle program state trace post₁)
    (hPost :
      ∀ result traceOut, post₁ result traceOut → post₂ result traceOut) :
    ARunResultWithOracle program state trace post₂ := by
  rcases hRun with ⟨fuel, result, traceOut, hRun, hResult⟩
  exact ⟨fuel, result, traceOut, hRun, hPost result traceOut hResult⟩

end ARunResultWithOracle

namespace Frame

namespace StateRel

theorem of_sameData_target
    {source : Structured.RunState} {target sameDataTarget : EVMState}
    {tokens : List Word}
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hData :
      Structured.Preservation.SameData sameDataTarget target) :
    Structured.Preservation.Frame.StateRel source sameDataTarget tokens := by
  rcases hRel with ⟨hStackRel, hDataRel⟩
  have hStack :
      sameDataTarget.stack = target.stack :=
    Structured.Preservation.stack_eq_of_eraseControl_eq hData
  refine ⟨?_, ?_⟩
  · simpa [hStack] using hStackRel
  · calc
      Structured.Preservation.eraseControl sameDataTarget
          = Structured.Preservation.eraseControl target := hData
      _ =
          Structured.Preservation.eraseControl
            { source.evm with stack := target.stack } := hDataRel
      _ =
          Structured.Preservation.eraseControl
            { source.evm with stack := sameDataTarget.stack } := by
              rw [hStack]

theorem label_runResultWithOracle_at {label : Assembly.Label}
    {pre post : Assembly.Program} {source : Structured.RunState}
    {target : EVMState} {tokens : List Word} {trace : Trace}
    (hFit : Structured.Preservation.PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens) :
    ARunResultWithOracle (pre ++ [Assembly.Instr.label label] ++ post)
      target trace
      (fun result traceFinal =>
        traceFinal = trace ∧
          match result with
          | .running target' =>
              Structured.Preservation.Frame.StateRel source target' tokens ∧
                target'.pc =
                  Assembly.Program.pcAfter
                    (pre ++ [Assembly.Instr.label label])
          | .halted _ => False) := by
  rcases
      Structured.Preservation.Frame.StateRel.label_stepResult_at
        (label := label) (pre := pre) (post := post)
        (source := source) (target := target) (tokens := tokens)
        hFit hPc hRel with
    ⟨target', hStep, hRel', hPc'⟩
  have hAtLabel :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.label label] ++ post)
          target.pc.toNat =
        some (Assembly.Program.byteLength pre,
          Assembly.Instr.label label) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.label label) 0
  have hStepOracle :
      Assembly.Source.stepResultWithOracle
          (pre ++ [Assembly.Instr.label label] ++ post) target trace =
        .ok (.running target', trace) :=
    Assembly.Source.stepResultWithOracle_of_stepResult_observer_none
      hStep (by
        intro pc instr hAt
        rw [hAtLabel] at hAt
        cases hAt
        rfl)
  refine
    ARunResultWithOracle.exact
      (program := pre ++ [Assembly.Instr.label label] ++ post)
      (fuel := 1) (state := target) (trace := trace)
      (trace' := trace) (result := .running target')
      ?_ ?_
  · unfold Assembly.Source.runNResultWithOracle
    rw [hStepOracle]
    rfl
  · exact ⟨rfl, hRel', hPc'⟩

theorem jump_then_label_runResultWithOracle_at {label : Assembly.Label}
    {pre between post : Assembly.Program} {source : Structured.RunState}
    {target : EVMState} {tokens : List Word} {trace : Trace}
    (hFitJump : Structured.Preservation.PCFits pre)
    (hFitLabel :
      Structured.Preservation.PCFits
        (pre ++ [Assembly.Instr.jump label] ++ between))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc
          (pre ++ [Assembly.Instr.jump label] ++ between ++
            [Assembly.Instr.label label] ++ post) label =
        some
          (Assembly.Program.byteLength
            (pre ++ [Assembly.Instr.jump label] ++ between))) :
    ARunResultWithOracle
      (pre ++ [Assembly.Instr.jump label] ++ between ++
        [Assembly.Instr.label label] ++ post)
      target trace
      (fun result traceFinal =>
        traceFinal = trace ∧
          match result with
          | .running target' =>
              Structured.Preservation.Frame.StateRel source target' tokens ∧
                target'.pc =
                  Assembly.Program.pcAfter
                    (pre ++ [Assembly.Instr.jump label] ++ between ++
                      [Assembly.Instr.label label])
          | .halted _ => False) := by
  let labelPre := pre ++ [Assembly.Instr.jump label] ++ between
  have hJumpLabel :
      Assembly.Program.labelPc
          (pre ++ [Assembly.Instr.jump label] ++
            (between ++ [Assembly.Instr.label label] ++ post)) label =
        some (Assembly.Program.byteLength labelPre) := by
    simpa [labelPre, List.append_assoc] using hLabel
  rcases
      Structured.Preservation.Frame.StateRel.jump_stepResult_at
        (label := label) (dest := Assembly.Program.byteLength labelPre)
        (pre := pre)
        (post := between ++ [Assembly.Instr.label label] ++ post)
        (source := source) (target := target) (tokens := tokens)
        hFitJump hPc hRel hJumpLabel with
    ⟨targetAfterJump, hJump, hRelAfterJump, hPcAfterJump⟩
  have hJumpStep :
      Assembly.Source.stepResult
          (pre ++ [Assembly.Instr.jump label] ++ between ++
            [Assembly.Instr.label label] ++ post)
          target =
        .ok (.running targetAfterJump) := by
    simpa [List.append_assoc] using hJump
  have hAtJump :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.jump label] ++ between ++
            [Assembly.Instr.label label] ++ post)
          target.pc.toNat =
        some (Assembly.Program.byteLength pre,
          Assembly.Instr.jump label) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFitJump]
    simpa [List.append_assoc] using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre (between ++ [Assembly.Instr.label label] ++ post)
        (Assembly.Instr.jump label) 0
  have hJumpOracle :
      Assembly.Source.stepResultWithOracle
          (pre ++ [Assembly.Instr.jump label] ++ between ++
            [Assembly.Instr.label label] ++ post)
          target trace =
        .ok (.running targetAfterJump, trace) :=
    Assembly.Source.stepResultWithOracle_of_stepResult_observer_none
      hJumpStep (by
        intro pc instr hAt
        rw [hAtJump] at hAt
        cases hAt
        rfl)
  have hHead :
      ARunResultWithOracle
        (pre ++ [Assembly.Instr.jump label] ++ between ++
          [Assembly.Instr.label label] ++ post)
        target trace
        (fun result traceMid =>
          match result with
          | .running mid =>
              traceMid = trace ∧
                Structured.Preservation.Frame.StateRel source mid tokens ∧
                mid.pc = Assembly.Program.pcAfter labelPre
          | .halted _ => False) := by
    refine
      ARunResultWithOracle.exact
        (program :=
          pre ++ [Assembly.Instr.jump label] ++ between ++
            [Assembly.Instr.label label] ++ post)
        (fuel := 1) (state := target) (trace := trace)
        (trace' := trace) (result := .running targetAfterJump)
        ?_ ?_
    · unfold Assembly.Source.runNResultWithOracle
      rw [hJumpOracle]
      rfl
    · exact ⟨rfl, hRelAfterJump, by simpa [labelPre] using hPcAfterJump⟩
  refine ARunResultWithOracle.bind_running hHead ?_
  intro targetAfterJump' traceMid hMiddle
  rcases hMiddle with ⟨hTraceMid, hRelMiddle, hPcMiddle⟩
  subst traceMid
  have hLabelRun :=
    label_runResultWithOracle_at (label := label) (pre := labelPre)
      (post := post) (source := source) (target := targetAfterJump')
      (tokens := tokens) (trace := trace)
      hFitLabel hPcMiddle hRelMiddle
  exact
    ARunResultWithOracle.mono
      (by simpa [labelPre, List.append_assoc] using hLabelRun)
      (by
        intro result traceFinal hResult
        rcases hResult with ⟨hTraceFinal, hResult⟩
        exact
          ⟨hTraceFinal,
            by
              cases result with
              | halted halt =>
                  exact hResult
              | running target' =>
                  simpa [labelPre, List.append_assoc] using hResult⟩)

theorem pop_runResultWithOracle_at {pre post : Assembly.Program}
    {source : Structured.RunState} {target : EVMState}
    {tokens : List Word}
    {stack : EvmYul.Stack Word} {value : Word}
    {trace : Trace}
    (hFit : Structured.Preservation.PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hPop : source.evm.stack.pop = some (stack, value)) :
    ARunResultWithOracle
      (pre ++ [Assembly.Instr.prim .pop] ++ post)
      target trace
      (fun result traceFinal =>
        traceFinal = trace ∧
          match result with
          | .running target' =>
              Structured.Preservation.Frame.StateRel
                (source.withEVM { source.evm with stack := stack })
                target' tokens ∧
                target'.pc =
                  Assembly.Program.pcAfter
                    (pre ++ [Assembly.Instr.prim .pop])
          | .halted _ => False) := by
  rcases
      Structured.Preservation.Frame.StateRel.pop_stepResult_at
        (pre := pre) (post := post) (source := source)
        (target := target) (tokens := tokens) (stack := stack)
        (value := value) hFit hPc hRel hPop with
    ⟨targetAfterPop, hPopStep, hRelAfterPop, hPcAfterPop⟩
  have hAtPop :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.prim .pop] ++ post)
          target.pc.toNat =
        some (Assembly.Program.byteLength pre,
          Assembly.Instr.prim .pop) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.prim .pop) 0
  have hPopOracle :
      Assembly.Source.stepResultWithOracle
          (pre ++ [Assembly.Instr.prim .pop] ++ post) target trace =
        .ok (.running targetAfterPop, trace) :=
    Assembly.Source.stepResultWithOracle_of_stepResult_observer_none
      hPopStep (by
        intro pc instr hAt
        rw [hAtPop] at hAt
        cases hAt
        rfl)
  refine
    ARunResultWithOracle.exact
      (program := pre ++ [Assembly.Instr.prim .pop] ++ post)
      (fuel := 1) (state := target) (trace := trace)
      (trace' := trace) (result := .running targetAfterPop)
      ?_ ?_
  · unfold Assembly.Source.runNResultWithOracle
    rw [hPopOracle]
    rfl
  · exact ⟨rfl, hRelAfterPop, hPcAfterPop⟩

end StateRel

