  theorem runCompiledCodeWithOracle_of_eval_sourceOwned
      {program : Assembly.Program} :
      ∀ {results : Nat} {expr : Locals.Expr results}
        {layout : List Name} {ctx : Locals.Ctx} {offset pc : Nat}
        {state state' : State} {values : List Word}
        {evm : EVMState} {stackPrefix : List Word}
        {code : Structured.Code},
        ctx.layout = layout →
        layout.Nodup →
        Locals.Source.Expr.SourceOwned expr →
        Locals.SourceLowering.Expr.Accessible layout offset expr →
        stackPrefix.length = offset →
        Locals.SourceLowering.StackPrefixRel layout state.source
          stackPrefix evm →
        Locals.Expr.compileCode ctx offset expr = some code →
        Expr.eval expr state = .ok (state', values) →
          ∃ evm',
            StructuredReplay.Code.runWithOracle program pc code evm
                state.trace =
              .ok (evm', state'.trace) ∧
            Locals.SourceLowering.StackPrefixRel layout state'.source
              (values.reverse ++ stackPrefix) evm' := by
    intro results expr layout ctx offset pc state state' values evm
      stackPrefix code hCtxLayout hNoDup hOwned hAccess hPrefixLen hRel
      hCompile hEval
    cases expr with
    | lit value =>
        simp [Locals.Expr.compileCode] at hCompile
        cases hCompile
        simp [Expr.eval] at hEval
        rcases hEval with ⟨hState, hValues⟩
        cases hState
        cases hValues
        rcases hRel with ⟨hShared, baseStack, hStack, hStackRel⟩
        let evm' :=
          evm.replaceStackAndIncrPC (evm.stack.push value) (pcΔ := 33)
        refine ⟨evm', ?_, ?_⟩
        · simp [StructuredReplay.Code.runWithOracle_singleton_push, evm']
        · constructor
          · simpa [evm', EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC] using hShared
          · refine ⟨baseStack, ?_, hStackRel⟩
            simp [evm', hStack, EvmYul.Stack.push,
              EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC]
    | var name =>
        unfold Expr.eval at hEval
        cases hLookup : state.source.vars name with
        | none =>
            simp [State.vars, hLookup, invalid, Structured.invalid] at hEval
        | some value =>
            simp [State.vars, hLookup] at hEval
            rcases hEval with ⟨hState, hValues⟩
            cases hState
            cases hValues
            rcases hAccess with ⟨idx, hName, hBound⟩
            rcases hRel with ⟨hShared, baseStack, hStack, hStackRel⟩
            cases hDepth :
                Locals.Layout.lookupDepth? name ctx.layout with
            | none =>
                simp [Locals.Expr.compileCode, hDepth] at hCompile
            | some depth =>
                cases hDup : Locals.StackOp.dup? (offset + depth) with
                | none =>
                    simp [Locals.Expr.compileCode, hDepth, hDup] at hCompile
                | some op =>
                    simp [Locals.Expr.compileCode, hDepth, hDup] at hCompile
                    cases hCompile
                    have hBaseAt : baseStack[idx]? = some value := by
                      have hSlot := hStackRel.2 hName
                      simpa [hLookup] using hSlot
                    have hStackAt :
                        evm.stack[offset + idx]? = some value := by
                      rw [hStack]
                      have hOffsetLen : offset = stackPrefix.length :=
                        hPrefixLen.symm
                      subst offset
                      rw [List.getElem?_append_right]
                      · simpa using hBaseAt
                      · simp
                    let evm' :=
                      evm.replaceStackAndIncrPC (value :: evm.stack)
                    have hRun :
                        Locals.Direct.Expr.runCode ctx offset (.var name)
                            evm =
                          .ok evm' := by
                      simpa [evm'] using
                        (Locals.Direct.Expr.runCode_var_layout_slot_value
                          ctx evm name layout
                          (idx := idx) (offset := offset)
                          hCtxLayout hNoDup hName hStackAt hBound)
                    have hStep : op.step evm = .ok evm' := by
                      simpa [Locals.Direct.Expr.runCode, hDepth, hDup]
                        using hRun
