namespace EvmCompiler
namespace Yul

/-!
Observer-oracle support for the unchecked `gas()`/`msize()` route.

This module deliberately separates two facts:

* the target dry run records concrete values observed by executed EVM `GAS` and
  `MSIZE` instructions;
* a replay source primitive may consume those recorded values as an explicit
  oracle.

It does not claim that the ordinary Yul source state's gas or active-memory
bookkeeping agrees with the compiled EVM run.
-/
namespace ObserverOracle

abbrev Trace := Assembly.ResourceTrace
abbrev Observation := Assembly.ResourceObservation
abbrev Observer := Assembly.ResourceObserver
abbrev SourcePrimitiveSemantics := Locals.Source.PrimitiveSemantics

def basicOpObserver? : Structured.BasicOp → Option Observer
  | .gas => some .gas
  | .msize => some .msize
  | _ => none

def yulPrimObserver? : EvmYul.Operation .Yul → Option Observer
  | .StackMemFlow .GAS => some .gas
  | .StackMemFlow .MSIZE => some .msize
  | _ => none

@[simp] theorem basicOpObserver?_gas :
    basicOpObserver? .gas = some .gas := rfl

@[simp] theorem basicOpObserver?_msize :
    basicOpObserver? .msize = some .msize := rfl

@[simp] theorem yulPrimObserver?_gas :
    yulPrimObserver?
        ((.StackMemFlow .GAS : EvmYul.Operation .Yul)) =
      some .gas := rfl

@[simp] theorem yulPrimObserver?_msize :
    yulPrimObserver?
        ((.StackMemFlow .MSIZE : EvmYul.Operation .Yul)) =
      some .msize := rfl

@[simp] theorem uncheckedBasicOp?_gas_observer :
    Prim.toUncheckedBasicOp?
        ((.StackMemFlow .GAS : EvmYul.Operation .Yul)) =
      some .gas ∧
    basicOpObserver? .gas = yulPrimObserver?
        ((.StackMemFlow .GAS : EvmYul.Operation .Yul)) := by
  simp [Prim.toUncheckedBasicOp?]

@[simp] theorem uncheckedBasicOp?_msize_observer :
    Prim.toUncheckedBasicOp?
        ((.StackMemFlow .MSIZE : EvmYul.Operation .Yul)) =
      some .msize ∧
    basicOpObserver? .msize = yulPrimObserver?
        ((.StackMemFlow .MSIZE : EvmYul.Operation .Yul)) := by
  simp [Prim.toUncheckedBasicOp?]

@[simp] theorem basicOp_toPrimOp_observer
    (op : Structured.BasicOp) :
    Assembly.ResourceObserver.ofPrimOp? op.toPrimOp =
      basicOpObserver? op := by
  cases op <;> rfl

@[simp] theorem basicOp_toPrimOp_haltKind?_none
    (op : Structured.BasicOp) :
    op.toPrimOp.haltKind? = none := by
