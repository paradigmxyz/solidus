mutual
  def Block.runWithOracle (asmProgram : Assembly.Program) (pc : Nat)
      (program : Structured.Program) :
      Nat → Structured.Block → Structured.RunState → Trace →
        Except EVMException (Structured.Outcome × Trace)
    | 0, _block, _state, _trace =>
        Structured.invalid
    | _fuel + 1, ⟨[]⟩, state, trace =>
        .ok (Structured.Outcome.regular state, trace)
    | fuel + 1, ⟨stmt :: rest⟩, state, trace => do
        let (outcome, trace') ←
          Stmt.runWithOracle asmProgram pc program fuel stmt state trace
        match outcome.mode with
        | .regular =>
            Block.runWithOracle asmProgram pc program fuel ⟨rest⟩
              outcome.state trace'
        | .brk | .cont | .leave | .halt _ =>
            .ok (outcome, trace')
  termination_by fuel block _state _trace => (fuel, 0, sizeOf block)

  def Stmt.runForLoopWithOracle (asmProgram : Assembly.Program) (pc : Nat)
      (program : Structured.Program) :
      Nat → Structured.Code → Structured.Block → Structured.Block →
        Structured.RunState → Trace →
          Except EVMException (Structured.Outcome × Trace)
    | 0, _cond, _post, _body, _state, _trace =>
        Structured.invalid
    | fuel + 1, cond, post, body, state, trace =>
        match Code.runConditionWithOracle asmProgram pc cond state trace with
        | .error err => .error err
        | .ok (stateAfterCond, condTrue, traceAfterCond) =>
            if condTrue then
              match Block.runWithOracle asmProgram pc program fuel body
                  stateAfterCond traceAfterCond with
              | .error err => .error err
              | .ok (bodyOutcome, traceAfterBody) =>
                  match bodyOutcome.mode with
                  | .brk =>
                      .ok (Structured.Outcome.regular bodyOutcome.state,
                        traceAfterBody)
                  | .regular | .cont =>
                      match Block.runWithOracle asmProgram pc program fuel post
                          bodyOutcome.state traceAfterBody with
                      | .error err => .error err
                      | .ok (postOutcome, traceAfterPost) =>
                          match postOutcome.mode with
                          | .regular =>
                              Stmt.runForLoopWithOracle asmProgram pc program
                                fuel cond post body postOutcome.state
                                traceAfterPost
                          | .brk | .cont =>
                              Structured.invalid
                          | .leave | .halt _ =>
                              .ok (postOutcome, traceAfterPost)
                  | .leave | .halt _ =>
                      .ok (bodyOutcome, traceAfterBody)
            else
              .ok (Structured.Outcome.regular stateAfterCond, traceAfterCond)
  termination_by fuel _cond _post _body _state _trace => (fuel, 2, 0)

  def Stmt.runWithOracle (asmProgram : Assembly.Program) (pc : Nat)
      (program : Structured.Program) :
      Nat → Structured.Stmt → Structured.RunState → Trace →
        Except EVMException (Structured.Outcome × Trace)
    | _fuel, .code code, state, trace => do
        let (evm', trace') ← Code.runWithOracle asmProgram pc code state.evm trace
        .ok (Structured.Outcome.regular (state.withEVM evm'), trace')
    | 0, .if_ _cond _body, _state, _trace =>
        Structured.invalid
    | fuel + 1, .if_ cond body, state, trace =>
        match Code.runConditionWithOracle asmProgram pc cond state trace with
        | .error err => .error err
        | .ok (stateAfterCond, condTrue, traceAfterCond) =>
            if condTrue then
              Block.runWithOracle asmProgram pc program fuel body
                stateAfterCond traceAfterCond
            else
              .ok (Structured.Outcome.regular stateAfterCond, traceAfterCond)
    | 0, .switch _scrutinee _cases _defaultBody, _state, _trace =>
        Structured.invalid
    | fuel + 1, .switch scrutinee cases defaultBody, state, trace => do
        let (evmAfterScrutinee, traceAfterScrutinee) ←
          Code.runWithOracle asmProgram pc scrutinee state.evm trace
        match evmAfterScrutinee.stack.pop with
        | none =>
            .error .StackUnderflow
        | some ⟨stack, value⟩ =>
            let evmAfterPop := { evmAfterScrutinee with stack := stack }
            let stateAfterPop := state.withEVM evmAfterPop
            match Structured.Switch.select value cases defaultBody with
            | some body =>
                Block.runWithOracle asmProgram pc program fuel body
                  stateAfterPop traceAfterScrutinee
            | none =>
                .ok (Structured.Outcome.regular stateAfterPop,
                  traceAfterScrutinee)
    | 0, .for_ _init _cond _post _body, _state, _trace =>
        Structured.invalid
    | fuel + 1, .for_ init cond post body, state, trace => do
        let (initOutcome, traceAfterInit) ←
          Block.runWithOracle asmProgram pc program fuel init state trace
        match initOutcome.mode with
        | .regular =>
            Stmt.runForLoopWithOracle asmProgram pc program fuel cond post body
              initOutcome.state traceAfterInit
        | .brk | .cont =>
            Structured.invalid
        | .leave | .halt _ =>
            .ok (initOutcome, traceAfterInit)
    | _fuel, .brk, state, trace =>
        .ok (Structured.Outcome.brk state, trace)
    | _fuel, .cont, state, trace =>
        .ok (Structured.Outcome.cont state, trace)
    | _fuel, .leave, state, trace =>
        match state.returns with
        | [] => Structured.invalid
        | _ :: _ => .ok (Structured.Outcome.leave state, trace)
    | 0, .call _name, _state, _trace =>
        Structured.invalid
    | fuel + 1, .call name, state, trace =>
        match Structured.ProcList.lookup? name program.procs with
        | none =>
            Structured.invalid
        | some proc =>
            match Structured.StackFrame.splitArgs? proc.argc state.evm.stack with
            | none =>
                .error .StackUnderflow
            | some (args, callerStack) =>
                let callEVM := { state.evm with stack := args }
                let callState :=
                  (state.withEVM callEVM).pushReturn callerStack proc.retc
                match Block.runWithOracle asmProgram pc program fuel proc.body
                    callState trace with
                | .error err => .error err
                | .ok (outcome, traceAfterCall) =>
                    match outcome.mode with
                    | .regular | .leave =>
                        match outcome.state.popReturn? with
                        | none => Structured.invalid
                        | some (frame, returned) =>
                            match Structured.StackFrame.attachReturns? frame
                                outcome.state.evm.stack with
                            | none => Structured.invalid
                            | some stack =>
                                let evm := { outcome.state.evm with stack := stack }
                                .ok
                                  (Structured.Outcome.regular
                                    (returned.withEVM evm), traceAfterCall)
                    | .brk | .cont =>
                        Structured.invalid
                    | .halt kind =>
                        .ok
                          (Structured.Outcome.halt kind outcome.state,
                            traceAfterCall)
    | _fuel, .terminal kind, state, trace => do
        let evm ← Structured.Terminal.step kind state.evm
        .ok (Structured.Outcome.halt kind (state.withEVM evm), trace)
  termination_by fuel stmt _state _trace => (fuel, 3, sizeOf stmt)

  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | exact Prod.Lex.right _
          (Prod.Lex.left _ _ (by omega))
end

