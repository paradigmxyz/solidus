theorem compileExprWithOracle_of_eval_sourceOwned
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {sourceCtx : Ctx} {targetCtx : Locals.Ctx} {fuel pc : Nat}
    {expr : Locals.Expr 0} {state stateAfterExpr : State}
    {values : List Word} {target : Locals.RunState}
    {code : Structured.Code}
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible sourceCtx.scope 0 expr)
    (hRel :
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompile : Locals.Expr.compileCode targetCtx 0 expr = some code)
    (hEval : Expr.eval expr state = .ok (stateAfterExpr, values)) :
    ∃ evm',
      Locals.Stmt.compile targetCtx (.expr expr) =
        some (Locals.codeStmt code, targetCtx) ∧
      Stmt.run program sourceCtx fuel (.expr expr) state =
        .ok (Outcome.regular stateAfterExpr, sourceCtx) ∧
      StructuredReplay.Code.runWithOracle asmProgram pc code target.evm
          state.trace =
        .ok (evm', stateAfterExpr.trace) ∧
      Locals.SourceLowering.StateRel sourceCtx.scope stateAfterExpr.source
        (target.withEVM evm') ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  rcases hCtx with ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  have hCtxRel : Locals.SourceLowering.CtxRel sourceCtx targetCtx :=
    ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  rcases
      Expr.runCompiledCodeWithOracle_of_eval_sourceOwned
        (program := asmProgram) (layout := sourceCtx.scope)
        (ctx := targetCtx) (offset := 0) (pc := pc)
        (state := state) (state' := stateAfterExpr)
        (values := values) (evm := target.evm)
        (stackPrefix := []) (code := code)
        hLayout hNoDup hOwned hAccess rfl
        (Locals.SourceLowering.StackPrefixRel.of_stateRel hRel)
        hCompile hEval with
    ⟨evm', hRunCode, hPrefixRel⟩
  have hValuesLen : values.length = 0 :=
    Expr.eval_length hEval
  have hValuesNil : values = [] := by
    cases values with
    | nil => rfl
    | cons _head _tail =>
        simp at hValuesLen
  have hPrefixNil :
      Locals.SourceLowering.StackPrefixRel sourceCtx.scope
        stateAfterExpr.source [] evm' := by
    simpa [hValuesNil] using hPrefixRel
  have hStateRel :
      Locals.SourceLowering.StateRel sourceCtx.scope stateAfterExpr.source
        (target.withEVM evm') :=
    Locals.SourceLowering.StackPrefixRel.to_stateRel_nil
      (target := target.withEVM evm') hPrefixNil
  refine ⟨evm', ?_, ?_, hRunCode, hStateRel, hCtxRel⟩
  · simp [Locals.Stmt.compile, Locals.codeStmt, hCompile]
  · simp [Stmt.run, hEval]

theorem compileLetWithOracle_of_evalOne_sourceOwned
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {sourceCtx : Ctx} {targetCtx : Locals.Ctx} {fuel pc : Nat}
    {name : Name} {expr : Locals.Expr 1}
    {state stateAfterValue : State} {value : Word}
    {target : Locals.RunState} {code : Structured.Code}
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible sourceCtx.scope 0 expr)
    (hFresh : name ∉ sourceCtx.scope)
    (hRel :
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompile : Locals.Expr.compileCode targetCtx 0 expr = some code)
    (hEvalOne : Expr.evalOne expr state = .ok (stateAfterValue, value)) :
    ∃ evm',
      Locals.Stmt.compile targetCtx (.let_ name expr) =
        some
          (Locals.codeStmt code,
            targetCtx.withLayout (name :: targetCtx.layout)) ∧
      Stmt.run program sourceCtx fuel (.let_ name expr) state =
        .ok
          (Outcome.regular (stateAfterValue.insert name value),
            { sourceCtx with scope := name :: sourceCtx.scope }) ∧
      StructuredReplay.Code.runWithOracle asmProgram pc code target.evm
          state.trace =
        .ok (evm', stateAfterValue.trace) ∧
      Locals.SourceLowering.StateRel (name :: sourceCtx.scope)
        (stateAfterValue.source.insert name value) (target.withEVM evm') ∧
      Locals.SourceLowering.CtxRel
        { sourceCtx with scope := name :: sourceCtx.scope }
        (targetCtx.withLayout (name :: targetCtx.layout)) := by
  rcases hCtx with ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  have hCtxRel : Locals.SourceLowering.CtxRel sourceCtx targetCtx :=
    ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  rcases
      Expr.runCompiledCodeWithOracle_of_evalOne_sourceOwned
        (program := asmProgram) (layout := sourceCtx.scope)
        (ctx := targetCtx) (pc := pc) (state := state)
        (state' := stateAfterValue) (value := value)
        (target := target) (code := code)
        hLayout hNoDup hOwned hAccess hRel hCompile hEvalOne with
    ⟨evm', hRunCode, hExprRel⟩
  have hStateRel :
      Locals.SourceLowering.StateRel (name :: sourceCtx.scope)
        (stateAfterValue.source.insert name value) (target.withEVM evm') :=
    Locals.SourceLowering.ExprResultRel.to_stateRel_cons_insert
      hFresh hExprRel
  have hCtxOut :
      Locals.SourceLowering.CtxRel
        { sourceCtx with scope := name :: sourceCtx.scope }
        (targetCtx.withLayout (name :: targetCtx.layout)) :=
    Locals.SourceLowering.CtxRel.withScopeCons hCtxRel
  refine ⟨evm', ?_, ?_, hRunCode, hStateRel, hCtxOut⟩
  · simp [Locals.Stmt.compile, Locals.codeStmt, hCompile]
  · simp [Stmt.run, hEvalOne]

theorem compileAssignWithOracle_of_evalOne_sourceOwned
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {sourceCtx : Ctx} {targetCtx : Locals.Ctx} {fuel pc : Nat}
    {name : Name} {idx : Nat} {expr : Locals.Expr 1}
    {state stateAfterValue : State} {value : Word}
    {target : Locals.RunState} {code : Structured.Code}
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hName : sourceCtx.scope[idx]? = some name)
    (hBound : idx + 1 ≤ 16)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible sourceCtx.scope 0 expr)
    (hRel :
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompile : Locals.Expr.compileCode targetCtx 0 expr = some code)
    (hEvalOne : Expr.evalOne expr state = .ok (stateAfterValue, value)) :
    ∃ swapOp evm',
      Locals.Stmt.compile targetCtx (.assign name expr) =
        some
          (Locals.codeStmt
            (code ++
              [Structured.BasicInstr.op swapOp,
                Structured.BasicInstr.op .pop]),
            targetCtx) ∧
      Stmt.run program sourceCtx fuel (.assign name expr) state =
        .ok
          (Outcome.regular
            (stateAfterValue.withVars
              (Locals.Source.Store.insert stateAfterValue.vars name value)),
            sourceCtx) ∧
      StructuredReplay.Code.runWithOracle asmProgram pc
          (code ++
            [Structured.BasicInstr.op swapOp,
              Structured.BasicInstr.op .pop])
          target.evm state.trace =
        .ok (evm', stateAfterValue.trace) ∧
      Locals.SourceLowering.StateRel sourceCtx.scope
        (stateAfterValue.source.withVars
          (Locals.Source.Store.insert stateAfterValue.source.vars name value))
        (target.withEVM evm') ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  rcases hCtx with ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  have hCtxRel : Locals.SourceLowering.CtxRel sourceCtx targetCtx :=
    ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  have hContains : state.source.vars.contains name = true :=
    Locals.SourceLowering.StackStoreRel.contains_of_layout hRel.2 hName
  rcases
      Expr.runCompiledCodeWithOracle_of_evalOne_sourceOwned
        (program := asmProgram) (layout := sourceCtx.scope)
        (ctx := targetCtx) (pc := pc) (state := state)
        (state' := stateAfterValue) (value := value)
        (target := target) (code := code)
        hLayout hNoDup hOwned hAccess hRel hCompile hEvalOne with
    ⟨evmAfterValue, hRunValue, hExprRel⟩
  rcases hExprRel with ⟨hShared, baseStack, hStack, hStackRel⟩
  have hStackEVM :
      evmAfterValue.stack = [value] ++ baseStack := by
    simpa [Structured.RunState.withEVM] using hStack
  rcases
      Locals.SourceLowering.StackStoreRel.lookup_value hStackRel hName with
    ⟨old, hOld, _hOldStore⟩
  have hDepth :
      Locals.Layout.lookupDepth? name targetCtx.layout = some (idx + 1) := by
    simpa [hLayout] using
      (Locals.Layout.lookupDepth?_of_get?_nodup hName hNoDup)
  rcases
      Locals.SourceLowering.Assignment.stackOp_swap?_step_eq_swap
        (n := idx + 1) (by omega) hBound evmAfterValue with
    ⟨swapOp, hSwap, hSwapStepEq⟩
  let swappedEVM :=
    evmAfterValue.replaceStackAndIncrPC
      (old :: baseStack.take idx ++ [value] ++ baseStack.drop (idx + 1))
  let finalStack :=
    baseStack.take idx ++ value :: baseStack.drop (idx + 1)
  let finalEVM := swappedEVM.replaceStackAndIncrPC finalStack
  have hSwapRun :
      EvmYul.swap (idx + 1) evmAfterValue = .ok swappedEVM := by
    simpa [swappedEVM] using
      (Locals.SourceLowering.Assignment.evm_swap_assign_get?
        (state := evmAfterValue) (locals := baseStack) (idx := idx)
        (old := old) (value := value) hStackEVM hOld)
  have hSwapStep :
      Structured.BasicOp.step swapOp evmAfterValue = .ok swappedEVM := by
    rw [hSwapStepEq, hSwapRun]
  have hPopStep :
      Structured.BasicOp.step .pop swappedEVM = .ok finalEVM := by
    simp [Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
      Assembly.Target.stepInstr, Assembly.PrimOp.step,
      Assembly.PrimStep.run, Assembly.PrimOp.continuingStep?,
      EvmYul.Stack.pop, swappedEVM, finalEVM, finalStack,
      EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC, List.append_assoc]
  have hSwapObserver : basicOpObserver? swapOp = none :=
    stackOp_swap?_observer_none hSwap
  have hSwapOracle :
      StructuredReplay.Code.runWithOracle asmProgram
          (pc + StructuredReplay.Code.byteLength code)
          [Structured.BasicInstr.op swapOp] evmAfterValue
          stateAfterValue.trace =
        .ok (swappedEVM, stateAfterValue.trace) :=
    StructuredReplay.Code.runWithOracle_singleton_op_nonObserver_of_step
      (program := asmProgram)
      (pc := pc + StructuredReplay.Code.byteLength code)
      (trace := stateAfterValue.trace) hSwapObserver hSwapStep
  have hPopOracle :
      StructuredReplay.Code.runWithOracle asmProgram
          ((pc + StructuredReplay.Code.byteLength code) +
            StructuredReplay.Code.byteLength
              [Structured.BasicInstr.op swapOp])
          [Structured.BasicInstr.op .pop] swappedEVM
          stateAfterValue.trace =
        .ok (finalEVM, stateAfterValue.trace) :=
    StructuredReplay.Code.runWithOracle_singleton_op_nonObserver_of_step
      (program := asmProgram)
      (pc := (pc + StructuredReplay.Code.byteLength code) +
        StructuredReplay.Code.byteLength [Structured.BasicInstr.op swapOp])
      (trace := stateAfterValue.trace) (by rfl) hPopStep
  have hSuffixRun :
      StructuredReplay.Code.runWithOracle asmProgram
          (pc + StructuredReplay.Code.byteLength code)
          [Structured.BasicInstr.op swapOp, Structured.BasicInstr.op .pop]
          evmAfterValue stateAfterValue.trace =
        .ok (finalEVM, stateAfterValue.trace) := by
    change
      StructuredReplay.Code.runWithOracle asmProgram
          (pc + StructuredReplay.Code.byteLength code)
          ([Structured.BasicInstr.op swapOp] ++
            [Structured.BasicInstr.op .pop])
          evmAfterValue stateAfterValue.trace =
        .ok (finalEVM, stateAfterValue.trace)
    rw [StructuredReplay.Code.runWithOracle_append]
    simp [hSwapOracle, hPopOracle]
  have hFullRun :
      StructuredReplay.Code.runWithOracle asmProgram pc
          (code ++
            [Structured.BasicInstr.op swapOp,
              Structured.BasicInstr.op .pop])
          target.evm state.trace =
        .ok (finalEVM, stateAfterValue.trace) := by
    rw [StructuredReplay.Code.runWithOracle_append]
    simp [hRunValue, hSuffixRun]
  have hFinalRel :
      Locals.SourceLowering.StateRel sourceCtx.scope
        (stateAfterValue.source.withVars
          (Locals.Source.Store.insert stateAfterValue.source.vars name value))
        (target.withEVM finalEVM) := by
    constructor
    · simpa [finalEVM, swappedEVM, Locals.Source.State.withVars,
        EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC, Structured.RunState.withEVM] using
        hShared
    · simpa [finalEVM, swappedEVM, finalStack,
        Locals.Source.State.withVars,
        EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC, Structured.RunState.withEVM] using
        (Locals.SourceLowering.StackStoreRel.assign
          hNoDup hName hStackRel)
  refine ⟨swapOp, finalEVM, ?_, ?_, hFullRun, hFinalRel, hCtxRel⟩
  · simp [Locals.Stmt.compile, Locals.codeStmt, hDepth, hCompile, hSwap]
  · simp [Stmt.run, State.vars, hContains, hEvalOne]

theorem compileIfFalseWithOracle_of_evalCondition_sourceOwned
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {exprProgram : Expressions.Program}
    {sourceCtx : Ctx} {targetCtx bodyCtx : Locals.Ctx}
    {fuel pc : Nat} {cond : Locals.Expr 1} {body : Locals.Block}
    {state stateAfterCond : State}
    {target : Locals.RunState} {condCode : Structured.Code}
    {bodyCode : List Expressions.Stmt} {lowerBody : Expressions.Block}
    (hCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDup : sourceCtx.scope.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible sourceCtx.scope 0 cond)
    (hRel :
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompileCond :
      Locals.Expr.compileCode targetCtx 0 cond = some condCode)
    (hCompileBody :
      Locals.Block.compileOpen targetCtx body = some (bodyCode, bodyCtx))
    (hFinishBody :
      Locals.finishScoped targetCtx bodyCtx bodyCode = some lowerBody)
    (hEvalCond :
      Expr.evalCondition cond state = .ok (stateAfterCond, false)) :
    ∃ evmAfterPop,
      Locals.Stmt.compile targetCtx (.if_ cond body) =
        some
          ([Expressions.Stmt.if_
            (Expressions.Expr.code (results := 1) condCode)
            lowerBody],
            targetCtx) ∧
      Stmt.run program sourceCtx (fuel + 1) (.if_ cond body) state =
        .ok (Outcome.regular stateAfterCond, sourceCtx) ∧
      ExpressionsReplay.Stmt.runWithOracle asmProgram pc exprProgram
          (fuel + 1)
          (Expressions.Stmt.if_
            (Expressions.Expr.code (results := 1) condCode)
            lowerBody)
          target state.trace =
        .ok
          (Expressions.Outcome.regular (target.withEVM evmAfterPop),
            stateAfterCond.trace) ∧
      Locals.SourceLowering.StateRel sourceCtx.scope stateAfterCond.source
        (target.withEVM evmAfterPop) ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  rcases hCtx with ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  have hCtxRel : Locals.SourceLowering.CtxRel sourceCtx targetCtx :=
    ⟨hLayout, hBreak, hContinue, hLeave, hRetc⟩
  rcases
      Expr.runCompiledExpressionsConditionWithOracle_of_evalCondition_sourceOwned
        (program := asmProgram) (expr := cond)
        (layout := sourceCtx.scope) (ctx := targetCtx)
        (pc := pc) (state := state) (state' := stateAfterCond)
        (cond := false) (target := target) (code := condCode)
        hLayout hNoDup hOwned hAccess hRel hCompileCond hEvalCond with
    ⟨evmAfterPop, value, hCompileCondExpr, hEvalOne,
      hCondReplay, hStateRel⟩
  refine ⟨evmAfterPop, ?_, ?_, ?_, hStateRel, hCtxRel⟩
  · simp [Locals.Stmt.compile, hCompileCondExpr, hCompileBody,
      hFinishBody]
  · simp [Stmt.run, hEvalCond]
  · exact
      ExpressionsReplay.Stmt.runWithOracle_if_false_of_condition
        (asmProgram := asmProgram) (pc := pc) (fuel := fuel)
        (program := exprProgram)
        (cond := Expressions.Expr.code (results := 1) condCode)
        (body := lowerBody) hCondReplay

theorem compileIfTrueWithOracle_of_evalCondition_sourceOwned
    {asmProgram : Assembly.Program} {program : Locals.Program}
