      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.jump label) 0
  have hStepOracle :
      Assembly.Source.stepResultWithOracle
          (pre ++ [Assembly.Instr.jump label] ++ post) target trace =
        .ok (.running target', trace) :=
    Assembly.Source.stepResultWithOracle_of_stepResult_observer_none
      hStep (by
        intro pc instr hAt
        rw [hAtJump] at hAt
        cases hAt
        rfl)
  have hStepOracle' :
      Assembly.Source.stepResultWithOracle
          (pre ++
            (Structured.Stmt.compileFromCtxCore .brk ctx supply).code ++
            post) target trace =
