                      | error err =>
                          rw [hRestRun] at hRun
                          simp [sourceCtxAfter] at hRun
                      | ok restRunResult =>
                          rcases restRunResult with
                            ⟨restOutcome, restSourceCtxOut⟩
                          rw [hRestRun] at hRun
                          simp [sourceCtxAfter, Outcome.regular] at hRun
                          rcases hRun with ⟨hOpenState, hSourceCtxOut⟩
                          cases restOutcome with
                          | mk restState restMode =>
                              cases restMode <;> simp [Outcome.regular] at hOpenState
                              cases hOpenState
                              cases hSourceCtxOut
                              have hCtxAfter :
                                  Locals.SourceLowering.CtxRel sourceCtxAfter
                                    targetCtxAfter := by
                                exact
                                  Locals.SourceLowering.CtxRel.withScopeCons
                                    hCtx
                              have hNoDupAfter :
                                  sourceCtxAfter.scope.Nodup := by
                                simp [sourceCtxAfter, hFresh, hNoDup]
                              rcases
                                  Stmt.compileLetWithOracle_of_evalOne_sourceOwned
                                    (asmProgram := asmProgram)
                                    (program := program)
                                    (sourceCtx := sourceCtx)
                                    (targetCtx := targetCtx)
                                    (fuel := fuel + 1) (pc := pc)
                                    (name := name) (expr := expr)
                                    (state := state)
                                    (stateAfterValue := stateAfterValue)
                                    (value := value) (target := target)
                                    (code := headCode)
                                    hCtx hNoDup hOwned hAccess hFresh hRel
                                    hHeadCode hEvalOne with
                                ⟨evmAfterHead, _hCompileStmt, _hStmtRun,
                                  hRunCode, hHeadRel, _hCtxHead⟩
                              have hHeadRelState :
                                  Locals.SourceLowering.StateRel
                                    (name :: sourceCtx.scope)
                                    (stateAfterValue.insert name value).source
                                    (target.withEVM evmAfterHead) := by
                                simpa [State.insert] using hHeadRel
                              have hStmtReplay :
                                  ExpressionsReplay.Stmt.runWithOracle
                                      asmProgram pc exprProgram (fuel + 1)
                                      (Expressions.Stmt.code headCode)
                                      target state.trace =
                                    .ok
                                      (Expressions.Outcome.regular
                                        (target.withEVM evmAfterHead),
                                        (stateAfterValue.insert name value).trace) := by
                                simpa [State.insert] using
