        ⟨hEval, _hTrace⟩
      dsimp [Locals.Source.PrimitiveSemantics.structured] at hEval
      by_cases hLen :
          values.length = Expressions.Structured.BasicOp.inputs op
      · cases hCont :
          Locals.Source.PrimitiveSemantics.sourceContinuingStep? op with
        | none =>
            simp [hLen, hCont] at hEval
        | some step =>
            exact
              oracleStepPC_singleton_op_of_sourceContinuingStep
                hCont
      · simp [hLen] at hEval
  | some _kind =>
      cases op <;> simp [basicOpObserver?] at hObserver
      all_goals
        first
        | exact oracleStepPC_singleton_msize
        | exact oracleStepPC_singleton_gas

theorem runWithOracle_replicate_pop_exists
    (program : Assembly.Program) :
    ∀ (pc : Nat) (state : EVMState) (trace : Trace) (n : Nat),
      n ≤ state.stack.length →
        ∃ final,
          runWithOracle program pc
              (List.replicate n (Structured.BasicInstr.op .pop))
              state trace =
            .ok (final, trace) ∧
          final.stack = state.stack.drop n ∧
          final.toSharedState = state.toSharedState := by
  intro pc state trace n
  induction n generalizing pc state trace with
  | zero =>
      intro _hLen
      refine ⟨state, ?_, ?_, rfl⟩
      · simp [runWithOracle]
      · simp
  | succ n ih =>
      intro hLen
      cases state with
      | mk shared pcState stack execLength =>
          cases stack with
          | nil =>
              simp at hLen
          | cons top rest =>
              have hTailLen : n ≤ rest.length := by
                simpa using Nat.succ_le_succ_iff.mp hLen
              let state0 : EVMState :=
                { toSharedState := shared, pc := pcState,
                  stack := top :: rest, execLength := execLength }
              let stepState : EVMState :=
                state0.replaceStackAndIncrPC rest
              have hStep :
                  Structured.BasicOp.step .pop state0 =
                    .ok stepState := by
                subst stepState
                simp [state0, Structured.BasicOp.step,
                  Structured.BasicOp.toPrimOp, Assembly.Target.stepInstr,
                  Assembly.PrimOp.step, Assembly.PrimStep.run,
                  Assembly.PrimOp.continuingStep?, EvmYul.Stack.pop]
              have hObserver : basicOpObserver? .pop = none := by
                simp [basicOpObserver?]
              have hStepOracle :
                  StructuredReplay.BasicInstr.stepWithOracle program pc
                      (Structured.BasicInstr.op .pop) state0 trace =
                    .ok (stepState, trace) :=
                StructuredReplay.BasicInstr.stepWithOracle_op_nonObserver_of_step
                  (program := program) (pc := pc) (trace := trace)
                  hObserver hStep
              rcases
                  ih
                    (pc + (Structured.BasicInstr.op .pop).toAssembly.byteSize)
                    stepState trace hTailLen with
                ⟨final, hRun, hFinalStack, hFinalShared⟩
              refine ⟨final, ?_, ?_, ?_⟩
              · simpa [runWithOracle, List.replicate_succ, state0,
                  hStepOracle] using hRun
              · simpa [state0, stepState] using hFinalStack
              · simpa [state0, stepState] using hFinalShared

