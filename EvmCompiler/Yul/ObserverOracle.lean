                      stackOp_dup?_observer_none hDup
                    refine ⟨evm', ?_, ?_⟩
                    · exact
                        StructuredReplay.Code.runWithOracle_singleton_op_nonObserver_of_step
                          (program := program) (pc := pc)
                          (trace := state.trace)
                          hObserver hStep
                    · constructor
                      · simpa [evm',
                          EvmYul.EVM.State.replaceStackAndIncrPC,
                          EvmYul.EVM.State.incrPC] using hShared
                      · refine ⟨baseStack, ?_, hStackRel⟩
                        simp [evm', hStack,
                          EvmYul.EVM.State.replaceStackAndIncrPC,
                          EvmYul.EVM.State.incrPC]
    | code _code =>
        simp [Locals.Source.Expr.SourceOwned] at hOwned
    | prim op args =>
        simp [Locals.Expr.compileCode] at hCompile
        cases hArgsCode :
            Locals.ExprSeq.compileCode ctx offset args with
        | none =>
            simp [hArgsCode] at hCompile
        | some argsCode =>
            simp [hArgsCode] at hCompile
            cases hCompile
            simp [Expr.eval] at hEval
            cases hArgs : Expr.ExprSeq.eval args state with
            | error err =>
                simp [hArgs] at hEval
            | ok argsResult =>
                rcases argsResult with ⟨stateAfterArgs, argValues⟩
                simp [hArgs] at hEval
                cases hReplay :
                    replayPrimitiveSemantics.eval op stateAfterArgs.shared
                      argValues stateAfterArgs.trace with
                | error err =>
                    simp [hReplay] at hEval
                | ok replayResult =>
                    rcases replayResult with
                      ⟨shared', values', trace'⟩
                    simp [hReplay] at hEval
                    rcases hEval with ⟨hState, hValues⟩
                    cases hState
                    cases hValues
                    rcases
                        runCompiledSeqCodeWithOracle_of_eval_sourceOwned
                          (program := program)
                          (layout := layout) (ctx := ctx)
                          (offset := offset) (pc := pc)
                          (state := state) (state' := stateAfterArgs)
                          (values := argValues) (evm := evm)
                          (stackPrefix := stackPrefix)
                          (code := argsCode)
                          hCtxLayout hNoDup hOwned hAccess hPrefixLen
                          hRel hArgsCode hArgs with
                      ⟨evmAfterArgs, hRunArgs, hArgsRel⟩
                    rcases hArgsRel with
                      ⟨hArgsShared, baseStack, hArgsStack,
                        hArgsStackRel⟩
                    rcases
                        StructuredReplay.Code.runWithOracle_singleton_op_of_replay
                          (program := program)
                          (pc := pc +
                            StructuredReplay.Code.byteLength argsCode)
                          (baseStack := stackPrefix ++ baseStack)
                          hReplay hArgsShared
                          (by
                            rw [hArgsStack]
                            simp [List.append_assoc]) with
                      ⟨evmAfterPrim, hRunPrim, hPrimShared,
                        hPrimStack⟩
                    refine ⟨evmAfterPrim, ?_, ?_⟩
                    · rw [StructuredReplay.Code.runWithOracle_append]
                      simp [hRunArgs, hRunPrim]
                    · constructor
                      · simpa [State.withShared, State.withTrace,
                          State.withSource,
                          Locals.Source.State.withShared] using hPrimShared
                      · refine ⟨baseStack, ?_, ?_⟩
                        · rw [hPrimStack]
                          simp [List.append_assoc]
                        · simpa [State.withShared, State.withTrace,
                            State.withSource,
                            Locals.Source.State.withShared]
                            using hArgsStackRel

  theorem runCompiledSeqCodeWithOracle_of_eval_sourceOwned
      {program : Assembly.Program} :
      ∀ {results : Nat} {exprs : Locals.ExprSeq results}
        {layout : List Name} {ctx : Locals.Ctx} {offset pc : Nat}
        {state state' : State} {values : List Word}
        {evm : EVMState} {stackPrefix : List Word}
        {code : Structured.Code},
        ctx.layout = layout →
        layout.Nodup →
        Locals.Source.ExprSeq.SourceOwned exprs →
        Locals.SourceLowering.ExprSeq.Accessible layout offset exprs →
        stackPrefix.length = offset →
        Locals.SourceLowering.StackPrefixRel layout state.source
          stackPrefix evm →
        Locals.ExprSeq.compileCode ctx offset exprs = some code →
        Expr.ExprSeq.eval exprs state = .ok (state', values) →
          ∃ evm',
            StructuredReplay.Code.runWithOracle program pc code evm
                state.trace =
              .ok (evm', state'.trace) ∧
            Locals.SourceLowering.StackPrefixRel layout state'.source
              (values.reverse ++ stackPrefix) evm' := by
    intro results exprs layout ctx offset pc state state' values evm
      stackPrefix code hCtxLayout hNoDup hOwned hAccess hPrefixLen hRel
      hCompile hEval
    cases exprs with
    | nil =>
        simp [Locals.ExprSeq.compileCode] at hCompile
        cases hCompile
        simp [Expr.ExprSeq.eval] at hEval
        rcases hEval with ⟨hState, hValues⟩
        cases hState
        cases hValues
        refine ⟨evm, ?_, ?_⟩
        · simp [StructuredReplay.Code.runWithOracle]
        · simpa using hRel
    | @cons left right head tail =>
        simp [Locals.Source.ExprSeq.SourceOwned] at hOwned
        rcases hOwned with ⟨hHeadOwned, hTailOwned⟩
        simp [Locals.SourceLowering.ExprSeq.Accessible] at hAccess
        rcases hAccess with ⟨hHeadAccess, hTailAccess⟩
        simp [Locals.ExprSeq.compileCode] at hCompile
        cases hHeadCode :
            Locals.Expr.compileCode ctx offset head with
        | none =>
            simp [hHeadCode] at hCompile
        | some headCode =>
            cases hTailCode :
                Locals.ExprSeq.compileCode ctx (offset + left) tail with
            | none =>
                simp [hHeadCode, hTailCode] at hCompile
            | some tailCode =>
                simp [hHeadCode, hTailCode] at hCompile
                cases hCompile
                simp [Expr.ExprSeq.eval] at hEval
                cases hHead : Expr.eval head state with
                | error err =>
                    simp [hHead] at hEval
                | ok headResult =>
                    rcases headResult with
                      ⟨stateAfterHead, headValues⟩
                    simp [hHead] at hEval
                    cases hTail :
                        Expr.ExprSeq.eval tail stateAfterHead with
                    | error err =>
                        simp [hTail] at hEval
                    | ok tailResult =>
                        rcases tailResult with
                          ⟨stateAfterTail, tailValues⟩
                        simp [hTail] at hEval
                        rcases hEval with ⟨hState, hValues⟩
                        rcases
                            runCompiledCodeWithOracle_of_eval_sourceOwned
                              (program := program)
                              (layout := layout) (ctx := ctx)
                              (offset := offset) (pc := pc)
                              (state := state)
                              (state' := stateAfterHead)
                              (values := headValues) (evm := evm)
                              (stackPrefix := stackPrefix)
                              (code := headCode)
                              hCtxLayout hNoDup hHeadOwned hHeadAccess
                              hPrefixLen hRel hHeadCode hHead with
                          ⟨evmAfterHead, hRunHead, hHeadRel⟩
                        have hHeadLen : headValues.length = left :=
                          Expr.eval_length hHead
                        have hNextPrefixLen :
                            (headValues.reverse ++ stackPrefix).length =
                              offset + left := by
                          simp [List.length_reverse, hHeadLen, hPrefixLen]
                          omega
                        rcases
                            runCompiledSeqCodeWithOracle_of_eval_sourceOwned
                              (program := program)
                              (layout := layout) (ctx := ctx)
                              (offset := offset + left)
                              (pc := pc +
                                StructuredReplay.Code.byteLength headCode)
                              (state := stateAfterHead)
                              (state' := stateAfterTail)
                              (values := tailValues)
                              (evm := evmAfterHead)
                              (stackPrefix :=
                                headValues.reverse ++ stackPrefix)
                              (code := tailCode)
                              hCtxLayout hNoDup hTailOwned hTailAccess
                              hNextPrefixLen hHeadRel hTailCode hTail with
                          ⟨evmAfterTail, hRunTail, hTailRel⟩
                        cases hState
                        cases hValues
                        refine ⟨evmAfterTail, ?_, ?_⟩
                        · rw [StructuredReplay.Code.runWithOracle_append]
                          simp [hRunHead, hRunTail]
                        · simpa [List.reverse_append, List.append_assoc]
                            using hTailRel
end

theorem eval_of_evalOne {results : Nat} {expr : Locals.Expr results}
    {state state' : State} {value : Word}
    (hOne : evalOne expr state = .ok (state', value)) :
    eval expr state = .ok (state', [value]) := by
  unfold evalOne at hOne
  cases hEval : eval expr state with
  | error err =>
      simp [hEval] at hOne
  | ok result =>
      rcases result with ⟨stateAfterExpr, values⟩
      simp [hEval] at hOne
      cases values with
      | nil =>
          simp [invalid, Structured.invalid] at hOne
      | cons head tail =>
          cases tail with
          | nil =>
              simp at hOne
              rcases hOne with ⟨hState, hValue⟩
              cases hState
              cases hValue
              rfl
          | cons second rest =>
              simp [invalid, Structured.invalid] at hOne

theorem runCompiledCodeWithOracle_of_evalOne_sourceOwned
    {program : Assembly.Program}
    {expr : Locals.Expr 1} {layout : List Name} {ctx : Locals.Ctx}
    {pc : Nat} {state state' : State} {value : Word}
    {target : Locals.RunState} {code : Structured.Code}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel :
      Locals.SourceLowering.StateRel layout state.source target)
    (hCompile : Locals.Expr.compileCode ctx 0 expr = some code)
    (hEvalOne : evalOne expr state = .ok (state', value)) :
    ∃ evm',
      StructuredReplay.Code.runWithOracle program pc code target.evm
          state.trace =
        .ok (evm', state'.trace) ∧
      Locals.SourceLowering.ExprResultRel layout state'.source [value]
        (target.withEVM evm') := by
  have hEval := eval_of_evalOne hEvalOne
  rcases
      runCompiledCodeWithOracle_of_eval_sourceOwned
        (program := program) (layout := layout) (ctx := ctx)
        (offset := 0) (pc := pc) (state := state)
        (state' := state') (values := [value]) (evm := target.evm)
        (stackPrefix := []) (code := code)
        hCtxLayout hNoDup hOwned hAccess rfl
        (Locals.SourceLowering.StackPrefixRel.of_stateRel hRel)
        hCompile hEval with
    ⟨evm', hRun, hPrefixRel⟩
  rcases hPrefixRel with ⟨hShared, baseStack, hStack, hStackRel⟩
  refine ⟨evm', hRun, ?_⟩
  exact
    ⟨by simpa [Structured.RunState.withEVM] using hShared,
      baseStack,
      by simpa [Structured.RunState.withEVM] using hStack,
      hStackRel⟩

theorem runCompiledConditionWithOracle_of_evalCondition_sourceOwned
    {program : Assembly.Program}
    {expr : Locals.Expr 1} {layout : List Name} {ctx : Locals.Ctx}
    {pc : Nat} {state state' : State} {cond : Bool}
    {target : Locals.RunState} {code : Structured.Code}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel :
      Locals.SourceLowering.StateRel layout state.source target)
    (hCompile : Locals.Expr.compileCode ctx 0 expr = some code)
    (hEvalCond : evalCondition expr state = .ok (state', cond)) :
    ∃ evmAfterExpr evmAfterPop value,
      evalOne expr state = .ok (state', value) ∧
      StructuredReplay.Code.runWithOracle program pc code target.evm
          state.trace =
        .ok (evmAfterExpr, state'.trace) ∧
      Structured.Code.popCondition evmAfterExpr =
        .ok (evmAfterPop, cond) ∧
      Locals.SourceLowering.StateRel layout state'.source
        (target.withEVM evmAfterPop) := by
  unfold evalCondition at hEvalCond
  cases hEvalOne : evalOne expr state with
  | error err =>
      simp [hEvalOne] at hEvalCond
  | ok oneResult =>
      rcases oneResult with ⟨stateAfterExpr, value⟩
      simp [hEvalOne] at hEvalCond
      rcases hEvalCond with ⟨hState, hCond⟩
      cases hState
      cases hCond
      rcases
          runCompiledCodeWithOracle_of_evalOne_sourceOwned
            (program := program) (layout := layout) (ctx := ctx)
            (pc := pc) (state := state) (state' := state')
            (value := value) (target := target) (code := code)
            hCtxLayout hNoDup hOwned hAccess hRel hCompile hEvalOne with
        ⟨evmAfterExpr, hRun, hExprRel⟩
      rcases hExprRel with
        ⟨hShared, baseStack, hStack, hStackRel⟩
      have hStackEVM : evmAfterExpr.stack = [value] ++ baseStack := by
        simpa [Structured.RunState.withEVM] using hStack
      let evmAfterPop : EVMState := { evmAfterExpr with stack := baseStack }
      refine ⟨evmAfterExpr, evmAfterPop, value, rfl, hRun, ?_, ?_⟩
      · simp [Structured.Code.popCondition, hStackEVM, EvmYul.Stack.pop,
          evmAfterPop]
      · exact
          ⟨by simpa [evmAfterPop, Structured.RunState.withEVM] using hShared,
            by simpa [evmAfterPop, Structured.RunState.withEVM]
              using hStackRel⟩

theorem runCompiledExpressionsConditionWithOracle_of_evalCondition_sourceOwned
    {program : Assembly.Program}
    {expr : Locals.Expr 1} {layout : List Name} {ctx : Locals.Ctx}
    {pc : Nat} {state state' : State} {cond : Bool}
    {target : Locals.RunState} {code : Structured.Code}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel :
      Locals.SourceLowering.StateRel layout state.source target)
    (hCompile : Locals.Expr.compileCode ctx 0 expr = some code)
    (hEvalCond : evalCondition expr state = .ok (state', cond)) :
    ∃ evmAfterPop value,
      Locals.Expr.compile ctx expr =
        some (Expressions.Expr.code (results := 1) code) ∧
      evalOne expr state = .ok (state', value) ∧
      ExpressionsReplay.Expr.runCodeConditionWithOracle program pc
          (Expressions.Expr.code (results := 1) code) target state.trace =
        .ok (target.withEVM evmAfterPop, cond, state'.trace) ∧
      Locals.SourceLowering.StateRel layout state'.source
        (target.withEVM evmAfterPop) := by
  rcases
      runCompiledConditionWithOracle_of_evalCondition_sourceOwned
        (program := program) (expr := expr) (layout := layout)
        (ctx := ctx) (pc := pc) (state := state) (state' := state')
        (cond := cond) (target := target) (code := code)
        hCtxLayout hNoDup hOwned hAccess hRel hCompile hEvalCond with
    ⟨evmAfterExpr, evmAfterPop, value, hEvalOne, hRun, hPop, hStateRel⟩
  refine
    ⟨evmAfterPop, value, ?_, hEvalOne, ?_, hStateRel⟩
  · simp [Locals.Expr.compile, hCompile]
  · exact
      ExpressionsReplay.Expr.runCodeConditionWithOracle_code_of_run
        hRun hPop

end Expr

namespace Switch

theorem compile_select_none
    {ctx : Locals.Ctx} {value : Word}
    {cases : List (Word × Locals.Block)}
    {defaultBody : Option Locals.Block}
    {lowerCases : List (Word × Expressions.Block)}
    {lowerDefault : Option Expressions.Block}
    (hCases :
      Locals.CaseList.compile ctx cases = some lowerCases)
    (hDefault :
      Locals.Default.compile ctx defaultBody = some lowerDefault)
    (hSelect :
      Locals.Source.Switch.select value cases defaultBody = none) :
    Expressions.Switch.select value lowerCases lowerDefault = none := by
  induction cases generalizing lowerCases with
  | nil =>
      simp [Locals.CaseList.compile] at hCases
      cases hCases
      cases defaultBody with
      | none =>
          simp [Locals.Source.Switch.select,
            Expressions.Switch.select, Locals.Default.compile] at hDefault hSelect ⊢
          cases hDefault
          rfl
      | some body =>
          simp [Locals.Source.Switch.select] at hSelect
  | cons head rest ih =>
      rcases head with ⟨caseValue, caseBody⟩
      cases hBodyCompile :
          Locals.Block.compileOpen ctx caseBody with
      | none =>
          simp [Locals.CaseList.compile, hBodyCompile] at hCases
      | some bodyResult =>
          rcases bodyResult with ⟨bodyCode, bodyCtx⟩
          cases hFinish :
              Locals.finishScoped ctx bodyCtx bodyCode with
          | none =>
              simp [Locals.CaseList.compile, hBodyCompile, hFinish] at hCases
          | some lowerBody =>
              cases hRestCompile :
                  Locals.CaseList.compile ctx rest with
              | none =>
                  simp [Locals.CaseList.compile, hBodyCompile, hFinish,
                    hRestCompile] at hCases
              | some lowerRest =>
                  simp [Locals.CaseList.compile, hBodyCompile, hFinish,
                    hRestCompile] at hCases
                  cases hCases
                  by_cases hMatch : caseValue = value
                  · simp [Locals.Source.Switch.select, hMatch] at hSelect
                  · simp [Locals.Source.Switch.select, hMatch] at hSelect
                    have hRestSelect :
                        Expressions.Switch.select value lowerRest lowerDefault =
                          none :=
                      ih hRestCompile hSelect
                    simp [Expressions.Switch.select, hMatch, hRestSelect]

theorem compile_select_some
    {ctx : Locals.Ctx} {value : Word}
    {cases : List (Word × Locals.Block)}
    {defaultBody : Option Locals.Block}
    {selected : Locals.Block}
    {selectedCode : List Expressions.Stmt} {selectedCtx : Locals.Ctx}
    {lowerCases : List (Word × Expressions.Block)}
    {lowerDefault : Option Expressions.Block}
    {lowerSelected : Expressions.Block}
    (hCases :
      Locals.CaseList.compile ctx cases = some lowerCases)
    (hDefault :
      Locals.Default.compile ctx defaultBody = some lowerDefault)
    (hSelectedCompile :
      Locals.Block.compileOpen ctx selected =
        some (selectedCode, selectedCtx))
    (hSelectedFinish :
      Locals.finishScoped ctx selectedCtx selectedCode =
        some lowerSelected)
    (hSelect :
      Locals.Source.Switch.select value cases defaultBody = some selected) :
    Expressions.Switch.select value lowerCases lowerDefault =
      some lowerSelected := by
  induction cases generalizing lowerCases with
  | nil =>
      simp [Locals.CaseList.compile] at hCases
      cases hCases
      cases defaultBody with
      | none =>
          simp [Locals.Source.Switch.select] at hSelect
      | some body =>
          simp [Locals.Source.Switch.select] at hSelect
          cases hSelect
          unfold Locals.Default.compile at hDefault
          simp [hSelectedCompile, hSelectedFinish] at hDefault
          cases hDefault
          simp [Expressions.Switch.select]
  | cons head rest ih =>
      rcases head with ⟨caseValue, caseBody⟩
      cases hBodyCompile :
          Locals.Block.compileOpen ctx caseBody with
      | none =>
          simp [Locals.CaseList.compile, hBodyCompile] at hCases
      | some bodyResult =>
          rcases bodyResult with ⟨bodyCode, bodyCtx⟩
          cases hFinish :
              Locals.finishScoped ctx bodyCtx bodyCode with
          | none =>
              simp [Locals.CaseList.compile, hBodyCompile, hFinish] at hCases
          | some lowerBody =>
              cases hRestCompile :
                  Locals.CaseList.compile ctx rest with
              | none =>
                  simp [Locals.CaseList.compile, hBodyCompile, hFinish,
                    hRestCompile] at hCases
              | some lowerRest =>
                  simp [Locals.CaseList.compile, hBodyCompile, hFinish,
                    hRestCompile] at hCases
                  cases hCases
                  by_cases hMatch : caseValue = value
                  · simp [Locals.Source.Switch.select, hMatch] at hSelect
                    cases hSelect
                    have hSelectedCompileEq :
                        bodyCode = selectedCode ∧ bodyCtx = selectedCtx := by
                      simp [hBodyCompile] at hSelectedCompile
                      exact hSelectedCompile
                    rcases hSelectedCompileEq with
                      ⟨hSelectedCode, hSelectedCtx⟩
                    subst selectedCode
                    subst selectedCtx
                    simp [hFinish] at hSelectedFinish
                    cases hSelectedFinish
                    simp [Expressions.Switch.select, hMatch]
                  · simp [Locals.Source.Switch.select, hMatch] at hSelect
                    have hRestSelect :
                        Expressions.Switch.select value lowerRest lowerDefault =
                          some lowerSelected :=
                      ih hRestCompile hSelect
                    simp [Expressions.Switch.select, hMatch, hRestSelect]

theorem compile_selected_open_finish
    {ctx : Locals.Ctx} {value : Word}
    {cases : List (Word × Locals.Block)}
    {defaultBody : Option Locals.Block}
    {selected : Locals.Block}
    {lowerCases : List (Word × Expressions.Block)}
    {lowerDefault : Option Expressions.Block}
    (hCases :
      Locals.CaseList.compile ctx cases = some lowerCases)
    (hDefault :
      Locals.Default.compile ctx defaultBody = some lowerDefault)
    (hSelect :
      Locals.Source.Switch.select value cases defaultBody = some selected) :
    ∃ selectedCode selectedCtx lowerSelected,
      Locals.Block.compileOpen ctx selected =
        some (selectedCode, selectedCtx) ∧
      Locals.finishScoped ctx selectedCtx selectedCode =
        some lowerSelected ∧
      Expressions.Switch.select value lowerCases lowerDefault =
        some lowerSelected := by
  induction cases generalizing lowerCases with
  | nil =>
      simp [Locals.CaseList.compile] at hCases
      cases hCases
      cases defaultBody with
      | none =>
          simp [Locals.Source.Switch.select] at hSelect
      | some defaultBody =>
          have hSelected : defaultBody = selected := by
            simpa [Locals.Source.Switch.select] using hSelect
          subst selected
          unfold Locals.Default.compile at hDefault
          cases hOpen :
              Locals.Block.compileOpen ctx defaultBody with
          | none =>
              simp [hOpen] at hDefault
          | some compiled =>
              rcases compiled with ⟨selectedCode, selectedCtx⟩
              cases hFinish :
                  Locals.finishScoped ctx selectedCtx selectedCode with
              | none =>
                  simp [hOpen, hFinish] at hDefault
              | some lowerSelected =>
                  simp [hOpen, hFinish] at hDefault
                  cases hDefault
                  refine
                    ⟨selectedCode, selectedCtx, lowerSelected,
                      by simpa [hOpen],
                      by simpa [hFinish], ?_⟩
                  simp [Expressions.Switch.select]
  | cons head rest ih =>
      rcases head with ⟨caseValue, caseBody⟩
      cases hBodyCompile :
          Locals.Block.compileOpen ctx caseBody with
      | none =>
          simp [Locals.CaseList.compile, hBodyCompile] at hCases
      | some bodyResult =>
          rcases bodyResult with ⟨bodyCode, bodyCtx⟩
          cases hFinish :
              Locals.finishScoped ctx bodyCtx bodyCode with
          | none =>
              simp [Locals.CaseList.compile, hBodyCompile, hFinish]
                at hCases
          | some lowerBody =>
              cases hRestCompile :
                  Locals.CaseList.compile ctx rest with
              | none =>
                  simp [Locals.CaseList.compile, hBodyCompile, hFinish,
                    hRestCompile] at hCases
              | some lowerRest =>
                  simp [Locals.CaseList.compile, hBodyCompile, hFinish,
                    hRestCompile] at hCases
                  cases hCases
                  by_cases hMatch : caseValue = value
                  · simp [Locals.Source.Switch.select, hMatch] at hSelect
                    cases hSelect
                    refine
                      ⟨bodyCode, bodyCtx, lowerBody,
                        by simpa [hBodyCompile],
                        by simpa [hFinish], ?_⟩
                    simp [Expressions.Switch.select, hMatch]
                  · simp [Locals.Source.Switch.select, hMatch] at hSelect
                    rcases ih hRestCompile hSelect with
                      ⟨selectedCode, selectedCtx, lowerSelected,
                        hSelectedCompile, hSelectedFinish,
                        hSelectedSwitch⟩
                    refine
                      ⟨selectedCode, selectedCtx, lowerSelected,
                        hSelectedCompile, hSelectedFinish, ?_⟩
                    simp [Expressions.Switch.select, hMatch,
                      hSelectedSwitch]

end Switch

mutual
  theorem Expr.eval_observerFree_matches_source {results : Nat}
      {expr : Locals.Expr results} {state state' : State}
      {values : List Word}
      (hFree : ExprObserverFree expr)
      (hEval : Expr.eval expr state = .ok (state', values)) :
      Locals.Source.Expr.eval Locals.Source.PrimitiveSemantics.structured
          expr state.source =
        .ok (state'.source, values) ∧
      state'.trace = state.trace := by
    cases expr with
    | lit value =>
        simp [Expr.eval] at hEval
        rcases hEval with ⟨hState, hValues⟩
        cases hState
        cases hValues
        exact ⟨rfl, rfl⟩
    | var name =>
        simp [Expr.eval] at hEval
        cases hVar : state.source.vars name with
        | none =>
            simp [State.vars, hVar, invalid, Structured.invalid] at hEval
        | some value =>
            simp [State.vars, hVar] at hEval
            rcases hEval with ⟨hState, hValues⟩
            cases hState
            cases hValues
            exact ⟨by simp [Locals.Source.Expr.eval, hVar], rfl⟩
    | code code =>
        cases hFree
    | prim op args =>
        rcases hFree with ⟨hObserver, hArgsFree⟩
        simp [Expr.eval] at hEval
        cases hArgs : Expr.ExprSeq.eval args state with
        | error err =>
            simp [hArgs] at hEval
        | ok argsResult =>
            rcases argsResult with ⟨stateAfterArgs, argValues⟩
            simp [hArgs] at hEval
            cases hReplay :
                replayPrimitiveSemantics.eval op stateAfterArgs.shared
                  argValues stateAfterArgs.trace with
            | error err =>
                simp [hReplay] at hEval
            | ok replayResult =>
                rcases replayResult with ⟨shared', values', trace'⟩
                simp [hReplay] at hEval
                rcases hEval with ⟨hState, hValues⟩
                cases hState
                have hArgsSource :=
                  ExprSeq.eval_observerFree_matches_source
                    hArgsFree hArgs
                rcases hArgsSource with ⟨hArgsOrdinary, hArgsTrace⟩
                have hReplayOrdinary :=
                  replay_eval_nonObserver_preserves_trace
                    (op := op) (shared := stateAfterArgs.shared)
                    (shared' := shared') (values := argValues)
                    (values' := values') (trace := stateAfterArgs.trace)
                    (trace' := trace') hObserver hReplay
                rcases hReplayOrdinary with ⟨hPrim, hTrace⟩
                change
                  Locals.Source.PrimitiveSemantics.structured.eval op
                      stateAfterArgs.source.shared argValues =
                    .ok (shared', values') at hPrim
                constructor
                · simp [Locals.Source.Expr.eval, hArgsOrdinary, hPrim,
                    hValues, State.withShared, State.withTrace,
                    State.withSource]
                · simp [State.withShared, State.withTrace, State.withSource,
                    hTrace, hArgsTrace]

  theorem ExprSeq.eval_observerFree_matches_source {results : Nat}
      {exprs : Locals.ExprSeq results} {state state' : State}
      {values : List Word}
      (hFree : ExprSeqObserverFree exprs)
      (hEval : Expr.ExprSeq.eval exprs state = .ok (state', values)) :
      Locals.Source.Expr.ExprSeq.eval
          Locals.Source.PrimitiveSemantics.structured exprs state.source =
        .ok (state'.source, values) ∧
      state'.trace = state.trace := by
    cases exprs with
    | nil =>
        simp [Expr.ExprSeq.eval] at hEval
        rcases hEval with ⟨hState, hValues⟩
        cases hState
        cases hValues
        exact ⟨rfl, rfl⟩
    | cons head tail =>
        rcases hFree with ⟨hHeadFree, hTailFree⟩
        simp [Expr.ExprSeq.eval] at hEval
        cases hHead : Expr.eval head state with
        | error err =>
            simp [hHead] at hEval
        | ok headResult =>
            rcases headResult with ⟨stateAfterHead, headValues⟩
            simp [hHead] at hEval
            cases hTail : Expr.ExprSeq.eval tail stateAfterHead with
            | error err =>
                simp [hTail] at hEval
            | ok tailResult =>
                rcases tailResult with ⟨stateAfterTail, tailValues⟩
                simp [hTail] at hEval
                rcases hEval with ⟨hState, hValues⟩
                cases hState
                cases hValues
                have hHeadSource :=
                  Expr.eval_observerFree_matches_source
                    hHeadFree hHead
                rcases hHeadSource with ⟨hHeadOrdinary, hHeadTrace⟩
                have hTailSource :=
                  ExprSeq.eval_observerFree_matches_source
                    hTailFree hTail
                rcases hTailSource with ⟨hTailOrdinary, hTailTrace⟩
                constructor
                · simp [Locals.Source.Expr.ExprSeq.eval, hHeadOrdinary,
                    hTailOrdinary]
                · exact hTailTrace.trans hHeadTrace
end

theorem Expr.evalOne_observerFree_matches_source {results : Nat}
    {expr : Locals.Expr results} {state state' : State} {value : Word}
    (hFree : ExprObserverFree expr)
    (hEval : Expr.evalOne expr state = .ok (state', value)) :
    Locals.Source.Expr.evalOne Locals.Source.PrimitiveSemantics.structured
        expr state.source =
      .ok (state'.source, value) ∧
    state'.trace = state.trace := by
  unfold Expr.evalOne at hEval
  cases hExpr : Expr.eval expr state with
  | error err =>
      simp [hExpr] at hEval
  | ok exprResult =>
      rcases exprResult with ⟨stateAfterExpr, values⟩
      simp [hExpr] at hEval
      cases values with
      | nil =>
          simp [invalid, Structured.invalid] at hEval
      | cons head tail =>
          cases tail with
          | nil =>
              simp at hEval
              rcases hEval with ⟨hState, hValue⟩
              cases hState
              cases hValue
              have hSource :=
                Expr.eval_observerFree_matches_source hFree hExpr
              rcases hSource with ⟨hOrdinary, hTrace⟩
              exact
                ⟨by simp [Locals.Source.Expr.evalOne, hOrdinary], hTrace⟩
          | cons second rest =>
              simp [invalid, Structured.invalid] at hEval

theorem Expr.evalCondition_observerFree_matches_source
    {expr : Locals.Expr 1} {state state' : State} {cond : Bool}
    (hFree : ExprObserverFree expr)
    (hEval : Expr.evalCondition expr state = .ok (state', cond)) :
    Locals.Source.Expr.evalCondition
        Locals.Source.PrimitiveSemantics.structured expr state.source =
      .ok (state'.source, cond) ∧
    state'.trace = state.trace := by
  unfold Expr.evalCondition at hEval
  cases hExpr : Expr.evalOne expr state with
  | error err =>
      simp [hExpr] at hEval
  | ok exprResult =>
      rcases exprResult with ⟨stateAfterExpr, value⟩
      simp [hExpr] at hEval
      rcases hEval with ⟨hState, hCond⟩
      cases hState
      cases hCond
      have hSource :=
        Expr.evalOne_observerFree_matches_source hFree hExpr
      rcases hSource with ⟨hOrdinary, hTrace⟩
      exact
        ⟨by simp [Locals.Source.Expr.evalCondition, hOrdinary], hTrace⟩

namespace Switch

abbrev select := Locals.Source.Switch.select

end Switch

mutual
  def Block.runOpen (program : Locals.Program) (ctx : Ctx) :
      Nat → Locals.Block → State → Except EVMException (Outcome × Ctx)
    | 0, _block, _state =>
        invalid
    | _fuel + 1, ⟨[]⟩, state =>
        .ok (Outcome.regular state, ctx)
    | fuel + 1, ⟨stmt :: rest⟩, state => do
        let (outcome, ctx') ← Stmt.run program ctx fuel stmt state
        match outcome.mode with
        | .regular =>
            Block.runOpen program ctx' fuel { stmts := rest } outcome.state
        | .brk | .cont | .leave | .halt _ =>
            .ok (outcome, ctx)
  termination_by fuel block _state => (fuel, 0, sizeOf block)
  decreasing_by
    all_goals simp_wf
    all_goals omega

  def Block.runScoped (program : Locals.Program) (ctx : Ctx)
      (block : Locals.Block) (fuel : Nat) (state : State) :
      Except EVMException Outcome := do
    let (outcome, _) ← Block.runOpen program ctx fuel block state
    match outcome.mode with
    | .regular =>
        .ok (Outcome.regular (outcome.state.restrictTo ctx.scope))
    | .brk | .cont | .leave | .halt _ =>
        .ok outcome
  termination_by (fuel, 1, sizeOf block)
  decreasing_by
    exact Prod.Lex.right fuel
      (Prod.Lex.left (sizeOf block) (sizeOf block) (by omega))

  def Stmt.runForLoop (program : Locals.Program) (loopCtx : Ctx)
      (cond : Locals.Expr 1) (postBase : Ctx) (post : Locals.Block)
      (bodyBase : Ctx) (body : Locals.Block) :
      Nat → State → Except EVMException Outcome
    | 0, _state =>
        invalid
    | fuel + 1, state =>
        match Expr.evalCondition cond state with
        | .error err => .error err
        | .ok (stateAfterCond, condTrue) =>
            if condTrue then
              match Block.runScoped program bodyBase body fuel
                  stateAfterCond with
              | .error err => .error err
              | .ok bodyOutcome =>
                  match bodyOutcome.mode with
                  | .brk =>
                      .ok (Outcome.regular bodyOutcome.state)
                  | .regular | .cont =>
                      match Block.runScoped program postBase post fuel
                          bodyOutcome.state with
                      | .error err => .error err
                      | .ok postOutcome =>
                          match postOutcome.mode with
                          | .regular =>
                              Stmt.runForLoop program loopCtx cond postBase
                                post bodyBase body fuel postOutcome.state
                          | .brk | .cont =>
                              invalid
                          | .leave | .halt _ =>
                              .ok postOutcome
                  | .leave | .halt _ =>
                      .ok bodyOutcome
            else
              .ok (Outcome.regular (stateAfterCond.restrictTo loopCtx.scope))
  termination_by fuel _state => (fuel, 2, 0)
  decreasing_by
    all_goals simp_wf
    all_goals omega

  def Stmt.run (program : Locals.Program) (ctx : Ctx) :
      Nat → Locals.Stmt → State → Except EVMException (Outcome × Ctx)
    | _fuel, .expr expr, state => do
        let (state', _values) ← Expr.eval expr state
        .ok (Outcome.regular state', ctx)
    | _fuel, .exprs exprs, state => do
        let (state', _values) ← Expr.ExprSeq.eval exprs state
        .ok (Outcome.regular state', ctx)
    | _fuel, .let_ name value, state => do
        let (stateAfterValue, value') ← Expr.evalOne value state
        .ok (Outcome.regular (stateAfterValue.insert name value'),
          { ctx with scope := name :: ctx.scope })
    | _fuel, .assign name value, state => do
        if state.vars.contains name then
          let (stateAfterValue, value') ← Expr.evalOne value state
          .ok (Outcome.regular
            (stateAfterValue.withVars
              (Locals.Source.Store.insert stateAfterValue.vars name value')),
            ctx)
        else
          invalid
    | _fuel, .assignTop _name, _state =>
        invalid
    | _fuel, .assignTopWithOffset _offset _name, _state =>
        invalid
    | _fuel, .promoteName _name, _state =>
        invalid
    | _fuel, .cleanupTo _targetLayout, _state =>
        invalid
    | fuel, .block body, state => do
        let outcome ← Block.runScoped program ctx body fuel state
        .ok (outcome, ctx)
    | 0, .if_ _cond _body, _state =>
        invalid
    | fuel + 1, .if_ cond body, state =>
        match Expr.evalCondition cond state with
        | .error err => .error err
        | .ok (stateAfterCond, condTrue) =>
            if condTrue then do
              let outcome ← Block.runScoped program ctx body fuel
                stateAfterCond
              .ok (outcome, ctx)
            else
              .ok (Outcome.regular stateAfterCond, ctx)
    | 0, .switch _scrutinee _cases _defaultBody, _state =>
        invalid
    | fuel + 1, .switch scrutinee cases defaultBody, state => do
        let (stateAfterScrutinee, value) ← Expr.evalOne scrutinee state
        match Switch.select value cases defaultBody with
        | none => .ok (Outcome.regular stateAfterScrutinee, ctx)
        | some body =>
            let outcome ← Block.runScoped program ctx body fuel
              stateAfterScrutinee
            .ok (outcome, ctx)
    | 0, .for_ _init _cond _post _body, _state =>
        invalid
    | fuel + 1, .for_ init cond post body, state => do
        let initBase := ctx.withoutLoopControl
        let (initOutcome, initCtx) ←
          Block.runOpen program initBase fuel init state
        match initOutcome.mode with
        | .regular =>
            let loopCtx := initCtx
            let postBase := initCtx.withoutLoopControl
            let bodyBase := initCtx.withLoopControl initCtx.scope initCtx.scope
            let loopOutcome ←
              Stmt.runForLoop program loopCtx cond postBase post bodyBase
                body fuel initOutcome.state
            match loopOutcome.mode with
            | .regular =>
                .ok (Outcome.regular (loopOutcome.state.restrictTo ctx.scope),
                  ctx)
            | .brk | .cont =>
                invalid
            | .leave | .halt _ =>
                .ok (loopOutcome, ctx)
        | .brk | .cont =>
            invalid
        | .leave | .halt _ =>
            .ok (initOutcome, ctx)
    | _fuel, .brk, state =>
        match ctx.breakScope? with
        | none => invalid
        | some scope =>
            .ok (Outcome.brk (state.restrictTo scope), ctx)
    | _fuel, .cont, state =>
        match ctx.continueScope? with
        | none => invalid
        | some scope =>
            .ok (Outcome.cont (state.restrictTo scope), ctx)
    | _fuel, .leave, state =>
        match ctx.leaveScope? with
        | none => invalid
        | some scope =>
            .ok (Outcome.leave (state.restrictTo scope), ctx)
    | _fuel, .call _name, _state =>
        invalid
    | _fuel, .terminal kind, state => do
        let (shared, trace') ←
          replayPrimitiveSemantics.terminal kind state.shared [] state.trace
        .ok (Outcome.halt kind ((state.withShared shared).withTrace trace'),
          ctx)
    | _fuel, .terminalArgs kind args, state => do
        let (stateAfterArgs, values) ← Expr.ExprSeq.eval args state
        let (shared, trace') ←
          replayPrimitiveSemantics.terminal kind stateAfterArgs.shared values
            stateAfterArgs.trace
        .ok
          (Outcome.halt kind
            ((stateAfterArgs.withShared shared).withTrace trace'), ctx)
  termination_by fuel stmt _state => (fuel, 3, sizeOf stmt)
  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | exact Prod.Lex.right _
          (Prod.Lex.left _ _ (by omega))
end

namespace Stmt

theorem run_regular_scope {program : Locals.Program}
    {ctx ctx' : Ctx} {fuel : Nat} {stmt : Locals.Stmt}
    {state out : State}
    (hRun :
      Stmt.run program ctx fuel stmt state =
        .ok (Outcome.regular out, ctx')) :
    ctx'.scope = Locals.Scope.Stmt.outEnv ctx.scope stmt := by
  cases stmt with
  | expr expr =>
      cases hEval : Expr.eval expr state with
      | error err =>
          simp [Stmt.run, hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfterExpr, values⟩
          simp [Stmt.run, hEval, Locals.Scope.Stmt.outEnv] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | exprs exprs =>
      cases hEval : Expr.ExprSeq.eval exprs state with
      | error err =>
          simp [Stmt.run, hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfterExprs, values⟩
          simp [Stmt.run, hEval, Locals.Scope.Stmt.outEnv] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | let_ name value =>
      cases hEval : Expr.evalOne value state with
      | error err =>
          simp [Stmt.run, hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfterValue, value'⟩
          simp [Stmt.run, hEval, Locals.Scope.Stmt.outEnv] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | assign name value =>
      cases hContains : state.vars.contains name with
      | false =>
          simp [Stmt.run, hContains, invalid, Structured.invalid] at hRun
      | true =>
          cases hEval : Expr.evalOne value state with
          | error err =>
              simp [Stmt.run, hContains, hEval] at hRun
          | ok result =>
              rcases result with ⟨stateAfterValue, value'⟩
              simp [Stmt.run, hContains, hEval, Locals.Scope.Stmt.outEnv]
                at hRun
              rcases hRun with ⟨_hOutcome, hCtxEq⟩
              cases hCtxEq
              rfl
  | assignTop name =>
      simp [Stmt.run, invalid, Structured.invalid] at hRun
  | assignTopWithOffset offset name =>
      simp [Stmt.run, invalid, Structured.invalid] at hRun
  | promoteName name =>
      simp [Stmt.run, invalid, Structured.invalid] at hRun
  | cleanupTo targetLayout =>
      simp [Stmt.run, invalid, Structured.invalid] at hRun
  | block body =>
      cases hBlock : Block.runScoped program ctx body fuel state with
      | error err =>
          simp [Stmt.run, hBlock] at hRun
      | ok outcome =>
          cases outcome with
          | mk blockState mode =>
              cases mode <;> simp [Stmt.run, hBlock,
                Locals.Scope.Stmt.outEnv, Outcome.regular, Outcome.brk,
                Outcome.cont, Outcome.leave, Outcome.halt] at hRun
              case regular =>
                rcases hRun with ⟨_hOutcome, hCtxEq⟩
                cases hCtxEq
                rfl
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Stmt.run, invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Expr.evalCondition cond state with
          | error err =>
              simp [Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨stateAfterCond, condTrue⟩
              cases condTrue <;>
                simp [Stmt.run, hCond, Locals.Scope.Stmt.outEnv] at hRun
              · rcases hRun with ⟨_hOutcome, hCtxEq⟩
                cases hCtxEq
                rfl
              · cases hBlock :
                    Block.runScoped program ctx body fuel stateAfterCond with
                | error err =>
                    simp [hBlock] at hRun
                | ok outcome =>
                    cases outcome with
                    | mk blockState mode =>
                        cases mode <;> simp [hBlock, Outcome.regular,
                          Outcome.brk, Outcome.cont, Outcome.leave,
                          Outcome.halt] at hRun
                        case regular =>
                          rcases hRun with ⟨_hOutcome, hCtxEq⟩
                          cases hCtxEq
                          rfl
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Stmt.run, invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hScrutinee : Expr.evalOne scrutinee state with
          | error err =>
              simp [Stmt.run, hScrutinee] at hRun
          | ok scrutineeResult =>
              rcases scrutineeResult with ⟨stateAfterScrutinee, value⟩
              cases hSelect :
                  Locals.Source.Switch.select value cases defaultBody with
              | none =>
                  simp [Stmt.run, hScrutinee, hSelect,
                    Locals.Scope.Stmt.outEnv] at hRun
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  cases hCtxEq
                  rfl
              | some body =>
                  cases hBlock :
                      Block.runScoped program ctx body fuel
                        stateAfterScrutinee with
                  | error err =>
                      simp [Stmt.run, hScrutinee, hSelect, hBlock] at hRun
                  | ok outcome =>
                      cases outcome with
                      | mk blockState mode =>
                          cases mode <;> simp [Stmt.run, hScrutinee,
                            hSelect, hBlock, Locals.Scope.Stmt.outEnv,
                            Outcome.regular, Outcome.brk, Outcome.cont,
                            Outcome.leave, Outcome.halt] at hRun
                          case regular =>
                            rcases hRun with ⟨_hOutcome, hCtxEq⟩
                            cases hCtxEq
                            rfl
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Stmt.run, invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hInit :
              Block.runOpen program ctx.withoutLoopControl fuel init state with
          | error err =>
              simp [Stmt.run, hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases initOutcome with
              | mk initState initMode =>
                  cases initMode <;> simp [Stmt.run, hInit,
                    Locals.Scope.Stmt.outEnv, Outcome.regular, Outcome.brk,
                    Outcome.cont, Outcome.leave, Outcome.halt, invalid,
                    Structured.invalid] at hRun
                  case regular =>
                    cases hLoop :
                        Stmt.runForLoop program initCtx cond
                          initCtx.withoutLoopControl post
                          (initCtx.withLoopControl initCtx.scope initCtx.scope)
                          body fuel initState with
                    | error err =>
                        simp [hLoop] at hRun
                    | ok loopOutcome =>
                        cases loopOutcome with
                        | mk loopState loopMode =>
                            cases loopMode <;> simp [hLoop,
                              Outcome.regular, Outcome.brk, Outcome.cont,
                              Outcome.leave, Outcome.halt, invalid,
                              Structured.invalid] at hRun
                            case regular =>
                              rcases hRun with ⟨_hOutcome, hCtxEq⟩
                              cases hCtxEq
                              rfl
  | brk =>
      cases hBreak : ctx.breakScope? with
      | none =>
          simp [Stmt.run, hBreak, invalid, Structured.invalid] at hRun
      | some scope =>
          simp [Stmt.run, hBreak, Outcome.brk] at hRun
          exact False.elim (by
            rcases hRun with ⟨hOutcome, _hCtx⟩
            cases hOutcome)
  | cont =>
      cases hContinue : ctx.continueScope? with
      | none =>
          simp [Stmt.run, hContinue, invalid, Structured.invalid] at hRun
      | some scope =>
          simp [Stmt.run, hContinue, Outcome.cont] at hRun
          exact False.elim (by
            rcases hRun with ⟨hOutcome, _hCtx⟩
            cases hOutcome)
  | leave =>
      cases hLeave : ctx.leaveScope? with
      | none =>
          simp [Stmt.run, hLeave, invalid, Structured.invalid] at hRun
      | some scope =>
          simp [Stmt.run, hLeave, Outcome.leave] at hRun
          exact False.elim (by
            rcases hRun with ⟨hOutcome, _hCtx⟩
            cases hOutcome)
  | call name =>
      simp [Stmt.run, invalid, Structured.invalid] at hRun
  | terminal kind =>
      cases hTerminal :
          replayPrimitiveSemantics.terminal kind state.shared [] state.trace with
      | error err =>
          simp [Stmt.run, hTerminal] at hRun
      | ok result =>
          rcases result with ⟨shared, trace'⟩
          simp [Stmt.run, hTerminal, Outcome.halt] at hRun
          exact False.elim (by
            rcases hRun with ⟨hOutcome, _hCtx⟩
            cases hOutcome)
  | terminalArgs kind args =>
      cases hArgs : Expr.ExprSeq.eval args state with
      | error err =>
          simp [Stmt.run, hArgs] at hRun
      | ok argResult =>
          rcases argResult with ⟨stateAfterArgs, values⟩
          cases hTerminal :
              replayPrimitiveSemantics.terminal kind stateAfterArgs.shared
                values stateAfterArgs.trace with
          | error err =>
              simp [Stmt.run, hArgs, hTerminal] at hRun
          | ok result =>
              rcases result with ⟨shared, trace'⟩
              simp [Stmt.run, hArgs, hTerminal, Outcome.halt] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)

end Stmt

namespace Block

theorem runOpen_regular_scope {program : Locals.Program}
    {ctx ctx' : Ctx} {fuel : Nat} {block : Locals.Block}
    {state out : State}
    (hRun :
      Block.runOpen program ctx fuel block state =
        .ok (Outcome.regular out, ctx')) :
    ctx'.scope = Locals.Scope.Block.outEnv ctx.scope block := by
  cases block with
  | mk stmts =>
      induction stmts generalizing ctx ctx' fuel state out with
      | nil =>
          cases fuel with
          | zero =>
              simp [Block.runOpen, invalid, Structured.invalid] at hRun
          | succ fuel =>
              simp [Block.runOpen, Locals.Scope.Block.outEnv,
                Locals.Scope.StmtList.outEnv] at hRun
              rcases hRun with ⟨_hOutcome, hCtxEq⟩
              cases hCtxEq
              rfl
      | cons stmt rest ih =>
          cases fuel with
          | zero =>
              simp [Block.runOpen, invalid, Structured.invalid] at hRun
          | succ fuel =>
              cases hStmt :
                  Stmt.run program ctx fuel stmt state with
              | error err =>
                  simp [Block.runOpen, hStmt] at hRun
              | ok stmtResult =>
                  rcases stmtResult with ⟨stmtOutcome, headCtx⟩
                  cases stmtOutcome with
                  | mk stmtState mode =>
                      cases mode <;> simp [Block.runOpen, hStmt,
                        Outcome.regular, Outcome.brk, Outcome.cont,
                        Outcome.leave, Outcome.halt] at hRun
                      case regular =>
                        have hHeadScope :
                            headCtx.scope =
                              Locals.Scope.Stmt.outEnv ctx.scope stmt :=
                          Stmt.run_regular_scope hStmt
                        have hTailScope :
                            ctx'.scope =
                              Locals.Scope.Block.outEnv headCtx.scope
                                { stmts := rest } :=
                          ih hRun
                        simpa [Locals.Scope.Block.outEnv,
                          Locals.Scope.StmtList.outEnv, hHeadScope] using
                          hTailScope
                      all_goals
                        exact False.elim (by
                          rcases hRun with ⟨hOutcome, _hCtx⟩
                          cases hOutcome)

theorem runOpen_regular_cleanupScopeRel {program : Locals.Program}
    {ctx ctx' : Ctx} {fuel : Nat} {block : Locals.Block}
    {state out : State}
    (hRun :
      Block.runOpen program ctx fuel block state =
        .ok (Outcome.regular out, ctx')) :
    Locals.SourceLowering.CleanupScopeRel ctx'.scope ctx.scope := by
  have hScope := runOpen_regular_scope hRun
  have hCleanup :
      Locals.SourceLowering.CleanupScopeRel
        (Locals.Scope.Block.outEnv ctx.scope block) ctx.scope :=
    Locals.SourceLowering.Scope.block_outEnv_cleanupScopeRel ctx.scope block
  simpa [hScope] using hCleanup

end Block

mutual
  theorem Block.runOpen_observerFree_matches_source
      {program : Locals.Program} {ctx ctx' : Ctx}
      {fuel : Nat} {block : Locals.Block} {state : State}
      {outcome : Outcome}
      (hFree : BlockObserverFree block)
      (hRun : Block.runOpen program ctx fuel block state =
        .ok (outcome, ctx')) :
      Locals.Source.Block.runOpen Locals.Source.PrimitiveSemantics.structured
          program ctx fuel block state.source =
        .ok (outcome.toSource, ctx') ∧
      outcome.state.trace = state.trace := by
    cases fuel with
    | zero =>
        cases block
        simp [Block.runOpen, Locals.Source.Block.runOpen, invalid,
          Structured.invalid] at hRun
    | succ fuel =>
        cases block with
        | mk stmts =>
            cases hFree with
            | mk hStmts =>
                cases stmts with
                | nil =>
                    simp [Block.runOpen, Locals.Source.Block.runOpen] at hRun ⊢
                    rcases hRun with ⟨hOutcome, hCtx⟩
                    cases hOutcome
                    cases hCtx
                    exact ⟨by simp [Outcome.toSource], rfl⟩
                | cons stmt rest =>
                    cases hStmts with
                    | cons hStmtFree hRestFree =>
                        simp [Block.runOpen, Locals.Source.Block.runOpen] at hRun ⊢
                        cases hStmt : Stmt.run program ctx fuel stmt state with
                        | error err =>
                            simp [hStmt] at hRun
                        | ok stmtResult =>
                            rcases stmtResult with ⟨stmtOutcome, stmtCtx⟩
                            simp [hStmt] at hRun
                            have hStmtSource :=
                              Stmt.run_observerFree_matches_source
                                hStmtFree hStmt
                            rcases hStmtSource with
                              ⟨hStmtOrdinary, hStmtTrace⟩
                            cases stmtOutcome with
                            | mk stmtState stmtMode =>
                                cases stmtMode with
                                | regular =>
                                    simp [hStmtOrdinary, Outcome.toSource] at hRun ⊢
                                    cases hRest :
                                        Block.runOpen program stmtCtx fuel
                                          { stmts := rest } stmtState with
                                    | error err =>
                                        simp [hRest] at hRun
                                    | ok restResult =>
                                        rcases restResult with
                                          ⟨restOutcome, restCtx⟩
                                        simp [hRest] at hRun
                                        rcases hRun with ⟨hOutcome, hCtx⟩
                                        cases hOutcome
                                        cases hCtx
                                        have hRestSource :=
                                          Block.runOpen_observerFree_matches_source
                                            (BlockObserverFree.mk hRestFree)
                                            hRest
                                        rcases hRestSource with
                                          ⟨hRestOrdinary, hRestTrace⟩
                                        exact
                                          ⟨hRestOrdinary,
                                            hRestTrace.trans hStmtTrace⟩
                                | brk =>
                                    simp [hStmtOrdinary, Outcome.toSource] at hRun ⊢
                                    rcases hRun with ⟨hOutcome, hCtx⟩
                                    cases hOutcome
                                    cases hCtx
                                    exact ⟨by simp [Outcome.toSource], hStmtTrace⟩
                                | cont =>
                                    simp [hStmtOrdinary, Outcome.toSource] at hRun ⊢
                                    rcases hRun with ⟨hOutcome, hCtx⟩
                                    cases hOutcome
                                    cases hCtx
                                    exact ⟨by simp [Outcome.toSource], hStmtTrace⟩
                                | leave =>
                                    simp [hStmtOrdinary, Outcome.toSource] at hRun ⊢
                                    rcases hRun with ⟨hOutcome, hCtx⟩
                                    cases hOutcome
                                    cases hCtx
                                    exact ⟨by simp [Outcome.toSource], hStmtTrace⟩
                                        | halt kind =>
                                            simp [hStmtOrdinary, Outcome.toSource] at hRun ⊢
                                            rcases hRun with ⟨hOutcome, hCtx⟩
                                            cases hOutcome
                                            cases hCtx
                                            exact ⟨by simp [Outcome.toSource], hStmtTrace⟩
  termination_by (fuel, 1)
  decreasing_by
    all_goals simp_wf
    all_goals omega

  theorem Block.runScoped_observerFree_matches_source
      {program : Locals.Program} {ctx : Ctx}
      {fuel : Nat} {block : Locals.Block} {state : State}
      {outcome : Outcome}
      (hFree : BlockObserverFree block)
      (hRun : Block.runScoped program ctx block fuel state = .ok outcome) :
      Locals.Source.Block.runScoped
          Locals.Source.PrimitiveSemantics.structured program ctx block fuel
          state.source =
        .ok outcome.toSource ∧
      outcome.state.trace = state.trace := by
    unfold Block.runScoped at hRun
    unfold Locals.Source.Block.runScoped
    cases hOpen : Block.runOpen program ctx fuel block state with
    | error err =>
        simp [hOpen] at hRun
    | ok openResult =>
        rcases openResult with ⟨openOutcome, openCtx⟩
        simp [hOpen] at hRun
        have hOpenSource :=
          Block.runOpen_observerFree_matches_source hFree hOpen
        rcases hOpenSource with ⟨hOpenOrdinary, hOpenTrace⟩
        simp [hOpenOrdinary]
        cases openOutcome with
        | mk openState openMode =>
            cases openMode with
            | regular =>
                cases hRun
                exact
                  ⟨by simp [Outcome.toSource, State.restrictTo,
                    State.withSource],
                    hOpenTrace⟩
            | brk =>
                cases hRun
                exact ⟨by simp [Outcome.toSource], hOpenTrace⟩
            | cont =>
                cases hRun
                exact ⟨by simp [Outcome.toSource], hOpenTrace⟩
            | leave =>
                cases hRun
                exact ⟨by simp [Outcome.toSource], hOpenTrace⟩
                    | halt kind =>
                        cases hRun
                        exact ⟨by simp [Outcome.toSource], hOpenTrace⟩
  termination_by (fuel, 2)
  decreasing_by
    all_goals simp_wf
    all_goals omega

  theorem Stmt.runForLoop_observerFree_matches_source
      {program : Locals.Program} {loopCtx : Ctx}
      {cond : Locals.Expr 1} {postBase : Ctx} {post : Locals.Block}
      {bodyBase : Ctx} {body : Locals.Block}
      {fuel : Nat} {state : State} {outcome : Outcome}
      (hCondFree : ExprObserverFree cond)
      (hPostFree : BlockObserverFree post)
      (hBodyFree : BlockObserverFree body)
      (hRun :
        Stmt.runForLoop program loopCtx cond postBase post bodyBase body
          fuel state = .ok outcome) :
      Locals.Source.Stmt.runForLoop
          Locals.Source.PrimitiveSemantics.structured program loopCtx cond
          postBase post bodyBase body fuel state.source =
        .ok outcome.toSource ∧
      outcome.state.trace = state.trace := by
    cases fuel with
    | zero =>
        simp [Stmt.runForLoop, Locals.Source.Stmt.runForLoop, invalid,
          Structured.invalid] at hRun
    | succ fuel =>
        unfold Stmt.runForLoop at hRun
        unfold Locals.Source.Stmt.runForLoop
        cases hCond :
            Expr.evalCondition cond state with
        | error err =>
            simp [hCond] at hRun
        | ok condResult =>
            rcases condResult with ⟨stateAfterCond, condTrue⟩
            simp [hCond] at hRun
            have hCondSource :=
              Expr.evalCondition_observerFree_matches_source
                hCondFree hCond
            rcases hCondSource with ⟨hCondOrdinary, hCondTrace⟩
            simp [hCondOrdinary]
            cases condTrue with
            | false =>
                simp at hRun ⊢
                cases hRun
                exact
                  ⟨by simp [Outcome.toSource, State.restrictTo,
                    State.withSource],
                    hCondTrace⟩
            | true =>
                simp at hRun ⊢
                cases hBody :
                    Block.runScoped program bodyBase body fuel
                      stateAfterCond with
                | error err =>
                    simp [hBody] at hRun
                | ok bodyOutcome =>
                    simp [hBody] at hRun
                    have hBodySource :=
                      Block.runScoped_observerFree_matches_source
                        hBodyFree hBody
                    rcases hBodySource with
                      ⟨hBodyOrdinary, hBodyTrace⟩
                    simp [hBodyOrdinary]
                    cases bodyOutcome with
                    | mk bodyState bodyMode =>
                        cases bodyMode with
                        | brk =>
                            cases hRun
                            exact
                              ⟨by simp [Outcome.toSource],
                                hBodyTrace.trans hCondTrace⟩
                        | regular =>
                            cases hPost :
                                Block.runScoped program postBase post fuel
                                  bodyState with
                            | error err =>
                                simp [hPost] at hRun
                            | ok postOutcome =>
                                simp [hPost] at hRun
                                have hPostSource :=
                                  Block.runScoped_observerFree_matches_source
                                    hPostFree hPost
                                rcases hPostSource with
                                  ⟨hPostOrdinary, hPostTrace⟩
                                simp [hPostOrdinary]
                                cases postOutcome with
                                | mk postState postMode =>
                                    cases postMode with
                                    | regular =>
                                        have hLoopSource :=
                                          Stmt.runForLoop_observerFree_matches_source
                                            hCondFree hPostFree hBodyFree hRun
                                        rcases hLoopSource with
                                          ⟨hLoopOrdinary, hLoopTrace⟩
                                        exact
                                          ⟨hLoopOrdinary,
                                            hLoopTrace.trans
                                              (hPostTrace.trans
                                                (hBodyTrace.trans hCondTrace))⟩
                                    | brk =>
                                        simp [invalid, Structured.invalid] at hRun
                                    | cont =>
                                        simp [invalid, Structured.invalid] at hRun
                                    | leave =>
                                        cases hRun
                                        exact
                                          ⟨by simp [Outcome.toSource],
                                            hPostTrace.trans
                                            (hBodyTrace.trans hCondTrace)⟩
                                    | halt kind =>
                                        cases hRun
                                        exact
                                          ⟨by simp [Outcome.toSource],
                                            hPostTrace.trans
                                            (hBodyTrace.trans hCondTrace)⟩
                        | cont =>
                            cases hPost :
                                Block.runScoped program postBase post fuel
                                  bodyState with
                            | error err =>
                                simp [hPost] at hRun
                            | ok postOutcome =>
                                simp [hPost] at hRun
                                have hPostSource :=
                                  Block.runScoped_observerFree_matches_source
                                    hPostFree hPost
                                rcases hPostSource with
                                  ⟨hPostOrdinary, hPostTrace⟩
                                simp [hPostOrdinary]
                                cases postOutcome with
                                | mk postState postMode =>
                                    cases postMode with
                                    | regular =>
                                        have hLoopSource :=
                                          Stmt.runForLoop_observerFree_matches_source
                                            hCondFree hPostFree hBodyFree hRun
                                        rcases hLoopSource with
                                          ⟨hLoopOrdinary, hLoopTrace⟩
                                        exact
                                          ⟨hLoopOrdinary,
                                            hLoopTrace.trans
                                              (hPostTrace.trans
                                                (hBodyTrace.trans hCondTrace))⟩
                                    | brk =>
                                        simp [invalid, Structured.invalid] at hRun
                                    | cont =>
                                        simp [invalid, Structured.invalid] at hRun
                                    | leave =>
                                        cases hRun
                                        exact
                                          ⟨by simp [Outcome.toSource],
                                            hPostTrace.trans
                                            (hBodyTrace.trans hCondTrace)⟩
                                    | halt kind =>
                                        cases hRun
                                        exact
                                          ⟨by simp [Outcome.toSource],
                                            hPostTrace.trans
                                            (hBodyTrace.trans hCondTrace)⟩
                        | leave =>
                            cases hRun
                            exact
                              ⟨by simp [Outcome.toSource],
                                hBodyTrace.trans hCondTrace⟩
                                | halt kind =>
                                    cases hRun
                                    exact
                                      ⟨by simp [Outcome.toSource],
                                        hBodyTrace.trans hCondTrace⟩
  termination_by (fuel, 3)
  decreasing_by
    all_goals simp_wf
    all_goals omega

  theorem Stmt.run_observerFree_matches_source
      {program : Locals.Program} {ctx ctx' : Ctx}
      {fuel : Nat} {stmt : Locals.Stmt} {state : State}
      {outcome : Outcome}
      (hFree : StmtObserverFree stmt)
      (hRun : Stmt.run program ctx fuel stmt state =
        .ok (outcome, ctx')) :
      Locals.Source.Stmt.run Locals.Source.PrimitiveSemantics.structured
          program ctx fuel stmt state.source =
        .ok (outcome.toSource, ctx') ∧
      outcome.state.trace = state.trace := by
    cases stmt with
    | expr expr =>
        cases hFree with
        | expr hExprFree =>
            simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
            cases hExpr : Expr.eval expr state with
            | error err =>
                simp [hExpr] at hRun
            | ok exprResult =>
                rcases exprResult with ⟨stateAfterExpr, values⟩
                simp [hExpr] at hRun
                rcases hRun with ⟨hOutcome, hCtx⟩
                cases hOutcome
                cases hCtx
                have hExprSource :=
                  Expr.eval_observerFree_matches_source hExprFree hExpr
                rcases hExprSource with ⟨hExprOrdinary, hExprTrace⟩
                exact
                  ⟨by simp [hExprOrdinary, Outcome.toSource],
                    hExprTrace⟩
    | exprs exprs =>
        cases hFree with
        | exprs hExprsFree =>
            simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
            cases hExprs : Expr.ExprSeq.eval exprs state with
            | error err =>
                simp [hExprs] at hRun
            | ok exprsResult =>
                rcases exprsResult with ⟨stateAfterExprs, values⟩
                simp [hExprs] at hRun
                rcases hRun with ⟨hOutcome, hCtx⟩
                cases hOutcome
                cases hCtx
                have hExprsSource :=
                  ExprSeq.eval_observerFree_matches_source hExprsFree hExprs
                rcases hExprsSource with ⟨hExprsOrdinary, hExprsTrace⟩
                exact
                  ⟨by simp [hExprsOrdinary, Outcome.toSource],
                    hExprsTrace⟩
    | let_ name value =>
        cases hFree with
        | let_ hValueFree =>
            simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
            cases hValue : Expr.evalOne value state with
            | error err =>
                simp [hValue] at hRun
            | ok valueResult =>
                rcases valueResult with ⟨stateAfterValue, value'⟩
                simp [hValue] at hRun
                rcases hRun with ⟨hOutcome, hCtx⟩
                cases hOutcome
                cases hCtx
                have hValueSource :=
                  Expr.evalOne_observerFree_matches_source
                    hValueFree hValue
                rcases hValueSource with ⟨hValueOrdinary, hValueTrace⟩
                exact
                  ⟨by simp [hValueOrdinary, Outcome.toSource, State.insert,
                    State.withSource],
                    hValueTrace⟩
    | assign name value =>
        cases hFree with
        | assign hValueFree =>
            simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
            by_cases hContains : state.source.vars.contains name
            · simp [State.vars, hContains] at hRun ⊢
              cases hValue : Expr.evalOne value state with
              | error err =>
                  simp [hValue] at hRun
              | ok valueResult =>
                  rcases valueResult with ⟨stateAfterValue, value'⟩
                  simp [hValue] at hRun
                  rcases hRun with ⟨hOutcome, hCtx⟩
                  cases hOutcome
                  cases hCtx
                  have hValueSource :=
                    Expr.evalOne_observerFree_matches_source
                      hValueFree hValue
                  rcases hValueSource with ⟨hValueOrdinary, hValueTrace⟩
                  exact
                    ⟨by simp [hValueOrdinary, Outcome.toSource,
                      State.withVars, State.withSource, State.vars],
                      hValueTrace⟩
            · simp [State.vars, hContains, invalid, Structured.invalid] at hRun
    | assignTop name =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run, invalid,
          Structured.invalid] at hRun
    | assignTopWithOffset offset name =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run, invalid,
          Structured.invalid] at hRun
    | promoteName name =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run, invalid,
          Structured.invalid] at hRun
    | cleanupTo targetLayout =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run, invalid,
          Structured.invalid] at hRun
    | block body =>
        cases hFree with
        | block hBodyFree =>
            simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
            cases hBody :
                Block.runScoped program ctx body fuel state with
            | error err =>
                simp [hBody] at hRun
            | ok bodyOutcome =>
                simp [hBody] at hRun
                rcases hRun with ⟨hOutcome, hCtx⟩
                cases hOutcome
                cases hCtx
                have hBodySource :=
                  Block.runScoped_observerFree_matches_source
                    hBodyFree hBody
                rcases hBodySource with ⟨hBodyOrdinary, hBodyTrace⟩
                exact ⟨by simp [hBodyOrdinary], hBodyTrace⟩
    | if_ cond body =>
        cases hFree with
        | if_ hCondFree hBodyFree =>
            cases fuel with
            | zero =>
                simp [Stmt.run, Locals.Source.Stmt.run, invalid,
                  Structured.invalid] at hRun
            | succ fuel =>
                unfold Stmt.run at hRun
                unfold Locals.Source.Stmt.run
                cases hCond : Expr.evalCondition cond state with
                | error err =>
                    simp [hCond] at hRun
                | ok condResult =>
                    rcases condResult with ⟨stateAfterCond, condTrue⟩
                    simp [hCond] at hRun
                    have hCondSource :=
                      Expr.evalCondition_observerFree_matches_source
                        hCondFree hCond
                    rcases hCondSource with ⟨hCondOrdinary, hCondTrace⟩
                    simp [hCondOrdinary]
                    cases condTrue with
                    | false =>
                        simp at hRun ⊢
                        rcases hRun with ⟨hOutcome, hCtx⟩
                        cases hOutcome
                        cases hCtx
                        exact ⟨by simp [Outcome.toSource], hCondTrace⟩
                    | true =>
                        simp at hRun ⊢
                        cases hBody :
                            Block.runScoped program ctx body fuel
                              stateAfterCond with
                        | error err =>
                            simp [hBody] at hRun
                        | ok bodyOutcome =>
                            simp [hBody] at hRun
                            rcases hRun with ⟨hOutcome, hCtx⟩
                            cases hOutcome
                            cases hCtx
                            have hBodySource :=
                              Block.runScoped_observerFree_matches_source
                                hBodyFree hBody
                            rcases hBodySource with
                              ⟨hBodyOrdinary, hBodyTrace⟩
                            exact
                              ⟨by simp [hBodyOrdinary],
                                hBodyTrace.trans hCondTrace⟩
    | switch scrutinee cases defaultBody =>
        cases hFree with
        | switch hScrutineeFree hCasesFree hDefaultFree =>
            cases fuel with
            | zero =>
                simp [Stmt.run, Locals.Source.Stmt.run, invalid,
                  Structured.invalid] at hRun
            | succ fuel =>
                simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
                cases hScrutinee :
                    Expr.evalOne scrutinee state with
                | error err =>
                    simp [hScrutinee] at hRun
                | ok scrutineeResult =>
                    rcases scrutineeResult with
                      ⟨stateAfterScrutinee, value⟩
                    simp [hScrutinee] at hRun
                    have hScrutineeSource :=
                      Expr.evalOne_observerFree_matches_source
                        hScrutineeFree hScrutinee
                    rcases hScrutineeSource with
                      ⟨hScrutineeOrdinary, hScrutineeTrace⟩
                    simp [hScrutineeOrdinary]
                    cases hSelect :
                        Switch.select value cases defaultBody with
                    | none =>
                        simp [hSelect] at hRun ⊢
                        rcases hRun with ⟨hOutcome, hCtx⟩
                        cases hOutcome
                        cases hCtx
                        exact
                          ⟨by simp [Outcome.toSource], hScrutineeTrace⟩
                    | some selectedBody =>
                        simp [hSelect] at hRun
                        have hSelectedFree :
                            BlockObserverFree selectedBody :=
                          blockObserverFree_of_select
                            hCasesFree hDefaultFree hSelect
                        cases hBody :
                            Block.runScoped program ctx selectedBody fuel
                              stateAfterScrutinee with
                        | error err =>
                            simp [hBody] at hRun
                        | ok bodyOutcome =>
                            simp [hBody] at hRun
                            rcases hRun with ⟨hOutcome, hCtx⟩
                            cases hOutcome
                            cases hCtx
                            have hBodySource :=
                              Block.runScoped_observerFree_matches_source
                                hSelectedFree hBody
                            rcases hBodySource with
                              ⟨hBodyOrdinary, hBodyTrace⟩
                            exact
                              ⟨by simp [hSelect, hBodyOrdinary],
                                hBodyTrace.trans hScrutineeTrace⟩
    | for_ init cond post body =>
        cases hFree with
        | for_ hInitFree hCondFree hPostFree hBodyFree =>
            cases fuel with
            | zero =>
                simp [Stmt.run, Locals.Source.Stmt.run, invalid,
                  Structured.invalid] at hRun
            | succ fuel =>
                simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
                cases hInit :
                    Block.runOpen program ctx.withoutLoopControl fuel init state with
                | error err =>
                    simp [hInit] at hRun
                | ok initResult =>
                    rcases initResult with ⟨initOutcome, initCtx⟩
                    simp [hInit] at hRun
                    have hInitSource :=
                      Block.runOpen_observerFree_matches_source
                        hInitFree hInit
                    rcases hInitSource with ⟨hInitOrdinary, hInitTrace⟩
                    simp [hInitOrdinary]
                    cases initOutcome with
                    | mk initState initMode =>
                        cases initMode with
                        | regular =>
                            simp [Outcome.toSource] at hRun ⊢
                            cases hLoop :
                                Stmt.runForLoop program initCtx cond
                                  initCtx.withoutLoopControl post
                                  (initCtx.withLoopControl initCtx.scope
                                    initCtx.scope)
                                  body fuel initState with
                            | error err =>
                                simp [hLoop] at hRun
                                    | ok loopOutcome =>
                                        simp [hLoop] at hRun
                                        have hLoopSource :=
                                          Stmt.runForLoop_observerFree_matches_source
                                            hCondFree hPostFree hBodyFree hLoop
                                        rcases hLoopSource with
                                          ⟨hLoopOrdinary, hLoopTrace⟩
                                        simp [hLoopOrdinary]
                                        cases loopOutcome with
                                        | mk loopState loopMode =>
                                            cases loopMode with
                                            | regular =>
                                                cases hRun
                                                exact
                                                  ⟨by simp [Outcome.toSource,
                                                    State.restrictTo,
                                                    State.withSource],
                                                    hLoopTrace.trans hInitTrace⟩
                                            | brk =>
                                                simp [invalid,
                                                  Structured.invalid] at hRun
                                            | cont =>
                                                simp [invalid,
                                                  Structured.invalid] at hRun
                                            | leave =>
                                                cases hRun
                                                exact
                                                  ⟨by simp [Outcome.toSource],
                                                    hLoopTrace.trans hInitTrace⟩
                                            | halt kind =>
                                                cases hRun
                                                exact
                                                  ⟨by simp [Outcome.toSource],
                                                    hLoopTrace.trans hInitTrace⟩
                        | brk =>
                            simp [invalid, Structured.invalid] at hRun
                        | cont =>
                            simp [invalid, Structured.invalid] at hRun
                        | leave =>
                            simp [Outcome.toSource] at hRun ⊢
                            rcases hRun with ⟨hOutcome, hCtx⟩
                            cases hOutcome
                            cases hCtx
                            exact ⟨by simp [Outcome.toSource], hInitTrace⟩
                        | halt kind =>
                            simp [Outcome.toSource] at hRun ⊢
                            rcases hRun with ⟨hOutcome, hCtx⟩
                            cases hOutcome
                            cases hCtx
                            exact ⟨by simp [Outcome.toSource], hInitTrace⟩
    | brk =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
        cases hBreak : ctx.breakScope? with
        | none =>
            simp [hBreak, invalid, Structured.invalid] at hRun
        | some scope =>
            simp [hBreak] at hRun ⊢
            rcases hRun with ⟨hOutcome, hCtx⟩
            cases hOutcome
            cases hCtx
            exact ⟨by simp [Outcome.toSource, State.restrictTo,
              State.withSource], rfl⟩
    | cont =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
        cases hCont : ctx.continueScope? with
        | none =>
            simp [hCont, invalid, Structured.invalid] at hRun
        | some scope =>
            simp [hCont] at hRun ⊢
            rcases hRun with ⟨hOutcome, hCtx⟩
            cases hOutcome
            cases hCtx
            exact ⟨by simp [Outcome.toSource, State.restrictTo,
              State.withSource], rfl⟩
    | leave =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
        cases hLeave : ctx.leaveScope? with
        | none =>
            simp [hLeave, invalid, Structured.invalid] at hRun
        | some scope =>
            simp [hLeave] at hRun ⊢
            rcases hRun with ⟨hOutcome, hCtx⟩
            cases hOutcome
            cases hCtx
            exact ⟨by simp [Outcome.toSource, State.restrictTo,
              State.withSource], rfl⟩
    | call name =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run, invalid,
          Structured.invalid] at hRun
    | terminal kind =>
        cases hFree
        simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
        cases hTerminal :
            replayPrimitiveSemantics.terminal kind state.shared [] state.trace with
        | error err =>
            simp [hTerminal] at hRun
        | ok terminalResult =>
            rcases terminalResult with ⟨shared, trace'⟩
            simp [hTerminal] at hRun
            rcases hRun with ⟨hOutcome, hCtx⟩
            cases hOutcome
            cases hCtx
            have hTerminalSource :=
              replay_terminal_preserves_trace hTerminal
            rcases hTerminalSource with ⟨hTerminalOrdinary, hTrace⟩
            change
              Locals.Source.PrimitiveSemantics.structured.terminal kind
                  state.source.shared [] =
                .ok shared at hTerminalOrdinary
            exact
              ⟨by simp [hTerminalOrdinary, Outcome.toSource,
                State.withShared, State.withTrace, State.withSource,
                Locals.Source.State.withShared],
                by simp [State.withShared, State.withTrace,
                  State.withSource, hTrace]⟩
    | terminalArgs kind args =>
        cases hFree with
        | terminalArgs hArgsFree =>
            simp [Stmt.run, Locals.Source.Stmt.run] at hRun ⊢
            cases hArgs : Expr.ExprSeq.eval args state with
            | error err =>
                simp [hArgs] at hRun
            | ok argsResult =>
                rcases argsResult with ⟨stateAfterArgs, values⟩
                simp [hArgs] at hRun
                cases hTerminal :
                    replayPrimitiveSemantics.terminal kind stateAfterArgs.shared
                      values stateAfterArgs.trace with
                | error err =>
                    simp [hTerminal] at hRun
                | ok terminalResult =>
                    rcases terminalResult with ⟨shared, trace'⟩
                    simp [hTerminal] at hRun
                    rcases hRun with ⟨hOutcome, hCtx⟩
                    cases hOutcome
                    cases hCtx
                    have hArgsSource :=
                      ExprSeq.eval_observerFree_matches_source
                        hArgsFree hArgs
                    rcases hArgsSource with ⟨hArgsOrdinary, hArgsTrace⟩
                    have hTerminalSource :=
                      replay_terminal_preserves_trace hTerminal
                    rcases hTerminalSource with
                      ⟨hTerminalOrdinary, hTrace⟩
                    change
                      Locals.Source.PrimitiveSemantics.structured.terminal
                          kind stateAfterArgs.source.shared values =
                        .ok shared at hTerminalOrdinary
                    exact
                      ⟨by simp [hArgsOrdinary, hTerminalOrdinary,
                        Outcome.toSource, State.withShared, State.withTrace,
                        State.withSource, Locals.Source.State.withShared],
                        by simp [State.withShared, State.withTrace,
                          State.withSource, hTrace, hArgsTrace]⟩
  termination_by (fuel, 4)
  decreasing_by
    all_goals simp_wf
    all_goals omega
end

