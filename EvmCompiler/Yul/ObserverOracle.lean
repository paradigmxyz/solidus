@[simp] theorem sourceOutcome_regular_mk (state : SourceState) :
    Locals.Source.Outcome.regular state =
      ({ state := state, mode := .regular } : Locals.Source.Outcome) := rfl

@[simp] theorem sourceOutcome_brk_mk (state : SourceState) :
