    {evm' : EVMState} {result : Expressions.Outcome × Trace}
    (hRun :
      StructuredReplay.Code.runWithOracle asmProgram pc code state.evm trace =
        .ok (evm', trace'))
    (hRest :
      runCodeWithOracle asmProgram
          (pc + StructuredReplay.Code.byteLength code) rest
          (state.withEVM evm') trace' =
        .ok result) :
    runCodeWithOracle asmProgram pc (Locals.codeStmt code ++ rest)
        state trace =
      .ok result := by
  simp [Locals.codeStmt, runCodeWithOracle, Stmt.runCodeStmtWithOracle,
    hRun, hRest]

theorem runCodeWithOracle_cleanupTo_scope_exists
    {asmProgram : Assembly.Program} {pc : Nat}
    {ctx : Locals.Ctx} {scope : List Name}
    {source : Locals.Source.State} {target : Locals.RunState}
    {cleanup : Structured.Code} {trace : Trace}
    (hScope : Locals.SourceLowering.CleanupScopeRel ctx.layout scope)
    (hRel : Locals.SourceLowering.StateRel ctx.layout source target)
    (hCleanup : ctx.cleanupTo? scope.length = some cleanup) :
    ∃ cleaned,
      runCodeWithOracle asmProgram pc (Locals.codeStmt cleanup) target trace =
        .ok (Expressions.Outcome.regular cleaned, trace) ∧
      Locals.SourceLowering.StateRel scope (source.restrictTo scope) cleaned ∧
      cleaned.returns = target.returns := by
  have hDepth : scope.length ≤ ctx.layout.length :=
    Locals.SourceLowering.CleanupScopeRel.depth_le hScope
  rcases hRel with ⟨hSharedRel, hStackRel⟩
  rcases hStackRel with ⟨hStackLen, hStackLookup⟩
  let n := ctx.layout.length - scope.length
  have hRunLen : n ≤ target.evm.stack.length := by
    dsimp [n]
    omega
  have hCleanupCode :
      cleanup =
        List.replicate n (Structured.BasicInstr.op .pop) := by
    unfold Locals.Ctx.cleanupTo? at hCleanup
    simp [hDepth] at hCleanup
    exact hCleanup.symm
  rcases
      StructuredReplay.Code.runWithOracle_replicate_pop_exists
        asmProgram pc target.evm trace n hRunLen with
    ⟨evmClean, hRun, hCleanStack, hCleanShared⟩
  have hRunCleanup :
      StructuredReplay.Code.runWithOracle asmProgram pc cleanup
          target.evm trace =
        .ok (evmClean, trace) := by
    simpa [hCleanupCode] using hRun
  refine ⟨target.withEVM evmClean, ?_, ?_, rfl⟩
  · exact runCodeWithOracle_codeStmt_of_run hRunCleanup
  · constructor
    · simpa [Structured.RunState.withEVM, Locals.Source.State.restrictTo,
        hCleanShared] using hSharedRel
    · constructor
      · have hScopeN : ctx.layout.drop n = scope := by
          simpa [n] using hScope
        have hScopeLen :
            (ctx.layout.drop n).length = scope.length := by
          rw [hScopeN]
        simpa [Structured.RunState.withEVM, hCleanStack, hStackLen] using
          hScopeLen
      · intro idx name hName
        have hScopeN : ctx.layout.drop n = scope := by
          simpa [n] using hScope
        have hLayoutAt :
            ctx.layout[n + idx]? = some name := by
          have hDropAt :
              (ctx.layout.drop n)[idx]? = some name := by
            rw [hScopeN]
            exact hName
          simpa [List.getElem?_drop] using hDropAt
        have hStackAt := hStackLookup hLayoutAt
        have hNameMem : name ∈ scope :=
          List.mem_of_getElem? hName
        simp [Structured.RunState.withEVM, hCleanStack, List.getElem?_drop,
          Locals.Source.State.restrictTo, Locals.Source.Store.restrictTo, n,
          hNameMem, hStackAt]

end StmtList

mutual
  def Block.runWithOracle (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program) :
      Nat → Expressions.Block → Expressions.RunState → Trace →
        Except EVMException (Expressions.Outcome × Trace)
    | 0, _block, _state, _trace =>
        Structured.invalid
    | _fuel + 1, ⟨[]⟩, state, trace =>
        .ok (Expressions.Outcome.regular state, trace)
    | fuel + 1, ⟨stmt :: rest⟩, state, trace => do
        let (outcome, trace') ←
          Stmt.runWithOracle asmProgram pc program fuel stmt state trace
        match outcome.mode with
        | .regular =>
            Block.runWithOracle asmProgram pc program fuel ⟨rest⟩
              outcome.state trace'
        | .brk | .cont | .leave | .halt _ =>
            .ok (outcome, trace')
  termination_by fuel block _state _trace => (fuel, 0, sizeOf block)

  def Stmt.runForLoopWithOracle (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program) :
      Nat → Expressions.Expr 1 → Expressions.Block → Expressions.Block →
        Expressions.RunState → Trace →
          Except EVMException (Expressions.Outcome × Trace)
    | 0, _cond, _post, _body, _state, _trace =>
        Structured.invalid
    | fuel + 1, cond, post, body, state, trace =>
        match Expr.runCodeConditionWithOracle asmProgram pc cond state trace with
        | .error err => .error err
        | .ok (stateAfterCond, condTrue, traceAfterCond) =>
            if condTrue then
              match Block.runWithOracle asmProgram pc program fuel body
                  stateAfterCond traceAfterCond with
              | .error err => .error err
              | .ok (bodyOutcome, traceAfterBody) =>
                  match bodyOutcome.mode with
                  | .brk =>
                      .ok (Expressions.Outcome.regular bodyOutcome.state,
                        traceAfterBody)
                  | .regular | .cont =>
                      match Block.runWithOracle asmProgram pc program fuel post
                          bodyOutcome.state traceAfterBody with
                      | .error err => .error err
                      | .ok (postOutcome, traceAfterPost) =>
                          match postOutcome.mode with
                          | .regular =>
                              Stmt.runForLoopWithOracle asmProgram pc program
                                fuel cond post body postOutcome.state
                                traceAfterPost
                          | .brk | .cont =>
                              Structured.invalid
                          | .leave | .halt _ =>
                              .ok (postOutcome, traceAfterPost)
                  | .leave | .halt _ =>
                      .ok (bodyOutcome, traceAfterBody)
            else
              .ok (Expressions.Outcome.regular stateAfterCond, traceAfterCond)
  termination_by fuel _cond _post _body _state _trace => (fuel, 2, 0)

  def Stmt.runWithOracle (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program) :
      Nat → Expressions.Stmt → Expressions.RunState → Trace →
        Except EVMException (Expressions.Outcome × Trace)
    | _fuel, .code code, state, trace => do
        let (evm', trace') ←
          StructuredReplay.Code.runWithOracle asmProgram pc code state.evm trace
        .ok (Expressions.Outcome.regular (state.withEVM evm'), trace')
    | _fuel, .expr expr, state, trace => do
        let (evm', trace') ←
          Expr.runCodeExprWithOracle asmProgram pc expr state.evm trace
        .ok (Expressions.Outcome.regular (state.withEVM evm'), trace')
    | 0, .if_ _cond _body, _state, _trace =>
        Structured.invalid
    | fuel + 1, .if_ cond body, state, trace =>
        match Expr.runCodeConditionWithOracle asmProgram pc cond state trace with
        | .error err => .error err
        | .ok (stateAfterCond, condTrue, traceAfterCond) =>
            if condTrue then
              Block.runWithOracle asmProgram pc program fuel body
                stateAfterCond traceAfterCond
            else
              .ok (Expressions.Outcome.regular stateAfterCond, traceAfterCond)
    | 0, .switch _scrutinee _cases _defaultBody, _state, _trace =>
        Structured.invalid
    | fuel + 1, .switch scrutinee cases defaultBody, state, trace => do
        let (evmAfterScrutinee, traceAfterScrutinee) ←
          Expr.runCodeExprWithOracle asmProgram pc scrutinee state.evm trace
        match evmAfterScrutinee.stack.pop with
        | none =>
            .error .StackUnderflow
        | some ⟨stack, value⟩ =>
            let evmAfterPop := { evmAfterScrutinee with stack := stack }
            let stateAfterPop := state.withEVM evmAfterPop
            match Expressions.Switch.select value cases defaultBody with
            | some body =>
                Block.runWithOracle asmProgram pc program fuel body
                  stateAfterPop traceAfterScrutinee
            | none =>
                .ok (Expressions.Outcome.regular stateAfterPop,
                  traceAfterScrutinee)
    | 0, .for_ _init _cond _post _body, _state, _trace =>
        Structured.invalid
    | fuel + 1, .for_ init cond post body, state, trace => do
        let (initOutcome, traceAfterInit) ←
          Block.runWithOracle asmProgram pc program fuel init state trace
        match initOutcome.mode with
        | .regular =>
            Stmt.runForLoopWithOracle asmProgram pc program fuel cond post body
              initOutcome.state traceAfterInit
        | .brk | .cont =>
            Structured.invalid
        | .leave | .halt _ =>
            .ok (initOutcome, traceAfterInit)
    | _fuel, .brk, state, trace =>
        .ok (Expressions.Outcome.brk state, trace)
    | _fuel, .cont, state, trace =>
        .ok (Expressions.Outcome.cont state, trace)
    | _fuel, .leave, state, trace =>
        match state.returns with
        | [] => Structured.invalid
        | _ :: _ => .ok (Expressions.Outcome.leave state, trace)
    | 0, .call _name, _state, _trace =>
        Structured.invalid
    | fuel + 1, .call name, state, trace =>
        match Expressions.ProcList.lookup? name program.procs with
        | none =>
            Structured.invalid
        | some proc =>
            match Structured.StackFrame.splitArgs? proc.argc state.evm.stack with
            | none =>
                .error .StackUnderflow
            | some (args, callerStack) =>
                let callEVM := { state.evm with stack := args }
                let callState :=
                  (state.withEVM callEVM).pushReturn callerStack proc.retc
                match Block.runWithOracle asmProgram pc program fuel proc.body
                    callState trace with
                | .error err => .error err
                | .ok (outcome, traceAfterCall) =>
                    match outcome.mode with
                    | .regular | .leave =>
                        match outcome.state.popReturn? with
                        | none => Structured.invalid
                        | some (frame, returned) =>
                            match Structured.StackFrame.attachReturns? frame
                                outcome.state.evm.stack with
                            | none => Structured.invalid
                            | some stack =>
                                let evm := { outcome.state.evm with stack := stack }
                                .ok
                                  (Expressions.Outcome.regular
                                    (returned.withEVM evm), traceAfterCall)
                    | .brk | .cont =>
                        Structured.invalid
                    | .halt kind =>
                        .ok
                          (Expressions.Outcome.halt kind outcome.state,
                            traceAfterCall)
    | _fuel, .terminal kind, state, trace => do
        let evm ← Structured.Terminal.step kind state.evm
        .ok (Expressions.Outcome.halt kind (state.withEVM evm), trace)
  termination_by fuel stmt _state _trace => (fuel, 3, sizeOf stmt)

  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | exact Prod.Lex.right _
          (Prod.Lex.left _ _ (by omega))
end

set_option maxHeartbeats 1200000 in
mutual
  theorem Block.runWithOracle_toStructured_of_codeShaped
      (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program)
      (hProgram : ProgramCodeShaped program) :
      ∀ (fuel : Nat) (block : Expressions.Block)
        (state : Expressions.RunState) (trace : Trace),
        BlockCodeShaped block →
        Block.runWithOracle asmProgram pc program fuel block state trace =
          StructuredReplay.Block.runWithOracle asmProgram pc
            program.toStructured fuel block.toStructured state trace := by
    intro fuel block state trace hCode
    cases fuel with
    | zero =>
        cases block
        simp [Block.runWithOracle, StructuredReplay.Block.runWithOracle,
          Expressions.Block.toStructured, Structured.invalid]
    | succ fuel =>
        cases block with
        | mk stmts =>
            cases stmts with
            | nil =>
                simp [Block.runWithOracle, StructuredReplay.Block.runWithOracle,
                  Expressions.Block.toStructured,
                  Expressions.StmtList.toStructured]
            | cons stmt rest =>
                rcases hCode with ⟨hStmtCode, hRestCode⟩
                simp [Block.runWithOracle, StructuredReplay.Block.runWithOracle,
                  Expressions.Block.toStructured,
                  Expressions.StmtList.toStructured]
                rw [Stmt.runWithOracle_toStructured_of_codeShaped
                  asmProgram pc program hProgram fuel stmt state trace
                  hStmtCode]
                cases hStmt :
                    StructuredReplay.Stmt.runWithOracle asmProgram pc
                      program.toStructured fuel stmt.toStructured state trace with
                | error err =>
                    simp [hStmt]
                | ok stmtResult =>
                    rcases stmtResult with ⟨outcome, traceAfterStmt⟩
                    simp [hStmt]
                    cases outcome.mode <;>
                      simp [Expressions.Block.toStructured,
                        Block.runWithOracle_toStructured_of_codeShaped
                          asmProgram pc program hProgram fuel
                          { stmts := rest } outcome.state traceAfterStmt
                          hRestCode]

  theorem Stmt.runForLoopWithOracle_toStructured_of_codeShaped
      (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program)
      (hProgram : ProgramCodeShaped program) :
      ∀ (fuel : Nat) (cond : Expressions.Expr 1)
        (post body : Expressions.Block) (state : Expressions.RunState)
        (trace : Trace),
        ExprCodeShaped cond →
        BlockCodeShaped post →
        BlockCodeShaped body →
        Stmt.runForLoopWithOracle asmProgram pc program fuel cond post body
            state trace =
          StructuredReplay.Stmt.runForLoopWithOracle asmProgram pc
            program.toStructured fuel cond.compile post.toStructured
            body.toStructured state trace := by
    intro fuel cond post body state trace hCondCode hPostCode hBodyCode
    cases fuel with
    | zero =>
        simp [Stmt.runForLoopWithOracle,
          StructuredReplay.Stmt.runForLoopWithOracle, Structured.invalid]
    | succ fuel =>
        unfold Stmt.runForLoopWithOracle
        unfold StructuredReplay.Stmt.runForLoopWithOracle
        rw [Expr.runCodeConditionWithOracle_eq_compile_of_codeShaped
          (asmProgram := asmProgram) (pc := pc) (state := state)
          (trace := trace) hCondCode]
        cases hCond :
            StructuredReplay.Code.runConditionWithOracle asmProgram pc
              cond.compile state trace with
        | error err =>
            simp [hCond]
        | ok condResult =>
            rcases condResult with
              ⟨stateAfterCond, condTrue, traceAfterCond⟩
            simp [hCond]
            cases condTrue with
            | false =>
                rfl
            | true =>
                rw [Block.runWithOracle_toStructured_of_codeShaped
                  asmProgram pc program hProgram fuel body stateAfterCond
                  traceAfterCond hBodyCode]
                cases hBody :
                    StructuredReplay.Block.runWithOracle asmProgram pc
                      program.toStructured fuel body.toStructured
                      stateAfterCond traceAfterCond with
                | error err =>
                    simp [hBody]
                | ok bodyResult =>
                    rcases bodyResult with
                      ⟨bodyOutcome, traceAfterBody⟩
                    simp [hBody]
                    cases bodyOutcome.mode with
                    | brk =>
                        rfl
                    | regular =>
                        rw [Block.runWithOracle_toStructured_of_codeShaped
                          asmProgram pc program hProgram fuel post
                          bodyOutcome.state traceAfterBody hPostCode]
                        cases hPost :
                            StructuredReplay.Block.runWithOracle asmProgram pc
                              program.toStructured fuel post.toStructured
                              bodyOutcome.state traceAfterBody with
                        | error err =>
                            simp [hPost]
                        | ok postResult =>
                            rcases postResult with
                              ⟨postOutcome, traceAfterPost⟩
                            simp [hPost, Structured.invalid]
                            cases postOutcome.mode <;>
                              simp [Structured.invalid,
                                Stmt.runForLoopWithOracle_toStructured_of_codeShaped
                                  asmProgram pc program hProgram fuel cond post
                                  body postOutcome.state traceAfterPost
                                  hCondCode hPostCode hBodyCode]
                    | cont =>
                        rw [Block.runWithOracle_toStructured_of_codeShaped
                          asmProgram pc program hProgram fuel post
                          bodyOutcome.state traceAfterBody hPostCode]
                        cases hPost :
                            StructuredReplay.Block.runWithOracle asmProgram pc
                              program.toStructured fuel post.toStructured
                              bodyOutcome.state traceAfterBody with
                        | error err =>
                            simp [hPost]
                        | ok postResult =>
                            rcases postResult with
                              ⟨postOutcome, traceAfterPost⟩
                            simp [hPost, Structured.invalid]
                            cases postOutcome.mode <;>
                              simp [Structured.invalid,
                                Stmt.runForLoopWithOracle_toStructured_of_codeShaped
                                  asmProgram pc program hProgram fuel cond post
                                  body postOutcome.state traceAfterPost
                                  hCondCode hPostCode hBodyCode]
                    | leave =>
                        rfl
                    | halt kind =>
                        rfl

  theorem Stmt.runWithOracle_toStructured_of_codeShaped
      (asmProgram : Assembly.Program) (pc : Nat)
      (program : Expressions.Program)
      (hProgram : ProgramCodeShaped program) :
      ∀ (fuel : Nat) (stmt : Expressions.Stmt)
        (state : Expressions.RunState) (trace : Trace),
        StmtCodeShaped stmt →
        Stmt.runWithOracle asmProgram pc program fuel stmt state trace =
          StructuredReplay.Stmt.runWithOracle asmProgram pc
            program.toStructured fuel stmt.toStructured state trace := by
    intro fuel stmt state trace hCode
    cases stmt with
    | code code =>
        simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
          Expressions.Stmt.toStructured]
    | expr expr =>
        simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
          Expressions.Stmt.toStructured,
          Expr.runCodeExprWithOracle_eq_compile_of_codeShaped hCode]
    | if_ cond body =>
        rcases hCode with ⟨hCondCode, hBodyCode⟩
        cases fuel with
        | zero =>
            simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
              Expressions.Stmt.toStructured, Structured.invalid]
        | succ fuel =>
            unfold Stmt.runWithOracle
            unfold StructuredReplay.Stmt.runWithOracle
            simp [Expressions.Stmt.toStructured]
            rw [Expr.runCodeConditionWithOracle_eq_compile_of_codeShaped
              (asmProgram := asmProgram) (pc := pc) (state := state)
              (trace := trace) hCondCode]
            cases hCond :
                StructuredReplay.Code.runConditionWithOracle asmProgram pc
                  cond.compile state trace with
            | error err =>
                simp [hCond]
            | ok condResult =>
                rcases condResult with
                  ⟨stateAfterCond, condTrue, traceAfterCond⟩
                simp [hCond]
                cases condTrue with
                | false =>
                    rfl
                | true =>
                    exact
                      Block.runWithOracle_toStructured_of_codeShaped
                        asmProgram pc program hProgram fuel body
                        stateAfterCond traceAfterCond hBodyCode
    | switch scrutinee cases defaultBody =>
        rcases hCode with ⟨hScrutineeCode, hCasesCode, hDefaultCode⟩
        cases fuel with
        | zero =>
            simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
              Expressions.Stmt.toStructured, Structured.invalid]
        | succ fuel =>
            unfold Stmt.runWithOracle
            unfold StructuredReplay.Stmt.runWithOracle
            simp [Expressions.Stmt.toStructured]
            rw [Expr.runCodeExprWithOracle_eq_compile_of_codeShaped
              (asmProgram := asmProgram) (pc := pc) (state := state.evm)
              (trace := trace) hScrutineeCode]
            cases hScrutinee :
                StructuredReplay.Code.runWithOracle asmProgram pc
                  scrutinee.compile state.evm trace with
            | error err =>
                simp [hScrutinee, StructuredReplay.Code.runStateWithOracle]
            | ok scrutineeResult =>
                rcases scrutineeResult with
                  ⟨evmAfterScrutinee, traceAfterScrutinee⟩
                simp [hScrutinee, StructuredReplay.Code.runStateWithOracle]
                cases hPop : evmAfterScrutinee.stack.pop with
                | none =>
                    simp [hPop]
                | some pair =>
                    rcases pair with ⟨stack, value⟩
                    simp [hPop]
                    rw [Expressions.Switch.select_toStructured value cases
                      defaultBody]
                    cases hSelected :
                        Expressions.Switch.select value cases defaultBody with
                    | none =>
                        simp [hSelected]
                    | some selected =>
                        simp [hSelected]
                        have hSelectedCode :
                            BlockCodeShaped selected :=
                          CaseListCodeShaped.of_select
                            hCasesCode hDefaultCode hSelected
                        exact
                          Block.runWithOracle_toStructured_of_codeShaped
                            asmProgram pc program hProgram fuel selected
                            (state.withEVM
                              { evmAfterScrutinee with stack := stack })
                            traceAfterScrutinee hSelectedCode
    | for_ init cond post body =>
        rcases hCode with
          ⟨hInitCode, hCondCode, hPostCode, hBodyCode⟩
        cases fuel with
        | zero =>
            simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
              Expressions.Stmt.toStructured, Structured.invalid]
        | succ fuel =>
            unfold Stmt.runWithOracle
            unfold StructuredReplay.Stmt.runWithOracle
            simp [Expressions.Stmt.toStructured]
            rw [Block.runWithOracle_toStructured_of_codeShaped
              asmProgram pc program hProgram fuel init state trace hInitCode]
            cases hInit :
                StructuredReplay.Block.runWithOracle asmProgram pc
                  program.toStructured fuel init.toStructured state trace with
            | error err =>
                simp [hInit]
            | ok initResult =>
                rcases initResult with ⟨initOutcome, traceAfterInit⟩
                simp [hInit, Structured.invalid]
                cases initOutcome.mode <;>
                  simp [Structured.invalid,
                    Stmt.runForLoopWithOracle_toStructured_of_codeShaped
                      asmProgram pc program hProgram fuel cond post body
                      initOutcome.state traceAfterInit hCondCode hPostCode
                      hBodyCode]
    | brk =>
        simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
          Expressions.Stmt.toStructured]
    | cont =>
        simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
          Expressions.Stmt.toStructured]
    | leave =>
        cases hReturns : state.returns <;>
          simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
            Expressions.Stmt.toStructured, Structured.invalid, hReturns,
            Structured.Outcome.leave]
    | call name =>
        cases fuel with
        | zero =>
            simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
              Expressions.Stmt.toStructured, Structured.invalid]
        | succ fuel =>
            unfold Stmt.runWithOracle
            unfold StructuredReplay.Stmt.runWithOracle
            simp [Expressions.Stmt.toStructured]
            rw [Expressions.ProcList.lookup?_program_toStructured name program]
            cases hLookup :
                Expressions.ProcList.lookup? name program.procs with
            | none =>
                rfl
            | some proc =>
                have hProcCode : ProcCodeShaped proc :=
                  ProcListCodeShaped.of_lookup? hProgram.1 hLookup
                simp [hLookup, Expressions.Proc.toStructured]
                cases hSplit :
                    Structured.StackFrame.splitArgs? proc.argc
                      state.evm.stack with
                | none =>
                    simp [hSplit]
                | some split =>
                    rcases split with ⟨args, callerStack⟩
                    simp [hSplit]
                    rw [Block.runWithOracle_toStructured_of_codeShaped
                      asmProgram pc program hProgram fuel proc.body
                      ((state.withEVM { state.evm with stack := args }).pushReturn
                        callerStack proc.retc) trace hProcCode]
                    cases hBody :
                        StructuredReplay.Block.runWithOracle asmProgram pc
                          program.toStructured fuel proc.body.toStructured
                          ((state.withEVM { state.evm with stack := args }).pushReturn
                            callerStack proc.retc) trace with
                    | error err =>
                        simp [hBody]
                    | ok bodyResult =>
                        rcases bodyResult with
                          ⟨outcome, traceAfterCall⟩
                        simp [hBody, Structured.invalid]
    | terminal kind =>
        simp [Stmt.runWithOracle, StructuredReplay.Stmt.runWithOracle,
          Expressions.Stmt.toStructured, Structured.Terminal.step]
end

