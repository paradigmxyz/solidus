theorem oracleRelSafe_gas :
    BasicInstr.OracleRelSafe (Structured.BasicInstr.op .gas) := by
  intro program pc source target source' trace trace' hData hStep
  cases trace with
  | nil =>
      simp [stepWithOracle_gas] at hStep
  | cons observation rest =>
      cases observation with
      | mk kind value =>
          cases kind
          · simp [stepWithOracle_gas] at hStep
            rcases hStep with ⟨hSource', hTrace'⟩
            subst source'
            subst trace'
            let post :=
              target.replaceStackAndIncrPC
                (target.stack.push
                  (EvmYul.MachineState.gas target.toMachineState))
            let target' :=
              { post with stack := value :: target.stack }
            have hTargetPost :
                Assembly.Target.stepInstr
                    (Assembly.TargetInstr.prim Assembly.PrimOp.gas)
                    target =
                  .ok post := by
              change
                EvmYul.EVM.machineStateOp EvmYul.MachineState.gas target =
                  .ok post
              simp [post, EvmYul.EVM.machineStateOp, Id.run,
                EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC, EvmYul.Stack.push,
                EvmYul.MachineState.gas]
            refine ⟨target', ?_, ?_, ?_⟩
            · have hTargetRun :
                  BasicInstr.stepWithOracle program pc
                      (Structured.BasicInstr.op .gas) target
                      ({ kind := .gas, value := value } :: rest) =
                    .ok (target', rest) := by
                simpa [target', post] using
                  stepWithOracle_gas program pc target
                    ({ kind := .gas, value := value } :: rest)
              exact
                BasicInstr.stepAtResultWithOracle_running_of_stepWithOracle
                  hTargetRun
            · cases source
              cases target
              simp [Structured.Preservation.SameData,
                Structured.Preservation.eraseControl, Assembly.eraseGas,
                EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC, EvmYul.Stack.push, post,
                target'] at hData ⊢
              exact ⟨hData.1, by simpa [hData.2]⟩
            · simp [target', Structured.BasicInstr.toAssembly,
                Structured.BasicOp.toPrimOp, Assembly.Instr.byteSize,
                EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC, post]
          · simp [stepWithOracle_gas] at hStep

