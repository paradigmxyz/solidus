theorem runWithOracle_nil (asmProgram : Assembly.Program) (pc : Nat)
    (program : Expressions.Program) (fuel : Nat)
    (state : Expressions.RunState) (trace : Trace) :
    runWithOracle asmProgram pc program (fuel + 1) { stmts := [] }
        state trace =
      .ok (Expressions.Outcome.regular state, trace) := by
  simp [runWithOracle]

theorem runWithOracle_cons_regular_of_runs
    {asmProgram : Assembly.Program} {pc fuel : Nat}
    {program : Expressions.Program} {stmt : Expressions.Stmt}
    {rest : List Expressions.Stmt}
    {state stateAfterStmt : Expressions.RunState}
    {trace traceAfterStmt : Trace}
    {result : Expressions.Outcome × Trace}
    (hStmt :
      Stmt.runWithOracle asmProgram pc program fuel stmt state trace =
        .ok
          (Expressions.Outcome.regular stateAfterStmt, traceAfterStmt))
    (hRest :
      runWithOracle asmProgram pc program fuel { stmts := rest }
          stateAfterStmt traceAfterStmt =
        .ok result) :
    runWithOracle asmProgram pc program (fuel + 1)
        { stmts := stmt :: rest } state trace =
      .ok result := by
  simp [runWithOracle, hStmt, hRest, Expressions.Outcome.regular,
    Structured.Outcome.regular]

theorem runWithOracle_cons_codeStmt_append_regular_of_runs
    {asmProgram : Assembly.Program} {pc fuel : Nat}
    {program : Expressions.Program} {stmt : Expressions.Stmt}
    {cleanup : Structured.Code} {rest : List Expressions.Stmt}
    {state stateAfterHead : Expressions.RunState}
    {trace traceAfterHead : Trace}
    {result : Expressions.Outcome × Trace}
    (hHead :
      runWithOracle asmProgram pc program (((fuel + 1) + 1) + 1)
          { stmts := stmt :: Locals.codeStmt cleanup } state trace =
        .ok (Expressions.Outcome.regular stateAfterHead, traceAfterHead))
    (hRest :
      runWithOracle asmProgram pc program (fuel + 1) { stmts := rest }
          stateAfterHead traceAfterHead =
        .ok result) :
    runWithOracle asmProgram pc program (((fuel + 1) + 1) + 1)
        { stmts := stmt :: Locals.codeStmt cleanup ++ rest } state trace =
      .ok result := by
  simp [runWithOracle, Locals.codeStmt] at hHead ⊢
  cases hStmt :
      Stmt.runWithOracle asmProgram pc program ((fuel + 1) + 1) stmt state
        trace with
  | error err =>
      simp [hStmt] at hHead
  | ok stmtResult =>
      rcases stmtResult with ⟨stmtOutcome, traceAfterStmt⟩
      cases stmtOutcome with
      | mk stateAfterStmt mode =>
          cases mode <;> simp [hStmt] at hHead ⊢
          · cases hCode :
                Stmt.runWithOracle asmProgram pc program (fuel + 1)
                  (Expressions.Stmt.code cleanup) stateAfterStmt
                  traceAfterStmt with
            | error err =>
                simp [hCode] at hHead
            | ok codeResult =>
                rcases codeResult with ⟨codeOutcome, traceAfterCode⟩
                cases codeOutcome with
                | mk stateAfterCode codeMode =>
                    cases codeMode <;> simp [hCode] at hHead ⊢
                    · rcases hHead with ⟨hState, hTrace⟩
                      cases hState
                      cases hTrace
                      exact hRest
                    all_goals
                      exact False.elim (by cases hHead.1)
          all_goals
            exact False.elim (by cases hHead.1)

theorem runWithOracle_cons_codeStmt_append_regular_of_runs_slack
    {asmProgram : Assembly.Program} {pc fuel : Nat}
    {program : Expressions.Program} {stmt : Expressions.Stmt}
    {cleanup : Structured.Code} {rest : List Expressions.Stmt}
    {state stateAfterHead : Expressions.RunState}
    {trace traceAfterHead : Trace}
    {result : Expressions.Outcome × Trace}
    (hHead :
      runWithOracle asmProgram pc program (((fuel + 1) + 1) + 1)
          { stmts := stmt :: Locals.codeStmt cleanup } state trace =
        .ok (Expressions.Outcome.regular stateAfterHead, traceAfterHead))
    (hRest :
      runWithOracle asmProgram pc program ((fuel + 1) + 1)
          { stmts := rest } stateAfterHead traceAfterHead =
        .ok result) :
    runWithOracle asmProgram pc program ((((fuel + 1) + 1) + 1) + 1)
        { stmts := stmt :: Locals.codeStmt cleanup ++ rest } state trace =
      .ok result := by
  have hHeadSlack :
      runWithOracle asmProgram pc program ((((fuel + 1) + 1) + 1) + 1)
          { stmts := stmt :: Locals.codeStmt cleanup } state trace =
        .ok (Expressions.Outcome.regular stateAfterHead, traceAfterHead) :=
    Block.runWithOracle_mono asmProgram pc program (by omega) hHead
  exact
    runWithOracle_cons_codeStmt_append_regular_of_runs
      (asmProgram := asmProgram) (pc := pc) (fuel := fuel + 1)
      (program := program) (stmt := stmt) (cleanup := cleanup) (rest := rest)
      (state := state) (stateAfterHead := stateAfterHead)
      (trace := trace) (traceAfterHead := traceAfterHead)
      (result := result) hHeadSlack hRest

theorem runWithOracle_cons_codeStmt_append_regular_of_runs_restSlack
    {asmProgram : Assembly.Program} {pc fuel restSlack : Nat}
    {program : Expressions.Program} {stmt : Expressions.Stmt}
    {cleanup : Structured.Code} {rest : List Expressions.Stmt}
    {state stateAfterHead : Expressions.RunState}
    {trace traceAfterHead : Trace}
    {result : Expressions.Outcome × Trace}
    (hRestSlack : 1 ≤ restSlack)
    (hHead :
      runWithOracle asmProgram pc program (((fuel + 1) + 1) + 1)
          { stmts := stmt :: Locals.codeStmt cleanup } state trace =
        .ok (Expressions.Outcome.regular stateAfterHead, traceAfterHead))
    (hRest :
      runWithOracle asmProgram pc program ((fuel + 1) + restSlack)
          { stmts := rest } stateAfterHead traceAfterHead =
        .ok result) :
    runWithOracle asmProgram pc program
        ((((fuel + 1) + restSlack) + 1) + 1)
        { stmts := stmt :: Locals.codeStmt cleanup ++ rest } state trace =
      .ok result := by
  let combineFuel : Nat := (fuel + 1) + (restSlack - 1)
  have hHeadSlack :
      runWithOracle asmProgram pc program (((combineFuel + 1) + 1) + 1)
          { stmts := stmt :: Locals.codeStmt cleanup } state trace =
        .ok (Expressions.Outcome.regular stateAfterHead, traceAfterHead) := by
    exact
      Block.runWithOracle_mono asmProgram pc program (by
        dsimp [combineFuel]
        omega) hHead
  have hRest' :
      runWithOracle asmProgram pc program (combineFuel + 1)
          { stmts := rest } stateAfterHead traceAfterHead =
        .ok result := by
    have hFuel :
        combineFuel + 1 = (fuel + 1) + restSlack := by
      dsimp [combineFuel]
      omega
    simpa [hFuel] using hRest
  have hFull :
      runWithOracle asmProgram pc program (((combineFuel + 1) + 1) + 1)
          { stmts := stmt :: Locals.codeStmt cleanup ++ rest } state trace =
        .ok result :=
    runWithOracle_cons_codeStmt_append_regular_of_runs
      (asmProgram := asmProgram) (pc := pc) (fuel := combineFuel)
      (program := program) (stmt := stmt) (cleanup := cleanup) (rest := rest)
      (state := state) (stateAfterHead := stateAfterHead)
      (trace := trace) (traceAfterHead := traceAfterHead)
      (result := result) hHeadSlack hRest'
  have hFuel :
      (((combineFuel + 1) + 1) + 1) =
        ((((fuel + 1) + restSlack) + 1) + 1) := by
    dsimp [combineFuel]
    omega
  simpa [hFuel] using hFull

