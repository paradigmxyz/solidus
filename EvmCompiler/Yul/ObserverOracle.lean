theorem runForRegularWithOracle_cleanupTo_scope
    {asmProgram : Assembly.Program} {exprProgram : Expressions.Program}
    {sourceCtx loopCtx : Ctx} {targetLoopCtx : Locals.Ctx}
    {fuel pc : Nat} {forStmt : Expressions.Stmt}
    {source : Locals.Source.State}
    {target targetAfterLoop : Locals.RunState}
    {trace traceAfterLoop : Trace} {cleanup : Structured.Code}
    (hLoopCtx : Locals.SourceLowering.CtxRel loopCtx targetLoopCtx)
    (hCleanupScope :
      Locals.SourceLowering.CleanupScopeRel loopCtx.scope sourceCtx.scope)
    (hRel :
      Locals.SourceLowering.StateRel loopCtx.scope source targetAfterLoop)
    (hCleanup :
      targetLoopCtx.cleanupTo? sourceCtx.scope.length = some cleanup)
    (hFor :
      ExpressionsReplay.Stmt.runWithOracle asmProgram pc exprProgram
          ((fuel + 1) + 1) forStmt target trace =
        .ok (Expressions.Outcome.regular targetAfterLoop, traceAfterLoop)) :
    ∃ cleaned,
      ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
          (((fuel + 1) + 1) + 1)
          { stmts := forStmt :: Locals.codeStmt cleanup } target trace =
        .ok (Expressions.Outcome.regular cleaned, traceAfterLoop) ∧
      Locals.SourceLowering.StateRel sourceCtx.scope
        (source.restrictTo sourceCtx.scope) cleaned := by
  rcases hLoopCtx with ⟨hLayout, _hBreak, _hContinue, _hLeave, _hRetc⟩
  have hCleanupScopeTarget :
      Locals.SourceLowering.CleanupScopeRel targetLoopCtx.layout
        sourceCtx.scope := by
    simpa [hLayout] using hCleanupScope
  have hRelTarget :
      Locals.SourceLowering.StateRel targetLoopCtx.layout source
        targetAfterLoop := by
    simpa [hLayout] using hRel
  rcases
      ExpressionsReplay.Block.runWithOracle_cleanupTo_scope_exists
        (asmProgram := asmProgram) (pc := pc) (fuel := fuel)
        (program := exprProgram) (ctx := targetLoopCtx)
        (scope := sourceCtx.scope) (source := source)
        (target := targetAfterLoop) (cleanup := cleanup)
        (trace := traceAfterLoop)
        hCleanupScopeTarget hRelTarget hCleanup with
    ⟨cleaned, hCleanupRun, hCleanRel, _hReturns⟩
  refine ⟨cleaned, ?_, hCleanRel⟩
  exact
    ExpressionsReplay.Block.runWithOracle_cons_regular_of_runs
      (asmProgram := asmProgram) (pc := pc)
      (fuel := (fuel + 1) + 1) (program := exprProgram)
      (stmt := forStmt) (rest := Locals.codeStmt cleanup)
      (state := target) (stateAfterStmt := targetAfterLoop)
      (trace := trace) (traceAfterStmt := traceAfterLoop)
      (result :=
        (Expressions.Outcome.regular cleaned, traceAfterLoop))
      hFor
      (by simpa [Nat.add_assoc] using hCleanupRun)

