                                    (asmProgram := asmProgram) (pc := pc)
                                    (fuel := fuel + 1)
                                    (program := exprProgram) hRunCode)
                              rcases
                                  ih hCtxAfter hNoDupAfter hHeadRelState
                                    hRestCompile hRestRun with
                                ⟨targetOut, hRestReplay, hFinalRel,
                                  hFinalCtx⟩
                              have hReplayFull :
                                  ExpressionsReplay.Block.runWithOracle
                                      asmProgram pc exprProgram
                                      ((fuel + 1) + 1)
                                      { stmts :=
                                          Expressions.Stmt.code headCode ::
                                            restCode }
                                      target state.trace =
                                    .ok
                                      (Expressions.Outcome.regular targetOut,
                                        openState.trace) :=
                                ExpressionsReplay.Block.runWithOracle_cons_regular_of_runs
                                  (asmProgram := asmProgram) (pc := pc)
                                  (fuel := fuel + 1)
                                  (program := exprProgram)
                                  (stmt := Expressions.Stmt.code headCode)
                                  (rest := restCode)
                                  (state := target)
                                  (stateAfterStmt :=
                                    target.withEVM evmAfterHead)
                                  (trace := state.trace)
                                  (traceAfterStmt :=
                                    (stateAfterValue.insert name value).trace)
                                  (result :=
                                    (Expressions.Outcome.regular targetOut,
                                      openState.trace))
                                  hStmtReplay hRestReplay
                              exact
                                ⟨targetOut,
                                  by simpa [Locals.codeStmt] using hReplayFull,
                                  hFinalRel, hFinalCtx⟩
  case assign sourceCtx name idx expr rest hName hBound hOwned hAccess hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hHeadCode :
              Locals.Expr.compileCode targetCtx 0 expr with
          | none =>
              simp [Locals.Block.compileOpen, Locals.Stmt.compile,
                hHeadCode] at hCompile
