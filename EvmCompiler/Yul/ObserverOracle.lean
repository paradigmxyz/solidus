        .ok (.running target', trace) := by
    unfold Assembly.Source.runNResultWithOracle
    rw [hStepOracle']
    simp [Assembly.Source.runNResultWithOracle]
  refine ARunResultWithOracle.exact hRunOne ?_
  exact
    ⟨rfl,
