theorem compileOpen_atomicIfPrefixBlockWithOracle
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {exprProgram : Expressions.Program} :
    ∀ {sourceCtx : Ctx} {targetCtx : Locals.Ctx}
      {fuel pc : Nat} {stmts : List Locals.Stmt}
      {state openState : State} {target : Locals.RunState}
      {code : List Expressions.Stmt}
      {sourceCtxOut : Ctx} {targetCtxOut : Locals.Ctx},
      AtomicIfPrefix sourceCtx stmts →
      Locals.SourceLowering.CtxRel sourceCtx targetCtx →
      sourceCtx.scope.Nodup →
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target →
      Locals.Block.compileOpen targetCtx { stmts := stmts } =
        some (code, targetCtxOut) →
      Block.runOpen program sourceCtx fuel { stmts := stmts } state =
        .ok (Outcome.regular openState, sourceCtxOut) →
      ∃ targetOut,
        ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
            (fuel + 1) { stmts := code } target state.trace =
          .ok (Expressions.Outcome.regular targetOut, openState.trace) ∧
        Locals.SourceLowering.StateRel sourceCtxOut.scope
          openState.source targetOut ∧
        Locals.SourceLowering.CtxRel sourceCtxOut targetCtxOut := by
  intro sourceCtx targetCtx fuel pc stmts state openState target code
    sourceCtxOut targetCtxOut hPrefix hCtx hNoDup hRel hCompile hRun
  induction hPrefix generalizing targetCtx fuel pc state openState target code
      sourceCtxOut targetCtxOut
  case nil sourceCtx =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Locals.Block.compileOpen] at hCompile
          rcases hCompile with ⟨hCode, hTargetCtxOut⟩
          subst code
          subst targetCtxOut
          simp [Block.runOpen] at hRun
          rcases hRun with ⟨hOpenState, hSourceCtxOut⟩
          cases hOpenState
          cases hSourceCtxOut
          refine ⟨target, ?_, hRel, hCtx⟩
          exact
            ExpressionsReplay.Block.runWithOracle_nil asmProgram pc exprProgram
              (fuel + 1) target state.trace
  case expr sourceCtx expr rest hOwned hAccess hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hHeadCode :
              Locals.Expr.compileCode targetCtx 0 expr with
          | none =>
              simp [Locals.Block.compileOpen, Locals.Stmt.compile,
                hHeadCode] at hCompile
          | some headCode =>
              cases hRestCompile :
                  Locals.Block.compileOpen targetCtx { stmts := rest } with
              | none =>
                  simp [Locals.Block.compileOpen, Locals.Stmt.compile,
                    hHeadCode, hRestCompile] at hCompile
              | some restResult =>
                  rcases restResult with ⟨restCode, restTargetCtxOut⟩
                  simp [Locals.Block.compileOpen, Locals.Stmt.compile,
                    hHeadCode, hRestCompile] at hCompile
                  rcases hCompile with ⟨hCode, hTargetCtxOut⟩
                  subst code
                  subst targetCtxOut
                  simp [Block.runOpen] at hRun
                  cases hEval : Expr.eval expr state with
                  | error err =>
                      simp [Stmt.run, hEval] at hRun
                  | ok evalResult =>
                      rcases evalResult with ⟨stateAfterExpr, values⟩
                      simp [Stmt.run, hEval] at hRun
                      cases hRestRun :
                          Block.runOpen program sourceCtx fuel
                            { stmts := rest } stateAfterExpr with
                      | error err =>
                          rw [hRestRun] at hRun
                          simp at hRun
                      | ok restRunResult =>
                          rcases restRunResult with
                            ⟨restOutcome, restSourceCtxOut⟩
                          rw [hRestRun] at hRun
                          simp [Outcome.regular] at hRun
                          rcases hRun with ⟨hOpenState, hSourceCtxOut⟩
                          cases restOutcome with
                          | mk restState restMode =>
                              cases restMode <;> simp [Outcome.regular] at hOpenState
                              cases hOpenState
                              cases hSourceCtxOut
                              rcases
                                  Stmt.compileExprWithOracle_of_eval_sourceOwned
                                    (asmProgram := asmProgram)
                                    (program := program)
                                    (sourceCtx := sourceCtx)
                                    (targetCtx := targetCtx)
                                    (fuel := fuel + 1) (pc := pc)
                                    (expr := expr) (state := state)
                                    (stateAfterExpr := stateAfterExpr)
                                    (values := values) (target := target)
                                    (code := headCode)
                                    hCtx hNoDup hOwned hAccess hRel
                                    hHeadCode hEval with
                                ⟨evmAfterHead, _hCompileStmt, _hStmtRun,
                                  hRunCode, hHeadRel, _hCtxHead⟩
                              have hStmtReplay :
                                  ExpressionsReplay.Stmt.runWithOracle
                                      asmProgram pc exprProgram (fuel + 1)
                                      (Expressions.Stmt.code headCode)
                                      target state.trace =
                                    .ok
                                      (Expressions.Outcome.regular
                                        (target.withEVM evmAfterHead),
                                        stateAfterExpr.trace) :=
                                ExpressionsReplay.Stmt.runWithOracle_code_of_run
                                  (asmProgram := asmProgram) (pc := pc)
                                  (fuel := fuel + 1)
                                  (program := exprProgram) hRunCode
                              rcases
                                  ih hCtx hNoDup hHeadRel hRestCompile
                                    hRestRun with
                                ⟨targetOut, hRestReplay, hFinalRel,
                                  hFinalCtx⟩
                              have hReplayFull :
                                  ExpressionsReplay.Block.runWithOracle
                                      asmProgram pc exprProgram
                                      ((fuel + 1) + 1)
                                      { stmts :=
                                          Expressions.Stmt.code headCode ::
                                            restCode }
                                      target state.trace =
                                    .ok
                                      (Expressions.Outcome.regular targetOut,
                                        openState.trace) :=
                                ExpressionsReplay.Block.runWithOracle_cons_regular_of_runs
                                  (asmProgram := asmProgram) (pc := pc)
                                  (fuel := fuel + 1)
                                  (program := exprProgram)
                                  (stmt := Expressions.Stmt.code headCode)
                                  (rest := restCode)
                                  (state := target)
                                  (stateAfterStmt :=
                                    target.withEVM evmAfterHead)
                                  (trace := state.trace)
                                  (traceAfterStmt := stateAfterExpr.trace)
                                  (result :=
                                    (Expressions.Outcome.regular targetOut,
                                      openState.trace))
                                  hStmtReplay hRestReplay
                              exact
                                ⟨targetOut,
                                  by simpa [Locals.codeStmt] using hReplayFull,
                                  hFinalRel, hFinalCtx⟩
  case let_ sourceCtx name expr rest hOwned hAccess hFresh hRest ih =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hHeadCode :
              Locals.Expr.compileCode targetCtx 0 expr with
          | none =>
              simp [Locals.Block.compileOpen, Locals.Stmt.compile,
                hHeadCode] at hCompile
          | some headCode =>
              let sourceCtxAfter : Ctx :=
