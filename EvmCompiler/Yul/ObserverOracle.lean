theorem target_run_result_unique
    {target : Assembly.TargetProgram} {fuel : Nat} {initial : EVMState}
    {trace rest₁ rest₂ : Trace}
    {result₁ result₂ : Assembly.StepResult}
    (h₁ :
      Assembly.Target.runNResultWithOracle target fuel initial trace =
        .ok (result₁, rest₁))
    (h₂ :
      Assembly.Target.runNResultWithOracle target fuel initial trace =
        .ok (result₂, rest₂)) :
    result₁ = result₂ ∧ rest₁ = rest₂ := by
  rw [h₁] at h₂
  cases h₂
  exact ⟨rfl, rfl⟩

