            (loopOutcome.state.restrictTo sourceCtx.scope),
            sourceCtx) ∧
      ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
          (((fuel + 1) + 1) + 1)
          { stmts :=
              Expressions.Stmt.for_ { stmts := initCode }
                (Expressions.Expr.code (results := 1) condCode)
                lowerPost lowerBody :: Locals.codeStmt cleanup }
          target state.trace =
        .ok (Expressions.Outcome.regular targetOut,
          loopOutcome.state.trace) ∧
      Locals.SourceLowering.StateRel sourceCtx.scope
        (loopOutcome.state.restrictTo sourceCtx.scope).source targetOut ∧
      Locals.SourceLowering.CtxRel sourceCtx targetCtx := by
  let finalState := loopOutcome.state.restrictTo sourceCtx.scope
  have hCompileRest :
      Locals.Block.compileOpen targetCtx { stmts := ([] : List Locals.Stmt) } =
        some (([] : List Expressions.Stmt), targetCtx) := by
    simp [Locals.Block.compileOpen]
  have hRestRun :
      Block.runOpen program sourceCtx (fuel + 1)
          { stmts := ([] : List Locals.Stmt) } finalState =
        .ok (Outcome.regular finalState, sourceCtx) := by
    simp [Block.runOpen, finalState]
  rcases
      compileOpen_cons_forRegularAtomicSwitchBlocksWithOracle_of_runForLoop
        (asmProgram := asmProgram) (program := program)
        (exprProgram := exprProgram) (sourceCtx := sourceCtx)
        (loopCtx := loopCtx) (sourceCtxOut := sourceCtx)
        (targetCtx := targetCtx) (targetLoopCtx := targetLoopCtx)
        (postTargetCtx := postTargetCtx)
        (bodyTargetCtx := bodyTargetCtx) (targetCtxOut := targetCtx)
        (fuel := fuel) (pc := pc) (init := init) (post := post)
        (body := body) (cond := cond) (rest := [])
        (state := state) (stateAfterInit := stateAfterInit)
        (loopOutcome := loopOutcome)
        (outcome := Outcome.regular finalState) (target := target)
        (initCode := initCode) (postCode := postCode)
        (bodyCode := bodyCode) (restCode := [])
        (condCode := condCode) (cleanup := cleanup)
        (lowerPost := lowerPost) (lowerBody := lowerBody)
