          · simpa [finalState] using
              ExpressionsReplay.Block.runWithOracle_nil asmProgram pc
                exprProgram fuel targetAfterFor finalState.trace
          · simp [Outcome.regular]) with
    ⟨targetOut, hCompile, hRun, hReplay, hModeFinal, hFinalRel,
      hFinalCtx⟩
  refine ⟨targetOut, ?_, ?_, ?_, hFinalRel, hFinalCtx⟩
  · simpa [Locals.Block.compileOpen] using hCompile
  · simpa [finalState] using hRun
  · simpa [finalState, State.restrictTo, Outcome.regular] using hReplay

