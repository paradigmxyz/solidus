theorem runConditionWithOracle_jumpi_result_ctx
    {code : Structured.Code} {label : Assembly.Label} {dest : Nat}
    {pre post : Assembly.Program}
    {source final : Structured.RunState} {target : EVMState}
    {tokens : List Word} {condTrue : Bool}
    {trace trace' : Trace}
    (hRelSafe : Code.OracleRelSafe code)
    (hFrame : Code.OracleFrameSafe code)
    (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc
          (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
          label = some dest)
    (hRun :
      Code.runConditionWithOracle
        (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
        (Assembly.Program.byteLength pre) code source trace =
        .ok (final, condTrue, trace')) :
    ARunResultWithOracle
      (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
      target trace
      (fun result traceFinal =>
        traceFinal = trace' ∧
          match result with
          | .running target' =>
              Structured.Preservation.Frame.StateRel final target' tokens ∧
              target'.pc =
                if condTrue then
                  EvmYul.UInt256.ofNat dest
                else
                  Assembly.Program.pcAfter
                    (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label])
          | .halted _ => False) := by
  rcases
      Code.runConditionWithOracle_oracleFrameSafe_hidden_pop_exists
        hRel hFrame hRun with
    ⟨hiddenAfterCode, hiddenFinal, hHiddenCode, hHiddenPop, hHiddenRel⟩
  have hDataStart :
      Structured.Preservation.SameData target
        { source.evm with stack := target.stack } :=
    hRel.dataRel
  rcases
      Code.runWithOracle_source_runNResultWithOracle_rel_segment
        (pre := pre) (post := [Assembly.Instr.jumpi label] ++ post)
        (code := code) (source := { source.evm with stack := target.stack })
        (target := target) (source' := hiddenAfterCode)
        hRelSafe hFits hPc hDataStart
        (by simpa [List.append_assoc] using hHiddenCode) with
    ⟨targetAfterCode, hCodeRun, hDataAfterCode, hPcAfterCode⟩
  have hRelAfterCode :
      Structured.Preservation.RelAt
        (Assembly.Program.pcAfter (pre ++ code.toAssembly))
        targetAfterCode hiddenAfterCode :=
    ⟨hPcAfterCode, hDataAfterCode⟩
  have hLabel' :
      Assembly.Program.labelPc
          ((pre ++ code.toAssembly) ++ [Assembly.Instr.jumpi label] ++ post)
          label = some dest := by
    simpa [List.append_assoc] using hLabel
  rcases
      EvmCompiler.Structured.Preservation.AssemblyControl.jumpi_stepResult_ctx_relAt_of_popCondition
        (label := label) (dest := dest)
        (pre := pre ++ code.toAssembly) (post := post)
        (source := hiddenAfterCode) (target := targetAfterCode)
        (source' := hiddenFinal) (condTrue := condTrue)
        (Structured.Preservation.Code.PCFitsFrom.end hFits)
        hRelAfterCode hLabel' hHiddenPop with
    ⟨targetAfterJump, hJumpStep, hRelAfterJump⟩
  have hAtJump :
      Assembly.Program.instrAtPc
          (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
          targetAfterCode.pc.toNat =
        some (Assembly.Program.byteLength (pre ++ code.toAssembly),
          Assembly.Instr.jumpi label) := by
    unfold Assembly.Program.instrAtPc
    rw [hPcAfterCode,
      Structured.Preservation.Code.PCFitsFrom.end hFits]
    simpa [List.append_assoc] using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        (pre ++ code.toAssembly) post (Assembly.Instr.jumpi label) 0
  have hJumpOracle :
      Assembly.Source.stepResultWithOracle
          (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
          targetAfterCode trace' =
        .ok (.running targetAfterJump, trace') :=
    Assembly.Source.stepResultWithOracle_of_stepResult_observer_none
      (by simpa [List.append_assoc] using hJumpStep)
      (by
        intro pc instr hAt
        rw [hAtJump] at hAt
        cases hAt
        rfl)
  have hRunJumpOne :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
          1 targetAfterCode trace' =
        .ok (.running targetAfterJump, trace') := by
    unfold Assembly.Source.runNResultWithOracle
    rw [hJumpOracle]
    rfl
  have hRunJumpOneNested :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ ([Assembly.Instr.jumpi label] ++ post))
          1 targetAfterCode trace' =
        .ok (.running targetAfterJump, trace') := by
    simpa [List.append_assoc] using hRunJumpOne
  refine
    ARunResultWithOracle.exact
      (program :=
        pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
      (fuel := code.length + 1) (state := target) (trace := trace)
      (trace' := trace') (result := .running targetAfterJump)
      ?_ ?_
  · exact
      by
        simpa [List.append_assoc] using
          Assembly.Source.runNResultWithOracle_running_bind
            hCodeRun hRunJumpOneNested
  · exact
      ⟨rfl,
        Frame.StateRel.of_sameData_target hHiddenRel hRelAfterJump.sameData,
        by simpa [List.append_assoc] using hRelAfterJump.pc_eq⟩

