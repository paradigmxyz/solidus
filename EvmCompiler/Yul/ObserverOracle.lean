namespace BasicInstr

def stepWithOracle (program : Assembly.Program) (pc : Nat)
    (instr : Structured.BasicInstr) (state : EVMState) (trace : Trace) :
    Except EVMException (EVMState × Trace) :=
  match
      Assembly.Source.stepAtResultWithOracle program pc instr.toAssembly state
        trace with
  | .error err => .error err
  | .ok (.running state', trace') => .ok (state', trace')
  | .ok (.halted _halt, _trace') => .error .InvalidInstruction

theorem stepAtResultWithOracle_running_of_stepWithOracle
    {program : Assembly.Program} {pc : Nat}
    {instr : Structured.BasicInstr}
    {state state' : EVMState} {trace trace' : Trace}
    (hStep :
      stepWithOracle program pc instr state trace = .ok (state', trace')) :
    Assembly.Source.stepAtResultWithOracle program pc instr.toAssembly
        state trace =
      .ok (.running state', trace') := by
  unfold stepWithOracle at hStep
  cases hAt :
      Assembly.Source.stepAtResultWithOracle program pc instr.toAssembly
        state trace with
  | error err =>
      rw [hAt] at hStep
      cases hStep
  | ok pair =>
      rcases pair with ⟨result, traceMid⟩
      rw [hAt] at hStep
      cases result with
      | running mid =>
          simp at hStep
          rcases hStep with ⟨rfl, rfl⟩
          rfl
      | halted halt =>
          simp at hStep

theorem stepWithOracle_push (program : Assembly.Program) (pc : Nat)
    (value : Word) (state : EVMState) (trace : Trace) :
    stepWithOracle program pc (.push value) state trace =
      .ok
        (state.replaceStackAndIncrPC (state.stack.push value) (pcΔ := 33),
          trace) := by
  simp [stepWithOracle, Structured.BasicInstr.toAssembly,
    Assembly.Source.stepAtResultWithOracle, Assembly.Source.stepAtResult,
    Assembly.Source.stepAt, Assembly.Target.stepInstr,
    Assembly.Instr.haltKind?, Assembly.ResourceObserver.ofInstr?]

theorem stepWithOracle_op_of_replay
    {program : Assembly.Program} {pc : Nat} {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack) :
    ∃ evm',
      stepWithOracle program pc (.op op) evm trace = .ok (evm', trace') ∧
      evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  rcases
      replayPrimitiveAssemblySound.eval_step_exists
        (program := program) (pc := pc)
        hReplay hShared hStack with
    ⟨evm', hStep, hShared', hStack'⟩
  refine ⟨evm', ?_, hShared', hStack'⟩
  simp [stepWithOracle, Structured.BasicInstr.toAssembly, hStep]

theorem stepWithOracle_op_nonObserver_of_step
    {program : Assembly.Program} {pc : Nat} {op : Structured.BasicOp}
    {state state' : EVMState} {trace : Trace}
    (hObserver : basicOpObserver? op = none)
    (hStep : Structured.BasicOp.step op state = .ok state') :
    stepWithOracle program pc (.op op) state trace = .ok (state', trace) := by
  have hTargetStep :
      Assembly.Target.stepInstr
          (Assembly.TargetInstr.prim op.toPrimOp) state = .ok state' := by
    simpa [Structured.BasicOp.step] using hStep
  have hNoHalt :
      (Assembly.Instr.prim op.toPrimOp).haltKind? = none := by
    simp [Assembly.Instr.haltKind?, basicOp_toPrimOp_haltKind?_none]
  have hNoObserver :
      Assembly.ResourceObserver.ofInstr?
          (Assembly.Instr.prim op.toPrimOp) = none := by
    simpa [Assembly.ResourceObserver.ofInstr?,
      basicOp_toPrimOp_observer] using hObserver
  simp [stepWithOracle, Structured.BasicInstr.toAssembly,
    Assembly.Source.stepAtResultWithOracle, Assembly.Source.stepAtResult,
    Assembly.Source.stepAt, hTargetStep, hNoHalt, hNoObserver]

theorem stepWithOracle_op_nonObserver
    {program : Assembly.Program} {pc : Nat} {op : Structured.BasicOp}
    {state : EVMState} {trace : Trace}
    (hObserver : basicOpObserver? op = none) :
    stepWithOracle program pc (.op op) state trace =
      match Structured.BasicOp.step op state with
      | .ok state' => .ok (state', trace)
      | .error err => .error err := by
  cases hStep : Structured.BasicOp.step op state with
  | error err =>
      have hTargetStep :
          Assembly.Target.stepInstr
              (Assembly.TargetInstr.prim op.toPrimOp) state =
            .error err := by
        simpa [Structured.BasicOp.step] using hStep
      simp [stepWithOracle, Structured.BasicInstr.toAssembly,
        Assembly.Source.stepAtResultWithOracle,
        Assembly.Source.stepAtResult, Assembly.Source.stepAt,
        hTargetStep]
  | ok state' =>
      simpa [hStep] using
        (stepWithOracle_op_nonObserver_of_step
          (program := program) (pc := pc) (trace := trace)
          hObserver hStep)

def OracleStepPC (instr : Structured.BasicInstr) : Prop :=
  ∀ {program : Assembly.Program} {pc : Nat}
    {state state' : EVMState} {trace trace' : Trace},
    stepWithOracle program pc instr state trace = .ok (state', trace') →
      state'.pc =
        state.pc + EvmYul.UInt256.ofNat instr.toAssembly.byteSize

def OracleRelSafe (instr : Structured.BasicInstr) : Prop :=
  ∀ {program : Assembly.Program} {pc : Nat}
    {source target source' : EVMState} {trace trace' : Trace},
    Structured.Preservation.SameData target source →
      stepWithOracle program pc instr source trace = .ok (source', trace') →
        ∃ target',
          Assembly.Source.stepAtResultWithOracle program pc
              instr.toAssembly target trace =
            .ok (.running target', trace') ∧
          Structured.Preservation.SameData target' source' ∧
          target'.pc =
            target.pc + EvmYul.UInt256.ofNat instr.toAssembly.byteSize

theorem source_stepResultWithOracle_of_segment_stepAtResultWithOracle
    {pre post : Assembly.Program} {instr : Structured.BasicInstr}
    {state state' : EVMState} {trace trace' : Trace}
    (hFit : Structured.Preservation.PCFits pre)
    (hPc : state.pc = Assembly.Program.pcAfter pre)
    (hStep :
      Assembly.Source.stepAtResultWithOracle
        (pre ++ instr.toAssembly :: post)
        (Assembly.Program.byteLength pre) instr.toAssembly state trace =
        .ok (.running state', trace')) :
    Assembly.Source.stepResultWithOracle
        (pre ++ instr.toAssembly :: post) state trace =
      .ok (.running state', trace') := by
  unfold Assembly.Source.stepResultWithOracle
  have hAt :
      Assembly.Program.instrAtPc (pre ++ instr.toAssembly :: post)
          state.pc.toNat =
        some (Assembly.Program.byteLength pre, instr.toAssembly) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post instr.toAssembly 0
  rw [hAt]
  exact hStep

theorem oracleRelSafe_of_runnerSafe_nonObserver
    {instr : Structured.BasicInstr}
    (hSafe : Structured.Preservation.BasicInstr.RunnerSafe instr)
    (hObserver : Assembly.ResourceObserver.ofInstr? instr.toAssembly = none) :
    OracleRelSafe instr := by
  intro program pc source target source' trace trace' hData hStep
  unfold stepWithOracle at hStep
  unfold Assembly.Source.stepAtResultWithOracle at hStep
  cases hPlain :
      Assembly.Source.stepAtResult program pc instr.toAssembly source with
  | error err =>
      simp [hPlain] at hStep
  | ok result =>
      rw [hPlain] at hStep
      cases result with
      | halted halt =>
          simp [hObserver] at hStep
      | running sourceMid =>
          simp [hObserver] at hStep
          rcases hStep with ⟨hSource', hTrace'⟩
          subst source'
          subst trace'
          have hInstrStep :
              instr.step source = .ok sourceMid := by
            unfold Assembly.Source.stepAtResult at hPlain
            simp [
              Structured.Preservation.BasicInstr.source_stepAt_eq_step,
              Structured.Preservation.BasicInstr.toAssembly_haltKind?_none]
              at hPlain
            cases hInstr : instr.step source with
            | error err =>
                simp [hInstr] at hPlain
            | ok mid =>
                simp [hInstr] at hPlain
                cases hPlain
                rfl
          rcases hSafe.controlSafe hData hInstrStep with
            ⟨target', hTargetStep, hTargetData⟩
          refine ⟨target', ?_, hTargetData, ?_⟩
          · unfold Assembly.Source.stepAtResultWithOracle
            have hTargetPlain :
                Assembly.Source.stepAtResult program pc instr.toAssembly
                    target =
                  .ok (.running target') := by
              unfold Assembly.Source.stepAtResult
              simp [
                Structured.Preservation.BasicInstr.source_stepAt_eq_step,
                Structured.Preservation.BasicInstr.toAssembly_haltKind?_none,
                hTargetStep]
            simp [hTargetPlain, hObserver]
          · exact hSafe.stepPC hTargetStep

theorem oracleRelSafe_push (value : Word) :
    OracleRelSafe (Structured.BasicInstr.push value) :=
  oracleRelSafe_of_runnerSafe_nonObserver
    (Structured.Preservation.BasicInstr.push_runnerSafe value) rfl

theorem stepWithOracle_pc_of_stepPC
    {instr : Structured.BasicInstr}
    (hStepPC : Structured.Preservation.BasicInstr.StepPC instr) :
    OracleStepPC instr := by
  intro program pc state state' trace trace' hStep
  unfold stepWithOracle at hStep
  unfold Assembly.Source.stepAtResultWithOracle at hStep
  cases hPlain :
      Assembly.Source.stepAtResult program pc instr.toAssembly state with
  | error err =>
      rw [hPlain] at hStep
      cases hStep
  | ok plainResult =>
      rw [hPlain] at hStep
      have hPlainPc :
          plainResult.state.pc =
            state.pc + EvmYul.UInt256.ofNat instr.toAssembly.byteSize := by
        cases plainResult with
        | running plainState =>
            have hInstrStep :
                instr.step state = .ok plainState := by
              unfold Assembly.Source.stepAtResult at hPlain
              simp [
                Structured.Preservation.BasicInstr.source_stepAt_eq_step,
                Structured.Preservation.BasicInstr.toAssembly_haltKind?_none]
                at hPlain
              cases hInstr : instr.step state with
              | error err =>
                  simp [hInstr] at hPlain
              | ok mid =>
                  simp [hInstr] at hPlain
                  cases hPlain
                  rfl
            exact hStepPC hInstrStep
        | halted halt =>
            unfold Assembly.Source.stepAtResult at hPlain
            simp [
              Structured.Preservation.BasicInstr.source_stepAt_eq_step,
              Structured.Preservation.BasicInstr.toAssembly_haltKind?_none]
              at hPlain
            cases hInstr : instr.step state with
            | error err =>
                simp [hInstr] at hPlain
            | ok mid =>
                simp [hInstr] at hPlain
      cases hObserver :
          Assembly.ResourceObserver.ofInstr? instr.toAssembly with
      | none =>
          rw [hObserver] at hStep
          cases plainResult with
          | running plainState =>
              simp at hStep
              rcases hStep with ⟨hState, _hTrace⟩
              subst state'
              exact hPlainPc
          | halted halt =>
              simp at hStep
      | some kind =>
          rw [hObserver] at hStep
          cases hApply :
              Assembly.ResourceObserver.applyOracleFromPostState kind
                plainResult.state trace with
          | error err =>
              simp [hApply] at hStep
          | ok applyPair =>
              rcases applyPair with ⟨oracleState, traceAfter⟩
              simp [hApply] at hStep
              cases plainResult with
              | running plainState =>
                  have hOraclePc :
                      oracleState.pc = plainState.pc :=
                    Assembly.ResourceObserver.applyOracleFromPostState_pc
                      hApply
                  cases hStep
                  exact Eq.trans hOraclePc hPlainPc
              | halted halt =>
                  cases hStep

theorem oracleStepPC_of_runnerSafe
    {instr : Structured.BasicInstr}
    (hSafe : Structured.Preservation.BasicInstr.RunnerSafe instr) :
    OracleStepPC instr :=
  stepWithOracle_pc_of_stepPC hSafe.stepPC

theorem source_stepResultWithOracle_of_segment_stepWithOracle
    {pre post : Assembly.Program} {instr : Structured.BasicInstr}
    {state state' : EVMState} {trace trace' : Trace}
    (hFit : Structured.Preservation.PCFits pre)
    (hPc : state.pc = Assembly.Program.pcAfter pre)
    (hStep :
      stepWithOracle (pre ++ instr.toAssembly :: post)
          (Assembly.Program.byteLength pre) instr state trace =
        .ok (state', trace')) :
    Assembly.Source.stepResultWithOracle
        (pre ++ instr.toAssembly :: post) state trace =
      .ok (.running state', trace') := by
  unfold stepWithOracle at hStep
  have hAt :
      Assembly.Program.instrAtPc (pre ++ instr.toAssembly :: post)
          state.pc.toNat =
        some (Assembly.Program.byteLength pre, instr.toAssembly) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post instr.toAssembly 0
  unfold Assembly.Source.stepResultWithOracle
  rw [hAt]
  cases hStepAt :
      Assembly.Source.stepAtResultWithOracle
        (pre ++ instr.toAssembly :: post)
        (Assembly.Program.byteLength pre) instr.toAssembly state trace with
  | error err =>
      rw [hStepAt] at hStep
      cases hStep
  | ok stepPair =>
      rcases stepPair with ⟨stepResult, stepTrace⟩
      rw [hStepAt] at hStep
      cases stepResult with
      | running mid =>
          simp at hStep
          rcases hStep with ⟨hState, hTrace⟩
          subst mid
          subst stepTrace
          exact hStepAt
      | halted halt =>
          simp at hStep

theorem stepWithOracle_pc_irrel (program : Assembly.Program)
    (pc pc' : Nat) (instr : Structured.BasicInstr)
    (state : EVMState) (trace : Trace) :
    stepWithOracle program pc instr state trace =
      stepWithOracle program pc' instr state trace := by
  cases instr with
  | push value =>
      simp [stepWithOracle, Structured.BasicInstr.toAssembly,
        Assembly.Source.stepAtResultWithOracle,
        Assembly.Source.stepAtResult, Assembly.Source.stepAt]
  | op op =>
      simp [stepWithOracle, Structured.BasicInstr.toAssembly,
        Assembly.Source.stepAtResultWithOracle,
        Assembly.Source.stepAtResult, Assembly.Source.stepAt]

end BasicInstr

namespace Code

def byteLength (code : Structured.Code) : Nat :=
  Assembly.Program.byteLength code.toAssembly

def OracleStepPC : Structured.Code → Prop
  | [] => True
  | instr :: rest =>
      BasicInstr.OracleStepPC instr ∧ OracleStepPC rest

def OracleRelSafe : Structured.Code → Prop
  | [] => True
  | instr :: rest =>
      BasicInstr.OracleRelSafe instr ∧ OracleRelSafe rest

theorem oracleStepPC_of_runnerSafe
    {code : Structured.Code}
    (hSafe : Structured.Preservation.Code.RunnerSafe code) :
    OracleStepPC code := by
  induction hSafe with
  | nil =>
      simp [OracleStepPC]
  | cons hInstr _hRest ih =>
      exact ⟨BasicInstr.oracleStepPC_of_runnerSafe hInstr, ih⟩

theorem oracleStepPC_nil :
    OracleStepPC [] := by
  simp [OracleStepPC]

theorem oracleStepPC_append {left right : Structured.Code}
    (hLeft : OracleStepPC left) (hRight : OracleStepPC right) :
    OracleStepPC (left ++ right) := by
  induction left with
  | nil =>
      simpa using hRight
  | cons instr rest ih =>
      rcases hLeft with ⟨hInstr, hRest⟩
      exact ⟨hInstr, ih hRest⟩

theorem oracleStepPC_cons {instr : Structured.BasicInstr}
    {rest : Structured.Code}
    (hInstr : OracleStepPC [instr])
    (hRest : OracleStepPC rest) :
    OracleStepPC (instr :: rest) := by
  rcases hInstr with ⟨hInstrPc, _hNil⟩
  exact ⟨hInstrPc, hRest⟩

theorem oracleRelSafe_nil :
    OracleRelSafe [] := by
  simp [OracleRelSafe]

theorem oracleRelSafe_append {left right : Structured.Code}
    (hLeft : OracleRelSafe left) (hRight : OracleRelSafe right) :
    OracleRelSafe (left ++ right) := by
  induction left with
  | nil =>
      simpa using hRight
  | cons instr rest ih =>
      rcases hLeft with ⟨hInstr, hRest⟩
      exact ⟨hInstr, ih hRest⟩

theorem oracleRelSafe_cons {instr : Structured.BasicInstr}
    {rest : Structured.Code}
    (hInstr : OracleRelSafe [instr])
    (hRest : OracleRelSafe rest) :
    OracleRelSafe (instr :: rest) := by
  rcases hInstr with ⟨hInstrRel, _hNil⟩
  exact ⟨hInstrRel, hRest⟩

theorem oracleRelSafe_of_runnerSafe_nonObserver
    {code : Structured.Code}
    (hSafe : Structured.Preservation.Code.RunnerSafe code)
    (hNoObservers :
      ∀ instr ∈ code,
        Assembly.ResourceObserver.ofInstr? instr.toAssembly = none) :
    OracleRelSafe code := by
  induction hSafe with
  | nil =>
      simp [OracleRelSafe]
  | cons hInstr _hRest ih =>
      exact
        ⟨BasicInstr.oracleRelSafe_of_runnerSafe_nonObserver hInstr
            (hNoObservers _ (by simp)),
          ih (by
            intro instr hMem
            exact hNoObservers instr (by simp [hMem]))⟩

def runWithOracle (program : Assembly.Program) :
    Nat → Structured.Code → EVMState → Trace →
      Except EVMException (EVMState × Trace)
  | _pc, [], state, trace => .ok (state, trace)
  | pc, instr :: rest, state, trace => do
      let (state', trace') ←
        BasicInstr.stepWithOracle program pc instr state trace
      runWithOracle program
        (pc + instr.toAssembly.byteSize) rest state' trace'

def runStateWithOracle (program : Assembly.Program) (pc : Nat)
    (code : Structured.Code) (state : Structured.RunState) (trace : Trace) :
    Except EVMException (Structured.RunState × Trace) := do
  let (evm', trace') ← runWithOracle program pc code state.evm trace
  .ok (state.withEVM evm', trace')

def OracleFrameSafe (code : Structured.Code) : Prop :=
  ∀ (program : Assembly.Program) (pc : Nat)
    (state final : EVMState) (trace trace' : Trace)
    (hidden : EvmYul.Stack Word),
      runWithOracle program pc code state trace = .ok (final, trace') →
        runWithOracle program pc code
            { state with stack := state.stack ++ hidden } trace =
          .ok ({ final with stack := final.stack ++ hidden }, trace')

theorem runWithOracle_hidden_suffix_of_oracleFrameSafe
    {program : Assembly.Program} {pc : Nat} {code : Structured.Code}
    {state final : EVMState} {trace trace' : Trace}
    {hidden : EvmYul.Stack Word}
    (hFrame : OracleFrameSafe code)
    (hRun : runWithOracle program pc code state trace =
      .ok (final, trace')) :
    runWithOracle program pc code
        { state with stack := state.stack ++ hidden } trace =
      .ok ({ final with stack := final.stack ++ hidden }, trace') :=
  hFrame program pc state final trace trace' hidden hRun

theorem runStateWithOracle_hidden_suffix_of_oracleFrameSafe
    {program : Assembly.Program} {pc : Nat} {code : Structured.Code}
    {state final : Structured.RunState} {trace trace' : Trace}
    {hidden : EvmYul.Stack Word}
    (hFrame : OracleFrameSafe code)
    (hRun : runStateWithOracle program pc code state trace =
      .ok (final, trace')) :
    runWithOracle program pc code
        { state.evm with stack := state.evm.stack ++ hidden } trace =
      .ok ({ final.evm with stack := final.evm.stack ++ hidden }, trace') := by
  unfold runStateWithOracle at hRun
  cases hCode :
      runWithOracle program pc code state.evm trace with
  | error err =>
      simp [hCode] at hRun
  | ok codePair =>
      rcases codePair with ⟨evmFinal, traceMid⟩
      simp [hCode] at hRun
      rcases hRun with ⟨hFinal, hTrace⟩
      cases hFinal
      cases hTrace
      simpa [Structured.RunState.withEVM] using
        hFrame program pc state.evm evmFinal trace trace' hidden hCode

theorem runStateWithOracle_oracleFrameSafe_hidden_exists
    {source final : Structured.RunState}
    {target : EVMState} {tokens : List Word} {code : Structured.Code}
    {asm : Assembly.Program} {pc : Nat} {trace trace' : Trace}
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hOracleFrame : OracleFrameSafe code)
    (hRun :
      runStateWithOracle asm pc code source trace =
        .ok (final, trace')) :
    ∃ hiddenFinal,
      runWithOracle asm pc code
          { source.evm with stack := target.stack } trace =
        .ok (hiddenFinal, trace') ∧
      Structured.Preservation.Frame.StateRel final hiddenFinal tokens := by
  unfold runStateWithOracle at hRun
  cases hCode : runWithOracle asm pc code source.evm trace with
  | error err =>
      simp [hCode] at hRun
  | ok codePair =>
      rcases codePair with ⟨evmFinal, traceMid⟩
      simp [hCode] at hRun
      rcases hRun with ⟨hFinal, hTrace⟩
      cases hFinal
      cases hTrace
      rcases hRel.hidden_suffix with
        ⟨suffix, hTargetStack, hMaterialize⟩
      let hiddenFinal : EVMState :=
        { evmFinal with stack := evmFinal.stack ++ suffix }
      have hHiddenRun :
          runWithOracle asm pc code
              { source.evm with stack := source.evm.stack ++ suffix }
              trace =
            .ok (hiddenFinal, trace') := by
        simpa [hiddenFinal] using
          hOracleFrame asm pc source.evm evmFinal trace trace' suffix hCode
      refine ⟨hiddenFinal, ?_, ?_⟩
      · rw [hTargetStack]
        exact hHiddenRun
      · refine ⟨?_, ?_⟩
        · simpa [Structured.RunState.withEVM, hiddenFinal] using
            hMaterialize evmFinal.stack
        · simp [Structured.RunState.withEVM, hiddenFinal]

def runConditionWithOracle (program : Assembly.Program) (pc : Nat)
    (code : Structured.Code) (state : Structured.RunState) (trace : Trace) :
    Except EVMException (Structured.RunState × Bool × Trace) := do
  let (evmAfterCode, trace') ← runWithOracle program pc code state.evm trace
  let (evmAfterPop, cond) ← Structured.Code.popCondition evmAfterCode
  .ok (state.withEVM evmAfterPop, cond, trace')

theorem runConditionWithOracle_oracleFrameSafe_hidden_pop_exists
    {source final : Structured.RunState}
    {target : EVMState} {tokens : List Word} {code : Structured.Code}
    {asm : Assembly.Program} {pc : Nat} {condTrue : Bool}
    {trace trace' : Trace}
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hOracleFrame : OracleFrameSafe code)
    (hRun :
      runConditionWithOracle asm pc code source trace =
        .ok (final, condTrue, trace')) :
    ∃ hiddenAfterCode hiddenFinal,
      runWithOracle asm pc code
          { source.evm with stack := target.stack } trace =
        .ok (hiddenAfterCode, trace') ∧
      Structured.Code.popCondition hiddenAfterCode =
        .ok (hiddenFinal, condTrue) ∧
      Structured.Preservation.Frame.StateRel final hiddenFinal tokens := by
  unfold runConditionWithOracle at hRun
  cases hCode : runWithOracle asm pc code source.evm trace with
  | error err =>
      simp [hCode] at hRun
  | ok codePair =>
      rcases codePair with ⟨evmAfterCode, traceMid⟩
      simp [hCode] at hRun
      cases hPop : Structured.Code.popCondition evmAfterCode with
      | error err =>
          simp [hPop] at hRun
      | ok popPair =>
          rcases popPair with ⟨evmAfterPop, condResult⟩
          simp [hPop] at hRun
          rcases hRun with ⟨hFinal, hCond, hTrace⟩
          cases hFinal
          cases hCond
          cases hTrace
          rcases hRel.hidden_suffix with
            ⟨suffix, hTargetStack, hMaterialize⟩
          let hiddenAfterCode : EVMState :=
            { evmAfterCode with stack := evmAfterCode.stack ++ suffix }
          have hHiddenCode :
              runWithOracle asm pc code
                  { source.evm with stack := source.evm.stack ++ suffix }
                  trace =
                .ok (hiddenAfterCode, trace') := by
            simpa [hiddenAfterCode] using
              hOracleFrame asm pc source.evm evmAfterCode trace trace'
                suffix hCode
          have hHiddenPop :
              Structured.Code.popCondition hiddenAfterCode =
                .ok
                  ({ evmAfterPop with stack := evmAfterPop.stack ++ suffix },
                    condTrue) := by
            simpa [hiddenAfterCode] using
              Structured.Preservation.Frame.StateRel.popCondition_hidden_suffix
                (hidden := suffix) hPop
          refine
            ⟨hiddenAfterCode,
              { evmAfterPop with stack := evmAfterPop.stack ++ suffix },
              ?_, hHiddenPop, ?_⟩
          · rw [hTargetStack]
            exact hHiddenCode
          · refine ⟨?_, ?_⟩
            · simpa [Structured.RunState.withEVM] using
                hMaterialize evmAfterPop.stack
            · simp [Structured.RunState.withEVM]

theorem runConditionWithOracle_oracleFrameSafe_hidden_exists
    {source final : Structured.RunState}
    {target : EVMState} {tokens : List Word} {code : Structured.Code}
    {asm : Assembly.Program} {pc : Nat} {condTrue : Bool}
    {trace trace' : Trace}
    (hRel :
      Structured.Preservation.Frame.StateRel source target tokens)
    (hOracleFrame : OracleFrameSafe code)
    (hRun :
      runConditionWithOracle asm pc code source trace =
        .ok (final, condTrue, trace')) :
    ∃ hiddenFinal,
      runConditionWithOracle asm pc code
          (source.withEVM { source.evm with stack := target.stack })
          trace =
        .ok (final.withEVM hiddenFinal, condTrue, trace') ∧
      Structured.Preservation.Frame.StateRel final hiddenFinal tokens := by
  unfold runConditionWithOracle at hRun
  cases hCode : runWithOracle asm pc code source.evm trace with
  | error err =>
      simp [hCode] at hRun
  | ok codePair =>
      rcases codePair with ⟨evmAfterCode, traceMid⟩
      simp [hCode] at hRun
      cases hPop : Structured.Code.popCondition evmAfterCode with
      | error err =>
          simp [hPop] at hRun
      | ok popPair =>
          rcases popPair with ⟨evmAfterPop, condResult⟩
          simp [hPop] at hRun
          rcases hRun with ⟨hFinal, hCond, hTrace⟩
          cases hFinal
          cases hCond
          cases hTrace
          rcases hRel.hidden_suffix with
            ⟨suffix, hTargetStack, hMaterialize⟩
          let hiddenAfterCode : EVMState :=
            { evmAfterCode with stack := evmAfterCode.stack ++ suffix }
          have hHiddenCode :
              runWithOracle asm pc code
                  { source.evm with stack := source.evm.stack ++ suffix }
                  trace =
                .ok (hiddenAfterCode, trace') := by
            simpa [hiddenAfterCode] using
              hOracleFrame asm pc source.evm evmAfterCode trace trace'
                suffix hCode
          have hHiddenPop :
              Structured.Code.popCondition hiddenAfterCode =
                .ok
                  ({ evmAfterPop with stack := evmAfterPop.stack ++ suffix },
                    condTrue) := by
            simpa [hiddenAfterCode] using
              Structured.Preservation.Frame.StateRel.popCondition_hidden_suffix
                (hidden := suffix) hPop
          refine
            ⟨{ evmAfterPop with stack := evmAfterPop.stack ++ suffix },
              ?_, ?_⟩
          · rw [hTargetStack]
            unfold runConditionWithOracle
            simp [Structured.RunState.withEVM, hHiddenCode, hHiddenPop]
          · refine ⟨?_, ?_⟩
            · simpa [Structured.RunState.withEVM] using
                hMaterialize evmAfterPop.stack
            · simp [Structured.RunState.withEVM]

theorem runWithOracle_nil (program : Assembly.Program) (pc : Nat)
    (state : EVMState) (trace : Trace) :
    runWithOracle program pc [] state trace = .ok (state, trace) := rfl

theorem runWithOracle_pc_irrel (program : Assembly.Program) :
    ∀ (pc pc' : Nat) (code : Structured.Code)
      (state : EVMState) (trace : Trace),
      runWithOracle program pc code state trace =
        runWithOracle program pc' code state trace := by
  intro pc pc' code
  induction code generalizing pc pc' with
  | nil =>
      intro state trace
      simp [runWithOracle]
  | cons instr rest ih =>
      intro state trace
      unfold runWithOracle
      rw [BasicInstr.stepWithOracle_pc_irrel program pc pc' instr state trace]
      cases hStep :
          BasicInstr.stepWithOracle program pc' instr state trace with
      | error err =>
          simp [hStep]
      | ok stepResult =>
          rcases stepResult with ⟨state', trace'⟩
          simp [hStep]
          exact
            ih (pc + instr.toAssembly.byteSize)
              (pc' + instr.toAssembly.byteSize) state' trace'

theorem runConditionWithOracle_pc_irrel (program : Assembly.Program)
    (pc pc' : Nat) (code : Structured.Code)
    (state : Structured.RunState) (trace : Trace) :
    runConditionWithOracle program pc code state trace =
      runConditionWithOracle program pc' code state trace := by
  unfold runConditionWithOracle
  rw [runWithOracle_pc_irrel program pc pc' code state.evm trace]

theorem runWithOracle_of_observer_free
    {code : Structured.Code}
    (hNoObservers :
      ∀ instr ∈ code,
        Assembly.ResourceObserver.ofInstr? instr.toAssembly = none)
    (program : Assembly.Program) :
    ∀ (pc : Nat) (state : EVMState) (trace : Trace),
      runWithOracle program pc code state trace =
        match Structured.Code.run code state with
