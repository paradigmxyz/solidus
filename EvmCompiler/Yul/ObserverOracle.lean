    sourceCtxOut targetCtxOut outcome hPrefix hCtx hNoDup hRel hCompile hRun
  induction hPrefix generalizing targetCtx fuel pc state target code
      sourceCtxOut targetCtxOut outcome
  case nil sourceCtx =>
      cases fuel with
      | zero =>
          simp [Block.runOpen, invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Locals.Block.compileOpen] at hCompile
          rcases hCompile with ⟨hCode, hTargetCtxOut⟩
          subst code
          subst targetCtxOut
          simp [Block.runOpen] at hRun
          rcases hRun with ⟨hOutcome, hSourceCtxOut⟩
          subst outcome
          subst sourceCtxOut
          refine ⟨target, ?_, rfl, hRel, hCtx⟩
          simp [ExpressionsReplay.StmtList.runCodeWithOracle]
  case expr sourceCtx expr rest hOwned hAccess hRest ih =>
