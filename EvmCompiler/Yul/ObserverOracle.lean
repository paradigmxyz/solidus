namespace Program

def runState (fuel : Nat) (program : Locals.Program) (state : State) :
    Except EVMException Outcome :=
  Block.runScoped program Locals.Source.Ctx.initial program.body fuel state

def run (fuel : Nat) (program : Locals.Program) (state : EVMState)
    (trace : Trace) : Except EVMException Outcome :=
  runState fuel program (State.initial state.toSharedState trace)

inductive Eval : Nat → Locals.Program → State → Outcome → Prop where
  | ofRun {fuel : Nat} {program : Locals.Program} {initial : State}
      {outcome : Outcome}
      (hRun : runState fuel program initial = .ok outcome) :
      Eval fuel program initial outcome

theorem runState_observerFree_matches_source
    {fuel : Nat} {program : Locals.Program} {initial : State}
    {outcome : Outcome}
    (hFree : BlockObserverFree program.body)
    (hRun : runState fuel program initial = .ok outcome) :
    Locals.Source.Program.runState
        Locals.Source.PrimitiveSemantics.structured fuel program
        initial.source =
      .ok outcome.toSource ∧
    outcome.state.trace = initial.trace := by
  simpa [runState, Locals.Source.Program.runState] using
    Block.runScoped_observerFree_matches_source
      (program := program) (ctx := Locals.Source.Ctx.initial)
      (fuel := fuel) (block := program.body) (state := initial)
      (outcome := outcome) hFree hRun

theorem run_observerFree_matches_source
    {fuel : Nat} {program : Locals.Program} {state : EVMState}
    {trace : Trace} {outcome : Outcome}
    (hFree : BlockObserverFree program.body)
    (hRun : run fuel program state trace = .ok outcome) :
    Locals.Source.Program.run Locals.Source.PrimitiveSemantics.structured
        fuel program state =
      .ok outcome.toSource ∧
    outcome.state.trace = trace := by
  simpa [run, Locals.Source.Program.run, State.initial] using
    runState_observerFree_matches_source
      (program := program) (fuel := fuel)
      (initial := State.initial state.toSharedState trace)
      (outcome := outcome) hFree (by simpa [run] using hRun)

end Program

