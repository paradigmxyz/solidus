theorem compileOpen_atomicSwitchForPrefixSlackBlockWithOracle
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {exprProgram : Expressions.Program} :
    ∀ {slack : Nat} {sourceCtx : Ctx} {targetCtx : Locals.Ctx}
      {fuel pc : Nat} {stmts : List Locals.Stmt}
      {state openState : State} {target : Locals.RunState}
      {code : List Expressions.Stmt}
      {sourceCtxOut : Ctx} {targetCtxOut : Locals.Ctx},
      AtomicSwitchForPrefixSlack slack sourceCtx stmts →
      Locals.SourceLowering.CtxRel sourceCtx targetCtx →
      sourceCtx.scope.Nodup →
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target →
      Locals.Block.compileOpen targetCtx { stmts := stmts } =
        some (code, targetCtxOut) →
      Block.runOpen program sourceCtx fuel { stmts := stmts } state =
        .ok (Outcome.regular openState, sourceCtxOut) →
      ∃ targetOut,
        ExpressionsReplay.Block.runWithOracle asmProgram pc exprProgram
            (fuel + slack) { stmts := code } target state.trace =
          .ok (Expressions.Outcome.regular targetOut, openState.trace) ∧
        Locals.SourceLowering.StateRel sourceCtxOut.scope
          openState.source targetOut ∧
        Locals.SourceLowering.CtxRel sourceCtxOut targetCtxOut := by
  intro slack sourceCtx targetCtx fuel pc stmts state openState target code
    sourceCtxOut targetCtxOut hPrefix hCtx hNoDup hRel hCompile hRun
  rcases
      compileOpen_atomicSwitchForPrefixSlackBlockWithOracle_of_run
        (asmProgram := asmProgram) (program := program)
        (exprProgram := exprProgram) (slack := slack)
        (sourceCtx := sourceCtx) (targetCtx := targetCtx)
        (fuel := fuel) (pc := pc) (stmts := stmts)
        (state := state) (target := target) (code := code)
        (sourceCtxOut := sourceCtxOut) (targetCtxOut := targetCtxOut)
        (outcome := Outcome.regular openState)
        hPrefix hCtx hNoDup hRel hCompile hRun with
    ⟨targetOut, hReplay, _hMode, hFinalRel, hFinalCtx⟩
  exact
    ⟨targetOut, by simpa [Outcome.regular] using hReplay,
      by simpa [Outcome.regular] using hFinalRel, hFinalCtx⟩

theorem compileOpen_singleton_forRegularAtomicSwitchBlocksWithOracle_of_runForLoop
    {asmProgram : Assembly.Program} {program : Locals.Program}
    {exprProgram : Expressions.Program}
    {sourceCtx loopCtx : Ctx}
    {targetCtx targetLoopCtx postTargetCtx bodyTargetCtx : Locals.Ctx}
    {fuel pc : Nat} {init post body : Locals.Block}
    {cond : Locals.Expr 1}
    {state stateAfterInit : State} {loopOutcome : Outcome}
    {target : Locals.RunState}
    {initCode postCode bodyCode : List Expressions.Stmt}
    {condCode cleanup : Structured.Code}
    {lowerPost lowerBody : Expressions.Block}
    (hInitPrefix :
      AtomicSwitchPrefix sourceCtx.withoutLoopControl init.stmts)
    (hPostPrefix :
      AtomicSwitchPrefix loopCtx.withoutLoopControl post.stmts)
    (hBodyPrefix :
      AtomicSwitchPrefix
        (loopCtx.withLoopControl loopCtx.scope loopCtx.scope) body.stmts)
    (hSourceCtx : Locals.SourceLowering.CtxRel sourceCtx targetCtx)
    (hNoDupSource : sourceCtx.scope.Nodup)
    (hNoDupLoop : loopCtx.scope.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible loopCtx.scope 0 cond)
    (hRel :
      Locals.SourceLowering.StateRel sourceCtx.scope state.source target)
    (hCompileInit :
      Locals.Block.compileOpen targetCtx.withoutLoopControl init =
        some (initCode, targetLoopCtx))
    (hCompileCond :
      Locals.Expr.compileCode targetLoopCtx 0 cond = some condCode)
    (hCompilePost :
      Locals.Block.compileOpen targetLoopCtx.withoutLoopControl post =
        some (postCode, postTargetCtx))
    (hFinishPost :
      Locals.finishScoped targetLoopCtx.withoutLoopControl postTargetCtx
          postCode =
        some lowerPost)
    (hCompileBody :
      Locals.Block.compileOpen
          (targetLoopCtx.withLoopControl targetLoopCtx.layout.length) body =
        some (bodyCode, bodyTargetCtx))
    (hFinishBody :
      Locals.finishScoped
          (targetLoopCtx.withLoopControl targetLoopCtx.layout.length)
          bodyTargetCtx bodyCode =
        some lowerBody)
    (hCleanup :
      targetLoopCtx.cleanupTo? sourceCtx.scope.length = some cleanup)
    (hInitRun :
      Block.runOpen program sourceCtx.withoutLoopControl fuel init state =
        .ok (Outcome.regular stateAfterInit, loopCtx))
    (hLoopRun :
      Stmt.runForLoop program loopCtx cond loopCtx.withoutLoopControl post
          (loopCtx.withLoopControl loopCtx.scope loopCtx.scope) body fuel
          stateAfterInit =
        .ok loopOutcome)
    (hMode : loopOutcome.mode = .regular) :
    ∃ targetOut,
      Locals.Block.compileOpen targetCtx
          { stmts := [Locals.Stmt.for_ init cond post body] } =
        some
          (Expressions.Stmt.for_ { stmts := initCode }
              (Expressions.Expr.code (results := 1) condCode)
              lowerPost lowerBody :: Locals.codeStmt cleanup,
