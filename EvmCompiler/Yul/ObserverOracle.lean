theorem oracleFrameSafe_cons
    {instr : Structured.BasicInstr} {rest : Structured.Code}
    (hInstr : OracleFrameSafe [instr])
    (hRest : OracleFrameSafe rest) :
    OracleFrameSafe (instr :: rest) := by
  simpa using
    oracleFrameSafe_append
      (left := [instr]) (right := rest) hInstr hRest

theorem runWithOracle_singleton_push (program : Assembly.Program) (pc : Nat)
    (value : Word) (state : EVMState) (trace : Trace) :
    runWithOracle program pc [Structured.BasicInstr.push value] state trace =
      .ok
        (state.replaceStackAndIncrPC (state.stack.push value) (pcΔ := 33),
          trace) := by
  simp [runWithOracle, BasicInstr.stepWithOracle_push]

theorem oracleFrameSafe_singleton_push (value : Word) :
    OracleFrameSafe [Structured.BasicInstr.push value] := by
  intro program pc state final trace trace' hidden hRun
  rw [runWithOracle_singleton_push] at hRun ⊢
  cases hRun
  simp [EvmYul.Stack.push, EvmYul.EVM.State.replaceStackAndIncrPC,
    EvmYul.EVM.State.incrPC]

theorem oracleStepPC_singleton_push (value : Word) :
    OracleStepPC [Structured.BasicInstr.push value] :=
  oracleStepPC_of_runnerSafe
    (Structured.Preservation.Code.RunnerSafe.cons
      (Structured.Preservation.BasicInstr.push_runnerSafe value)
      Structured.Preservation.Code.RunnerSafe.nil)

theorem oracleRelSafe_singleton_push (value : Word) :
    OracleRelSafe [Structured.BasicInstr.push value] := by
  exact ⟨BasicInstr.oracleRelSafe_push value, by simp [OracleRelSafe]⟩

theorem runWithOracle_singleton_op_of_replay
    {program : Assembly.Program} {pc : Nat} {op : Structured.BasicOp}
    {shared shared' : EvmYul.SharedState .EVM}
    {values values' : List Word} {trace trace' : Trace}
    {evm : EVMState} {baseStack : EvmYul.Stack Word}
    (hReplay :
      replayPrimitiveSemantics.eval op shared values trace =
        .ok (shared', values', trace'))
    (hShared : evm.toSharedState = shared)
    (hStack : evm.stack = values.reverse ++ baseStack) :
    ∃ evm',
      runWithOracle program pc [Structured.BasicInstr.op op] evm trace =
        .ok (evm', trace') ∧
      evm'.toSharedState = shared' ∧
      evm'.stack = values'.reverse ++ baseStack := by
  rcases
      BasicInstr.stepWithOracle_op_of_replay
        (program := program) (pc := pc)
        hReplay hShared hStack with
    ⟨evm', hStep, hShared', hStack'⟩
  refine ⟨evm', ?_, hShared', hStack'⟩
  simp [runWithOracle, hStep]

theorem runWithOracle_singleton_op_nonObserver_of_step
    {program : Assembly.Program} {pc : Nat} {op : Structured.BasicOp}
    {state state' : EVMState} {trace : Trace}
    (hObserver : basicOpObserver? op = none)
    (hStep : Structured.BasicOp.step op state = .ok state') :
    runWithOracle program pc [Structured.BasicInstr.op op] state trace =
      .ok (state', trace) := by
  have hStepOracle :=
    BasicInstr.stepWithOracle_op_nonObserver_of_step
      (program := program) (pc := pc) (trace := trace)
      hObserver hStep
  simp [runWithOracle, hStepOracle]

theorem runWithOracle_singleton_op_nonObserver
    {program : Assembly.Program} {pc : Nat} {op : Structured.BasicOp}
    {state : EVMState} {trace : Trace}
    (hObserver : basicOpObserver? op = none) :
    runWithOracle program pc [Structured.BasicInstr.op op] state trace =
      match Structured.BasicOp.step op state with
      | .ok state' => .ok (state', trace)
      | .error err => .error err := by
  simp [runWithOracle, BasicInstr.stepWithOracle_op_nonObserver hObserver]
  cases Structured.BasicOp.step op state <;> simp

theorem oracleFrameSafe_singleton_op_nonObserver
    {op : Structured.BasicOp}
    (hObserver : basicOpObserver? op = none)
    (hFrame : Structured.Code.FrameSafe [Structured.BasicInstr.op op]) :
    OracleFrameSafe [Structured.BasicInstr.op op] := by
  intro program pc state final trace trace' hidden hRun
  rw [runWithOracle_singleton_op_nonObserver hObserver] at hRun
  cases hStep : Structured.BasicOp.step op state with
  | error err =>
      simp [hStep] at hRun
  | ok mid =>
      simp [hStep] at hRun
      rcases hRun with ⟨hFinal, hTrace⟩
      cases hFinal
      cases hTrace
      have hCodeRun :
          Structured.Code.run [Structured.BasicInstr.op op] state =
            .ok final := by
        simp [Structured.Code.run, Structured.BasicInstr.step, hStep]
      have hHiddenCode :=
        hFrame state final hidden hCodeRun
      have hHiddenStep :
          Structured.BasicOp.step op
              { state with stack := state.stack ++ hidden } =
            .ok { final with stack := final.stack ++ hidden } := by
        cases hHiddenOp :
            Structured.BasicOp.step op
              { state with stack := state.stack ++ hidden } with
        | error err =>
            simp [Structured.Code.run, Structured.BasicInstr.step,
              hHiddenOp] at hHiddenCode
        | ok hiddenMid =>
            simp [Structured.Code.run, Structured.BasicInstr.step,
              hHiddenOp] at hHiddenCode
            cases hHiddenCode
            rfl
      exact
        runWithOracle_singleton_op_nonObserver_of_step
          (program := program) (pc := pc) (trace := trace)
          hObserver hHiddenStep

theorem frameSafe_singleton_op_of_sourceContinuingStep
    {op : Structured.BasicOp} {step : Assembly.PrimStep}
    (hStep :
      Locals.Source.PrimitiveSemantics.sourceContinuingStep? op =
        some step) :
    Structured.Code.FrameSafe [Structured.BasicInstr.op op] := by
  intro state final hidden hRun
  have hRunBind :
      (do
        let state' ← step.run state
        Except.ok state') = .ok final := by
    simpa [Structured.Code.run, Structured.BasicInstr.step,
      Locals.SourceLowering.PrimitiveSemantics.sourceContinuingStep_basicOp_step
        hStep state] using hRun
  have hRunStep : step.run state = .ok final := by
    cases hStepRun : step.run state with
    | error err =>
        simp [hStepRun] at hRunBind
    | ok mid =>
        simp [hStepRun] at hRunBind
        cases hRunBind
        rfl
  have hHidden :=
    Structured.Preservation.primStep_run_append_hidden_of_suffixSafe
      (hidden := hidden)
      (Locals.SourceLowering.PrimitiveSemantics.sourceContinuingStep_suffix_safe
        hStep)
      hRunStep
  have hHiddenBind :
      (do
        let state' ←
          step.run { state with stack := state.stack ++ hidden }
        Except.ok state') =
        .ok { final with stack := final.stack ++ hidden } := by
    simp [hHidden]
  simpa [Structured.Code.run, Structured.BasicInstr.step,
    Locals.SourceLowering.PrimitiveSemantics.sourceContinuingStep_basicOp_step
      hStep { state with stack := state.stack ++ hidden }] using hHiddenBind

