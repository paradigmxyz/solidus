namespace Expr

mutual
  def eval {results : Nat} (expr : Locals.Expr results) (state : State) :
      Except EVMException (State × List Word) :=
    match expr with
    | .lit value =>
        .ok (state, [value])
    | .var name =>
        match state.vars name with
        | some value => .ok (state, [value])
        | none => invalid
    | .code _code =>
        invalid
    | .prim op args => do
        let (stateAfterArgs, values) ← ExprSeq.eval args state
        let (shared, values', trace') ←
          replayPrimitiveSemantics.eval op stateAfterArgs.shared values
            stateAfterArgs.trace
        .ok ((stateAfterArgs.withShared shared).withTrace trace', values')

  def ExprSeq.eval {results : Nat} (exprs : Locals.ExprSeq results)
      (state : State) : Except EVMException (State × List Word) :=
    match exprs with
    | .nil => .ok (state, [])
    | .cons head tail => do
        let (stateAfterHead, headValues) ← eval head state
        let (stateAfterTail, tailValues) ← ExprSeq.eval tail stateAfterHead
        .ok (stateAfterTail, headValues ++ tailValues)
end

def evalOne {results : Nat} (expr : Locals.Expr results) (state : State) :
    Except EVMException (State × Word) := do
  let (state', values) ← eval expr state
  match values with
  | [value] => .ok (state', value)
  | _ => invalid

def evalCondition (expr : Locals.Expr 1) (state : State) :
    Except EVMException (State × Bool) := do
  let (state', value) ← evalOne expr state
  .ok (state', value != EvmYul.UInt256.ofNat 0)

theorem eval_gas_cons (state : State) (value : Word) (trace : Trace) :
    eval (Locals.Expr.prim .gas .nil)
        { state with trace := { kind := .gas, value := value } :: trace } =
      .ok ({ state with trace := trace }, [value]) := by
  rcases state with ⟨source, traceBefore⟩
  rcases source with ⟨shared, vars⟩
  simp [eval, ExprSeq.eval, replayPrimitiveSemantics, consume,
    State.withShared, State.withTrace, State.withSource, State.shared,
    Locals.Source.State.withShared]

theorem eval_msize_cons (state : State) (value : Word) (trace : Trace) :
    eval (Locals.Expr.prim .msize .nil)
        { state with trace := { kind := .msize, value := value } :: trace } =
      .ok ({ state with trace := trace }, [value]) := by
  rcases state with ⟨source, traceBefore⟩
  rcases source with ⟨shared, vars⟩
  simp [eval, ExprSeq.eval, replayPrimitiveSemantics, consume,
    State.withShared, State.withTrace, State.withSource, State.shared,
    Locals.Source.State.withShared]

end Expr

mutual
  theorem Expr.eval_length {results : Nat}
      {expr : Locals.Expr results} {state state' : State}
      {values : List Word}
      (hEval : Expr.eval expr state = .ok (state', values)) :
      values.length = results := by
    cases expr with
    | lit value =>
        simp [Expr.eval] at hEval
        rcases hEval with ⟨hState, hValues⟩
        cases hState
        cases hValues
        rfl
    | var name =>
        simp [Expr.eval] at hEval
        cases hVar : state.source.vars name with
        | none =>
            simp [State.vars, hVar, invalid, Structured.invalid] at hEval
        | some value =>
            simp [State.vars, hVar] at hEval
            rcases hEval with ⟨hState, hValues⟩
            cases hState
            cases hValues
            rfl
    | code code =>
        simp [Expr.eval, invalid, Structured.invalid] at hEval
    | prim op args =>
        simp [Expr.eval] at hEval
        cases hArgs : Expr.ExprSeq.eval args state with
        | error err =>
            simp [hArgs] at hEval
        | ok argsResult =>
            rcases argsResult with ⟨stateAfterArgs, argValues⟩
            simp [hArgs] at hEval
            cases hReplay :
                replayPrimitiveSemantics.eval op stateAfterArgs.shared
                  argValues stateAfterArgs.trace with
            | error err =>
                simp [hReplay] at hEval
            | ok replayResult =>
                rcases replayResult with ⟨shared', values', trace'⟩
                simp [hReplay] at hEval
                rcases hEval with ⟨hState, hValues⟩
                cases hState
                cases hValues
                exact replay_eval_length hReplay

  theorem ExprSeq.eval_length {results : Nat}
      {exprs : Locals.ExprSeq results} {state state' : State}
      {values : List Word}
      (hEval : Expr.ExprSeq.eval exprs state = .ok (state', values)) :
      values.length = results := by
    cases exprs with
    | nil =>
        simp [Expr.ExprSeq.eval] at hEval
        rcases hEval with ⟨hState, hValues⟩
        cases hState
        cases hValues
        rfl
    | cons head tail =>
        simp [Expr.ExprSeq.eval] at hEval
        cases hHead : Expr.eval head state with
        | error err =>
            simp [hHead] at hEval
        | ok headResult =>
            rcases headResult with ⟨stateAfterHead, headValues⟩
            simp [hHead] at hEval
            cases hTail :
                Expr.ExprSeq.eval tail stateAfterHead with
            | error err =>
                simp [hTail] at hEval
            | ok tailResult =>
                rcases tailResult with ⟨stateAfterTail, tailValues⟩
                simp [hTail] at hEval
                rcases hEval with ⟨hState, hValues⟩
                cases hState
                cases hValues
                have hHeadLength := Expr.eval_length hHead
                have hTailLength := ExprSeq.eval_length hTail
                simp [List.length_append, hHeadLength, hTailLength]
end

namespace Expr

mutual
  theorem oracleFrameSafe_compileCode_of_eval_sourceOwned :
      ∀ {results : Nat} {expr : Locals.Expr results}
        {ctx : Locals.Ctx} {offset : Nat}
        {state state' : State} {values : List Word}
        {code : Structured.Code},
        Locals.Source.Expr.SourceOwned expr →
        Locals.Expr.compileCode ctx offset expr = some code →
        Expr.eval expr state = .ok (state', values) →
          StructuredReplay.Code.OracleFrameSafe code := by
    intro results expr ctx offset state state' values code hOwned hCompile
      hEval
    cases expr with
    | lit value =>
        simp [Locals.Expr.compileCode] at hCompile
        cases hCompile
        exact StructuredReplay.Code.oracleFrameSafe_singleton_push value
    | var name =>
        unfold Expr.eval at hEval
        cases hLookup : state.source.vars name with
        | none =>
            simp [State.vars, hLookup, invalid, Structured.invalid] at hEval
        | some value =>
            simp [State.vars, hLookup] at hEval
            cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
            | none =>
                simp [Locals.Expr.compileCode, hDepth] at hCompile
            | some depth =>
                cases hDup : Locals.StackOp.dup? (offset + depth) with
                | none =>
                    simp [Locals.Expr.compileCode, hDepth, hDup] at hCompile
                | some op =>
                    simp [Locals.Expr.compileCode, hDepth, hDup] at hCompile
                    cases hCompile
                    exact
                      StructuredReplay.Code.oracleFrameSafe_singleton_op_nonObserver
                        (stackOp_dup?_observer_none hDup)
