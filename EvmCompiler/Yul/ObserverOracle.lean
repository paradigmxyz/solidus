      runCodeWithOracle asmProgram pc (Locals.codeStmt code) state trace =
        .ok
          (Expressions.Outcome.regular (state.withEVM evm'), trace') := by
    simp [runCodeWithOracle, Locals.codeStmt,
      Stmt.runCodeStmtWithOracle_code_of_run hRun]

  theorem runCodeWithOracle_codeStmt_source_runNResultWithOracle_segment_of_oracleStepPC
      {pre post : Assembly.Program} {code : Structured.Code}
      {state : Expressions.RunState} {trace trace' : Trace}
      {evm' : EVMState}
      (hStepPC : StructuredReplay.Code.OracleStepPC code)
      (hFits : Structured.Preservation.Code.PCFitsFrom pre code)
      (hPc : state.evm.pc = Assembly.Program.pcAfter pre)
      (hRun :
        runCodeWithOracle (pre ++ code.toAssembly ++ post)
            (Assembly.Program.byteLength pre) (Locals.codeStmt code)
            state trace =
          .ok (Expressions.Outcome.regular (state.withEVM evm'), trace')) :
      Assembly.Source.runNResultWithOracle
          (pre ++ code.toAssembly ++ post) code.length state.evm trace =
        .ok (.running evm', trace') ∧
      evm'.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly) := by
    have hCodeRun :
        StructuredReplay.Code.runWithOracle
            (pre ++ code.toAssembly ++ post)
            (Assembly.Program.byteLength pre) code state.evm trace =
          .ok (evm', trace') := by
      cases hCodeRun :
          StructuredReplay.Code.runWithOracle
            (pre ++ (code.toAssembly ++ post))
            (Assembly.Program.byteLength pre) code state.evm trace with
      | error err =>
          simp [runCodeWithOracle, Locals.codeStmt, Stmt.runCodeStmtWithOracle,
            hCodeRun] at hRun
      | ok codePair =>
          rcases codePair with ⟨evmMid, traceMid⟩
          simp [runCodeWithOracle, Locals.codeStmt, Stmt.runCodeStmtWithOracle,
            hCodeRun, Expressions.Outcome.regular] at hRun
          rcases hRun with ⟨hOutcome, hTrace⟩
          have hState :
              state.withEVM evmMid = state.withEVM evm' := by
            cases hOutcome
            rfl
          have hEvm : evmMid = evm' := by
            have hField :=
              congrArg (fun s : Expressions.RunState => s.evm) hState
            simpa [Structured.RunState.withEVM] using hField
          cases hEvm
          cases hTrace
          simpa [List.append_assoc] using hCodeRun
    exact
      StructuredReplay.Code.runWithOracle_source_runNResultWithOracle_segment_of_oracleStepPC
        hStepPC hFits hPc hCodeRun

