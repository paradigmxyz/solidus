    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hLoopCleanup : CleanupLayoutRel targetCtx.layout loopLayout)
    (hStmt :
      ∀ {fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
        {source : Source.State} {target : Locals.RunState}
        {stmt : Stmt} {sourceResult : Source.Outcome × Source.Ctx},
