theorem runForLoop_from_exact_source_run_with_layout
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {returns : List Name}
    {retc fuel : Nat}
    {loopCtx postBase bodyBase : Source.Ctx}
    {targetLoopCtx targetPostBase targetBodyBase : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {post body : Block}
    {sourceLoop : Source.Outcome}
    (hCtx : CtxRel retc loopCtx targetLoopCtx)
    (hNoDup : targetLoopCtx.layout.Nodup)
    (hCondScoped : Scope.ExprScoped loopCtx.scope cond)
    (hAccessBound : targetLoopCtx.layout.length + Access.exprWidth cond ≤ 16)
    (hRel : StateRel targetLoopCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.runForLoop prim program loopCtx cond postBase post bodyBase
          body (fuel + 1) source =
        .ok sourceLoop)
    (hBody :
      ∀ {sourceAfterCond : Source.State} {targetAfterCond : Locals.RunState}
        {sourceBody : Source.Outcome},
        Source.Block.runScoped prim program bodyBase body fuel
            sourceAfterCond =
          .ok sourceBody →
        StateRel targetLoopCtx.layout hiddenReturns sourceAfterCond
          targetAfterCond →
        ∃ targetBody,
          Direct.Block.runScoped program returns targetBodyBase body fuel
              targetAfterCond =
            .ok targetBody ∧
          StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
            sourceBody targetBody)
    (hPost :
      ∀ {sourceBody : Source.Outcome} {targetBody : Locals.Outcome}
        {sourcePost : Source.Outcome},
        (sourceBody.mode = .regular ∨ sourceBody.mode = .cont) →
        Source.Block.runScoped prim program postBase post fuel
            sourceBody.state =
          .ok sourcePost →
        StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
          sourceBody targetBody →
        ∃ targetPost,
          Direct.Block.runScoped program returns targetPostBase post fuel
              targetBody.state =
            .ok targetPost ∧
          StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
            sourcePost targetPost)
    (hLoop :
      ∀ {sourcePost : Source.State} {targetPost : Locals.RunState}
        {sourceLoop' : Source.Outcome},
        Source.Stmt.runForLoop prim program loopCtx cond postBase post bodyBase
            body fuel sourcePost =
          .ok sourceLoop' →
        StateRel targetLoopCtx.layout hiddenReturns sourcePost targetPost →
        ∃ targetLoop',
          Direct.Stmt.runForLoop program returns targetLoopCtx cond
              targetPostBase post targetBodyBase body fuel targetPost =
            .ok targetLoop' ∧
          StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
            sourceLoop' targetLoop') :
    ∃ targetLoop,
      Direct.Stmt.runForLoop program returns targetLoopCtx cond targetPostBase
          post targetBodyBase body (fuel + 1) target =
        .ok targetLoop ∧
      StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        sourceLoop targetLoop := by
  cases hEvalOne : Source.Expr.evalOne prim cond source with
  | error err =>
      simp [Source.Stmt.runForLoop, Source.Expr.evalCondition,
        Locals.Source.Expr.evalCondition, hEvalOne] at hSourceRun
  | ok evalResult =>
      rcases evalResult with ⟨sourceAfterCond, value⟩
      cases hTruth : (value != EvmYul.UInt256.ofNat 0) with
      | false =>
          rcases runForLoop_false_from_scoped_condition
              (prim := prim) hPrim (program := program)
              (returns := returns) (retc := retc) (fuel := fuel)
              (loopCtx := loopCtx) (postBase := postBase)
              (bodyBase := bodyBase) (targetLoopCtx := targetLoopCtx)
              (targetPostBase := targetPostBase)
              (targetBodyBase := targetBodyBase) (source := source)
              (sourceAfterCond := sourceAfterCond) (target := target)
              (hiddenReturns := hiddenReturns) (cond := cond)
              (post := post) (body := body) hCtx hNoDup hCondScoped
              hAccessBound hRel hEvalOne hTruth with
            ⟨targetAfterCond, hSourceFalse, hTargetFalse, hFalseRel⟩
          rw [hSourceRun] at hSourceFalse
          cases hSourceFalse
          exact ⟨Structured.Outcome.regular targetAfterCond, hTargetFalse,
            hFalseRel⟩
      | true =>
          rcases runForLoop_condition_bridge_from_scoped
              (prim := prim) hPrim (retc := retc) (loopCtx := loopCtx)
              (targetLoopCtx := targetLoopCtx) (source := source)
              (sourceAfterCond := sourceAfterCond) (target := target)
              (hiddenReturns := hiddenReturns) (cond := cond)
              (value := value) (truth := true) hCtx hNoDup hCondScoped
              hAccessBound hRel hEvalOne hTruth with
            ⟨targetAfterCond, hSourceCond, hTargetCond, hCondRel⟩
          cases hSourceBody :
              Source.Block.runScoped prim program bodyBase body fuel
                  sourceAfterCond with
          | error err =>
              simp [Source.Stmt.runForLoop, hSourceCond, hSourceBody]
                at hSourceRun
          | ok sourceBody =>
              rcases hBody hSourceBody hCondRel with
                ⟨targetBody, hTargetBody, hBodyRel⟩
              cases sourceBody with
              | mk sourceBodyState sourceBodyMode =>
                  cases targetBody with
                  | mk targetBodyState targetBodyMode =>
                      cases sourceBodyMode with
                      | regular =>
                          cases targetBodyMode with
                          | regular =>
                              have hBodyNext :
                                  ({ state := sourceBodyState,
                                      mode := Locals.Source.Mode.regular } :
                                    Source.Outcome).mode = .regular ∨
                                    ({ state := sourceBodyState,
                                        mode := Locals.Source.Mode.regular } :
                                      Source.Outcome).mode = .cont := by
                                exact Or.inl rfl
                              cases hSourcePost :
                                  Source.Block.runScoped prim program
                                      postBase post fuel sourceBodyState with
                              | error err =>
                                  simp [Source.Stmt.runForLoop, hSourceCond,
                                    hSourceBody, Source.Outcome.regular,
                                    Locals.Source.Outcome.regular,
                                    hSourcePost] at hSourceRun
                              | ok sourcePost =>
                                  rcases hPost hBodyNext hSourcePost
                                      hBodyRel with
                                    ⟨targetPost, hTargetPost, hPostRel⟩
                                  cases sourcePost with
                                  | mk sourcePostState sourcePostMode =>
                                      cases targetPost with
                                      | mk targetPostState targetPostMode =>
                                          cases sourcePostMode with
                                          | regular =>
                                              cases targetPostMode with
                                              | regular =>
                                                  have hPostStateRel :
                                                      StateRel
                                                        targetLoopCtx.layout
                                                        hiddenReturns
                                                        sourcePostState
                                                        targetPostState := by
                                                    simpa [StmtOutcomeRel,
                                                      Source.Outcome.regular,
                                                      Locals.Source.Outcome.regular,
                                                      Structured.Outcome.regular]
                                                      using hPostRel
                                                  cases hSourceLoopRec :
                                                      Source.Stmt.runForLoop
                                                        prim program loopCtx
                                                        cond postBase post
                                                        bodyBase body fuel
                                                        sourcePostState with
                                                  | error err =>
                                                      simp
                                                        [Source.Stmt.runForLoop,
                                                          hSourceCond,
                                                          hSourceBody,
                                                          Source.Outcome.regular,
                                                          Locals.Source.Outcome.regular,
                                                          hSourcePost,
                                                          hSourceLoopRec]
                                                        at hSourceRun
                                                  | ok sourceLoopRec =>
                                                      rcases hLoop
                                                          hSourceLoopRec
                                                          hPostStateRel with
                                                        ⟨targetLoopRec,
                                                          hTargetLoopRec,
                                                          hLoopRel⟩
                                                      have hSourceStep :
                                                          Source.Stmt.runForLoop
                                                              prim program
                                                              loopCtx cond
                                                              postBase post
                                                              bodyBase body
                                                              (fuel + 1)
                                                              source =
                                                            .ok
                                                              sourceLoopRec := by
                                                        simp
                                                          [Source.Stmt.runForLoop,
                                                            hSourceCond,
                                                            hSourceBody,
                                                            Source.Outcome.regular,
                                                            Locals.Source.Outcome.regular,
                                                            hSourcePost,
                                                            hSourceLoopRec]
                                                      have hTargetStep :
                                                          Direct.Stmt.runForLoop
                                                              program returns
                                                              targetLoopCtx
                                                              cond
                                                              targetPostBase
                                                              post
                                                              targetBodyBase
                                                              body (fuel + 1)
                                                              target =
                                                            .ok
                                                              targetLoopRec := by
                                                        simp
                                                          [Direct.Stmt.runForLoop,
                                                            hTargetCond,
                                                            hTargetBody,
                                                            Structured.Outcome.regular,
                                                            hTargetPost,
                                                            hTargetLoopRec]
                                                      rw [hSourceRun]
                                                        at hSourceStep
                                                      cases hSourceStep
                                                      exact ⟨targetLoopRec,
                                                        hTargetStep,
                                                        hLoopRel⟩
                                              | brk =>
                                                  exact False.elim (by
                                                    simpa [StmtOutcomeRel,
                                                      Source.Outcome.regular,
                                                      Locals.Source.Outcome.regular,
                                                      Structured.Outcome.brk]
                                                      using hPostRel)
                                              | cont =>
                                                  exact False.elim (by
                                                    simpa [StmtOutcomeRel,
                                                      Source.Outcome.regular,
                                                      Locals.Source.Outcome.regular,
