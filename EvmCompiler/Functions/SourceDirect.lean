                        (prim := prim) (program := program)
                        (returns := returns) (retc := retc)
                        (fuel := fuel) (sourceCtx := sourceCtx)
                        (sourceCtxMid := sourceCtxAfter)
                        (sourceCtxOut := sourceCtxOut)
                        (targetCtx := targetCtx)
                        (targetCtxMid := targetCtxAfter)
                        (targetCtxOut := targetCtxOut)
                        (source := source) (sourceMid := sourceHeadState)
                        (target := target) (targetMid := targetHeadState)
                        (hiddenReturns := hiddenReturns) (stmt := stmt)
                        (rest := rest) (sourceOutcome := sourceOutcome)
                        (targetOutcome := targetOutcome)
                        hSourceHead hTargetHead hHeadRel hSourceTail
                        hTargetTail hTailRel with
                    ⟨hSource, hTarget, hRel⟩
                  refine
                    BlockOpenRunBridgeWithLayout.of_bridge_and_layout
                      (BlockOpenRunBridge.of_parts hSource hTarget hRel)
                      ?hLayout
                  intro sourceInner sourceCtxRegular targetInner
