            simp
          rcases runScoped_nonregular_from_open
              (prim := prim) (program := program) (returns := returns)
              (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut) (source := source)
              (target := target) (hiddenReturns := hiddenReturns)
              (sourceOutcome :=
                { state := sourceOpenState,
                  mode := Locals.Source.Mode.cont })
              (targetOutcome := targetOpen) (block := block)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped', hTargetScoped, hOutcomeRel⟩
          rw [hSourceScoped] at hSourceScoped'
          cases hSourceScoped'
          rcases hOutcomeRel with ⟨outcomeLayout, hOutcomeRel⟩
          exact
            ⟨targetOpen, hTargetScoped,
              BlockScopedOutcomeRel.nonregular hOutcomeRel hNonregular⟩
      | leave =>
