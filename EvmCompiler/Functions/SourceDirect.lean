    (hHead :
      ∀ {sourceHead sourceCtxAfter},
        Source.Stmt.run prim program sourceCtx fuel stmt source =
          .ok (sourceHead, sourceCtxAfter) →
          LoopStmtRunBridgeWithLayout prim program returns loopLayout retc fuel
