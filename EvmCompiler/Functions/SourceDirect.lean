      Direct.FunDef.runBody program fn (fuel + 1) callState =
        .ok (Structured.Outcome.halt kind haltedTarget) ∧
      haltedSource.shared = haltedTarget.evm.toSharedState := by
  rcases
      BlockOpenRunBridgeWithLayout.target_result_of_source hOpen
        hSourceOpen with
    ⟨targetResult, hTarget, hRel⟩
  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
  cases targetOutcome with
  | mk targetState targetMode =>
      cases targetMode with
      | regular =>
          exact False.elim (by
            rcases hRel with ⟨_layout, hOutcomeRel, _hCtxRel⟩
            simpa [StmtOutcomeRel, Source.Outcome.halt,
              Locals.Source.Outcome.halt,
              Structured.Outcome.regular] using hOutcomeRel)
      | brk =>
          exact False.elim (by
            rcases hRel with ⟨_layout, hOutcomeRel, _hCtxRel⟩
            simpa [StmtOutcomeRel, Source.Outcome.halt,
              Locals.Source.Outcome.halt,
              Structured.Outcome.brk] using hOutcomeRel)
      | cont =>
          exact False.elim (by
            rcases hRel with ⟨_layout, hOutcomeRel, _hCtxRel⟩
            simpa [StmtOutcomeRel, Source.Outcome.halt,
              Locals.Source.Outcome.halt,
              Structured.Outcome.cont] using hOutcomeRel)
      | leave =>
          exact False.elim (by
            rcases hRel with ⟨_layout, hOutcomeRel, _hCtxRel⟩
            simpa [StmtOutcomeRel, Source.Outcome.halt,
              Locals.Source.Outcome.halt,
              Structured.Outcome.leave] using hOutcomeRel)
      | halt targetKind =>
          have hHaltRel :
              ∃ outcomeLayout,
                StmtOutcomeRel fn.returns outcomeLayout hiddenReturns
                  (Source.Outcome.halt kind haltedSource)
                  (Structured.Outcome.halt targetKind targetState) := by
            rcases hRel with ⟨outcomeLayout, hOutcomeRel, _hCtxRel⟩
            exact ⟨outcomeLayout, hOutcomeRel⟩
          rcases hHaltRel with ⟨_layout, hOutcomeRel⟩
          have hKindShared :
              kind = targetKind ∧
                haltedSource.shared = targetState.evm.toSharedState := by
            simpa [StmtOutcomeRel, Source.Outcome.halt,
              Locals.Source.Outcome.halt,
              Structured.Outcome.halt] using hOutcomeRel
          rcases hKindShared with ⟨hKind, hShared⟩
          subst targetKind
          have hRunBody :
              Direct.FunDef.runBody program fn (fuel + 1) callState =
                .ok (Structured.Outcome.halt kind targetState) :=
            runBody_halt_from_body
              (program := program) (fn := fn) (fuel := fuel)
              (callState := callState)
              (targetAfterInit := targetAfterInit)
              (haltedTarget := targetState) (bodyCtx := targetCtxOut)
              (kind := kind) hInit hTarget
