structure RecursiveCallbacks (prim : Source.PrimitiveSemantics)
    (program : Program) (returns : List Name) (retc : Nat)
    (hiddenReturns : List Structured.ReturnDest) : Prop where
  block :
    ∀ {fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
      {source : Source.State} {target : Locals.RunState}
      {block : Block} {sourceResult : Source.Outcome × Source.Ctx},
      LeaveFrameAvailable sourceCtx hiddenReturns →
      SourceInvariant.Block returns sourceCtx block →
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok sourceResult →
      CtxRel retc sourceCtx targetCtx →
      StateRel targetCtx.layout hiddenReturns source target →
        BlockOpenRunBridgeWithLayout prim program returns retc fuel
          sourceCtx targetCtx hiddenReturns block source target
  loopBlock :
    ∀ {loopLayout : List Name} {fuel : Nat}
      {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
      {source : Source.State} {target : Locals.RunState}
      {block : Block} {sourceResult : Source.Outcome × Source.Ctx},
      LeaveFrameAvailable sourceCtx hiddenReturns →
      SourceInvariant.Block returns sourceCtx block →
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok sourceResult →
      sourceCtx.breakScope?.map List.length = some loopLayout.length →
      sourceCtx.continueScope?.map List.length = some loopLayout.length →
      CtxRel retc sourceCtx targetCtx →
      StateRel targetCtx.layout hiddenReturns source target →
      CleanupLayoutRel targetCtx.layout loopLayout →
        LoopBlockOpenRunBridgeWithLayout prim program returns loopLayout
          retc fuel sourceCtx targetCtx hiddenReturns block source target
  forStmt :
    ∀ {fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
      {source : Source.State} {target : Locals.RunState}
      {init post body : Block} {cond : Expr 1}
      {sourceResult : Source.Outcome × Source.Ctx},
      LeaveFrameAvailable sourceCtx hiddenReturns →
      SourceInvariant.Stmt returns sourceCtx (.for_ init cond post body) →
      Source.Stmt.run prim program sourceCtx fuel
          (.for_ init cond post body) source =
        .ok sourceResult →
      CtxRel retc sourceCtx targetCtx →
      StateRel targetCtx.layout hiddenReturns source target →
        StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx
          targetCtx hiddenReturns (.for_ init cond post body) source target
  callBody :
    ∀ {callFuel : Nat} {functionName : Name}
      {sourceAfterArgs : Source.State} {argValues : List Word}
      {fn : FunDef} {paramStore : Source.Store}
      {targetAfterInit : Locals.RunState} {bodyOutcome : Source.Outcome}
      {sourceCtxOut : Source.Ctx} {callerBase : Locals.RunState},
      Source.FunList.find? functionName program.functions = some fn →
      Source.Store.insertMany fn.params argValues
          Locals.Source.Store.empty =
        some paramStore →
        fn.params.length + callerBase.evm.stack.length ≤ 16 →
      Source.Block.runOpen prim program (FunDef.sourceBodyCtx fn) callFuel
          fn.body
          { shared := sourceAfterArgs.shared,
            vars := Source.Store.initReturns fn.returns paramStore } =
        .ok (bodyOutcome, sourceCtxOut) →
      StateRel (FunDef.targetBodyCtx fn).layout
        ({ callerStack := callerBase.evm.stack,
            retc := fn.returns.length } :: hiddenReturns)
        { shared := sourceAfterArgs.shared,
          vars := Source.Store.initReturns fn.returns paramStore }
        targetAfterInit →
      BlockOpenRunBridgeWithLayout prim program fn.returns
        fn.returns.length callFuel (FunDef.sourceBodyCtx fn)
        (FunDef.targetBodyCtx fn)
        ({ callerStack := callerBase.evm.stack,
            retc := fn.returns.length } :: hiddenReturns)
        fn.body
        { shared := sourceAfterArgs.shared,
          vars := Source.Store.initReturns fn.returns paramStore }
        targetAfterInit

