theorem assign_lit_bridge {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState} {fuel : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    {name : Name} {idx : Nat} {value : Word}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hName : targetCtx.layout[idx]? = some name)
    (hBound : idx + 1 ≤ 16)
    (hRel : StateRel targetCtx.layout hiddenReturns source target) :
    ∃ targetAfter,
      Source.Stmt.run prim program sourceCtx fuel
          (.assign name (.lit value)) source =
        .ok
          (Source.Outcome.regular
            (source.withVars
              (Locals.Source.Store.insert source.vars name value)),
            sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx fuel
          (.assign name (.lit value)) target =
        .ok (Structured.Outcome.regular targetAfter, targetCtx) ∧
      StateRel targetCtx.layout hiddenReturns
        (source.withVars
          (Locals.Source.Store.insert source.vars name value))
        targetAfter ∧
      CtxRel retc sourceCtx targetCtx := by
  rcases hRel with ⟨hLowerRel, hReturns⟩
  have hContains : source.vars.contains name = true :=
    Locals.SourceLowering.StackStoreRel.contains_of_layout
      hLowerRel.2 hName
  have hCtxRel : CtxRel retc sourceCtx targetCtx := hCtx
  rcases SourceDirect.Expr.lit_bridge (prim := prim)
      (layout := targetCtx.layout)
      (hiddenReturns := hiddenReturns) (source := source)
      (target := target) (ctx := targetCtx) (value := value)
      ⟨hLowerRel, hReturns⟩ with
    ⟨hSourceExpr, evm, hTargetExpr, hExprRel⟩
  have hSourceEvalOne :
      Source.Expr.evalOne prim (Locals.Expr.lit value) source =
        .ok (source, value) := by
    simp [Source.Expr.evalOne, Locals.Source.Expr.evalOne, hSourceExpr]
  have hTargetRunState :
      Locals.Direct.Expr.runState targetCtx (Locals.Expr.lit value) target =
        .ok (target.withEVM evm) := by
    simp [Locals.Direct.Expr.runState, hTargetExpr]
  rcases Assignment.assignTop_stateRel
      (layout := targetCtx.layout) (hiddenReturns := hiddenReturns)
      (source := source) (targetAfterExpr := target.withEVM evm)
      (ctx := targetCtx) (fuel := fuel)
      (name := name) (idx := idx) (value := value)
      rfl hNoDup hName hBound hExprRel with
    ⟨targetAfter, hAssignTop, hTargetRel⟩
  refine ⟨targetAfter, ?hSource, ?hTarget, hTargetRel, hCtxRel⟩
  · simp [Source.Stmt.run, hContains, hSourceEvalOne]
  · simp [Direct.Stmt.run, hTargetRunState, hAssignTop]

