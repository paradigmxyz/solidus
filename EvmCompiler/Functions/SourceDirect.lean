namespace Program

theorem runState_toDirect_exists
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {fuel : Nat}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    (hScoped : program.Scoped)
    (hFrameBound : FrameBound.Program program)
    (hSourceRun :
      Source.Program.runState prim fuel program source = .ok sourceOutcome)
    (hRel : StateRel [] [] source target) :
    ∃ targetOutcome,
      Direct.Program.runState fuel program target = .ok targetOutcome ∧
      BlockScopedOutcomeRel [] [] [] sourceOutcome targetOutcome := by
  rcases
      RecursiveCallbacks.runScoped_from_source_run_constructed
        (prim := prim) hPrim (program := program) (returns := [])
        (retc := 0) (fuel := fuel) (sourceCtx := Source.Ctx.initial)
        (targetCtx := Locals.Ctx.initial) (source := source)
        (target := target) (hiddenReturns := [])
        (block := program.body) (sourceOutcome := sourceOutcome)
        hScoped.1 hFrameBound.1 rfl LeaveFrameAvailable.initial
        (by simpa [Source.Program.runState] using hSourceRun)
        (SourceInvariant.Program.body hScoped hFrameBound)
        CtxRel.initial hRel with
    ⟨targetOutcome, hTargetRun, hOutcomeRel⟩
  exact
    ⟨targetOutcome,
      by simpa [Direct.Program.runState] using hTargetRun,
      hOutcomeRel⟩

theorem run_toDirect_exists
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {fuel : Nat}
    {initial : EVMState} {sourceOutcome : Source.Outcome}
    (hScoped : program.Scoped)
    (hFrameBound : FrameBound.Program program)
    (hInitialStack : initial.stack = [])
    (hSourceRun :
      Source.Program.run prim fuel program initial = .ok sourceOutcome) :
    ∃ targetOutcome,
      Direct.Program.run fuel program initial = .ok targetOutcome ∧
      BlockScopedOutcomeRel [] [] [] sourceOutcome targetOutcome := by
  exact
    runState_toDirect_exists (prim := prim) hPrim
      (program := program) (fuel := fuel)
      (source := Source.Program.initialState initial.toSharedState)
      (target := Structured.RunState.initial initial)
      (sourceOutcome := sourceOutcome)
      hScoped hFrameBound (by simpa [Source.Program.run] using hSourceRun)
      (StateRel.initial hInitialStack)

end Program

