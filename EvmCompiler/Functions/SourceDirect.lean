theorem for_leave_or_halt_stmtRunResult_from_init_open
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceInitCtx : Source.Ctx}
    {targetCtx targetInitCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {init post body : Block} {cond : Expr 1}
    {sourceInit : Source.Outcome} {targetInit : Locals.Outcome}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceInit :
      Source.Block.runOpen prim program sourceCtx.withoutLoopControl fuel
          init source =
        .ok (sourceInit, sourceInitCtx))
    (hTargetInit :
      Direct.Block.runOpen program returns targetCtx.withoutLoopControl fuel
          init target =
        .ok (targetInit, targetInitCtx))
    (hInitRel :
      BlockOpenResultRel retc returns hiddenReturns
        (sourceInit, sourceInitCtx) (targetInit, targetInitCtx))
    (hPass :
      sourceInit.mode = .leave ∨
        ∃ kind, sourceInit.mode = .halt kind) :
