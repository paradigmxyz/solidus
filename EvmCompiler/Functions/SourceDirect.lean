    {init post body : Block} {cond : Expr 1}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceRun :
      Source.Stmt.run prim program sourceCtx (fuel + 1)
          (.for_ init cond post body) source =
        .ok sourceResult)
    (hInit :
      BlockOpenRunBridgeWithLayout prim program returns retc fuel
        sourceCtx.withoutLoopControl targetCtx.withoutLoopControl
        hiddenReturns init source target)
    (hLoop :
      ∀ {sourceInitCtx targetInitCtx sourceAfterInit targetAfterInit},
        StateRel targetInitCtx.layout hiddenReturns sourceAfterInit
          targetAfterInit →
        CtxRel retc sourceInitCtx targetInitCtx →
        ∃ sourceLoop targetLoop,
          Source.Stmt.runForLoop prim program sourceInitCtx cond
              sourceInitCtx.withoutLoopControl post
              (sourceInitCtx.withLoopControl sourceInitCtx.scope
                sourceInitCtx.scope)
              body fuel sourceAfterInit =
            .ok sourceLoop ∧
          Direct.Stmt.runForLoop program returns targetInitCtx cond
              targetInitCtx.withoutLoopControl post
              (targetInitCtx.withLoopControl targetInitCtx.layout.length)
              body fuel targetAfterInit =
            .ok targetLoop ∧
          StmtOutcomeRel returns targetInitCtx.layout hiddenReturns
            sourceLoop targetLoop) :
    StmtRunBridgeWithLayout prim program returns retc (fuel + 1)
      sourceCtx targetCtx hiddenReturns (.for_ init cond post body)
      source target := by
  rcases BlockOpenRunBridgeWithLayout.to_bridge hInit with
    ⟨sourceInitResult, targetInitResult, hSourceInit, hTargetInit, hInitRel⟩
  rcases sourceInitResult with ⟨sourceInit, sourceInitCtx⟩
  rcases targetInitResult with ⟨targetInit, targetInitCtx⟩
  cases sourceInit with
  | mk sourceInitState sourceInitMode =>
      cases sourceInitMode with
      | regular =>
          cases targetInit with
          | mk targetInitState targetInitMode =>
              cases targetInitMode with
              | regular =>
                  have hInitRegular :
                      StateRel targetInitCtx.layout hiddenReturns
                          sourceInitState targetInitState ∧
                        CtxRel retc sourceInitCtx targetInitCtx := by
                    simpa [BlockOpenResultRel, Source.Outcome.regular,
                      Locals.Source.Outcome.regular,
                      Structured.Outcome.regular] using hInitRel
                  rcases hInitRegular with ⟨hInitStateRel, hInitCtxRel⟩
