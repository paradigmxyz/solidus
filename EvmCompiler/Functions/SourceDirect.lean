theorem leave_bridge {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState} {fuel : Nat}
    {hiddenReturns : List Structured.ReturnDest} {leaveScope : List Name}
    {values : List Word}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hLeave : sourceCtx.leaveScope? = some leaveScope)
    (hNoDup : targetCtx.layout.Nodup)
    (hReturnsLen : returns.length = retc)
    (hRetcBound : retc ≤ 16)
    (hHiddenReturns : hiddenReturns ≠ [])
    (hValues : ReturnValuesRel targetCtx.layout source target returns values)
    (hRel : StateRel targetCtx.layout hiddenReturns source target) :
    ∃ targetAfter,
      Source.Stmt.run prim program sourceCtx fuel .leave source =
        .ok
          (Source.Outcome.leave
            (Locals.Source.State.restrictTo leaveScope source),
            sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx fuel .leave target =
        .ok (Structured.Outcome.leave targetAfter, targetCtx) ∧
      ReturnedStackRel hiddenReturns
        (Locals.Source.State.restrictTo leaveScope source) values
        targetAfter ∧
      CtxRel retc sourceCtx targetCtx := by
  rcases hCtx with
    ⟨hSameScope, hBreakDepth, hContinueDepth, hLeaveDepth, hLeaveRetc,
      hBreakScopeRel, hContinueScopeRel⟩
  have hCtxRel : CtxRel retc sourceCtx targetCtx :=
    ⟨hSameScope, hBreakDepth, hContinueDepth, hLeaveDepth, hLeaveRetc,
      hBreakScopeRel, hContinueScopeRel⟩
  rcases hRel with ⟨hLowerRel, hHiddenEq⟩
  rcases hLowerRel with ⟨hSharedRel, hStackRel⟩
  have hTargetDepth : targetCtx.leaveDepth? = some 0 := by
    rw [hLeaveDepth, hLeave]
    rfl
  have hValuesLen : values.length = returns.length :=
    ReturnValuesRel.values_length hValues
  have hPreserveLen : values.reverse.length = targetCtx.leaveRetc := by
    simp [hValuesLen, hReturnsLen, hLeaveRetc]
  have hTargetRetcBound : targetCtx.leaveRetc ≤ 16 := by
    rw [hLeaveRetc]
    exact hRetcBound
  rcases ReturnValuesRel.pushReturns
      (layout := targetCtx.layout) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (ctx := targetCtx)
      (returns := returns) (values := values)
      rfl hNoDup ⟨⟨hSharedRel, hStackRel⟩, hHiddenEq⟩ hValues with
    ⟨stateAfterReturns, hLookup, hPush, hPushStack, hPushShared,
      hPushReturns⟩
  rcases Cleanup.runCleanupToPreserving_exists
      (ctx := targetCtx) (preserve := targetCtx.leaveRetc)
      (targetDepth := 0) (state := stateAfterReturns)
      (preserved := values.reverse) (locals := target.evm.stack)
      (by omega) hPreserveLen hTargetRetcBound hPushStack hStackRel.1 with
    ⟨targetAfter, hCleanup, hCleanupStack, hCleanupShared,
      hCleanupReturns⟩
  have hFinalReturns : targetAfter.returns = hiddenReturns :=
    hCleanupReturns.trans hPushReturns
  have hTargetReturnsNonempty : targetAfter.returns ≠ [] := by
    intro hNil
    have hHiddenNil : hiddenReturns = [] := by
      simpa [hFinalReturns] using hNil
    exact hHiddenReturns hHiddenNil
  have hFinalStack : targetAfter.evm.stack = values.reverse := by
    simpa [Nat.sub_zero, ← hStackRel.1] using hCleanupStack
  have hFinalShared :
      targetAfter.evm.toSharedState =
        (Locals.Source.State.restrictTo leaveScope source).shared := by
    calc
      targetAfter.evm.toSharedState = stateAfterReturns.evm.toSharedState :=
        hCleanupShared
      _ = target.evm.toSharedState := hPushShared
      _ = source.shared := hSharedRel
      _ = (Locals.Source.State.restrictTo leaveScope source).shared := rfl
  refine ⟨targetAfter, ?hSource, ?hTarget, ?hReturned, hCtxRel⟩
  · simp [Source.Stmt.run, hLeave]
  · cases hReturnsCase : targetAfter.returns with
    | nil =>
        exact False.elim (hTargetReturnsNonempty hReturnsCase)
    | cons frame rest =>
        simp [Direct.Stmt.run, hPush, hTargetDepth, hCleanup, hReturnsCase]
  · exact ⟨hFinalShared, hFinalStack, hFinalReturns⟩

theorem call_returned_from_parts {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source sourceAfterArgs : Source.State}
    {target targetAfterArgs callerBase returnedTarget : Locals.RunState}
    {targetMode : Structured.Mode}
    {fuel : Nat} {hiddenReturns : List Structured.ReturnDest}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {fn : FunDef} {argValues returnValues : List Word}
    {returnStore : Source.Store} {sharedAfterCall : EvmYul.SharedState .EVM}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDupLayout : targetCtx.layout.Nodup)
    (hTargetsNoDup : targets.Nodup)
    (hContains : Scope.containsAll sourceCtx.scope targets)
    (hBound : targets.length + targetCtx.layout.length ≤ 16)
    (hArgEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues))
    (hPrelude :
      CallPrelude targetCtx.layout hiddenReturns sourceAfterArgs
        sharedAfterCall argValues targetCtx args target targetAfterArgs
        callerBase)
    (hLookup :
      Source.FunList.find? functionName program.functions = some fn)
    (hSourceBody :
      Source.FunDef.runBody prim program fn argValues fuel
          sourceAfterArgs.shared =
        .ok (Source.CallResult.returned sharedAfterCall returnValues))
    (hTargetMode : targetMode = .regular ∨ targetMode = .leave)
    (hTargetBody :
      Direct.FunDef.runBody program fn fuel
          ((targetAfterArgs.withEVM
            { targetAfterArgs.evm with stack := argValues.reverse }).pushReturn
            callerBase.evm.stack fn.returns.length) =
        .ok { state := returnedTarget, mode := targetMode })
    (hReturned :
      ReturnedStackRel
        (Structured.ReturnDest.mk callerBase.evm.stack fn.returns.length ::
          hiddenReturns)
        (sourceAfterArgs.withShared sharedAfterCall) returnValues
        returnedTarget)
    (hAssign :
      Source.Store.assignMany targets returnValues sourceAfterArgs.vars =
        some returnStore) :
    ∃ targetAfter,
      Source.Stmt.run prim program sourceCtx (fuel + 1)
          (.call targets functionName args) source =
        .ok
          (Source.Outcome.regular
            { shared := sharedAfterCall, vars := returnStore },
            sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx (fuel + 1)
          (.call targets functionName args) target =
        .ok (Structured.Outcome.regular targetAfter, targetCtx) ∧
    StateRel targetCtx.layout hiddenReturns
        { shared := sharedAfterCall, vars := returnStore } targetAfter := by
  rcases hPrelude with
    ⟨hTargetArgs, hArgStack, _hPrefixRel, hBaseRel⟩
  have hArgLen : argValues.length = fn.params.length :=
    Source.FunDef.runBody_args_length hSourceBody
  have hReturnLen : returnValues.length = fn.returns.length :=
    Source.FunDef.runBody_returned_length hSourceBody
  have hTargetLookup : FunList.find? functionName program.functions = some fn := by
    simpa using hLookup
  have hSplit :
      Structured.StackFrame.splitArgs? fn.params.length
          targetAfterArgs.evm.stack =
        some (argValues.reverse, callerBase.evm.stack) := by
    unfold Structured.StackFrame.splitArgs?
    have hPrefixLen : argValues.reverse.length = fn.params.length := by
      simp [hArgLen]
    have hLe : fn.params.length ≤ targetAfterArgs.evm.stack.length := by
      rw [hArgStack]
      simp [hPrefixLen]
    rw [if_pos hLe]
    rw [hArgStack]
    have hTake :
        List.take fn.params.length
            (argValues.reverse ++ callerBase.evm.stack) =
          argValues.reverse := by
      simpa [hPrefixLen] using
        (List.take_left (l₁ := argValues.reverse)
          (l₂ := callerBase.evm.stack))
    have hDrop :
        List.drop fn.params.length
            (argValues.reverse ++ callerBase.evm.stack) =
          callerBase.evm.stack := by
      simpa [hPrefixLen] using
        (List.drop_left (l₁ := argValues.reverse)
          (l₂ := callerBase.evm.stack))
    simp [hTake, hDrop]
  have hAssignCallSource :
      Source.Store.assignMany targets returnValues
          (sourceAfterArgs.withShared sharedAfterCall).vars =
        some returnStore := by
    simpa [Locals.Source.State.withShared] using hAssign
  rcases Assignment.finishReturnedCall_stateRel
      (retc := retc) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns)
      (sourceAfterCall := sourceAfterArgs.withShared sharedAfterCall)
      (base := callerBase) (returnedTarget := returnedTarget)
      (targets := targets) (values := returnValues) (returnStore := returnStore)
      (frame :=
        { callerStack := callerBase.evm.stack, retc := fn.returns.length })
      hCtx hNoDupLayout hTargetsNoDup hContains hBound hAssignCallSource
      hBaseRel hReturned rfl (by simpa using hReturnLen) with
    ⟨returned, stateWithReturns, targetAfter, hPop, hAttach, hStateWithReturns,
      hAssignRun, hFinalRel⟩
  have hSourceRun :
      Source.Stmt.run prim program sourceCtx (fuel + 1)
          (.call targets functionName args) source =
        .ok
          (Source.Outcome.regular
            { shared := sharedAfterCall, vars := returnStore },
            sourceCtx) := by
    simp [Source.Stmt.run, hTargetsNoDup, hArgEval, hTargetLookup, hSourceBody,
      hAssign]
  have hAssignRunConcrete :
      Direct.assignReturnedTops targetCtx targets.reverse
          (returned.withEVM
            { returnedTarget.evm with
              stack := returnValues.reverse ++ callerBase.evm.stack }) =
        .ok targetAfter := by
    simpa [hStateWithReturns] using hAssignRun
  have hTargetRun :
      Direct.Stmt.run program returns targetCtx (fuel + 1)
          (.call targets functionName args) target =
        .ok (Structured.Outcome.regular targetAfter, targetCtx) := by
    cases hTargetMode with
    | inl hRegular =>
        subst targetMode
        simpa [Direct.Stmt.run, hTargetArgs, hTargetLookup, hSplit,
          hTargetBody, hPop, hAttach, hAssignRunConcrete]
    | inr hLeave =>
        subst targetMode
        simpa [Direct.Stmt.run, hTargetArgs, hTargetLookup, hSplit,
          hTargetBody, hPop, hAttach, hAssignRunConcrete]
  refine ⟨targetAfter, hSourceRun, hTargetRun, ?_⟩
  simpa [Locals.Source.State.withShared, Locals.Source.State.withVars] using
    hFinalRel

theorem call_halted_from_parts {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source sourceAfterArgs haltedSource : Source.State}
    {target targetAfterArgs callerBase haltedTarget : Locals.RunState}
    {fuel : Nat} {hiddenReturns : List Structured.ReturnDest}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {fn : FunDef} {argValues : List Word} {kind : Assembly.HaltKind}
    (hTargetsNoDup : targets.Nodup)
    (hArgEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues))
    (hPrelude :
      CallPrelude targetCtx.layout hiddenReturns sourceAfterArgs
        haltedSource.shared argValues targetCtx args target targetAfterArgs
        callerBase)
    (hLookup :
      Source.FunList.find? functionName program.functions = some fn)
    (hSourceBody :
      Source.FunDef.runBody prim program fn argValues fuel
          sourceAfterArgs.shared =
        .ok (Source.CallResult.halted kind haltedSource))
    (hTargetBody :
      Direct.FunDef.runBody program fn fuel
          ((targetAfterArgs.withEVM
            { targetAfterArgs.evm with stack := argValues.reverse }).pushReturn
            callerBase.evm.stack fn.returns.length) =
        .ok (Structured.Outcome.halt kind haltedTarget))
    (hHaltShared : haltedSource.shared = haltedTarget.evm.toSharedState) :
    Source.Stmt.run prim program sourceCtx (fuel + 1)
        (.call targets functionName args) source =
      .ok (Source.Outcome.halt kind haltedSource, sourceCtx) ∧
    Direct.Stmt.run program returns targetCtx (fuel + 1)
        (.call targets functionName args) target =
      .ok (Structured.Outcome.halt kind haltedTarget, targetCtx) ∧
    haltedSource.shared = haltedTarget.evm.toSharedState := by
  rcases hPrelude with
    ⟨hTargetArgs, hArgStack, _hPrefixRel, _hBaseRel⟩
  have hArgLen : argValues.length = fn.params.length :=
    Source.FunDef.runBody_args_length hSourceBody
  have hTargetLookup : FunList.find? functionName program.functions = some fn := by
    simpa using hLookup
  have hSplit :
      Structured.StackFrame.splitArgs? fn.params.length
          targetAfterArgs.evm.stack =
        some (argValues.reverse, callerBase.evm.stack) := by
    unfold Structured.StackFrame.splitArgs?
    have hPrefixLen : argValues.reverse.length = fn.params.length := by
      simp [hArgLen]
    have hLe : fn.params.length ≤ targetAfterArgs.evm.stack.length := by
      rw [hArgStack]
      simp [hPrefixLen]
    rw [if_pos hLe]
    rw [hArgStack]
    have hTake :
        List.take fn.params.length
            (argValues.reverse ++ callerBase.evm.stack) =
          argValues.reverse := by
      simpa [hPrefixLen] using
        (List.take_left (l₁ := argValues.reverse)
          (l₂ := callerBase.evm.stack))
    have hDrop :
        List.drop fn.params.length
            (argValues.reverse ++ callerBase.evm.stack) =
          callerBase.evm.stack := by
      simpa [hPrefixLen] using
        (List.drop_left (l₁ := argValues.reverse)
          (l₂ := callerBase.evm.stack))
    simp [hTake, hDrop]
  constructor
  · simp [Source.Stmt.run, hTargetsNoDup, hArgEval, hTargetLookup,
      hSourceBody]
  constructor
  · simpa [Direct.Stmt.run, hTargetArgs, hTargetLookup, hSplit, hTargetBody]
  · exact hHaltShared

end Stmt

def ModeRel : Source.Mode → Structured.Mode → Prop
  | .regular, .regular => True
  | .brk, .brk => True
  | .cont, .cont => True
  | .leave, .leave => True
  | .halt sourceKind, .halt targetKind => sourceKind = targetKind
  | _, _ => False

def sourceOutcomeView :
    Simulation.OutcomeView Source.Outcome Source.State Source.Mode where
  state := fun outcome => outcome.state
  mode := fun outcome => outcome.mode

def targetOutcomeView :
    Simulation.OutcomeView Locals.Outcome Locals.RunState Structured.Mode where
  state := Structured.Outcome.state
  mode := Structured.Outcome.mode

def outcomeContract (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest) :
    Simulation.OutcomeContract
      Source.Mode Structured.Mode Source.State Locals.RunState where
  relate sourceMode targetMode sourceState targetState :=
    match sourceMode, targetMode with
    | .halt sourceKind, .halt targetKind =>
        sourceKind = targetKind ∧
          sourceState.shared = targetState.evm.toSharedState
    | _, _ =>
        StateRel layout hiddenReturns sourceState targetState ∧
          ModeRel sourceMode targetMode

@[simp] theorem outcomeContract_relate (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (sourceMode : Source.Mode) (targetMode : Structured.Mode)
    (sourceState : Source.State) (targetState : Locals.RunState) :
    (outcomeContract layout hiddenReturns).relate
        sourceMode targetMode sourceState targetState =
      match sourceMode, targetMode with
      | .halt sourceKind, .halt targetKind =>
          sourceKind = targetKind ∧
            sourceState.shared = targetState.evm.toSharedState
      | _, _ =>
          StateRel layout hiddenReturns sourceState targetState ∧
            ModeRel sourceMode targetMode := rfl

def OutcomeRel (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.Outcome) (target : Locals.Outcome) : Prop :=
  (outcomeContract layout hiddenReturns).relate
    source.mode target.mode source.state target.state

theorem outcomeRel_eq_simulation (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.Outcome) (target : Locals.Outcome) :
    OutcomeRel layout hiddenReturns source target =
      Simulation.OutcomeRel sourceOutcomeView targetOutcomeView
        (outcomeContract layout hiddenReturns) source target := rfl

/--
Outcome relation for the function source-to-direct boundary.

Most modes preserve the ordinary named-store/stack-layout `StateRel`.  `leave`
is the exception owned by this layer: the direct backend has already pushed the
function return variables and cleaned the frame, so the observable relation is
`ReturnedStackRel`, not a live-locals layout relation.
-/
def stmtOutcomeContract (returns : List Name) (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest) :
    Simulation.OutcomeContract
      Source.Mode Structured.Mode Source.State Locals.RunState where
  relate sourceMode targetMode sourceState targetState :=
    match sourceMode, targetMode with
    | .regular, .regular
    | .brk, .brk
    | .cont, .cont =>
        StateRel layout hiddenReturns sourceState targetState
    | .leave, .leave =>
        ∃ values,
          Source.Store.lookupMany returns sourceState.vars = some values ∧
            ReturnedStackRel hiddenReturns sourceState values targetState
    | .halt sourceKind, .halt targetKind =>
        sourceKind = targetKind ∧
          sourceState.shared = targetState.evm.toSharedState
    | _, _ => False

@[simp] theorem stmtOutcomeContract_relate
    (returns layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (sourceMode : Source.Mode) (targetMode : Structured.Mode)
    (sourceState : Source.State) (targetState : Locals.RunState) :
    (stmtOutcomeContract returns layout hiddenReturns).relate
        sourceMode targetMode sourceState targetState =
      match sourceMode, targetMode with
      | .regular, .regular
      | .brk, .brk
      | .cont, .cont =>
          StateRel layout hiddenReturns sourceState targetState
      | .leave, .leave =>
          ∃ values,
            Source.Store.lookupMany returns sourceState.vars = some values ∧
              ReturnedStackRel hiddenReturns sourceState values targetState
      | .halt sourceKind, .halt targetKind =>
          sourceKind = targetKind ∧
            sourceState.shared = targetState.evm.toSharedState
      | _, _ => False := rfl

def StmtOutcomeRel (returns : List Name) (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.Outcome) (target : Locals.Outcome) : Prop :=
  (stmtOutcomeContract returns layout hiddenReturns).relate
    source.mode target.mode source.state target.state

theorem stmtOutcomeRel_eq_simulation
    (returns layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.Outcome) (target : Locals.Outcome) :
    StmtOutcomeRel returns layout hiddenReturns source target =
      Simulation.OutcomeRel sourceOutcomeView targetOutcomeView
        (stmtOutcomeContract returns layout hiddenReturns) source target := rfl

namespace OutcomeRel

theorem regular {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    OutcomeRel layout hiddenReturns (Source.Outcome.regular source)
      (Structured.Outcome.regular target) := by
  exact ⟨hRel, trivial⟩

theorem halt {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {kind : Assembly.HaltKind} {source : Source.State}
    {target : Locals.RunState}
    (hShared : source.shared = target.evm.toSharedState) :
    OutcomeRel layout hiddenReturns (Source.Outcome.halt kind source)
      (Structured.Outcome.halt kind target) := by
  exact ⟨rfl, hShared⟩

theorem halt_of_stateRel {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {kind : Assembly.HaltKind} {source : Source.State}
    {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    OutcomeRel layout hiddenReturns (Source.Outcome.halt kind source)
      (Structured.Outcome.halt kind target) := by
  exact halt hRel.1.1.symm

end OutcomeRel

namespace StmtOutcomeRel

theorem regular {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.regular source) (Structured.Outcome.regular target) := by
  exact hRel

theorem brk {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.brk source) (Structured.Outcome.brk target) := by
  exact hRel

theorem cont {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.cont source) (Structured.Outcome.cont target) := by
  exact hRel

theorem leave {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {values : List Word}
    (hLookup : Source.Store.lookupMany returns source.vars = some values)
    (hRel : ReturnedStackRel hiddenReturns source values target) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.leave source) (Structured.Outcome.leave target) := by
  exact ⟨values, hLookup, hRel⟩

theorem leave_of_returnValuesRel_restrict {returns layout leaveScope : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target targetAfter : Locals.RunState}
    {values : List Word}
    (hReturnScope : ∀ name, name ∈ returns → name ∈ leaveScope)
    (hValues : ReturnValuesRel layout source target returns values)
    (hRel :
      ReturnedStackRel hiddenReturns
        (Locals.Source.State.restrictTo leaveScope source) values
        targetAfter) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.leave
        (Locals.Source.State.restrictTo leaveScope source))
      (Structured.Outcome.leave targetAfter) := by
  exact leave
    (Source.Store.lookupMany_restrictTo_of_mem
      (names := returns) (scope := leaveScope) (store := source.vars)
      (values := values) hReturnScope hValues.1)
    hRel

theorem halt {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {kind : Assembly.HaltKind} {source : Source.State}
    {target : Locals.RunState}
    (hShared : source.shared = target.evm.toSharedState) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.halt kind source) (Structured.Outcome.halt kind target) := by
  exact ⟨rfl, hShared⟩

theorem stateRel_of_regular_or_cont {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.Outcome} {target : Locals.Outcome}
    (hRel :
      StmtOutcomeRel returns layout hiddenReturns source target)
    (hMode : source.mode = .regular ∨ source.mode = .cont) :
    StateRel layout hiddenReturns source.state target.state := by
  cases source with
  | mk sourceState sourceMode =>
      cases target with
      | mk targetState targetMode =>
          cases sourceMode with
          | regular =>
              cases targetMode <;>
                simpa [StmtOutcomeRel] using hRel
          | brk =>
              exact False.elim (by
                rcases hMode with hMode | hMode <;> simp at hMode)
          | cont =>
              cases targetMode <;>
                simpa [StmtOutcomeRel] using hRel
          | leave =>
              exact False.elim (by
                rcases hMode with hMode | hMode <;> simp at hMode)
          | halt kind =>
              exact False.elim (by
                rcases hMode with hMode | hMode <;> simp at hMode)

end StmtOutcomeRel

def StmtRunResultRel (retc : Nat) (returns : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (sourceResult : Source.Outcome × Source.Ctx)
    (targetResult : Locals.Outcome × Locals.Ctx) : Prop :=
  match sourceResult.1.mode, targetResult.1.mode with
  | .regular, .regular =>
      StateRel targetResult.2.layout hiddenReturns
        sourceResult.1.state targetResult.1.state ∧
        CtxRel retc sourceResult.2 targetResult.2
  | _, _ =>
      ∃ outcomeLayout,
        StmtOutcomeRel returns outcomeLayout hiddenReturns
          sourceResult.1 targetResult.1 ∧
          CtxRel retc sourceResult.2 targetResult.2

namespace StmtRunResultRel

theorem regular {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hCtx : CtxRel retc sourceCtx targetCtx) :
    StmtRunResultRel retc returns hiddenReturns
      (Source.Outcome.regular source, sourceCtx)
      (Structured.Outcome.regular target, targetCtx) := by
  exact ⟨hRel, hCtx⟩

theorem brk {retc : Nat} {returns outcomeLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        (Source.Outcome.brk source) (Structured.Outcome.brk target))
    (hCtx : CtxRel retc sourceCtx targetCtx) :
    StmtRunResultRel retc returns hiddenReturns
      (Source.Outcome.brk source, sourceCtx)
      (Structured.Outcome.brk target, targetCtx) := by
  exact ⟨outcomeLayout, hRel, hCtx⟩

theorem cont {retc : Nat} {returns outcomeLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        (Source.Outcome.cont source) (Structured.Outcome.cont target))
    (hCtx : CtxRel retc sourceCtx targetCtx) :
    StmtRunResultRel retc returns hiddenReturns
      (Source.Outcome.cont source, sourceCtx)
      (Structured.Outcome.cont target, targetCtx) := by
  exact ⟨outcomeLayout, hRel, hCtx⟩

theorem leave {retc : Nat} {returns outcomeLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        (Source.Outcome.leave source) (Structured.Outcome.leave target))
    (hCtx : CtxRel retc sourceCtx targetCtx) :
    StmtRunResultRel retc returns hiddenReturns
      (Source.Outcome.leave source, sourceCtx)
      (Structured.Outcome.leave target, targetCtx) := by
  exact ⟨outcomeLayout, hRel, hCtx⟩

theorem halt {retc : Nat} {returns outcomeLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {kind : Assembly.HaltKind}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        (Source.Outcome.halt kind source) (Structured.Outcome.halt kind target))
    (hCtx : CtxRel retc sourceCtx targetCtx) :
    StmtRunResultRel retc returns hiddenReturns
      (Source.Outcome.halt kind source, sourceCtx)
      (Structured.Outcome.halt kind target, targetCtx) := by
  exact ⟨outcomeLayout, hRel, hCtx⟩

theorem regular_stateRel {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtRunResultRel retc returns hiddenReturns
        (Source.Outcome.regular source, sourceCtx)
        (Structured.Outcome.regular target, targetCtx)) :
    StateRel targetCtx.layout hiddenReturns source target ∧
      CtxRel retc sourceCtx targetCtx := by
  simpa [StmtRunResultRel, Source.Outcome.regular,
    Locals.Source.Outcome.regular, Structured.Outcome.regular] using hRel

theorem outcomeRel_of_nonregular {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtRunResultRel retc returns hiddenReturns
        (sourceOutcome, sourceCtx) (targetOutcome, targetCtx))
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    ∃ outcomeLayout,
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        sourceOutcome targetOutcome := by
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [StmtRunResultRel] at hRel hNonregular ⊢
          all_goals exact hRel.1

theorem of_nonregular {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hOutcome :
      ∃ outcomeLayout,
        StmtOutcomeRel returns outcomeLayout hiddenReturns
          sourceOutcome targetOutcome)
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    StmtRunResultRel retc returns hiddenReturns
      (sourceOutcome, sourceCtx) (targetOutcome, targetCtx) := by
  rcases hOutcome with ⟨outcomeLayout, hOutcomeRel⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          exact False.elim (hNonregular rfl)
      | brk =>
          simpa [StmtRunResultRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                { state := sourceState, mode := Locals.Source.Mode.brk }
                targetOutcome ∧
                CtxRel retc sourceCtx targetCtx from
              ⟨outcomeLayout, hOutcomeRel, hCtx⟩)
      | cont =>
          simpa [StmtRunResultRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                { state := sourceState, mode := Locals.Source.Mode.cont }
                targetOutcome ∧
                CtxRel retc sourceCtx targetCtx from
              ⟨outcomeLayout, hOutcomeRel, hCtx⟩)
      | leave =>
          simpa [StmtRunResultRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                { state := sourceState, mode := Locals.Source.Mode.leave }
                targetOutcome ∧
                CtxRel retc sourceCtx targetCtx from
              ⟨outcomeLayout, hOutcomeRel, hCtx⟩)
      | halt kind =>
          simpa [StmtRunResultRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                (Source.Outcome.halt kind sourceState) targetOutcome ∧
                CtxRel retc sourceCtx targetCtx from
              ⟨outcomeLayout, hOutcomeRel, hCtx⟩)

end StmtRunResultRel

def BlockOpenResultRel (retc : Nat) (returns : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (sourceResult : Source.Outcome × Source.Ctx)
    (targetResult : Locals.Outcome × Locals.Ctx) : Prop :=
  match sourceResult.1.mode, targetResult.1.mode with
  | .regular, .regular =>
      StateRel targetResult.2.layout hiddenReturns
        sourceResult.1.state targetResult.1.state ∧
        CtxRel retc sourceResult.2 targetResult.2
  | _, _ =>
      ∃ outcomeLayout,
        StmtOutcomeRel returns outcomeLayout hiddenReturns
          sourceResult.1 targetResult.1 ∧
          CtxRel retc sourceResult.2 targetResult.2

namespace BlockOpenResultRel

theorem regular {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hRel : StateRel targetCtx.layout hiddenReturns source target) :
    BlockOpenResultRel retc returns hiddenReturns
      (Source.Outcome.regular source, sourceCtx)
      (Structured.Outcome.regular target, targetCtx) := by
  exact ⟨hRel, hCtx⟩

theorem outcomeRel_of_nonregular {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      BlockOpenResultRel retc returns hiddenReturns
        (sourceOutcome, sourceCtx) (targetOutcome, targetCtx))
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    ∃ outcomeLayout,
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        sourceOutcome targetOutcome := by
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [BlockOpenResultRel] at hRel hNonregular ⊢
          all_goals exact hRel.1

end BlockOpenResultRel

def BlockScopedOutcomeRel (returns : List Name) (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.Outcome) (target : Locals.Outcome) : Prop :=
  match source.mode, target.mode with
  | .regular, .regular =>
      StateRel layout hiddenReturns source.state target.state
  | _, _ =>
      ∃ outcomeLayout,
        StmtOutcomeRel returns outcomeLayout hiddenReturns source target

namespace BlockScopedOutcomeRel

theorem regular {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    BlockScopedOutcomeRel returns layout hiddenReturns
      (Source.Outcome.regular source) (Structured.Outcome.regular target) := by
  exact hRel

theorem nonregular {returns layout outcomeLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.Outcome} {target : Locals.Outcome}
    (hRel : StmtOutcomeRel returns outcomeLayout hiddenReturns source target)
    (hNonregular : source.mode ≠ .regular) :
    BlockScopedOutcomeRel returns layout hiddenReturns source target := by
  cases source with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          exact False.elim (hNonregular rfl)
      | brk =>
          simpa [BlockScopedOutcomeRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                { state := sourceState, mode := Locals.Source.Mode.brk }
                target from
              ⟨outcomeLayout, hRel⟩)
      | cont =>
          simpa [BlockScopedOutcomeRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                { state := sourceState, mode := Locals.Source.Mode.cont }
                target from
              ⟨outcomeLayout, hRel⟩)
      | leave =>
          simpa [BlockScopedOutcomeRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                { state := sourceState, mode := Locals.Source.Mode.leave }
                target from
              ⟨outcomeLayout, hRel⟩)
      | halt kind =>
          simpa [BlockScopedOutcomeRel] using
            (show ∃ outcomeLayout,
              StmtOutcomeRel returns outcomeLayout hiddenReturns
                (Source.Outcome.halt kind sourceState) target from
              ⟨outcomeLayout, hRel⟩)

theorem to_stmtOutcomeRel_of_not_break_continue
    {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.Outcome} {target : Locals.Outcome}
    (hRel :
      BlockScopedOutcomeRel returns layout hiddenReturns source target)
    (hNotBreak : source.mode ≠ .brk)
    (hNotContinue : source.mode ≠ .cont) :
    StmtOutcomeRel returns layout hiddenReturns source target := by
  cases source with
  | mk sourceState sourceMode =>
      cases target with
      | mk targetState targetMode =>
          cases sourceMode with
          | regular =>
              cases targetMode <;>
                simpa [BlockScopedOutcomeRel, StmtOutcomeRel] using hRel
          | brk =>
              exact False.elim (hNotBreak rfl)
          | cont =>
              exact False.elim (hNotContinue rfl)
          | leave =>
              cases targetMode <;>
                simpa [BlockScopedOutcomeRel, StmtOutcomeRel] using hRel
          | halt kind =>
              cases targetMode <;>
                simpa [BlockScopedOutcomeRel, StmtOutcomeRel] using hRel

theorem regular_stateRel {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel :
      BlockScopedOutcomeRel returns layout hiddenReturns
        (Source.Outcome.regular source)
        (Structured.Outcome.regular target)) :
    StateRel layout hiddenReturns source target := by
  simpa [BlockScopedOutcomeRel, Source.Outcome.regular,
    Locals.Source.Outcome.regular, Structured.Outcome.regular] using hRel

theorem leave_stmtOutcomeRel {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel :
      BlockScopedOutcomeRel returns layout hiddenReturns
        (Source.Outcome.leave source)
        (Structured.Outcome.leave target)) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.leave source)
      (Structured.Outcome.leave target) :=
  to_stmtOutcomeRel_of_not_break_continue hRel
    (by simp [Source.Outcome.leave, Locals.Source.Outcome.leave])
    (by simp [Source.Outcome.leave, Locals.Source.Outcome.leave])

theorem halt_stmtOutcomeRel {returns layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {kind : Assembly.HaltKind}
    {source : Source.State} {target : Locals.RunState}
    (hRel :
      BlockScopedOutcomeRel returns layout hiddenReturns
        (Source.Outcome.halt kind source)
        (Structured.Outcome.halt kind target)) :
    StmtOutcomeRel returns layout hiddenReturns
      (Source.Outcome.halt kind source)
      (Structured.Outcome.halt kind target) :=
  to_stmtOutcomeRel_of_not_break_continue hRel
    (by simp [Source.Outcome.halt, Locals.Source.Outcome.halt])
    (by simp [Source.Outcome.halt, Locals.Source.Outcome.halt])

end BlockScopedOutcomeRel

namespace StmtRunResultRel

theorem to_blockOpenResultRel {retc : Nat} {returns : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceResult : Source.Outcome × Source.Ctx}
    {targetResult : Locals.Outcome × Locals.Ctx}
    (hRel :
      StmtRunResultRel retc returns hiddenReturns sourceResult targetResult) :
    BlockOpenResultRel retc returns hiddenReturns sourceResult targetResult := by
  rcases sourceResult with ⟨sourceOutcome, sourceCtx⟩
  rcases targetResult with ⟨targetOutcome, targetCtx⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode
          all_goals
            simpa [StmtRunResultRel, BlockOpenResultRel] using hRel

end StmtRunResultRel

def LoopStmtRunResultRel (retc : Nat) (returns loopLayout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (sourceResult : Source.Outcome × Source.Ctx)
    (targetResult : Locals.Outcome × Locals.Ctx) : Prop :=
  match sourceResult.1.mode, targetResult.1.mode with
  | .regular, .regular =>
      StateRel targetResult.2.layout hiddenReturns
        sourceResult.1.state targetResult.1.state ∧
        CtxRel retc sourceResult.2 targetResult.2
  | .brk, .brk
  | .cont, .cont =>
      StateRel loopLayout hiddenReturns
        sourceResult.1.state targetResult.1.state ∧
        CtxRel retc sourceResult.2 targetResult.2
  | .leave, .leave
  | .halt _, .halt _ =>
      StmtOutcomeRel returns loopLayout hiddenReturns
        sourceResult.1 targetResult.1 ∧
        CtxRel retc sourceResult.2 targetResult.2
  | _, _ => False

namespace LoopStmtRunResultRel

theorem to_stmtRunResultRel {retc : Nat} {returns loopLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceResult : Source.Outcome × Source.Ctx}
    {targetResult : Locals.Outcome × Locals.Ctx}
    (hRel :
      LoopStmtRunResultRel retc returns loopLayout hiddenReturns
        sourceResult targetResult) :
    StmtRunResultRel retc returns hiddenReturns sourceResult targetResult := by
  rcases sourceResult with ⟨sourceOutcome, sourceCtx⟩
  rcases targetResult with ⟨targetOutcome, targetCtx⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [LoopStmtRunResultRel, StmtRunResultRel, StmtOutcomeRel]
              at hRel ⊢
          all_goals
            first
            | exact hRel
            | exact ⟨⟨loopLayout, hRel.1⟩, hRel.2⟩

theorem of_stmtRunResultRel_not_break_continue
    {retc : Nat} {returns loopLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceResult : Source.Outcome × Source.Ctx}
    {targetResult : Locals.Outcome × Locals.Ctx}
    (hRel :
      StmtRunResultRel retc returns hiddenReturns sourceResult targetResult)
    (hNotBreak : sourceResult.1.mode ≠ .brk)
    (hNotContinue : sourceResult.1.mode ≠ .cont) :
    LoopStmtRunResultRel retc returns loopLayout hiddenReturns
      sourceResult targetResult := by
  rcases sourceResult with ⟨sourceOutcome, sourceCtx⟩
  rcases targetResult with ⟨targetOutcome, targetCtx⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode with
          | regular =>
              cases targetMode <;>
                simpa [LoopStmtRunResultRel, StmtRunResultRel,
                  StmtOutcomeRel] using hRel
          | brk =>
              exact False.elim (hNotBreak rfl)
          | cont =>
              exact False.elim (hNotContinue rfl)
          | leave =>
              cases targetMode <;>
                simpa [LoopStmtRunResultRel, StmtRunResultRel,
                  StmtOutcomeRel] using hRel
          | halt kind =>
              cases targetMode <;>
                simpa [LoopStmtRunResultRel, StmtRunResultRel,
                  StmtOutcomeRel] using hRel

theorem brk {retc : Nat} {returns loopLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
      StmtOutcomeRel returns loopLayout hiddenReturns
        (Source.Outcome.brk source) (Structured.Outcome.brk target))
    (hCtx : CtxRel retc sourceCtx targetCtx) :
    LoopStmtRunResultRel retc returns loopLayout hiddenReturns
      (Source.Outcome.brk source, sourceCtx)
      (Structured.Outcome.brk target, targetCtx) := by
  exact ⟨hRel, hCtx⟩

theorem cont {retc : Nat} {returns loopLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    (hRel :
