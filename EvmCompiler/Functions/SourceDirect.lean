theorem call_stmtRunBridge_from_source_run_with_layout
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDupLayout : targetCtx.layout.Nodup)
    (hScoped :
      Scope.Stmt.Scoped sourceCtx.scope (.call targets functionName args))
    (hArgAccessBound :
      targetCtx.layout.length + Access.exprSeqWidth (Lower.argExprs args) ≤
        16)
    (hAssignBound : targets.length + targetCtx.layout.length ≤ 16)
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.run prim program sourceCtx (fuel + 1)
          (.call targets functionName args) source =
        .ok sourceResult)
    (hReturned :
      ∀ {sourceAfterArgs argValues fn sharedAfterCall returnValues
          returnStore targetAfterArgs callerBase},
        Source.ArgList.eval prim args source =
          .ok (sourceAfterArgs, argValues) →
        Source.FunList.find? functionName program.functions = some fn →
        Source.FunDef.runBody prim program fn argValues fuel
            sourceAfterArgs.shared =
          .ok (Source.CallResult.returned sharedAfterCall returnValues) →
        Source.Store.assignMany targets returnValues sourceAfterArgs.vars =
          some returnStore →
        CallPrelude targetCtx.layout hiddenReturns sourceAfterArgs
          sharedAfterCall argValues targetCtx args target targetAfterArgs
          callerBase →
        ∃ targetMode returnedTarget,
          (targetMode = .regular ∨ targetMode = .leave) ∧
          Direct.FunDef.runBody program fn fuel
              ((targetAfterArgs.withEVM
                { targetAfterArgs.evm with stack := argValues.reverse }).pushReturn
                callerBase.evm.stack fn.returns.length) =
            .ok { state := returnedTarget, mode := targetMode } ∧
          ReturnedStackRel
            (Structured.ReturnDest.mk callerBase.evm.stack
                fn.returns.length :: hiddenReturns)
            (sourceAfterArgs.withShared sharedAfterCall) returnValues
            returnedTarget)
    (hHalted :
      ∀ {sourceAfterArgs argValues fn kind haltedSource targetAfterArgs
          callerBase},
        Source.ArgList.eval prim args source =
          .ok (sourceAfterArgs, argValues) →
        Source.FunList.find? functionName program.functions = some fn →
        Source.FunDef.runBody prim program fn argValues fuel
            sourceAfterArgs.shared =
          .ok (Source.CallResult.halted kind haltedSource) →
        CallPrelude targetCtx.layout hiddenReturns sourceAfterArgs
          haltedSource.shared argValues targetCtx args target targetAfterArgs
          callerBase →
        ∃ haltedTarget,
          Direct.FunDef.runBody program fn fuel
              ((targetAfterArgs.withEVM
                { targetAfterArgs.evm with stack := argValues.reverse }).pushReturn
                callerBase.evm.stack fn.returns.length) =
            .ok (Structured.Outcome.halt kind haltedTarget) ∧
          haltedSource.shared = haltedTarget.evm.toSharedState) :
    StmtRunBridgeWithLayout prim program returns retc (fuel + 1)
      sourceCtx targetCtx hiddenReturns (.call targets functionName args)
      source target := by
  have hTargetsNoDup : targets.Nodup := hScoped.1
  have hContains : Scope.containsAll sourceCtx.scope targets := hScoped.2.1
  cases hArgEval : Source.ArgList.eval prim args source with
  | error err =>
      simp [Source.Stmt.run, hTargetsNoDup, hArgEval] at hSourceRun
  | ok argResult =>
      rcases argResult with ⟨sourceAfterArgs, argValues⟩
      cases hLookup :
          Source.FunList.find? functionName program.functions with
      | none =>
          have hLookupDirect :
              FunList.find? functionName program.functions = none := by
            simpa [FunList.source_find?_eq] using hLookup
          simp [Source.Stmt.run, hTargetsNoDup, hArgEval, hLookupDirect,
            Source.invalid, Structured.invalid] at hSourceRun
      | some fn =>
          have hLookupDirect :
              FunList.find? functionName program.functions = some fn := by
            simpa [FunList.source_find?_eq] using hLookup
          simp [Source.Stmt.run, hTargetsNoDup, hArgEval, hLookupDirect]
            at hSourceRun
          cases hBody :
              Source.FunDef.runBody prim program fn argValues fuel
                sourceAfterArgs.shared with
          | error err =>
              simp [hBody] at hSourceRun
          | ok callResult =>
              cases callResult with
              | returned sharedAfterCall returnValues =>
                  cases hAssign :
                      Source.Store.assignMany targets returnValues
                        sourceAfterArgs.vars with
                  | none =>
                      simp [hBody, hAssign, Source.invalid,
                        Structured.invalid] at hSourceRun
                  | some returnStore =>
                      rcases
                          CallPrelude.exists_of_eval_stmt_scoped hPrim hCtx
                            hNoDupLayout hScoped hArgAccessBound hRel hArgEval
                            (sharedAfterCall := sharedAfterCall) with
                        ⟨targetAfterArgs, callerBase, hPrelude⟩
                      rcases hReturned hArgEval hLookup hBody hAssign
                          hPrelude with
                        ⟨targetMode, returnedTarget, hTargetMode,
                          hTargetBody, hReturnedRel⟩
                      exact
                        call_returned_stmtRunBridge_with_layout_from_parts
                          (prim := prim) (program := program)
                          (returns := returns) (retc := retc)
                          (sourceCtx := sourceCtx) (targetCtx := targetCtx)
                          (source := source)
                          (sourceAfterArgs := sourceAfterArgs)
                          (target := target)
                          (targetAfterArgs := targetAfterArgs)
                          (callerBase := callerBase)
                          (returnedTarget := returnedTarget)
                          (targetMode := targetMode) (fuel := fuel)
                          (hiddenReturns := hiddenReturns)
                          (targets := targets)
                          (functionName := functionName) (args := args)
                          (fn := fn) (argValues := argValues)
                          (returnValues := returnValues)
                          (returnStore := returnStore)
                          (sharedAfterCall := sharedAfterCall)
                          hCtx hNoDupLayout hTargetsNoDup hContains
                          hAssignBound hArgEval hPrelude hLookup hBody
                          hTargetMode hTargetBody hReturnedRel hAssign
              | halted kind haltedSource =>
                  rcases
                      CallPrelude.exists_of_eval_stmt_scoped hPrim hCtx
                        hNoDupLayout hScoped hArgAccessBound hRel hArgEval
                        (sharedAfterCall := haltedSource.shared) with
                    ⟨targetAfterArgs, callerBase, hPrelude⟩
                  rcases hHalted hArgEval hLookup hBody hPrelude with
                    ⟨haltedTarget, hTargetBody, hHaltShared⟩
                  exact
                    call_halted_stmtRunBridge_with_layout_from_parts
                      (prim := prim) (program := program)
                      (returns := returns) (retc := retc)
                      (sourceCtx := sourceCtx) (targetCtx := targetCtx)
                      (source := source)
                      (sourceAfterArgs := sourceAfterArgs)
                      (haltedSource := haltedSource) (target := target)
                      (targetAfterArgs := targetAfterArgs)
                      (callerBase := callerBase)
                      (haltedTarget := haltedTarget) (fuel := fuel)
                      (hiddenReturns := hiddenReturns) (targets := targets)
                      (functionName := functionName) (args := args)
                      (fn := fn) (argValues := argValues) (kind := kind)
                      hCtx hTargetsNoDup hArgEval hPrelude hLookup hBody
                      hTargetBody hHaltShared

