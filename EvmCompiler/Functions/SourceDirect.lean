    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {returns : List Name}
    {retc fuel : Nat}
    {loopCtx postBase bodyBase : Source.Ctx}
    {targetLoopCtx targetPostBase targetBodyBase : Locals.Ctx}
    {source sourceAfterCond : Source.State}
    {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {post body : Block} {value : Word}
    {kind : Assembly.HaltKind}
    (hCtx : CtxRel retc loopCtx targetLoopCtx)
    (hNoDup : targetLoopCtx.layout.Nodup)
    (hCondScoped : Scope.ExprScoped loopCtx.scope cond)
    (hAccessBound : targetLoopCtx.layout.length + Access.exprWidth cond ≤ 16)
    (hRel : StateRel targetLoopCtx.layout hiddenReturns source target)
    (hEvalOne :
      Source.Expr.evalOne prim cond source = .ok (sourceAfterCond, value))
    (hTrue : (value != EvmYul.UInt256.ofNat 0) = true)
    (hBody :
      ∀ targetAfterCond,
        StateRel targetLoopCtx.layout hiddenReturns sourceAfterCond
          targetAfterCond →
        ∃ bodySource bodyTarget,
          Source.Block.runScoped prim program bodyBase body fuel
              sourceAfterCond =
            .ok (Source.Outcome.halt kind bodySource) ∧
          Direct.Block.runScoped program returns targetBodyBase body fuel
              targetAfterCond =
            .ok (Structured.Outcome.halt kind bodyTarget) ∧
          StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
            (Source.Outcome.halt kind bodySource)
            (Structured.Outcome.halt kind bodyTarget)) :
    ∃ bodySource bodyTarget,
      Source.Stmt.runForLoop prim program loopCtx cond postBase post bodyBase
          body (fuel + 1) source =
        .ok (Source.Outcome.halt kind bodySource) ∧
      Direct.Stmt.runForLoop program returns targetLoopCtx cond targetPostBase
          post targetBodyBase body (fuel + 1) target =
        .ok (Structured.Outcome.halt kind bodyTarget) ∧
      StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        (Source.Outcome.halt kind bodySource)
        (Structured.Outcome.halt kind bodyTarget) := by
  rcases runForLoop_condition_bridge_from_scoped hPrim hCtx hNoDup
      hCondScoped hAccessBound hRel hEvalOne hTrue with
    ⟨targetAfterCond, hSourceCond, hTargetCond, hCondRel⟩
  rcases hBody targetAfterCond hCondRel with
    ⟨bodySource, bodyTarget, hSourceBody, hTargetBody, hBodyRel⟩
  exact ⟨bodySource, bodyTarget,
    runForLoop_body_halt_from_scoped
      (prim := prim) (program := program) (returns := returns)
      (fuel := fuel) (loopCtx := loopCtx) (postBase := postBase)
      (bodyBase := bodyBase) (targetLoopCtx := targetLoopCtx)
      (targetPostBase := targetPostBase)
      (targetBodyBase := targetBodyBase) (source := source)
      (sourceAfterCond := sourceAfterCond) (bodySource := bodySource)
      (target := target) (targetAfterCond := targetAfterCond)
      (bodyTarget := bodyTarget) (hiddenReturns := hiddenReturns)
      (cond := cond) (post := post) (body := body) (kind := kind)
      hSourceCond hTargetCond hSourceBody hTargetBody hBodyRel⟩

theorem runForLoop_body_next_post_leave_or_halt_from_scoped
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {fuel : Nat}
    {loopCtx postBase bodyBase : Source.Ctx}
    {targetLoopCtx targetPostBase targetBodyBase : Locals.Ctx}
    {source sourceAfterCond : Source.State}
    {target targetAfterCond : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {post body : Block}
    {sourceBody targetBody sourcePost targetPost}
    (hSourceCond :
      Source.Expr.evalCondition prim cond source =
        .ok (sourceAfterCond, true))
    (hTargetCond :
      Locals.Direct.Expr.runCondition targetLoopCtx cond target =
        .ok (targetAfterCond, true))
    (hSourceBody :
      Source.Block.runScoped prim program bodyBase body fuel
          sourceAfterCond =
        .ok sourceBody)
    (hTargetBody :
      Direct.Block.runScoped program returns targetBodyBase body fuel
          targetAfterCond =
        .ok targetBody)
    (hBodyRel :
      StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        sourceBody targetBody)
    (hBodyNext :
      sourceBody.mode = .regular ∨ sourceBody.mode = .cont)
    (hSourcePost :
      Source.Block.runScoped prim program postBase post fuel
          sourceBody.state =
        .ok sourcePost)
    (hTargetPost :
      Direct.Block.runScoped program returns targetPostBase post fuel
          targetBody.state =
        .ok targetPost)
    (hPostRel :
      StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        sourcePost targetPost)
    (hPostPass :
      sourcePost.mode = .leave ∨
        ∃ kind, sourcePost.mode = .halt kind) :
    Source.Stmt.runForLoop prim program loopCtx cond postBase post bodyBase
        body (fuel + 1) source =
      .ok sourcePost ∧
    Direct.Stmt.runForLoop program returns targetLoopCtx cond targetPostBase
        post targetBodyBase body (fuel + 1) target =
      .ok targetPost ∧
    StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
      sourcePost targetPost := by
  constructor
  · cases sourceBody with
    | mk sourceBodyState sourceBodyMode =>
        cases sourcePost with
        | mk sourcePostState sourcePostMode =>
            cases sourceBodyMode <;> cases sourcePostMode <;>
              simp [Source.Stmt.runForLoop, hSourceCond, hSourceBody,
                hSourcePost] at hBodyNext hPostPass ⊢
  constructor
  · cases sourceBody with
    | mk sourceBodyState sourceBodyMode =>
        cases targetBody with
        | mk targetBodyState targetBodyMode =>
            cases sourcePost with
            | mk sourcePostState sourcePostMode =>
                cases targetPost with
                | mk targetPostState targetPostMode =>
                    cases sourceBodyMode <;> cases targetBodyMode <;>
                      cases sourcePostMode <;> cases targetPostMode <;>
                        simp [Direct.Stmt.runForLoop, hTargetCond,
                          hTargetBody, hTargetPost, StmtOutcomeRel] at hBodyRel hBodyNext hPostRel hPostPass ⊢
  · simpa using hPostRel

