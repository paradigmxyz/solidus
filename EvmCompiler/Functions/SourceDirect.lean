                            hNonregular with
                        ⟨hSource, hTarget, hRelResult⟩
                      exact
                        ⟨⟨_, _, hSource, hTarget, hRelResult⟩,
                          by
                            intro sourceInner sourceCtxRegular _targetInner
                              _targetCtxRegular hSourceRegular
                              _hTargetRegular _hRegularRel
                            have hBad :
