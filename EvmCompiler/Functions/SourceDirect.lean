import EvmCompiler.Functions.SourceSemantics
import EvmCompiler.Functions.Semantics
import EvmCompiler.Locals.SourceLowering

namespace EvmCompiler
namespace Functions

/-
Boundary relation from the stack-free function source interpreter to the
existing direct procedure backend.

The source side uses named stores and Yul-like call/leave behavior.  The direct
backend uses a concrete operand stack, cleanup depths, and ghost return frames.
This module owns that representation relation so object/Yul layers can target
`Functions.Source` without seeing return-frame machinery.
-/
namespace SourceDirect

namespace ExprSeq

theorem eval_mpr {prim : Source.PrimitiveSemantics}
    {n m : Nat} (h : m = n) (exprs : Locals.ExprSeq n)
    (state : Source.State) :
    Locals.Source.Expr.ExprSeq.eval prim
        (Eq.mpr (congrArg Locals.ExprSeq h) exprs) state =
      Locals.Source.Expr.ExprSeq.eval prim exprs state := by
  cases h
  rfl

theorem sourceOwned_mpr {n m : Nat} (h : m = n)
    (exprs : Locals.ExprSeq n) :
    Locals.Source.ExprSeq.SourceOwned
        (Eq.mpr (congrArg Locals.ExprSeq h) exprs) ↔
      Locals.Source.ExprSeq.SourceOwned exprs := by
  cases h
  rfl

theorem scoped_mpr {n m : Nat} (h : m = n)
    (env : List Name) (exprs : Locals.ExprSeq n) :
    Scope.ExprSeqScoped env
        (Eq.mpr (congrArg Locals.ExprSeq h) exprs) ↔
      Scope.ExprSeqScoped env exprs := by
  cases h
  rfl

theorem varSlotValuesAt_mpr {n m : Nat} (h : m = n)
    (layout : List Name) (stack : EvmYul.Stack Word) (offset : Nat)
    (exprs : Locals.ExprSeq n) (values : List Word) :
    Locals.ExprSeq.VarSlotValuesAt layout stack offset
        (Eq.mpr (congrArg Locals.ExprSeq h) exprs) values ↔
      Locals.ExprSeq.VarSlotValuesAt layout stack offset exprs values := by
  cases h
  rfl

theorem varSlotValuesAt_mp {n m : Nat} (h : n = m)
    (layout : List Name) (stack : EvmYul.Stack Word) (offset : Nat)
    (exprs : Locals.ExprSeq n) (values : List Word) :
    Locals.ExprSeq.VarSlotValuesAt layout stack offset
        (Eq.mp (congrArg Locals.ExprSeq h) exprs) values ↔
      Locals.ExprSeq.VarSlotValuesAt layout stack offset exprs values := by
  cases h
  rfl

end ExprSeq

namespace Expr

theorem eval_of_evalOne {prim : Source.PrimitiveSemantics}
    {expr : Expr 1} {state state' : Source.State} {value : Word}
    (hOne : Source.Expr.evalOne prim expr state = .ok (state', value)) :
    Source.Expr.eval prim expr state = .ok (state', [value]) := by
  unfold Source.Expr.evalOne Locals.Source.Expr.evalOne at hOne
  cases hEval : Source.Expr.eval prim expr state with
  | error _err =>
      simp [hEval] at hOne
  | ok result =>
      rcases result with ⟨s, values⟩
      simp [hEval] at hOne
      cases values with
      | nil =>
          simp [Locals.Source.invalid, Structured.invalid] at hOne
      | cons head tail =>
          cases tail with
          | nil =>
              simp at hOne
              rcases hOne with ⟨rfl, rfl⟩
              simpa using hEval
          | cons _second _more =>
              simp [Locals.Source.invalid, Structured.invalid] at hOne

end Expr

namespace ArgList

theorem eval_argExprs {prim : Source.PrimitiveSemantics} :
    ∀ {args : List (Expr 1)} {state state' : Source.State}
      {values : List Word},
      Source.ArgList.eval prim args state = .ok (state', values) →
        Locals.Source.Expr.ExprSeq.eval prim (Lower.argExprs args) state =
          .ok (state', values) := by
  intro args
  induction args with
  | nil =>
      intro state state' values hEval
      simp [Source.ArgList.eval, Lower.argExprs] at hEval ⊢
      rcases hEval with ⟨rfl, rfl⟩
      rfl
  | cons arg rest ih =>
      intro state state' values hEval
      unfold Source.ArgList.eval at hEval
      cases hOne : Source.Expr.evalOne prim arg state with
      | error _err =>
          simp [hOne] at hEval
      | ok oneResult =>
          rcases oneResult with ⟨stateAfterArg, value⟩
          simp [hOne] at hEval
          cases hRest : Source.ArgList.eval prim rest stateAfterArg with
          | error _err =>
              simp [hRest] at hEval
          | ok restResult =>
              rcases restResult with ⟨stateAfterRest, restValues⟩
              simp [hRest] at hEval
              rcases hEval with ⟨rfl, rfl⟩
              have hOneEval := Expr.eval_of_evalOne hOne
              have hTail := ih hRest
              rw [Lower.argExprs]
              rw [ExprSeq.eval_mpr (by simp [Nat.add_comm])]
              simp [Locals.Source.Expr.ExprSeq.eval, hOneEval, hTail]

end ArgList

namespace FunList

@[simp] theorem source_find?_eq (name : Name) :
    ∀ functions : List FunDef,
      Source.FunList.find? name functions = FunList.find? name functions
  | [] => by
      simp [Source.FunList.find?, FunList.find?]
  | fn :: rest => by
      by_cases hName : fn.name = name
      · simp [Source.FunList.find?, FunList.find?, hName]
      · simp [Source.FunList.find?, FunList.find?, hName,
          source_find?_eq name rest]

theorem scoped_of_find? {name : Name} :
    ∀ {functions : List FunDef} {fn : FunDef},
      FunList.Scoped functions →
      FunList.find? name functions = some fn →
      fn.Scoped
  | [], fn, hScoped, hFind => by
      simp [FunList.find?] at hFind
  | head :: rest, fn, hScoped, hFind => by
      by_cases hName : head.name = name
      · simp [FunList.find?, hName] at hFind
        cases hFind
        exact hScoped.1
      · simp [FunList.find?, hName] at hFind
        exact scoped_of_find? hScoped.2 hFind

theorem source_scoped_of_find? {name : Name} {functions : List FunDef}
    {fn : FunDef}
    (hScoped : FunList.Scoped functions)
    (hFind : Source.FunList.find? name functions = some fn) :
    fn.Scoped := by
  exact scoped_of_find? hScoped (by simpa [source_find?_eq name functions] using hFind)

end FunList

namespace SourceScope

mutual
  theorem exprScoped_sourceOwned {env : List Name}
      {results : Nat} {expr : Expr results}
      (hScoped : Functions.Scope.ExprScoped env expr) :
      Locals.Source.Expr.SourceOwned expr := by
    cases expr with
    | lit _value =>
        simp [Locals.Source.Expr.SourceOwned]
    | var _name =>
        simp [Locals.Source.Expr.SourceOwned]
    | code _code =>
        exact False.elim hScoped
    | prim _op args =>
        exact exprSeqScoped_sourceOwned hScoped

  theorem exprSeqScoped_sourceOwned {env : List Name}
      {results : Nat} {exprs : Locals.ExprSeq results}
      (hScoped : Functions.Scope.ExprSeqScoped env exprs) :
      Locals.Source.ExprSeq.SourceOwned exprs := by
    cases exprs with
    | nil =>
        simp [Locals.Source.ExprSeq.SourceOwned]
    | cons head tail =>
        rcases hScoped with ⟨hHead, hTail⟩
        exact ⟨exprScoped_sourceOwned hHead,
          exprSeqScoped_sourceOwned hTail⟩
end

theorem stmt_outEnv_nodup {env : List Name} {stmt : Stmt}
    (hScoped : Functions.Scope.Stmt.Scoped env stmt)
    (hNoDup : env.Nodup) :
    (Functions.Scope.Stmt.outEnv env stmt).Nodup := by
  cases stmt <;> simp [Functions.Scope.Stmt.outEnv,
    Functions.Scope.Stmt.Scoped] at hScoped ⊢
  · exact hNoDup
  · exact ⟨hScoped.1, hNoDup⟩
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup

mutual
  theorem block_outEnv_nodup {env : List Name} {block : Block}
      (hScoped : Functions.Scope.Block.Scoped env block)
      (hNoDup : env.Nodup) :
      (Functions.Scope.Block.outEnv env block).Nodup := by
    cases block with
    | mk stmts =>
        exact stmtList_outEnv_nodup hScoped hNoDup

  theorem stmtList_outEnv_nodup :
      ∀ {env : List Name} {stmts : List Stmt},
        Functions.Scope.StmtList.Scoped env stmts →
        env.Nodup →
          (Functions.Scope.StmtList.outEnv env stmts).Nodup
    | _env, [], hScoped, hNoDup => by
        simpa [Functions.Scope.StmtList.outEnv]
    | env, stmt :: rest, hScoped, hNoDup => by
        rcases hScoped with ⟨hHead, hTail⟩
        exact stmtList_outEnv_nodup
          (env := Functions.Scope.Stmt.outEnv env stmt) (stmts := rest) hTail
          (stmt_outEnv_nodup hHead hNoDup)
end

theorem stmt_outEnv_contains_of_contains {env : List Name} {stmt : Stmt}
    {name : Name}
    (hContains : name ∈ env) :
    name ∈ Functions.Scope.Stmt.outEnv env stmt := by
  cases stmt <;> simp [Functions.Scope.Stmt.outEnv, hContains]

theorem stmt_outEnv_length_le {env : List Name} {stmt : Stmt} :
    env.length ≤ (Functions.Scope.Stmt.outEnv env stmt).length := by
  cases stmt <;> simp [Functions.Scope.Stmt.outEnv]

mutual
  theorem block_outEnv_contains_of_contains {env : List Name} {block : Block}
      {name : Name}
      (hContains : name ∈ env) :
      name ∈ Functions.Scope.Block.outEnv env block := by
    cases block with
    | mk stmts =>
        exact stmtList_outEnv_contains_of_contains (stmts := stmts)
          hContains

  theorem stmtList_outEnv_contains_of_contains {name : Name} :
      ∀ {env : List Name} {stmts : List Stmt},
        name ∈ env →
          name ∈ Functions.Scope.StmtList.outEnv env stmts
    | _env, [], hContains => by
        simpa [Functions.Scope.StmtList.outEnv] using hContains
    | env, stmt :: rest, hContains => by
        exact stmtList_outEnv_contains_of_contains
          (env := Functions.Scope.Stmt.outEnv env stmt) (stmts := rest)
          (stmt_outEnv_contains_of_contains (stmt := stmt) hContains)
end

mutual
  theorem block_outEnv_length_le {env : List Name} {block : Block} :
      env.length ≤ (Functions.Scope.Block.outEnv env block).length := by
    cases block with
    | mk stmts =>
        exact stmtList_outEnv_length_le (env := env) (stmts := stmts)

  theorem stmtList_outEnv_length_le :
      ∀ {env : List Name} {stmts : List Stmt},
        env.length ≤ (Functions.Scope.StmtList.outEnv env stmts).length
    | _env, [] => by
        simp [Functions.Scope.StmtList.outEnv]
    | env, stmt :: rest => by
        have hHead :
            env.length ≤
              (Functions.Scope.Stmt.outEnv env stmt).length :=
          stmt_outEnv_length_le (env := env) (stmt := stmt)
        have hTail :
            (Functions.Scope.Stmt.outEnv env stmt).length ≤
              (Functions.Scope.StmtList.outEnv
                (Functions.Scope.Stmt.outEnv env stmt) rest).length :=
          stmtList_outEnv_length_le
            (env := Functions.Scope.Stmt.outEnv env stmt) (stmts := rest)
        simpa [Functions.Scope.StmtList.outEnv] using Nat.le_trans hHead hTail
end

theorem switch_select_block_scoped {env : List Name} {scrutinee : Word}
    {cases : List (Word × Block)} {defaultBody : Option Block}
    {body : Block}
    (hCases : Scope.CaseList.Scoped env cases)
    (hDefault : Scope.Default.Scoped env defaultBody)
    (hSelect : Source.Switch.select scrutinee cases defaultBody = some body) :
    Scope.Block.Scoped env body := by
  induction cases generalizing defaultBody body with
  | nil =>
      cases defaultBody with
      | none =>
          simp [Source.Switch.select] at hSelect
      | some defaultBlock =>
          simp [Source.Switch.select] at hSelect
          cases hSelect
          simpa [Scope.Default.Scoped] using hDefault
  | cons head rest ih =>
      rcases head with ⟨value, caseBody⟩
      rcases hCases with ⟨hCaseBody, hRest⟩
      by_cases hEq : value = scrutinee
      · simp [Source.Switch.select, hEq] at hSelect
        cases hSelect
        exact hCaseBody
      · exact ih hRest hDefault
          (by simpa [Source.Switch.select, hEq] using hSelect)

end SourceScope

mutual
  /--
  Source programs whose function-level constructs are handled at this
  source/direct boundary.

  Unlike the `Functions.SourceLowering.SourceToLocals` source-owned grammar,
  this grammar admits function calls and nonempty-return `leave`: the direct
  procedure backend is exactly where those return-frame details are proved.
  It still rejects raw lower `.code` expressions through
  `Locals.Source.Expr.SourceOwned`, keeping arbitrary structured/stack code out
  of the source-facing function semantics.
  -/
  def Block.SourceOwned (returns : List Name) : Block → Prop
    | ⟨stmts⟩ => StmtList.SourceOwned returns stmts

  def Stmt.SourceOwned (returns : List Name) : Stmt → Prop
    | .expr expr => Locals.Source.Expr.SourceOwned expr
    | .let_ _name value => Locals.Source.Expr.SourceOwned value
    | .assign _name value => Locals.Source.Expr.SourceOwned value
    | .block body => Block.SourceOwned returns body
    | .if_ cond body =>
        Locals.Source.Expr.SourceOwned cond ∧
          Block.SourceOwned returns body
    | .switch scrutinee cases defaultBody =>
        Locals.Source.Expr.SourceOwned scrutinee ∧
          CaseList.SourceOwned returns cases ∧
            Default.SourceOwned returns defaultBody
    | .for_ init cond post body =>
        Block.SourceOwned returns init ∧
          Locals.Source.Expr.SourceOwned cond ∧
            Block.SourceOwned returns post ∧
              Block.SourceOwned returns body
    | .brk => True
    | .cont => True
    | .leave => True
    | .call _targets _functionName args =>
        ∀ arg, arg ∈ args → Locals.Source.Expr.SourceOwned arg
    | .terminal _kind => True
    | .terminalArgs _kind args => Locals.Source.ExprSeq.SourceOwned args

  def StmtList.SourceOwned (returns : List Name) : List Stmt → Prop
    | [] => True
    | stmt :: rest =>
        Stmt.SourceOwned returns stmt ∧
          StmtList.SourceOwned returns rest

  def CaseList.SourceOwned (returns : List Name) :
      List (Word × Block) → Prop
    | [] => True
    | (_value, body) :: rest =>
        Block.SourceOwned returns body ∧
          CaseList.SourceOwned returns rest

  def Default.SourceOwned (returns : List Name) :
      Option Block → Prop
    | none => True
    | some body => Block.SourceOwned returns body
end

namespace FunDef

def SourceOwned (fn : FunDef) : Prop :=
  Block.SourceOwned fn.returns fn.body

end FunDef

namespace FunList

def SourceOwned : List FunDef → Prop
  | [] => True
  | fn :: rest => FunDef.SourceOwned fn ∧ SourceOwned rest

end FunList

namespace Program

def SourceOwned (program : Program) : Prop :=
  FunList.SourceOwned program.functions ∧ Block.SourceOwned [] program.body

end Program

namespace SourceOwned

mutual
  theorem block_of_scoped {returns env : List Name} {block : Block}
      (hScoped : Scope.Block.Scoped env block) :
      Block.SourceOwned returns block := by
    cases block with
    | mk stmts =>
        exact stmtList_of_scoped hScoped

  theorem stmt_of_scoped {returns env : List Name} {stmt : Stmt}
      (hScoped : Scope.Stmt.Scoped env stmt) :
      Stmt.SourceOwned returns stmt := by
    cases stmt with
    | expr expr =>
        exact SourceScope.exprScoped_sourceOwned hScoped
    | let_ name value =>
        exact SourceScope.exprScoped_sourceOwned hScoped.2
    | assign name value =>
        exact SourceScope.exprScoped_sourceOwned hScoped.2
    | block body =>
        exact block_of_scoped hScoped
    | if_ cond body =>
        exact ⟨SourceScope.exprScoped_sourceOwned hScoped.1,
          block_of_scoped hScoped.2⟩
    | switch scrutinee cases defaultBody =>
        exact ⟨SourceScope.exprScoped_sourceOwned hScoped.1,
          caseList_of_scoped hScoped.2.1,
          default_of_scoped hScoped.2.2⟩
    | for_ init cond post body =>
        dsimp [Scope.Stmt.Scoped] at hScoped
        exact ⟨block_of_scoped hScoped.1,
          SourceScope.exprScoped_sourceOwned hScoped.2.1,
          block_of_scoped hScoped.2.2.1,
          block_of_scoped hScoped.2.2.2⟩
    | brk =>
        trivial
    | cont =>
        trivial
    | leave =>
        trivial
    | call targets functionName args =>
        exact fun arg hArg =>
          SourceScope.exprScoped_sourceOwned (hScoped.2.2 arg hArg)
    | terminal kind =>
        trivial
    | terminalArgs kind args =>
        exact SourceScope.exprSeqScoped_sourceOwned hScoped

  theorem stmtList_of_scoped {returns env : List Name} {stmts : List Stmt}
      (hScoped : Scope.StmtList.Scoped env stmts) :
      StmtList.SourceOwned returns stmts := by
    cases stmts with
    | nil =>
        trivial
    | cons stmt rest =>
        exact ⟨stmt_of_scoped hScoped.1,
          stmtList_of_scoped hScoped.2⟩

  theorem caseList_of_scoped {returns env : List Name}
      {cases : List (Word × Block)}
      (hScoped : Scope.CaseList.Scoped env cases) :
      CaseList.SourceOwned returns cases := by
    cases cases with
    | nil =>
        trivial
    | cons head rest =>
        rcases head with ⟨value, body⟩
        exact ⟨block_of_scoped hScoped.1,
          caseList_of_scoped hScoped.2⟩

  theorem default_of_scoped {returns env : List Name}
      {defaultBody : Option Block}
      (hScoped : Scope.Default.Scoped env defaultBody) :
      Default.SourceOwned returns defaultBody := by
    cases defaultBody with
    | none =>
        trivial
    | some body =>
        exact block_of_scoped hScoped
end

theorem funDef_of_scoped {fn : FunDef} (hScoped : fn.Scoped) :
    FunDef.SourceOwned fn :=
  block_of_scoped (Functions.FunDef.bodyScoped hScoped)

theorem funList_of_scoped :
    ∀ {functions : List FunDef},
      FunList.Scoped functions → FunList.SourceOwned functions
  | [], _hScoped => by
      trivial
  | fn :: rest, hScoped => by
      exact ⟨funDef_of_scoped hScoped.1,
        funList_of_scoped hScoped.2⟩

theorem program_of_scoped {program : Program}
    (hScoped : program.Scoped) :
    Program.SourceOwned program :=
  ⟨funList_of_scoped hScoped.1, block_of_scoped hScoped.2⟩

end SourceOwned

namespace FunList

theorem sourceOwned_of_find? {name : Name} :
    ∀ {functions : List FunDef} {fn : FunDef},
      FunList.SourceOwned functions →
      FunList.find? name functions = some fn →
      FunDef.SourceOwned fn
  | [], fn, hOwned, hFind => by
      simp [FunList.find?] at hFind
  | head :: rest, fn, hOwned, hFind => by
      by_cases hName : head.name = name
      · simp [FunList.find?, hName] at hFind
        cases hFind
        exact hOwned.1
      · simp [FunList.find?, hName] at hFind
        exact sourceOwned_of_find? hOwned.2 hFind

theorem source_sourceOwned_of_find? {name : Name} {functions : List FunDef}
    {fn : FunDef}
    (hOwned : FunList.SourceOwned functions)
    (hFind : Source.FunList.find? name functions = some fn) :
    FunDef.SourceOwned fn := by
  exact sourceOwned_of_find? hOwned
    (by simpa [source_find?_eq name functions] using hFind)

end FunList

namespace SourceRun

theorem stmt_regular_scope {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {state sourceInner : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt state =
        .ok (Source.Outcome.regular sourceInner, ctxOut)) :
    ctxOut.scope = Scope.Stmt.outEnv ctx.scope stmt := by
  cases stmt with
  | expr expr =>
      cases hEval : Source.Expr.eval prim expr state with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          subst ctxOut
          rfl
  | let_ name value =>
      cases hEval : Source.Expr.evalOne prim value state with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval, Scope.Stmt.outEnv] at hRun ⊢
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          subst ctxOut
          rfl
  | assign name value =>
      cases hContains : state.vars.contains name with
      | false =>
          simp [Source.Stmt.run, hContains, Source.invalid,
            Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value state with
          | error err =>
              simp [Source.Stmt.run, hContains, hEval] at hRun
          | ok result =>
              simp [Source.Stmt.run, hContains, hEval, Scope.Stmt.outEnv]
                at hRun ⊢
              rcases hRun with ⟨_hOutcome, hCtxEq⟩
              subst ctxOut
              rfl
  | block body =>
      cases hBlock : Source.Block.runScoped prim program ctx body fuel state with
      | error err =>
          simp [Source.Stmt.run, hBlock] at hRun
      | ok outcome =>
          cases outcome with
          | mk outcomeState outcomeMode =>
              cases outcomeMode with
              | regular =>
                  simp [Source.Stmt.run, hBlock, Scope.Stmt.outEnv] at hRun ⊢
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  subst ctxOut
                  rfl
              | brk =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
              | cont =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
              | leave =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
              | halt kind =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Source.Expr.evalCondition prim cond state with
          | error err =>
              simp [Source.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨stateAfterCond, condTrue⟩
              cases condTrue with
              | false =>
                  simp [Source.Stmt.run, hCond, Scope.Stmt.outEnv]
                    at hRun ⊢
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  subst ctxOut
                  rfl
              | true =>
                  cases hBlock :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterCond with
                  | error err =>
                      simp [Source.Stmt.run, hCond, hBlock] at hRun
                  | ok outcome =>
                      cases outcome with
                      | mk outcomeState outcomeMode =>
                          cases outcomeMode with
                          | regular =>
                              simp [Source.Stmt.run, hCond, hBlock,
                                Scope.Stmt.outEnv] at hRun ⊢
                              rcases hRun with ⟨_hOutcome, hCtxEq⟩
                              subst ctxOut
                              rfl
                          | brk =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
                          | cont =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
                          | leave =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
                          | halt kind =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hEval : Source.Expr.evalOne prim scrutinee state with
          | error err =>
              simp [Source.Stmt.run, hEval] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterScrutinee, value⟩
              cases hSelect :
                  Source.Switch.select value cases defaultBody with
              | none =>
                  simp [Source.Stmt.run, hEval, hSelect, Scope.Stmt.outEnv]
                    at hRun ⊢
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  subst ctxOut
                  rfl
              | some body =>
                  cases hBlock :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterScrutinee with
                  | error err =>
                      simp [Source.Stmt.run, hEval, hSelect, hBlock] at hRun
                  | ok outcome =>
                      cases outcome with
                      | mk outcomeState outcomeMode =>
                          cases outcomeMode with
                          | regular =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock,
                                Scope.Stmt.outEnv] at hRun ⊢
                              rcases hRun with ⟨_hOutcome, hCtxEq⟩
                              subst ctxOut
                              rfl
                          | brk =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
                          | cont =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
                          | leave =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
                          | halt kind =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hInit :
              Source.Block.runOpen prim program ctx.withoutLoopControl fuel
                init state with
          | error err =>
              simp [Source.Stmt.run, hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases initOutcome with
              | mk initState initMode =>
                  cases initMode with
                  | regular =>
                      cases hLoop :
                          Source.Stmt.runForLoop prim program initCtx cond
                            initCtx.withoutLoopControl post
                            (initCtx.withLoopControl initCtx.scope
                              initCtx.scope)
                            body fuel initState with
                      | error err =>
                          simp [Source.Stmt.run, hInit, hLoop] at hRun
                      | ok loopOutcome =>
                          cases loopOutcome with
                          | mk loopState loopMode =>
                              cases loopMode with
                              | regular =>
                                  simp [Source.Stmt.run, hInit, hLoop,
                                    Scope.Stmt.outEnv] at hRun ⊢
                                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                  subst ctxOut
                                  rfl
                              | brk =>
                                  simp [Source.Stmt.run, hInit, hLoop,
                                    Source.invalid, Structured.invalid]
                                    at hRun
                              | cont =>
                                  simp [Source.Stmt.run, hInit, hLoop,
                                    Source.invalid, Structured.invalid]
                                    at hRun
                              | leave =>
                                  simp [Source.Stmt.run, hInit, hLoop]
                                    at hRun
                                  cases hRun.1
                              | halt kind =>
                                  simp [Source.Stmt.run, hInit, hLoop]
                                    at hRun
                                  cases hRun.1
                  | brk =>
                      simp [Source.Stmt.run, hInit, Source.invalid,
                        Structured.invalid] at hRun
                  | cont =>
                      simp [Source.Stmt.run, hInit, Source.invalid,
                        Structured.invalid] at hRun
                  | leave =>
                      simp [Source.Stmt.run, hInit] at hRun
                      cases hRun.1
                  | halt kind =>
                      simp [Source.Stmt.run, hInit] at hRun
                      cases hRun.1
  | brk =>
      cases hBreak : ctx.breakScope? with
      | none =>
          simp [Source.Stmt.run, hBreak, Source.invalid,
            Structured.invalid] at hRun
      | some scope =>
          simp [Source.Stmt.run, hBreak] at hRun
          cases hRun.1
  | cont =>
      cases hContinue : ctx.continueScope? with
      | none =>
          simp [Source.Stmt.run, hContinue, Source.invalid,
            Structured.invalid] at hRun
      | some scope =>
          simp [Source.Stmt.run, hContinue] at hRun
          cases hRun.1
  | leave =>
      cases hLeave : ctx.leaveScope? with
      | none =>
          simp [Source.Stmt.run, hLeave, Source.invalid,
            Structured.invalid] at hRun
      | some scope =>
          simp [Source.Stmt.run, hLeave] at hRun
          cases hRun.1
  | call targets functionName args =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          by_cases hTargets : targets.Nodup
          · cases hArgs : Source.ArgList.eval prim args state with
            | error err =>
                simp [Source.Stmt.run, hTargets, hArgs] at hRun
            | ok argResult =>
                rcases argResult with ⟨stateAfterArgs, argValues⟩
                cases hFind :
                    FunList.find? functionName program.functions with
                | none =>
                    simp [Source.Stmt.run, hTargets, hArgs, hFind,
                      Source.invalid, Structured.invalid] at hRun
                | some fn =>
                    cases hBody :
                        Source.FunDef.runBody prim program fn argValues fuel
                          stateAfterArgs.shared with
                    | error err =>
                        simp [Source.Stmt.run, hTargets, hArgs, hFind,
                          hBody] at hRun
                    | ok callResult =>
                        cases callResult with
                        | returned sharedAfterCall returnValues =>
                            cases hAssign :
                                Source.Store.assignMany targets returnValues
                                  stateAfterArgs.vars with
                            | none =>
                                simp [Source.Stmt.run, hTargets, hArgs,
                                  hFind, hBody, hAssign, Source.invalid,
                                  Structured.invalid] at hRun
                            | some returnStore =>
                                simp [Source.Stmt.run, hTargets, hArgs,
                                  hFind, hBody, hAssign, Scope.Stmt.outEnv]
                                  at hRun ⊢
                                rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                subst ctxOut
                                rfl
                        | halted kind haltedState =>
                            simp [Source.Stmt.run, hTargets, hArgs, hFind,
                              hBody] at hRun
                            cases hRun.1
          · simp [Source.Stmt.run, hTargets, Source.invalid,
              Structured.invalid] at hRun
  | terminal kind =>
      cases hTerminal : prim.terminal kind state.shared [] with
      | error err =>
          simp [Source.Stmt.run, hTerminal] at hRun
      | ok shared =>
          simp [Source.Stmt.run, hTerminal] at hRun
          cases hRun.1
  | terminalArgs kind args =>
      cases hEval :
          Locals.Source.Expr.ExprSeq.eval prim args state with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok evalResult =>
          rcases evalResult with ⟨stateAfterArgs, values⟩
          cases hTerminal :
              prim.terminal kind stateAfterArgs.shared values with
          | error err =>
              simp [Source.Stmt.run, hEval, hTerminal] at hRun
          | ok shared =>
              simp [Source.Stmt.run, hEval, hTerminal] at hRun
              cases hRun.1

theorem for_stmt_not_break_continue {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx : Source.Ctx} {fuel : Nat}
    {init post body : Block} {cond : Expr 1} {state : Source.State}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hRun :
      Source.Stmt.run prim program ctx fuel (.for_ init cond post body) state =
        .ok sourceResult) :
    sourceResult.1.mode ≠ .brk ∧ sourceResult.1.mode ≠ .cont := by
  constructor
  · intro hMode
    rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
    cases sourceOutcome with
    | mk sourceState sourceMode =>
        cases sourceMode <;> simp at hMode
        case brk =>
          cases fuel with
          | zero =>
              simp [Source.Stmt.run, Source.invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              cases hInit :
                  Source.Block.runOpen prim program ctx.withoutLoopControl fuel
                    init state with
              | error err =>
                  simp [Source.Stmt.run, hInit] at hRun
              | ok initResult =>
                  rcases initResult with ⟨initOutcome, initCtx⟩
                  cases initOutcome with
                  | mk initState initMode =>
                      cases initMode with
                      | regular =>
                          cases hLoop :
                              Source.Stmt.runForLoop prim program initCtx cond
                                initCtx.withoutLoopControl post
                                (initCtx.withLoopControl initCtx.scope
                                  initCtx.scope)
                                body fuel initState with
                          | error err =>
                              simp [Source.Stmt.run, hInit, hLoop] at hRun
                          | ok loopOutcome =>
                              cases loopOutcome with
                              | mk loopState loopMode =>
                                  cases loopMode <;>
                                    simp [Source.Stmt.run, hInit, hLoop,
                                      Source.invalid, Structured.invalid,
                                      Source.Outcome.regular,
                                      Locals.Source.Outcome.regular,
                                      Source.Outcome.leave,
                                      Locals.Source.Outcome.leave,
                                      Source.Outcome.halt,
                                      Locals.Source.Outcome.halt] at hRun
                      | brk =>
                          simp [Source.Stmt.run, hInit, Source.invalid,
                            Structured.invalid] at hRun
                      | cont =>
                          simp [Source.Stmt.run, hInit, Source.invalid,
                            Structured.invalid] at hRun
                      | leave =>
                          simp [Source.Stmt.run, hInit] at hRun
                      | halt kind =>
                          simp [Source.Stmt.run, hInit] at hRun
  · intro hMode
    rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
    cases sourceOutcome with
    | mk sourceState sourceMode =>
        cases sourceMode <;> simp at hMode
        case cont =>
          cases fuel with
          | zero =>
              simp [Source.Stmt.run, Source.invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              cases hInit :
                  Source.Block.runOpen prim program ctx.withoutLoopControl fuel
                    init state with
              | error err =>
                  simp [Source.Stmt.run, hInit] at hRun
              | ok initResult =>
                  rcases initResult with ⟨initOutcome, initCtx⟩
                  cases initOutcome with
                  | mk initState initMode =>
                      cases initMode with
                      | regular =>
                          cases hLoop :
                              Source.Stmt.runForLoop prim program initCtx cond
                                initCtx.withoutLoopControl post
                                (initCtx.withLoopControl initCtx.scope
                                  initCtx.scope)
                                body fuel initState with
                          | error err =>
                              simp [Source.Stmt.run, hInit, hLoop] at hRun
                          | ok loopOutcome =>
                              cases loopOutcome with
                              | mk loopState loopMode =>
                                  cases loopMode <;>
                                    simp [Source.Stmt.run, hInit, hLoop,
                                      Source.invalid, Structured.invalid,
                                      Source.Outcome.regular,
                                      Locals.Source.Outcome.regular,
                                      Source.Outcome.leave,
                                      Locals.Source.Outcome.leave,
                                      Source.Outcome.halt,
                                      Locals.Source.Outcome.halt] at hRun
                      | brk =>
                          simp [Source.Stmt.run, hInit, Source.invalid,
                            Structured.invalid] at hRun
                      | cont =>
                          simp [Source.Stmt.run, hInit, Source.invalid,
                            Structured.invalid] at hRun
                      | leave =>
                          simp [Source.Stmt.run, hInit] at hRun
                      | halt kind =>
                          simp [Source.Stmt.run, hInit] at hRun

theorem call_stmt_not_break_continue {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx : Source.Ctx} {fuel : Nat}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {state : Source.State} {sourceResult : Source.Outcome × Source.Ctx}
    (hRun :
      Source.Stmt.run prim program ctx fuel (.call targets functionName args)
          state =
        .ok sourceResult) :
    sourceResult.1.mode ≠ .brk ∧ sourceResult.1.mode ≠ .cont := by
  constructor
  · intro hMode
    rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
    cases sourceOutcome with
    | mk sourceState sourceMode =>
        cases sourceMode <;> simp at hMode
        case brk =>
          cases fuel with
          | zero =>
              simp [Source.Stmt.run, Source.invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              by_cases hTargets : targets.Nodup
              · cases hArgs : Source.ArgList.eval prim args state with
                | error err =>
                    simp [Source.Stmt.run, hTargets, hArgs] at hRun
                | ok argResult =>
                    rcases argResult with ⟨stateAfterArgs, argValues⟩
                    cases hFind :
                        Source.FunList.find? functionName program.functions with
                    | none =>
                        have hFindDirect :
                            EvmCompiler.Functions.FunList.find? functionName
                                program.functions =
                              none := by
                          simpa [SourceDirect.FunList.source_find?_eq
                            functionName program.functions] using hFind
                        simp [Source.Stmt.run, hTargets, hArgs, hFindDirect,
                          Source.invalid, Structured.invalid] at hRun
                    | some fn =>
                        have hFindDirect :
                            EvmCompiler.Functions.FunList.find? functionName
                                program.functions =
                              some fn := by
                          simpa [SourceDirect.FunList.source_find?_eq
                            functionName program.functions] using hFind
                        cases hBody :
                            Source.FunDef.runBody prim program fn argValues fuel
                              stateAfterArgs.shared with
                        | error err =>
                            simp [Source.Stmt.run, hTargets, hArgs,
                              hFindDirect, hBody] at hRun
                        | ok callResult =>
                            cases callResult with
                            | returned sharedAfterCall returnValues =>
                                cases hAssign :
                                    Source.Store.assignMany targets returnValues
                                      stateAfterArgs.vars with
                                | none =>
                                    simp [Source.Stmt.run, hTargets, hArgs,
                                      hFindDirect, hBody, hAssign,
                                      Source.invalid, Structured.invalid]
                                      at hRun
                                | some returnStore =>
                                    simp [Source.Stmt.run, hTargets, hArgs,
                                      hFindDirect, hBody, hAssign,
                                      Source.Outcome.regular,
                                      Locals.Source.Outcome.regular] at hRun
                            | halted kind haltedState =>
                                simp [Source.Stmt.run, hTargets, hArgs,
                                  hFindDirect, hBody, Source.Outcome.halt,
                                  Locals.Source.Outcome.halt] at hRun
              · simp [Source.Stmt.run, hTargets, Source.invalid,
                  Structured.invalid] at hRun
  · intro hMode
    rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
    cases sourceOutcome with
    | mk sourceState sourceMode =>
        cases sourceMode <;> simp at hMode
        case cont =>
          cases fuel with
          | zero =>
              simp [Source.Stmt.run, Source.invalid, Structured.invalid]
                at hRun
          | succ fuel =>
              by_cases hTargets : targets.Nodup
              · cases hArgs : Source.ArgList.eval prim args state with
                | error err =>
                    simp [Source.Stmt.run, hTargets, hArgs] at hRun
                | ok argResult =>
                    rcases argResult with ⟨stateAfterArgs, argValues⟩
                    cases hFind :
                        Source.FunList.find? functionName program.functions with
                    | none =>
                        have hFindDirect :
                            EvmCompiler.Functions.FunList.find? functionName
                                program.functions =
                              none := by
                          simpa [SourceDirect.FunList.source_find?_eq
                            functionName program.functions] using hFind
                        simp [Source.Stmt.run, hTargets, hArgs, hFindDirect,
                          Source.invalid, Structured.invalid] at hRun
                    | some fn =>
                        have hFindDirect :
                            EvmCompiler.Functions.FunList.find? functionName
                                program.functions =
                              some fn := by
                          simpa [SourceDirect.FunList.source_find?_eq
                            functionName program.functions] using hFind
                        cases hBody :
                            Source.FunDef.runBody prim program fn argValues fuel
                              stateAfterArgs.shared with
                        | error err =>
                            simp [Source.Stmt.run, hTargets, hArgs,
                              hFindDirect, hBody] at hRun
                        | ok callResult =>
                            cases callResult with
                            | returned sharedAfterCall returnValues =>
                                cases hAssign :
                                    Source.Store.assignMany targets returnValues
                                      stateAfterArgs.vars with
                                | none =>
                                    simp [Source.Stmt.run, hTargets, hArgs,
                                      hFindDirect, hBody, hAssign,
                                      Source.invalid, Structured.invalid]
                                      at hRun
                                | some returnStore =>
                                    simp [Source.Stmt.run, hTargets, hArgs,
                                      hFindDirect, hBody, hAssign,
                                      Source.Outcome.regular,
                                      Locals.Source.Outcome.regular] at hRun
                            | halted kind haltedState =>
                                simp [Source.Stmt.run, hTargets, hArgs,
                                  hFindDirect, hBody, Source.Outcome.halt,
                                  Locals.Source.Outcome.halt] at hRun
              · simp [Source.Stmt.run, hTargets, Source.invalid,
                  Structured.invalid] at hRun

theorem stmt_regular_leaveScope {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {state sourceInner : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt state =
        .ok (Source.Outcome.regular sourceInner, ctxOut)) :
    ctxOut.leaveScope? = ctx.leaveScope? := by
  cases stmt with
  | expr expr =>
      cases hEval : Source.Expr.eval prim expr state with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          subst ctxOut
          rfl
  | let_ name value =>
      cases hEval : Source.Expr.evalOne prim value state with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          subst ctxOut
          rfl
  | assign name value =>
      cases hContains : state.vars.contains name with
      | false =>
          simp [Source.Stmt.run, hContains, Source.invalid,
            Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value state with
          | error err =>
              simp [Source.Stmt.run, hContains, hEval] at hRun
          | ok result =>
              simp [Source.Stmt.run, hContains, hEval] at hRun
              rcases hRun with ⟨_hOutcome, hCtxEq⟩
              subst ctxOut
              rfl
  | block body =>
      cases hBlock : Source.Block.runScoped prim program ctx body fuel state with
      | error err =>
          simp [Source.Stmt.run, hBlock] at hRun
      | ok outcome =>
          cases outcome with
          | mk outcomeState outcomeMode =>
              cases outcomeMode with
              | regular =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  subst ctxOut
                  rfl
              | brk =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
              | cont =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
              | leave =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
              | halt kind =>
                  simp [Source.Stmt.run, hBlock] at hRun
                  cases hRun.1
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Source.Expr.evalCondition prim cond state with
          | error err =>
              simp [Source.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨stateAfterCond, condTrue⟩
              cases condTrue with
              | false =>
                  simp [Source.Stmt.run, hCond] at hRun
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  subst ctxOut
                  rfl
              | true =>
                  cases hBlock :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterCond with
                  | error err =>
                      simp [Source.Stmt.run, hCond, hBlock] at hRun
                  | ok outcome =>
                      cases outcome with
                      | mk outcomeState outcomeMode =>
                          cases outcomeMode with
                          | regular =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              rcases hRun with ⟨_hOutcome, hCtxEq⟩
                              subst ctxOut
                              rfl
                          | brk =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
                          | cont =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
                          | leave =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
                          | halt kind =>
                              simp [Source.Stmt.run, hCond, hBlock] at hRun
                              cases hRun.1
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hEval : Source.Expr.evalOne prim scrutinee state with
          | error err =>
              simp [Source.Stmt.run, hEval] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterScrutinee, value⟩
              cases hSelect :
                  Source.Switch.select value cases defaultBody with
              | none =>
                  simp [Source.Stmt.run, hEval, hSelect] at hRun
                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                  subst ctxOut
                  rfl
              | some body =>
                  cases hBlock :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterScrutinee with
                  | error err =>
                      simp [Source.Stmt.run, hEval, hSelect, hBlock] at hRun
                  | ok outcome =>
                      cases outcome with
                      | mk outcomeState outcomeMode =>
                          cases outcomeMode with
                          | regular =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              rcases hRun with ⟨_hOutcome, hCtxEq⟩
                              subst ctxOut
                              rfl
                          | brk =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
                          | cont =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
                          | leave =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
                          | halt kind =>
                              simp [Source.Stmt.run, hEval, hSelect, hBlock]
                                at hRun
                              cases hRun.1
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hInit :
              Source.Block.runOpen prim program ctx.withoutLoopControl fuel
                init state with
          | error err =>
              simp [Source.Stmt.run, hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases initOutcome with
              | mk initState initMode =>
                  cases initMode with
                  | regular =>
                      cases hLoop :
                          Source.Stmt.runForLoop prim program initCtx cond
                            initCtx.withoutLoopControl post
                            (initCtx.withLoopControl initCtx.scope
                              initCtx.scope)
                            body fuel initState with
                      | error err =>
                          simp [Source.Stmt.run, hInit, hLoop] at hRun
                      | ok loopOutcome =>
                          cases loopOutcome with
                          | mk loopState loopMode =>
                              cases loopMode with
                              | regular =>
                                  simp [Source.Stmt.run, hInit, hLoop]
                                    at hRun
                                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                  subst ctxOut
                                  rfl
                              | brk =>
                                  simp [Source.Stmt.run, hInit, hLoop,
                                    Source.invalid, Structured.invalid]
                                    at hRun
                              | cont =>
                                  simp [Source.Stmt.run, hInit, hLoop,
                                    Source.invalid, Structured.invalid]
                                    at hRun
                              | leave =>
                                  simp [Source.Stmt.run, hInit, hLoop]
                                    at hRun
                                  cases hRun.1
                              | halt kind =>
                                  simp [Source.Stmt.run, hInit, hLoop]
                                    at hRun
                                  cases hRun.1
                  | brk =>
                      simp [Source.Stmt.run, hInit, Source.invalid,
                        Structured.invalid] at hRun
                  | cont =>
                      simp [Source.Stmt.run, hInit, Source.invalid,
                        Structured.invalid] at hRun
                  | leave =>
                      simp [Source.Stmt.run, hInit] at hRun
                      cases hRun.1
                  | halt kind =>
                      simp [Source.Stmt.run, hInit] at hRun
                      cases hRun.1
  | brk =>
      cases hBreak : ctx.breakScope? with
      | none =>
          simp [Source.Stmt.run, hBreak, Source.invalid,
            Structured.invalid] at hRun
      | some scope =>
          simp [Source.Stmt.run, hBreak] at hRun
          cases hRun.1
  | cont =>
      cases hContinue : ctx.continueScope? with
      | none =>
          simp [Source.Stmt.run, hContinue, Source.invalid,
            Structured.invalid] at hRun
      | some scope =>
          simp [Source.Stmt.run, hContinue] at hRun
          cases hRun.1
  | leave =>
      cases hLeave : ctx.leaveScope? with
      | none =>
          simp [Source.Stmt.run, hLeave, Source.invalid,
            Structured.invalid] at hRun
