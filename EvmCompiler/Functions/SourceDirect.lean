            sourceState targetState) :
    LoopBlockOpenRunBridgeWithLayout prim program returns loopLayout retc
      (fuel + 1) sourceCtx targetCtx hiddenReturns { stmts := stmt :: rest }
      source target := by
  rcases source_runOpen_cons_head (prim := prim) (program := program)
      (fuel := fuel) (sourceCtx := sourceCtx) (source := source)
      (stmt := stmt) (rest := rest) hSourceRun with
    ⟨sourceHead, sourceCtxAfter, hSourceHead, hSourceTailOfRegular,
