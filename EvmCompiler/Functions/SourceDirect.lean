theorem block_runOpen_not_break_continue_of_no_loop_control
    {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {block : Block} {state : Source.State} {outcome : Source.Outcome}
    (hRun :
      Source.Block.runOpen prim program ctx fuel block state =
        .ok (outcome, ctxOut))
    (hBreak : ctx.breakScope? = none)
    (hContinue : ctx.continueScope? = none) :
    outcome.mode ≠ .brk ∧ outcome.mode ≠ .cont := by
  induction fuel using Nat.strong_induction_on generalizing ctx state block
      ctxOut outcome with
  | h fuel ih =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid]
            at hRun
      | succ fuel =>
          cases block with
          | mk stmts =>
              have hScopedNoBreakContinue :
                  ∀ {fuel' : Nat} {ctx' : Source.Ctx}
                    {block' : Block} {state' : Source.State}
                    {outcome' : Source.Outcome},
                    fuel' < fuel + 1 →
                    Source.Block.runScoped prim program ctx' block' fuel'
                        state' =
                      .ok outcome' →
                    ctx'.breakScope? = none →
                    ctx'.continueScope? = none →
                    outcome'.mode ≠ .brk ∧
                      outcome'.mode ≠ .cont := by
                intro fuel' ctx' block' state' outcome' hLt hScoped
                  hBreak' hContinue'
                unfold Source.Block.runScoped at hScoped
                cases hOpen :
                    Source.Block.runOpen prim program ctx' fuel' block'
                      state' with
                | error err =>
                    simp [hOpen] at hScoped
                | ok result =>
                    rcases result with ⟨openOutcome, ctxOpen⟩
                    have hOpenNoBC :=
                      ih fuel' hLt hOpen hBreak' hContinue'
                    cases openOutcome with
                    | mk openState openMode =>
                        cases openMode with
                        | regular =>
                            simp [hOpen, Source.Outcome.regular,
                              Locals.Source.Outcome.regular] at hScoped
                            cases hScoped
                            constructor <;>
                              simp [Source.Outcome.regular,
                                Locals.Source.Outcome.regular]
                        | brk =>
                            exact False.elim (hOpenNoBC.1 rfl)
                        | cont =>
                            exact False.elim (hOpenNoBC.2 rfl)
                        | leave =>
                            simp [hOpen, Source.Outcome.leave,
                              Locals.Source.Outcome.leave] at hScoped
                            cases hScoped
                            constructor <;>
                              simp [Source.Outcome.leave,
                                Locals.Source.Outcome.leave]
                        | halt kind =>
                            simp [hOpen, Source.Outcome.halt,
                              Locals.Source.Outcome.halt] at hScoped
                            cases hScoped
                            constructor <;>
                              simp [Source.Outcome.halt,
                                Locals.Source.Outcome.halt]
              cases stmts with
              | nil =>
                  simp [Source.Block.runOpen] at hRun
                  rcases hRun with ⟨hOutcome, _hCtx⟩
                  cases hOutcome
                  constructor <;>
                    simp [Source.Outcome.regular,
                      Locals.Source.Outcome.regular]
              | cons stmt rest =>
                  cases hHead :
                      Source.Stmt.run prim program ctx fuel stmt state with
                  | error err =>
                      simp [Source.Block.runOpen, hHead] at hRun
                  | ok headResult =>
                      rcases headResult with ⟨headOutcome, ctxMid⟩
                      have hHeadNoBC :
                          headOutcome.mode ≠ .brk ∧
                            headOutcome.mode ≠ .cont := by
                        cases stmt with
                        | expr expr =>
                            cases hEval :
                                Source.Expr.eval prim expr state with
                            | error err =>
                                simp [Source.Stmt.run, hEval] at hHead
                            | ok result =>
                                simp [Source.Stmt.run, hEval] at hHead
                                rcases hHead with ⟨hOutcome, _hCtx⟩
                                cases hOutcome
                                constructor <;>
                                  simp [Source.Outcome.regular,
                                    Locals.Source.Outcome.regular]
                        | let_ name value =>
                            cases hEval :
                                Source.Expr.evalOne prim value state with
                            | error err =>
                                simp [Source.Stmt.run, hEval] at hHead
                            | ok result =>
                                simp [Source.Stmt.run, hEval] at hHead
                                rcases hHead with ⟨hOutcome, _hCtx⟩
                                cases hOutcome
                                constructor <;>
                                  simp [Source.Outcome.regular,
                                    Locals.Source.Outcome.regular]
                        | assign name value =>
                            cases hContains : state.vars.contains name with
                            | false =>
                                simp [Source.Stmt.run, hContains,
                                  Source.invalid, Structured.invalid]
                                  at hHead
                            | true =>
                                cases hEval :
                                    Source.Expr.evalOne prim value state with
                                | error err =>
                                    simp [Source.Stmt.run, hContains,
                                      hEval] at hHead
                                | ok result =>
                                    simp [Source.Stmt.run, hContains,
                                      hEval] at hHead
                                    rcases hHead with ⟨hOutcome, _hCtx⟩
                                    cases hOutcome
                                    constructor <;>
                                      simp [Source.Outcome.regular,
                                        Locals.Source.Outcome.regular]
                        | block body =>
                            cases hScoped :
                                Source.Block.runScoped prim program ctx body
                                  fuel state with
                            | error err =>
                                simp [Source.Stmt.run, hScoped] at hHead
                            | ok scopedOutcome =>
                                have hScopedNoBC :=
                                  hScopedNoBreakContinue
                                    (fuel' := fuel) (ctx' := ctx)
                                    (block' := body) (state' := state)
                                    (outcome' := scopedOutcome)
                                    (by omega) hScoped hBreak hContinue
                                simp [Source.Stmt.run, hScoped] at hHead
                                rcases hHead with ⟨hOutcome, _hCtx⟩
                                cases hOutcome
                                exact hScopedNoBC
                        | if_ cond body =>
                            cases fuel with
                            | zero =>
                                simp [Source.Stmt.run, Source.invalid,
                                  Structured.invalid] at hHead
                            | succ fuel' =>
                                cases hCond :
                                    Source.Expr.evalCondition prim cond
                                      state with
                                | error err =>
                                    simp [Source.Stmt.run, hCond] at hHead
                                | ok condResult =>
                                    rcases condResult with
                                      ⟨stateAfterCond, condTrue⟩
                                    cases condTrue with
                                    | false =>
                                        simp [Source.Stmt.run, hCond] at hHead
                                        rcases hHead with
                                          ⟨hOutcome, _hCtx⟩
                                        cases hOutcome
                                        constructor <;>
                                          simp [Source.Outcome.regular,
                                            Locals.Source.Outcome.regular]
                                    | true =>
                                        cases hScoped :
                                            Source.Block.runScoped prim
                                              program ctx body fuel'
                                              stateAfterCond with
                                        | error err =>
                                            simp [Source.Stmt.run, hCond,
                                              hScoped] at hHead
                                        | ok scopedOutcome =>
                                            have hScopedNoBC :=
                                              hScopedNoBreakContinue
                                                (fuel' := fuel')
                                                (ctx' := ctx) (block' := body)
                                                (state' := stateAfterCond)
                                                (outcome' := scopedOutcome)
                                                (by omega) hScoped hBreak
                                                hContinue
                                            simp [Source.Stmt.run, hCond,
                                              hScoped] at hHead
                                            rcases hHead with
                                              ⟨hOutcome, _hCtx⟩
                                            cases hOutcome
                                            exact hScopedNoBC
                        | switch scrutinee cases defaultBody =>
                            cases fuel with
                            | zero =>
                                simp [Source.Stmt.run, Source.invalid,
                                  Structured.invalid] at hHead
                            | succ fuel' =>
                                cases hEval :
                                    Source.Expr.evalOne prim scrutinee state
                                with
                                | error err =>
                                    simp [Source.Stmt.run, hEval] at hHead
                                | ok evalResult =>
                                    rcases evalResult with
                                      ⟨stateAfterScrutinee, value⟩
                                    cases hSelect :
                                        Source.Switch.select value cases
                                          defaultBody with
                                    | none =>
                                        simp [Source.Stmt.run, hEval,
                                          hSelect] at hHead
                                        rcases hHead with
                                          ⟨hOutcome, _hCtx⟩
                                        cases hOutcome
                                        constructor <;>
                                          simp [Source.Outcome.regular,
                                            Locals.Source.Outcome.regular]
                                    | some body =>
                                        cases hScoped :
                                            Source.Block.runScoped prim
                                              program ctx body fuel'
                                              stateAfterScrutinee with
                                        | error err =>
                                            simp [Source.Stmt.run, hEval,
                                              hSelect, hScoped] at hHead
                                        | ok scopedOutcome =>
                                            have hScopedNoBC :=
                                              hScopedNoBreakContinue
                                                (fuel' := fuel')
                                                (ctx' := ctx) (block' := body)
                                                (state' :=
                                                  stateAfterScrutinee)
                                                (outcome' := scopedOutcome)
                                                (by omega) hScoped hBreak
                                                hContinue
                                            simp [Source.Stmt.run, hEval,
                                              hSelect, hScoped] at hHead
                                            rcases hHead with
                                              ⟨hOutcome, _hCtx⟩
                                            cases hOutcome
                                            exact hScopedNoBC
                        | for_ init cond post body =>
                            exact SourceRun.for_stmt_not_break_continue hHead
                        | brk =>
                            simp [Source.Stmt.run, hBreak, Source.invalid,
                              Structured.invalid] at hHead
                        | cont =>
                            simp [Source.Stmt.run, hContinue, Source.invalid,
                              Structured.invalid] at hHead
                        | leave =>
                            cases hLeave : ctx.leaveScope? with
                            | none =>
                                simp [Source.Stmt.run, hLeave,
                                  Source.invalid, Structured.invalid]
                                  at hHead
                            | some leaveScope =>
                                simp [Source.Stmt.run, hLeave] at hHead
                                rcases hHead with ⟨hOutcome, _hCtx⟩
                                cases hOutcome
                                constructor <;>
                                  simp [Source.Outcome.leave,
                                    Locals.Source.Outcome.leave]
                        | call targets functionName args =>
                            exact SourceRun.call_stmt_not_break_continue
                              hHead
                        | terminal kind =>
                            cases hTerminal :
                                prim.terminal kind state.shared [] with
                            | error err =>
                                simp [Source.Stmt.run, hTerminal] at hHead
                            | ok shared =>
                                simp [Source.Stmt.run, hTerminal] at hHead
                                rcases hHead with ⟨hOutcome, _hCtx⟩
                                cases hOutcome
                                constructor <;>
                                  simp [Source.Outcome.halt,
                                    Locals.Source.Outcome.halt]
                        | terminalArgs kind args =>
                            cases hEval :
                                Locals.Source.Expr.ExprSeq.eval prim args
                                  state with
                            | error err =>
                                simp [Source.Stmt.run, hEval] at hHead
                            | ok evalResult =>
                                rcases evalResult with
                                  ⟨stateAfterArgs, values⟩
                                cases hTerminal :
                                    prim.terminal kind stateAfterArgs.shared
                                      values with
                                | error err =>
                                    simp [Source.Stmt.run, hEval, hTerminal]
                                      at hHead
                                | ok shared =>
                                    simp [Source.Stmt.run, hEval, hTerminal]
                                      at hHead
                                    rcases hHead with ⟨hOutcome, _hCtx⟩
                                    cases hOutcome
                                    constructor <;>
                                      simp [Source.Outcome.halt,
                                        Locals.Source.Outcome.halt]
                      cases headOutcome with
                      | mk headState headMode =>
                          cases headMode with
                          | regular =>
                              have hTail :
                                  Source.Block.runOpen prim program ctxMid
                                      fuel { stmts := rest } headState =
                                    .ok (outcome, ctxOut) := by
                                simpa [Source.Block.runOpen, hHead]
                                  using hRun
                              have hBreakMid :
                                  ctxMid.breakScope? = none := by
                                rw [stmt_regular_breakScope hHead]
                                exact hBreak
                              have hContinueMid :
                                  ctxMid.continueScope? = none := by
                                rw [stmt_regular_continueScope hHead]
                                exact hContinue
                              exact ih fuel (by omega) hTail hBreakMid
                                hContinueMid
                          | brk =>
                              exact False.elim (hHeadNoBC.1 rfl)
                          | cont =>
                              exact False.elim (hHeadNoBC.2 rfl)
                          | leave =>
                              simp [Source.Block.runOpen, hHead] at hRun
                              rcases hRun with ⟨hOutcome, _hCtx⟩
                              subst outcome
                              constructor <;>
                                simp [Source.Outcome.leave,
                                  Locals.Source.Outcome.leave]
                          | halt kind =>
                              simp [Source.Block.runOpen, hHead] at hRun
                              rcases hRun with ⟨hOutcome, _hCtx⟩
                              subst outcome
                              constructor <;>
                                simp [Source.Outcome.halt,
                                  Locals.Source.Outcome.halt]

theorem block_runScoped_not_break_continue_of_no_loop_control
    {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx : Source.Ctx} {fuel : Nat}
    {block : Block} {state : Source.State} {outcome : Source.Outcome}
    (hRun :
      Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome)
    (hBreak : ctx.breakScope? = none)
    (hContinue : ctx.continueScope? = none) :
    outcome.mode ≠ .brk ∧ outcome.mode ≠ .cont := by
  unfold Source.Block.runScoped at hRun
  cases hOpen :
      Source.Block.runOpen prim program ctx fuel block state with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨openOutcome, ctxOut⟩
      have hOpenNoBC :
          openOutcome.mode ≠ .brk ∧ openOutcome.mode ≠ .cont :=
        block_runOpen_not_break_continue_of_no_loop_control hOpen hBreak
          hContinue
      cases openOutcome with
      | mk openState openMode =>
          cases openMode with
          | regular =>
              simp [hOpen, Source.Outcome.regular,
                Locals.Source.Outcome.regular] at hRun
              cases hRun
              constructor <;>
                simp [Source.Outcome.regular,
                  Locals.Source.Outcome.regular]
          | brk =>
              exact False.elim (hOpenNoBC.1 rfl)
          | cont =>
              exact False.elim (hOpenNoBC.2 rfl)
          | leave =>
              simp [hOpen, Source.Outcome.leave,
                Locals.Source.Outcome.leave] at hRun
              cases hRun
              constructor <;>
                simp [Source.Outcome.leave,
                  Locals.Source.Outcome.leave]
          | halt kind =>
              simp [hOpen, Source.Outcome.halt,
                Locals.Source.Outcome.halt] at hRun
              cases hRun
              constructor <;>
                simp [Source.Outcome.halt,
                  Locals.Source.Outcome.halt]

theorem block_runScoped_open_exists {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx : Source.Ctx} {fuel : Nat}
    {block : Block} {state : Source.State} {outcome : Source.Outcome}
    (hRun :
      Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome) :
    ∃ openOutcome ctxOut,
      Source.Block.runOpen prim program ctx fuel block state =
        .ok (openOutcome, ctxOut) := by
  unfold Source.Block.runScoped at hRun
  cases hOpen : Source.Block.runOpen prim program ctx fuel block state with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨openOutcome, ctxOut⟩
      exact ⟨openOutcome, ctxOut, rfl⟩

end SourceRun

/--
The direct backend may choose any stack-layout order for a source scope, as long
as it contains the same names and has the same length.  Order is a lowering
choice, not a source-language observation.
-/
def SameScope (layout scope : List Name) : Prop :=
  layout.length = scope.length ∧ ∀ name, name ∈ layout ↔ name ∈ scope

namespace SameScope

theorem refl (scope : List Name) :
    SameScope scope scope := by
  simp [SameScope]

theorem cons {layout scope : List Name} {name : Name}
    (hRel : SameScope layout scope) :
    SameScope (name :: layout) (name :: scope) := by
  rcases hRel with ⟨hLength, hMem⟩
  constructor
  · simp [hLength]
  · intro key
    simp [hMem key]

theorem symm {layout scope : List Name}
    (hRel : SameScope layout scope) :
    SameScope scope layout := by
  rcases hRel with ⟨hLength, hMem⟩
  exact ⟨hLength.symm, fun name => (hMem name).symm⟩

theorem nodup_left {layout scope : List Name}
    (hRel : SameScope layout scope)
    (hScope : scope.Nodup) :
    layout.Nodup := by
  classical
  rcases hRel with ⟨hLength, hMem⟩
  have hPerm : layout.dedup.Perm scope := by
    rw [List.perm_iff_count]
    intro name
    by_cases hLayoutMem : name ∈ layout
    · have hScopeMem : name ∈ scope := (hMem name).mp hLayoutMem
      simp [List.count_eq_one_of_mem (List.nodup_dedup layout)
          (by simpa using hLayoutMem),
        List.count_eq_one_of_mem hScope hScopeMem]
    · have hScopeNotMem : name ∉ scope := by
        intro hScopeMem
        exact hLayoutMem ((hMem name).mpr hScopeMem)
      have hDedupNotMem : name ∉ layout.dedup := by
        simpa using hLayoutMem
      simp [List.count_eq_zero_of_not_mem hDedupNotMem,
        List.count_eq_zero_of_not_mem hScopeNotMem]
  have hDedupLength : layout.dedup.length = layout.length := by
    calc
      layout.dedup.length = scope.length := hPerm.length_eq
      _ = layout.length := hLength.symm
  have hDedupEq : layout.dedup = layout :=
    (List.dedup_sublist layout).eq_of_length hDedupLength
  exact List.dedup_eq_self.mp hDedupEq

theorem nodup_right {layout scope : List Name}
    (hRel : SameScope layout scope)
    (hLayout : layout.Nodup) :
    scope.Nodup :=
  nodup_left hRel.symm hLayout

theorem reverse_append (left right : List Name) :
    SameScope (left.reverse ++ right.reverse) (left ++ right) := by
  constructor
  · simp
  · intro key
    by_cases hLeft : key ∈ left <;>
      by_cases hRight : key ∈ right <;>
      simp [hLeft, hRight]

end SameScope

/--
The part of a concrete layout retained by cleanup to `scope.length` has the same
source names as the abstract handler scope.  This is the local typed-continuation
facade for `break`/`continue`: the source handler names stay abstract, while the
lowering proof knows which target stack suffix implements them.
-/
def CleanupScopeRel (layout scope : List Name) : Prop :=
  SameScope (layout.drop (layout.length - scope.length)) scope

namespace CleanupScopeRel

theorem of_sameScope {layout scope : List Name}
    (hRel : SameScope layout scope) :
    CleanupScopeRel layout scope := by
  rcases hRel with ⟨hLength, hMem⟩
  simpa [CleanupScopeRel, hLength, SameScope] using
    (show layout.length = scope.length ∧
        (∀ name, name ∈ layout ↔ name ∈ scope) from ⟨hLength, hMem⟩)

theorem cons {layout scope : List Name} {name : Name}
    (hRel : CleanupScopeRel layout scope) :
    CleanupScopeRel (name :: layout) scope := by
  rcases hRel with ⟨hLength, hMem⟩
  have hLe : scope.length ≤ layout.length := by
    simp [List.length_drop] at hLength
    omega
  have hDrop :
      (name :: layout).drop ((name :: layout).length - scope.length) =
        layout.drop (layout.length - scope.length) := by
    have hSub :
        (name :: layout).length - scope.length =
          (layout.length - scope.length) + 1 := by
      simp
      omega
    rw [hSub]
    simp
  constructor
  · rw [hDrop]
    exact hLength
  · intro key
    rw [hDrop]
    exact hMem key

end CleanupScopeRel

/--
Exact target-layout suffix retained by a scoped cleanup.

`CleanupScopeRel` is the source-facing version used for break/continue handler
scopes, where only the source names matter.  Scoped block fallthrough needs the
stronger target-side fact: after popping block-local stack slots, the concrete
layout is exactly the incoming target layout.
-/
def CleanupLayoutRel (layout outer : List Name) : Prop :=
  layout.drop (layout.length - outer.length) = outer

namespace CleanupLayoutRel

theorem refl (layout : List Name) :
    CleanupLayoutRel layout layout := by
  simp [CleanupLayoutRel]

theorem cons {layout outer : List Name} {name : Name}
    (hRel : CleanupLayoutRel layout outer) :
    CleanupLayoutRel (name :: layout) outer := by
  have hLen : outer.length ≤ layout.length := by
    have hLength := congrArg List.length hRel
    simp [CleanupLayoutRel] at hLength
    omega
  have hDrop :
      (name :: layout).drop ((name :: layout).length - outer.length) =
        layout.drop (layout.length - outer.length) := by
    have hSub :
        (name :: layout).length - outer.length =
          (layout.length - outer.length) + 1 := by
      simp
      omega
    rw [hSub]
    simp
  rw [CleanupLayoutRel, hDrop]
  exact hRel

theorem trans {layout mid outer : List Name}
    (hOuter : CleanupLayoutRel layout mid)
    (hInner : CleanupLayoutRel mid outer) :
    CleanupLayoutRel layout outer := by
  have hMidLen : mid.length ≤ layout.length := by
    have hLength := congrArg List.length hOuter
    simp [CleanupLayoutRel] at hLength
    omega
  have hOuterLen : outer.length ≤ mid.length := by
    have hLength := congrArg List.length hInner
    simp [CleanupLayoutRel] at hLength
    omega
  have hIndex :
      layout.length - outer.length =
        (layout.length - mid.length) + (mid.length - outer.length) := by
    omega
  rw [CleanupLayoutRel, hIndex]
  rw [← List.drop_drop]
  rw [hOuter]
  exact hInner

theorem to_cleanupScope {layout outer scope : List Name}
    (hRel : CleanupLayoutRel layout outer)
    (hScope : SameScope outer scope) :
    CleanupScopeRel layout scope := by
  rcases hScope with ⟨hLength, hMem⟩
  constructor
  · have hDrop :
        layout.drop (layout.length - scope.length) = outer := by
      simpa [CleanupLayoutRel, hLength] using hRel
    rw [hDrop]
    exact hLength
  · intro name
    have hDrop :
        layout.drop (layout.length - scope.length) = outer := by
      simpa [CleanupLayoutRel, hLength] using hRel
    rw [hDrop]
    exact hMem name

end CleanupLayoutRel

namespace StackStoreRel

theorem insertMany_reverse_prefix :
    ∀ {names : List Name} {wordValues : List Word}
      {store store' : Source.Store} {layout : List Name}
      {stack : EvmYul.Stack Word},
      Source.Store.insertMany names wordValues store = some store' →
        names.Nodup →
        (∀ name, name ∈ names → name ∉ layout) →
        Locals.SourceLowering.StackStoreRel layout store stack →
          Locals.SourceLowering.StackStoreRel
            (names.reverse ++ layout) store' (wordValues.reverse ++ stack)
  | [], [], store, store', layout, stack, hInsert, _hNoDup, _hFresh, hRel => by
      simp [Source.Store.insertMany] at hInsert
      cases hInsert
      simpa using hRel
  | [], _value :: _values, _store, _store', _layout, _stack, hInsert,
      _hNoDup, _hFresh, _hRel => by
      simp [Source.Store.insertMany] at hInsert
  | _name :: _names, [], _store, _store', _layout, _stack, hInsert,
      _hNoDup, _hFresh, _hRel => by
      simp [Source.Store.insertMany] at hInsert
  | name :: names, value :: values, store, store', layout, stack, hInsert,
      hNoDup, hFresh, hRel => by
      unfold Source.Store.insertMany at hInsert
      cases hNoDup with
      | cons hNameNotMem hNamesNoDup =>
          have hNameFresh : name ∉ layout :=
            hFresh name (by simp)
          have hTailFresh :
              ∀ tailName, tailName ∈ names → tailName ∉ name :: layout := by
            intro tailName hTailMem hMem
            have hNe : tailName ≠ name := by
              intro hEq
              subst tailName
              exact hNameNotMem name hTailMem rfl
            have hNotLayout : tailName ∉ layout :=
              hFresh tailName (by simp [hTailMem])
            simp [hNe] at hMem
            exact hNotLayout hMem
          have hHeadRel :
              Locals.SourceLowering.StackStoreRel (name :: layout)
                (Locals.Source.Store.insert store name value)
                (value :: stack) :=
            Locals.SourceLowering.StackStoreRel.cons_insert hNameFresh hRel
          have hTail :=
            insertMany_reverse_prefix
              (names := names) (wordValues := values)
              (store := Locals.Source.Store.insert store name value)
              (store' := store') (layout := name :: layout)
              (stack := value :: stack)
              hInsert hNamesNoDup hTailFresh hHeadRel
          simpa [List.reverse_cons, List.append_assoc] using hTail

theorem insertMany_reverse_empty {names : List Name} {values : List Word}
    {store' : Source.Store}
    (hInsert :
      Source.Store.insertMany names values Locals.Source.Store.empty =
        some store')
    (hNoDup : names.Nodup) :
    Locals.SourceLowering.StackStoreRel names.reverse store'
      values.reverse := by
  simpa using
    insertMany_reverse_prefix
      (names := names) (wordValues := values)
      (store := Locals.Source.Store.empty) (store' := store')
      (layout := []) (stack := []) hInsert hNoDup
      (by intro name hMem hEmpty; cases hEmpty)
      Locals.SourceLowering.StackStoreRel.nil

end StackStoreRel

namespace Cleanup

theorem run_replicate_pop_exists (state : EVMState) :
    ∀ n, n ≤ state.stack.length →
      ∃ final,
        Structured.Code.run
            (List.replicate n (Structured.BasicInstr.op .pop)) state =
          .ok final := by
  intro n
  induction n generalizing state with
  | zero =>
      intro _hLen
      exact ⟨state, by simp [Structured.Code.run]⟩
  | succ n ih =>
      intro hLen
      cases state with
      | mk shared pc stack execLength =>
          cases stack with
          | nil =>
              simp at hLen
          | cons top rest =>
              let state0 : EVMState :=
                { toSharedState := shared, pc := pc, stack := top :: rest,
                  execLength := execLength }
              let stepState : EVMState :=
                state0.replaceStackAndIncrPC rest
              have hStep :
                  Structured.BasicInstr.step (Structured.BasicInstr.op .pop)
                      state0 =
                    .ok stepState := by
                simp [state0, stepState, Structured.BasicInstr.step,
                  Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
                  Assembly.Target.stepInstr, Assembly.PrimOp.step,
                  Assembly.PrimStep.run, Assembly.PrimOp.continuingStep?,
                  EvmYul.Stack.pop]
              have hLenRest : n ≤ rest.length := by
                simpa using Nat.le_of_succ_le_succ hLen
              have hLenTail : n ≤ stepState.stack.length := by
                simpa [stepState, state0,
                  EvmYul.EVM.State.replaceStackAndIncrPC,
                  EvmYul.EVM.State.incrPC] using hLenRest
              rcases ih stepState hLenTail with ⟨final, hTail⟩
              exact ⟨final, by
                simpa [Structured.Code.run, List.replicate_succ, state0,
                  hStep] using hTail⟩

theorem runCleanupTo_exists {ctx : Locals.Ctx} {targetDepth : Nat}
    {state : Locals.RunState}
    (hDepth : targetDepth ≤ ctx.layout.length)
    (hStackLen : state.evm.stack.length = ctx.layout.length) :
    ∃ cleaned,
      Locals.Direct.Ctx.runCleanupTo ctx targetDepth state = .ok cleaned := by
  unfold Locals.Direct.Ctx.runCleanupTo
  unfold Locals.Ctx.cleanupTo?
  simp [hDepth, Structured.Code.runState]
  have hPopLen :
      ctx.layout.length - targetDepth ≤ state.evm.stack.length := by
    omega
  rcases run_replicate_pop_exists state.evm
      (ctx.layout.length - targetDepth) hPopLen with
    ⟨evm, hRun⟩
  exact ⟨state.withEVM evm, by simp [hRun]⟩

theorem runCleanupAll_exists {ctx : Locals.Ctx} {state : Locals.RunState}
    (hStackLen : state.evm.stack.length = ctx.layout.length) :
    ∃ cleaned,
      Locals.Direct.Ctx.runCleanupAll ctx state = .ok cleaned ∧
        cleaned.evm.toSharedState = state.evm.toSharedState ∧
        cleaned.returns = state.returns := by
  rcases runCleanupTo_exists
      (ctx := ctx) (targetDepth := 0) (state := state)
      (Nat.zero_le ctx.layout.length) hStackLen with
    ⟨cleaned, hRunTo⟩
  rcases Locals.Direct.Ctx.runCleanupTo_stack_drop hRunTo with
    ⟨_hDepth, _hStack, hShared, hReturns⟩
  have hRunAll :
      Locals.Direct.Ctx.runCleanupAll ctx state = .ok cleaned := by
    simpa [Locals.Direct.Ctx.runCleanupAll, Locals.Direct.Ctx.runCleanupTo,
      Locals.Ctx.cleanupAll, Locals.Ctx.cleanupTo?] using hRunTo
  exact ⟨cleaned, hRunAll, hShared, hReturns⟩

theorem swapRestoreUpTo_exists {state : EVMState}
    {front suffix : List Word} {token : Word}
    (hBound : front.length ≤ 16) :
    ∃ code final,
      Locals.Ctx.swapRestoreUpTo? front.length = some code ∧
      Structured.Code.run code { state with stack := front ++ token :: suffix } =
        .ok final ∧
      final.stack = token :: front ++ suffix ∧
      final.toSharedState =
        ({ state with stack := front ++ token :: suffix } : EVMState).toSharedState := by
  induction front using List.reverseRecOn generalizing state suffix token with
  | nil =>
      refine ⟨[], { state with stack := token :: suffix }, rfl, ?_, ?_, rfl⟩
      · simp [Structured.Code.run]
      · rfl
  | append_singleton front last ih =>
      have hSwapBound : front.length + 1 ≤ 16 := by
        simpa [List.length_append] using hBound
      have hFrontBound : front.length ≤ 16 := by omega
      rcases ih (state := state) (suffix := token :: suffix) (token := last)
          hFrontBound with
        ⟨restore, mid, hRestoreCode, hRestoreRun, hMidStack, hMidShared⟩
      rcases
          Locals.SourceLowering.Assignment.stackOp_swap?_step_eq_swap
            (n := front.length + 1) (by omega) hSwapBound mid with
        ⟨swapOp, hSwapOp, hSwapStep⟩
      let finalState : EVMState :=
        mid.replaceStackAndIncrPC (token :: front ++ [last] ++ suffix)
      have hMidRecord :
          { mid with stack := last :: front ++ [token] ++ suffix } = mid := by
        have hStackEq :
            last :: front ++ [token] ++ suffix = mid.stack := by
          rw [hMidStack]
          simp [List.append_assoc]
        rw [hStackEq]
      have hStep :
          Structured.BasicInstr.step (Structured.BasicInstr.op swapOp) mid =
            .ok finalState := by
        simp [Structured.BasicInstr.step, hSwapStep]
        rw [← hMidRecord]
        simpa [finalState] using
          Structured.Preservation.StackShuffle.swap_snoc (state := mid)
            (front := front) (suffix := suffix) (top := last)
            (last := token)
      refine ⟨restore ++ [Structured.BasicInstr.op swapOp], finalState,
        ?hCode, ?hRun, ?hStack, ?hShared⟩
      · simp [Locals.Ctx.swapRestoreUpTo?, List.length_append,
          hRestoreCode, hSwapOp]
      · rw [Locals.Direct.code_run_append]
        simp [hRestoreRun, Structured.Code.run, hStep]
      · simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, List.append_assoc]
      · simpa [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC] using hMidShared

theorem cleanupOnePreserving_exists {state : EVMState}
    {preserved suffix : List Word} {localValue : Word}
    (hBound : preserved.length ≤ 16) :
    ∃ code final,
      Locals.Ctx.cleanupOnePreserving? preserved.length = some code ∧
      Structured.Code.run code
          { state with stack := preserved ++ localValue :: suffix } =
        .ok final ∧
      final.stack = preserved ++ suffix ∧
      final.toSharedState =
        ({ state with stack := preserved ++ localValue :: suffix } : EVMState).toSharedState := by
  cases preserved with
  | nil =>
      let finalState : EVMState :=
        ({ state with stack := localValue :: suffix } : EVMState).replaceStackAndIncrPC
          suffix
      have hPop :
          Structured.BasicInstr.step (Structured.BasicInstr.op .pop)
              { state with stack := localValue :: suffix } =
            .ok finalState := by
        simp [Structured.BasicInstr.step, Structured.BasicOp.step,
          Structured.BasicOp.toPrimOp, Assembly.Target.stepInstr,
          Assembly.PrimOp.step, Assembly.PrimStep.run,
          Assembly.PrimOp.continuingStep?, EvmYul.Stack.pop, finalState]
      refine ⟨[Structured.BasicInstr.op .pop], finalState, rfl, ?_, ?_, ?_⟩
      · simp [Structured.Code.run, hPop]
      · simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC]
      · simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC]
  | cons top front =>
      have hSwapBound : front.length + 1 ≤ 16 := by
        simpa using hBound
      rcases
          Locals.SourceLowering.Assignment.stackOp_swap?_step_eq_swap
            (n := front.length + 1) (by omega) hSwapBound
            { state with stack := top :: front ++ localValue :: suffix } with
        ⟨swapOp, hSwapOp, hSwapStep⟩
      let afterSwap : EVMState :=
        ({ state with stack := top :: front ++ localValue :: suffix } :
          EVMState).replaceStackAndIncrPC
          (localValue :: front ++ [top] ++ suffix)
      have hSwapRun :
          Structured.BasicInstr.step (Structured.BasicInstr.op swapOp)
              { state with stack := top :: front ++ localValue :: suffix } =
            .ok afterSwap := by
        change
          swapOp.step
              { state with stack := top :: front ++ localValue :: suffix } =
            .ok afterSwap
        rw [hSwapStep]
        simpa [afterSwap, List.append_assoc] using
          Structured.Preservation.StackShuffle.swap_snoc (state := state)
            (front := front) (suffix := suffix) (top := top)
            (last := localValue)
      let afterPop : EVMState :=
        afterSwap.replaceStackAndIncrPC (front ++ [top] ++ suffix)
      have hPopRun :
          Structured.BasicInstr.step (Structured.BasicInstr.op .pop)
              afterSwap =
            .ok afterPop := by
        simp [Structured.BasicInstr.step, Structured.BasicOp.step,
          Structured.BasicOp.toPrimOp, Assembly.Target.stepInstr,
          Assembly.PrimOp.step, Assembly.PrimStep.run,
          Assembly.PrimOp.continuingStep?, EvmYul.Stack.pop, afterSwap,
          afterPop, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, List.append_assoc]
      have hFrontBound : front.length ≤ 16 := by omega
      rcases swapRestoreUpTo_exists (state := afterPop) (front := front)
          (suffix := suffix) (token := top) hFrontBound with
        ⟨restore, finalState, hRestoreCode, hRestoreRun, hFinalStack,
          hFinalShared⟩
      have hAfterPopRecord :
          { afterPop with stack := front ++ top :: suffix } = afterPop := by
        simp [afterPop, afterSwap, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, List.append_assoc]
      refine
        ⟨[Structured.BasicInstr.op swapOp, Structured.BasicInstr.op .pop] ++
            restore,
          finalState, ?hCode, ?hRun, ?hStack, ?hShared⟩
      · simp [Locals.Ctx.cleanupOnePreserving?, hSwapOp, hRestoreCode]
      · simp [Structured.Code.run]
        have hSwapRun' :
            (Structured.BasicInstr.op swapOp).step
                { state with stack := top :: (front ++ localValue :: suffix) } =
              .ok afterSwap := by
          simpa [List.append_assoc] using hSwapRun
        rw [hSwapRun']
        simp [hPopRun]
        simpa [hAfterPopRecord] using hRestoreRun
      · simpa using hFinalStack
      · simpa [afterPop, afterSwap, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC] using hFinalShared

theorem cleanupManyPreserving_exists {state : EVMState}
    {preserved remove keep : List Word}
    (hBound : preserved.length ≤ 16) :
    ∃ code final,
      Locals.Ctx.cleanupManyPreserving? remove.length preserved.length =
        some code ∧
      Structured.Code.run code
          { state with stack := preserved ++ remove ++ keep } =
        .ok final ∧
      final.stack = preserved ++ keep ∧
      final.toSharedState =
        ({ state with stack := preserved ++ remove ++ keep } :
          EVMState).toSharedState := by
  induction remove generalizing state with
  | nil =>
      refine ⟨[], { state with stack := preserved ++ keep }, rfl, ?_, ?_, rfl⟩
      · simp [Structured.Code.run]
      · simp
  | cons localValue rest ih =>
      rcases cleanupOnePreserving_exists (state := state)
          (preserved := preserved) (suffix := rest ++ keep)
          (localValue := localValue) hBound with
        ⟨head, mid, hHeadCode, hHeadRun, hMidStack, hMidShared⟩
      rcases ih (state := mid) with
        ⟨tail, finalState, hTailCode, hTailRun, hFinalStack, hFinalShared⟩
      have hMidRecord :
          { mid with stack := preserved ++ (rest ++ keep) } = mid := by
        cases mid with
        | mk shared pc stack execLength =>
            dsimp at hMidStack ⊢
            rw [← hMidStack]
      have hTailRunMid : Structured.Code.run tail mid = .ok finalState := by
        simpa [hMidRecord] using hTailRun
      refine ⟨head ++ tail, finalState, ?hCode, ?hRun, hFinalStack, ?hShared⟩
      · simp [Locals.Ctx.cleanupManyPreserving?, hHeadCode, hTailCode]
      · rw [Locals.Direct.code_run_append]
        simp [hHeadRun]
        exact hTailRunMid
      · simpa [hMidRecord] using hFinalShared.trans hMidShared

theorem runCleanupToPreserving_exists {ctx : Locals.Ctx}
    {preserve targetDepth : Nat} {state : Locals.RunState}
    {preserved locals : List Word}
    (hTarget : targetDepth ≤ ctx.layout.length)
    (hPreserveLen : preserved.length = preserve)
    (hBound : preserve ≤ 16)
    (hStack : state.evm.stack = preserved ++ locals)
    (hLocalsLen : locals.length = ctx.layout.length) :
    ∃ cleaned,
      Locals.Direct.Ctx.runCleanupToPreserving ctx preserve targetDepth state =
        .ok cleaned ∧
      cleaned.evm.stack =
        preserved ++ locals.drop (ctx.layout.length - targetDepth) ∧
      cleaned.evm.toSharedState = state.evm.toSharedState ∧
      cleaned.returns = state.returns := by
  let count := ctx.layout.length - targetDepth
  have hCountLe : count ≤ locals.length := by
    dsimp [count]
    omega
  have hTakeLen : (locals.take count).length = count := by
    simp [List.length_take, Nat.min_eq_left hCountLe]
  have hPreservedBound : preserved.length ≤ 16 := by
    omega
  rcases cleanupManyPreserving_exists (state := state.evm)
      (preserved := preserved) (remove := locals.take count)
      (keep := locals.drop count) hPreservedBound with
    ⟨code, finalEVM, hCode, hRun, hFinalStack, hFinalShared⟩
  have hCode' :
      Locals.Ctx.cleanupManyPreserving? count preserve = some code := by
    simpa [hTakeLen, hPreserveLen] using hCode
  have hStackSplit :
      preserved ++ locals.take count ++ locals.drop count =
        state.evm.stack := by
    rw [show preserved ++ locals.take count ++ locals.drop count =
        preserved ++ locals by
      simp [List.take_append_drop, List.append_assoc]]
    exact hStack.symm
  have hStartRecord :
      { state.evm with
          stack := preserved ++ locals.take count ++ locals.drop count } =
        state.evm := by
    cases state with
    | mk evm returns =>
        cases evm with
        | mk shared pc stack execLength =>
            dsimp at hStackSplit ⊢
            rw [hStackSplit]
  have hRunEVM : Structured.Code.run code state.evm = .ok finalEVM := by
    rw [← hStartRecord]
    exact hRun
  refine ⟨state.withEVM finalEVM, ?hRunState, ?hStackFinal, ?hShared, rfl⟩
  · unfold Locals.Direct.Ctx.runCleanupToPreserving
    unfold Locals.Ctx.cleanupToPreserving?
    simp [hTarget]
    rw [show ctx.layout.length - targetDepth = count by rfl, hCode']
    simp [Structured.Code.runState, hRunEVM]
  · simpa [Structured.RunState.withEVM, count] using hFinalStack
  · have hSharedStart :
        ({ state.evm with
          stack := preserved ++ locals.take count ++ locals.drop count } :
          EVMState).toSharedState = state.evm.toSharedState := by
      rw [hStartRecord]
    simpa [Structured.RunState.withEVM, hSharedStart] using hFinalShared

end Cleanup

/--
Context relation for lowering `Functions.Source` to `Functions.Direct`.

Break/continue handlers are ordinary scoped cleanups, so they relate to the
length and retained concrete suffix shape of the source handler scope.  `leave`
is different at the function layer: source `leave` keeps the function-local
return variables for lookup, while the direct backend jumps to the procedure
epilogue by cleaning to depth `0` and preserving `retc` result values.  That
distinction is precisely why this relation lives at the function/procedure
boundary.
-/
def CtxRel (retc : Nat) (source : Source.Ctx) (target : Locals.Ctx) : Prop :=
  SameScope target.layout source.scope ∧
    target.breakDepth? = source.breakScope?.map List.length ∧
    target.continueDepth? = source.continueScope?.map List.length ∧
    target.leaveDepth? = source.leaveScope?.map (fun _scope => 0) ∧
    target.leaveRetc = retc ∧
    (∀ scope, source.breakScope? = some scope →
      CleanupScopeRel target.layout scope) ∧
    (∀ scope, source.continueScope? = some scope →
      CleanupScopeRel target.layout scope)

namespace CtxRel

theorem initial :
    CtxRel 0 Source.Ctx.initial Locals.Ctx.initial := by
  simp [CtxRel, Source.Ctx.initial, Locals.Ctx.initial, SameScope.refl]

theorem layout_nodup {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx}
    (hRel : CtxRel retc source target)
    (hSourceNoDup : source.scope.Nodup) :
    target.layout.Nodup := by
  exact SameScope.nodup_left hRel.1 hSourceNoDup

theorem withoutLoopControl {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx}
    (hRel : CtxRel retc source target) :
    CtxRel retc source.withoutLoopControl target.withoutLoopControl := by
  rcases hRel with
    ⟨hScope, hBreak, hContinue, hLeave, hRetc, _hBreakScope,
      _hContinueScope⟩
  simp [CtxRel, Source.Ctx.withoutLoopControl,
    Locals.Ctx.withoutLoopControl, hScope, hLeave, hRetc]

theorem withLoopControl_self {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx}
    (hRel : CtxRel retc source target) :
    CtxRel retc (source.withLoopControl source.scope source.scope)
      (target.withLoopControl target.layout.length) := by
  rcases hRel with
    ⟨hScope, _hBreak, _hContinue, hLeave, hRetc, _hBreakScope,
      _hContinueScope⟩
  rcases hScope with ⟨hLength, hMem⟩
  have hScopeRel : SameScope target.layout source.scope := ⟨hLength, hMem⟩
  refine ⟨hScopeRel, ?_, ?_, ?_, hRetc, ?_, ?_⟩
  · simp [Source.Ctx.withLoopControl, Locals.Ctx.withLoopControl, hLength]
  · simp [Source.Ctx.withLoopControl, Locals.Ctx.withLoopControl, hLength]
  · simpa [Source.Ctx.withLoopControl, Locals.Ctx.withLoopControl] using hLeave
  · intro scope h
    simp [Source.Ctx.withLoopControl] at h
    subst scope
    exact CleanupScopeRel.of_sameScope hScopeRel
  · intro scope h
    simp [Source.Ctx.withLoopControl] at h
    subst scope
    exact CleanupScopeRel.of_sameScope hScopeRel

theorem withLeaveScope_self {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx}
    (hRel : CtxRel retc source target) :
    CtxRel retc (source.withLeaveScope source.scope)
      { target with leaveDepth? := some 0 } := by
  rcases hRel with
    ⟨hScope, hBreak, hContinue, _hLeave, hRetc, hBreakScope,
      hContinueScope⟩
  refine ⟨hScope, ?_, ?_, ?_, hRetc, ?_, ?_⟩
  · simpa [Source.Ctx.withLeaveScope] using hBreak
  · simpa [Source.Ctx.withLeaveScope] using hContinue
  · simp [Source.Ctx.withLeaveScope]
  · intro scope h
    exact hBreakScope scope (by simpa [Source.Ctx.withLeaveScope] using h)
  · intro scope h
    exact hContinueScope scope (by simpa [Source.Ctx.withLeaveScope] using h)

theorem withScopeCons {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx} {name : Name}
    (hRel : CtxRel retc source target) :
    CtxRel retc { source with scope := name :: source.scope }
      (target.withLayout (name :: target.layout)) := by
  rcases hRel with
    ⟨hScope, hBreak, hContinue, hLeave, hRetc, hBreakScope,
      hContinueScope⟩
  refine ⟨SameScope.cons hScope, ?_, ?_, ?_, hRetc, ?_, ?_⟩
  · simpa [Locals.Ctx.withLayout] using hBreak
  · simpa [Locals.Ctx.withLayout] using hContinue
  · simpa [Locals.Ctx.withLayout] using hLeave
  · intro scope h
    exact CleanupScopeRel.cons (hBreakScope scope h)
  · intro scope h
    exact CleanupScopeRel.cons (hContinueScope scope h)

theorem assignmentTargets {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx} {targets : List Name}
    (hRel : CtxRel retc source target)
    (hContains : Scope.containsAll source.scope targets)
    (hBound : targets.length + target.layout.length ≤ 16) :
    ∀ {name : Name}, name ∈ targets →
      ∃ idx, target.layout[idx]? = some name ∧ targets.length + idx ≤ 16 := by
  rcases hRel with
    ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc, _hBreakScope,
      _hContinueScope⟩
  intro name hMemTargets
  have hSourceMem : name ∈ source.scope :=
    hContains name hMemTargets
  have hTargetMem : name ∈ target.layout :=
    (hScope.2 name).mpr hSourceMem
  rcases (List.mem_iff_getElem?.mp hTargetMem) with ⟨idx, hGet⟩
  have hIdxLt : idx < target.layout.length := by
    rcases List.getElem?_eq_some_iff.mp hGet with ⟨hLt, _hEq⟩
    exact hLt
  exact ⟨idx, hGet, by omega⟩

theorem lookup_of_source_mem {retc : Nat} {source : Source.Ctx}
    {target : Locals.Ctx} {name : Name}
    (hRel : CtxRel retc source target)
    (hSourceMem : name ∈ source.scope)
    (hBound : target.layout.length ≤ 16) :
    ∃ idx, target.layout[idx]? = some name ∧ idx + 1 ≤ 16 := by
  rcases hRel with
    ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc, _hBreakScope,
      _hContinueScope⟩
  have hTargetMem : name ∈ target.layout :=
    (hScope.2 name).mpr hSourceMem
  rcases List.mem_iff_getElem?.mp hTargetMem with ⟨idx, hGet⟩
  have hIdxLt : idx < target.layout.length := by
    rcases List.getElem?_eq_some_iff.mp hGet with ⟨hLt, _hEq⟩
    exact hLt
  exact ⟨idx, hGet, by omega⟩

end CtxRel

def LeaveFrameAvailable (ctx : Source.Ctx)
    (hiddenReturns : List Structured.ReturnDest) : Prop :=
  ∀ leaveScope, ctx.leaveScope? = some leaveScope → hiddenReturns ≠ []

namespace LeaveFrameAvailable

theorem initial :
    LeaveFrameAvailable Source.Ctx.initial [] := by
  intro leaveScope hLeave hNil
  simp [Source.Ctx.initial] at hLeave

theorem cons {ctx : Source.Ctx}
    {frame : Structured.ReturnDest}
    {hiddenReturns : List Structured.ReturnDest} :
    LeaveFrameAvailable ctx (frame :: hiddenReturns) := by
  intro leaveScope hLeave hNil
  cases hNil

theorem withoutLoopControl {ctx : Source.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    (hSafe : LeaveFrameAvailable ctx hiddenReturns) :
    LeaveFrameAvailable ctx.withoutLoopControl hiddenReturns := by
  intro leaveScope hLeave
  exact hSafe leaveScope
    (by simpa [Source.Ctx.withoutLoopControl] using hLeave)

theorem withLoopControl {ctx : Source.Ctx} {breakScope continueScope : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    (hSafe : LeaveFrameAvailable ctx hiddenReturns) :
    LeaveFrameAvailable (ctx.withLoopControl breakScope continueScope)
      hiddenReturns := by
  intro leaveScope hLeave
  exact hSafe leaveScope
    (by simpa [Source.Ctx.withLoopControl] using hLeave)

theorem of_stmt_regular {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {state sourceInner : Source.State}
    {hiddenReturns : List Structured.ReturnDest}
    (hSafe : LeaveFrameAvailable ctx hiddenReturns)
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt state =
        .ok (Source.Outcome.regular sourceInner, ctxOut)) :
    LeaveFrameAvailable ctxOut hiddenReturns := by
  intro leaveScope hLeave
  exact hSafe leaveScope
    (by
      rw [← SourceRun.stmt_regular_leaveScope hRun]
      exact hLeave)

theorem of_block_regular {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {block : Block} {state sourceInner : Source.State}
    {hiddenReturns : List Structured.ReturnDest}
    (hSafe : LeaveFrameAvailable ctx hiddenReturns)
    (hRun :
      Source.Block.runOpen prim program ctx fuel block state =
        .ok (Source.Outcome.regular sourceInner, ctxOut)) :
    LeaveFrameAvailable ctxOut hiddenReturns := by
  intro leaveScope hLeave
  exact hSafe leaveScope
    (by
      rw [← SourceRun.block_runOpen_regular_leaveScope hRun]
      exact hLeave)

end LeaveFrameAvailable

namespace FunDef

def sourceBodyCtx (fn : FunDef) : Source.Ctx :=
  Source.FunDef.bodyCtx fn

def targetBodyCtx (fn : FunDef) : Locals.Ctx :=
  Locals.Ctx.procEntryWithLayoutAndRetc
    (fn.returns.reverse ++ fn.params.reverse) fn.returns.length

theorem bodyCtxRel (fn : FunDef) :
    CtxRel fn.returns.length (sourceBodyCtx fn) (targetBodyCtx fn) := by
  constructor
  · exact SameScope.reverse_append fn.returns fn.params
  · simp [sourceBodyCtx, Source.FunDef.bodyCtx, targetBodyCtx,
      Source.Ctx.initial, Source.Ctx.withLeaveScope,
      Locals.Ctx.procEntryWithLayoutAndRetc,
      Locals.Ctx.procEntryWithLayout, Locals.Ctx.procEntry,
      Locals.Ctx.initial]

theorem targetBodyCtx_layout_nodup {fn : FunDef}
    (hScoped : fn.Scoped) :
    (targetBodyCtx fn).layout.Nodup := by
  have hSignature : (fn.returns ++ fn.params).Nodup :=
    Functions.FunDef.signatureNodup hScoped
  have hReverse :
      (fn.params.reverse ++ fn.returns.reverse).Nodup := by
    simpa [List.reverse_append] using
      (List.nodup_reverse.mpr hSignature)
  have hPerm :
      (fn.params.reverse ++ fn.returns.reverse).Perm
        (fn.returns.reverse ++ fn.params.reverse) :=
    List.perm_append_comm
  have hTarget :
      (fn.returns.reverse ++ fn.params.reverse).Nodup :=
    (List.Perm.nodup_iff hPerm).mp hReverse
  simpa [targetBodyCtx, Locals.Ctx.procEntryWithLayoutAndRetc,
    Locals.Ctx.procEntryWithLayout, Locals.Ctx.procEntry,
    Locals.Ctx.initial] using hTarget

end FunDef

def StateRel (layout : List Name) (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) (target : Locals.RunState) : Prop :=
  Locals.SourceLowering.StateRel layout source target ∧
    target.returns = hiddenReturns

namespace StateRel

theorem initial {evm : EVMState}
    (hStack : evm.stack = []) :
    StateRel [] [] (Source.Program.initialState evm.toSharedState)
      (Structured.RunState.initial evm) := by
  constructor
  · constructor
    · rfl
    · simpa [hStack] using Locals.SourceLowering.StackStoreRel.nil
  · rfl

theorem cleanupTo_scope {ctx : Locals.Ctx} {scope : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target cleaned : Locals.RunState}
    (hRel : StateRel ctx.layout hiddenReturns source target)
    (hScope : CleanupScopeRel ctx.layout scope)
    (hRun :
      Locals.Direct.Ctx.runCleanupTo ctx scope.length target = .ok cleaned) :
    StateRel (ctx.layout.drop (ctx.layout.length - scope.length))
      hiddenReturns (Locals.Source.State.restrictTo scope source) cleaned := by
  rcases hRel with ⟨hLowerRel, hReturns⟩
  rcases hLowerRel with ⟨hSharedRel, hStackRel⟩
  rcases hStackRel with ⟨hStackLen, hStackLookup⟩
  rcases hScope with ⟨hScopeLength, hScopeMem⟩
  rcases Locals.Direct.Ctx.runCleanupTo_stack_drop hRun with
    ⟨_hDepth, hCleanStack, hCleanShared, hCleanReturns⟩
  constructor
  · constructor
    · simp [Locals.Source.State.restrictTo, hCleanShared, hSharedRel]
    · constructor
      · rw [hCleanStack]
        simp [List.length_drop, hStackLen]
      · intro idx name hLayout
        have hCombined :
            ctx.layout[ctx.layout.length - scope.length + idx]? =
              some name := by
          rw [← List.getElem?_drop]
          exact hLayout
        have hStackAt := hStackLookup hCombined
        rw [hCleanStack, List.getElem?_drop]
        have hNameMem : name ∈ scope :=
          (hScopeMem name).mp (List.mem_of_getElem? hLayout)
        simpa [Locals.Source.State.restrictTo,
          Locals.Source.Store.restrictTo, hNameMem] using hStackAt
  · exact hCleanReturns.trans hReturns

theorem cleanupTo_layout {ctx : Locals.Ctx} {outer scope : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target cleaned : Locals.RunState}
    (hRel : StateRel ctx.layout hiddenReturns source target)
    (hLayout : CleanupLayoutRel ctx.layout outer)
    (hScope : SameScope outer scope)
    (hRun :
      Locals.Direct.Ctx.runCleanupTo ctx outer.length target = .ok cleaned) :
    StateRel outer hiddenReturns (Locals.Source.State.restrictTo scope source)
      cleaned := by
  rcases hScope with ⟨hLength, hMem⟩
  have hRunScope :
      Locals.Direct.Ctx.runCleanupTo ctx scope.length target = .ok cleaned := by
    simpa [hLength] using hRun
  have hCleanupScope :
      CleanupScopeRel ctx.layout scope :=
    CleanupLayoutRel.to_cleanupScope hLayout ⟨hLength, hMem⟩
  have hClean :=
    cleanupTo_scope
      (ctx := ctx) (scope := scope) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (cleaned := cleaned)
      hRel hCleanupScope hRunScope
  have hDrop :
      ctx.layout.drop (ctx.layout.length - scope.length) = outer := by
    simpa [CleanupLayoutRel, hLength] using hLayout
  simpa [hDrop] using hClean

theorem withShared {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (shared : EvmYul.SharedState .EVM)
    (hRel : StateRel layout hiddenReturns source target) :
    StateRel layout hiddenReturns (source.withShared shared)
      (target.withEVM { target.evm with toSharedState := shared }) := by
  rcases hRel with ⟨⟨_hShared, hStackRel⟩, hReturns⟩
  exact ⟨⟨rfl, by simpa [Structured.RunState.withEVM] using hStackRel⟩,
    by simpa [Structured.RunState.withEVM] using hReturns⟩

theorem restrictTo_sameScope {layout scope : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target)
    (hScope : SameScope layout scope) :
    StateRel layout hiddenReturns (Locals.Source.State.restrictTo scope source)
      target := by
  rcases hRel with ⟨⟨hShared, hStackRel⟩, hReturns⟩
  rcases hStackRel with ⟨hStackLen, hStackLookup⟩
  constructor
  · constructor
    · simpa [Locals.Source.State.restrictTo] using hShared
    · constructor
      · exact hStackLen
      · intro idx name hLayout
        have hNameMem : name ∈ scope :=
          (hScope.2 name).mp (List.mem_of_getElem? hLayout)
        simpa [Locals.Source.State.restrictTo,
          Locals.Source.Store.restrictTo, hNameMem] using
          hStackLookup hLayout
  · exact hReturns

end StateRel

namespace Access

mutual
  def exprWidth {results : Nat} : Expr results → Nat
    | .lit _value => 0
    | .var _name => 1
    | .code _code => 0
    | .prim _op args => exprSeqWidth args

  def exprSeqWidth {results : Nat} : Locals.ExprSeq results → Nat
    | .nil => 0
    | .cons (left := left) head tail =>
        max (exprWidth head) (left + exprSeqWidth tail)
end

theorem exprSeq_results_le_width :
    ∀ {results : Nat} (exprs : Locals.ExprSeq results),
      results ≤ exprSeqWidth exprs
  | _, exprs => by
      cases exprs with
      | nil =>
          simp [exprSeqWidth]
      | cons head tail =>
          rename_i left right
          have hTail := exprSeq_results_le_width tail
          simp [exprSeqWidth]
          omega

end Access

namespace FrameBound

/-
Source-side stack-resource precondition for the function source/direct lowering.

This is deliberately not part of `Functions.Source` semantics: it is a compiler
resource bound used to discharge EVM `DUP`/`SWAP` reachability obligations in
this lowering proof.  It is phrased over source scopes instead of target layouts
so higher layers can establish it without mentioning concrete stack slots.
-/
mutual
  def Block (returns env : List Name) : Block → Prop
    | ⟨stmts⟩ => StmtList returns env stmts

  def Stmt (returns env : List Name) : Stmt → Prop
    | .expr expr => env.length + Access.exprWidth expr ≤ 16
    | .let_ _name value => env.length + Access.exprWidth value ≤ 16
    | .assign _name value => env.length + Access.exprWidth value ≤ 16
    | .block body => Block returns env body
    | .if_ cond body =>
        env.length + Access.exprWidth cond ≤ 16 ∧
          Block returns env body
    | .switch scrutinee cases defaultBody =>
        env.length + Access.exprWidth scrutinee ≤ 16 ∧
          CaseList returns env cases ∧
            Default returns env defaultBody
    | .for_ init cond post body =>
        Block returns env init ∧
          let loopEnv := Scope.Block.outEnv env init
          loopEnv.length + Access.exprWidth cond ≤ 16 ∧
            Block returns loopEnv post ∧
              Block returns loopEnv body
    | .brk => True
    | .cont => True
    | .leave => returns.length + env.length ≤ 16
    | .call targets _functionName args =>
        env.length + Access.exprSeqWidth (Lower.argExprs args) ≤ 16 ∧
          targets.length + env.length ≤ 16
    | .terminal _kind => True
    | .terminalArgs _kind args =>
        env.length + Access.exprSeqWidth args ≤ 16

  def StmtList (returns env : List Name) : List Stmt → Prop
    | [] => True
    | stmt :: rest =>
        Stmt returns env stmt ∧
          StmtList returns (Scope.Stmt.outEnv env stmt) rest

  def CaseList (returns env : List Name) :
      List (Word × Block) → Prop
    | [] => True
    | (_value, body) :: rest =>
        Block returns env body ∧ CaseList returns env rest

  def Default (returns env : List Name) :
      Option Block → Prop
    | none => True
    | some body => Block returns env body
end

def FunDef (fn : Functions.FunDef) : Prop :=
  Block fn.returns (fn.returns ++ fn.params) fn.body ∧
    fn.returns.length +
      (Scope.Block.outEnv (fn.returns ++ fn.params) fn.body).length ≤ 16

def FunList : List Functions.FunDef → Prop
  | [] => True
  | fn :: rest => FunDef fn ∧ FunList rest

def Program (program : Functions.Program) : Prop :=
  FunList program.functions ∧ Block [] [] program.body

def le16? (width : Nat) : Bool :=
  decide (width ≤ 16)

mutual
  def block? (returns env : List Name) : Functions.Block → Bool
    | ⟨stmts⟩ => stmtList? returns env stmts

  def stmt? (returns env : List Name) : Functions.Stmt → Bool
    | .expr expr => le16? (env.length + Access.exprWidth expr)
    | .let_ _name value => le16? (env.length + Access.exprWidth value)
    | .assign _name value => le16? (env.length + Access.exprWidth value)
    | .block body => block? returns env body
    | .if_ cond body =>
        le16? (env.length + Access.exprWidth cond) &&
          block? returns env body
    | .switch scrutinee cases defaultBody =>
        le16? (env.length + Access.exprWidth scrutinee) &&
          (caseList? returns env cases &&
            default? returns env defaultBody)
    | .for_ init cond post body =>
        block? returns env init &&
          (let loopEnv := Scope.Block.outEnv env init
           le16? (loopEnv.length + Access.exprWidth cond) &&
            (block? returns loopEnv post &&
              block? returns loopEnv body))
    | .brk => true
    | .cont => true
    | .leave => le16? (returns.length + env.length)
    | .call targets _functionName args =>
        le16? (env.length + Access.exprSeqWidth (Lower.argExprs args)) &&
          le16? (targets.length + env.length)
    | .terminal _kind => true
    | .terminalArgs _kind args =>
        le16? (env.length + Access.exprSeqWidth args)

  def stmtList? (returns env : List Name) : List Functions.Stmt → Bool
    | [] => true
    | stmt :: rest =>
        stmt? returns env stmt &&
          stmtList? returns (Scope.Stmt.outEnv env stmt) rest

  def caseList? (returns env : List Name) :
      List (Word × Functions.Block) → Bool
    | [] => true
    | (_value, body) :: rest =>
        block? returns env body && caseList? returns env rest

  def default? (returns env : List Name) : Option Functions.Block → Bool
    | none => true
    | some body => block? returns env body
end

def funDef? (fn : Functions.FunDef) : Bool :=
  block? fn.returns (fn.returns ++ fn.params) fn.body &&
    le16?
      (fn.returns.length +
        (Scope.Block.outEnv (fn.returns ++ fn.params) fn.body).length)

def funList? : List Functions.FunDef → Bool
  | [] => true
  | fn :: rest => funDef? fn && funList? rest

def program? (program : Functions.Program) : Bool :=
  funList? program.functions && block? [] [] program.body

theorem le16_of_check {width : Nat}
    (hCheck : le16? width = true) :
    width ≤ 16 := by
  unfold le16? at hCheck
  exact of_decide_eq_true hCheck

mutual
  theorem block_of_check {returns env : List Name} :
      ∀ {block : Functions.Block},
        block? returns env block = true →
          Block returns env block := by
    intro block hCheck
    cases block with
    | mk stmts =>
        exact stmtList_of_check hCheck

  theorem stmt_of_check {returns env : List Name} :
      ∀ {stmt : Functions.Stmt},
        stmt? returns env stmt = true →
          Stmt returns env stmt := by
    intro stmt hCheck
    cases stmt with
    | expr expr =>
        exact le16_of_check (by simpa [stmt?] using hCheck)
    | let_ _name value =>
        exact le16_of_check (by simpa [stmt?] using hCheck)
    | assign _name value =>
        exact le16_of_check (by simpa [stmt?] using hCheck)
    | block body =>
        exact block_of_check (by simpa [stmt?] using hCheck)
    | if_ cond body =>
        have hAnd :
            le16? (env.length + Access.exprWidth cond) = true ∧
              block? returns env body = true :=
          by simpa [stmt?] using hCheck
        exact ⟨le16_of_check hAnd.1, block_of_check hAnd.2⟩
    | switch scrutinee cases defaultBody =>
        have hAnd :
            le16? (env.length + Access.exprWidth scrutinee) = true ∧
              (caseList? returns env cases &&
                default? returns env defaultBody) = true :=
          by simpa [stmt?] using hCheck
        have hTail :
            caseList? returns env cases = true ∧
              default? returns env defaultBody = true :=
          by simpa using hAnd.2
        exact
          ⟨le16_of_check hAnd.1, caseList_of_check hTail.1,
            default_of_check hTail.2⟩
    | for_ init cond post body =>
        have hAnd :
            block? returns env init = true ∧
              (let loopEnv := Scope.Block.outEnv env init
               le16? (loopEnv.length + Access.exprWidth cond) &&
                (block? returns loopEnv post &&
                  block? returns loopEnv body)) = true :=
          by simpa [stmt?] using hCheck
        let loopEnv := Scope.Block.outEnv env init
        have hLoop :
            le16? (loopEnv.length + Access.exprWidth cond) = true ∧
              (block? returns loopEnv post &&
                block? returns loopEnv body) = true :=
          by simpa [loopEnv] using hAnd.2
        have hPostBody :
            block? returns loopEnv post = true ∧
              block? returns loopEnv body = true :=
          by simpa using hLoop.2
        exact
          ⟨block_of_check hAnd.1, le16_of_check hLoop.1,
            block_of_check hPostBody.1, block_of_check hPostBody.2⟩
    | brk =>
        trivial
    | cont =>
        trivial
    | leave =>
        exact le16_of_check (by simpa [stmt?] using hCheck)
    | call targets _functionName args =>
        have hAnd :
            le16?
                (env.length + Access.exprSeqWidth (Lower.argExprs args)) =
              true ∧
              le16? (targets.length + env.length) = true :=
          by simpa [stmt?] using hCheck
        exact ⟨le16_of_check hAnd.1, le16_of_check hAnd.2⟩
    | terminal _kind =>
        trivial
    | terminalArgs _kind args =>
        exact le16_of_check (by simpa [stmt?] using hCheck)

  theorem stmtList_of_check {returns env : List Name} :
      ∀ {stmts : List Functions.Stmt},
        stmtList? returns env stmts = true →
          StmtList returns env stmts := by
    intro stmts hCheck
    cases stmts with
    | nil =>
        trivial
    | cons stmt rest =>
        have hAnd :
            stmt? returns env stmt = true ∧
              stmtList? returns (Scope.Stmt.outEnv env stmt) rest = true :=
          by simpa [stmtList?] using hCheck
        exact ⟨stmt_of_check hAnd.1, stmtList_of_check hAnd.2⟩

  theorem caseList_of_check {returns env : List Name} :
      ∀ {cases : List (Word × Functions.Block)},
        caseList? returns env cases = true →
          CaseList returns env cases := by
    intro cases hCheck
    cases cases with
    | nil =>
        trivial
    | cons head rest =>
        rcases head with ⟨_value, body⟩
        have hAnd :
            block? returns env body = true ∧
              caseList? returns env rest = true :=
          by simpa [caseList?] using hCheck
        exact ⟨block_of_check hAnd.1, caseList_of_check hAnd.2⟩

  theorem default_of_check {returns env : List Name} :
      ∀ {defaultBody : Option Functions.Block},
        default? returns env defaultBody = true →
          Default returns env defaultBody := by
    intro defaultBody hCheck
    cases defaultBody with
    | none =>
        trivial
    | some body =>
        exact block_of_check hCheck
end

theorem funDef_of_check {fn : Functions.FunDef}
    (hCheck : funDef? fn = true) :
    FunDef fn := by
  have hAnd :
      block? fn.returns (fn.returns ++ fn.params) fn.body = true ∧
        le16?
          (fn.returns.length +
            (Scope.Block.outEnv (fn.returns ++ fn.params) fn.body).length) =
          true :=
    by simpa [funDef?] using hCheck
  exact ⟨block_of_check hAnd.1, le16_of_check hAnd.2⟩

theorem funList_of_check :
    ∀ {functions : List Functions.FunDef},
      funList? functions = true →
        FunList functions
  | [], _hCheck => by
      trivial
  | fn :: rest, hCheck => by
      have hAnd :
          funDef? fn = true ∧ funList? rest = true :=
        by simpa [funList?] using hCheck
      exact ⟨funDef_of_check hAnd.1, funList_of_check hAnd.2⟩

theorem program_of_check {program : Functions.Program}
    (hCheck : program? program = true) :
    Program program := by
  have hAnd :
      funList? program.functions = true ∧
        block? [] [] program.body = true :=
    by simpa [program?] using hCheck
  exact ⟨funList_of_check hAnd.1, block_of_check hAnd.2⟩

theorem funDef_body {fn : Functions.FunDef}
    (hBound : FunDef fn) :
    Block fn.returns (fn.returns ++ fn.params) fn.body := by
  exact hBound.1

theorem funDef_regularReturnBound {fn : Functions.FunDef}
    (hBound : FunDef fn) :
    fn.returns.length +
      (Scope.Block.outEnv (fn.returns ++ fn.params) fn.body).length ≤ 16 := by
  exact hBound.2

theorem funDef_targetBodyCtx_layout_le16 {fn : Functions.FunDef}
    (hBound : FunDef fn) :
    (SourceDirect.FunDef.targetBodyCtx fn).layout.length ≤ 16 := by
  have hStartLeOut :
      (fn.returns ++ fn.params).length ≤
        (Scope.Block.outEnv (fn.returns ++ fn.params) fn.body).length :=
    SourceScope.block_outEnv_length_le
      (env := fn.returns ++ fn.params) (block := fn.body)
  have hTargetLen :
      (SourceDirect.FunDef.targetBodyCtx fn).layout.length =
        (fn.returns ++ fn.params).length := by
    simp [SourceDirect.FunDef.targetBodyCtx,
      Locals.Ctx.procEntryWithLayoutAndRetc,
      Locals.Ctx.procEntryWithLayout, Locals.Ctx.procEntry,
      Locals.Ctx.initial]
  have hFinal := funDef_regularReturnBound hBound
  rw [hTargetLen]
  omega

theorem stmtList_head {returns env : List Name}
    {stmt : Functions.Stmt} {rest : List Functions.Stmt}
    (hBound : StmtList returns env (stmt :: rest)) :
    Stmt returns env stmt := by
  exact hBound.1

theorem stmtList_tail {returns env : List Name}
    {stmt : Functions.Stmt} {rest : List Functions.Stmt}
    (hBound : StmtList returns env (stmt :: rest)) :
    StmtList returns (Scope.Stmt.outEnv env stmt) rest := by
  exact hBound.2

theorem switch_select_block {returns env : List Name} {scrutinee : Word}
    {cases : List (Word × Functions.Block)}
    {defaultBody : Option Functions.Block} {body : Functions.Block}
    (hCases : CaseList returns env cases)
    (hDefault : Default returns env defaultBody)
    (hSelect : Source.Switch.select scrutinee cases defaultBody = some body) :
    Block returns env body := by
  induction cases with
  | nil =>
      cases defaultBody with
      | none =>
          simp [Source.Switch.select] at hSelect
      | some defaultBlock =>
          simp [Source.Switch.select] at hSelect
          cases hSelect
          simpa [Default] using hDefault
  | cons head rest ih =>
      rcases head with ⟨value, caseBody⟩
      rcases hCases with ⟨hCaseBody, hRest⟩
      by_cases hEq : value = scrutinee
      · simp [Source.Switch.select, hEq] at hSelect
        cases hSelect
        exact hCaseBody
      · exact ih hRest
          (by simpa [Source.Switch.select, hEq] using hSelect)

theorem funDef_of_find? {name : Name} :
    ∀ {functions : List Functions.FunDef} {fn : Functions.FunDef},
      FunList functions →
      EvmCompiler.Functions.FunList.find? name functions = some fn →
      FunDef fn
  | [], fn, hBound, hFind => by
      simp [EvmCompiler.Functions.FunList.find?] at hFind
  | head :: rest, fn, hBound, hFind => by
      by_cases hName : head.name = name
      · simp [EvmCompiler.Functions.FunList.find?, hName] at hFind
        cases hFind
        exact hBound.1
      · simp [EvmCompiler.Functions.FunList.find?, hName] at hFind
        exact funDef_of_find? hBound.2 hFind

theorem source_funDef_of_find? {name : Name}
    {functions : List Functions.FunDef} {fn : Functions.FunDef}
    (hBound : FunList functions)
    (hFind : Source.FunList.find? name functions = some fn) :
    FunDef fn := by
  exact funDef_of_find? hBound
    (by simpa [SourceDirect.FunList.source_find?_eq name functions]
      using hFind)

theorem access_of_ctxRel {retc : Nat} {sourceCtx : Source.Ctx}
    {targetCtx : Locals.Ctx} {width : Nat}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hBound : sourceCtx.scope.length + width ≤ 16) :
    targetCtx.layout.length + width ≤ 16 := by
  rcases hCtx with ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc,
    _hBreakScope, _hContinueScope⟩
  rw [hScope.1]
  exact hBound

theorem call_argAccess_of_ctxRel {retc : Nat} {sourceCtx : Source.Ctx}
    {targetCtx : Locals.Ctx} {returns targets : List Name}
    {functionName : Name} {args : List (Expr 1)}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hBound :
      Stmt returns sourceCtx.scope (.call targets functionName args)) :
    targetCtx.layout.length + Access.exprSeqWidth (Lower.argExprs args) ≤
      16 := by
  exact access_of_ctxRel hCtx hBound.1

theorem call_assignBound_of_ctxRel {retc : Nat} {sourceCtx : Source.Ctx}
    {targetCtx : Locals.Ctx} {returns targets : List Name}
    {functionName : Name} {args : List (Expr 1)}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hBound :
      Stmt returns sourceCtx.scope (.call targets functionName args)) :
    targets.length + targetCtx.layout.length ≤ 16 := by
  rcases hCtx with ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc,
    _hBreakScope, _hContinueScope⟩
  rw [hScope.1]
  exact hBound.2

end FrameBound

namespace SourceInvariant

/--
Source-shaped invariant package for one function-source statement.

This is the public side of the recursive source/direct proof boundary: it
mentions source scopes, source scoping, and the source-shaped frame-width
predicate, but not target stack slots, cleanup depths, return tokens, or layout
positions.
-/
structure Stmt (returns : List Name) (ctx : Source.Ctx)
    (stmt : Functions.Stmt) : Prop where
  scopeNodup : ctx.scope.Nodup
  isScoped : Scope.Stmt.Scoped ctx.scope stmt
  frameBound : FrameBound.Stmt returns ctx.scope stmt
  returnScope :
    ∀ leaveScope, ctx.leaveScope? = some leaveScope →
      ∀ name, name ∈ returns → name ∈ leaveScope
  returnsInScope : ∀ name, name ∈ returns → name ∈ ctx.scope

/--
Source-shaped invariant package for an open function-source block.
-/
structure Block (returns : List Name) (ctx : Source.Ctx)
    (block : Functions.Block) : Prop where
  scopeNodup : ctx.scope.Nodup
  isScoped : Scope.Block.Scoped ctx.scope block
  frameBound : FrameBound.Block returns ctx.scope block
  returnScope :
    ∀ leaveScope, ctx.leaveScope? = some leaveScope →
      ∀ name, name ∈ returns → name ∈ leaveScope
  returnsInScope : ∀ name, name ∈ returns → name ∈ ctx.scope

namespace Stmt

theorem targetLayoutNodup {returns : List Name} {ctx : Source.Ctx}
    {targetCtx : Locals.Ctx} {stmt : Functions.Stmt} {retc : Nat}
    (hInv : Stmt returns ctx stmt)
    (hCtx : CtxRel retc ctx targetCtx) :
    targetCtx.layout.Nodup :=
  CtxRel.layout_nodup hCtx hInv.scopeNodup

theorem for_post_of_regular_init {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {ctx initCtx : Source.Ctx} {fuel : Nat}
    {init post body : Functions.Block} {cond : Expr 1}
    {state sourceAfterInit : Source.State}
    (hInv : Stmt returns ctx (.for_ init cond post body))
    (hInit :
      Source.Block.runOpen prim program ctx.withoutLoopControl fuel init
          state =
        .ok (Source.Outcome.regular sourceAfterInit, initCtx)) :
    Block returns initCtx.withoutLoopControl post := by
  have hScope :
      initCtx.scope = Scope.Block.outEnv ctx.scope init := by
    have hScope' := SourceRun.block_runOpen_regular_scope hInit
    simpa [Source.Ctx.withoutLoopControl] using hScope'
  have hInitScopeNodup :
      initCtx.scope.Nodup := by
    rw [hScope]
    exact SourceScope.block_outEnv_nodup hInv.isScoped.1 hInv.scopeNodup
  exact
    { scopeNodup := by
        simpa [Source.Ctx.withoutLoopControl] using hInitScopeNodup
      isScoped := by
        simpa [Source.Ctx.withoutLoopControl, hScope] using
          hInv.isScoped.2.2.1
      frameBound := by
        simpa [Source.Ctx.withoutLoopControl, hScope] using
          hInv.frameBound.2.2.1
      returnScope := by
        intro leaveScope hLeave name hReturn
        exact
          SourceRun.block_runOpen_regular_returnScope
            (returns := returns) hInit
            (by
              intro leaveScope hLeave name hReturn
              exact hInv.returnScope leaveScope
                (by
                  simpa [Source.Ctx.withoutLoopControl] using hLeave)
                name hReturn)
            leaveScope
            (by
              simpa [Source.Ctx.withoutLoopControl] using hLeave)
            name hReturn
      returnsInScope := by
        intro name hReturn
        have hReturns :=
          SourceRun.block_runOpen_regular_returns_in_scope
            (returns := returns) hInit
            (by
              intro name hReturn
              simpa [Source.Ctx.withoutLoopControl] using
                hInv.returnsInScope name hReturn)
            name hReturn
        simpa [Source.Ctx.withoutLoopControl] using hReturns }

theorem for_body_of_regular_init {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {ctx initCtx : Source.Ctx} {fuel : Nat}
    {init post body : Functions.Block} {cond : Expr 1}
    {state sourceAfterInit : Source.State}
    (hInv : Stmt returns ctx (.for_ init cond post body))
    (hInit :
      Source.Block.runOpen prim program ctx.withoutLoopControl fuel init
          state =
        .ok (Source.Outcome.regular sourceAfterInit, initCtx)) :
    Block returns (initCtx.withLoopControl initCtx.scope initCtx.scope)
      body := by
  have hScope :
      initCtx.scope = Scope.Block.outEnv ctx.scope init := by
    have hScope' := SourceRun.block_runOpen_regular_scope hInit
    simpa [Source.Ctx.withoutLoopControl] using hScope'
  have hInitScopeNodup :
      initCtx.scope.Nodup := by
    rw [hScope]
    exact SourceScope.block_outEnv_nodup hInv.isScoped.1 hInv.scopeNodup
  exact
    { scopeNodup := by
        simpa [Source.Ctx.withLoopControl] using hInitScopeNodup
      isScoped := by
        simpa [Source.Ctx.withLoopControl, hScope] using
          hInv.isScoped.2.2.2
      frameBound := by
        simpa [Source.Ctx.withLoopControl, hScope] using
          hInv.frameBound.2.2.2
      returnScope := by
        intro leaveScope hLeave name hReturn
        exact
          SourceRun.block_runOpen_regular_returnScope
            (returns := returns) hInit
            (by
              intro leaveScope hLeave name hReturn
              exact hInv.returnScope leaveScope
                (by
                  simpa [Source.Ctx.withoutLoopControl] using hLeave)
                name hReturn)
            leaveScope
            (by
              simpa [Source.Ctx.withLoopControl] using hLeave)
            name hReturn
      returnsInScope := by
        intro name hReturn
        have hReturns :=
          SourceRun.block_runOpen_regular_returns_in_scope
            (returns := returns) hInit
            (by
              intro name hReturn
              simpa [Source.Ctx.withoutLoopControl] using
                hInv.returnsInScope name hReturn)
            name hReturn
        simpa [Source.Ctx.withLoopControl] using hReturns }

end Stmt

namespace Block

theorem head {returns : List Name} {ctx : Source.Ctx}
    {stmt : Functions.Stmt} {rest : List Functions.Stmt}
    (hInv : Block returns ctx { stmts := stmt :: rest }) :
    Stmt returns ctx stmt := by
  exact
    { scopeNodup := hInv.scopeNodup
      isScoped := hInv.isScoped.1
      frameBound := hInv.frameBound.1
      returnScope := hInv.returnScope
      returnsInScope := hInv.returnsInScope }

theorem tail_of_regular {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {stmt : Functions.Stmt} {rest : List Functions.Stmt}
    {state sourceInner : Source.State}
    (hInv : Block returns ctx { stmts := stmt :: rest })
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt state =
        .ok (Source.Outcome.regular sourceInner, ctxOut)) :
    Block returns ctxOut { stmts := rest } := by
  have hScope :
      ctxOut.scope = Scope.Stmt.outEnv ctx.scope stmt :=
    SourceRun.stmt_regular_scope hRun
  exact
    { scopeNodup :=
        SourceRun.stmt_regular_scope_nodup hRun hInv.isScoped.1
          hInv.scopeNodup
      isScoped := by
        simpa [hScope] using hInv.isScoped.2
      frameBound := by
        simpa [hScope] using hInv.frameBound.2
      returnScope :=
        SourceRun.stmt_regular_returnScope hRun hInv.returnScope
      returnsInScope :=
        SourceRun.stmt_regular_returns_in_scope hRun
          hInv.returnsInScope }

end Block

namespace FunDef

theorem body {fn : Functions.FunDef}
    (hScoped : fn.Scoped)
    (hFrameBound : FrameBound.FunDef fn) :
    Block fn.returns (SourceDirect.FunDef.sourceBodyCtx fn) fn.body := by
  let functionScope := fn.returns ++ fn.params
  have hScope :
      (SourceDirect.FunDef.sourceBodyCtx fn).scope = functionScope := by
    simp [SourceDirect.FunDef.sourceBodyCtx, Source.FunDef.bodyCtx,
      Source.Ctx.initial, Source.Ctx.withLeaveScope, functionScope]
  exact
    { scopeNodup := by
        simpa [hScope, functionScope] using
          Functions.FunDef.signatureNodup hScoped
      isScoped := by
        simpa [hScope, functionScope] using
          Functions.FunDef.bodyScoped hScoped
      frameBound := by
        simpa [hScope, functionScope] using
          FrameBound.funDef_body hFrameBound
      returnScope := by
        intro leaveScope hLeave name hReturn
        have hLeaveScope : leaveScope = functionScope := by
          simpa [SourceDirect.FunDef.sourceBodyCtx, Source.FunDef.bodyCtx,
            Source.Ctx.initial, Source.Ctx.withLeaveScope, functionScope]
            using hLeave.symm
        rw [hLeaveScope]
        exact List.mem_append_left fn.params hReturn
      returnsInScope := by
        intro name hReturn
        rw [hScope]
        exact List.mem_append_left fn.params hReturn }

theorem body_of_find? {program : Program} {name : Name}
    {fn : Functions.FunDef}
    (hFunctionsScoped : Functions.FunList.Scoped program.functions)
    (hFunctionBounds : FrameBound.FunList program.functions)
    (hFind : Source.FunList.find? name program.functions = some fn) :
    Block fn.returns (SourceDirect.FunDef.sourceBodyCtx fn) fn.body := by
  exact body
    (SourceDirect.FunList.source_scoped_of_find? hFunctionsScoped hFind)
    (FrameBound.source_funDef_of_find? hFunctionBounds hFind)

end FunDef

namespace Program

theorem body {program : Functions.Program}
    (hScoped : program.Scoped)
    (hFrameBound : FrameBound.Program program) :
    Block [] Source.Ctx.initial program.body := by
  exact
    { scopeNodup := by
        simp [Source.Ctx.initial]
      isScoped := by
        simpa [Source.Ctx.initial] using hScoped.2
      frameBound := by
        simpa [Source.Ctx.initial] using hFrameBound.2
      returnScope := by
        intro _leaveScope _hLeave name hReturn
        cases hReturn
      returnsInScope := by
        intro name hReturn
        cases hReturn }

end Program

end SourceInvariant

namespace CtxRel

mutual
  theorem expr_accessible_of_scoped {retc offset : Nat}
      {source : Source.Ctx} {target : Locals.Ctx}
      {results : Nat} {expr : Expr results}
      (hRel : CtxRel retc source target)
      (hScoped : Scope.ExprScoped source.scope expr)
      (hBound :
        offset + target.layout.length + Access.exprWidth expr ≤ 16) :
      Locals.SourceLowering.Expr.Accessible target.layout offset expr := by
    cases expr with
    | lit value =>
        simp [Locals.SourceLowering.Expr.Accessible]
    | var name =>
        rcases hRel with
          ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc, _hBreakScope,
            _hContinueScope⟩
        have hTargetMem : name ∈ target.layout :=
          (hScope.2 name).mpr hScoped
        rcases List.mem_iff_getElem?.mp hTargetMem with ⟨idx, hGet⟩
        have hIdxLt : idx < target.layout.length := by
          rcases List.getElem?_eq_some_iff.mp hGet with ⟨hLt, _hEq⟩
          exact hLt
        exact ⟨idx, hGet, by simp [Access.exprWidth] at hBound; omega⟩
    | code code =>
        exact False.elim hScoped
    | prim op args =>
        exact exprSeq_accessible_of_scoped hRel hScoped
          (by simpa [Access.exprWidth] using hBound)

  theorem exprSeq_accessible_of_scoped {retc offset : Nat}
      {source : Source.Ctx} {target : Locals.Ctx}
      {results : Nat} {exprs : Locals.ExprSeq results}
      (hRel : CtxRel retc source target)
      (hScoped : Scope.ExprSeqScoped source.scope exprs)
      (hBound :
        offset + target.layout.length + Access.exprSeqWidth exprs ≤ 16) :
      Locals.SourceLowering.ExprSeq.Accessible target.layout offset exprs := by
    cases exprs with
    | nil =>
        simp [Locals.SourceLowering.ExprSeq.Accessible]
    | cons head tail =>
        rename_i left _right
        rcases hScoped with ⟨hHeadScoped, hTailScoped⟩
        have hHeadBound :
            offset + target.layout.length + Access.exprWidth head ≤ 16 := by
          have hLe :
              Access.exprWidth head ≤
                max (Access.exprWidth head)
                  (left + Access.exprSeqWidth tail) :=
            Nat.le_max_left _ _
          simp [Access.exprSeqWidth] at hBound
          omega
        have hTailBound :
            (offset + left) + target.layout.length +
                Access.exprSeqWidth tail ≤ 16 := by
          have hLe :
              left + Access.exprSeqWidth tail ≤
                max (Access.exprWidth head)
                  (left + Access.exprSeqWidth tail) :=
            Nat.le_max_right _ _
          simp [Access.exprSeqWidth] at hBound
          omega
        exact
          ⟨expr_accessible_of_scoped hRel hHeadScoped hHeadBound,
            exprSeq_accessible_of_scoped hRel hTailScoped hTailBound⟩
end

end CtxRel

def PrefixedStateRel (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) (stackPrefix : List Word)
    (target : Locals.RunState) : Prop :=
  target.evm.toSharedState = source.shared ∧
    ∃ baseStack : EvmYul.Stack Word,
      target.evm.stack = stackPrefix ++ baseStack ∧
        Locals.SourceLowering.StackStoreRel layout source.vars baseStack ∧
        target.returns = hiddenReturns

namespace PrefixedStateRel

theorem of_stateRel {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : StateRel layout hiddenReturns source target) :
    PrefixedStateRel layout hiddenReturns source [] target := by
  rcases hRel with ⟨⟨hShared, hStackRel⟩, hReturns⟩
  exact ⟨hShared, target.evm.stack, by simp, hStackRel, hReturns⟩

theorem of_stateRel_stack_prefix {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {base target : Locals.RunState}
    {stackPrefix : List Word}
    (hRel : StateRel layout hiddenReturns source base)
    (hShared : target.evm.toSharedState = source.shared)
    (hStack : target.evm.stack = stackPrefix ++ base.evm.stack)
    (hReturns : target.returns = hiddenReturns) :
    PrefixedStateRel layout hiddenReturns source stackPrefix target := by
  rcases hRel with ⟨⟨_hBaseShared, hStackRel⟩, _hBaseReturns⟩
  exact ⟨hShared, base.evm.stack, hStack, hStackRel, hReturns⟩

theorem to_stateRel_nil {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : PrefixedStateRel layout hiddenReturns source [] target) :
    StateRel layout hiddenReturns source target := by
  rcases hRel with ⟨hShared, baseStack, hStack, hStackRel, hReturns⟩
  exact ⟨⟨hShared, by simpa [hStack] using hStackRel⟩, hReturns⟩

theorem callerStateRel_withShared {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {stackPrefix : List Word}
    (hRel : PrefixedStateRel layout hiddenReturns source stackPrefix target)
    (shared : EvmYul.SharedState .EVM) :
    ∃ callerBase,
      target.evm.stack = stackPrefix ++ callerBase.evm.stack ∧
      StateRel layout hiddenReturns (source.withShared shared) callerBase := by
  rcases hRel with ⟨_hShared, baseStack, hStack, hStackRel, hReturns⟩
  let callerBase : Locals.RunState :=
    target.withEVM { target.evm with toSharedState := shared, stack := baseStack }
  refine ⟨callerBase, ?hStack, ?hRel⟩
  · simpa [callerBase, Structured.RunState.withEVM] using hStack
  · constructor
    · constructor
      · simp [callerBase, Structured.RunState.withEVM,
          Locals.Source.State.withShared]
      · simpa [callerBase, Structured.RunState.withEVM] using hStackRel
    · simpa [callerBase, Structured.RunState.withEVM] using hReturns

end PrefixedStateRel

namespace ArgList

theorem argExprs_sourceOwned :
    ∀ {args : List (Expr 1)},
      (∀ arg, arg ∈ args → Locals.Source.Expr.SourceOwned arg) →
        Locals.Source.ExprSeq.SourceOwned (Lower.argExprs args)
  | [], _hOwned => by
      simp [Lower.argExprs, Locals.Source.ExprSeq.SourceOwned]
  | arg :: rest, hOwned => by
      have hHead : Locals.Source.Expr.SourceOwned arg :=
        hOwned arg (by simp)
      have hTail :
          Locals.Source.ExprSeq.SourceOwned (Lower.argExprs rest) :=
        argExprs_sourceOwned (args := rest)
          (by
            intro restArg hMem
            exact hOwned restArg (by simp [hMem]))
      rw [Lower.argExprs]
      rw [ExprSeq.sourceOwned_mpr (by simp [Nat.add_comm])
        (Locals.ExprSeq.cons arg (Lower.argExprs rest))]
      simp [Locals.Source.ExprSeq.SourceOwned, hHead, hTail]

theorem argExprs_sourceOwned_of_scoped {env : List Name}
    {args : List (Expr 1)}
    (hScoped : ∀ arg, arg ∈ args → Functions.Scope.ExprScoped env arg) :
    Locals.Source.ExprSeq.SourceOwned (Lower.argExprs args) :=
  argExprs_sourceOwned
    (by
      intro arg hMem
      exact SourceScope.exprScoped_sourceOwned (hScoped arg hMem))

theorem argExprs_scoped_of_scoped {env : List Name} :
    ∀ {args : List (Expr 1)},
      (∀ arg, arg ∈ args → Functions.Scope.ExprScoped env arg) →
        Scope.ExprSeqScoped env (Lower.argExprs args)
  | [], _hScoped => by
      simp [Lower.argExprs, Scope.ExprSeqScoped]
  | arg :: rest, hScoped => by
      have hHead : Functions.Scope.ExprScoped env arg :=
        hScoped arg (by simp)
      have hTail :
          Scope.ExprSeqScoped env (Lower.argExprs rest) :=
        argExprs_scoped_of_scoped (args := rest)
          (by
            intro restArg hMem
            exact hScoped restArg (by simp [hMem]))
      rw [Lower.argExprs]
      rw [ExprSeq.scoped_mpr (by simp [Nat.add_comm]) env
        (Locals.ExprSeq.cons arg (Lower.argExprs rest))]
      simp [Scope.ExprSeqScoped, hHead, hTail]

theorem length_le_argExprsWidth :
    ∀ {args : List (Expr 1)},
      args.length ≤ Access.exprSeqWidth (Lower.argExprs args)
  | args => Access.exprSeq_results_le_width (Lower.argExprs args)

theorem evalArgs_of_eval_sourceOwned {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {layout : List Name} {ctx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {args : List (Expr 1)} {source sourceAfterArgs : Source.State}
    {argValues : List Word} {target : Locals.RunState}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned :
      Locals.Source.ExprSeq.SourceOwned (Lower.argExprs args))
    (hAccess :
      Locals.SourceLowering.ExprSeq.Accessible layout 0
        (Lower.argExprs args))
    (hRel : StateRel layout hiddenReturns source target)
    (hEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues)) :
    ∃ targetAfterArgs,
      Direct.evalArgs ctx args target = .ok targetAfterArgs ∧
        PrefixedStateRel layout hiddenReturns sourceAfterArgs
          argValues.reverse targetAfterArgs := by
  cases args with
  | nil =>
      simp [Source.ArgList.eval] at hEval
      rcases hEval with ⟨rfl, rfl⟩
      refine ⟨target, ?_, ?_⟩
      · simp [Direct.evalArgs]
      · simpa using PrefixedStateRel.of_stateRel hRel
  | cons arg rest =>
      have hExprEval :
          Locals.Source.Expr.ExprSeq.eval prim
              (Lower.argExprs (arg :: rest)) source =
            .ok (sourceAfterArgs, argValues) :=
        ArgList.eval_argExprs hEval
      rcases hRel with ⟨hLowerRel, hReturns⟩
      rcases
        Locals.SourceLowering.Expr.runSeqCode_of_eval_sourceOwned hPrim
          (layout := layout) (ctx := ctx) (offset := 0)
          (source := source) (source' := sourceAfterArgs)
          (values := argValues) (evm := target.evm)
          (stackPrefix := [])
          hCtxLayout hNoDup hOwned hAccess rfl
          (Locals.SourceLowering.StackPrefixRel.of_stateRel hLowerRel)
          hExprEval with
        ⟨evmAfterArgs, hRunArgs, hPrefixRel⟩
      let targetAfterArgs := target.withEVM evmAfterArgs
      refine ⟨targetAfterArgs, ?_, ?_⟩
      · simp [Direct.evalArgs, hRunArgs, targetAfterArgs]
      · rcases hPrefixRel with
          ⟨hShared, baseStack, hStack, hStackRel⟩
        refine ⟨?_, baseStack, ?_, hStackRel, ?_⟩
        · simpa [targetAfterArgs, Structured.RunState.withEVM] using hShared
        · simpa [targetAfterArgs, Structured.RunState.withEVM] using hStack
        · simpa [targetAfterArgs, Structured.RunState.withEVM] using hReturns

theorem evalArgs_callerStateRel_of_eval_sourceOwned
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {layout : List Name} {ctx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {args : List (Expr 1)} {source sourceAfterArgs : Source.State}
    {argValues : List Word} {target : Locals.RunState}
    (sharedAfterCall : EvmYul.SharedState .EVM)
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned :
      Locals.Source.ExprSeq.SourceOwned (Lower.argExprs args))
    (hAccess :
      Locals.SourceLowering.ExprSeq.Accessible layout 0
        (Lower.argExprs args))
    (hRel : StateRel layout hiddenReturns source target)
    (hEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues)) :
    ∃ targetAfterArgs callerBase,
      Direct.evalArgs ctx args target = .ok targetAfterArgs ∧
        targetAfterArgs.evm.stack =
          argValues.reverse ++ callerBase.evm.stack ∧
        StateRel layout hiddenReturns
          (sourceAfterArgs.withShared sharedAfterCall) callerBase := by
  rcases evalArgs_of_eval_sourceOwned hPrim hCtxLayout hNoDup hOwned hAccess
      hRel hEval with
    ⟨targetAfterArgs, hRunArgs, hPrefixRel⟩
  rcases PrefixedStateRel.callerStateRel_withShared hPrefixRel
      sharedAfterCall with
    ⟨callerBase, hArgStack, hBaseRel⟩
  exact ⟨targetAfterArgs, callerBase, hRunArgs, hArgStack, hBaseRel⟩

end ArgList

structure CallPrelude (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (sourceAfterArgs : Source.State)
    (sharedAfterCall : EvmYul.SharedState .EVM)
    (argValues : List Word)
    (targetCtx : Locals.Ctx)
    (args : List (Expr 1))
    (target targetAfterArgs callerBase : Locals.RunState) : Prop where
  targetArgs :
    Direct.evalArgs targetCtx args target = .ok targetAfterArgs
  argStack :
    targetAfterArgs.evm.stack = argValues.reverse ++ callerBase.evm.stack
  prefixRel :
    PrefixedStateRel layout hiddenReturns sourceAfterArgs argValues.reverse
      targetAfterArgs
  baseRel :
    StateRel layout hiddenReturns
      (sourceAfterArgs.withShared sharedAfterCall) callerBase

namespace CallPrelude

theorem callerBase_stack_length {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceAfterArgs : Source.State}
    {sharedAfterCall : EvmYul.SharedState .EVM}
    {argValues : List Word}
    {targetCtx : Locals.Ctx}
    {args : List (Expr 1)}
    {target targetAfterArgs callerBase : Locals.RunState}
    (prelude :
      CallPrelude layout hiddenReturns sourceAfterArgs sharedAfterCall
        argValues targetCtx args target targetAfterArgs callerBase) :
    callerBase.evm.stack.length = layout.length := by
  rcases prelude.baseRel with ⟨hLowerRel, _hReturns⟩
  rcases hLowerRel with ⟨_hShared, hStackRel⟩
  exact hStackRel.1

theorem argCallerBound_of_access_insertMany_eval
    {prim : Source.PrimitiveSemantics}
    {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterArgs : Source.State}
    {sharedAfterCall : EvmYul.SharedState .EVM}
    {argValues : List Word}
    {targetCtx : Locals.Ctx}
    {args : List (Expr 1)}
    {target targetAfterArgs callerBase : Locals.RunState}
    {fn : FunDef} {paramStore : Source.Store}
    (prelude :
      CallPrelude layout hiddenReturns sourceAfterArgs sharedAfterCall
        argValues targetCtx args target targetAfterArgs callerBase)
    (hAccessBound :
      layout.length + Access.exprSeqWidth (Lower.argExprs args) ≤ 16)
    (hEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues))
    (hParams :
      Source.Store.insertMany fn.params argValues
          Locals.Source.Store.empty =
        some paramStore) :
    fn.params.length + callerBase.evm.stack.length ≤ 16 := by
  have hValuesArgs :
      argValues.length = args.length :=
    Source.ArgList.eval_length prim hEval
  have hValuesParams :
      argValues.length = fn.params.length :=
    Source.Store.insertMany_length hParams
  have hParamsWidth :
      fn.params.length ≤ Access.exprSeqWidth (Lower.argExprs args) := by
    rw [← hValuesParams, hValuesArgs]
    exact ArgList.length_le_argExprsWidth (args := args)
  have hCallerLen := prelude.callerBase_stack_length
  omega

theorem exists_of_eval_sourceOwned {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {layout : List Name} {ctx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {args : List (Expr 1)} {source sourceAfterArgs : Source.State}
    {argValues : List Word} {target : Locals.RunState}
    {sharedAfterCall : EvmYul.SharedState .EVM}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned :
      Locals.Source.ExprSeq.SourceOwned (Lower.argExprs args))
    (hAccess :
      Locals.SourceLowering.ExprSeq.Accessible layout 0
        (Lower.argExprs args))
    (hRel : StateRel layout hiddenReturns source target)
    (hEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues)) :
    ∃ targetAfterArgs callerBase,
      CallPrelude layout hiddenReturns sourceAfterArgs sharedAfterCall
        argValues ctx args target targetAfterArgs callerBase := by
  rcases ArgList.evalArgs_of_eval_sourceOwned hPrim hCtxLayout hNoDup hOwned
      hAccess hRel hEval with
    ⟨targetAfterArgs, hTargetArgs, hPrefixRel⟩
  rcases PrefixedStateRel.callerStateRel_withShared hPrefixRel
      sharedAfterCall with
    ⟨callerBase, hArgStack, hBaseRel⟩
  exact
    ⟨targetAfterArgs, callerBase,
      ⟨hTargetArgs, hArgStack, hPrefixRel, hBaseRel⟩⟩

theorem exists_of_eval_scoped {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {env layout : List Name} {ctx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {args : List (Expr 1)} {source sourceAfterArgs : Source.State}
    {argValues : List Word} {target : Locals.RunState}
    {sharedAfterCall : EvmYul.SharedState .EVM}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hScopedArgs :
      ∀ arg, arg ∈ args → Functions.Scope.ExprScoped env arg)
    (hAccess :
      Locals.SourceLowering.ExprSeq.Accessible layout 0
        (Lower.argExprs args))
    (hRel : StateRel layout hiddenReturns source target)
    (hEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues)) :
    ∃ targetAfterArgs callerBase,
      CallPrelude layout hiddenReturns sourceAfterArgs sharedAfterCall
        argValues ctx args target targetAfterArgs callerBase :=
  exists_of_eval_sourceOwned hPrim hCtxLayout hNoDup
    (ArgList.argExprs_sourceOwned_of_scoped hScopedArgs)
    hAccess hRel hEval

theorem exists_of_eval_stmt_scoped {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {source sourceAfterArgs : Source.State}
    {argValues : List Word} {target : Locals.RunState}
    {sharedAfterCall : EvmYul.SharedState .EVM} {retc : Nat}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hScoped :
      Scope.Stmt.Scoped sourceCtx.scope (.call targets functionName args))
    (hAccessBound :
      targetCtx.layout.length + Access.exprSeqWidth (Lower.argExprs args) ≤
        16)
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hEval :
      Source.ArgList.eval prim args source =
        .ok (sourceAfterArgs, argValues)) :
    ∃ targetAfterArgs callerBase,
      CallPrelude targetCtx.layout hiddenReturns sourceAfterArgs
        sharedAfterCall argValues targetCtx args target targetAfterArgs
        callerBase :=
  exists_of_eval_scoped hPrim rfl hNoDup
    hScoped.2.2
    (CtxRel.exprSeq_accessible_of_scoped hCtx
      (ArgList.argExprs_scoped_of_scoped hScoped.2.2)
      (by simpa using hAccessBound))
    hRel hEval

end CallPrelude

def ExprResultRel (layout : List Name)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) (values : List Word)
    (target : Locals.RunState) : Prop :=
  Locals.SourceLowering.ExprResultRel layout source values target ∧
    target.returns = hiddenReturns

namespace ExprResultRel

theorem to_stateRel_cons_insert {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState} {name : Name}
    {value : Word}
    (hFresh : name ∉ layout)
    (hRel : ExprResultRel layout hiddenReturns source [value] target) :
    StateRel (name :: layout) hiddenReturns (source.insert name value)
      target := by
  rcases hRel with ⟨hExprRel, hReturns⟩
  exact
    ⟨Locals.SourceLowering.ExprResultRel.to_stateRel_cons_insert
        hFresh hExprRel,
      hReturns⟩

theorem of_stateRel_stack_prefix {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {base target : Locals.RunState}
    {values : List Word}
    (hRel : StateRel layout hiddenReturns source base)
    (hShared : target.evm.toSharedState = source.shared)
    (hStack : target.evm.stack = values ++ base.evm.stack)
    (hReturns : target.returns = hiddenReturns) :
    ExprResultRel layout hiddenReturns source values target := by
  rcases hRel with ⟨⟨_hBaseShared, hStackRel⟩, _hBaseReturns⟩
  exact ⟨⟨hShared, base.evm.stack, hStack, hStackRel⟩, hReturns⟩

theorem to_stateRel_nil {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hRel : ExprResultRel layout hiddenReturns source [] target) :
    StateRel layout hiddenReturns source target := by
  rcases hRel with ⟨hExprRel, hReturns⟩
  rcases hExprRel with ⟨hShared, baseStack, hStack, hStackRel⟩
  exact ⟨⟨hShared, by simpa [hStack] using hStackRel⟩, hReturns⟩

end ExprResultRel

namespace Expr

theorem lit_bridge {prim : Source.PrimitiveSemantics}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {ctx : Locals.Ctx} {value : Word}
    (hRel : StateRel layout hiddenReturns source target) :
    Source.Expr.eval prim (Locals.Expr.lit value) source =
      .ok (source, [value]) ∧
      ∃ evm,
        Locals.Direct.Expr.runCode ctx 0 (Locals.Expr.lit value) target.evm =
          .ok evm ∧
          ExprResultRel layout hiddenReturns source [value]
            (target.withEVM evm) := by
  rcases hRel with ⟨hStateRel, hReturns⟩
  rcases
      Locals.SourceLowering.Expr.lit_bridge
        (prim := prim) (layout := layout) (source := source)
        (target := target) (ctx := ctx) (value := value) hStateRel with
    ⟨hSource, evm, hTarget, hExprRel⟩
  refine ⟨hSource, evm, hTarget, ?_⟩
  exact ⟨hExprRel, by simpa [Structured.RunState.withEVM] using hReturns⟩

theorem var_bridge {prim : Source.PrimitiveSemantics}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {ctx : Locals.Ctx} {name : Name} {idx : Nat}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hBound : idx + 1 ≤ 16)
    (hRel : StateRel layout hiddenReturns source target) :
    ∃ value evm,
      Source.Expr.eval prim (Locals.Expr.var name) source =
        .ok (source, [value]) ∧
        Locals.Direct.Expr.runCode ctx 0 (Locals.Expr.var name) target.evm =
          .ok evm ∧
          ExprResultRel layout hiddenReturns source [value]
            (target.withEVM evm) := by
  rcases hRel with ⟨hStateRel, hReturns⟩
  rcases
      Locals.SourceLowering.Expr.var_bridge
        (prim := prim) (layout := layout) (source := source)
        (target := target) (ctx := ctx) (name := name) (idx := idx)
        hCtxLayout hNoDup hName hBound hStateRel with
    ⟨value, evm, hSource, hTarget, hExprRel⟩
  refine ⟨value, evm, hSource, hTarget, ?_⟩
  exact ⟨hExprRel, by simpa [Structured.RunState.withEVM] using hReturns⟩

theorem eval_bridge_sourceOwned {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {results : Nat} {expr : Expr results}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source source' : Source.State} {values : List Word}
    {target : Locals.RunState} {ctx : Locals.Ctx}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel : StateRel layout hiddenReturns source target)
    (hEval : Source.Expr.eval prim expr source = .ok (source', values)) :
    ∃ evm,
      Locals.Direct.Expr.runCode ctx 0 expr target.evm = .ok evm ∧
        ExprResultRel layout hiddenReturns source' values.reverse
          (target.withEVM evm) := by
  rcases hRel with ⟨hLowerRel, hReturns⟩
  rcases
    Locals.SourceLowering.Expr.runCode_of_eval_sourceOwned hPrim
      (layout := layout) (ctx := ctx) (offset := 0)
      (source := source) (source' := source') (values := values)
      (evm := target.evm) (stackPrefix := [])
      hCtxLayout hNoDup hOwned hAccess rfl
      (Locals.SourceLowering.StackPrefixRel.of_stateRel hLowerRel)
      hEval with
    ⟨evm, hRun, hPrefixRel⟩
  rcases hPrefixRel with ⟨hShared, baseStack, hStack, hStackRel⟩
  refine ⟨evm, hRun, ?_⟩
  constructor
  · exact ⟨by simpa [Structured.RunState.withEVM] using hShared,
      baseStack,
      by simpa [Structured.RunState.withEVM] using hStack,
      hStackRel⟩
  · simpa [Structured.RunState.withEVM] using hReturns

theorem evalOne_bridge_sourceOwned {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {expr : Expr 1}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source source' : Source.State} {value : Word}
    {target : Locals.RunState} {ctx : Locals.Ctx}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel : StateRel layout hiddenReturns source target)
    (hEvalOne : Source.Expr.evalOne prim expr source = .ok (source', value)) :
    ∃ evm,
      Locals.Direct.Expr.runCode ctx 0 expr target.evm = .ok evm ∧
        ExprResultRel layout hiddenReturns source' [value]
          (target.withEVM evm) := by
  have hEval := Expr.eval_of_evalOne hEvalOne
  rcases eval_bridge_sourceOwned hPrim hCtxLayout hNoDup hOwned hAccess hRel
      hEval with
    ⟨evm, hRun, hExprRel⟩
  exact ⟨evm, hRun, by simpa using hExprRel⟩

theorem evalCondition_bridge_sourceOwned {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {expr : Expr 1}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source source' : Source.State} {value : Word}
    {target : Locals.RunState} {ctx : Locals.Ctx}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel : StateRel layout hiddenReturns source target)
    (hEvalOne : Source.Expr.evalOne prim expr source = .ok (source', value)) :
    ∃ target',
      Source.Expr.evalCondition prim expr source =
        .ok (source', value != EvmYul.UInt256.ofNat 0) ∧
      Locals.Direct.Expr.runCondition ctx expr target =
        .ok (target', value != EvmYul.UInt256.ofNat 0) ∧
      StateRel layout hiddenReturns source' target' := by
  rcases evalOne_bridge_sourceOwned hPrim hCtxLayout hNoDup hOwned hAccess
      hRel hEvalOne with
    ⟨evmAfterExpr, hRunExpr, hExprRel⟩
  rcases hExprRel with ⟨⟨hShared, baseStack, hStack, hStackRel⟩, hReturns⟩
  have hStackEVM : evmAfterExpr.stack = [value] ++ baseStack := by
    simpa [Structured.RunState.withEVM] using hStack
  let evmAfterPop : EVMState := { evmAfterExpr with stack := baseStack }
  let target' : Locals.RunState := target.withEVM evmAfterPop
  refine ⟨target', ?hSource, ?hTarget, ?hRel⟩
  · simp [Source.Expr.evalCondition, Locals.Source.Expr.evalCondition,
      hEvalOne]
  · simp [Locals.Direct.Expr.runCondition, hRunExpr,
      Structured.Code.popCondition, hStackEVM, EvmYul.Stack.pop, target',
      evmAfterPop]
  · exact
      ⟨⟨by simpa [target', evmAfterPop, Structured.RunState.withEVM]
            using hShared,
          by simpa [target', evmAfterPop, Structured.RunState.withEVM]
            using hStackRel⟩,
        by simpa [target', Structured.RunState.withEVM] using hReturns⟩

theorem evalOne_pop_bridge_sourceOwned {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {expr : Expr 1}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {source source' : Source.State} {value : Word}
    {target : Locals.RunState} {ctx : Locals.Ctx}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess : Locals.SourceLowering.Expr.Accessible layout 0 expr)
    (hRel : StateRel layout hiddenReturns source target)
    (hEvalOne : Source.Expr.evalOne prim expr source = .ok (source', value)) :
    ∃ targetAfterExpr targetAfterPop stackAfterPop,
      Locals.Direct.Expr.runState ctx expr target = .ok targetAfterExpr ∧
      targetAfterExpr.evm.stack.pop = some (stackAfterPop, value) ∧
      targetAfterPop =
        targetAfterExpr.withEVM
          { targetAfterExpr.evm with stack := stackAfterPop } ∧
      StateRel layout hiddenReturns source' targetAfterPop := by
  rcases evalOne_bridge_sourceOwned hPrim hCtxLayout hNoDup hOwned hAccess
      hRel hEvalOne with
    ⟨evmAfterExpr, hRunExpr, hExprRel⟩
  rcases hExprRel with ⟨⟨hShared, baseStack, hStack, hStackRel⟩, hReturns⟩
  have hStackEVM : evmAfterExpr.stack = [value] ++ baseStack := by
    simpa [Structured.RunState.withEVM] using hStack
  let targetAfterExpr : Locals.RunState := target.withEVM evmAfterExpr
  let targetAfterPop : Locals.RunState :=
    targetAfterExpr.withEVM { targetAfterExpr.evm with stack := baseStack }
  refine ⟨targetAfterExpr, targetAfterPop, baseStack, ?hRunState, ?hPop,
    rfl, ?hRel⟩
  · simp [Locals.Direct.Expr.runState, hRunExpr, targetAfterExpr]
  · simp [targetAfterExpr, hStackEVM, EvmYul.Stack.pop]
  · exact
      ⟨⟨by simpa [targetAfterPop, targetAfterExpr,
              Structured.RunState.withEVM] using hShared,
          by simpa [targetAfterPop, targetAfterExpr,
              Structured.RunState.withEVM] using hStackRel⟩,
        by simpa [targetAfterPop, targetAfterExpr,
          Structured.RunState.withEVM] using hReturns⟩

end Expr

namespace Switch

theorem source_select_eq (scrutinee : Word)
    (cases : List (Word × Block)) (defaultBody : Option Block) :
    Source.Switch.select scrutinee cases defaultBody =
      EvmCompiler.Functions.Switch.select scrutinee cases defaultBody := by
  induction cases with
  | nil =>
      cases defaultBody <;> rfl
  | cons head rest ih =>
      rcases head with ⟨value, body⟩
      by_cases hEq : value = scrutinee
      · simp [Source.Switch.select, EvmCompiler.Functions.Switch.select, hEq]
      · simp [Source.Switch.select, EvmCompiler.Functions.Switch.select, hEq,
          ih]

end Switch

def ReturnValuesRel (layout : List Name) (source : Source.State)
    (target : Locals.RunState) (returns : List Name) (values : List Word) :
    Prop :=
  Source.Store.lookupMany returns source.vars = some values ∧
    Locals.ExprSeq.VarSlotValuesAt layout target.evm.stack 0
      (Lower.returnExprs returns) values

namespace ReturnValuesRel

def Accessible (layout : List Name) : Nat → List Name → Prop
  | _offset, [] => True
  | offset, name :: rest =>
      (∃ idx, layout[idx]? = some name ∧ offset + idx + 1 ≤ 16) ∧
        Accessible layout (offset + 1) rest

theorem accessible_of_ctxRel {retc offset : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {returns : List Name}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hContains : ∀ name, name ∈ returns → name ∈ sourceCtx.scope)
    (hBound :
      offset + returns.length + targetCtx.layout.length ≤ 16) :
    Accessible targetCtx.layout offset returns := by
  induction returns generalizing offset with
  | nil =>
      simp [Accessible]
  | cons name rest ih =>
      have hNameSource : name ∈ sourceCtx.scope :=
        hContains name (by simp)
      rcases hCtx with
        ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc, _hBreakScope,
          _hContinueScope⟩
      have hNameTarget : name ∈ targetCtx.layout :=
        (hScope.2 name).mpr hNameSource
      rcases List.mem_iff_getElem?.mp hNameTarget with ⟨idx, hGet⟩
      have hIdxLt : idx < targetCtx.layout.length := by
        rcases List.getElem?_eq_some_iff.mp hGet with ⟨hLt, _hEq⟩
        exact hLt
      refine ⟨⟨idx, hGet, ?_⟩, ?_⟩
      · simp at hBound
        omega
      · have hTailContains :
            ∀ tailName, tailName ∈ rest → tailName ∈ sourceCtx.scope := by
          intro tailName hTail
          exact hContains tailName (by simp [hTail])
        exact ih (offset := offset + 1) hTailContains (by
          simp at hBound ⊢
          omega)

theorem safe_of_ctxRel {retc : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {returns : List Name}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hContains : ∀ name, name ∈ returns → name ∈ sourceCtx.scope)
    (hBound : returns.length + sourceCtx.scope.length ≤ 16) :
    targetCtx.layout.Nodup ∧
      Accessible targetCtx.layout 0 returns := by
  have hTargetNoDup : targetCtx.layout.Nodup :=
    CtxRel.layout_nodup hCtx hSourceNoDup
  have hTargetBound :
      0 + returns.length + targetCtx.layout.length ≤ 16 := by
    rcases hCtx with ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc,
      _hBreakScope, _hContinueScope⟩
    rw [hScope.1]
    omega
  exact
    ⟨hTargetNoDup,
      accessible_of_ctxRel hCtx hContains hTargetBound⟩

theorem lookupMany_length {store : Source.Store} :
    ∀ {names : List Name} {values : List Word},
      Source.Store.lookupMany names store = some values →
      values.length = names.length
  | [], values, hLookup => by
      simp [Source.Store.lookupMany] at hLookup
      cases hLookup
      simp
  | name :: rest, values, hLookup => by
      unfold Source.Store.lookupMany at hLookup
      cases hName : store name with
      | none =>
          simp [hName] at hLookup
      | some value =>
          cases hTail : Source.Store.lookupMany rest store with
          | none =>
              simp [hName, hTail] at hLookup
          | some tailValues =>
              simp [hName, hTail] at hLookup
              cases hLookup
              have hTailLength :=
                lookupMany_length (store := store) (names := rest)
                  (values := tailValues) hTail
              simp [hTailLength]

theorem values_length {layout : List Name} {source : Source.State}
    {target : Locals.RunState} {returns : List Name} {values : List Word}
    (hRel : ReturnValuesRel layout source target returns values) :
    values.length = returns.length :=
  lookupMany_length (store := source.vars) (names := returns)
    (values := values)
    hRel.1

theorem lookupMany_exists_of_accessible
    {layout : List Name} {store : Source.Store}
    {stack : EvmYul.Stack Word} :
    ∀ {returns : List Name} {offset : Nat},
      Accessible layout offset returns →
      Locals.SourceLowering.StackStoreRel layout store stack →
        ∃ values, Source.Store.lookupMany returns store = some values
  | [], _offset, _hAccess, _hRel => by
      exact ⟨[], by simp [Source.Store.lookupMany]⟩
  | name :: rest, offset, hAccess, hRel => by
      rcases hAccess with ⟨⟨idx, hName, _hBound⟩, hTailAccess⟩
      rcases Locals.SourceLowering.StackStoreRel.lookup_value hRel hName with
        ⟨value, _hStack, hStore⟩
      rcases lookupMany_exists_of_accessible hTailAccess hRel with
        ⟨tailValues, hTail⟩
      exact ⟨value :: tailValues, by
        simp [Source.Store.lookupMany, hStore, hTail]⟩

theorem varSlotValuesAt_returnExprs_of_lookupMany_accessible
    {layout : List Name} {store : Source.Store} {stack : EvmYul.Stack Word} :
    ∀ {returns : List Name} {values : List Word} {offset : Nat},
      Accessible layout offset returns →
      Source.Store.lookupMany returns store = some values →
      Locals.SourceLowering.StackStoreRel layout store stack →
        Locals.ExprSeq.VarSlotValuesAt layout stack offset
          (Lower.returnExprs returns) values
  | [], values, offset, _hAccess, hLookup, _hRel => by
      simp [Source.Store.lookupMany] at hLookup
      cases hLookup
      simp [Lower.returnExprs, Locals.ExprSeq.VarSlotValuesAt.nil]
  | name :: rest, values, offset, hAccess, hLookup, hRel => by
      rcases hAccess with ⟨⟨idx, hName, hBound⟩, hTailAccess⟩
      unfold Source.Store.lookupMany at hLookup
      cases hStore : store name with
      | none =>
          simp [hStore] at hLookup
      | some value =>
          cases hTail : Source.Store.lookupMany rest store with
          | none =>
              simp [hStore, hTail] at hLookup
          | some tailValues =>
              simp [hStore, hTail] at hLookup
              cases hLookup
              have hStack : stack[idx]? = some value := by
                simpa [hStore] using hRel.2 hName
              have hTailSlots :
                  Locals.ExprSeq.VarSlotValuesAt layout stack (offset + 1)
                    (Lower.returnExprs rest) tailValues :=
                varSlotValuesAt_returnExprs_of_lookupMany_accessible
                  hTailAccess hTail hRel
              let consExpr : Locals.ExprSeq (1 + rest.length) :=
                Locals.ExprSeq.cons (left := 1) (right := rest.length)
                  (.var name) (Lower.returnExprs rest)
              have hCons :
                  Locals.ExprSeq.VarSlotValuesAt layout stack offset
                    consExpr (value :: tailValues) :=
                Locals.ExprSeq.VarSlotValuesAt.cons_var
                  hName hStack hBound hTailSlots
              change
                Locals.ExprSeq.VarSlotValuesAt layout stack offset
                  (Eq.mp
                    (congrArg Locals.ExprSeq
                      (by omega : 1 + rest.length = rest.length + 1))
                    consExpr)
                  (value :: tailValues)
              exact
                (ExprSeq.varSlotValuesAt_mp
                  (by omega : 1 + rest.length = rest.length + 1)
                  layout stack offset consExpr (value :: tailValues)).mpr hCons

theorem of_stateRel_lookupMany_accessible {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {returns : List Name} {values : List Word}
    (hAccess : Accessible layout 0 returns)
    (hLookup : Source.Store.lookupMany returns source.vars = some values)
    (hRel : StateRel layout hiddenReturns source target) :
    ReturnValuesRel layout source target returns values := by
  rcases hRel with ⟨⟨_hShared, hStackRel⟩, _hReturns⟩
  exact
    ⟨hLookup,
      varSlotValuesAt_returnExprs_of_lookupMany_accessible
        hAccess hLookup hStackRel⟩

theorem exists_of_stateRel_accessible {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {returns : List Name}
    (hAccess : Accessible layout 0 returns)
    (hRel : StateRel layout hiddenReturns source target) :
    ∃ values, ReturnValuesRel layout source target returns values := by
  rcases hRel with ⟨⟨hShared, hStackRel⟩, hReturns⟩
  rcases lookupMany_exists_of_accessible hAccess hStackRel with
    ⟨values, hLookup⟩
  exact
    ⟨values,
      of_stateRel_lookupMany_accessible hAccess hLookup
        ⟨⟨hShared, hStackRel⟩, hReturns⟩⟩

theorem pushReturns {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {ctx : Locals.Ctx} {returns : List Name} {values : List Word}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hStateRel : StateRel layout hiddenReturns source target)
    (hValues : ReturnValuesRel layout source target returns values) :
    ∃ targetAfter,
      Source.Store.lookupMany returns source.vars = some values ∧
      Direct.pushReturns ctx returns target = .ok targetAfter ∧
      targetAfter.evm.stack = values.reverse ++ target.evm.stack ∧
      targetAfter.evm.toSharedState = target.evm.toSharedState ∧
      targetAfter.returns = hiddenReturns := by
  rcases hStateRel with ⟨_hLowerRel, hReturns⟩
  rcases hValues with ⟨hLookup, hSlots⟩
  cases returns with
  | nil =>
      simp [Source.Store.lookupMany] at hLookup
      cases hLookup
      refine ⟨target, rfl, ?_, ?_, rfl, hReturns⟩
      · simp [Direct.pushReturns]
      · simp
  | cons name rest =>
      rcases
        Locals.Direct.Expr.ExprSeq.runCode_of_varSlotValuesAt
          ctx target.evm target.evm layout 0 []
          hCtxLayout hNoDup (by simp) (by simp) hSlots with
        ⟨evmAfterReturns, hRun, hStack, hShared⟩
      refine ⟨target.withEVM evmAfterReturns, hLookup, ?_, ?_, ?_, ?_⟩
      · simp [Direct.pushReturns, hRun]
      · simpa [Structured.RunState.withEVM] using hStack
      · simpa [Structured.RunState.withEVM] using hShared
      · simpa [Structured.RunState.withEVM] using hReturns

end ReturnValuesRel

namespace FrameBound

theorem leave_accessible {retc : Nat} {sourceCtx : Source.Ctx}
    {targetCtx : Locals.Ctx} {returns : List Name}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hReturnScope :
      ∀ name, name ∈ returns → name ∈ sourceCtx.scope)
    (hBound : Stmt returns sourceCtx.scope .leave) :
    ReturnValuesRel.Accessible targetCtx.layout 0 returns := by
  have hTargetBound :
      0 + returns.length + targetCtx.layout.length ≤ 16 := by
    rcases hCtx with ⟨hScope, _hBreak, _hContinue, _hLeave, _hRetc,
      _hBreakScope, _hContinueScope⟩
    simp [Stmt] at hBound
    rw [hScope.1]
    omega
  exact
    ReturnValuesRel.accessible_of_ctxRel hCtx hReturnScope hTargetBound

theorem funDef_regular_return_safe
    {prim : Source.PrimitiveSemantics}
    {program : Functions.Program} {fn : Functions.FunDef}
    {fuel : Nat} {sourceBody bodyState : Source.State}
    {sourceCtxOut : Source.Ctx} {targetCtxOut : Locals.Ctx}
    (hScoped : fn.Scoped)
    (hBound : FunDef fn)
    (hSourceOpen :
      Source.Block.runOpen prim program
          (SourceDirect.FunDef.sourceBodyCtx fn) fuel fn.body sourceBody =
        .ok (Source.Outcome.regular bodyState, sourceCtxOut))
    (hCtx : CtxRel fn.returns.length sourceCtxOut targetCtxOut) :
    targetCtxOut.layout.Nodup ∧
      ReturnValuesRel.Accessible targetCtxOut.layout 0 fn.returns := by
  have hScopeEq :
      sourceCtxOut.scope =
        Scope.Block.outEnv
          (SourceDirect.FunDef.sourceBodyCtx fn).scope fn.body :=
    SourceRun.block_runOpen_regular_scope hSourceOpen
  have hSignatureNoDup :
      (fn.returns ++ fn.params).Nodup :=
    Functions.FunDef.signatureNodup hScoped
  have hBodyOutNoDup :
      (Scope.Block.outEnv (fn.returns ++ fn.params) fn.body).Nodup :=
    SourceScope.block_outEnv_nodup
      (Functions.FunDef.bodyScoped hScoped) hSignatureNoDup
  have hSourceNoDup : sourceCtxOut.scope.Nodup := by
    rw [hScopeEq]
    simpa [SourceDirect.FunDef.sourceBodyCtx, Source.FunDef.bodyCtx,
      Source.Ctx.initial, Source.Ctx.withLeaveScope] using hBodyOutNoDup
  have hReturnsInSource :
      ∀ name, name ∈ fn.returns → name ∈ sourceCtxOut.scope := by
    intro name hMem
    rw [hScopeEq]
    have hInitial : name ∈ fn.returns ++ fn.params := by
      exact List.mem_append_left fn.params hMem
    simpa [SourceDirect.FunDef.sourceBodyCtx, Source.FunDef.bodyCtx,
      Source.Ctx.initial, Source.Ctx.withLeaveScope] using
      SourceScope.block_outEnv_contains_of_contains
        (block := fn.body) hInitial
  have hSourceBound :
      fn.returns.length + sourceCtxOut.scope.length ≤ 16 := by
    rw [hScopeEq]
    simpa [SourceDirect.FunDef.sourceBodyCtx, Source.FunDef.bodyCtx,
      Source.Ctx.initial, Source.Ctx.withLeaveScope] using
      funDef_regularReturnBound hBound
  exact
    ReturnValuesRel.safe_of_ctxRel hCtx hSourceNoDup hReturnsInSource
      hSourceBound

end FrameBound

def ReturnedStackRel (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) (values : List Word)
    (target : Locals.RunState) : Prop :=
  target.evm.toSharedState = source.shared ∧
    target.evm.stack = values.reverse ∧
    target.returns = hiddenReturns

namespace ReturnedStackRel

theorem popReturn_attach {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {values : List Word}
    {target : Locals.RunState} {frame : Structured.ReturnDest}
    (hRel : ReturnedStackRel (frame :: hiddenReturns) source values target)
    (hLen : values.length = frame.retc) :
    ∃ returned stateWithReturns,
      target.popReturn? = some (frame, returned) ∧
      Structured.StackFrame.attachReturns? frame target.evm.stack =
        some (values.reverse ++ frame.callerStack) ∧
      stateWithReturns =
        returned.withEVM
          { target.evm with stack := values.reverse ++ frame.callerStack } ∧
      stateWithReturns.evm.toSharedState = source.shared ∧
      stateWithReturns.evm.stack = values.reverse ++ frame.callerStack ∧
      stateWithReturns.returns = hiddenReturns := by
  rcases hRel with ⟨hShared, hStack, hReturns⟩
  cases frame with
  | mk callerStack retc =>
      simp at hLen
      cases target with
      | mk evm returns =>
          dsimp at hShared hStack hReturns ⊢
          subst returns
          let returned : Locals.RunState :=
            { evm := evm, returns := hiddenReturns }
          let stateWithReturns : Locals.RunState :=
            returned.withEVM
              { evm with stack := values.reverse ++ callerStack }
          refine ⟨returned, stateWithReturns, ?hPop, ?hAttach, rfl,
            ?hSharedFinal, ?hStackFinal, ?hReturnsFinal⟩
          · simp [Structured.RunState.popReturn?, returned]
          · simp [Structured.StackFrame.attachReturns?, hStack, hLen]
          · simpa [stateWithReturns, returned, Structured.RunState.withEVM]
              using hShared
          · simp [stateWithReturns, returned, Structured.RunState.withEVM]
          · simp [stateWithReturns, returned, Structured.RunState.withEVM]

end ReturnedStackRel

namespace ReturnValuesRel

theorem pushCleanup_returnedStack {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {ctx : Locals.Ctx} {returns : List Name} {values : List Word}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hReturnsLen : returns.length = ctx.leaveRetc)
    (hRetcBound : ctx.leaveRetc ≤ 16)
    (hValues : ReturnValuesRel layout source target returns values)
    (hRel : StateRel layout hiddenReturns source target) :
    ∃ stateAfterReturns targetAfter,
      Direct.pushReturns ctx returns target = .ok stateAfterReturns ∧
      Locals.Direct.Ctx.runCleanupToPreserving ctx ctx.leaveRetc 0
          stateAfterReturns =
        .ok targetAfter ∧
      ReturnedStackRel hiddenReturns source values targetAfter := by
  rcases hRel with ⟨hLowerRel, hHiddenEq⟩
  rcases hLowerRel with ⟨hSharedRel, hStackRel⟩
  have hValuesLen : values.length = returns.length :=
    ReturnValuesRel.values_length hValues
  have hPreserveLen : values.reverse.length = ctx.leaveRetc := by
    simp [hValuesLen, hReturnsLen]
  rcases ReturnValuesRel.pushReturns
      (layout := layout) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (ctx := ctx)
      (returns := returns) (values := values)
      hCtxLayout hNoDup ⟨⟨hSharedRel, hStackRel⟩, hHiddenEq⟩ hValues with
    ⟨stateAfterReturns, _hLookup, hPush, hPushStack, hPushShared,
      hPushReturns⟩
  rcases Cleanup.runCleanupToPreserving_exists
      (ctx := ctx) (preserve := ctx.leaveRetc) (targetDepth := 0)
      (state := stateAfterReturns) (preserved := values.reverse)
      (locals := target.evm.stack)
      (by omega) hPreserveLen hRetcBound hPushStack
      (by simpa [hCtxLayout] using hStackRel.1) with
    ⟨targetAfter, hCleanup, hCleanupStack, hCleanupShared,
      hCleanupReturns⟩
  have hDropAll : target.evm.stack.drop ctx.layout.length = [] := by
    apply List.drop_eq_nil_of_le
    have hLen : target.evm.stack.length = ctx.layout.length := by
      simpa [hCtxLayout] using hStackRel.1
    omega
  have hFinalStack : targetAfter.evm.stack = values.reverse := by
    simpa [Nat.sub_zero, hDropAll] using hCleanupStack
  have hFinalShared : targetAfter.evm.toSharedState = source.shared := by
    calc
      targetAfter.evm.toSharedState = stateAfterReturns.evm.toSharedState :=
        hCleanupShared
      _ = target.evm.toSharedState := hPushShared
      _ = source.shared := hSharedRel
  have hFinalReturns : targetAfter.returns = hiddenReturns :=
    hCleanupReturns.trans hPushReturns
  exact
    ⟨stateAfterReturns, targetAfter, hPush, hCleanup,
      hFinalShared, hFinalStack, hFinalReturns⟩

end ReturnValuesRel

namespace Assignment

private def dummyLocalsProgram : Locals.Program :=
  { body := { stmts := [] } }

theorem assignTopWithOffset_returns {ctx : Locals.Ctx}
    {state targetAfter : Locals.RunState} {offset : Nat} {name : Name}
    (hRun : Direct.assignTopWithOffset ctx offset name state = .ok targetAfter) :
    targetAfter.returns = state.returns := by
  unfold Direct.assignTopWithOffset at hRun
  cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
  | none =>
      simp [hDepth, Structured.invalid] at hRun
  | some depth =>
      simp [hDepth] at hRun
      cases hSwap : Locals.StackOp.swap? (offset + depth) with
      | none =>
          simp [hSwap, Structured.invalid] at hRun
      | some swapOp =>
          simp [hSwap] at hRun
          cases hSwapStep : swapOp.step state.evm with
          | error err =>
              simp [hSwapStep] at hRun
          | ok evmAfterSwap =>
              simp [hSwapStep] at hRun
              cases hPopStep :
                  Structured.BasicOp.pop.step evmAfterSwap with
              | error err =>
                  simp [hPopStep] at hRun
              | ok evmAfterPop =>
                  simp [hPopStep] at hRun
                  cases hRun
                  rfl

theorem evm_swap_assign_get?_with_prefix {state : EVMState}
    {stackPrefix locals : EvmYul.Stack Word} {idx : Nat} {old value : Word}
    (hStack : state.stack = value :: stackPrefix ++ locals)
    (hLocal : locals[idx]? = some old) :
    EvmYul.swap (stackPrefix.length + idx + 1) state =
      .ok (state.replaceStackAndIncrPC
        (old :: stackPrefix ++ locals.take idx ++ [value] ++
          locals.drop (idx + 1))) := by
  have hLocals :
      locals = locals.take idx ++ old :: locals.drop (idx + 1) :=
    Locals.StackLowering.list_eq_take_getElem?_drop hLocal
  have hLt : idx < locals.length := by
    rcases List.getElem?_eq_some_iff.mp hLocal with ⟨hLt, _hValue⟩
    exact hLt
  have hTakeLen : (locals.take idx).length = idx := by
    simp [List.length_take, Nat.min_eq_left (Nat.le_of_lt hLt)]
  have hStart :
      { state with
          stack := value :: (stackPrefix ++ locals.take idx) ++ [old] ++
            locals.drop (idx + 1) } = state := by
    cases state with
    | mk shared pc stack execLength =>
        dsimp at hStack ⊢
        subst stack
        simpa using hLocals.symm
  have hSwap :=
    Structured.Preservation.StackShuffle.swap_snoc
      (state := state) (front := stackPrefix ++ locals.take idx)
      (suffix := locals.drop (idx + 1)) (top := value) (last := old)
  rw [hStart] at hSwap
  simpa [hTakeLen, List.length_append, List.append_assoc, Nat.add_assoc,
    Nat.add_comm, Nat.add_left_comm] using hSwap

theorem assignTopWithOffset_prefixed {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {targetAfterExpr : Locals.RunState}
    {ctx : Locals.Ctx} {name : Name} {idx offset : Nat}
    {value : Word} {stackPrefix : List Word}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hOffset : offset = stackPrefix.length)
    (hBound : stackPrefix.length + idx + 1 ≤ 16)
    (hRel :
      PrefixedStateRel layout hiddenReturns source (value :: stackPrefix)
        targetAfterExpr) :
    ∃ targetAfter,
      Direct.assignTopWithOffset ctx offset name targetAfterExpr =
        .ok targetAfter ∧
      PrefixedStateRel layout hiddenReturns
        (source.withVars (Locals.Source.Store.insert source.vars name value))
        stackPrefix targetAfter := by
  rcases hRel with ⟨hShared, baseStack, hStack, hStackRel, hReturns⟩
  rcases Locals.SourceLowering.StackStoreRel.lookup_value hStackRel hName with
    ⟨old, hOld, _hOldStore⟩
  have hDepth :
      Locals.Layout.lookupDepth? name ctx.layout = some (idx + 1) := by
    simpa [hCtxLayout] using
      (Locals.Layout.lookupDepth?_of_get?_nodup hName hNoDup)
  rcases Locals.SourceLowering.Assignment.stackOp_swap?_step_eq_swap
      (n := stackPrefix.length + (idx + 1)) (by omega) (by omega)
      targetAfterExpr.evm with
    ⟨swapOp, hSwapOp, hSwapStep⟩
  let updatedBaseStack :=
    baseStack.take idx ++ value :: baseStack.drop (idx + 1)
  let swappedEVM :=
    targetAfterExpr.evm.replaceStackAndIncrPC
      (old :: stackPrefix ++ baseStack.take idx ++ [value] ++
        baseStack.drop (idx + 1))
  let finalEVM :=
    swappedEVM.replaceStackAndIncrPC (stackPrefix ++ updatedBaseStack)
  let targetAfter := targetAfterExpr.withEVM finalEVM
  refine ⟨targetAfter, ?hRun, ?hRelAfter⟩
  · have hStackForSwap :
        targetAfterExpr.evm.stack = value :: stackPrefix ++ baseStack := by
      simpa [List.cons_append, List.append_assoc] using hStack
    have hSwapRun :
        EvmYul.swap (stackPrefix.length + idx + 1) targetAfterExpr.evm =
          .ok swappedEVM := by
      simpa [swappedEVM, Nat.add_assoc] using
        (evm_swap_assign_get?_with_prefix
          (state := targetAfterExpr.evm) (stackPrefix := stackPrefix)
          (locals := baseStack) (idx := idx) (old := old)
          (value := value) hStackForSwap hOld)
    have hSwapRun' : swapOp.step targetAfterExpr.evm = .ok swappedEVM := by
      rw [hSwapStep]
      simpa [Nat.add_assoc] using hSwapRun
    have hPop :
        Structured.BasicOp.pop.step swappedEVM = .ok finalEVM := by
      simp [Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
        Assembly.Target.stepInstr, Assembly.PrimOp.step,
        Assembly.PrimStep.run, Assembly.PrimOp.continuingStep?,
        EvmYul.Stack.pop, swappedEVM, finalEVM, updatedBaseStack,
        EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC, List.append_assoc]
    simp [Direct.assignTopWithOffset, hDepth, hOffset, hSwapOp, hSwapRun',
      hPop, targetAfter, Structured.RunState.withEVM]
  · refine ⟨?hSharedAfter, updatedBaseStack, ?hStackAfter, ?hStackRelAfter,
      ?hReturnsAfter⟩
    · simpa [targetAfter, finalEVM, swappedEVM, Locals.Source.State.withVars,
        EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC] using hShared
    · simp [targetAfter, finalEVM, swappedEVM, updatedBaseStack,
        EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC]
    · exact
        Locals.SourceLowering.StackStoreRel.assign hNoDup hName hStackRel
    · simpa [targetAfter, finalEVM, swappedEVM,
        Structured.RunState.withEVM] using hReturns

theorem assignTop_of_localsAssignTop_run {ctx : Locals.Ctx}
    {state targetAfter : Locals.RunState} {name : Name} {fuel : Nat}
    (hRun :
      Locals.Direct.Stmt.run dummyLocalsProgram ctx fuel
          (.assignTop name) state =
        .ok (Structured.Outcome.regular targetAfter, ctx)) :
    Direct.assignTop ctx name state = .ok targetAfter := by
  simp [Locals.Direct.Stmt.run, dummyLocalsProgram] at hRun
  unfold Direct.assignTop
  cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
  | none =>
      simp [hDepth, Locals.invalid, Structured.invalid] at hRun ⊢
  | some depth =>
      simp [hDepth] at hRun ⊢
      cases hSwap : Locals.StackOp.swap? depth with
      | none =>
          simp [hSwap, Locals.invalid, Structured.invalid] at hRun ⊢
      | some swapOp =>
          simp [hSwap] at hRun ⊢
          cases hSwapStep : swapOp.step state.evm with
          | error err =>
              simp [hSwapStep] at hRun
          | ok evmAfterSwap =>
              simp [hSwapStep] at hRun ⊢
              cases hPopStep :
                  Structured.BasicOp.pop.step evmAfterSwap with
              | error err =>
                  simp [hPopStep] at hRun
              | ok evmAfterPop =>
                  simp [hPopStep] at hRun ⊢
                  cases hRun
                  rfl

theorem assignTop_returns {ctx : Locals.Ctx}
    {state targetAfter : Locals.RunState} {name : Name}
    (hRun : Direct.assignTop ctx name state = .ok targetAfter) :
    targetAfter.returns = state.returns := by
  unfold Direct.assignTop at hRun
  cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
  | none =>
      simp [hDepth, Structured.invalid] at hRun
  | some depth =>
      simp [hDepth] at hRun
      cases hSwap : Locals.StackOp.swap? depth with
      | none =>
          simp [hSwap, Structured.invalid] at hRun
      | some swapOp =>
          simp [hSwap] at hRun
          cases hSwapStep : swapOp.step state.evm with
          | error err =>
              simp [hSwapStep] at hRun
          | ok evmAfterSwap =>
              simp [hSwapStep] at hRun
              cases hPopStep :
                  Structured.BasicOp.pop.step evmAfterSwap with
              | error err =>
                  simp [hPopStep] at hRun
              | ok evmAfterPop =>
                  simp [hPopStep] at hRun
                  cases hRun
                  rfl

theorem assignTop_stateRel {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {targetAfterExpr : Locals.RunState}
    {ctx : Locals.Ctx} {fuel : Nat}
    {name : Name} {idx : Nat} {value : Word}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hBound : idx + 1 ≤ 16)
    (hExprRel :
      ExprResultRel layout hiddenReturns source [value] targetAfterExpr) :
    ∃ targetAfter,
      Direct.assignTop ctx name targetAfterExpr = .ok targetAfter ∧
      StateRel layout hiddenReturns
        (source.withVars (Locals.Source.Store.insert source.vars name value))
        targetAfter := by
  rcases hExprRel with ⟨hLowerExprRel, hReturns⟩
  rcases
      Locals.SourceLowering.Assignment.assignTop_stateRel
        (layout := layout) (source := source)
        (targetAfterExpr := targetAfterExpr) (ctx := ctx)
        (program := dummyLocalsProgram) (fuel := fuel)
        (name := name) (idx := idx) (value := value)
        hCtxLayout hNoDup hName hBound hLowerExprRel with
    ⟨targetAfter, hTargetRun, hLowerRel⟩
  have hAssignTop :
      Direct.assignTop ctx name targetAfterExpr = .ok targetAfter :=
    assignTop_of_localsAssignTop_run hTargetRun
  have hReturnsAfter : targetAfter.returns = hiddenReturns :=
    (assignTop_returns hAssignTop).trans hReturns
  exact ⟨targetAfter, hAssignTop, hLowerRel, hReturnsAfter⟩

theorem assignTop_stateRel_of_stack_prefix {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {base targetAfterExpr : Locals.RunState}
    {ctx : Locals.Ctx} {fuel : Nat}
    {name : Name} {idx : Nat} {value : Word}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hBound : idx + 1 ≤ 16)
    (hBaseRel : StateRel layout hiddenReturns source base)
    (hShared : targetAfterExpr.evm.toSharedState = source.shared)
    (hStack : targetAfterExpr.evm.stack = [value] ++ base.evm.stack)
    (hReturns : targetAfterExpr.returns = hiddenReturns) :
    ∃ targetAfter,
      Direct.assignTop ctx name targetAfterExpr = .ok targetAfter ∧
      StateRel layout hiddenReturns
        (source.withVars (Locals.Source.Store.insert source.vars name value))
        targetAfter := by
  exact
    assignTop_stateRel
      (layout := layout) (hiddenReturns := hiddenReturns)
      (source := source) (targetAfterExpr := targetAfterExpr)
      (ctx := ctx) (fuel := fuel) (name := name) (idx := idx)
      (value := value) hCtxLayout hNoDup hName hBound
      (ExprResultRel.of_stateRel_stack_prefix hBaseRel hShared hStack hReturns)

theorem assignReturnedTops_direct_order {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest} {ctx : Locals.Ctx} :
    ∀ {names : List Name} {values : List Word}
      {source : Source.State} {target : Locals.RunState}
      {store' : Source.Store},
      ctx.layout = layout →
      layout.Nodup →
      (∀ {name : Name}, name ∈ names →
        ∃ idx, layout[idx]? = some name ∧ names.length + idx ≤ 16) →
      Source.Store.assignMany names values source.vars = some store' →
      PrefixedStateRel layout hiddenReturns source values target →
        ∃ targetAfter,
          Direct.assignReturnedTops ctx names target = .ok targetAfter ∧
          StateRel layout hiddenReturns (source.withVars store') targetAfter
  | [], [], source, target, store', _hCtxLayout, _hNoDupLayout,
      _hTargets, hAssign, hRel => by
      simp [Source.Store.assignMany] at hAssign
      subst store'
      refine ⟨target, by simp [Direct.assignReturnedTops], ?_⟩
      simpa [Locals.Source.State.withVars] using
        PrefixedStateRel.to_stateRel_nil hRel
  | [], _value :: _values, _source, _target, _store', _hCtxLayout,
      _hNoDupLayout, _hTargets, hAssign, _hRel => by
      simp [Source.Store.assignMany] at hAssign
  | name :: rest, [], _source, _target, _store', _hCtxLayout,
      _hNoDupLayout, _hTargets, hAssign, _hRel => by
      simp [Source.Store.assignMany] at hAssign
  | name :: rest, value :: valuesTail, source, target, store',
      hCtxLayout, hNoDupLayout, hTargets, hAssign, hRel => by
      unfold Source.Store.assignMany at hAssign
      cases hContains : source.vars.contains name with
      | false =>
          simp [hContains] at hAssign
      | true =>
          simp [hContains] at hAssign
          have hTailLen : valuesTail.length = rest.length :=
            Source.Store.assignMany_length hAssign
          rcases hTargets (name := name) (by simp) with
            ⟨idx, hName, hHeadBound⟩
          have hBound : valuesTail.length + idx + 1 ≤ 16 := by
            have hHeadBound' : rest.length + idx + 1 ≤ 16 := by
              simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                hHeadBound
            simpa [hTailLen] using hHeadBound'
          rcases assignTopWithOffset_prefixed
              (layout := layout) (hiddenReturns := hiddenReturns)
              (source := source) (targetAfterExpr := target)
              (ctx := ctx) (name := name) (idx := idx)
              (offset := rest.length) (value := value)
              (stackPrefix := valuesTail)
              hCtxLayout hNoDupLayout hName hTailLen.symm hBound hRel with
            ⟨targetAfterHead, hHeadRun, hHeadRel⟩
          have hTargetsRest :
              ∀ {restName : Name}, restName ∈ rest →
                ∃ idx, layout[idx]? = some restName ∧
                  rest.length + idx ≤ 16 := by
            intro restName hMem
            rcases hTargets (name := restName) (by simp [hMem]) with
              ⟨idx, hLayout, hBoundAll⟩
            have hBoundAll' : rest.length + idx + 1 ≤ 16 := by
              simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                hBoundAll
            exact ⟨idx, hLayout, by omega⟩
          rcases assignReturnedTops_direct_order
              (layout := layout) (hiddenReturns := hiddenReturns)
              (ctx := ctx) (names := rest) (values := valuesTail)
              (source :=
                source.withVars
                  (Locals.Source.Store.insert source.vars name value))
              (target := targetAfterHead) (store' := store')
              hCtxLayout hNoDupLayout hTargetsRest hAssign hHeadRel with
            ⟨targetAfter, hTailRun, hTailRel⟩
          refine ⟨targetAfter, ?hRun, hTailRel⟩
          simp [Direct.assignReturnedTops, hHeadRun, hTailRun]

theorem assignReturnedTops_source_order {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {ctx : Locals.Ctx} {targets : List Name} {values : List Word}
    {store' : Source.Store}
    (hCtxLayout : ctx.layout = layout)
    (hNoDupLayout : layout.Nodup)
    (hTargetsNoDup : targets.Nodup)
    (hTargets :
      ∀ {name : Name}, name ∈ targets →
        ∃ idx, layout[idx]? = some name ∧ targets.length + idx ≤ 16)
    (hAssign :
      Source.Store.assignMany targets values source.vars = some store')
    (hRel :
      PrefixedStateRel layout hiddenReturns source values.reverse target) :
    ∃ targetAfter,
      Direct.assignReturnedTops ctx targets.reverse target = .ok targetAfter ∧
      StateRel layout hiddenReturns (source.withVars store') targetAfter := by
  have hAssignReverse :
      Source.Store.assignMany targets.reverse values.reverse source.vars =
        some store' :=
    Source.Store.assignMany_reverse_of_run hAssign hTargetsNoDup
  have hTargetsReverse :
      ∀ {name : Name}, name ∈ targets.reverse →
        ∃ idx, layout[idx]? = some name ∧
          targets.reverse.length + idx ≤ 16 := by
    intro name hMem
    rcases hTargets (name := name) (by simpa using hMem) with
      ⟨idx, hLayout, hBound⟩
    exact ⟨idx, hLayout, by simpa using hBound⟩
  exact
    assignReturnedTops_direct_order
      (layout := layout) (hiddenReturns := hiddenReturns) (ctx := ctx)
      (names := targets.reverse) (values := values.reverse)
      (source := source) (target := target) (store' := store')
      hCtxLayout hNoDupLayout hTargetsReverse hAssignReverse hRel

theorem assignReturnedTops_source_order_of_stateRel_stack_prefix
    {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {base target : Locals.RunState}
    {ctx : Locals.Ctx} {targets : List Name} {values : List Word}
    {store' : Source.Store}
    (hCtxLayout : ctx.layout = layout)
    (hNoDupLayout : layout.Nodup)
    (hTargetsNoDup : targets.Nodup)
    (hTargets :
      ∀ {name : Name}, name ∈ targets →
        ∃ idx, layout[idx]? = some name ∧ targets.length + idx ≤ 16)
    (hAssign :
      Source.Store.assignMany targets values source.vars = some store')
    (hBaseRel : StateRel layout hiddenReturns source base)
    (hShared : target.evm.toSharedState = source.shared)
    (hStack : target.evm.stack = values.reverse ++ base.evm.stack)
    (hReturns : target.returns = hiddenReturns) :
    ∃ targetAfter,
      Direct.assignReturnedTops ctx targets.reverse target =
        .ok targetAfter ∧
      StateRel layout hiddenReturns (source.withVars store') targetAfter := by
  exact
    assignReturnedTops_source_order
      (layout := layout) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (ctx := ctx)
      (targets := targets) (values := values) (store' := store')
      hCtxLayout hNoDupLayout hTargetsNoDup hTargets hAssign
      (PrefixedStateRel.of_stateRel_stack_prefix hBaseRel hShared hStack
        hReturns)

theorem assignReturnedTops_source_order_of_ctxRel_stack_prefix
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {base target : Locals.RunState}
    {targets : List Name} {values : List Word}
    {store' : Source.Store}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDupLayout : targetCtx.layout.Nodup)
    (hTargetsNoDup : targets.Nodup)
    (hContains : Scope.containsAll sourceCtx.scope targets)
    (hBound : targets.length + targetCtx.layout.length ≤ 16)
    (hAssign :
      Source.Store.assignMany targets values source.vars = some store')
    (hBaseRel : StateRel targetCtx.layout hiddenReturns source base)
    (hShared : target.evm.toSharedState = source.shared)
    (hStack : target.evm.stack = values.reverse ++ base.evm.stack)
    (hReturns : target.returns = hiddenReturns) :
    ∃ targetAfter,
      Direct.assignReturnedTops targetCtx targets.reverse target =
        .ok targetAfter ∧
      StateRel targetCtx.layout hiddenReturns (source.withVars store')
        targetAfter := by
  exact
    assignReturnedTops_source_order_of_stateRel_stack_prefix
      (layout := targetCtx.layout) (hiddenReturns := hiddenReturns)
      (source := source) (base := base) (target := target)
      (ctx := targetCtx) (targets := targets) (values := values)
      (store' := store') rfl hNoDupLayout hTargetsNoDup
      (CtxRel.assignmentTargets hCtx hContains hBound) hAssign hBaseRel
      hShared hStack hReturns

theorem finishReturnedCall_stateRel
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceAfterCall : Source.State} {base returnedTarget : Locals.RunState}
    {targets : List Name} {values : List Word} {returnStore : Source.Store}
    {frame : Structured.ReturnDest}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDupLayout : targetCtx.layout.Nodup)
    (hTargetsNoDup : targets.Nodup)
    (hContains : Scope.containsAll sourceCtx.scope targets)
    (hBound : targets.length + targetCtx.layout.length ≤ 16)
    (hAssign :
      Source.Store.assignMany targets values sourceAfterCall.vars =
        some returnStore)
    (hBaseRel :
      StateRel targetCtx.layout hiddenReturns sourceAfterCall base)
    (hReturned :
      ReturnedStackRel (frame :: hiddenReturns) sourceAfterCall values
        returnedTarget)
    (hFrameStack : frame.callerStack = base.evm.stack)
    (hFrameRetc : values.length = frame.retc) :
    ∃ returned stateWithReturns targetAfter,
      returnedTarget.popReturn? = some (frame, returned) ∧
      Structured.StackFrame.attachReturns? frame returnedTarget.evm.stack =
        some (values.reverse ++ base.evm.stack) ∧
      stateWithReturns =
        returned.withEVM
          { returnedTarget.evm with stack := values.reverse ++ base.evm.stack } ∧
      Direct.assignReturnedTops targetCtx targets.reverse stateWithReturns =
        .ok targetAfter ∧
      StateRel targetCtx.layout hiddenReturns
        (sourceAfterCall.withVars returnStore) targetAfter := by
  rcases ReturnedStackRel.popReturn_attach
      (hiddenReturns := hiddenReturns) (source := sourceAfterCall)
      (values := values) (target := returnedTarget) (frame := frame)
      hReturned hFrameRetc with
    ⟨returned, attachedState, hPop, hAttach, hAttachedEq, hAttachedShared,
      hAttachedStack, hAttachedReturns⟩
  let stateWithReturns :=
    returned.withEVM
      { returnedTarget.evm with stack := values.reverse ++ base.evm.stack }
  have hAttachBase :
      Structured.StackFrame.attachReturns? frame returnedTarget.evm.stack =
        some (values.reverse ++ base.evm.stack) := by
    simpa [hFrameStack] using hAttach
  have hStateWithReturnsEq : stateWithReturns = attachedState := by
    subst stateWithReturns
    simpa [hFrameStack] using hAttachedEq.symm
  have hStateShared :
      stateWithReturns.evm.toSharedState = sourceAfterCall.shared := by
    rw [hStateWithReturnsEq]
    exact hAttachedShared
  have hStateStack :
      stateWithReturns.evm.stack = values.reverse ++ base.evm.stack := by
    simp [stateWithReturns, Structured.RunState.withEVM]
  have hStateReturns : stateWithReturns.returns = hiddenReturns := by
    rw [hStateWithReturnsEq]
    exact hAttachedReturns
  rcases assignReturnedTops_source_order_of_ctxRel_stack_prefix
      (retc := retc) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns) (source := sourceAfterCall)
      (base := base) (target := stateWithReturns)
      (targets := targets) (values := values) (store' := returnStore)
      hCtx hNoDupLayout hTargetsNoDup hContains hBound hAssign
      hBaseRel hStateShared hStateStack hStateReturns with
    ⟨targetAfter, hAssignRun, hFinalRel⟩
  refine ⟨returned, stateWithReturns, targetAfter, hPop, hAttachBase, rfl,
    hAssignRun, hFinalRel⟩

end Assignment

namespace InitReturns

theorem stateRel {prim : Source.PrimitiveSemantics} {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {ctx : Locals.Ctx} :
    ∀ {returns : List Name},
      ctx.layout = layout →
      returns.Nodup →
      (∀ name, name ∈ returns → name ∉ layout) →
      StateRel layout hiddenReturns source target →
        ∃ targetAfter ctxAfter,
          Direct.initReturns returns ctx target = .ok (targetAfter, ctxAfter) ∧
          ctxAfter = ctx.withLayout (returns.reverse ++ layout) ∧
          StateRel ctxAfter.layout hiddenReturns
            (source.withVars (Source.Store.initReturns returns source.vars))
            targetAfter
  | [], hCtxLayout, _hNoDup, _hFresh, hRel => by
      refine ⟨target, ctx, ?hRun, ?hCtx, ?hRel⟩
      · simp [Direct.initReturns]
      · cases ctx
        simp [Locals.Ctx.withLayout] at hCtxLayout ⊢
        exact hCtxLayout
      · simpa [Source.Store.initReturns, Locals.Source.State.withVars,
          hCtxLayout] using hRel
  | name :: rest, hCtxLayout, hNoDup, hFresh, hRel => by
      cases hNoDup with
      | cons hNameNotMem hRestNoDup =>
          have hNameFresh : name ∉ layout :=
            hFresh name (by simp)
          have hRestFresh :
              ∀ restName, restName ∈ rest → restName ∉ name :: layout := by
            intro restName hRestMem hMem
            have hNe : restName ≠ name := by
              intro hEq
              subst restName
              exact hNameNotMem name hRestMem rfl
            have hNotLayout : restName ∉ layout :=
              hFresh restName (by simp [hRestMem])
            simp [hNe] at hMem
            exact hNotLayout hMem
          rcases Expr.lit_bridge (prim := prim)
              (layout := layout) (hiddenReturns := hiddenReturns)
              (source := source) (target := target) (ctx := ctx)
              (value := Direct.zero) hRel with
            ⟨_hSourceExpr, evmAfterZero, hTargetExpr, hExprRel⟩
          have hTargetRunState :
              Locals.Direct.Expr.runState ctx (.lit Direct.zero) target =
                .ok (target.withEVM evmAfterZero) := by
            simp [Locals.Direct.Expr.runState, hTargetExpr]
          have hHeadRel :
              StateRel (name :: layout) hiddenReturns
                (source.insert name Direct.zero)
                (target.withEVM evmAfterZero) :=
            ExprResultRel.to_stateRel_cons_insert hNameFresh hExprRel
          rcases stateRel
              (prim := prim)
              (layout := name :: layout) (hiddenReturns := hiddenReturns)
              (source := source.insert name Direct.zero)
              (target := target.withEVM evmAfterZero)
              (ctx := ctx.withLayout (name :: ctx.layout))
              (returns := rest)
              (by simp [Locals.Ctx.withLayout, hCtxLayout])
              hRestNoDup hRestFresh hHeadRel with
            ⟨targetAfter, ctxAfter, hTailRun, hCtxAfter, hTailRel⟩
          refine ⟨targetAfter, ?_⟩
          refine ⟨ctxAfter, ?_⟩
          constructor
          · simp [Direct.initReturns, hTargetRunState, hTailRun]
          constructor
          · simpa [List.reverse_cons, List.append_assoc, hCtxLayout,
              Locals.Ctx.withLayout] using hCtxAfter
          · simpa [Source.Store.initReturns, Locals.Source.State.insert,
              Locals.Source.State.withVars, Source.zero, Direct.zero]
              using hTailRel

end InitReturns

namespace FunDef

theorem initCallFrame_stateRel {prim : Source.PrimitiveSemantics}
    {fn : FunDef} {args : List Word} {paramStore : Source.Store}
    {shared : EvmYul.SharedState .EVM}
    {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    (hScoped : fn.Scoped)
    (hParams :
      Source.Store.insertMany fn.params args Locals.Source.Store.empty =
        some paramStore)
    (hShared : target.evm.toSharedState = shared)
    (hStack : target.evm.stack = args.reverse)
    (hReturns : target.returns = hiddenReturns) :
    ∃ targetAfter,
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          target =
        .ok (targetAfter, targetBodyCtx fn) ∧
      StateRel (targetBodyCtx fn).layout hiddenReturns
        { shared := shared,
          vars := Source.Store.initReturns fn.returns paramStore }
        targetAfter := by
  have hSignature : (fn.returns ++ fn.params).Nodup :=
    Functions.FunDef.signatureNodup hScoped
  have hParamsNoDup : fn.params.Nodup :=
    List.Nodup.of_append_right hSignature
  have hReturnsNoDup : fn.returns.Nodup :=
    List.Nodup.of_append_left hSignature
  have hDisjoint :
      ∀ name, name ∈ fn.returns → name ∉ fn.params.reverse := by
    intro name hReturn hParamReverse
    have hParam : name ∈ fn.params := by
      simpa using hParamReverse
    rcases List.nodup_append.mp hSignature with
      ⟨_hReturns, _hParams, hNoOverlap⟩
    exact hNoOverlap name hReturn name hParam rfl
  have hParamStackRel :
      Locals.SourceLowering.StackStoreRel fn.params.reverse paramStore
        args.reverse :=
    StackStoreRel.insertMany_reverse_empty hParams hParamsNoDup
  let sourceAfterParams : Source.State :=
    { shared := shared, vars := paramStore }
  have hParamRel :
      StateRel fn.params.reverse hiddenReturns sourceAfterParams target := by
    exact ⟨⟨hShared, by simpa [hStack] using hParamStackRel⟩, hReturns⟩
  rcases InitReturns.stateRel
      (prim := prim) (layout := fn.params.reverse)
      (hiddenReturns := hiddenReturns) (source := sourceAfterParams)
      (target := target)
      (ctx :=
        Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
          fn.returns.length)
      (returns := fn.returns)
      (by simp [Locals.Ctx.procEntryWithLayoutAndRetc,
        Locals.Ctx.procEntryWithLayout, Locals.Ctx.procEntry,
        Locals.Ctx.initial])
      hReturnsNoDup hDisjoint hParamRel with
    ⟨targetAfter, ctxAfter, hRun, hCtxAfter, hRel⟩
  refine ⟨targetAfter, ?hRun, ?hRel⟩
  · have hCtxTarget : ctxAfter = targetBodyCtx fn := by
      simpa [targetBodyCtx, Locals.Ctx.withLayout,
        Locals.Ctx.procEntryWithLayoutAndRetc,
        Locals.Ctx.procEntryWithLayout, Locals.Ctx.procEntry,
        Locals.Ctx.initial] using hCtxAfter
    simpa [hCtxTarget] using hRun
  · have hCtxTarget : ctxAfter = targetBodyCtx fn := by
      simpa [targetBodyCtx, Locals.Ctx.withLayout,
        Locals.Ctx.procEntryWithLayoutAndRetc,
        Locals.Ctx.procEntryWithLayout, Locals.Ctx.procEntry,
        Locals.Ctx.initial] using hCtxAfter
    subst ctxAfter
    simpa [sourceAfterParams, Locals.Source.State.withVars] using hRel

theorem prepareCallFrame_stateRel {prim : Source.PrimitiveSemantics}
    {callerLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceAfterArgs : Source.State} {targetAfterArgs : Locals.RunState}
    {fn : FunDef} {values : List Word} {paramStore : Source.Store}
    (hScoped : fn.Scoped)
    (hParams :
      Source.Store.insertMany fn.params values Locals.Source.Store.empty =
        some paramStore)
    (hArgsLen : values.length = fn.params.length)
    (hRel :
      PrefixedStateRel callerLayout hiddenReturns sourceAfterArgs
        values.reverse targetAfterArgs) :
    ∃ callerStack callState targetAfterInit,
      Structured.StackFrame.splitArgs? fn.params.length
          targetAfterArgs.evm.stack =
        some (values.reverse, callerStack) ∧
      callState =
        ((targetAfterArgs.withEVM
          { targetAfterArgs.evm with stack := values.reverse }).pushReturn
          callerStack fn.returns.length) ∧
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          callState =
        .ok (targetAfterInit, targetBodyCtx fn) ∧
      StateRel (targetBodyCtx fn).layout
        ({ callerStack := callerStack, retc := fn.returns.length } ::
          hiddenReturns)
        { shared := sourceAfterArgs.shared,
          vars := Source.Store.initReturns fn.returns paramStore }
        targetAfterInit := by
  rcases hRel with ⟨hShared, callerStack, hStack, _hStackRel, hReturns⟩
  have hPrefixLen : values.reverse.length = fn.params.length := by
    simp [hArgsLen]
  have hSplit :
      Structured.StackFrame.splitArgs? fn.params.length
          targetAfterArgs.evm.stack =
        some (values.reverse, callerStack) := by
    unfold Structured.StackFrame.splitArgs?
    have hLe : fn.params.length ≤ targetAfterArgs.evm.stack.length := by
      rw [hStack]
      simp [hPrefixLen]
    rw [if_pos hLe]
    rw [hStack]
    have hTake :
        List.take fn.params.length (values.reverse ++ callerStack) =
          values.reverse := by
      simpa [hPrefixLen] using
        (List.take_left (l₁ := values.reverse) (l₂ := callerStack))
    have hDrop :
        List.drop fn.params.length (values.reverse ++ callerStack) =
          callerStack := by
      simpa [hPrefixLen] using
        (List.drop_left (l₁ := values.reverse) (l₂ := callerStack))
    simp [hTake, hDrop]
  let callState : Locals.RunState :=
    ((targetAfterArgs.withEVM
      { targetAfterArgs.evm with stack := values.reverse }).pushReturn
      callerStack fn.returns.length)
  have hCallShared :
      callState.evm.toSharedState = sourceAfterArgs.shared := by
    simpa [callState, Structured.RunState.withEVM,
      Structured.RunState.pushReturn] using hShared
  have hCallStack : callState.evm.stack = values.reverse := by
    simp [callState, Structured.RunState.withEVM,
      Structured.RunState.pushReturn]
  have hCallReturns :
      callState.returns =
        { callerStack := callerStack, retc := fn.returns.length } ::
          hiddenReturns := by
    simp [callState, Structured.RunState.withEVM,
      Structured.RunState.pushReturn, hReturns]
  rcases initCallFrame_stateRel
      (prim := prim) (fn := fn) (args := values)
      (paramStore := paramStore) (shared := sourceAfterArgs.shared)
      (target := callState)
      (hiddenReturns :=
        { callerStack := callerStack, retc := fn.returns.length } ::
          hiddenReturns)
      hScoped hParams hCallShared hCallStack hCallReturns with
    ⟨targetAfterInit, hInitRun, hInitRel⟩
  refine ⟨callerStack, callState, targetAfterInit, hSplit, ?_, hInitRun,
    hInitRel⟩
  rfl

theorem runBody_regular_from_body {program : Program} {fn : FunDef}
    {fuel : Nat} {hiddenReturns : List Structured.ReturnDest}
    {callState targetAfterInit bodyTarget : Locals.RunState}
    {bodyCtx : Locals.Ctx} {bodySource : Source.State}
    {returnValues : List Word}
    (hInit :
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          callState =
        .ok (targetAfterInit, targetBodyCtx fn))
    (hBody :
      Direct.Block.runOpen program fn.returns (targetBodyCtx fn) fuel
          fn.body targetAfterInit =
        .ok (Structured.Outcome.regular bodyTarget, bodyCtx))
    (hNoDup : bodyCtx.layout.Nodup)
    (hReturnsLen : fn.returns.length = bodyCtx.leaveRetc)
    (hRetcBound : bodyCtx.leaveRetc ≤ 16)
    (hRel : StateRel bodyCtx.layout hiddenReturns bodySource bodyTarget)
    (hValues :
      ReturnValuesRel bodyCtx.layout bodySource bodyTarget fn.returns
        returnValues) :
    ∃ targetAfter,
      Direct.FunDef.runBody program fn (fuel + 1) callState =
        .ok (Structured.Outcome.regular targetAfter) ∧
      ReturnedStackRel hiddenReturns bodySource returnValues targetAfter := by
  rcases ReturnValuesRel.pushCleanup_returnedStack
      (layout := bodyCtx.layout) (hiddenReturns := hiddenReturns)
      (source := bodySource) (target := bodyTarget) (ctx := bodyCtx)
      (returns := fn.returns) (values := returnValues)
      rfl hNoDup hReturnsLen hRetcBound hValues hRel with
    ⟨stateAfterReturns, targetAfter, hPush, hCleanup, hReturned⟩
  have hCleanupDirect :
      Locals.Direct.Ctx.runCleanupToPreserving bodyCtx fn.returns.length 0
          stateAfterReturns =
        .ok targetAfter := by
    simpa [hReturnsLen] using hCleanup
  refine ⟨targetAfter, ?_, hReturned⟩
  simp [Direct.FunDef.runBody, hInit, hBody, hPush, hCleanupDirect]

theorem runBody_leave_from_body {program : Program} {fn : FunDef}
    {fuel : Nat} {callState targetAfterInit targetAfter : Locals.RunState}
    {bodyCtx : Locals.Ctx}
    (hInit :
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          callState =
        .ok (targetAfterInit, targetBodyCtx fn))
    (hBody :
      Direct.Block.runOpen program fn.returns (targetBodyCtx fn) fuel
          fn.body targetAfterInit =
        .ok (Structured.Outcome.leave targetAfter, bodyCtx)) :
    Direct.FunDef.runBody program fn (fuel + 1) callState =
      .ok (Structured.Outcome.leave targetAfter) := by
  simp [Direct.FunDef.runBody, hInit, hBody]

theorem runBody_halt_from_body {program : Program} {fn : FunDef}
    {fuel : Nat} {callState targetAfterInit haltedTarget : Locals.RunState}
    {bodyCtx : Locals.Ctx} {kind : Assembly.HaltKind}
    (hInit :
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          callState =
        .ok (targetAfterInit, targetBodyCtx fn))
    (hBody :
      Direct.Block.runOpen program fn.returns (targetBodyCtx fn) fuel
          fn.body targetAfterInit =
        .ok (Structured.Outcome.halt kind haltedTarget, bodyCtx)) :
    Direct.FunDef.runBody program fn (fuel + 1) callState =
      .ok (Structured.Outcome.halt kind haltedTarget) := by
  simp [Direct.FunDef.runBody, hInit, hBody]

end FunDef

namespace CallPrelude

theorem prepareCallFrame {prim : Source.PrimitiveSemantics}
    {layout : List Name} {hiddenReturns : List Structured.ReturnDest}
    {sourceAfterArgs : Source.State}
    {sharedAfterCall : EvmYul.SharedState .EVM}
    {argValues : List Word} {targetCtx : Locals.Ctx}
    {args : List (Expr 1)}
    {target targetAfterArgs callerBase : Locals.RunState}
    {fn : FunDef} {paramStore : Source.Store}
    (hScoped : fn.Scoped)
    (hParams :
      Source.Store.insertMany fn.params argValues
          Locals.Source.Store.empty =
        some paramStore)
    (hArgsLen : argValues.length = fn.params.length)
    (hPrelude :
      CallPrelude layout hiddenReturns sourceAfterArgs sharedAfterCall
        argValues targetCtx args target targetAfterArgs callerBase) :
    ∃ callState targetAfterInit,
      Structured.StackFrame.splitArgs? fn.params.length
          targetAfterArgs.evm.stack =
        some (argValues.reverse, callerBase.evm.stack) ∧
      callState =
        ((targetAfterArgs.withEVM
          { targetAfterArgs.evm with stack := argValues.reverse }).pushReturn
          callerBase.evm.stack fn.returns.length) ∧
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          callState =
        .ok (targetAfterInit, FunDef.targetBodyCtx fn) ∧
      StateRel (FunDef.targetBodyCtx fn).layout
        ({ callerStack := callerBase.evm.stack, retc := fn.returns.length } ::
          hiddenReturns)
        { shared := sourceAfterArgs.shared,
          vars := Source.Store.initReturns fn.returns paramStore }
        targetAfterInit := by
  rcases hPrelude with
    ⟨_hTargetArgs, hArgStack, hPrefixRel, _hBaseRel⟩
  rcases FunDef.prepareCallFrame_stateRel
      (prim := prim) (callerLayout := layout)
      (hiddenReturns := hiddenReturns)
      (sourceAfterArgs := sourceAfterArgs)
      (targetAfterArgs := targetAfterArgs)
      (fn := fn) (values := argValues) (paramStore := paramStore)
      hScoped hParams hArgsLen hPrefixRel with
    ⟨callerStack, callState, targetAfterInit, hSplit, hCallState, hInit,
      hRel⟩
  have hCallerStack : callerStack = callerBase.evm.stack := by
    rw [hArgStack] at hSplit
    unfold Structured.StackFrame.splitArgs? at hSplit
    have hPrefixLen : argValues.reverse.length = fn.params.length := by
      simp [hArgsLen]
    have hLe :
        fn.params.length ≤
          (argValues.reverse ++ callerBase.evm.stack).length := by
      simp [hPrefixLen]
    rw [if_pos hLe] at hSplit
    have hTake :
        List.take fn.params.length
            (argValues.reverse ++ callerBase.evm.stack) =
          argValues.reverse := by
      simpa [hPrefixLen] using
        (List.take_left (l₁ := argValues.reverse)
          (l₂ := callerBase.evm.stack))
    have hDrop :
        List.drop fn.params.length
            (argValues.reverse ++ callerBase.evm.stack) =
          callerBase.evm.stack := by
      simpa [hPrefixLen] using
        (List.drop_left (l₁ := argValues.reverse)
          (l₂ := callerBase.evm.stack))
    simp [hTake, hDrop] at hSplit
    cases hSplit
    rfl
  subst callerStack
  exact ⟨callState, targetAfterInit, hSplit, hCallState, hInit, hRel⟩

end CallPrelude

namespace Stmt

theorem expr_bridge {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source sourceAfterExpr : Source.State}
    {target : Locals.RunState} {fuel : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    {expr : Expr 0} {values : List Word}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 expr)
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hEval :
      Source.Expr.eval prim expr source = .ok (sourceAfterExpr, values)) :
    ∃ targetAfter,
      Source.Stmt.run prim program sourceCtx fuel (.expr expr) source =
        .ok (Source.Outcome.regular sourceAfterExpr, sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx fuel (.expr expr) target =
        .ok (Structured.Outcome.regular targetAfter, targetCtx) ∧
      StateRel targetCtx.layout hiddenReturns sourceAfterExpr targetAfter ∧
      CtxRel retc sourceCtx targetCtx := by
  have hValuesLen : values.length = 0 :=
    Locals.SourceLowering.Expr.eval_length_of_sourceOwned hPrim hOwned hEval
  have hValuesNil : values = [] := by
    cases values with
    | nil => rfl
    | cons head tail =>
        simp at hValuesLen
  rcases SourceDirect.Expr.eval_bridge_sourceOwned hPrim
      (layout := targetCtx.layout)
      (hiddenReturns := hiddenReturns) (source := source)
      (source' := sourceAfterExpr) (values := values)
      (target := target) (ctx := targetCtx)
      rfl hNoDup hOwned hAccess hRel hEval with
    ⟨evm, hTargetExpr, hExprRel⟩
  have hTargetRunState :
      Locals.Direct.Expr.runState targetCtx expr target =
        .ok (target.withEVM evm) := by
    simp [Locals.Direct.Expr.runState, hTargetExpr]
  have hExprRelNil :
      ExprResultRel targetCtx.layout hiddenReturns sourceAfterExpr []
        (target.withEVM evm) := by
    simpa [hValuesNil] using hExprRel
  refine ⟨target.withEVM evm, ?_, ?_, ?_, hCtx⟩
  · simp [Source.Stmt.run, hEval]
  · simp [Direct.Stmt.run, hTargetRunState]
  · exact ExprResultRel.to_stateRel_nil hExprRelNil

theorem let_lit_bridge {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState} {fuel : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    {name : Name} {value : Word}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hFresh : name ∉ sourceCtx.scope)
    (hRel : StateRel targetCtx.layout hiddenReturns source target) :
    Source.Stmt.run prim program sourceCtx fuel (.let_ name (.lit value))
        source =
      .ok
        (Source.Outcome.regular (source.insert name value),
          { sourceCtx with scope := name :: sourceCtx.scope }) ∧
      ∃ targetAfter,
        Direct.Stmt.run program returns targetCtx fuel
            (.let_ name (.lit value)) target =
          .ok
            (Structured.Outcome.regular targetAfter,
              targetCtx.withLayout (name :: targetCtx.layout)) ∧
        StateRel (name :: targetCtx.layout) hiddenReturns
          (source.insert name value) targetAfter ∧
        CtxRel retc { sourceCtx with scope := name :: sourceCtx.scope }
          (targetCtx.withLayout (name :: targetCtx.layout)) := by
  rcases hCtx with ⟨hScope, hBreak, hContinue, hLeave, hRetc⟩
  have hCtxRel : CtxRel retc sourceCtx targetCtx :=
    ⟨hScope, hBreak, hContinue, hLeave, hRetc⟩
  have hFreshTarget : name ∉ targetCtx.layout := by
    intro hMem
    exact hFresh ((hScope.2 name).mp hMem)
  rcases SourceDirect.Expr.lit_bridge (prim := prim)
      (layout := targetCtx.layout)
      (hiddenReturns := hiddenReturns) (source := source)
      (target := target) (ctx := targetCtx) (value := value) hRel with
    ⟨hSourceExpr, evm, hTargetExpr, hExprRel⟩
  have hSourceEvalOne :
      Source.Expr.evalOne prim (Locals.Expr.lit value) source =
        .ok (source, value) := by
    simp [Source.Expr.evalOne, Locals.Source.Expr.evalOne, hSourceExpr]
  have hTargetRunState :
      Locals.Direct.Expr.runState targetCtx (Locals.Expr.lit value) target =
        .ok (target.withEVM evm) := by
    simp [Locals.Direct.Expr.runState, hTargetExpr]
  refine ⟨?hSource, target.withEVM evm, ?hTarget, ?hState, ?hCtx⟩
  · simp [Source.Stmt.run, hSourceEvalOne]
  · simp [Direct.Stmt.run, hTargetRunState]
  · exact ExprResultRel.to_stateRel_cons_insert hFreshTarget hExprRel
  · exact CtxRel.withScopeCons hCtxRel

