theorem runOpen_from_source_run_with_loop_invariant_callback_depth
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns loopLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {block : Block} {sourceResult : Source.Outcome × Source.Ctx}
    (hLeaveFrame : LeaveFrameAvailable sourceCtx hiddenReturns)
    (hSourceRun :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok sourceResult)
    (hInv : SourceInvariant.Block returns sourceCtx block)
    (hBreakDepth :
      sourceCtx.breakScope?.map List.length = some loopLayout.length)
    (hContinueDepth :
      sourceCtx.continueScope?.map List.length = some loopLayout.length)
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hLoopCleanup : CleanupLayoutRel targetCtx.layout loopLayout)
    (hStmt :
      ∀ {fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
        {source : Source.State} {target : Locals.RunState}
        {stmt : Stmt} {sourceResult : Source.Outcome × Source.Ctx},
        LeaveFrameAvailable sourceCtx hiddenReturns →
        SourceInvariant.Stmt returns sourceCtx stmt →
        Source.Stmt.run prim program sourceCtx fuel stmt source =
          .ok sourceResult →
        sourceCtx.breakScope?.map List.length = some loopLayout.length →
        sourceCtx.continueScope?.map List.length = some loopLayout.length →
        CtxRel retc sourceCtx targetCtx →
        StateRel targetCtx.layout hiddenReturns source target →
        CleanupLayoutRel targetCtx.layout loopLayout →
          LoopStmtRunBridgeWithLayout prim program returns loopLayout retc fuel
            sourceCtx targetCtx hiddenReturns stmt source target) :
    LoopBlockOpenRunBridgeWithLayout prim program returns loopLayout retc fuel
      sourceCtx targetCtx hiddenReturns block source target :=
  runOpen_from_source_run_with_loop_invariant_callback_depth_bounded
    (prim := prim) (program := program) (returns := returns)
    (loopLayout := loopLayout) (retc := retc) (maxFuel := fuel)
    (fuel := fuel) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
    (source := source) (target := target) (hiddenReturns := hiddenReturns)
    (block := block) (sourceResult := sourceResult) hSourceRun
    (Nat.le_refl fuel) hLeaveFrame hInv hBreakDepth hContinueDepth hCtx hRel
    hLoopCleanup
    (by
      intro fuel sourceCtx targetCtx source target stmt sourceResult _hFuel
        hLeaveFrame hInv hSourceRun hBreakDepth hContinueDepth hCtx hRel hCleanup
      exact hStmt hLeaveFrame hInv hSourceRun hBreakDepth hContinueDepth hCtx hRel
        hCleanup)

theorem runScoped_regular_from_open {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxOut : Locals.Ctx}
    {source sourceInner : Source.State}
    {target targetInner : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {block : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.regular sourceInner, sourceCtxOut))
    (hTargetOpen :
      Direct.Block.runOpen program returns targetCtx fuel block target =
        .ok (Structured.Outcome.regular targetInner, targetCtxOut))
    (hOpenRel :
      BlockOpenResultRel retc returns hiddenReturns
        (Source.Outcome.regular sourceInner, sourceCtxOut)
        (Structured.Outcome.regular targetInner, targetCtxOut))
    (hLayout :
      CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    ∃ targetScoped,
      Source.Block.runScoped prim program sourceCtx block fuel source =
        .ok
          (Source.Outcome.regular
            (Locals.Source.State.restrictTo sourceCtx.scope sourceInner)) ∧
      Direct.Block.runScoped program returns targetCtx block fuel target =
        .ok (Structured.Outcome.regular targetScoped) ∧
      StateRel targetCtx.layout hiddenReturns
        (Locals.Source.State.restrictTo sourceCtx.scope sourceInner)
        targetScoped := by
  have hRegularRel :
      StateRel targetCtxOut.layout hiddenReturns sourceInner targetInner ∧
        CtxRel retc sourceCtxOut targetCtxOut := by
    simpa [BlockOpenResultRel, Source.Outcome.regular,
      Locals.Source.Outcome.regular, Structured.Outcome.regular] using
      hOpenRel
  rcases hRegularRel with ⟨hStateRel, _hFinalCtx⟩
  have hStateRelFull :
      StateRel targetCtxOut.layout hiddenReturns sourceInner targetInner :=
    hStateRel
  rcases hStateRel with ⟨⟨_hSharedRel, hStackRel⟩, _hReturns⟩
  have hDepth : targetCtx.layout.length ≤ targetCtxOut.layout.length := by
    have hLength := congrArg List.length hLayout
    simp [CleanupLayoutRel] at hLength
    omega
  rcases Cleanup.runCleanupTo_exists
      (ctx := targetCtxOut) (targetDepth := targetCtx.layout.length)
      (state := targetInner) hDepth hStackRel.1 with
    ⟨targetScoped, hCleanup⟩
  have hScopedRel :
      StateRel targetCtx.layout hiddenReturns
        (Locals.Source.State.restrictTo sourceCtx.scope sourceInner)
        targetScoped :=
    StateRel.cleanupTo_layout
      (ctx := targetCtxOut) (outer := targetCtx.layout)
      (scope := sourceCtx.scope) (hiddenReturns := hiddenReturns)
      (source := sourceInner) (target := targetInner)
      (cleaned := targetScoped) hStateRelFull hLayout hCtx.1 hCleanup
  refine ⟨targetScoped, ?hSource, ?hTarget, hScopedRel⟩
  · simp [Source.Block.runScoped, hSourceOpen,
      Source.Outcome.regular, Locals.Source.Outcome.regular]
  · simp [Direct.Block.runScoped, hTargetOpen, hCleanup,
      Structured.Outcome.regular]

theorem block_regular_stmtRunResult_from_open
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxOut : Locals.Ctx}
    {source sourceInner : Source.State}
    {target targetInner : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {body : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel body source =
        .ok (Source.Outcome.regular sourceInner, sourceCtxOut))
    (hTargetOpen :
      Direct.Block.runOpen program returns targetCtx fuel body target =
        .ok (Structured.Outcome.regular targetInner, targetCtxOut))
    (hOpenRel :
      BlockOpenResultRel retc returns hiddenReturns
        (Source.Outcome.regular sourceInner, sourceCtxOut)
        (Structured.Outcome.regular targetInner, targetCtxOut))
    (hLayout :
      CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    ∃ targetScoped,
      Source.Stmt.run prim program sourceCtx fuel (.block body) source =
        .ok
          (Source.Outcome.regular
            (Locals.Source.State.restrictTo sourceCtx.scope sourceInner),
            sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx fuel (.block body) target =
        .ok (Structured.Outcome.regular targetScoped, targetCtx) ∧
      StmtRunResultRel retc returns hiddenReturns
        (Source.Outcome.regular
          (Locals.Source.State.restrictTo sourceCtx.scope sourceInner),
          sourceCtx)
        (Structured.Outcome.regular targetScoped, targetCtx) := by
  rcases runScoped_regular_from_open
      (prim := prim) (program := program) (returns := returns)
      (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
      (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
      (targetCtxOut := targetCtxOut) (source := source)
      (sourceInner := sourceInner) (target := target)
      (targetInner := targetInner) (hiddenReturns := hiddenReturns)
      (block := body) hCtx hSourceOpen hTargetOpen hOpenRel hLayout with
    ⟨targetScoped, hSourceScoped, hTargetScoped, hScopedRel⟩
  refine ⟨targetScoped, ?hSource, ?hTarget, ?hRel⟩
  · simp [Source.Stmt.run, hSourceScoped]
  · simp [Direct.Stmt.run, hTargetScoped]
  · exact StmtRunResultRel.regular hScopedRel hCtx

theorem runScoped_nonregular_from_open
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxOut : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    {block : Block}
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (sourceOutcome, sourceCtxOut))
    (hTargetOpen :
      Direct.Block.runOpen program returns targetCtx fuel block target =
        .ok (targetOutcome, targetCtxOut))
    (hOpenRel :
      BlockOpenResultRel retc returns hiddenReturns
        (sourceOutcome, sourceCtxOut) (targetOutcome, targetCtxOut))
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    Source.Block.runScoped prim program sourceCtx block fuel source =
      .ok sourceOutcome ∧
    Direct.Block.runScoped program returns targetCtx block fuel target =
      .ok targetOutcome ∧
    ∃ outcomeLayout,
      StmtOutcomeRel returns outcomeLayout hiddenReturns
        sourceOutcome targetOutcome := by
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [Source.Block.runScoped, Direct.Block.runScoped,
              hSourceOpen, hTargetOpen, BlockOpenResultRel,
              StmtOutcomeRel] at hOpenRel hNonregular ⊢
          all_goals exact hOpenRel.1

theorem runScoped_from_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx}
    {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {block : Block} {sourceOutcome : Source.Outcome}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceScoped :
      Source.Block.runScoped prim program sourceCtx block fuel source =
        .ok sourceOutcome)
    (hOpen :
      BlockOpenRunBridgeWithLayout prim program returns retc fuel sourceCtx
        targetCtx hiddenReturns block source target) :
    ∃ targetOutcome,
      Direct.Block.runScoped program returns targetCtx block fuel target =
        .ok targetOutcome ∧
      BlockScopedOutcomeRel returns targetCtx.layout hiddenReturns
