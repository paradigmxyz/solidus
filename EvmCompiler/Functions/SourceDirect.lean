                  simp [BlockOpenResultRel, StmtOutcomeRel,
                    Source.Outcome.regular, Structured.Outcome.cont]
                    at hOpenRel
              | leave =>
                  simp [BlockOpenResultRel, StmtOutcomeRel,
                    Source.Outcome.regular, Structured.Outcome.leave]
                    at hOpenRel
              | halt kind =>
                  simp [BlockOpenResultRel, StmtOutcomeRel,
                    Source.Outcome.regular, Structured.Outcome.halt]
                    at hOpenRel
