namespace FunDef

theorem runBody_returned_from_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {fn : FunDef}
    {fuel : Nat} {hiddenReturns : List Structured.ReturnDest}
    {callState targetAfterInit : Locals.RunState}
    {sourceBody returnSource : Source.State}
    {bodyOutcome : Source.Outcome} {sourceCtxOut : Source.Ctx}
    {sharedAfterCall : EvmYul.SharedState .EVM}
    {returnValues : List Word}
    (hSourceOpen :
      Source.Block.runOpen prim program (sourceBodyCtx fn) fuel fn.body
          sourceBody =
        .ok (bodyOutcome, sourceCtxOut))
    (hMode : bodyOutcome.mode = .regular ∨ bodyOutcome.mode = .leave)
    (hLookup :
      Source.Store.lookupMany fn.returns bodyOutcome.state.vars =
        some returnValues)
    (hShared : bodyOutcome.state.shared = sharedAfterCall)
    (hReturnSourceShared : returnSource.shared = sharedAfterCall)
    (hInit :
      Direct.initReturns fn.returns
          (Locals.Ctx.procEntryWithLayoutAndRetc fn.params.reverse
            fn.returns.length)
          callState =
        .ok (targetAfterInit, targetBodyCtx fn))
    (hFnScoped : fn.Scoped)
    (hFrameBound : FrameBound.FunDef fn)
    (hOpen :
      BlockOpenRunBridgeWithLayout prim program fn.returns fn.returns.length
        fuel (sourceBodyCtx fn) (targetBodyCtx fn) hiddenReturns fn.body
        sourceBody targetAfterInit) :
    ∃ targetMode returnedTarget,
      (targetMode = .regular ∨ targetMode = .leave) ∧
      Direct.FunDef.runBody program fn (fuel + 1) callState =
        .ok { state := returnedTarget, mode := targetMode } ∧
      ReturnedStackRel hiddenReturns returnSource returnValues
        returnedTarget := by
  rcases
      BlockOpenRunBridgeWithLayout.target_result_of_source hOpen hSourceOpen
    with ⟨targetResult, hTargetOpen, hOpenRel⟩
  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
  cases bodyOutcome with
  | mk bodyState bodyMode =>
      cases bodyMode with
      | regular =>
          cases targetOutcome with
          | mk targetState targetMode =>
              cases targetMode with
              | regular =>
                  have hRegularRel :
                      StateRel targetCtxOut.layout hiddenReturns bodyState
                          targetState ∧
                        CtxRel fn.returns.length sourceCtxOut targetCtxOut := by
                    simpa [BlockOpenResultRel, Source.Outcome.regular,
                      Locals.Source.Outcome.regular,
                      Structured.Outcome.regular] using hOpenRel
                  rcases hRegularRel with ⟨hStateRel, hCtxRel⟩
                  rcases
                      FrameBound.funDef_regular_return_safe
                        hFnScoped hFrameBound hSourceOpen hCtxRel with
                    ⟨hNoDup, hReturnAccess⟩
                  have hValues :
                      ReturnValuesRel targetCtxOut.layout bodyState targetState
                        fn.returns returnValues :=
                    ReturnValuesRel.of_stateRel_lookupMany_accessible
                      hReturnAccess hLookup hStateRel
                  have hReturnsLen :
                      fn.returns.length = targetCtxOut.leaveRetc := by
                    rcases hCtxRel with
                      ⟨_hScope, _hBreak, _hContinue, _hLeave, hRetc,
                        _hBreakScope, _hContinueScope⟩
                    exact hRetc.symm
                  have hRetcBound : fn.returns.length ≤ 16 := by
                    have hBound :=
                      FrameBound.funDef_regularReturnBound hFrameBound
                    omega
                  have hTargetRetcBound : targetCtxOut.leaveRetc ≤ 16 := by
                    simpa [← hReturnsLen] using hRetcBound
                  rcases runBody_regular_from_body
                      (program := program) (fn := fn) (fuel := fuel)
                      (hiddenReturns := hiddenReturns)
                      (callState := callState)
                      (targetAfterInit := targetAfterInit)
                      (bodyTarget := targetState)
                      (bodyCtx := targetCtxOut) (bodySource := bodyState)
                      (returnValues := returnValues)
                      hInit hTargetOpen hNoDup hReturnsLen hTargetRetcBound
                      hStateRel hValues with
                    ⟨returnedTarget, hRunBody, hReturned⟩
                  refine ⟨.regular, returnedTarget, Or.inl rfl, hRunBody, ?_⟩
                  rcases hReturned with ⟨hReturnedShared, hStack, hReturns⟩
                  refine ⟨?_, hStack, hReturns⟩
                  calc
                    returnedTarget.evm.toSharedState = bodyState.shared :=
                      hReturnedShared
                    _ = sharedAfterCall := hShared
                    _ = returnSource.shared := hReturnSourceShared.symm
              | brk =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | cont =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | leave =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | halt kind =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
      | brk =>
          exact False.elim (by
            cases hMode with
            | inl hRegular => cases hRegular
            | inr hLeave => cases hLeave)
      | cont =>
          exact False.elim (by
            cases hMode with
            | inl hRegular => cases hRegular
            | inr hLeave => cases hLeave)
      | leave =>
          cases targetOutcome with
          | mk targetState targetMode =>
              cases targetMode with
              | regular =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | brk =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | cont =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | leave =>
                  have hLeaveRel :
                      ∃ outcomeLayout,
                        StmtOutcomeRel fn.returns outcomeLayout hiddenReturns
                          (Source.Outcome.leave bodyState)
                          (Structured.Outcome.leave targetState) := by
                    rcases hOpenRel with ⟨outcomeLayout, hOutcomeRel, _hCtxRel⟩
                    exact ⟨outcomeLayout, hOutcomeRel⟩
                  rcases hLeaveRel with ⟨_layout, hOutcomeRel⟩
                  rcases hOutcomeRel with
                    ⟨values, hLookupValues, hReturned⟩
                  have hLookupBody :
                      Source.Store.lookupMany fn.returns bodyState.vars =
                        some returnValues := by
                    simpa [Source.Outcome.leave] using hLookup
                  have hLookupValuesBody :
                      Source.Store.lookupMany fn.returns bodyState.vars =
                        some values := by
                    simpa [Source.Outcome.leave] using hLookupValues
                  have hValuesEq : values = returnValues := by
                    rw [hLookupBody] at hLookupValuesBody
                    cases hLookupValuesBody
                    rfl
                  subst values
                  have hRunBody :
                      Direct.FunDef.runBody program fn (fuel + 1)
                          callState =
                        .ok (Structured.Outcome.leave targetState) :=
                    runBody_leave_from_body
                      (program := program) (fn := fn) (fuel := fuel)
                      (callState := callState)
                      (targetAfterInit := targetAfterInit)
                      (targetAfter := targetState) (bodyCtx := targetCtxOut)
                      hInit hTargetOpen
                  refine ⟨.leave, targetState, Or.inr rfl, hRunBody, ?_⟩
                  rcases hReturned with ⟨hReturnedShared, hStack, hReturns⟩
                  refine ⟨?_, hStack, hReturns⟩
                  calc
                    targetState.evm.toSharedState = bodyState.shared :=
                      hReturnedShared
                    _ = sharedAfterCall := hShared
                    _ = returnSource.shared := hReturnSourceShared.symm
              | halt kind =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
      | halt kind =>
