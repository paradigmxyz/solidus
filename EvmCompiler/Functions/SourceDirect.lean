theorem source_runOpen_cons_head {prim : Source.PrimitiveSemantics}
    {program : Program} {fuel : Nat} {sourceCtx : Source.Ctx}
    {source : Source.State} {stmt : Stmt} {rest : List Stmt}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hSourceRun :
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := stmt :: rest } source =
        .ok sourceResult) :
    ∃ sourceHead sourceCtxAfter,
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (sourceHead, sourceCtxAfter) ∧
      (sourceHead.mode = .regular →
        Source.Block.runOpen prim program sourceCtxAfter fuel
            { stmts := rest } sourceHead.state =
          .ok sourceResult) ∧
      (sourceHead.mode ≠ .regular → sourceResult = (sourceHead, sourceCtx)) := by
  cases hHead : Source.Stmt.run prim program sourceCtx fuel stmt source with
  | error err =>
      simp [Source.Block.runOpen, hHead] at hSourceRun
  | ok headResult =>
      rcases headResult with ⟨sourceHead, sourceCtxAfter⟩
      refine ⟨sourceHead, sourceCtxAfter, rfl, ?hRegular, ?hNonregular⟩
      · intro hRegular
        cases sourceHead with
        | mk sourceHeadState sourceHeadMode =>
            cases sourceHeadMode <;> simp at hRegular
            simpa [Source.Block.runOpen, hHead] using hSourceRun
      · intro hNonregular
        cases sourceHead with
        | mk sourceHeadState sourceHeadMode =>
            cases sourceHeadMode <;>
              simp [Source.Block.runOpen, hHead] at hSourceRun hNonregular ⊢
            all_goals exact hSourceRun.symm

