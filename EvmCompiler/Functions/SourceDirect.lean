def StmtRunBridge (prim : Source.PrimitiveSemantics)
    (program : Program) (returns : List Name) (retc fuel : Nat)
    (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (stmt : Stmt) (source : Source.State) (target : Locals.RunState) :
    Prop :=
  ∃ sourceResult targetResult,
    Source.Stmt.run prim program sourceCtx fuel stmt source =
      .ok sourceResult ∧
    Direct.Stmt.run program returns targetCtx fuel stmt target =
      .ok targetResult ∧
    StmtRunResultRel retc returns hiddenReturns sourceResult targetResult

def StmtRunBridgeWithLayout (prim : Source.PrimitiveSemantics)
    (program : Program) (returns : List Name) (retc fuel : Nat)
    (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (stmt : Stmt) (source : Source.State) (target : Locals.RunState) :
    Prop :=
  StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
    hiddenReturns stmt source target ∧
  ∀ {sourceInner sourceCtxOut targetInner targetCtxOut},
    Source.Stmt.run prim program sourceCtx fuel stmt source =
      .ok (Source.Outcome.regular sourceInner, sourceCtxOut) →
    Direct.Stmt.run program returns targetCtx fuel stmt target =
      .ok (Structured.Outcome.regular targetInner, targetCtxOut) →
    StmtRunResultRel retc returns hiddenReturns
      (Source.Outcome.regular sourceInner, sourceCtxOut)
      (Structured.Outcome.regular targetInner, targetCtxOut) →
    CleanupLayoutRel targetCtxOut.layout targetCtx.layout

def LoopStmtRunBridgeWithLayout (prim : Source.PrimitiveSemantics)
    (program : Program) (returns loopLayout : List Name)
    (retc fuel : Nat) (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (stmt : Stmt) (source : Source.State) (target : Locals.RunState) :
    Prop :=
  (∃ sourceResult targetResult,
    Source.Stmt.run prim program sourceCtx fuel stmt source =
      .ok sourceResult ∧
    Direct.Stmt.run program returns targetCtx fuel stmt target =
      .ok targetResult ∧
    LoopStmtRunResultRel retc returns loopLayout hiddenReturns
      sourceResult targetResult) ∧
  ∀ {sourceInner sourceCtxOut targetInner targetCtxOut},
    Source.Stmt.run prim program sourceCtx fuel stmt source =
      .ok (Source.Outcome.regular sourceInner, sourceCtxOut) →
    Direct.Stmt.run program returns targetCtx fuel stmt target =
      .ok (Structured.Outcome.regular targetInner, targetCtxOut) →
    LoopStmtRunResultRel retc returns loopLayout hiddenReturns
      (Source.Outcome.regular sourceInner, sourceCtxOut)
      (Structured.Outcome.regular targetInner, targetCtxOut) →
    CleanupLayoutRel targetCtxOut.layout targetCtx.layout

def BlockOpenRunBridge (prim : Source.PrimitiveSemantics)
    (program : Program) (returns : List Name) (retc fuel : Nat)
    (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (block : Block) (source : Source.State) (target : Locals.RunState) :
