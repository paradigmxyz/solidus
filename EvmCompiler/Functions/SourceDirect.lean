              (sourceAfterCond := sourceAfterCond) (target := target)
              (targetAfterCond := targetAfterCond)
              (hiddenReturns := hiddenReturns) (cond := cond) (body := body)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.cont })
              (targetOutcome := targetOutcome) hCtx hSourceCond hTargetCond
              hSourceOpen hTargetOpen hOpenRel hNonregular
      | leave =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          exact
            if_true_nonregular_stmtRunBridge_from_open_with_layout
              (prim := prim) (program := program) (returns := returns)
              (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut) (source := source)
