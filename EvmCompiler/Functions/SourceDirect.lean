                                  Source.Outcome) =
                                  Source.Outcome.regular sourceInner := by
                              have hPair :
                                  (({ state := sourceHeadState,
                                      mode := Locals.Source.Mode.brk } :
                                    Source.Outcome), sourceCtx) =
                                    (Source.Outcome.regular sourceInner,
                                      sourceCtxRegular) := by
                                simpa [hSource] using hSourceRegular
