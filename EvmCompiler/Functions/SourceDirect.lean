namespace StmtRunBridge

theorem of_parts {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    {targetResult : Locals.Outcome × Locals.Ctx}
    (hSource :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok sourceResult)
    (hTarget :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok targetResult)
    (hRel :
      StmtRunResultRel retc returns hiddenReturns
        sourceResult targetResult) :
    StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns stmt source target :=
  ⟨sourceResult, targetResult, hSource, hTarget, hRel⟩

end StmtRunBridge

namespace StmtRunBridgeWithLayout

theorem to_bridge {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    (hBridge :
      StmtRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns stmt source target) :
    StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns stmt source target :=
  hBridge.1

theorem regular_layout {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    (hBridge :
      StmtRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns stmt source target)
    {sourceInner sourceCtxOut targetInner targetCtxOut}
    (hSource :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceInner, sourceCtxOut))
    (hTarget :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok (Structured.Outcome.regular targetInner, targetCtxOut))
    (hRel :
      StmtRunResultRel retc returns hiddenReturns
        (Source.Outcome.regular sourceInner, sourceCtxOut)
        (Structured.Outcome.regular targetInner, targetCtxOut)) :
    CleanupLayoutRel targetCtxOut.layout targetCtx.layout :=
  hBridge.2 hSource hTarget hRel

theorem target_result_of_source {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hBridge :
      StmtRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns stmt source target)
    (hSource :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok sourceResult) :
    ∃ targetResult,
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok targetResult ∧
      StmtRunResultRel retc returns hiddenReturns sourceResult targetResult := by
  rcases StmtRunBridgeWithLayout.to_bridge hBridge with
    ⟨sourceResult', targetResult, hSource', hTarget, hRel⟩
  rw [hSource] at hSource'
  cases hSource'
  exact ⟨targetResult, hTarget, hRel⟩

theorem of_bridge_and_layout {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    (hBridge :
      StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
        hiddenReturns stmt source target)
    (hLayout :
      ∀ {sourceInner sourceCtxOut targetInner targetCtxOut},
        Source.Stmt.run prim program sourceCtx fuel stmt source =
          .ok (Source.Outcome.regular sourceInner, sourceCtxOut) →
        Direct.Stmt.run program returns targetCtx fuel stmt target =
          .ok (Structured.Outcome.regular targetInner, targetCtxOut) →
        StmtRunResultRel retc returns hiddenReturns
          (Source.Outcome.regular sourceInner, sourceCtxOut)
          (Structured.Outcome.regular targetInner, targetCtxOut) →
        CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns stmt source target :=
  ⟨hBridge, hLayout⟩

theorem of_bridge_and_regular_target_layout {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    (hBridge :
      StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
        hiddenReturns stmt source target)
    (hLayout :
      ∀ {targetInner targetCtxOut},
        Direct.Stmt.run program returns targetCtx fuel stmt target =
          .ok (Structured.Outcome.regular targetInner, targetCtxOut) →
        CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns stmt source target :=
  of_bridge_and_layout hBridge
    (by
      intro _sourceInner _sourceCtxOut targetInner targetCtxOut
        _hSource hTarget _hRel
      exact hLayout hTarget)

theorem of_bridge_and_never_regular_source {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    (hBridge :
      StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
        hiddenReturns stmt source target)
    (hNever :
      ∀ {sourceInner sourceCtxOut},
        Source.Stmt.run prim program sourceCtx fuel stmt source =
          .ok (Source.Outcome.regular sourceInner, sourceCtxOut) →
        False) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns stmt source target :=
  of_bridge_and_layout hBridge
    (by
      intro sourceInner sourceCtxOut _targetInner _targetCtxOut
        hSource _hTarget _hRel
      exact False.elim (hNever hSource))

theorem of_parts_regular_target_cleanup {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx targetCtxOut : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target targetAfter : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hSource :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok sourceResult)
    (hTarget :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok (Structured.Outcome.regular targetAfter, targetCtxOut))
    (hRel :
      StmtRunResultRel retc returns hiddenReturns sourceResult
        (Structured.Outcome.regular targetAfter, targetCtxOut))
    (hLayout : CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns stmt source target := by
  refine
    of_bridge_and_regular_target_layout
      (StmtRunBridge.of_parts hSource hTarget hRel) ?hLayout
  intro targetInner targetCtxRegular hTargetRegular
  rw [hTarget] at hTargetRegular
  cases hTargetRegular
  exact hLayout

theorem of_parts_never_regular_source {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    {targetResult : Locals.Outcome × Locals.Ctx}
    (hSource :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok sourceResult)
    (hTarget :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok targetResult)
