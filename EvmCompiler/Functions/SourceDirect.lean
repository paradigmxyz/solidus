theorem runOpen_cons_from_stmtRunResult
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxAfter : Source.Ctx}
    {targetCtx targetCtxAfter : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {sourceHead : Source.Outcome} {targetHead : Locals.Outcome}
    (hSourceHead :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (sourceHead, sourceCtxAfter))
    (hTargetHead :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok (targetHead, targetCtxAfter))
    (hHeadRel :
      StmtRunResultRel retc returns hiddenReturns
        (sourceHead, sourceCtxAfter) (targetHead, targetCtxAfter))
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hTail :
      ∀ {sourceMid : Source.State} {targetMid : Locals.RunState},
        sourceHead = Source.Outcome.regular sourceMid →
        targetHead = Structured.Outcome.regular targetMid →
          ∃ sourceResult targetResult,
            Source.Block.runOpen prim program sourceCtxAfter fuel
                { stmts := rest } sourceMid =
              .ok sourceResult ∧
            Direct.Block.runOpen program returns targetCtxAfter fuel
                { stmts := rest } targetMid =
              .ok targetResult ∧
            BlockOpenResultRel retc returns hiddenReturns
              sourceResult targetResult) :
    ∃ sourceResult targetResult,
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := stmt :: rest } source =
        .ok sourceResult ∧
      Direct.Block.runOpen program returns targetCtx (fuel + 1)
          { stmts := stmt :: rest } target =
        .ok targetResult ∧
      BlockOpenResultRel retc returns hiddenReturns
        sourceResult targetResult := by
  cases sourceHead with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          cases targetHead with
          | mk targetState targetMode =>
              cases targetMode with
              | regular =>
                  rcases hTail rfl rfl with
                    ⟨sourceResult, targetResult, hSourceTail, hTargetTail,
                      hTailRel⟩
                  rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
                  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
                  rcases
                      runOpen_cons_regular_from_stmtRunResult
                        (retc := retc) (returns := returns)
                        (hiddenReturns := hiddenReturns)
                        hSourceHead hTargetHead hHeadRel
                        hSourceTail hTargetTail hTailRel with
                    ⟨hSource, hTarget, hRel⟩
                  exact
                    ⟨(sourceOutcome, sourceCtxOut),
                      (targetOutcome, targetCtxOut), hSource, hTarget, hRel⟩
              | brk =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
              | cont =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
              | leave =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
              | halt kind =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
      | brk =>
          cases targetHead with
          | mk targetState targetMode =>
              have hNonregular :
                  ({ state := sourceState, mode := Locals.Source.Mode.brk } :
                    Source.Outcome).mode ≠ .regular := by simp
              rcases
                  runOpen_cons_nonregular_from_stmtRunResult
                    (retc := retc) (returns := returns)
                    (hiddenReturns := hiddenReturns)
                    hSourceHead hTargetHead hHeadRel hCtx hNonregular with
                ⟨hSource, hTarget, hRel⟩
              exact
                ⟨({ state := sourceState, mode := Locals.Source.Mode.brk },
                    sourceCtx),
                  ({ state := targetState, mode := targetMode }, targetCtx),
                  hSource, hTarget, hRel⟩
      | cont =>
          cases targetHead with
          | mk targetState targetMode =>
              have hNonregular :
                  ({ state := sourceState, mode := Locals.Source.Mode.cont } :
                    Source.Outcome).mode ≠ .regular := by simp
              rcases
                  runOpen_cons_nonregular_from_stmtRunResult
                    (retc := retc) (returns := returns)
                    (hiddenReturns := hiddenReturns)
                    hSourceHead hTargetHead hHeadRel hCtx hNonregular with
                ⟨hSource, hTarget, hRel⟩
              exact
                ⟨({ state := sourceState, mode := Locals.Source.Mode.cont },
                    sourceCtx),
                  ({ state := targetState, mode := targetMode }, targetCtx),
                  hSource, hTarget, hRel⟩
      | leave =>
          cases targetHead with
          | mk targetState targetMode =>
              have hNonregular :
                  ({ state := sourceState, mode := Locals.Source.Mode.leave } :
                    Source.Outcome).mode ≠ .regular := by simp
              rcases
                  runOpen_cons_nonregular_from_stmtRunResult
                    (retc := retc) (returns := returns)
                    (hiddenReturns := hiddenReturns)
                    hSourceHead hTargetHead hHeadRel hCtx hNonregular with
                ⟨hSource, hTarget, hRel⟩
              exact
                ⟨({ state := sourceState, mode := Locals.Source.Mode.leave },
                    sourceCtx),
                  ({ state := targetState, mode := targetMode }, targetCtx),
                  hSource, hTarget, hRel⟩
      | halt kind =>
          cases targetHead with
          | mk targetState targetMode =>
              have hNonregular :
                  (Source.Outcome.halt kind sourceState).mode ≠
                    .regular := by
                simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
              rcases
                  runOpen_cons_nonregular_from_stmtRunResult
                    (retc := retc) (returns := returns)
                    (hiddenReturns := hiddenReturns)
                    hSourceHead hTargetHead hHeadRel hCtx hNonregular with
                ⟨hSource, hTarget, hRel⟩
              exact
                ⟨(Source.Outcome.halt kind sourceState, sourceCtx),
                  ({ state := targetState, mode := targetMode }, targetCtx),
                  hSource, hTarget, hRel⟩

theorem runOpen_cons_from_stmtRunBridge
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    (hHead :
      StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
        hiddenReturns stmt source target)
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hTail :
      ∀ {sourceMid : Source.State} {targetMid : Locals.RunState}
        {sourceCtxMid : Source.Ctx} {targetCtxMid : Locals.Ctx},
        StateRel targetCtxMid.layout hiddenReturns sourceMid targetMid →
        CtxRel retc sourceCtxMid targetCtxMid →
          BlockOpenRunBridge prim program returns retc fuel
            sourceCtxMid targetCtxMid hiddenReturns { stmts := rest }
            sourceMid targetMid) :
    BlockOpenRunBridge prim program returns retc (fuel + 1)
      sourceCtx targetCtx hiddenReturns { stmts := stmt :: rest }
      source target := by
  rcases hHead with
    ⟨sourceHeadResult, targetHeadResult, hSourceHead, hTargetHead, hHeadRel⟩
  rcases sourceHeadResult with ⟨sourceHead, sourceCtxAfter⟩
  rcases targetHeadResult with ⟨targetHead, targetCtxAfter⟩
  rcases
      runOpen_cons_from_stmtRunResult
        (retc := retc) (returns := returns)
        (hiddenReturns := hiddenReturns)
        (sourceCtxAfter := sourceCtxAfter)
        (targetCtxAfter := targetCtxAfter)
        (sourceHead := sourceHead) (targetHead := targetHead)
        (stmt := stmt) (rest := rest)
        hSourceHead hTargetHead hHeadRel hCtx
        (by
          intro sourceMid targetMid hSourceHeadRegular hTargetHeadRegular
          subst sourceHead
          subst targetHead
          rcases StmtRunResultRel.regular_stateRel hHeadRel with
            ⟨hStateRel, hCtxRel⟩
          exact hTail hStateRel hCtxRel) with
    ⟨sourceResult, targetResult, hSource, hTarget, hRel⟩
  exact
    BlockOpenRunBridge.of_parts hSource hTarget hRel

theorem runOpen_cons_from_stmtRunBridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    (hHead :
      StmtRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns stmt source target)
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hTail :
      ∀ {sourceMid : Source.State} {targetMid : Locals.RunState}
        {sourceCtxMid : Source.Ctx} {targetCtxMid : Locals.Ctx},
        StateRel targetCtxMid.layout hiddenReturns sourceMid targetMid →
        CtxRel retc sourceCtxMid targetCtxMid →
          BlockOpenRunBridgeWithLayout prim program returns retc fuel
            sourceCtxMid targetCtxMid hiddenReturns { stmts := rest }
            sourceMid targetMid) :
    BlockOpenRunBridgeWithLayout prim program returns retc (fuel + 1)
      sourceCtx targetCtx hiddenReturns { stmts := stmt :: rest }
      source target := by
  refine
    BlockOpenRunBridgeWithLayout.of_bridge_and_layout
      (runOpen_cons_from_stmtRunBridge
        (prim := prim) (program := program) (returns := returns)
        (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
        (targetCtx := targetCtx) (source := source) (target := target)
        (hiddenReturns := hiddenReturns) (stmt := stmt) (rest := rest)
        (StmtRunBridgeWithLayout.to_bridge hHead) hCtx
        (by
          intro sourceMid targetMid sourceCtxMid targetCtxMid
            hStateRel hCtxRel
          exact
            BlockOpenRunBridgeWithLayout.to_bridge
              (hTail hStateRel hCtxRel)))
      ?hLayout
  intro sourceInner sourceCtxOut targetInner targetCtxOut
    hSourceCons hTargetCons hConsRel
  rcases StmtRunBridgeWithLayout.to_bridge hHead with
    ⟨sourceHeadResult, targetHeadResult, hSourceHead, hTargetHead, hHeadRel⟩
  rcases sourceHeadResult with ⟨sourceHead, sourceCtxAfter⟩
  rcases targetHeadResult with ⟨targetHead, targetCtxAfter⟩
  cases sourceHead with
  | mk sourceHeadState sourceHeadMode =>
      cases sourceHeadMode with
      | regular =>
          cases targetHead with
          | mk targetHeadState targetHeadMode =>
              cases targetHeadMode with
              | regular =>
                  have hSourceTail :
                      Source.Block.runOpen prim program sourceCtxAfter fuel
                          { stmts := rest } sourceHeadState =
                        .ok
                          (Source.Outcome.regular sourceInner, sourceCtxOut) :=
                    by
                      simpa [Source.Block.runOpen, hSourceHead]
                        using hSourceCons
                  have hTargetTail :
                      Direct.Block.runOpen program returns targetCtxAfter fuel
                          { stmts := rest } targetHeadState =
                        .ok
                          (Structured.Outcome.regular targetInner,
                            targetCtxOut) := by
                    simpa [Direct.Block.runOpen, hTargetHead]
                      using hTargetCons
                  have hHeadLayout :
                      CleanupLayoutRel targetCtxAfter.layout
                        targetCtx.layout :=
                    StmtRunBridgeWithLayout.regular_layout hHead
                      hSourceHead hTargetHead hHeadRel
                  rcases StmtRunResultRel.regular_stateRel hHeadRel with
                    ⟨hStateRel, hCtxRel⟩
                  have hTailBridge :
                      BlockOpenRunBridgeWithLayout prim program returns retc
                        fuel sourceCtxAfter targetCtxAfter hiddenReturns
                        { stmts := rest } sourceHeadState targetHeadState :=
                    hTail hStateRel hCtxRel
                  have hTailLayout :
                      CleanupLayoutRel targetCtxOut.layout
                        targetCtxAfter.layout :=
                    BlockOpenRunBridgeWithLayout.regular_layout hTailBridge
                      hSourceTail hTargetTail hConsRel
                  exact CleanupLayoutRel.trans hTailLayout hHeadLayout
              | brk =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
              | cont =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
              | leave =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
              | halt kind =>
                  exact False.elim (by
                    simpa [StmtRunResultRel, StmtOutcomeRel] using hHeadRel)
      | brk =>
          have hBad :
              ({ state := sourceHeadState, mode := Locals.Source.Mode.brk } :
                Source.Outcome) =
                Source.Outcome.regular sourceInner := by
            have hPair :
                ({ state := sourceHeadState, mode := Locals.Source.Mode.brk } :
                  Source.Outcome) = Source.Outcome.regular sourceInner ∧
                  sourceCtx = sourceCtxOut := by
              simpa [Source.Block.runOpen, hSourceHead] using hSourceCons
            exact hPair.1
          cases hBad
      | cont =>
          have hBad :
              ({ state := sourceHeadState, mode := Locals.Source.Mode.cont } :
                Source.Outcome) =
                Source.Outcome.regular sourceInner := by
            have hPair :
                ({ state := sourceHeadState, mode := Locals.Source.Mode.cont } :
                  Source.Outcome) = Source.Outcome.regular sourceInner ∧
                  sourceCtx = sourceCtxOut := by
              simpa [Source.Block.runOpen, hSourceHead] using hSourceCons
            exact hPair.1
          cases hBad
      | leave =>
          have hBad :
              ({ state := sourceHeadState, mode := Locals.Source.Mode.leave } :
                Source.Outcome) =
                Source.Outcome.regular sourceInner := by
            have hPair :
                ({ state := sourceHeadState, mode := Locals.Source.Mode.leave } :
                  Source.Outcome) = Source.Outcome.regular sourceInner ∧
                  sourceCtx = sourceCtxOut := by
              simpa [Source.Block.runOpen, hSourceHead] using hSourceCons
            exact hPair.1
          cases hBad
      | halt kind =>
          have hBad :
              (Source.Outcome.halt kind sourceHeadState : Source.Outcome) =
                Source.Outcome.regular sourceInner := by
            have hPair :
                (Source.Outcome.halt kind sourceHeadState : Source.Outcome) =
                    Source.Outcome.regular sourceInner ∧
                  sourceCtx = sourceCtxOut := by
              simpa [Source.Block.runOpen, hSourceHead] using hSourceCons
            exact hPair.1
          cases hBad

theorem runOpen_cons_from_source_run_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
