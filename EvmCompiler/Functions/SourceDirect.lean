                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | leave =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
