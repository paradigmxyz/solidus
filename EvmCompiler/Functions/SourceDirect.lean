  rcases SourceRun.block_runScoped_open_exists hSourceScoped with
    ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
  rcases
      BlockOpenRunBridgeWithLayout.target_result_of_source hOpen
        hSourceOpen with
    ⟨targetResult, hTargetOpen, hOpenRel⟩
  rcases targetResult with ⟨targetOpen, targetCtxOut⟩
  cases sourceOpen with
  | mk sourceOpenState sourceOpenMode =>
      cases sourceOpenMode with
      | regular =>
          cases targetOpen with
          | mk targetOpenState targetOpenMode =>
              cases targetOpenMode with
              | regular =>
                  have hLayout :
                      CleanupLayoutRel targetCtxOut.layout
                        targetCtx.layout :=
                    BlockOpenRunBridgeWithLayout.regular_layout hOpen
                      hSourceOpen hTargetOpen hOpenRel
