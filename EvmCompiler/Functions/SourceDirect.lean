  cases hSourceScoped :
      Source.Block.runScoped prim program sourceCtx body fuel source with
  | error err =>
      simp [Source.Stmt.run, hSourceScoped] at hSourceRun
  | ok sourceOutcome =>
      have hSourceStmt :
          Source.Stmt.run prim program sourceCtx fuel (.block body) source =
            .ok (sourceOutcome, sourceCtx) := by
        simp [Source.Stmt.run, hSourceScoped]
      rcases
          runScoped_from_source_run_with_loop_invariant_callback_cleanup
            (prim := prim) (program := program) (returns := returns)
            (loopLayout := loopLayout) (retc := retc) (fuel := fuel)
            (sourceCtx := sourceCtx) (targetCtx := targetCtx) (source := source)
            (target := target) (hiddenReturns := hiddenReturns) (block := body)
            (sourceOutcome := sourceOutcome) hLeaveFrame hSourceScoped hInv hCtx
            hRel hLoopCleanup hStmt with
        ⟨targetOutcome, hTargetScoped, hOutcomeRel⟩
      have hTargetStmt :
          Direct.Stmt.run program returns targetCtx fuel (.block body) target =
            .ok (targetOutcome, targetCtx) := by
        simp [Direct.Stmt.run, hTargetScoped]
      exact
        LoopStmtRunBridgeWithLayout.of_loop_result_same_ctx
          (prim := prim) (program := program) (returns := returns)
          (loopLayout := loopLayout) (retc := retc) (fuel := fuel)
          (sourceCtx := sourceCtx) (targetCtx := targetCtx) (source := source)
          (target := target) (hiddenReturns := hiddenReturns)
          (stmt := .block body) (sourceOutcome := sourceOutcome)
          (targetOutcome := targetOutcome) hSourceStmt hTargetStmt
          hOutcomeRel

theorem block_nonregular_stmtRunResult_from_open
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxOut : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    {body : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel body source =
        .ok (sourceOutcome, sourceCtxOut))
    (hTargetOpen :
      Direct.Block.runOpen program returns targetCtx fuel body target =
        .ok (targetOutcome, targetCtxOut))
    (hOpenRel :
      BlockOpenResultRel retc returns hiddenReturns
        (sourceOutcome, sourceCtxOut) (targetOutcome, targetCtxOut))
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    Source.Stmt.run prim program sourceCtx fuel (.block body) source =
      .ok (sourceOutcome, sourceCtx) ∧
    Direct.Stmt.run program returns targetCtx fuel (.block body) target =
      .ok (targetOutcome, targetCtx) ∧
    StmtRunResultRel retc returns hiddenReturns
      (sourceOutcome, sourceCtx) (targetOutcome, targetCtx) := by
  rcases runScoped_nonregular_from_open
      (prim := prim) (program := program) (returns := returns)
      (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
      (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
      (targetCtxOut := targetCtxOut) (source := source) (target := target)
      (hiddenReturns := hiddenReturns) (sourceOutcome := sourceOutcome)
      (targetOutcome := targetOutcome) (block := body)
      hSourceOpen hTargetOpen hOpenRel hNonregular with
    ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
  refine ⟨?hSource, ?hTarget, ?hRel⟩
  · simp [Source.Stmt.run, hSourceScoped]
  · simp [Direct.Stmt.run, hTargetScoped]
  · exact StmtRunResultRel.of_nonregular hOutcomeRel hCtx hNonregular

theorem block_stmtRunBridge_from_open_bridge
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {body : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hOpen :
      BlockOpenRunBridge prim program returns retc fuel sourceCtx targetCtx
        hiddenReturns body source target)
    (hRegularLayout :
      ∀ {sourceInner sourceCtxOut targetInner targetCtxOut},
        Source.Block.runOpen prim program sourceCtx fuel body source =
          .ok (Source.Outcome.regular sourceInner, sourceCtxOut) →
        Direct.Block.runOpen program returns targetCtx fuel body target =
          .ok (Structured.Outcome.regular targetInner, targetCtxOut) →
        BlockOpenResultRel retc returns hiddenReturns
          (Source.Outcome.regular sourceInner, sourceCtxOut)
          (Structured.Outcome.regular targetInner, targetCtxOut) →
        CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) source target := by
  rcases hOpen with
    ⟨sourceResult, targetResult, hSourceOpen, hTargetOpen, hOpenRel⟩
  rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          cases targetOutcome with
          | mk targetState targetMode =>
              cases targetMode with
              | regular =>
                  have hLayout :
                      CleanupLayoutRel targetCtxOut.layout
                        targetCtx.layout :=
                    hRegularLayout hSourceOpen hTargetOpen hOpenRel
                  rcases
                      block_regular_stmtRunResult_from_open
                        (prim := prim) (program := program)
                        (returns := returns) (retc := retc) (fuel := fuel)
                        (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtxOut)
                        (targetCtx := targetCtx) (targetCtxOut := targetCtxOut)
                        (source := source) (sourceInner := sourceState)
                        (target := target) (targetInner := targetState)
                        (hiddenReturns := hiddenReturns) (body := body)
                        hCtx hSourceOpen hTargetOpen hOpenRel hLayout with
                    ⟨targetScoped, hSource, hTarget, hRel⟩
                  exact StmtRunBridge.of_parts hSource hTarget hRel
              | brk =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | cont =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | leave =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
              | halt kind =>
                  exact False.elim (by
                    simpa [BlockOpenResultRel, StmtOutcomeRel] using hOpenRel)
      | brk =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.brk } :
                Source.Outcome).mode ≠ .regular := by
            simp
          rcases
              block_nonregular_stmtRunResult_from_open
                (prim := prim) (program := program) (returns := returns)
                (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
                (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
                (targetCtxOut := targetCtxOut) (source := source)
                (target := target) (hiddenReturns := hiddenReturns)
                (sourceOutcome :=
                  { state := sourceState, mode := Locals.Source.Mode.brk })
                (targetOutcome := targetOutcome) (body := body)
                hCtx hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSource, hTarget, hRel⟩
          exact StmtRunBridge.of_parts hSource hTarget hRel
      | cont =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.cont } :
                Source.Outcome).mode ≠ .regular := by
            simp
          rcases
              block_nonregular_stmtRunResult_from_open
                (prim := prim) (program := program) (returns := returns)
                (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
                (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
                (targetCtxOut := targetCtxOut) (source := source)
                (target := target) (hiddenReturns := hiddenReturns)
                (sourceOutcome :=
                  { state := sourceState, mode := Locals.Source.Mode.cont })
                (targetOutcome := targetOutcome) (body := body)
                hCtx hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSource, hTarget, hRel⟩
          exact StmtRunBridge.of_parts hSource hTarget hRel
      | leave =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          rcases
              block_nonregular_stmtRunResult_from_open
                (prim := prim) (program := program) (returns := returns)
                (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
                (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
                (targetCtxOut := targetCtxOut) (source := source)
                (target := target) (hiddenReturns := hiddenReturns)
                (sourceOutcome :=
                  { state := sourceState, mode := Locals.Source.Mode.leave })
                (targetOutcome := targetOutcome) (body := body)
                hCtx hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSource, hTarget, hRel⟩
          exact StmtRunBridge.of_parts hSource hTarget hRel
      | halt kind =>
          have hNonregular :
              (Source.Outcome.halt kind sourceState).mode ≠ .regular := by
            simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
          rcases
              block_nonregular_stmtRunResult_from_open
                (prim := prim) (program := program) (returns := returns)
                (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
                (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
                (targetCtxOut := targetCtxOut) (source := source)
                (target := target) (hiddenReturns := hiddenReturns)
                (sourceOutcome := Source.Outcome.halt kind sourceState)
                (targetOutcome := targetOutcome) (body := body)
                hCtx hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSource, hTarget, hRel⟩
          exact StmtRunBridge.of_parts hSource hTarget hRel

theorem block_stmtRunBridge_from_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {body : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hOpen :
      BlockOpenRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns body source target) :
    StmtRunBridge prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) source target :=
  block_stmtRunBridge_from_open_bridge
    (prim := prim) (program := program) (returns := returns)
    (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
    (targetCtx := targetCtx) (source := source) (target := target)
    (hiddenReturns := hiddenReturns) (body := body)
    hCtx (BlockOpenRunBridgeWithLayout.to_bridge hOpen)
    (by
      intro sourceInner sourceCtxOut targetInner targetCtxOut
        hSource hTarget hRel
      exact
        BlockOpenRunBridgeWithLayout.regular_layout hOpen
          hSource hTarget hRel)

theorem block_stmtRunBridgeWithLayout_from_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {body : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hOpen :
      BlockOpenRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns body source target) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) source target := by
  refine
    StmtRunBridgeWithLayout.of_bridge_and_regular_target_layout
      (block_stmtRunBridge_from_open_bridge_with_layout
        (prim := prim) (program := program) (returns := returns)
        (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
        (targetCtx := targetCtx) (source := source) (target := target)
        (hiddenReturns := hiddenReturns) (body := body) hCtx hOpen)
      ?hLayout
  intro targetInner targetCtxOut hTarget
  cases hScoped :
      Direct.Block.runScoped program returns targetCtx body fuel target with
  | error err =>
      simp [Direct.Stmt.run, hScoped] at hTarget
  | ok targetOutcome =>
      simp [Direct.Stmt.run, hScoped] at hTarget
      cases hTarget.2
      exact CleanupLayoutRel.refl targetCtx.layout

theorem block_stmtRunBridge_from_source_run_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {body : Block} {sourceResult : Source.Outcome × Source.Ctx}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceRun :
      Source.Stmt.run prim program sourceCtx fuel (.block body) source =
        .ok sourceResult)
    (hOpen :
      BlockOpenRunBridgeWithLayout prim program returns retc fuel
        sourceCtx targetCtx hiddenReturns body source target) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) source target :=
  block_stmtRunBridgeWithLayout_from_open_bridge_with_layout
    (prim := prim) (program := program) (returns := returns)
    (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
    (targetCtx := targetCtx) (source := source) (target := target)
    (hiddenReturns := hiddenReturns) (body := body) hCtx hOpen

theorem block_stmtRunBridge_from_exact_source_run_with_layout
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {body : Block} {sourceResult : Source.Outcome × Source.Ctx}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceRun :
      Source.Stmt.run prim program sourceCtx fuel (.block body) source =
        .ok sourceResult)
    (hOpen :
      ∀ {sourceOpen : Source.Outcome} {sourceCtxOut : Source.Ctx},
        Source.Block.runOpen prim program sourceCtx fuel body source =
          .ok (sourceOpen, sourceCtxOut) →
        BlockOpenRunBridgeWithLayout prim program returns retc fuel
          sourceCtx targetCtx hiddenReturns body source target) :
    StmtRunBridgeWithLayout prim program returns retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) source target := by
  cases hScoped :
      Source.Block.runScoped prim program sourceCtx body fuel source with
  | error err =>
      simp [Source.Stmt.run, hScoped] at hSourceRun
  | ok scopedOutcome =>
      rcases SourceRun.block_runScoped_open_exists hScoped with
        ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
      exact
        block_stmtRunBridge_from_source_run_with_layout
          (prim := prim) (program := program) (returns := returns)
          (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
          (targetCtx := targetCtx) (source := source) (target := target)
          (hiddenReturns := hiddenReturns) (body := body)
          (sourceResult := sourceResult) hCtx hSourceRun
          (hOpen hSourceOpen)

end Block

