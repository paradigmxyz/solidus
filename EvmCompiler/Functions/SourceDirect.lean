    {source sourceAfterCond : Source.State}
    {target targetAfterCond : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {body : Block}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hSourceCond :
      Source.Expr.evalCondition prim cond source = .ok (sourceAfterCond, true))
    (hTargetCond :
      Locals.Direct.Expr.runCondition targetCtx cond target =
        .ok (targetAfterCond, true))
    (hCondRel :
      StateRel targetCtx.layout hiddenReturns sourceAfterCond targetAfterCond)
    (hOpen :
      BlockOpenRunBridgeWithLayout prim program returns retc fuel sourceCtx
        targetCtx hiddenReturns body sourceAfterCond targetAfterCond) :
    StmtRunBridgeWithLayout prim program returns retc (fuel + 1)
      sourceCtx targetCtx hiddenReturns (.if_ cond body) source target := by
  rcases BlockOpenRunBridgeWithLayout.to_bridge hOpen with
    ⟨sourceOpenResult, targetOpenResult, hSourceOpen, hTargetOpen, hOpenRel⟩
  rcases sourceOpenResult with ⟨sourceOutcome, sourceCtxOut⟩
  rcases targetOpenResult with ⟨targetOutcome, targetCtxOut⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          cases targetOutcome with
          | mk targetState targetMode =>
              cases targetMode with
              | regular =>
                  have hLayout :
                      CleanupLayoutRel targetCtxOut.layout
                        targetCtx.layout :=
                    BlockOpenRunBridgeWithLayout.regular_layout hOpen
                      hSourceOpen hTargetOpen hOpenRel
