theorem block_runOpen_regular_scope {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {block : Block} {state sourceInner : Source.State}
    (hRun :
      Source.Block.runOpen prim program ctx fuel block state =
        .ok (Source.Outcome.regular sourceInner, ctxOut)) :
    ctxOut.scope = Scope.Block.outEnv ctx.scope block := by
  cases block with
  | mk stmts =>
      induction fuel generalizing ctx state stmts with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid]
            at hRun
      | succ fuel ih =>
          cases stmts with
          | nil =>
              simp [Source.Block.runOpen, Scope.Block.outEnv,
                Scope.StmtList.outEnv] at hRun
              rcases hRun with ⟨_hState, hCtxEq⟩
              subst ctxOut
              rfl
          | cons stmt rest =>
              cases hHead :
                  Source.Stmt.run prim program ctx fuel stmt state with
              | error err =>
                  simp [Source.Block.runOpen, hHead] at hRun
              | ok headResult =>
                  rcases headResult with ⟨headOutcome, ctxMid⟩
                  cases headOutcome with
                  | mk headState headMode =>
                      cases headMode with
                      | regular =>
                          have hTail :
                              Source.Block.runOpen prim program ctxMid fuel
                                  { stmts := rest } headState =
                                .ok (Source.Outcome.regular sourceInner,
                                  ctxOut) := by
                            simpa [Source.Block.runOpen, hHead] using hRun
                          have hMidScope :
                              ctxMid.scope =
                                Scope.Stmt.outEnv ctx.scope stmt :=
                            stmt_regular_scope hHead
                          have hTailScope :=
                            ih (ctx := ctxMid) (state := headState)
                              (stmts := rest) hTail
                          simpa [Scope.Block.outEnv, Scope.StmtList.outEnv,
                            hMidScope] using hTailScope
                      | brk =>
                          simp [Source.Block.runOpen, hHead] at hRun
                          cases hRun.1
                      | cont =>
                          simp [Source.Block.runOpen, hHead] at hRun
                          cases hRun.1
                      | leave =>
                          simp [Source.Block.runOpen, hHead] at hRun
                          cases hRun.1
                      | halt kind =>
                          simp [Source.Block.runOpen, hHead] at hRun
                          cases hRun.1

