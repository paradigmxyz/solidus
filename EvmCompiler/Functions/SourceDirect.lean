                  hInv hRun hCtx hRel)
            (by
              intro subFuel sourceCtx targetCtx source target stmt
                sourceResult hSub hStmtLeaveFrame hStmtInv hStmtRun hCtx hRel
              exact
                Stmt.stmtRunBridge_from_source_run_invariant_with_for_callback_dispatchers_bounded
                  (prim := prim) hPrim (program := program)
                  (returns := fn.returns) (retc := fn.returns.length)
                  (maxFuel := callFuel) (fuel := subFuel)
                  (sourceCtx := sourceCtx) (targetCtx := targetCtx)
                  (source := source) (target := target)
                  (hiddenReturns :=
                    { callerStack := callerBase.evm.stack,
                      retc := fn.returns.length } :: hiddenReturns)
                    (stmt := stmt) (sourceResult := sourceResult)
                    hFunctionsScoped hFunctionBounds rfl hStmtLeaveFrame
                    hCtx hStmtInv hRel hStmtRun hSub
                  (by
                    intro subFuel' sourceCtx targetCtx source target block
                      sourceResult hSub' hLocalLeaveFrame hInv hRun hCtx hRel
                    exact
                      (callbacks (returns := fn.returns)
                        (retc := fn.returns.length)
                        (hiddenReturns :=
                          { callerStack := callerBase.evm.stack,
                            retc := fn.returns.length } :: hiddenReturns)
                        rfl).block
                        (Nat.le_trans hSub' hFuelPred)
                        hLocalLeaveFrame hInv hRun hCtx hRel)
                  (by
                    intro loopLayout subFuel' sourceCtx targetCtx source
                      target block sourceResult hSub' hLocalLeaveFrame hInv
                      hRun hBreak hContinue hCtx hRel hCleanup
                    exact
                      (callbacks (returns := fn.returns)
                        (retc := fn.returns.length)
                        (hiddenReturns :=
                          { callerStack := callerBase.evm.stack,
                            retc := fn.returns.length } :: hiddenReturns)
                        rfl).loopBlock
                        (Nat.le_trans hSub' hFuelPred)
                        hLocalLeaveFrame hInv hRun hBreak hContinue hCtx hRel
                        hCleanup)
                  (by
                    intro subFuel' sourceCtx targetCtx source target init post
                      body cond sourceResult hSub' hLocalLeaveFrame hInv hRun
                      hCtx hRel
                    exact
                      (callbacks (returns := fn.returns)
                        (retc := fn.returns.length)
                        (hiddenReturns :=
                          { callerStack := callerBase.evm.stack,
                            retc := fn.returns.length } :: hiddenReturns)
                        rfl).forStmt
                        (Nat.le_trans hSub' hFuelPred)
                        hLocalLeaveFrame hInv hRun hCtx hRel)
                  (by
                    intro nestedFuel nestedName nestedSourceAfterArgs
                      nestedArgValues nestedFn nestedParamStore
                      nestedTargetAfterInit nestedBodyOutcome
                      nestedSourceCtxOut nestedCallerBase hNestedFuel
                      hNestedFind hNestedParams _hNestedArgCallerBound
                      hNestedRun hNestedRel
                    exact
                      callBody_from_all_upTo callbacks hFunctionsScoped
                        hFunctionBounds
                        (hFuel := Nat.le_trans hNestedFuel hFuelPred)
                        hNestedFind hNestedParams hNestedRun hNestedRel))

theorem all_upTo {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program}
    (hFunctionsScoped : Functions.FunList.Scoped program.functions)
    (hFunctionBounds : FrameBound.FunList program.functions) :
    ∀ maxFuel {returns : List Name} {retc : Nat}
      {hiddenReturns : List Structured.ReturnDest},
      returns.length = retc →
        RecursiveCallbacksUpTo prim program returns retc hiddenReturns
          maxFuel := by
  intro maxFuel
  induction maxFuel with
  | zero =>
      intro returns retc hiddenReturns hReturnsLen
      exact RecursiveCallbacksUpTo.zero
  | succ maxFuel ih =>
      intro returns retc hiddenReturns hReturnsLen
      exact
        RecursiveCallbacksUpTo.succ_all (prim := prim) hPrim
          (program := program) hFunctionsScoped hFunctionBounds
          (maxFuel := maxFuel)
          (by
            intro returns retc hiddenReturns hReturnsLen
            exact
              ih (returns := returns) (retc := retc)
                (hiddenReturns := hiddenReturns) hReturnsLen)
          hReturnsLen

end RecursiveCallbacksUpTo

namespace RecursiveCallbacks

theorem to_upTo {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc maxFuel : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    (callbacks : RecursiveCallbacks prim program returns retc hiddenReturns) :
    RecursiveCallbacksUpTo prim program returns retc hiddenReturns
      maxFuel := by
  refine
    { block := ?_
      loopBlock := ?_
      forStmt := ?_
      callBody := ?_ }
  · intro fuel sourceCtx targetCtx source target block sourceResult _hFuel
      hLeaveFrame hInv hSourceRun hCtx hRel
    exact callbacks.block hLeaveFrame hInv hSourceRun hCtx hRel
  · intro loopLayout fuel sourceCtx targetCtx source target block sourceResult
      _hFuel hLeaveFrame hInv hSourceRun hBreakDepth hContinueDepth hCtx hRel
      hCleanup
    exact callbacks.loopBlock hLeaveFrame hInv hSourceRun hBreakDepth
      hContinueDepth hCtx hRel hCleanup
  · intro fuel sourceCtx targetCtx source target init post body cond sourceResult
      _hFuel hLeaveFrame hInv hSourceRun hCtx hRel
    exact callbacks.forStmt hLeaveFrame hInv hSourceRun hCtx hRel
  · intro callFuel functionName sourceAfterArgs argValues fn paramStore
      targetAfterInit bodyOutcome sourceCtxOut callerBase _hFuel hFind hParams
      hArgCallerBound hSourceRun hRel
    exact callbacks.callBody hFind hParams hArgCallerBound hSourceRun hRel

theorem of_forall_upTo {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name} {retc : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    (callbacks :
      ∀ maxFuel,
        RecursiveCallbacksUpTo prim program returns retc hiddenReturns
          maxFuel) :
    RecursiveCallbacks prim program returns retc hiddenReturns := by
  refine
    { block := ?_
      loopBlock := ?_
      forStmt := ?_
      callBody := ?_ }
  · intro fuel sourceCtx targetCtx source target block sourceResult
      hLeaveFrame hInv hSourceRun hCtx hRel
    exact
      (callbacks fuel).block (Nat.le_refl fuel) hLeaveFrame hInv hSourceRun
        hCtx hRel
  · intro loopLayout fuel sourceCtx targetCtx source target block sourceResult
      hLeaveFrame hInv hSourceRun hBreakDepth hContinueDepth hCtx hRel
      hCleanup
    exact
      (callbacks fuel).loopBlock (Nat.le_refl fuel) hLeaveFrame hInv
        hSourceRun hBreakDepth hContinueDepth hCtx hRel hCleanup
  · intro fuel sourceCtx targetCtx source target init post body cond
      sourceResult hLeaveFrame hInv hSourceRun hCtx hRel
    exact
      (callbacks fuel).forStmt (Nat.le_refl fuel) hLeaveFrame hInv
        hSourceRun hCtx hRel
  · intro callFuel functionName sourceAfterArgs argValues fn paramStore
      targetAfterInit bodyOutcome sourceCtxOut callerBase hFind hParams
      hArgCallerBound hSourceRun hRel
    exact
      (callbacks callFuel).callBody (Nat.le_refl callFuel) hFind hParams
        hArgCallerBound hSourceRun hRel

theorem constructed {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {returns : List Name} {retc : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    (hFunctionsScoped : Functions.FunList.Scoped program.functions)
    (hFunctionBounds : FrameBound.FunList program.functions)
    (hReturnsLen : returns.length = retc) :
    RecursiveCallbacks prim program returns retc hiddenReturns := by
  exact
    of_forall_upTo
      (prim := prim) (program := program) (returns := returns)
      (retc := retc) (hiddenReturns := hiddenReturns)
      (fun maxFuel =>
        RecursiveCallbacksUpTo.all_upTo (prim := prim) hPrim
          (program := program) hFunctionsScoped hFunctionBounds maxFuel
          hReturnsLen)

