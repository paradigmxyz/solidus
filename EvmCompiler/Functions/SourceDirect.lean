theorem runOpen_cons_nonregular_from_loopStmtRunResult
    {prim : Source.PrimitiveSemantics}
    {program : Program} {returns loopLayout : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxAfter : Source.Ctx}
    {targetCtx targetCtxAfter : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    (hSourceHead :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (sourceOutcome, sourceCtxAfter))
    (hTargetHead :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok (targetOutcome, targetCtxAfter))
    (hHeadRel :
      LoopStmtRunResultRel retc returns loopLayout hiddenReturns
        (sourceOutcome, sourceCtxAfter) (targetOutcome, targetCtxAfter))
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    Source.Block.runOpen prim program sourceCtx (fuel + 1)
        { stmts := stmt :: rest } source =
      .ok (sourceOutcome, sourceCtx) ∧
    Direct.Block.runOpen program returns targetCtx (fuel + 1)
        { stmts := stmt :: rest } target =
      .ok (targetOutcome, targetCtx) ∧
    LoopBlockOpenResultRel retc returns loopLayout hiddenReturns
      (sourceOutcome, sourceCtx) (targetOutcome, targetCtx) := by
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [Source.Block.runOpen, Direct.Block.runOpen, hSourceHead,
              hTargetHead, LoopStmtRunResultRel, LoopBlockOpenResultRel,
              StmtOutcomeRel] at hHeadRel hNonregular ⊢
          all_goals
            first
            | exact False.elim hHeadRel
            | exact False.elim hNonregular
            | exact ⟨hHeadRel.1, hCtx⟩

