                      (sourceInner := sourceState) (target := target)
                      (targetAfterCond := targetAfterCond)
                      (targetInner := targetState)
                      (hiddenReturns := hiddenReturns) (cond := cond)
                      (body := body) hCtx hSourceCond hTargetCond hCondRel
                      hSourceOpen hTargetOpen hOpenRel hLayout
