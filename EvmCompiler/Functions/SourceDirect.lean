theorem brk_bridge {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState} {fuel : Nat}
    {hiddenReturns : List Structured.ReturnDest} {breakScope : List Name}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hBreak : sourceCtx.breakScope? = some breakScope)
    (hRel : StateRel targetCtx.layout hiddenReturns source target) :
    ∃ targetAfter,
      Source.Stmt.run prim program sourceCtx fuel .brk source =
        .ok
          (Source.Outcome.brk
            (Locals.Source.State.restrictTo breakScope source),
            sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx fuel .brk target =
        .ok (Structured.Outcome.brk targetAfter, targetCtx) ∧
      StateRel
        (targetCtx.layout.drop
          (targetCtx.layout.length - breakScope.length))
        hiddenReturns
        (Locals.Source.State.restrictTo breakScope source) targetAfter ∧
      CleanupScopeRel targetCtx.layout breakScope ∧
      CtxRel retc sourceCtx targetCtx := by
  rcases hCtx with
    ⟨hSameScope, hBreakDepth, hContinueDepth, hLeaveDepth, hRetc,
      hBreakScopeRel, hContinueScopeRel⟩
  have hCtxRel : CtxRel retc sourceCtx targetCtx :=
    ⟨hSameScope, hBreakDepth, hContinueDepth, hLeaveDepth, hRetc,
      hBreakScopeRel, hContinueScopeRel⟩
  have hCleanupScope : CleanupScopeRel targetCtx.layout breakScope :=
    hBreakScopeRel breakScope hBreak
  have hTargetDepth : targetCtx.breakDepth? = some breakScope.length := by
    rw [hBreakDepth, hBreak]
    rfl
  have hDepth : breakScope.length ≤ targetCtx.layout.length := by
    rcases hCleanupScope with ⟨hLength, _hMem⟩
    simp [List.length_drop] at hLength
    omega
  have hStackLen : target.evm.stack.length = targetCtx.layout.length := by
    rcases hRel with ⟨⟨_hShared, hStackRel⟩, _hReturns⟩
    exact hStackRel.1
  rcases Cleanup.runCleanupTo_exists
      (ctx := targetCtx) (targetDepth := breakScope.length)
      (state := target) hDepth hStackLen with
    ⟨targetAfter, hCleanupRun⟩
  refine ⟨targetAfter, ?hSource, ?hTarget, ?hRel, hCleanupScope, hCtxRel⟩
  · simp [Source.Stmt.run, hBreak]
  · simp [Direct.Stmt.run, hTargetDepth, hCleanupRun]
  · exact StateRel.cleanupTo_scope hRel hCleanupScope hCleanupRun

theorem cont_bridge {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
