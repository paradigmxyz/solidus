    {hiddenReturns : List Structured.ReturnDest}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hRel : StateRel targetCtx.layout hiddenReturns source target) :
    Source.Block.runOpen prim program sourceCtx (fuel + 1)
        { stmts := [] } source =
      .ok (Source.Outcome.regular source, sourceCtx) ∧
    Direct.Block.runOpen program returns targetCtx (fuel + 1)
        { stmts := [] } target =
      .ok (Structured.Outcome.regular target, targetCtx) ∧
    BlockOpenResultRel retc returns hiddenReturns
      (Source.Outcome.regular source, sourceCtx)
      (Structured.Outcome.regular target, targetCtx) := by
  simp [Source.Block.runOpen, Direct.Block.runOpen,
    BlockOpenResultRel.regular hCtx hRel]

theorem runOpen_cons_regular_from_parts {prim : Source.PrimitiveSemantics}
    {program : Program} {returns : List Name}
    {retc fuel : Nat} {sourceCtx sourceCtxMid sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxMid targetCtxOut : Locals.Ctx}
    {source sourceMid : Source.State}
    {target targetMid : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    (hSourceHead :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceMid, sourceCtxMid))
    (hTargetHead :
      Direct.Stmt.run program returns targetCtx fuel stmt target =
        .ok (Structured.Outcome.regular targetMid, targetCtxMid))
    (hSourceTail :
      Source.Block.runOpen prim program sourceCtxMid fuel
          { stmts := rest } sourceMid =
        .ok (sourceOutcome, sourceCtxOut))
    (hTargetTail :
      Direct.Block.runOpen program returns targetCtxMid fuel
          { stmts := rest } targetMid =
        .ok (targetOutcome, targetCtxOut))
    (hTailRel :
      BlockOpenResultRel retc returns hiddenReturns
