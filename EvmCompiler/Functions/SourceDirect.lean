theorem terminal_stmtOutcome_bridge {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {program : Program} {returns : List Name}
    {retc : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState} {fuel : Nat}
    {hiddenReturns : List Structured.ReturnDest}
    {kind : Assembly.HaltKind} {sharedAfter : EvmYul.SharedState .EVM}
    (hCtx : CtxRel retc sourceCtx targetCtx)
    (hRel : StateRel targetCtx.layout hiddenReturns source target)
    (hTerminal :
      prim.terminal kind source.shared [] = .ok sharedAfter) :
    ∃ targetAfter,
      Source.Stmt.run prim program sourceCtx fuel (.terminal kind) source =
        .ok
          (Source.Outcome.halt kind (source.withShared sharedAfter),
            sourceCtx) ∧
      Direct.Stmt.run program returns targetCtx fuel (.terminal kind) target =
        .ok (Structured.Outcome.halt kind targetAfter, targetCtx) ∧
      StmtOutcomeRel returns targetCtx.layout hiddenReturns
        (Source.Outcome.halt kind (source.withShared sharedAfter))
        (Structured.Outcome.halt kind targetAfter) ∧
      CtxRel retc sourceCtx targetCtx := by
  rcases hRel with ⟨⟨hSharedRel, hStackRel⟩, hReturns⟩
  rcases Cleanup.runCleanupAll_exists
      (ctx := targetCtx) (state := target) hStackRel.1 with
    ⟨cleaned, hCleanup, hCleanupShared, _hCleanupReturns⟩
  rcases hPrim.terminal_step_exists
      (kind := kind) (shared := source.shared) (shared' := sharedAfter)
      (values := []) (evm := cleaned.evm)
      (baseStack := cleaned.evm.stack)
      hTerminal (by simpa [hCleanupShared] using hSharedRel)
      (by simp) with
    ⟨evmAfter, hStep, hStepShared⟩
  let targetAfter : Locals.RunState := cleaned.withEVM evmAfter
  refine ⟨targetAfter, ?hSource, ?hTarget, ?hOutcome, hCtx⟩
  · simp [Source.Stmt.run, hTerminal, Locals.Source.State.withShared]
  · simp [Direct.Stmt.run, hCleanup, hStep, targetAfter]
  · exact
      StmtOutcomeRel.halt
        (returns := returns) (layout := targetCtx.layout)
        (hiddenReturns := hiddenReturns)
        (source := source.withShared sharedAfter)
        (target := targetAfter)
        (by simpa [targetAfter, Locals.Source.State.withShared,
          Structured.RunState.withEVM] using hStepShared.symm)

