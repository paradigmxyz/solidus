  rw [hSourceHead] at hSourceHead'
  cases hSourceHead'
  rcases targetHeadResult with ⟨targetHead, targetCtxAfter⟩
  cases sourceHead with
  | mk sourceHeadState sourceHeadMode =>
      cases sourceHeadMode with
      | regular =>
          cases targetHead with
          | mk targetHeadState targetHeadMode =>
