      | ok evalResult =>
          rcases evalResult with ⟨stateAfterArgs, values⟩
          cases hTerminal :
              prim.terminal kind stateAfterArgs.shared values with
          | error err =>
              simp [Source.Stmt.run, hEval, hTerminal] at hRun
          | ok shared =>
              simp [Source.Stmt.run, hEval, hTerminal] at hRun
              cases hRun.1


theorem stmt_regular_scope_nodup {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {state sourceInner : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt state =
        .ok (Source.Outcome.regular sourceInner, ctxOut))
    (hScoped : Scope.Stmt.Scoped ctx.scope stmt)
    (hNoDup : ctx.scope.Nodup) :
    ctxOut.scope.Nodup := by
  have hScope :
      ctxOut.scope = Scope.Stmt.outEnv ctx.scope stmt :=
    stmt_regular_scope hRun
  rw [hScope]
  exact SourceScope.stmt_outEnv_nodup hScoped hNoDup

theorem stmt_regular_returnScope {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxOut : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {state sourceInner : Source.State}
    {returns : List Name}
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt state =
        .ok (Source.Outcome.regular sourceInner, ctxOut))
    (hReturnScope :
      ∀ leaveScope, ctx.leaveScope? = some leaveScope →
        ∀ name, name ∈ returns → name ∈ leaveScope) :
    ∀ leaveScope, ctxOut.leaveScope? = some leaveScope →
      ∀ name, name ∈ returns → name ∈ leaveScope := by
  intro leaveScope hLeaveScope name hReturn
  have hLeaveEq :
      ctxOut.leaveScope? = ctx.leaveScope? :=
    stmt_regular_leaveScope hRun
  exact hReturnScope leaveScope (by simpa [hLeaveEq] using hLeaveScope)
