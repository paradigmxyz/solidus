    {prim : Source.PrimitiveSemantics}
    {m n : Nat} (h : m = n) (exprs : Locals.ExprSeq n)
    (source : Source.State) :
    Locals.Source.Expr.ExprSeq.eval prim
        (Eq.mpr (congrArg Locals.ExprSeq h) exprs) source =
      Locals.Source.Expr.ExprSeq.eval prim exprs source := by
  subst n
  rfl

