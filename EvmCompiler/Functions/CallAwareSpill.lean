                    by
                      simp [Expressions.ProcList.lookup?,
                        hHeadProcNameNe, hLookup],
                    hProcCompile, hProcName, hArgc, hRetc⟩

theorem compileExpressionsProgramWithSwitchFallback?_eq_some_components
