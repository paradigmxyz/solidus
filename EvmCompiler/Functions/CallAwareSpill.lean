      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid]
            at hSourceRun
      | succ fuel =>
          simp [Source.Block.runOpen, Source.Outcome.regular] at hSourceRun
          cases hSourceRun.1
