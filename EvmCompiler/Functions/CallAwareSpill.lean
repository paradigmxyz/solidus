    ⟨fn, _spill, _saved, _argsCode, _storeCode, hFind, hTargetsNodup,
      _hArgsLength, _hTargetsLength, _hSafe, _hSpill, _hSavedEq,
      _hArgsCode, _hStoreCode, _hPlan⟩
