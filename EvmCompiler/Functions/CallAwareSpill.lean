def StmtUsesNonCallSpanFallback : Stmt → Prop
  | .expr _ => True
  | .let_ _ _ => True
  | .assign _ _ => True
  | .if_ _ _ => True
  | .switch _ _ _ => True
  | .for_ _ _ _ _ => True
  | .brk => True
  | .cont => True
  | .terminal _ => True
  | .terminalArgs _ _ => True
  | .call _ _ _ => False
  | .leave => False
  | .block _ => False

