    {range : ScratchRange} {program : Program}
    {plan : Plan} {exprProgram : Expressions.Program}
    {asm : Assembly.Program} {name : Name} {fn : FunDef}
    (hCompile :
      compileChecked? range program = some (plan, exprProgram, asm))
