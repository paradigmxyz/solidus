    ⟨restrictedLayout, contTarget, exprFuel, hRestricted, hRun, hRel',
      hDefined', hStack, hCtx⟩
  exact
    ⟨contTarget, exprFuel, hRun,
      by simpa [hRestricted, hPlanRestrict] using hRel',
      by
        intro name location hMem
        exact
          hDefined' (name := name) (location := location)
            (by simpa [hRestricted, hPlanRestrict] using hMem),
      hStack, hCtx⟩

theorem compileCall?_eq_some
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout}
    {targets : List Name} {functionName : Name}
    {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCall? range program sourceScope stackLayout layout targets
          functionName args =
        some plan) :
    ∃ fn, ∃ spill : SpillPlan, ∃ saved argsCode storeCode,
      FunList.find? functionName program.functions = some fn ∧
      targets.Nodup ∧
      args.length = fn.params.length ∧
      targets.length = fn.returns.length ∧
      SourceNoMemoryTouch.exprSeq? (Lower.argExprs args) = true ∧
      Locals.SourceLowering.StateRel.SpillScratch.SpillPlan.spillAllStack?
          range sourceScope stackLayout layout = some spill ∧
      saved = callerSaveEntries targets spill.layout ∧
      SpillExpr.compileSeqFullCode? range saved.length spill.layout
          (Lower.argExprs args) = some argsCode ∧
      storeReturnedTargetsCode? range spill.layout targets.reverse =
        some storeCode ∧
      plan =
        { sourceScope := spill.sourceScope
          stackLayout := []
          layout := spill.layout
          block :=
            ExpressionsBlock.seqList
              [ SpillStmtCode.toExpressionsBlock spill.code,
                ExpressionsBlock.ofCode (saveScratchCode range saved),
                ExpressionsBlock.ofCode argsCode,
                ExpressionsBlock.ofCall functionName,
                ExpressionsBlock.ofCode storeCode,
                ExpressionsBlock.ofCode
                  (restoreScratchCode range saved) ] } := by
  unfold compileCall? at hCompile
  cases hFind : FunList.find? functionName program.functions with
  | none =>
      simp [hFind] at hCompile
  | some fn =>
      simp [hFind] at hCompile
      by_cases hTargetsNodup : targets.Nodup
      · simp [hTargetsNodup] at hCompile
        by_cases hArgsLength : args.length = fn.params.length
        · simp [hArgsLength] at hCompile
          by_cases hTargetsLength : targets.length = fn.returns.length
          · simp [hTargetsLength] at hCompile
            cases hSafe :
                SourceNoMemoryTouch.exprSeq? (Lower.argExprs args) with
            | false =>
                simp [hSafe] at hCompile
            | true =>
                simp [hSafe] at hCompile
                cases hSpill :
                    Locals.SourceLowering.StateRel.SpillScratch.SpillPlan.spillAllStack?
                      range sourceScope stackLayout layout with
                | none =>
                    simp [hSpill] at hCompile
                | some spill =>
                    simp [hSpill] at hCompile
                    let saved := callerSaveEntries targets spill.layout
                    cases hArgsCode :
                        SpillExpr.compileSeqFullCode? range saved.length
                          spill.layout
                          (Lower.argExprs args) with
                    | none =>
                        simp [saved, hArgsCode] at hCompile
                    | some argsCode =>
                        simp [saved, hArgsCode] at hCompile
                        cases hStore :
                            storeReturnedTargetsCode? range spill.layout
                              targets.reverse with
                        | none =>
                            simp [hStore] at hCompile
                        | some storeCode =>
                            simp [hStore] at hCompile
                            cases hCompile
                            have hFind' :
                                FunList.find? functionName program.functions =
                                  some fn := by
                              simpa [hFind]
                            have hSafe' :
                                SourceNoMemoryTouch.exprSeq?
                                    (Lower.argExprs args) = true := by
                              simpa [hSafe]
                            have hSpill' :
                                Locals.SourceLowering.StateRel.SpillScratch.SpillPlan.spillAllStack?
                                    range sourceScope stackLayout layout =
                                  some spill := by
                              simpa [hSpill]
                            have hArgsCode' :
                                SpillExpr.compileSeqFullCode? range
                                    saved.length spill.layout
                                    (Lower.argExprs args) =
                                  some argsCode := by
                              simpa [hArgsCode]
                            have hStore' :
                                storeReturnedTargetsCode? range spill.layout
                                    targets.reverse =
                                  some storeCode := by
                              simpa [hStore]
                            exact
                              ⟨fn, spill, saved, argsCode, storeCode, rfl,
                                hTargetsNodup, hArgsLength, hTargetsLength,
                                rfl, rfl, rfl, hArgsCode', hStore', rfl⟩
          · simp [hTargetsLength] at hCompile
        · simp [hArgsLength] at hCompile
      · simp [hTargetsNodup] at hCompile

theorem compileCall?_noCallCreate
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout}
    {targets : List Name} {functionName : Name}
    {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCall? range program sourceScope stackLayout layout targets
          functionName args =
        some plan) :
    plan.block.usesCallCreate = false := by
  rcases compileCall?_eq_some hCompile with
    ⟨_fn, spill, saved, argsCode, storeCode, _hFind, _hTargetsNodup,
      _hArgsLength, _hTargetsLength, hSafe, hSpill, hSaved, hArgsCode,
      hStore, hPlan⟩
  subst plan
  simpa [ExpressionsBlock.seqList] using
    expressionsBlock_append_noCallCreate
      (SpillStmtCode.toExpressionsBlock_noCallCreate
        (SpillPlan.spillAllStack?_noCallCreate hSpill))
      (expressionsBlock_append_noCallCreate
        (expressionsBlock_ofCode_noCallCreate
          (saveScratchCode_noCallCreate range saved))
        (expressionsBlock_append_noCallCreate
          (expressionsBlock_ofCode_noCallCreate
            (SpillExpr.compileSeqFullCode?_noCallCreate
              (SourceNoMemoryTouch.exprSeq?_sound hSafe) hArgsCode))
          (expressionsBlock_append_noCallCreate
            expressionsBlock_ofCall_noCallCreate
            (expressionsBlock_append_noCallCreate
              (expressionsBlock_ofCode_noCallCreate
                (storeReturnedTargetsCode?_noCallCreate hStore))
              (expressionsBlock_append_noCallCreate
                (expressionsBlock_ofCode_noCallCreate
                  (restoreScratchCode_noCallCreate range saved))
                expressionsBlock_empty_noCallCreate)))))

theorem compileCallWithNormalizedStackFallback?_noCallCreate
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout} {targets : List Name}
    {functionName : Name} {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCallWithNormalizedStackFallback? range program sourceScope
        stackLayout layout targets functionName args = some plan) :
    plan.block.usesCallCreate = false := by
  unfold compileCallWithNormalizedStackFallback? at hCompile
  cases hEntry :
      normalizePlanStack? range
        { sourceScope := sourceScope
          stackLayout := stackLayout
          layout := layout
          block := { stmts := [] } } with
  | none =>
      simp [hEntry] at hCompile
  | some entry =>
      simp [hEntry] at hCompile
      cases hCall :
          compileCall? range program entry.sourceScope entry.stackLayout
            entry.layout targets functionName args with
      | none =>
          simp [hCall] at hCompile
      | some callPlan =>
          simp [hCall] at hCompile
          cases hCompile
          exact
            expressionsBlock_append_noCallCreate
              (normalizePlanStack?_noCallCreate hEntry
                (by
                  simp [Expressions.Block.usesCallCreate,
                    Expressions.StmtList.usesCallCreate]))
              (compileCall?_noCallCreate hCall)

theorem compileCall?_returned_targets_lookup_scratch
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout}
    {targets : List Name} {functionName : Name}
    {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCall? range program sourceScope stackLayout layout targets
          functionName args =
        some plan) :
    ∀ target, target ∈ targets →
      ∃ slot, SpillLayout.lookup? target plan.layout = some (.scratch slot) := by
  rcases compileCall?_eq_some hCompile with
    ⟨_fn, spill, _saved, _argsCode, storeCode, _hFind, _hTargetsNodup,
      _hArgsLength, _hTargetsLength, _hSafe, _hSpill, _hArgsCode,
      _hSaved, hStore, hPlan⟩
  subst plan
  intro target hMem
  exact storeReturnedTargetsCode?_lookup_scratch hStore target
    (by simpa using List.mem_reverse.mpr hMem)

theorem compileCall?_block_stmts_eq
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout}
    {targets : List Name} {functionName : Name}
    {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCall? range program sourceScope stackLayout layout targets
          functionName args =
        some plan) :
    ∃ fn, ∃ spill : SpillPlan, ∃ saved argsCode storeCode,
      FunList.find? functionName program.functions = some fn ∧
      saved = callerSaveEntries targets spill.layout ∧
      SpillExpr.compileSeqFullCode? range saved.length spill.layout
          (Lower.argExprs args) = some argsCode ∧
      storeReturnedTargetsCode? range spill.layout targets.reverse =
        some storeCode ∧
      plan.block.stmts =
        (SpillStmtCode.toExpressionsBlock spill.code).stmts ++
          [Expressions.Stmt.code (saveScratchCode range saved)] ++
          [Expressions.Stmt.code argsCode] ++
          [Expressions.Stmt.call functionName] ++
          [Expressions.Stmt.code storeCode] ++
          [Expressions.Stmt.code
            (restoreScratchCode range saved)] := by
  rcases compileCall?_eq_some hCompile with
    ⟨fn, spill, saved, argsCode, storeCode, hFind, _hTargetsNodup,
      _hArgsLength, _hTargetsLength, _hSafe, _hSpill, hSaved, hArgsCode,
      hStore, hPlan⟩
  subst plan
  refine
    ⟨fn, spill, saved, argsCode, storeCode, hFind, hSaved, hArgsCode,
      hStore, ?_⟩
  simp [ExpressionsBlock.seqList, ExpressionsBlock.append,
    ExpressionsBlock.ofCode, ExpressionsBlock.ofCall, List.append_assoc]

theorem compileCall?_block_contains_call
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout}
    {targets : List Name} {functionName : Name}
    {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCall? range program sourceScope stackLayout layout targets
          functionName args =
        some plan) :
    Expressions.Stmt.call functionName ∈ plan.block.stmts := by
  rcases compileCall?_block_stmts_eq hCompile with
    ⟨_fn, _spill, _saved, _argsCode, _storeCode, _hFind, _hSaved,
      _hArgsCode, _hStore, hStmts⟩
  rw [hStmts]
  simp

theorem compileCall?_sourceScope_stackLayout
    {range : ScratchRange} {program : Program}
    {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout}
    {targets : List Name} {functionName : Name}
    {args : List (Expr 1)} {plan : Plan}
    (hCompile :
      compileCall? range program sourceScope stackLayout layout targets
          functionName args =
        some plan) :
    plan.sourceScope = sourceScope ∧ plan.stackLayout = [] := by
  rcases compileCall?_eq_some hCompile with
    ⟨_fn, spill, _saved, _argsCode, _storeCode, _hFind, _hTargetsNodup,
      _hArgsLength, _hTargetsLength, _hSafe, hSpill, _hSavedEq,
      _hArgsCode, _hStoreCode, hPlan⟩
  subst plan
  constructor
  · exact SpillPlan.spillAllStack?_sourceScope hSpill
  · rfl

theorem source_call_regular_ctx
    {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxAfter : Source.Ctx} {fuel : Nat}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {source sourceAfter : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel
          (.call targets functionName args) source =
        .ok (Source.Outcome.regular sourceAfter, ctxAfter)) :
    ctxAfter = ctx := by
  cases fuel with
  | zero =>
      simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
  | succ bodyFuel =>
      unfold Source.Stmt.run at hRun
      by_cases hTargets : targets.Nodup
      · simp [hTargets] at hRun
        cases hArgs : Source.ArgList.eval prim args source with
        | error err =>
            simp [hArgs] at hRun
        | ok argResult =>
            rcases argResult with ⟨sourceAfterArgs, argValues⟩
            simp [hArgs] at hRun
            cases hFind : FunList.find? functionName program.functions with
            | none =>
                simp [hFind, Source.invalid, Structured.invalid] at hRun
            | some fn =>
                simp [hFind] at hRun
                cases hBody :
                    Source.FunDef.runBody prim program fn argValues bodyFuel
                      sourceAfterArgs.shared with
                | error err =>
                    simp [hBody] at hRun
                | ok callResult =>
                    cases callResult with
                    | returned sharedAfterCall returnValues =>
                        cases hAssign :
                            Source.Store.assignMany targets returnValues
                              sourceAfterArgs.vars with
                        | none =>
                            simp [hBody, hAssign, Source.invalid,
                              Structured.invalid] at hRun
                        | some returnStore =>
                            simp [hBody, hAssign] at hRun
                            exact hRun.2.symm
                    | halted kind haltedState =>
                        simp [hBody, Source.Outcome.halt] at hRun
                        cases hRun.1
      · simp [hTargets, Source.invalid, Structured.invalid] at hRun

theorem source_stmt_regular_handlers_eq
    {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxAfter : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {source sourceAfter : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt source =
        .ok (Source.Outcome.regular sourceAfter, ctxAfter)) :
    ctxAfter.breakScope? = ctx.breakScope? ∧
      ctxAfter.continueScope? = ctx.continueScope? ∧
      ctxAfter.leaveScope? = ctx.leaveScope? := by
  cases stmt with
  | expr expr =>
      unfold Source.Stmt.run at hRun
      cases hEval : Source.Expr.eval prim expr source with
      | error err =>
          simp [hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfter, values⟩
          simp [hEval] at hRun
          cases hRun.2
          simp
  | let_ name value =>
      unfold Source.Stmt.run at hRun
      cases hEval : Source.Expr.evalOne prim value source with
      | error err =>
          simp [hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfter, value'⟩
          simp [hEval] at hRun
          cases hRun.2
          simp
  | assign name value =>
      unfold Source.Stmt.run at hRun
      cases hContains : source.vars.contains name with
      | false =>
          simp [hContains, Source.invalid, Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value source with
          | error err =>
              simp [hContains, hEval] at hRun
          | ok result =>
              rcases result with ⟨stateAfter, value'⟩
              simp [hContains, hEval] at hRun
              cases hRun.2
              simp
  | block body =>
      unfold Source.Stmt.run at hRun
      cases hScoped :
          Source.Block.runScoped prim program ctx body fuel source with
      | error err =>
          simp [hScoped] at hRun
      | ok outcome =>
          simp [hScoped] at hRun
          cases hRun.2
          simp
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          unfold Source.Stmt.run at hRun
          cases hCond : Source.Expr.evalCondition prim cond source with
          | error err =>
              simp [hCond] at hRun
          | ok result =>
              rcases result with ⟨stateAfterCond, condTrue⟩
              cases condTrue with
              | false =>
                  simp [hCond] at hRun
                  cases hRun.2
                  simp
              | true =>
                  cases hScoped :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterCond with
                  | error err =>
                      simp [hCond, hScoped] at hRun
                  | ok outcome =>
                      simp [hCond, hScoped] at hRun
                      cases hRun.2
                      simp
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          unfold Source.Stmt.run at hRun
          cases hScrutinee : Source.Expr.evalOne prim scrutinee source with
          | error err =>
              simp [hScrutinee] at hRun
          | ok result =>
              rcases result with ⟨stateAfterScrutinee, value⟩
              cases hSelect : Source.Switch.select value cases defaultBody with
              | none =>
                  simp [hScrutinee, hSelect] at hRun
                  cases hRun.2
                  simp
              | some body =>
                  cases hScoped :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterScrutinee with
                  | error err =>
                      simp [hScrutinee, hSelect, hScoped] at hRun
                  | ok outcome =>
                      simp [hScrutinee, hSelect, hScoped] at hRun
                      cases hRun.2
                      simp
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          unfold Source.Stmt.run at hRun
          cases hInit :
              Source.Block.runOpen prim program ctx.withoutLoopControl fuel
                init source with
          | error err =>
              simp [hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases hInitMode : initOutcome.mode with
              | regular =>
                  cases hLoop :
                      Source.Stmt.runForLoop prim program initCtx cond
                        initCtx.withoutLoopControl post
                        (initCtx.withLoopControl initCtx.scope initCtx.scope)
                        body fuel initOutcome.state with
                  | error err =>
                      simp [hInit, hInitMode, hLoop] at hRun
                  | ok loopOutcome =>
                      cases hLoopMode : loopOutcome.mode with
                      | regular =>
                          simp [hInit, hInitMode, hLoop, hLoopMode] at hRun
                          cases hRun.2
                          simp
                      | brk =>
                          simp [hInit, hInitMode, hLoop, hLoopMode,
                            Source.invalid, Structured.invalid] at hRun
                      | cont =>
                          simp [hInit, hInitMode, hLoop, hLoopMode,
                            Source.invalid, Structured.invalid] at hRun
                      | leave =>
                          simp [hInit, hInitMode, hLoop, hLoopMode] at hRun
                          cases hRun.2
                          simp
                      | halt kind =>
                          simp [hInit, hInitMode, hLoop, hLoopMode] at hRun
                          cases hRun.2
                          simp
              | brk =>
                  simp [hInit, hInitMode, Source.invalid,
                    Structured.invalid] at hRun
              | cont =>
                  simp [hInit, hInitMode, Source.invalid,
                    Structured.invalid] at hRun
              | leave =>
                  simp [hInit, hInitMode] at hRun
                  cases hRun.2
                  simp
              | halt kind =>
                  simp [hInit, hInitMode] at hRun
                  cases hRun.2
                  simp
  | brk =>
      unfold Source.Stmt.run at hRun
      cases hBreak : ctx.breakScope? with
      | none =>
          simp [hBreak, Source.invalid, Structured.invalid] at hRun
      | some scope =>
          simp [hBreak, Source.Outcome.brk] at hRun
          cases hRun.1
  | cont =>
      unfold Source.Stmt.run at hRun
      cases hContinue : ctx.continueScope? with
      | none =>
          simp [hContinue, Source.invalid, Structured.invalid] at hRun
      | some scope =>
          simp [hContinue, Source.Outcome.cont] at hRun
          cases hRun.1
  | leave =>
      unfold Source.Stmt.run at hRun
      cases hLeave : ctx.leaveScope? with
      | none =>
          simp [hLeave, Source.invalid, Structured.invalid] at hRun
      | some scope =>
          simp [hLeave, Source.Outcome.leave] at hRun
          cases hRun.1
  | call targets functionName args =>
      have hCtx := source_call_regular_ctx hRun
      subst ctxAfter
      simp
  | terminal kind =>
      unfold Source.Stmt.run at hRun
      cases hTerminal : prim.terminal kind source.shared [] with
      | error err =>
          simp [hTerminal] at hRun
      | ok shared =>
          simp [hTerminal, Source.Outcome.halt] at hRun
          cases hRun.1
  | terminalArgs kind args =>
      unfold Source.Stmt.run at hRun
      cases hArgs : Locals.Source.Expr.ExprSeq.eval prim args source with
      | error err =>
          simp [hArgs] at hRun
      | ok result =>
          rcases result with ⟨stateAfterArgs, values⟩
          cases hTerminal : prim.terminal kind stateAfterArgs.shared values with
          | error err =>
              simp [hArgs, hTerminal] at hRun
          | ok shared =>
              simp [hArgs, hTerminal, Source.Outcome.halt] at hRun
              cases hRun.1

theorem source_call_leave_false
    {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxAfter : Source.Ctx} {fuel : Nat}
    {targets : List Name} {functionName : Name} {args : List (Expr 1)}
    {source sourceAfter : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel
          (.call targets functionName args) source =
        .ok (Source.Outcome.leave sourceAfter, ctxAfter)) :
    False := by
  cases fuel with
  | zero =>
      simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
  | succ bodyFuel =>
      unfold Source.Stmt.run at hRun
      by_cases hTargets : targets.Nodup
      · simp [hTargets] at hRun
        cases hArgs : Source.ArgList.eval prim args source with
        | error err =>
            simp [hArgs] at hRun
        | ok argResult =>
            rcases argResult with ⟨sourceAfterArgs, argValues⟩
            simp [hArgs] at hRun
            cases hFind : FunList.find? functionName program.functions with
            | none =>
                simp [hFind, Source.invalid, Structured.invalid] at hRun
            | some fn =>
                simp [hFind] at hRun
                cases hBody :
                    Source.FunDef.runBody prim program fn argValues bodyFuel
                      sourceAfterArgs.shared with
                | error err =>
                    simp [hBody] at hRun
                | ok callResult =>
                    cases callResult with
                    | returned sharedAfterCall returnValues =>
                        cases hAssign :
                            Source.Store.assignMany targets returnValues
                              sourceAfterArgs.vars with
                        | none =>
                            simp [hBody, hAssign, Source.invalid,
                              Structured.invalid] at hRun
                        | some returnStore =>
                            simp [hBody, hAssign, Source.Outcome.regular]
                              at hRun
                            cases hRun.1
                    | halted kind haltedState =>
                        simp [hBody, Source.Outcome.halt] at hRun
                        cases hRun.1
      · simp [hTargets, Source.invalid, Structured.invalid] at hRun

theorem source_stmt_regular_leaveScope_eq
    {prim : Source.PrimitiveSemantics}
    {program : Program} {ctx ctxAfter : Source.Ctx} {fuel : Nat}
    {stmt : Stmt} {source sourceAfter : Source.State}
    (hRun :
      Source.Stmt.run prim program ctx fuel stmt source =
        .ok (Source.Outcome.regular sourceAfter, ctxAfter)) :
    ctxAfter.leaveScope? = ctx.leaveScope? := by
  cases stmt with
  | expr expr =>
      unfold Source.Stmt.run at hRun
      cases hEval : Source.Expr.eval prim expr source with
      | error err =>
          simp [hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfter, values⟩
          simp [hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtx⟩
          cases hCtx
          rfl
  | let_ name value =>
      unfold Source.Stmt.run at hRun
      cases hEval : Source.Expr.evalOne prim value source with
      | error err =>
          simp [hEval] at hRun
      | ok result =>
          rcases result with ⟨stateAfter, value'⟩
          simp [hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtx⟩
          cases hCtx
          rfl
  | assign name value =>
      unfold Source.Stmt.run at hRun
      cases hContains : source.vars.contains name with
      | false =>
          simp [hContains, Source.invalid, Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value source with
          | error err =>
              simp [hContains, hEval] at hRun
          | ok result =>
              rcases result with ⟨stateAfter, value'⟩
              simp [hContains, hEval] at hRun
              rcases hRun with ⟨_hOutcome, hCtx⟩
              cases hCtx
              rfl
  | block body =>
      unfold Source.Stmt.run at hRun
      cases hScoped : Source.Block.runScoped prim program ctx body fuel
          source with
      | error err =>
          simp [hScoped] at hRun
      | ok bodyOutcome =>
          simp [hScoped] at hRun
          rcases hRun with ⟨_hOutcome, hCtx⟩
          cases hCtx
          rfl
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          unfold Source.Stmt.run at hRun
          cases hCond : Source.Expr.evalCondition prim cond source with
          | error err =>
              simp [hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨stateAfterCond, condTrue⟩
              cases condTrue
              · simp [hCond] at hRun
                rcases hRun with ⟨_hOutcome, hCtx⟩
                cases hCtx
                rfl
              · cases hScoped :
                    Source.Block.runScoped prim program ctx body fuel
                      stateAfterCond with
                | error err =>
                    simp [hCond, hScoped] at hRun
                | ok bodyOutcome =>
                    simp [hCond, hScoped] at hRun
                    rcases hRun with ⟨_hOutcome, hCtx⟩
                    cases hCtx
                    rfl
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          unfold Source.Stmt.run at hRun
          cases hScrutinee : Source.Expr.evalOne prim scrutinee source with
          | error err =>
              simp [hScrutinee] at hRun
          | ok scrutineeResult =>
              rcases scrutineeResult with ⟨stateAfterScrutinee, value⟩
              cases hSelect : Source.Switch.select value cases defaultBody with
              | none =>
                  simp [hScrutinee, hSelect] at hRun
                  rcases hRun with ⟨_hOutcome, hCtx⟩
                  cases hCtx
                  rfl
              | some body =>
                  cases hScoped :
                      Source.Block.runScoped prim program ctx body fuel
                        stateAfterScrutinee with
                  | error err =>
                      simp [hScrutinee, hSelect, hScoped] at hRun
                  | ok bodyOutcome =>
                      simp [hScrutinee, hSelect, hScoped] at hRun
                      rcases hRun with ⟨_hOutcome, hCtx⟩
                      cases hCtx
                      rfl
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          unfold Source.Stmt.run at hRun
          cases hInit :
              Source.Block.runOpen prim program ctx.withoutLoopControl fuel
                init source with
          | error err =>
              simp [hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases hInitMode : initOutcome.mode with
              | regular =>
                  cases hLoop :
                      Source.Stmt.runForLoop prim program initCtx cond
                        initCtx.withoutLoopControl post
                        (initCtx.withLoopControl initCtx.scope initCtx.scope)
                        body fuel initOutcome.state with
                  | error err =>
                      simp [hInit, hInitMode, hLoop] at hRun
                  | ok loopOutcome =>
                      cases hLoopMode : loopOutcome.mode with
                      | regular =>
                          simp [hInit, hInitMode, hLoop, hLoopMode] at hRun
                          rcases hRun with ⟨_hOutcome, hCtx⟩
                          cases hCtx
                          rfl
                      | brk =>
                          simp [hInit, hInitMode, hLoop, hLoopMode,
                            Source.invalid, Structured.invalid] at hRun
                      | cont =>
                          simp [hInit, hInitMode, hLoop, hLoopMode,
                            Source.invalid, Structured.invalid] at hRun
                      | leave =>
                          simp [hInit, hInitMode, hLoop, hLoopMode] at hRun
                          have hModeRegular : loopOutcome.mode = .regular := by
                            rw [hRun.1]
                            rfl
                          rw [hModeRegular] at hLoopMode
                          cases hLoopMode
                      | halt kind =>
                          simp [hInit, hInitMode, hLoop, hLoopMode] at hRun
                          have hModeRegular : loopOutcome.mode = .regular := by
                            rw [hRun.1]
                            rfl
                          rw [hModeRegular] at hLoopMode
                          cases hLoopMode
              | brk =>
                  simp [hInit, hInitMode, Source.invalid,
                    Structured.invalid] at hRun
              | cont =>
                  simp [hInit, hInitMode, Source.invalid,
                    Structured.invalid] at hRun
              | leave =>
                  simp [hInit, hInitMode] at hRun
                  have hModeRegular : initOutcome.mode = .regular := by
                    rw [hRun.1]
                    rfl
                  rw [hModeRegular] at hInitMode
                  cases hInitMode
              | halt kind =>
                  simp [hInit, hInitMode] at hRun
                  have hModeRegular : initOutcome.mode = .regular := by
                    rw [hRun.1]
                    rfl
                  rw [hModeRegular] at hInitMode
                  cases hInitMode
  | brk =>
      unfold Source.Stmt.run at hRun
      cases hBreak : ctx.breakScope? with
      | none =>
          simp [hBreak, Source.invalid, Structured.invalid] at hRun
      | some scope =>
          simp [hBreak, Source.Outcome.brk] at hRun
          cases hRun.1
  | cont =>
      unfold Source.Stmt.run at hRun
      cases hContinue : ctx.continueScope? with
      | none =>
          simp [hContinue, Source.invalid, Structured.invalid] at hRun
      | some scope =>
          simp [hContinue, Source.Outcome.cont] at hRun
          cases hRun.1
  | leave =>
      unfold Source.Stmt.run at hRun
      cases hLeave : ctx.leaveScope? with
      | none =>
          simp [hLeave, Source.invalid, Structured.invalid] at hRun
      | some scope =>
          simp [hLeave, Source.Outcome.leave] at hRun
          cases hRun.1
  | call targets functionName args =>
      have hCtx : ctxAfter = ctx :=
        source_call_regular_ctx hRun
      cases hCtx
      rfl
  | terminal kind =>
      unfold Source.Stmt.run at hRun
      cases hTerminal : prim.terminal kind source.shared [] with
      | error err =>
          simp [hTerminal] at hRun
      | ok shared =>
          simp [hTerminal, Source.Outcome.halt] at hRun
          cases hRun.1
  | terminalArgs kind args =>
      unfold Source.Stmt.run at hRun
      cases hArgs : Locals.Source.Expr.ExprSeq.eval prim args source with
      | error err =>
          simp [hArgs] at hRun
      | ok argResult =>
          rcases argResult with ⟨stateAfterArgs, values⟩
          cases hTerminal : prim.terminal kind stateAfterArgs.shared values with
          | error err =>
              simp [hArgs, hTerminal] at hRun
          | ok shared =>
              simp [hArgs, hTerminal, Source.Outcome.halt] at hRun
              cases hRun.1

mutual

def compileStmt? (range : ScratchRange) (program : Program)
    (returns sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) : Stmt → Option Plan
  | .call targets functionName args =>
      compileCall? range program sourceScope stackLayout layout targets
        functionName args
  | .leave =>
      compileLeave? range returns sourceScope stackLayout layout
  | .block body =>
      compileBlockStmt? range program returns sourceScope stackLayout layout
        body
  | stmt =>
      compileNonCallStmtSpan? range returns sourceScope stackLayout layout stmt
  termination_by stmt => (sizeOf stmt, 0)
  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | simp

def compileSwitchCaseBodies? (range : ScratchRange) (program : Program)
    (returns sourceScope : List Name)
    (layout : SpillLayout.Layout) :
    List (Word × Block) → Option (List (Word × Expressions.Block))
  | [] => some []
  | (value, body) :: rest => do
      let bodyPlan ←
        compileBlockStmt? range program returns sourceScope [] layout body
      let normalized ← normalizePlanStack? range bodyPlan
      if
          normalized.sourceScope = sourceScope ∧
            normalized.stackLayout = [] ∧
            normalized.layout = layout
      then
        let tail ←
          compileSwitchCaseBodies? range program returns sourceScope layout
            rest
        some ((value, normalized.block) :: tail)
      else
        none
  termination_by cases => (sizeOf cases, 0)
  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | simp

def compileSwitchDefaultBody? (range : ScratchRange) (program : Program)
    (returns sourceScope : List Name)
    (layout : SpillLayout.Layout) :
    Option Block → Option (Option Expressions.Block)
  | none => some none
  | some body => do
      let bodyPlan ←
        compileBlockStmt? range program returns sourceScope [] layout body
      let normalized ← normalizePlanStack? range bodyPlan
      if
          normalized.sourceScope = sourceScope ∧
            normalized.stackLayout = [] ∧
            normalized.layout = layout
      then
        some (some normalized.block)
      else
        none
  termination_by defaultBody => (sizeOf defaultBody, 0)
  decreasing_by
    all_goals simp_wf
    all_goals omega

def compileSwitchFallback? (range : ScratchRange) (program : Program)
    (returns sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) (scrutinee : Expr 1)
    (cases : List (Word × Block)) (defaultBody : Option Block) :
    Option Plan := do
  let entry ←
    normalizePlanStack? range
      { sourceScope := sourceScope
        stackLayout := stackLayout
        layout := layout
        block := { stmts := [] } }
  if entry.stackLayout = [] then
    if SourceNoMemoryTouch.expr? scrutinee then
      let scrutineeCode ←
        SpillExpr.compileCode? range 0 entry.layout scrutinee
      let compiledCases ←
        compileSwitchCaseBodies? range program returns entry.sourceScope
          entry.layout cases
      let compiledDefault ←
        compileSwitchDefaultBody? range program returns entry.sourceScope
          entry.layout defaultBody
      some
        { sourceScope := entry.sourceScope
          stackLayout := []
          layout := entry.layout
          block :=
            ExpressionsBlock.append entry.block
              { stmts :=
                  [Expressions.Stmt.switch (.code scrutineeCode)
                    compiledCases compiledDefault] } }
    else
      none
  else
    none
  termination_by (sizeOf (Stmt.switch scrutinee cases defaultBody), 1)
  decreasing_by
    all_goals simp_wf
    all_goals omega

def compileStmtList? (range : ScratchRange) (program : Program)
    (returns sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) : List Stmt → Option Plan
  | [] =>
      some
        { sourceScope := sourceScope
          stackLayout := stackLayout
          layout := layout
          block := { stmts := [] } }
  | stmt :: rest => do
      let head ←
        compileStmt? range program returns sourceScope stackLayout layout stmt
      let tail ←
        compileStmtList? range program returns head.sourceScope
          head.stackLayout head.layout rest
      some
        { sourceScope := tail.sourceScope
          stackLayout := tail.stackLayout
          layout := tail.layout
          block := ExpressionsBlock.append head.block tail.block }
  termination_by stmts => (sizeOf stmts, 0)
  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | simp

def compileBlockOpen? (range : ScratchRange) (program : Program)
    (returns sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) (block : Block) : Option Plan :=
  compileStmtList? range program returns sourceScope stackLayout layout
    block.stmts
  termination_by (sizeOf block, 1)
  decreasing_by
    cases block
    simp_wf
    omega

def compileBlockStmt? (range : ScratchRange) (program : Program)
    (returns sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) (body : Block) : Option Plan := do
  let bodyPlan ←
    compileBlockOpen? range program returns sourceScope stackLayout layout body
  let restrictedLayout := SpillLayout.restrictToScope sourceScope
    bodyPlan.layout
  if
      SpillLayout.checked? range sourceScope bodyPlan.stackLayout
        restrictedLayout
  then
    some
      { sourceScope := sourceScope
        stackLayout := bodyPlan.stackLayout
        layout := restrictedLayout
        block := bodyPlan.block }
  else
    none
  termination_by (sizeOf body, 2)
  decreasing_by
    simp_wf
    omega

end

mutual

def compileStmtWithSwitchFallback? (range : ScratchRange) (program : Program)
    (handlers : FallbackHandlers) (returns sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) : Stmt → Option Plan
  | .call targets functionName args =>
      compileCallWithNormalizedStackFallback? range program sourceScope
        stackLayout layout targets functionName args
  | .leave =>
      compileLeave? range returns sourceScope stackLayout layout
  | .block body =>
      compileBlockStmtWithSwitchFallback? range program handlers returns
        sourceScope stackLayout layout body
  | .expr expr =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            (.expr expr) with
      | some plan => some plan
      | none =>
          compileExprStmtWithSpillFallback? range sourceScope stackLayout
            layout expr
  | .let_ name value =>
      match
          compileNonCallStmtSpan? range returns sourceScope
            stackLayout layout (.let_ name value) with
      | some plan => some plan
      | none =>
          compileLetWithSpillFallback? range sourceScope stackLayout layout
            name value
  | .assign name value =>
      match
          compileNonCallStmtSpan? range returns sourceScope
            stackLayout layout (.assign name value) with
      | some plan => some plan
      | none =>
          compileAssignWithSpillFallback? range sourceScope stackLayout layout
            name value
  | .if_ cond body =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            (.if_ cond body) with
      | some plan => some plan
      | none =>
          compileIfFallbackWithSwitchFallback? range program returns
            handlers sourceScope stackLayout layout cond body
  | .switch scrutinee cases defaultBody =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            (.switch scrutinee cases defaultBody) with
      | some plan => some plan
      | none =>
          compileSwitchFallbackWithSwitchFallback? range program returns
            handlers sourceScope stackLayout layout scrutinee cases defaultBody
  | .for_ init cond post body =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            (.for_ init cond post body) with
      | some plan => some plan
      | none =>
          compileForFallbackWithSwitchFallback? range program handlers returns
            sourceScope stackLayout layout init cond post body
  | .brk =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            .brk with
      | some plan => some plan
      | none =>
          compileBreakWithSpillFallback? range handlers sourceScope
            stackLayout layout
  | .cont =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            .cont with
      | some plan => some plan
      | none =>
          compileContinueWithSpillFallback? range handlers sourceScope
            stackLayout layout
  | .terminal kind =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            (.terminal kind) with
      | some plan => some plan
      | none =>
          compileTerminalWithSpillFallback? sourceScope stackLayout layout kind
  | .terminalArgs kind args =>
      match
          compileNonCallStmtSpan? range returns sourceScope stackLayout layout
            (.terminalArgs kind args) with
      | some plan => some plan
      | none =>
          compileTerminalArgsWithSpillFallback? range sourceScope stackLayout
            layout kind args
  termination_by stmt => (sizeOf stmt, 3)
  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | simp

def compileIfFallbackWithSwitchFallback? (range : ScratchRange)
    (program : Program) (returns : List Name) (handlers : FallbackHandlers)
    (sourceScope stackLayout : List Name)
    (layout : SpillLayout.Layout) (cond : Expr 1) (body : Block) :
    Option Plan := do
  let entry ←
    normalizePlanStack? range
      { sourceScope := sourceScope
        stackLayout := stackLayout
        layout := layout
        block := { stmts := [] } }
  if entry.stackLayout = [] then
    if SourceNoMemoryTouch.expr? cond then
      let condCode ←
        SpillExpr.compileCode? range 0 entry.layout cond
      let bodyPlan ←
        compileBlockStmtWithSwitchFallback? range program handlers returns
          entry.sourceScope [] entry.layout body
      let normalized ← normalizePlanStack? range bodyPlan
      if
          normalized.sourceScope = entry.sourceScope ∧
            normalized.stackLayout = [] ∧
            normalized.layout = entry.layout
      then
        some
          { sourceScope := entry.sourceScope
            stackLayout := []
            layout := entry.layout
            block :=
              ExpressionsBlock.append entry.block
                { stmts := [Expressions.Stmt.if_ (.code condCode)
                    normalized.block] } }
      else
        none
    else
      none
  else
    none
  termination_by (sizeOf (Stmt.if_ cond body), 2)
  decreasing_by
    all_goals simp_wf
    all_goals omega

def compileSwitchCaseBodiesWithSwitchFallback? (range : ScratchRange)
    (program : Program) (returns : List Name) (handlers : FallbackHandlers)
    (sourceScope : List Name)
    (layout : SpillLayout.Layout) :
    List (Word × Block) → Option (List (Word × Expressions.Block))
  | [] => some []
  | (value, body) :: rest => do
      let bodyPlan ←
        compileBlockStmtWithSwitchFallback? range program handlers returns
          sourceScope [] layout body
      let normalized ← normalizePlanStack? range bodyPlan
      if
          normalized.sourceScope = sourceScope ∧
            normalized.stackLayout = [] ∧
            normalized.layout = layout
      then
        let tail ←
          compileSwitchCaseBodiesWithSwitchFallback? range program returns
            handlers sourceScope layout rest
        some ((value, normalized.block) :: tail)
      else
        none
  termination_by cases => (sizeOf cases, 3)
  decreasing_by
    all_goals simp_wf
    all_goals
      first
      | omega
      | simp

def compileSwitchDefaultBodyWithSwitchFallback? (range : ScratchRange)
    (program : Program) (returns : List Name) (handlers : FallbackHandlers)
    (sourceScope : List Name)
    (layout : SpillLayout.Layout) :
    Option Block → Option (Option Expressions.Block)
  | none => some none
  | some body => do
      let bodyPlan ←
        compileBlockStmtWithSwitchFallback? range program handlers returns
          sourceScope [] layout body
      let normalized ← normalizePlanStack? range bodyPlan
      if
          normalized.sourceScope = sourceScope ∧
            normalized.stackLayout = [] ∧
