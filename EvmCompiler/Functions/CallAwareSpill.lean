                      simp [Source.Block.runOpen, hStmtRun, Source.Outcome.brk]
                        at hSourceRun
                      rcases hSourceRun with ⟨hOutcome, _hCtx⟩
                      cases hOutcome
                  | cont =>
                      simp [Source.Block.runOpen, hStmtRun, Source.Outcome.cont]
                        at hSourceRun
                      rcases hSourceRun with ⟨hOutcome, _hCtx⟩
                      cases hOutcome
                  | leave =>
                      simp [Source.Block.runOpen, hStmtRun, Source.Outcome.leave]
