  | assign name value =>
      simpa [compileStmtWithSwitchFallback?, hHelper]
  | if_ cond body =>
      simpa [compileStmtWithSwitchFallback?, hHelper]
  | switch scrutinee cases defaultBody =>
      simpa [compileStmtWithSwitchFallback?, hHelper]
  | for_ init cond post body =>
      simpa [compileStmtWithSwitchFallback?, hHelper]
