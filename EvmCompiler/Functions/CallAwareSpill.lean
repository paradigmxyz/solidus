      sourceAfter, target, kind, hCompile, _hSupported, _hScope, _hRel,
      _hDefined, _hLength, hSourceRun, _hCallReplay, _hHaltReplay => by
      have hPlan := compileStmtList?_eq_some_nil hCompile
