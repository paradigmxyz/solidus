                ((target.withEVM afterArgsEVM).withEVM afterCall)) ∧
          SharedStateEqOutsideScratch range sharedAfterCall
            afterCall.toSharedState ∧
          ScratchRegionReady afterCall.toMachineState range.base
            range.words ∧
