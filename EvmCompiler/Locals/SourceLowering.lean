    {range : ScratchRange} {sourceScope stackLayout : List Name}
    {layout : SpillLayout.Layout} {stmts : List Stmt} {plan : SpillPlan}
    {program : Program} {sourceCtx sourceCtxAfter : Source.Ctx}
