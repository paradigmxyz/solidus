  | assignTop name =>
      simp [compile?] at hPlan
  | assignTopWithOffset offset name =>
      simp [compile?] at hPlan
  | promoteName name =>
      simp [compile?] at hPlan
  | cleanupTo targetLayout =>
      simp [compile?] at hPlan
  | block body =>
      simp [compile?] at hPlan
  | if_ cond body =>
