  | for_ init cond post body =>
      simp [compile?] at hPlan
  | brk =>
      simp [compile?] at hPlan
  | cont =>
      simp [compile?] at hPlan
  | leave =>
      simp [compile?] at hPlan
  | call name =>
      simp [compile?] at hPlan
  | terminal kind =>
      exact compileTerminal?_wellFormed hPlan hLayout
  | terminalArgs kind args =>
      exact compileTerminalArgs?_wellFormed hPlan hLayout

