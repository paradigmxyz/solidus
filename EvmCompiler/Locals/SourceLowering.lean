        hErase
    calc
      target.toSharedState.substate =
          reference.toSharedState.substate := by
        simpa [Structured.Preservation.eraseControl, Assembly.eraseGas]
          using hEq
      _ = ghost.substate := hOutside.substate_eq
      _ = source.substate := hInv.substate_eq
  executionEnv_eq := by
    have hEq :=
