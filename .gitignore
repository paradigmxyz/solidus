# Optimization-harness run artifacts (regenerated by scripts/opt_harness.sh and
# scripts/opt_gas_runner.py). The baseline (benchmarks/opt_baseline.json) is
# tracked on purpose; these per-run outputs are not.
benchmarks/opt_last_run.json
benchmarks/opt_check.json
benchmarks/score_debug.json

# Foundry gas-runner scratch. opt_gas_runner.py renders its forge project into a
# TemporaryDirectory (out/, cache/, gas.out all live under that temp dir and are
# cleaned up), so nothing persistent normally lands in the tree. These guard
# against a stray forge invocation leaving artifacts at the repo root.
/forge-artifacts/
/broadcast/
